<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chris hopper</title>

    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- 高级样式 -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #0A0A0F;
            color: #FFFFFF;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        main {
            padding-top: 1.5rem;
            padding-bottom: 3rem;
        }
        .container {
            max-width: 1200px;
        }
        .navbar-nav .nav-link {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .nav-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(255,255,255,0.06);
            flex-shrink: 0;
        }
        .nav-avatar-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.3);
            font-size: 0.7rem;
            font-weight: 600;
            flex-shrink: 0;
        }

        /* ===== 通知样式 ===== */
        .notif-badge {
            position: absolute;
            top: -4px;
            right: -6px;
            background: #EC4899;
            color: #fff;
            font-size: 0.6rem;
            font-weight: 700;
            padding: 0.1rem 0.4rem;
            border-radius: 20px;
            min-width: 18px;
            text-align: center;
            line-height: 1.4;
            border: 2px solid #0A0A0F;
        }

        .notif-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            width: 400px;
            max-height: 480px;
            background: #1a1a2e;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.04);
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            display: none;
            z-index: 1000;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .notif-dropdown.show {
            display: block;
            animation: notifSlideDown 0.25s ease;
        }

        @@keyframes notifSlideDown {
            from { opacity: 0; transform: translateY(-10px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .notif-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 1.2rem;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .notif-mark-all {
            background: none;
            border: none;
            color: rgba(255,255,255,0.2);
            font-size: 0.75rem;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .notif-mark-all:hover {
            color: #8B5CF6;
        }

        .notif-list {
            max-height: 340px;
            overflow-y: auto;
            padding: 0.2rem 0;
        }

        .notif-list::-webkit-scrollbar {
            width: 3px;
        }
        .notif-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 0.8rem;
            padding: 0.8rem 1.2rem;
            border-bottom: 1px solid rgba(255,255,255,0.02);
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .notif-item:hover {
            background: rgba(255,255,255,0.02);
        }

        .notif-item.read {
            opacity: 0.4;
        }

        .notif-item .notif-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 0.2rem;
        }

        .notif-item .notif-dot.info { background: #4facfe; }
        .notif-item .notif-dot.success { background: #28a745; }
        .notif-item .notif-dot.warning { background: #ffc107; }
        .notif-item .notif-dot.danger { background: #dc3545; }

        .notif-item .notif-content {
            flex: 1;
            min-width: 0;
        }

        .notif-item .notif-title {
            color: #fff;
            font-weight: 500;
            font-size: 0.85rem;
        }

        .notif-item .notif-msg {
            color: rgba(255,255,255,0.4);
            font-size: 0.8rem;
            margin-top: 0.1rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .notif-item .notif-time {
            color: rgba(255,255,255,0.15);
            font-size: 0.65rem;
            margin-top: 0.2rem;
        }

        .notif-empty {
            text-align: center;
            padding: 2rem;
            color: rgba(255,255,255,0.15);
            font-size: 0.9rem;
        }

        .notif-footer {
            padding: 0.6rem 1.2rem;
            border-top: 1px solid rgba(255,255,255,0.04);
            text-align: center;
        }

        .notif-footer a {
            color: rgba(255,255,255,0.2);
            text-decoration: none;
            font-size: 0.8rem;
            transition: color 0.3s ease;
        }

        .notif-footer a:hover {
            color: #8B5CF6;
        }

        .nav-item.dropdown {
            position: relative;
        }

        .nav-link-bell {
            position: relative;
            cursor: pointer;
            padding: 0.5rem 0.8rem;
            border-radius: 40px;
            transition: all 0.3s ease;
        }

        .nav-link-bell:hover {
            background: rgba(255,255,255,0.04);
        }
    </style>
</head>
<body>

    <!-- ===== 导航栏 ===== -->
    <nav class="navbar navbar-expand-lg nav-advanced">
        <div class="container">
            <a class="navbar-brand nav-brand" href="/">
                <i class="bi bi-command"></i> Chris hopper
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    style="border:1px solid rgba(255,255,255,0.06);">
                <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">

                @{
                    var userId = Context.Session.GetInt32("UserId");
                    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
                    var username = Context.Session.GetString("Username");
                }

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house"></i> 首页</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Blog"><i class="bi bi-journal"></i> 博客</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About"><i class="bi bi-person"></i> 关于</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Contact"><i class="bi bi-envelope"></i> 联系</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Message/Index"><i class="bi bi-chat"></i> 留言</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Game"><i class="bi bi-controller"></i> 游戏</a></li>

                    @if (userId.HasValue)
                    {
                        MyPersonalWebsite.Models.User? user = null;
                        string? avatarUrl = null;
                        bool isAvatarApproved = false;
                        int unreadCount = 0;
                        var notifications = new List<MyPersonalWebsite.Models.Notification>();
                        try
                        {
                            var dataSync = Context.RequestServices.GetService<MyPersonalWebsite.Services.DataSyncService>();
                            if (dataSync != null)
                            {
                                user = await dataSync.GetUserByIdAsync(userId.Value);
                                if (user != null)
                                {
                                    avatarUrl = user.AvatarUrl;
                                    isAvatarApproved = user.IsAvatarApproved;
                                }
                                notifications = await dataSync.GetNotificationsByUserIdAsync(userId.Value);
                                unreadCount = notifications.Count(n => !n.IsRead);
                            }
                        }
                        catch { }

                        @if (isAdmin == 1)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Dashboard" style="color:#8B5CF6;">
                                    <i class="bi bi-speedometer2"></i> 管理
                                </a>
                            </li>
                        }

                        <!-- ⭐ 通知铃铛 -->
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-bell" onclick="toggleNotifications(event)">
                                <i class="bi bi-bell" style="font-size:1.2rem;"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="notif-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                                }
                            </a>
                            <div class="notif-dropdown" id="notifDropdown">
                                <div class="notif-header">
                                    <span>📬 通知</span>
                                    @if (unreadCount > 0)
                                    {
                                        <button onclick="markAllRead()" class="notif-mark-all">全部已读</button>
                                    }
                                </div>
                                <div class="notif-list" id="notifList">
                                    @if (notifications.Any())
                                    {
                                        foreach (var n in notifications.Take(10))
                                        {
                                            <div class="notif-item @(n.IsRead ? "read" : "")" data-id="@n.Id" onclick="markNotifRead(@n.Id, this)">
                                                <div class="notif-dot @n.Type"></div>
                                                <div class="notif-content">
                                                    <div class="notif-title">@n.Title</div>
                                                    <div class="notif-msg">@n.Message</div>
                                                    <div class="notif-time">@n.CreatedAt.ToString("MM-dd HH:mm")</div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="notif-empty">🎉 暂无通知</div>
                                    }
                                </div>
                                <div class="notif-footer">
                                    <a href="/Home/Notifications">查看全部</a>
                                </div>
                            </div>
                        </li>

                        <!-- 个人资料 -->
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Profile">
                                @if (!string.IsNullOrEmpty(avatarUrl) && isAvatarApproved)
                                {
                                    <img src="@avatarUrl" alt="头像" class="nav-avatar" />
                                }
                                else
                                {
                                    <span class="nav-avatar-placeholder">@(username?.FirstOrDefault().ToString().ToUpper() ?? "?")</span>
                                }
                                <span>@username</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Logout" style="color:#EC4899;">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Auth/Login"><i class="bi bi-box-arrow-in-right"></i> 登录</a></li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Register" style="background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;border-radius:50px;padding:0.4rem 1.2rem;">
                                注册
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== 主体 ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== 页脚 ===== -->
    <footer style="border-top:1px solid rgba(255,255,255,0.03);padding:2rem 0;margin-top:2rem;">
        <div class="container text-center">
            <p style="color:rgba(255,255,255,0.3);font-size:0.85rem;">
                © 2026 <span style="background:linear-gradient(135deg,#8B5CF6,#EC4899,#F59E0B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Chris hopper</span>
                <br>
                <span style="font-size:0.75rem;color:rgba(255,255,255,0.15);">
                    用 <i class="bi bi-heart-fill" style="color:#EC4899;"></i> 和 ASP.NET Core 10.0 构建
                </span>
            </p>
        </div>
    </footer>

    <!-- ===== 脚本 ===== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        // ============================================================
        // 通知下拉菜单
        // ============================================================
        function toggleNotifications(e) {
            e.preventDefault();
            e.stopPropagation();
            const dropdown = document.getElementById('notifDropdown');
            dropdown.classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('notifDropdown');
            if (dropdown && !dropdown.contains(e.target) && !e.target.closest('.nav-link-bell')) {
                dropdown.classList.remove('show');
            }
        });

        // ============================================================
        // 标记单条通知为已读
        // ============================================================
        function markNotifRead(id, element) {
            if (element.classList.contains('read')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkNotificationRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    element.classList.add('read');
                    const badge = document.querySelector('.notif-badge');
                    if (badge) {
                        const count = parseInt(badge.textContent) - 1;
                        if (count > 0) {
                            badge.textContent = count;
                        } else {
                            badge.remove();
                        }
                    }
                }
            });
        }

        // ============================================================
        // 全部标记已读
        // ============================================================
        function markAllRead() {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkAllNotificationsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: ''
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    document.querySelectorAll('.notif-item').forEach(el => el.classList.add('read'));
                    const badge = document.querySelector('.notif-badge');
                    if (badge) badge.remove();
                    const btn = document.querySelector('.notif-mark-all');
                    if (btn) btn.remove();
                }
            });
        }

        // 点击通知项标记已读
        document.addEventListener('click', function(e) {
            const item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                const id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });

        // ============================================================
        // ⭐ SignalR 连接
        // ============================================================
        (function() {
            const userId = @(Context.Session.GetInt32("UserId") ?? 0);
            const isAdmin = @(Context.Session.GetInt32("IsAdmin") ?? 0);
            if (!userId) return;

            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/messageHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.start()
                    .then(() => {
                        connection.invoke('UserOnline', userId);
                        console.log('✅ SignalR 已连接');
                    })
                    .catch(err => console.error('❌ SignalR 连接失败:', err));

                // 监听在线用户更新
                connection.on('OnlineUsersUpdated', function(onlineUserIds) {
                    if (isAdmin === 1) {
                        window._updateOnlineList && window._updateOnlineList(onlineUserIds);
                    }
                });

                // ⭐ 恐怖入侵监听
                connection.on('HorrorInvasion', function(message) {
                    triggerHorrorInvasion(message || '💀 你逃不掉的...');
                });

                // 页面关闭时断开连接
                window.addEventListener('beforeunload', function() {
                    connection.stop();
                });

            } catch (e) {
                console.log('SignalR 不可用');
            }
        })();

        // ============================================================
        // ⭐ 恐怖入侵效果（完整版）
        // ============================================================

        function triggerHorrorInvasion(message) {
            // ===== 1. 强制全屏 =====
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(function() {});
            }

            // ===== 2. 逐渐乱码 =====
            var textNodes = [];
            var walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        var parent = node.parentElement;
                        if (parent && !parent.closest('script') && !parent.closest('style') && node.textContent.trim().length > 0) {
                            return NodeFilter.FILTER_ACCEPT;
                        }
                        return NodeFilter.FILTER_REJECT;
                    }
                }
            );

            var node;
            while (node = walker.nextNode()) {
                textNodes.push(node);
            }

            var originalTexts = textNodes.map(function(n) { return n.textContent; });

            var glitchLevel = 0;

            var glitchInterval = setInterval(function() {
                glitchLevel += 0.06;
                if (glitchLevel > 1) glitchLevel = 1;

                textNodes.forEach(function(node, idx) {
                    var original = originalTexts[idx] || '';
                    var glitched = '';
                    for (var i = 0; i < original.length; i++) {
                        if (Math.random() < glitchLevel && original[i] !== ' ' && original[i] !== '\n') {
                            var rand = Math.random();
                            if (rand < 0.2) {
                                glitched += '🩸💀☠️👁️🔪⚰️🕷️🦇'[Math.floor(Math.random() * 8)];
                            } else {
                                glitched += '!@#$%^&*()_+-=<>?/[]{}|;:,.\'"\\`~'[Math.floor(Math.random() * 30)];
                            }
                        } else {
                            glitched += original[i];
                        }
                    }
                    node.textContent = glitched;
                });

                if (glitchLevel > 0.3) {
                    document.body.style.backgroundColor = 'rgba(0,0,0,0.03)';
                    setTimeout(function() { document.body.style.backgroundColor = ''; }, 50);
                }

                if (glitchLevel >= 1) {
                    clearInterval(glitchInterval);

                    // ===== 3. 随机选择恐怖效果 =====
                    var horrorEffects = [
                        'typewriter',
                        'multiLine',
                        'matrixRain',
                        'bloodDissolve',
                        'crtHorror',
                        'faceZoom',
                        'textPulse'
                    ];

                    var effect = horrorEffects[Math.floor(Math.random() * horrorEffects.length)];

                    // ===== 创建遮罩 =====
                    var overlay = document.createElement('div');
                    overlay.id = 'horrorOverlay';
                    overlay.style.cssText = `
                        position: fixed;
                        inset: 0;
                        background: rgba(0, 0, 0, 0.97);
                        z-index: 99999;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        animation: horrorFadeIn 0.5s ease;
                        cursor: default;
                        user-select: none;
                        overflow: hidden;
                    `;
                    document.body.appendChild(overlay);

                    // 注入CSS动画
                    var style = document.createElement('style');
                    style.textContent = `
                        @keyframes horrorFadeIn {
                            0% { opacity: 0; transform: scale(0.95); }
                            100% { opacity: 1; transform: scale(1); }
                        }
                        @keyframes textGlitch {
                            0%, 100% { opacity: 1; transform: translateX(0) skewX(0deg); }
                            10% { opacity: 0.7; transform: translateX(-8px) skewX(5deg); }
                            20% { opacity: 0.5; transform: translateX(8px) skewX(-5deg); }
                            30% { opacity: 0.8; transform: translateX(-5px) skewX(3deg); }
                            40% { opacity: 0.6; transform: translateX(5px) skewX(-3deg); }
                            50% { opacity: 0.9; transform: translateX(-3px) skewX(2deg); }
                            60% { opacity: 0.7; transform: translateX(3px) skewX(-2deg); }
                            70% { opacity: 0.8; transform: translateX(-4px) skewX(4deg); }
                            80% { opacity: 0.5; transform: translateX(4px) skewX(-4deg); }
                            90% { opacity: 0.9; transform: translateX(-2px) skewX(1deg); }
                        }
                        @keyframes textPulse {
                            0%, 100% { transform: scale(1); opacity: 1; }
                            25% { transform: scale(1.05); opacity: 0.8; }
                            50% { transform: scale(0.95); opacity: 1; }
                            75% { transform: scale(1.03); opacity: 0.9; }
                        }
                        @keyframes faceZoom {
                            0% { transform: scale(0.1) rotate(-15deg); opacity: 0; }
                            50% { transform: scale(1.3) rotate(5deg); opacity: 1; }
                            70% { transform: scale(0.9) rotate(-3deg); }
                            100% { transform: scale(1) rotate(0deg); }
                        }
                        @keyframes glitchImage {
                            0%, 100% { transform: translate(0, 0) scale(1); opacity: 1; }
                            10% { transform: translate(-15px, 8px) scale(1.03); opacity: 0.8; }
                            20% { transform: translate(12px, -5px) scale(0.97); opacity: 0.6; }
                            30% { transform: translate(-8px, 12px) scale(1.05); opacity: 0.9; }
                            40% { transform: translate(18px, -8px) scale(0.95); opacity: 0.5; }
                            50% { transform: translate(-10px, 6px) scale(1.02); opacity: 0.7; }
                            60% { transform: translate(8px, -15px) scale(0.98); opacity: 0.8; }
                            70% { transform: translate(-18px, 10px) scale(1.04); opacity: 0.6; }
                            80% { transform: translate(10px, -6px) scale(0.96); opacity: 0.7; }
                            90% { transform: translate(-6px, 12px) scale(1.01); opacity: 0.9; }
                        }
                        @keyframes lineAppear {
                            0% { opacity: 0; transform: translateX(-50%) translateY(20px) scale(0.8); }
                            100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
                        }
                        @keyframes lineDisappear {
                            0% { opacity: 1; transform: translateX(-50%) scale(1); filter: blur(0px); }
                            100% { opacity: 0; transform: translateX(-50%) scale(0.3); filter: blur(20px); }
                        }
                        @keyframes charBlood {
                            0% { color: #ff0000; transform: scale(1); filter: blur(0px); opacity: 1; }
                            30% { color: #cc0000; transform: scale(1.3); filter: blur(2px); opacity: 0.9; }
                            60% { color: #880000; transform: scale(0.8); filter: blur(8px); opacity: 0.6; }
                            100% { color: #220000; transform: scale(0.2); filter: blur(25px); opacity: 0; }
                        }
                        @keyframes crtFlicker {
                            0%, 100% { opacity: 1; }
                            10% { opacity: 0.3; }
                            20% { opacity: 0.9; }
                            30% { opacity: 0.1; }
                            40% { opacity: 0.8; }
                            50% { opacity: 0.2; }
                            60% { opacity: 1; }
                            70% { opacity: 0.4; }
                            80% { opacity: 0.9; }
                            90% { opacity: 0.1; }
                        }
                        @keyframes crtShift {
                            0% { transform: translate(-50%, -50%) translateX(-5px) skewX(1deg); }
                            100% { transform: translate(-50%, -50%) translateX(5px) skewX(-1deg); }
                        }
                    `;
                    document.head.appendChild(style);

                    // ===== 执行随机效果 =====
                    switch(effect) {
                        case 'typewriter':
                            typeHorrorText(overlay, message);
                            break;
                        case 'multiLine':
                            showMultiLineHorror(overlay, message);
                            break;
                        case 'matrixRain':
                            showMatrixRain(overlay);
                            break;
                        case 'bloodDissolve':
                            showBloodDissolve(overlay, message);
                            break;
                        case 'crtHorror':
                            showCRTHorror(overlay);
                            break;
                        case 'faceZoom':
                            showFaceZoom(overlay, message);
                            break;
                        case 'textPulse':
                            showTextPulse(overlay, message);
                            break;
                    }

                    // ===== 恢复 =====
                    setTimeout(function() {
                        // 恢复文本
                        textNodes.forEach(function(node, idx) {
                            node.textContent = originalTexts[idx] || '';
                        });

                        // 退出全屏
                        if (document.fullscreenElement) {
                            document.exitFullscreen().catch(function() {});
                        }

                        // 移除遮罩
                        var overlayEl = document.getElementById('horrorOverlay');
                        if (overlayEl) {
                            overlayEl.style.animation = 'horrorFadeIn 0.5s ease reverse';
                            setTimeout(function() {
                                overlayEl.remove();
                                if (style) style.remove();
                            }, 500);
                        }

                        document.body.style.backgroundColor = '';

                        // 停止音效
                        var allAudio = document.querySelectorAll('audio');
                        allAudio.forEach(function(a) { a.pause(); a.currentTime = 0; });

                    }, 5000);

                }
            }, 100);
        }

        // ============================================================
        // ⭐ 恐怖效果函数
        // ============================================================

        // 1. 打字机效果
        function typeHorrorText(container, message) {
            var textDiv = document.createElement('div');
            textDiv.id = 'horrorText';
            textDiv.style.cssText = `
                position: relative;
                z-index: 2;
                color: #ff0000;
                font-size: 3.5rem;
                font-family: 'Courier New', monospace;
                font-weight: 900;
                text-shadow: 0 0 60px rgba(255,0,0,0.3);
                letter-spacing: 6px;
                text-align: center;
                max-width: 85vw;
                word-wrap: break-word;
                min-height: 100px;
            `;
            container.appendChild(textDiv);

            var chars = message.split('');
            var index = 0;
            var glitchChars = '!@#$%^&*()_+-=<>?/[]{}|;:,.\'"\\`~';
            var bloodChars = '🩸💀☠️👁️🔪⚰️🕷️🦇';

            function typeNext() {
                if (index < chars.length) {
                    var display = '';
                    for (var i = 0; i < chars.length; i++) {
                        if (i < index) {
                            display += chars[i];
                        } else if (i === index) {
                            var rand = Math.random();
                            if (rand < 0.3) {
                                display += bloodChars[Math.floor(Math.random() * bloodChars.length)];
                            } else {
                                display += glitchChars[Math.floor(Math.random() * glitchChars.length)];
                            }
                        } else {
                            display += ' ';
                        }
                    }
                    textDiv.textContent = display;
                    textDiv.style.transform = 'translateX(' + (Math.random() - 0.5) * 10 + 'px)';
                    index++;
                    setTimeout(typeNext, 80 + Math.random() * 120);
                } else {
                    textDiv.textContent = message;
                    textDiv.style.animation = 'textGlitch 0.15s infinite';
                    textDiv.style.transform = 'translateX(0)';
                }
            }
            typeNext();
        }

        // 2. 多行消失效果
        function showMultiLineHorror(container, message) {
            var words = message.split(' ').length > 1 ? message.split(' ') : ['⚠️', '系', '统', '崩', '溃', '⚠️'];

            var wrapper = document.createElement('div');
            wrapper.style.cssText = `
                position: relative;
                z-index: 2;
                text-align: center;
                min-height: 300px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 10px;
            `;
            container.appendChild(wrapper);

            var lineElements = [];
            words.forEach(function(word, index) {
                var div = document.createElement('div');
                div.textContent = word;
                div.style.cssText = `
                    color: ${index % 2 === 0 ? '#ff0000' : '#ffffff'};
                    font-size: ${2.5 + Math.random() * 1.5}rem;
                    font-family: 'Courier New', monospace;
                    font-weight: 900;
                    text-shadow: 0 0 30px rgba(255,0,0,${0.3 - index * 0.03});
                    letter-spacing: 8px;
                    opacity: 0;
                    animation: lineAppear 0.5s ease forwards;
                    animation-delay: ${index * 0.3}s;
                    transform-origin: center;
                `;
                wrapper.appendChild(div);
                lineElements.push(div);
            });

            setTimeout(function() {
                lineElements.forEach(function(line, index) {
                    setTimeout(function() {
                        var original = line.textContent;
                        var glitchInterval = setInterval(function() {
                            var glitched = '';
                            for (var i = 0; i < original.length; i++) {
                                if (Math.random() > 0.4) {
                                    var rand = Math.random();
                                    if (rand < 0.2) {
                                        glitched += '🩸💀☠️👁️🔪⚰️🕷️🦇'[Math.floor(Math.random() * 8)];
                                    } else {
                                        glitched += '!@#$%^&*()'[Math.floor(Math.random() * 10)];
                                    }
                                } else {
                                    glitched += original[i];
                                }
                            }
                            line.textContent = glitched;
                        }, 30);
                        setTimeout(function() {
                            clearInterval(glitchInterval);
                            line.style.animation = 'lineDisappear 0.6s ease forwards';
                            setTimeout(function() {
                                line.textContent = '';
                            }, 600);
                        }, 500);
                    }, index * 200 + 1500);
                });
            }, 1000);
        }

        // 3. 矩阵雨效果
        function showMatrixRain(container) {
            var canvas = document.createElement('canvas');
            canvas.style.cssText = `
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                z-index: 1;
            `;
            container.appendChild(canvas);

            var ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            var chars = '0123456789!@#$%^&*()_+-=<>?/[]{}|;:,.\'"\\`~🩸💀☠️👁️🔪⚰️🕷️🦇';
            var fontSize = 18;
            var columns = Math.ceil(canvas.width / fontSize);
            var drops = [];

            for (var i = 0; i < columns; i++) {
                drops[i] = Math.random() * -100;
            }

            var textDiv = document.createElement('div');
            textDiv.textContent = '⚠️ SYSTEM BREACH ⚠️';
            textDiv.style.cssText = `
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 2;
                color: #ff0000;
                font-size: 3.5rem;
                font-family: 'Courier New', monospace;
                font-weight: 900;
                text-shadow: 0 0 80px rgba(255,0,0,0.5);
                letter-spacing: 12px;
                animation: textPulse 0.5s ease-in-out infinite alternate;
                text-align: center;
            `;
            container.appendChild(textDiv);

            var subText = document.createElement('div');
            subText.textContent = '🔴 系统已被入侵 • 请立即断开连接 🔴';
            subText.style.cssText = `
                position: absolute;
                bottom: 15%;
                left: 50%;
                transform: translateX(-50%);
                z-index: 2;
                color: rgba(255,0,0,0.3);
                font-size: 1rem;
                font-family: 'Courier New', monospace;
                letter-spacing: 4px;
                animation: textPulse 0.8s ease-in-out infinite alternate;
            `;
            container.appendChild(subText);

            var matrixInterval = setInterval(function() {
                ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                for (var i = 0; i < drops.length; i++) {
                    var text = chars[Math.floor(Math.random() * chars.length)];
                    var x = i * fontSize;
                    var y = drops[i] * fontSize;

                    if (drops[i] < 5) {
                        ctx.fillStyle = '#ff4444';
                    } else {
                        ctx.fillStyle = 'rgba(255,0,0,' + (0.3 + Math.random() * 0.5) + ')';
                    }

                    ctx.font = fontSize + 'px monospace';
                    ctx.fillText(text, x, y);

                    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }
                    drops[i]++;
                }

                if (Math.random() > 0.92) {
                    ctx.fillStyle = 'rgba(255,0,0,0.03)';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                }
            }, 33);

            setTimeout(function() {
                clearInterval(matrixInterval);
                canvas.remove();
                textDiv.remove();
                subText.remove();
            }, 4800);
        }

        // 4. 鲜血溶解效果
        function showBloodDissolve(container, message) {
            var text = message || '💀 你逃不掉的...';
            var chars = text.split('');

            var textDiv = document.createElement('div');
            textDiv.style.cssText = `
                position: relative;
                z-index: 2;
                font-size: 4rem;
                font-family: 'Courier New', monospace;
                font-weight: 900;
                text-shadow: 0 0 80px rgba(255,0,0,0.3);
                letter-spacing: 6px;
                display: flex;
                gap: 4px;
                flex-wrap: wrap;
                justify-content: center;
                max-width: 90vw;
            `;
            container.appendChild(textDiv);

            chars.forEach(function(ch, index) {
                var span = document.createElement('span');
                span.textContent = ch;
                span.style.cssText = `
                    display: inline-block;
                    animation: charBlood ${1.5 + Math.random() * 1.5}s ease-in-out forwards;
                    animation-delay: ${index * 0.12}s;
                    filter: blur(0px);
                    color: #ff0000;
                `;
                textDiv.appendChild(span);
            });

            var bloodDiv = document.createElement('div');
            bloodDiv.style.cssText = `
                position: absolute;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse at center, rgba(255,0,0,0.05), transparent 70%);
                animation: textPulse 0.5s ease-in-out infinite alternate;
            `;
            container.appendChild(bloodDiv);

            setTimeout(function() {
                textDiv.remove();
                bloodDiv.remove();
            }, 4800);
        }

        // 5. CRT老电视效果
        function showCRTHorror(container) {
            var canvas = document.createElement('canvas');
            canvas.style.cssText = `
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                z-index: 1;
            `;
            container.appendChild(canvas);

            var ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            var scanlineDiv = document.createElement('div');
            scanlineDiv.style.cssText = `
                position: absolute;
                inset: 0;
                z-index: 3;
                pointer-events: none;
                background: repeating-linear-gradient(0deg,
                    transparent,
                    transparent 2px,
                    rgba(0,0,0,0.1) 2px,
                    rgba(0,0,0,0.1) 4px
                );
            `;
            container.appendChild(scanlineDiv);

            var textDiv = document.createElement('div');
            textDiv.textContent = '📡 信号中断...';
            textDiv.style.cssText = `
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                z-index: 2;
                color: #00ff00;
                font-size: 3rem;
                font-family: 'Courier New', monospace;
                font-weight: bold;
                text-shadow: 0 0 30px rgba(0,255,0,0.2);
                letter-spacing: 6px;
                animation: crtFlicker 0.1s infinite, crtShift 0.3s infinite alternate;
            `;
            container.appendChild(textDiv);

            function drawSnow() {
                ctx.fillStyle = 'rgba(0,0,0,0.95)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                var imageData = ctx.createImageData(canvas.width, canvas.height);
                var data = imageData.data;

                for (var i = 0; i < data.length; i += 4) {
                    var value = Math.random() * 255;
                    data[i] = value;
                    data[i+1] = value;
                    data[i+2] = value;
                    data[i+3] = 255;
                }

                ctx.putImageData(imageData, 0, 0);
            }

            var snowInterval = setInterval(drawSnow, 50);

            var messages = [
                '📡 信号中断...',
                '⚠️ 正在尝试连接...',
                '👁️ 检测到异常信号...',
                '💀 信号已被拦截...',
                '🔴 连接已断开...'
            ];

            var msgIndex = 0;
            var msgInterval = setInterval(function() {
                msgIndex = (msgIndex + 1) % messages.length;
                textDiv.textContent = messages[msgIndex];
                var colors = ['#00ff00', '#ff0000', '#ffff00', '#ff00ff'];
                textDiv.style.color = colors[Math.floor(Math.random() * colors.length)];
            }, 800);

            setTimeout(function() {
                clearInterval(snowInterval);
                clearInterval(msgInterval);
                canvas.remove();
                scanlineDiv.remove();
                textDiv.remove();
            }, 4800);
        }

        // 6. 图片突脸效果
        function showFaceZoom(container, message) {
            var horrorImages = [
                '/images/horror/ghost.png',
                '/images/horror/face1.png',
                '/images/horror/face2.png',
                '/images/horror/face3.png',
                '/images/horror/skull.png',
                '/images/horror/demon.png',
                '/images/horror/scream.png'
            ];

            var selectedImage = horrorImages[Math.floor(Math.random() * horrorImages.length)];

            var img = document.createElement('img');
            img.src = selectedImage;
            img.style.cssText = `
                position: relative;
                z-index: 2;
                max-width: 80vw;
                max-height: 60vh;
                border-radius: 12px;
                animation: faceZoom 0.6s ease-out forwards, glitchImage 0.3s infinite;
                box-shadow: 0 0 100px rgba(255,0,0,0.15);
            `;
            img.onerror = function() { this.src = '/images/horror/face1.png'; };
            container.appendChild(img);

            var textDiv = document.createElement('div');
            textDiv.textContent = message || '💀 你逃不掉的...';
            textDiv.style.cssText = `
                position: relative;
                z-index: 2;
                color: #ff0000;
                font-size: 2.5rem;
                font-family: 'Courier New', monospace;
                font-weight: 900;
                text-shadow: 0 0 40px rgba(255,0,0,0.3);
                letter-spacing: 6px;
                margin-top: 1rem;
                animation: textGlitch 0.3s infinite;
                text-align: center;
            `;
            container.appendChild(textDiv);

            // 血滴背景
            var bloodDiv = document.createElement('div');
            bloodDiv.style.cssText = `
                position: absolute;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse at center, rgba(255,0,0,0.08), transparent 60%);
                animation: textPulse 0.5s ease-in-out infinite alternate;
            `;
            container.appendChild(bloodDiv);

            setTimeout(function() {
                img.remove();
                textDiv.remove();
                bloodDiv.remove();
            }, 4800);
        }

        // 7. 文字脉冲效果
        function showTextPulse(container, message) {
            var textDiv = document.createElement('div');
            textDiv.textContent = message || '💀 你逃不掉的...';
            textDiv.style.cssText = `
                position: relative;
                z-index: 2;
                color: #ff0000;
                font-size: 5rem;
                font-family: 'Courier New', monospace;
                font-weight: 900;
                text-shadow: 0 0 80px rgba(255,0,0,0.3);
                letter-spacing: 12px;
                animation: textPulse 0.3s ease-in-out infinite alternate, textGlitch 0.2s infinite;
                text-align: center;
                max-width: 90vw;
                word-wrap: break-word;
            `;
            container.appendChild(textDiv);

            // 背景脉冲
            var pulseDiv = document.createElement('div');
            pulseDiv.style.cssText = `
                position: absolute;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse at center, rgba(255,0,0,0.05), transparent 60%);
                animation: textPulse 0.5s ease-in-out infinite alternate;
            `;
            container.appendChild(pulseDiv);

            // 随机闪烁红色边框
            var borderInterval = setInterval(function() {
                if (Math.random() > 0.7) {
                    container.style.border = '3px solid rgba(255,0,0,0.2)';
                    setTimeout(function() {
                        container.style.border = 'none';
                    }, 200);
                }
            }, 500);

            setTimeout(function() {
                clearInterval(borderInterval);
                textDiv.remove();
                pulseDiv.remove();
            }, 4800);
        }

        // ============================================================
        // 点击通知项标记已读
        // ============================================================
        document.addEventListener('click', function(e) {
            const item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                const id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
