<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chris hopper</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body { background: #0A0A0F; color: #FFFFFF; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        main { padding-top: 1.5rem; padding-bottom: 3rem; }
        .container { max-width: 1200px; }
        .navbar-nav .nav-link { display: flex; align-items: center; gap: 0.3rem; }
        .nav-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; }
        .nav-avatar-placeholder { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); font-size: 0.7rem; font-weight: 600; flex-shrink: 0; }

        .notif-badge { position: absolute; top: -4px; right: -6px; background: #EC4899; color: #fff; font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 20px; min-width: 18px; text-align: center; line-height: 1.4; border: 2px solid #0A0A0F; }
        .notif-dropdown { position: absolute; top: 100%; right: 0; width: 400px; max-height: 480px; background: #1a1a2e; border-radius: 16px; border: 1px solid rgba(255,255,255,0.04); box-shadow: 0 20px 60px rgba(0,0,0,0.5); display: none; z-index: 1000; overflow: hidden; margin-top: 0.5rem; }
        .notif-dropdown.show { display: block; animation: notifSlideDown 0.25s ease; }
        @@keyframes notifSlideDown { from { opacity: 0; transform: translateY(-10px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .notif-header { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: #fff; font-weight: 600; font-size: 0.95rem; }
        .notif-mark-all { background: none; border: none; color: rgba(255,255,255,0.2); font-size: 0.75rem; cursor: pointer; transition: color 0.3s ease; }
        .notif-mark-all:hover { color: #8B5CF6; }
        .notif-list { max-height: 340px; overflow-y: auto; padding: 0.2rem 0; }
        .notif-list::-webkit-scrollbar { width: 3px; }
        .notif-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        .notif-item { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.02); cursor: pointer; transition: background 0.2s ease; }
        .notif-item:hover { background: rgba(255,255,255,0.02); }
        .notif-item.read { opacity: 0.4; }
        .notif-item .notif-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 0.2rem; }
        .notif-item .notif-dot.info { background: #4facfe; }
        .notif-item .notif-dot.success { background: #28a745; }
        .notif-item .notif-dot.warning { background: #ffc107; }
        .notif-item .notif-dot.danger { background: #dc3545; }
        .notif-item .notif-content { flex: 1; min-width: 0; }
        .notif-item .notif-title { color: #fff; font-weight: 500; font-size: 0.85rem; }
        .notif-item .notif-msg { color: rgba(255,255,255,0.4); font-size: 0.8rem; margin-top: 0.1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .notif-item .notif-time { color: rgba(255,255,255,0.15); font-size: 0.65rem; margin-top: 0.2rem; }
        .notif-empty { text-align: center; padding: 2rem; color: rgba(255,255,255,0.15); font-size: 0.9rem; }
        .notif-footer { padding: 0.6rem 1.2rem; border-top: 1px solid rgba(255,255,255,0.04); text-align: center; }
        .notif-footer a { color: rgba(255,255,255,0.2); text-decoration: none; font-size: 0.8rem; transition: color 0.3s ease; }
        .notif-footer a:hover { color: #8B5CF6; }
        .nav-item.dropdown { position: relative; }
        .nav-link-bell { position: relative; cursor: pointer; padding: 0.5rem 0.8rem; border-radius: 40px; transition: all 0.3s ease; }
        .nav-link-bell:hover { background: rgba(255,255,255,0.04); }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg nav-advanced">
        <div class="container">
            <a class="navbar-brand nav-brand" href="/"><i class="bi bi-command"></i> Chris hopper</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border:1px solid rgba(255,255,255,0.06);">
                <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                @{
                    var userId = Context.Session.GetInt32("UserId");
                    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
                    var username = Context.Session.GetString("Username");
                }
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house"></i> 首页</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Blog"><i class="bi bi-journal"></i> 博客</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About"><i class="bi bi-person"></i> 关于</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/Contact"><i class="bi bi-envelope"></i> 联系</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Message/Index"><i class="bi bi-chat"></i> 留言</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Game"><i class="bi bi-controller"></i> 游戏</a></li>

                    @if (userId.HasValue)
                    {
                        MyPersonalWebsite.Models.User? user = null;
                        string? avatarUrl = null;
                        bool isAvatarApproved = false;
                        int unreadCount = 0;
                        var notifications = new List<MyPersonalWebsite.Models.Notification>();
                        try
                        {
                            var dataSync = Context.RequestServices.GetService<MyPersonalWebsite.Services.DataSyncService>();
                            if (dataSync != null)
                            {
                                user = await dataSync.GetUserByIdAsync(userId.Value);
                                if (user != null)
                                {
                                    avatarUrl = user.AvatarUrl;
                                    isAvatarApproved = user.IsAvatarApproved;
                                }
                                notifications = await dataSync.GetNotificationsByUserIdAsync(userId.Value);
                                unreadCount = notifications.Count(n => !n.IsRead);
                            }
                        }
                        catch { }

                        @if (isAdmin == 1)
                        {
                            <li class="nav-item"><a class="nav-link" href="/Admin/Dashboard" style="color:#8B5CF6;"><i class="bi bi-speedometer2"></i> 管理</a></li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-bell" onclick="toggleNotifications(event)">
                                <i class="bi bi-bell" style="font-size:1.2rem;"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="notif-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                                }
                            </a>
                            <div class="notif-dropdown" id="notifDropdown">
                                <div class="notif-header">
                                    <span>📬 通知</span>
                                    @if (unreadCount > 0)
                                    {
                                        <button onclick="markAllRead()" class="notif-mark-all">全部已读</button>
                                    }
                                </div>
                                <div class="notif-list" id="notifList">
                                    @if (notifications.Any())
                                    {
                                        foreach (var n in notifications.Take(10))
                                        {
                                            <div class="notif-item @(n.IsRead ? "read" : "")" data-id="@n.Id" onclick="markNotifRead(@n.Id, this)">
                                                <div class="notif-dot @n.Type"></div>
                                                <div class="notif-content">
                                                    <div class="notif-title">@n.Title</div>
                                                    <div class="notif-msg">@n.Message</div>
                                                    <div class="notif-time">@n.CreatedAt.ToString("MM-dd HH:mm")</div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="notif-empty">🎉 暂无通知</div>
                                    }
                                </div>
                                <div class="notif-footer"><a href="/Home/Notifications">查看全部</a></div>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Profile">
                                @if (!string.IsNullOrEmpty(avatarUrl) && isAvatarApproved)
                                {
                                    <img src="@avatarUrl" alt="头像" class="nav-avatar" />
                                }
                                else
                                {
                                    <span class="nav-avatar-placeholder">@(username?.FirstOrDefault().ToString().ToUpper() ?? "?")</span>
                                }
                                <span>@username</span>
                            </a>
                        </li>

                        <li class="nav-item"><a class="nav-link" href="/Auth/Logout" style="color:#EC4899;"><i class="bi bi-box-arrow-right"></i></a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Auth/Login"><i class="bi bi-box-arrow-in-right"></i> 登录</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Auth/Register" style="background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;border-radius:50px;padding:0.4rem 1.2rem;">注册</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer style="border-top:1px solid rgba(255,255,255,0.03);padding:2rem 0;margin-top:2rem;">
        <div class="container text-center">
            <p style="color:rgba(255,255,255,0.3);font-size:0.85rem;">
                © 2026 <span style="background:linear-gradient(135deg,#8B5CF6,#EC4899,#F59E0B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Chris hopper</span>
                <br>
                <span style="font-size:0.75rem;color:rgba(255,255,255,0.15);">用 <i class="bi bi-heart-fill" style="color:#EC4899;"></i> 和 ASP.NET Core 10.0 构建</span>
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        // 通知下拉菜单
        function toggleNotifications(e) {
            e.preventDefault();
            e.stopPropagation();
            document.getElementById('notifDropdown').classList.toggle('show');
        }
        document.addEventListener('click', function(e) {
            var dropdown = document.getElementById('notifDropdown');
            if (dropdown && !dropdown.contains(e.target) && !e.target.closest('.nav-link-bell')) {
                dropdown.classList.remove('show');
            }
        });

        function markNotifRead(id, element) {
            if (element.classList.contains('read')) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkNotificationRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'id=' + id
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    element.classList.add('read');
                    var badge = document.querySelector('.notif-badge');
                    if (badge) {
                        var count = parseInt(badge.textContent) - 1;
                        count > 0 ? badge.textContent = count : badge.remove();
                    }
                }
            });
        }

        function markAllRead() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkAllNotificationsRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: ''
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    document.querySelectorAll('.notif-item').forEach(function(el) { el.classList.add('read'); });
                    var badge = document.querySelector('.notif-badge');
                    if (badge) badge.remove();
                    var btn = document.querySelector('.notif-mark-all');
                    if (btn) btn.remove();
                }
            });
        }

        // SignalR 连接
        (function() {
            var userId = @(Context.Session.GetInt32("UserId") ?? 0);
            var isAdmin = @(Context.Session.GetInt32("IsAdmin") ?? 0);
            if (!userId) return;

            try {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/messageHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.start()
                    .then(function() {
                        connection.invoke('UserOnline', userId);
                        console.log('✅ SignalR 已连接');
                    })
                    .catch(function(err) { console.error('❌ SignalR 连接失败:', err); });

                connection.on('OnlineUsersUpdated', function(onlineUserIds) {
                    if (isAdmin === 1) {
                        window._updateOnlineList && window._updateOnlineList(onlineUserIds);
                    }
                });

                connection.on('HorrorInvasion', function(message) {
                    triggerHorrorInvasion(message || '💀 你逃不掉的...');
                });

                connection.on('GhostEvent', function(message) {
                    showGhost(message || '👻 幽灵出没！');
                });

                connection.on('ShakeEvent', function(intensity) {
                    triggerScreenShake(intensity || 'medium');
                });

                window.addEventListener('beforeunload', function() {
                    connection.stop();
                });

            } catch (e) {
                console.log('SignalR 不可用');
            }
        })();

        // 音效合成
        function playHorrorSound() {
            try {
                var audioCtx = new(window.AudioContext || window.webkitAudioContext)();
                var convolver = audioCtx.createConvolver();
                var reverbBuffer = createReverbBuffer(audioCtx);
                convolver.buffer = reverbBuffer;
                var masterGain = audioCtx.createGain();
                masterGain.gain.value = 0.35;
                convolver.connect(masterGain);
                masterGain.connect(audioCtx.destination);

                var types = ['scream', 'whisper', 'knock', 'breath', 'laugh', 'ambient'];
                var selected = types[Math.floor(Math.random() * types.length)];

                if (selected === 'scream') {
                    var freqs = [700, 500, 900];
                    var gains = [0.35, 0.25, 0.2];
                    var durations = [0.5, 0.4, 0.6];
                    freqs.forEach(function(freq, idx) {
                        var osc = audioCtx.createOscillator();
                        var gain = audioCtx.createGain();
                        osc.type = idx === 0 ? 'sawtooth' : 'square';
                        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                        osc.frequency.exponentialRampToValueAtTime(freq * 2.5, audioCtx.currentTime + durations[idx]);
                        gain.gain.setValueAtTime(0, audioCtx.currentTime + idx * 0.02);
                        gain.gain.linearRampToValueAtTime(gains[idx], audioCtx.currentTime + 0.05 + idx * 0.02);
                        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + durations[idx] + 0.1);
                        osc.connect(gain);
                        gain.connect(convolver);
                        osc.start(audioCtx.currentTime + idx * 0.02);
                        osc.stop(audioCtx.currentTime + durations[idx] + 0.1);
                    });
                } else if (selected === 'whisper') {
                    var bufferSize = audioCtx.sampleRate * 2.5;
                    var buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                    var data = buffer.getChannelData(0);
                    for (var i = 0; i < bufferSize; i++) {
                        var env = Math.sin(i * 0.0003) * 0.5 + 0.5;
                        var modulation = Math.sin(i * 0.002) * 0.3 + 0.7;
                        data[i] = (Math.random() * 2 - 1) * (0.08 * env * modulation);
                    }
                    var source = audioCtx.createBufferSource();
                    source.buffer = buffer;
                    var gain = audioCtx.createGain();
                    gain.gain.setValueAtTime(0, audioCtx.currentTime);
                    gain.gain.linearRampToValueAtTime(0.06, audioCtx.currentTime + 0.5);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 2.8);
                    source.connect(gain);
                    gain.connect(convolver);
                    source.start();
                    source.stop(audioCtx.currentTime + 2.8);
                } else if (selected === 'knock') {
                    for (var i = 0; i < 4; i++) {
                        var delay = i * 0.4;
                        var osc = audioCtx.createOscillator();
                        var gain = audioCtx.createGain();
                        osc.type = 'square';
                        osc.frequency.setValueAtTime(250 - i * 15, audioCtx.currentTime + delay);
                        osc.frequency.setValueAtTime(80 - i * 10, audioCtx.currentTime + delay + 0.05);
                        gain.gain.setValueAtTime(0, audioCtx.currentTime + delay);
                        gain.gain.linearRampToValueAtTime(0.4 - i * 0.04, audioCtx.currentTime + delay + 0.01);
                        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + delay + 0.08);
                        osc.connect(gain);
                        gain.connect(convolver);
                        osc.start(audioCtx.currentTime + delay);
                        osc.stop(audioCtx.currentTime + delay + 0.08);
                    }
                } else if (selected === 'breath') {
                    var bufSize = audioCtx.sampleRate * 3;
                    var buf = audioCtx.createBuffer(1, bufSize, audioCtx.sampleRate);
                    var d = buf.getChannelData(0);
                    for (var i = 0; i < bufSize; i++) {
                        var env = Math.sin(i * 0.0002) * 0.5 + 0.5;
                        var pulse = Math.sin(i * 0.001) > 0 ? 1 : 0.3;
                        d[i] = (Math.random() * 2 - 1) * (0.06 * env * pulse);
                    }
                    var src = audioCtx.createBufferSource();
                    src.buffer = buf;
                    var g = audioCtx.createGain();
                    g.gain.setValueAtTime(0, audioCtx.currentTime);
                    g.gain.linearRampToValueAtTime(0.04, audioCtx.currentTime + 0.5);
                    g.gain.setValueAtTime(0.04, audioCtx.currentTime + 1.5);
                    g.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 3.2);
                    src.connect(g);
                    g.connect(convolver);
                    src.start();
                    src.stop(audioCtx.currentTime + 3.2);
                } else if (selected === 'laugh') {
                    var pitches = [300, 400, 350, 500, 450, 600];
                    var times = [0, 0.25, 0.5, 0.8, 1.05, 1.35];
                    pitches.forEach(function(p, idx) {
                        var osc = audioCtx.createOscillator();
                        var gain = audioCtx.createGain();
                        osc.type = idx % 2 === 0 ? 'sawtooth' : 'square';
                        osc.frequency.setValueAtTime(p, audioCtx.currentTime + times[idx]);
                        osc.frequency.exponentialRampToValueAtTime(p * 1.2, audioCtx.currentTime + times[idx] + 0.12);
                        gain.gain.setValueAtTime(0, audioCtx.currentTime + times[idx]);
                        gain.gain.linearRampToValueAtTime(0.06, audioCtx.currentTime + times[idx] + 0.05);
                        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + times[idx] + 0.15);
                        osc.connect(gain);
                        gain.connect(convolver);
                        osc.start(audioCtx.currentTime + times[idx]);
                        osc.stop(audioCtx.currentTime + times[idx] + 0.15);
                    });
                } else {
                    var envBufSize = audioCtx.sampleRate * 6;
                    var envBuf = audioCtx.createBuffer(1, envBufSize, audioCtx.sampleRate);
                    var envData = envBuf.getChannelData(0);
                    for (var i = 0; i < envBufSize; i++) {
                        var env = Math.sin(i * 0.0001) * 0.5 + 0.5;
                        var wind = Math.sin(i * 0.0005) * 0.3;
                        var metal = Math.sin(i * 0.001) * 0.1;
                        envData[i] = (Math.random() * 2 - 1) * 0.03 * env + wind * 0.02 + metal * 0.01;
                    }
                    var envSrc = audioCtx.createBufferSource();
                    envSrc.buffer = envBuf;
                    var envGain = audioCtx.createGain();
                    envGain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    envGain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 6);
                    envSrc.connect(envGain);
                    envGain.connect(convolver);
                    envSrc.start();
                    envSrc.stop(audioCtx.currentTime + 6);
                }
            } catch (e) { console.log('音效跳过'); }
        }

        function createReverbBuffer(audioCtx) {
            var sampleRate = audioCtx.sampleRate;
            var length = sampleRate * 1.5;
            var buffer = audioCtx.createBuffer(2, length, sampleRate);
            var left = buffer.getChannelData(0);
            var right = buffer.getChannelData(1);
            for (var i = 0; i < length; i++) {
                var decay = Math.exp(-i / (sampleRate * 0.8));
                left[i] = (Math.random() * 2 - 1) * decay * 0.5;
                right[i] = (Math.random() * 2 - 1) * decay * 0.5;
            }
            return buffer;
        }

        // ============================================================
        // ⭐ 恐怖入侵效果
        // ============================================================
        function triggerHorrorInvasion(message) {
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(function() {});
            }
            playHorrorSound();

            var textNodes = [];
            var walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        var parent = node.parentElement;
                        if (parent && !parent.closest('script') && !parent.closest('style') && node.textContent.trim().length > 0) {
                            return NodeFilter.FILTER_ACCEPT;
                        }
                        return NodeFilter.FILTER_REJECT;
                    }
                }
            );

            var node;
            while (node = walker.nextNode()) {
                textNodes.push(node);
            }

            var originalTexts = textNodes.map(function(n) { return n.textContent; });
            var glitchLevel = 0;
            var glitchChars = '!@#$%^&*()_+-=<>?/[]{}|;:,.\'"\\`~';
            var bloodChars = '🩸💀☠️👁️🔪⚰️🕷️🦇👹🔥';

            var glitchInterval = setInterval(function() {
                glitchLevel += 0.08;
                if (glitchLevel > 1) glitchLevel = 1;

                textNodes.forEach(function(node, idx) {
                    var original = originalTexts[idx] || '';
                    var glitched = '';
                    for (var i = 0; i < original.length; i++) {
                        if (Math.random() < glitchLevel && original[i] !== ' ' && original[i] !== '\n') {
                            var rand = Math.random();
                            if (rand < 0.25) {
                                glitched += bloodChars[Math.floor(Math.random() * bloodChars.length)];
                            } else {
                                glitched += glitchChars[Math.floor(Math.random() * glitchChars.length)];
                            }
                        } else {
                            glitched += original[i];
                        }
                    }
                    node.textContent = glitched;
                });

                if (glitchLevel > 0.2) {
                    document.body.style.backgroundColor = 'rgba(255,0,0,0.02)';
                    setTimeout(function() { document.body.style.backgroundColor = ''; }, 50);
                }

                if (glitchLevel >= 1) {
                    clearInterval(glitchInterval);

                    var overlay = document.createElement('div');
                    overlay.id = 'horrorOverlay';
                    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.98);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;animation:horrorFadeIn 0.3s ease;cursor:default;user-select:none;overflow:hidden;';
                    document.body.appendChild(overlay);

                    var symbols = ['😱', '👹', '💀', '👾', '🤡', '👻', '☠️', '🔪'];
                    var char = symbols[Math.floor(Math.random() * symbols.length)];

                    var bigDiv = document.createElement('div');
                    bigDiv.style.cssText = 'font-size:10rem;animation:faceZoom 0.5s ease-out forwards;filter:drop-shadow(0 0 80px rgba(255,0,0,0.3));';
                    bigDiv.textContent = char;
                    overlay.appendChild(bigDiv);

                    var textDiv = document.createElement('div');
                    textDiv.style.cssText = 'color:#ff0000;font-size:3.5rem;font-family:Courier New,monospace;font-weight:900;text-shadow:0 0 60px rgba(255,0,0,0.5);letter-spacing:8px;margin-top:0.5rem;animation:textGlitch 0.15s infinite,textPulse 0.3s infinite alternate;text-align:center;padding:0 1rem;';
                    textDiv.textContent = message || '💀 你逃不掉的...';
                    overlay.appendChild(textDiv);

                    var subDiv = document.createElement('div');
                    subDiv.style.cssText = 'color:rgba(255,0,0,0.08);font-size:0.8rem;margin-top:0.5rem;font-family:Courier New,monospace;letter-spacing:4px;animation:staticFlicker 0.15s infinite;';
                    subDiv.textContent = '⚠️ 你 已 经 被 锁 定 ⚠️';
                    overlay.appendChild(subDiv);

                    var style = document.createElement('style');
                    style.textContent =
                        '@keyframes horrorFadeIn{0%{opacity:0;transform:scale(0.9)}100%{opacity:1;transform:scale(1)}}' +
                        '@keyframes faceZoom{0%{transform:scale(0.1) rotate(-20deg);opacity:0}50%{transform:scale(1.4) rotate(5deg);opacity:1}70%{transform:scale(0.9) rotate(-3deg)}100%{transform:scale(1) rotate(0deg)}}' +
                        '@keyframes textGlitch{0%,100%{opacity:1;transform:translateX(0) skewX(0deg)}10%{opacity:0.6;transform:translateX(-12px) skewX(8deg)}20%{opacity:0.4;transform:translateX(12px) skewX(-8deg)}30%{opacity:0.7;transform:translateX(-8px) skewX(5deg)}40%{opacity:0.5;transform:translateX(8px) skewX(-5deg)}50%{opacity:0.8;transform:translateX(-5px) skewX(3deg)}60%{opacity:0.6;transform:translateX(5px) skewX(-3deg)}70%{opacity:0.7;transform:translateX(-6px) skewX(6deg)}80%{opacity:0.4;transform:translateX(6px) skewX(-6deg)}90%{opacity:0.9;transform:translateX(-3px) skewX(2deg)}}' +
                        '@keyframes textPulse{0%,100%{transform:scale(1);opacity:1}25%{transform:scale(1.08);opacity:0.7}50%{transform:scale(0.92);opacity:1}75%{transform:scale(1.05);opacity:0.8}}' +
                        '@keyframes staticFlicker{0%,100%{opacity:1}25%{opacity:0.2}50%{opacity:0.7}75%{opacity:0.1}}';
                    document.head.appendChild(style);

                    var flashInterval = setInterval(function() {
                        var flash = document.createElement('div');
                        flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,0,0,' + (Math.random() * 0.08) + ');z-index:99998;pointer-events:none;';
                        document.body.appendChild(flash);
                        setTimeout(function() { flash.remove(); }, 100);
                    }, 200);

                    setTimeout(function() {
                        clearInterval(flashInterval);
                        textNodes.forEach(function(node, idx) {
                            node.textContent = originalTexts[idx] || '';
                        });
                        if (document.fullscreenElement) {
                            document.exitFullscreen().catch(function() {});
                        }
                        var overlayEl = document.getElementById('horrorOverlay');
                        if (overlayEl) {
                            overlayEl.style.animation = 'horrorFadeIn 0.5s ease reverse';
                            setTimeout(function() {
                                overlayEl.remove();
                                if (style) style.remove();
                            }, 500);
                        }
                        document.body.style.backgroundColor = '';
                    }, 5000);
                }
            }, 80);
        }

        // ============================================================
        // ⭐ 幽灵飘过
        // ============================================================
        function showGhost(message) {
            var ghost = document.createElement('div');
            ghost.style.cssText = 'position:fixed;top:50%;left:-200px;transform:translateY(-50%);font-size:10rem;z-index:99999;pointer-events:none;animation:ghostFly 4s ease-in-out forwards;filter:drop-shadow(0 0 80px rgba(139,92,246,0.3));';
            ghost.textContent = '👻';
            document.body.appendChild(ghost);

            var text = document.createElement('div');
            text.style.cssText = 'position:fixed;top:55%;left:50%;transform:translateX(-50%);font-size:2.5rem;color:rgba(255,255,255,0.15);z-index:99999;pointer-events:none;animation:fadeText 3s ease-out forwards;font-family:Inter,sans-serif;text-shadow:0 0 60px rgba(139,92,246,0.1);letter-spacing:4px;';
            text.textContent = message;
            document.body.appendChild(text);

            var style = document.createElement('style');
            style.textContent = '@keyframes ghostFly{0%{transform:translateY(-50%) translateX(0) scale(0.8);opacity:0}10%{opacity:1}50%{transform:translateY(-40%) translateX(50vw) scale(1.3)}90%{opacity:1}100%{transform:translateY(-60%) translateX(100vw) scale(0.8);opacity:0}}@keyframes fadeText{0%{opacity:0;transform:translateX(-50%) scale(0.8)}20%{opacity:1;transform:translateX(-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translateX(-50%) scale(1.2)}}';
            document.head.appendChild(style);

            setTimeout(function() {
                ghost.remove();
                text.remove();
                style.remove();
            }, 5000);
        }

        // ============================================================
        // ⭐ 屏幕震动
        // ============================================================
        function triggerScreenShake(intensity) {
            var duration = intensity === 'hard' ? 1000 : intensity === 'medium' ? 600 : 350;
            var strength = intensity === 'hard' ? 30 : intensity === 'medium' ? 15 : 8;

            var container = document.body;
            container.style.animation = 'none';
            container.offsetHeight;

            var shakeStyle = document.createElement('style');
            shakeStyle.textContent = '@keyframes shakeScreen{0%{transform:translate(0,0) rotate(0deg)}5%{transform:translate(-' + strength + 'px,' + (strength/2) + 'px) rotate(-' + (strength/4) + 'deg)}10%{transform:translate(' + strength + 'px,-' + (strength/2) + 'px) rotate(' + (strength/4) + 'deg)}15%{transform:translate(-' + (strength*1.5) + 'px,' + strength + 'px) rotate(-' + (strength/3) + 'deg)}20%{transform:translate(' + (strength/2) + 'px,-' + (strength*1.5) + 'px) rotate(' + (strength/4) + 'deg)}25%{transform:translate(-' + (strength/2) + 'px,' + (strength/2) + 'px) rotate(-' + (strength/8) + 'deg)}30%{transform:translate(' + (strength*1.2) + 'px,-' + (strength/3) + 'px) rotate(' + (strength/6) + 'deg)}35%{transform:translate(-' + (strength*0.8) + 'px,' + (strength*0.8) + 'px) rotate(-' + (strength/5) + 'deg)}40%{transform:translate(' + (strength*0.6) + 'px,-' + (strength*0.6) + 'px) rotate(' + (strength/8) + 'deg)}50%{transform:translate(-' + (strength*0.4) + 'px,' + (strength*0.4) + 'px) rotate(-' + (strength/6) + 'deg)}60%{transform:translate(' + (strength*0.8) + 'px,-' + (strength*0.5) + 'px) rotate(' + (strength/5) + 'deg)}70%{transform:translate(-' + (strength*0.5) + 'px,' + (strength*0.6) + 'px) rotate(-' + (strength/4) + 'deg)}80%{transform:translate(' + (strength*0.3) + 'px,-' + (strength*0.3) + 'px) rotate(' + (strength/8) + 'deg)}90%{transform:translate(-' + (strength*0.2) + 'px,' + (strength*0.2) + 'px) rotate(-' + (strength/10) + 'deg)}100%{transform:translate(0,0) rotate(0deg)}}';
            document.head.appendChild(shakeStyle);

            container.style.animation = 'shakeScreen ' + duration + 'ms ease-in-out';

            var flashInterval = setInterval(function() {
                var flash = document.createElement('div');
                flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,0,0,' + (0.03 + Math.random() * 0.05) + ');z-index:99998;pointer-events:none;';
                document.body.appendChild(flash);
                setTimeout(function() { flash.remove(); }, 50);
            }, 50);

            var blackInterval = setInterval(function() {
                if (Math.random() > 0.7) {
                    var black = document.createElement('div');
                    black.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,' + (0.1 + Math.random() * 0.3) + ');z-index:99997;pointer-events:none;';
                    document.body.appendChild(black);
                    setTimeout(function() { black.remove(); }, 50);
                }
            }, 100);

            setTimeout(function() {
                clearInterval(flashInterval);
                clearInterval(blackInterval);
                container.style.animation = '';
                shakeStyle.remove();
            }, duration);
        }

        document.addEventListener('click', function(e) {
            var item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                var id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
