        // ============================================================
        // ⭐ 幽灵飘过
        // ============================================================
        function showGhost(message) {
            var ghost = document.createElement('div');
            ghost.style.cssText = 'position:fixed;top:50%;left:-200px;transform:translateY(-50%);font-size:10rem;z-index:99999;pointer-events:none;animation:ghostFly 4s ease-in-out forwards;filter:drop-shadow(0 0 80px rgba(139,92,246,0.3));';
            ghost.textContent = '👻';
            document.body.appendChild(ghost);

            var text = document.createElement('div');
            text.style.cssText = 'position:fixed;top:55%;left:50%;transform:translateX(-50%);font-size:2.5rem;color:rgba(255,255,255,0.15);z-index:99999;pointer-events:none;animation:fadeText 3s ease-out forwards;font-family:Inter,sans-serif;text-shadow:0 0 60px rgba(139,92,246,0.1);letter-spacing:4px;';
            text.textContent = message;
            document.body.appendChild(text);

            var style = document.createElement('style');
            style.textContent =
                '@keyframes ghostFly{0%{transform:translateY(-50%) translateX(0) scale(0.8);opacity:0}10%{opacity:1}50%{transform:translateY(-40%) translateX(50vw) scale(1.3)}90%{opacity:1}100%{transform:translateY(-60%) translateX(100vw) scale(0.8);opacity:0}}' +
                '@keyframes fadeText{0%{opacity:0;transform:translateX(-50%) scale(0.8)}20%{opacity:1;transform:translateX(-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translateX(-50%) scale(1.2)}}';
            document.head.appendChild(style);

            setTimeout(function() {
                ghost.remove();
                text.remove();
                style.remove();
            }, 5000);
        }

        // ============================================================
        // ⭐ 屏幕震动
        // ============================================================
        function triggerScreenShake(intensity) {
            var duration = intensity === 'hard' ? 1000 : intensity === 'medium' ? 600 : 350;
            var strength = intensity === 'hard' ? 30 : intensity === 'medium' ? 15 : 8;

            var container = document.body;
            container.style.animation = 'none';
            container.offsetHeight;

            var shakeStyle = document.createElement('style');
            shakeStyle.textContent =
                '@keyframes shakeScreen{0%{transform:translate(0,0) rotate(0deg)}5%{transform:translate(-' + strength + 'px,' + (strength/2) + 'px) rotate(-' + (strength/4) + 'deg)}10%{transform:translate(' + strength + 'px,-' + (strength/2) + 'px) rotate(' + (strength/4) + 'deg)}15%{transform:translate(-' + (strength*1.5) + 'px,' + strength + 'px) rotate(-' + (strength/3) + 'deg)}20%{transform:translate(' + (strength/2) + 'px,-' + (strength*1.5) + 'px) rotate(' + (strength/4) + 'deg)}25%{transform:translate(-' + (strength/2) + 'px,' + (strength/2) + 'px) rotate(-' + (strength/8) + 'deg)}30%{transform:translate(' + (strength*1.2) + 'px,-' + (strength/3) + 'px) rotate(' + (strength/6) + 'deg)}35%{transform:translate(-' + (strength*0.8) + 'px,' + (strength*0.8) + 'px) rotate(-' + (strength/5) + 'deg)}40%{transform:translate(' + (strength*0.6) + 'px,-' + (strength*0.6) + 'px) rotate(' + (strength/8) + 'deg)}50%{transform:translate(-' + (strength*0.4) + 'px,' + (strength*0.4) + 'px) rotate(-' + (strength/6) + 'deg)}60%{transform:translate(' + (strength*0.8) + 'px,-' + (strength*0.5) + 'px) rotate(' + (strength/5) + 'deg)}70%{transform:translate(-' + (strength*0.5) + 'px,' + (strength*0.6) + 'px) rotate(-' + (strength/4) + 'deg)}80%{transform:translate(' + (strength*0.3) + 'px,-' + (strength*0.3) + 'px) rotate(' + (strength/8) + 'deg)}90%{transform:translate(-' + (strength*0.2) + 'px,' + (strength*0.2) + 'px) rotate(-' + (strength/10) + 'deg)}100%{transform:translate(0,0) rotate(0deg)}';
            document.head.appendChild(shakeStyle);

            container.style.animation = 'shakeScreen ' + duration + 'ms ease-in-out';

            var flashInterval = setInterval(function() {
                var flash = document.createElement('div');
                flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,0,0,' + (0.03 + Math.random() * 0.05) + ');z-index:99998;pointer-events:none;';
                document.body.appendChild(flash);
                setTimeout(function() { flash.remove(); }, 50);
            }, 50);

            var blackInterval = setInterval(function() {
                if (Math.random() > 0.7) {
                    var black = document.createElement('div');
                    black.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,' + (0.1 + Math.random() * 0.3) + ');z-index:99997;pointer-events:none;';
                    document.body.appendChild(black);
                    setTimeout(function() { black.remove(); }, 50);
                }
            }, 100);

            setTimeout(function() {
                clearInterval(flashInterval);
                clearInterval(blackInterval);
                container.style.animation = '';
                shakeStyle.remove();
            }, duration);
        }

        // ============================================================
        // 点击通知项标记已读
        // ============================================================
        document.addEventListener('click', function(e) {
            const item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                const id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

