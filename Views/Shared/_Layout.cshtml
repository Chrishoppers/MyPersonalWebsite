                        var symbols = ['😱', '👹', '💀', '👾', '🤡', '👻', '☠️', '🔪'];
                        this.style.display = 'none';
                        var fallback = document.createElement('div');
                        fallback.style.cssText = 'font-size:10rem;animation:faceZoom 0.5s ease-out forwards;filter:drop-shadow(0 0 80px rgba(255,0,0,0.3));';
                        fallback.textContent = symbols[Math.floor(Math.random() * symbols.length)];
                        overlay.insertBefore(fallback, overlay.firstChild);
                    };
                    overlay.appendChild(img);

                    // ===== 恐怖文字 =====
                    var messages = [
                        '你 刚 才 关 门 了 吗 ？',
                        '镜 子 里 的 人 刚 才 笑 了',
                        '你 的 背 后 有 呼 吸 声',
                        '床 底 下 有 人 在 看 你',
                        '你 家 窗 户 外 面 站 着 人',
                        '你 的 名 字 被 人 喊 了 三 遍',
                        '你 手 机 里 多 了 一 张 照 片',
                        '你 客 厅 的 灯 自 己 亮 了',
                        '刚 才 有 人 敲 了 你 的 门',
                        '你 的 猫 在 盯 着 空 气 看',
                        '它 就 在 你 身 后 ！ ！ ！',
                        '快 跑 ！ ！ ！ 它 来 了 ！',
                        '你 已 经 被 锁 定 了 ！',
                        '别 回 头 ！ ！ ！ 别 回 头 ！',
                        '它 正 在 爬 你 的 床 ！',
                        '你 的 天 花 板 上 有 东 西',
                        '它 在 门 缝 里 看 你',
                        '你 的 脚 踝 被 抓 住 了',
                        '你 感 觉 脖 子 有 点 凉 吗',
                        '你 闻 到 烧 焦 的 味 道 了 吗',
                        '你 的 耳 朵 有 人 在 吹 气',
                        '你 的 枕 头 下 有 东 西 吗',
                        '你 的 被 子 里 有 什 么 在 动',
                        '你 的 手 机 屏 幕 裂 了 一 条 缝',
                        '⚠️ 你 被 标 记 了 ！ ！ ！',
                        '🔴 无 法 逃 离 。 。 。',
                        '💀 你 的 数 据 已 泄 露',
