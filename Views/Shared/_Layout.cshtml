                    ];
                    var finalMsg = message || messages[Math.floor(Math.random() * messages.length)];

                    var textDiv = document.createElement('div');
                    textDiv.style.cssText = 'color:#ff0000;font-size:2.8rem;font-family:Courier New,monospace;font-weight:900;text-shadow:0 0 60px rgba(255,0,0,0.5);letter-spacing:6px;margin-top:1rem;animation:textGlitch 0.15s infinite,textPulse 0.3s infinite alternate;text-align:center;padding:0 1rem;';
                    textDiv.textContent = finalMsg;
                    overlay.appendChild(textDiv);

                    var subDiv = document.createElement('div');
                    subDiv.style.cssText = 'color:rgba(255,0,0,0.06);font-size:0.8rem;margin-top:0.5rem;font-family:Courier New,monospace;letter-spacing:4px;animation:staticFlicker 0.15s infinite;';
                    subDiv.textContent = '⚠️ 你 已 经 无 法 逃 离 ⚠️';
                    overlay.appendChild(subDiv);

                    // ===== 红色闪烁 =====
                    var flashInterval = setInterval(function() {
