                    // ===== 8秒后恢复 =====
                    setTimeout(function() {
                        clearInterval(flashInterval);
                        textNodes.forEach(function(node, idx) {
                            node.textContent = originalTexts[idx] || '';
                        });
                        if (document.fullscreenElement) {
                            document.exitFullscreen().catch(function() {});
                        }
                        var overlayEl = document.getElementById('horrorOverlay');
                        if (overlayEl) {
                            overlayEl.style.animation = 'horrorFadeIn 0.5s ease reverse';
