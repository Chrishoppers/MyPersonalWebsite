<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chris hopper</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body { background: #0A0A0F; color: #FFFFFF; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        main { padding-top: 1.5rem; padding-bottom: 3rem; }
        .container { max-width: 1200px; }
        .navbar-nav .nav-link { display: flex; align-items: center; gap: 0.3rem; }
        .nav-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; }
        .nav-avatar-placeholder { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); font-size: 0.7rem; font-weight: 600; flex-shrink: 0; }

        .notif-badge { position: absolute; top: -4px; right: -6px; background: #EC4899; color: #fff; font-size: 0.6rem; font-weight: 700; padding: 0.1rem 0.4rem; border-radius: 20px; min-width: 18px; text-align: center; line-height: 1.4; border: 2px solid #0A0A0F; }
        .notif-dropdown { position: absolute; top: 100%; right: 0; width: 400px; max-height: 480px; background: #1a1a2e; border-radius: 16px; border: 1px solid rgba(255,255,255,0.04); box-shadow: 0 20px 60px rgba(0,0,0,0.5); display: none; z-index: 1000; overflow: hidden; margin-top: 0.5rem; }
        .notif-dropdown.show { display: block; animation: notifSlideDown 0.25s ease; }
        @@keyframes notifSlideDown { from { opacity: 0; transform: translateY(-10px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .notif-header { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.04); color: #fff; font-weight: 600; font-size: 0.95rem; }
        .notif-mark-all { background: none; border: none; color: rgba(255,255,255,0.2); font-size: 0.75rem; cursor: pointer; transition: color 0.3s ease; }
        .notif-mark-all:hover { color: #8B5CF6; }
        .notif-list { max-height: 340px; overflow-y: auto; padding: 0.2rem 0; }
        .notif-list::-webkit-scrollbar { width: 3px; }
        .notif-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
        .notif-item { display: flex; align-items: flex-start; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.02); cursor: pointer; transition: background 0.2s ease; }
        .notif-item:hover { background: rgba(255,255,255,0.02); }
        .notif-item.read { opacity: 0.4; }
        .notif-item .notif-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 0.2rem; }
        .notif-item .notif-dot.info { background: #4facfe; }
        .notif-item .notif-dot.success { background: #28a745; }
        .notif-item .notif-dot.warning { background: #ffc107; }
        .notif-item .notif-dot.danger { background: #dc3545; }
        .notif-item .notif-content { flex: 1; min-width: 0; }
        .notif-item .notif-title { color: #fff; font-weight: 500; font-size: 0.85rem; }
        .notif-item .notif-msg { color: rgba(255,255,255,0.4); font-size: 0.8rem; margin-top: 0.1rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .notif-item .notif-time { color: rgba(255,255,255,0.15); font-size: 0.65rem; margin-top: 0.2rem; }
        .notif-empty { text-align: center; padding: 2rem; color: rgba(255,255,255,0.15); font-size: 0.9rem; }
        .notif-footer { padding: 0.6rem 1.2rem; border-top: 1px solid rgba(255,255,255,0.04); text-align: center; }
        .notif-footer a { color: rgba(255,255,255,0.2); text-decoration: none; font-size: 0.8rem; transition: color 0.3s ease; }
        .notif-footer a:hover { color: #8B5CF6; }
        .nav-item.dropdown { position: relative; }
        .nav-link-bell { position: relative; cursor: pointer; padding: 0.5rem 0.8rem; border-radius: 40px; transition: all 0.3s ease; }
        .nav-link-bell:hover { background: rgba(255,255,255,0.04); }

        /* ⭐ 受限用户提示条 */
        .restricted-banner {
            background: linear-gradient(135deg, rgba(139,92,246,0.08), rgba(236,72,153,0.08));
            border-bottom: 1px solid rgba(139,92,246,0.06);
            padding: 0.3rem 0;
            text-align: center;
            font-size: 0.75rem;
            color: rgba(255,255,255,0.2);
        }
        .restricted-banner strong {
            color: #8B5CF6;
        }
        .restricted-banner .highlight {
            color: #EC4899;
        }
    </style>
</head>
<body>

@{
    var userId = Context.Session.GetInt32("UserId");
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    var isRestricted = Context.Session.GetInt32("IsRestricted") ?? 0;
    var username = Context.Session.GetString("Username");
    
    // ⭐ 打印调试日志
    if (isRestricted == 1)
    {
        Console.WriteLine($"🔒 受限用户访问: {Context.Request.Path}");
    }
    
    // ⭐ 受限用户允许的路径
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
    var allowedPaths = new[] { "/resource", "/auth", "/home/contact", "/home/about" };
    var isAllowedPath = allowedPaths.Any(p => currentPath.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    
    // ⭐ 如果是受限用户且不在允许路径中，重定向到资源大厅
    if (isRestricted == 1 && !isAllowedPath && !currentPath.Contains("/resource"))
    {
        Context.Response.Redirect("/Resource/Index");
        return;
    }
}

    <!-- ⭐ 受限用户顶部提示条 -->
    @if (isRestricted == 1)
    {
        <div class="restricted-banner">
            🔒 你当前处于 <strong>资源专区</strong> 模式 · 仅可访问资源相关页面
            <span class="highlight">✦</span> 如需完整访问，请联系管理员
        </div>
    }

    <nav class="navbar navbar-expand-lg nav-advanced">
        <div class="container">
            <a class="navbar-brand nav-brand" href="/">
                <i class="bi bi-command"></i> 
                @if (isRestricted == 1)
                {
                    <span>资源专区</span>
                }
                else
                {
                    <span>Chris hopper</span>
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border:1px solid rgba(255,255,255,0.06);">
                <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    
                    @if (userId.HasValue)
                    {
                        @if (isRestricted == 1)
                        {
                            <!-- ⭐⭐⭐ 受限用户：只显示资源大厅 + 退出 ⭐⭐⭐ -->
                            <li class="nav-item"><a class="nav-link" href="/Resource/Index" style="color:#8B5CF6;font-weight:600;"><i class="bi bi-box"></i> 资源大厅</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Auth/Logout" style="color:#EC4899;"><i class="bi bi-box-arrow-right"></i> 退出</a></li>
                        }
                        else
                        {
                            <!-- ⭐ 正常用户显示所有导航 -->
                            <li class="nav-item"><a class="nav-link" href="/"><i class="bi bi-house"></i> 首页</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Blog"><i class="bi bi-journal"></i> 博客</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Home/About"><i class="bi bi-person"></i> 关于</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Home/Contact"><i class="bi bi-envelope"></i> 联系</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Message/Index"><i class="bi bi-chat"></i> 留言</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Game"><i class="bi bi-controller"></i> 游戏</a></li>
                            
                            @if (isAdmin == 1)
                            {
                                <li class="nav-item"><a class="nav-link" href="/Admin/Dashboard" style="color:#8B5CF6;"><i class="bi bi-speedometer2"></i> 管理</a></li>
                            }

                            <!-- ⭐ 通知 -->
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-bell" onclick="toggleNotifications(event)">
                                    <i class="bi bi-bell" style="font-size:1.2rem;"></i>
                                    @{
                                        int unreadCount = 0;
                                        try
                                        {
                                            var dataSync = Context.RequestServices.GetService<MyPersonalWebsite.Services.DataSyncService>();
                                            if (dataSync != null)
                                            {
                                                var notifications = await dataSync.GetNotificationsByUserIdAsync(userId.Value);
                                                unreadCount = notifications.Count(n => !n.IsRead);
                                            }
                                        }
                                        catch { }
                                    }
                                    @if (unreadCount > 0)
                                    {
                                        <span class="notif-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                                    }
                                </a>
                                <div class="notif-dropdown" id="notifDropdown">
                                    <div class="notif-header">
                                        <span>📬 通知</span>
                                        @if (unreadCount > 0)
                                        {
                                            <button onclick="markAllRead()" class="notif-mark-all">全部已读</button>
                                        }
                                    </div>
                                    <div class="notif-list" id="notifList">
                                        @{
                                            try
                                            {
                                                var dataSync = Context.RequestServices.GetService<MyPersonalWebsite.Services.DataSyncService>();
                                                if (dataSync != null)
                                                {
                                                    var notifications = await dataSync.GetNotificationsByUserIdAsync(userId.Value);
                                                    if (notifications.Any())
                                                    {
                                                        foreach (var n in notifications.Take(10))
                                                        {
                                                            <div class="notif-item @(n.IsRead ? "read" : "")" data-id="@n.Id" onclick="markNotifRead(@n.Id, this)">
                                                                <div class="notif-dot @n.Type"></div>
                                                                <div class="notif-content">
                                                                    <div class="notif-title">@n.Title</div>
                                                                    <div class="notif-msg">@n.Message</div>
                                                                    <div class="notif-time">@n.CreatedAt.ToString("MM-dd HH:mm")</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <div class="notif-empty">🎉 暂无通知</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="notif-empty">🎉 暂无通知</div>
                                                }
                                            }
                                            catch
                                            {
                                                <div class="notif-empty">🎉 暂无通知</div>
                                            }
                                        }
                                    </div>
                                    <div class="notif-footer"><a href="/Home/Notifications">查看全部</a></div>
                                </div>
                            </li>

                            <!-- ⭐ 用户头像 -->
                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Profile">
                                    @{
                                        string? avatarUrl = null;
                                        bool isAvatarApproved = false;
                                        try
                                        {
                                            var dataSync = Context.RequestServices.GetService<MyPersonalWebsite.Services.DataSyncService>();
                                            if (dataSync != null)
                                            {
                                                var user = await dataSync.GetUserByIdAsync(userId.Value);
                                                if (user != null)
                                                {
                                                    avatarUrl = user.AvatarUrl;
                                                    isAvatarApproved = user.IsAvatarApproved;
                                                }
                                            }
                                        }
                                        catch { }
                                    }
                                    @if (!string.IsNullOrEmpty(avatarUrl) && isAvatarApproved)
                                    {
                                        <img src="@avatarUrl" alt="头像" class="nav-avatar" />
                                    }
                                    else
                                    {
                                        <span class="nav-avatar-placeholder">@(username?.FirstOrDefault().ToString().ToUpper() ?? "?")</span>
                                    }
                                    <span>@username</span>
                                </a>
                            </li>

                            <li class="nav-item"><a class="nav-link" href="/Auth/Logout" style="color:#EC4899;"><i class="bi bi-box-arrow-right"></i></a></li>
                        }
                    }
                    else
                    {
                        <!-- ⭐ 未登录状态 -->
                        <li class="nav-item"><a class="nav-link" href="/Auth/Login"><i class="bi bi-box-arrow-in-right"></i> 登录</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Auth/Register" style="background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;border-radius:50px;padding:0.4rem 1.2rem;">注册</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer style="border-top:1px solid rgba(255,255,255,0.03);padding:2rem 0;margin-top:2rem;">
        <div class="container text-center">
            <p style="color:rgba(255,255,255,0.3);font-size:0.85rem;">
                @if (isRestricted == 1)
                {
                    <span>© 2026 <span style="color:#8B5CF6;">Chris hopper</span> · 资源专区</span>
                }
                else
                {
                    <span>© 2026 <span style="background:linear-gradient(135deg,#8B5CF6,#EC4899,#F59E0B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Chris hopper</span></span>
                }
                <br>
                <span style="font-size:0.75rem;color:rgba(255,255,255,0.15);">用 <i class="bi bi-heart-fill" style="color:#EC4899;"></i> 和 ASP.NET Core 10.0 构建</span>
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        // ============================================================
        // 通知系统
        // ============================================================
        function toggleNotifications(e) {
            e.preventDefault();
            e.stopPropagation();
            document.getElementById('notifDropdown').classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            var dropdown = document.getElementById('notifDropdown');
            if (dropdown && !dropdown.contains(e.target) && !e.target.closest('.nav-link-bell')) {
                dropdown.classList.remove('show');
            }
        });

        function markNotifRead(id, element) {
            if (element.classList.contains('read')) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkNotificationRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'id=' + id
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    element.classList.add('read');
                    var badge = document.querySelector('.notif-badge');
                    if (badge) {
                        var count = parseInt(badge.textContent) - 1;
                        count > 0 ? badge.textContent = count : badge.remove();
                    }
                }
            });
        }

        function markAllRead() {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Home/MarkAllNotificationsRead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: ''
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    document.querySelectorAll('.notif-item').forEach(function(el) { el.classList.add('read'); });
                    var badge = document.querySelector('.notif-badge');
                    if (badge) badge.remove();
                    var btn = document.querySelector('.notif-mark-all');
                    if (btn) btn.remove();
                }
            });
        }

        // ============================================================
        // SignalR
        // ============================================================
        (function() {
            var userId = @(Context.Session.GetInt32("UserId") ?? 0);
            var isAdmin = @(Context.Session.GetInt32("IsAdmin") ?? 0);
            if (!userId) return;

            try {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/messageHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.start()
                    .then(function() {
                        connection.invoke('UserOnline', userId);
                        console.log('✅ SignalR 已连接');
                    })
                    .catch(function(err) { console.error('❌ SignalR 连接失败:', err); });

                connection.on('OnlineUsersUpdated', function(onlineUserIds) {
                    if (isAdmin === 1) {
                        window._updateOnlineList && window._updateOnlineList(onlineUserIds);
                    }
                });

                connection.on('HorrorInvasion', function(message) {
                    triggerHorrorInvasion(message || '💀 你逃不掉的...');
                });

                connection.on('GhostEvent', function(message) {
                    showGhost(message || '👻 幽灵出没！');
                });

                connection.on('ShakeEvent', function(intensity) {
                    triggerScreenShake(intensity || 'medium');
                });

                window.addEventListener('beforeunload', function() {
                    connection.stop();
                });

            } catch (e) {
                console.log('SignalR 不可用');
            }
        })();

        // ============================================================
        // 音效
        // ============================================================
        function playHorrorSound() {
            try {
                var audioCtx = new(window.AudioContext || window.webkitAudioContext)();
                var types = ['scream', 'whisper', 'knock', 'breath', 'laugh', 'ambient'];
                var selected = types[Math.floor(Math.random() * types.length)];

                if (selected === 'scream') {
                    var osc = audioCtx.createOscillator();
                    var gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(2000, audioCtx.currentTime + 0.5);
                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.8);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.8);
                } else if (selected === 'whisper') {
                    var bufferSize = audioCtx.sampleRate * 2;
                    var buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
                    var data = buffer.getChannelData(0);
                    for (var i = 0; i < bufferSize; i++) {
                        data[i] = (Math.random() * 2 - 1) * 0.08;
                    }
                    var source = audioCtx.createBufferSource();
                    source.buffer = buffer;
                    var gain = audioCtx.createGain();
                    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 2);
                    source.connect(gain);
                    gain.connect(audioCtx.destination);
                    source.start();
                    source.stop(audioCtx.currentTime + 2);
                }
            } catch(e) {}
        }

        // ============================================================
        // ⭐ 恐怖入侵
        // ============================================================
        function triggerHorrorInvasion(message) {
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(function() {});
            }
            playHorrorSound();

            var allInteractive = document.querySelectorAll('button, a, input, textarea, select, [onclick], .nav-link, .btn, .btn-glass');
            var originalPointers = [];
            allInteractive.forEach(function(el, index) {
                originalPointers[index] = el.style.pointerEvents;
                el.style.pointerEvents = 'none';
                el.style.cursor = 'default';
                if (el.tagName === 'A' || el.classList.contains('nav-link') || el.classList.contains('btn') || el.classList.contains('btn-glass')) {
                    el.style.color = 'rgba(255,255,255,0.1)';
                }
                if (el.tagName === 'BUTTON' || el.classList.contains('btn') || el.classList.contains('btn-glass')) {
                    el.style.opacity = '0.2';
                    el.style.transform = 'scale(0.95)';
                }
            });

            var textNodes = [];
            var walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        var parent = node.parentElement;
                        if (parent && !parent.closest('script') && !parent.closest('style') && node.textContent.trim().length > 0) {
                            return NodeFilter.FILTER_ACCEPT;
                        }
                        return NodeFilter.FILTER_REJECT;
                    }
                }
            );

            var node;
            while (node = walker.nextNode()) {
                var rect = node.parentElement ? node.parentElement.getBoundingClientRect() : null;
                var centerX = window.innerWidth / 2;
                var centerY = window.innerHeight / 2;
                var dist = 0;
                if (rect) {
                    var nodeCenterX = rect.left + rect.width / 2;
                    var nodeCenterY = rect.top + rect.height / 2;
                    dist = Math.sqrt(Math.pow(nodeCenterX - centerX, 2) + Math.pow(nodeCenterY - centerY, 2));
                }
                textNodes.push({
                    node: node,
                    original: node.textContent,
                    dist: dist,
                    maxDist: Math.max(window.innerWidth, window.innerHeight)
                });
            }

            var glitchChars = String.fromCharCode(33,35,36,37,94,38,42,40,41,95,43,45,61,60,62,63,47,91,93,123,125,124,59,58,44,46,34,39,92,126);
            var bloodChars = '🩸💀☠️👁️🔪⚰️🕷️🦇👹🔥';
            var startTime = Date.now();
            var duration = 12000;

            var distortionInterval = setInterval(function() {
                var elapsed = Date.now() - startTime;
                var progress = Math.min(elapsed / duration, 1);
                var intensity = progress * 15;

                var skewX = Math.sin(elapsed / 200) * intensity * 0.6;
                var skewY = Math.cos(elapsed / 250 + 1) * intensity * 0.4;
                var scaleX = 1 + Math.sin(elapsed / 300) * intensity * 0.015;
                var scaleY = 1 + Math.cos(elapsed / 350 + 2) * intensity * 0.015;
                var rotate = Math.sin(elapsed / 180) * intensity * 0.12;
                var translateX = Math.sin(elapsed / 220) * intensity * 1.5;
                var translateY = Math.cos(elapsed / 280 + 1.5) * intensity * 1.5;

                document.body.style.transform =
                    'skewX(' + skewX + 'deg) skewY(' + skewY + 'deg) ' +
                    'scale(' + scaleX + ',' + scaleY + ') ' +
                    'rotate(' + rotate + 'deg) ' +
                    'translate(' + translateX + 'px, ' + translateY + 'px)';
                document.body.style.transformOrigin = 'center center';
                document.body.style.transition = 'none';

                if (progress > 0.2 && Math.random() > 0.7) {
                    var borderIntensity = 0.05 + Math.random() * 0.15;
                    document.body.style.boxShadow = 'inset 0 0 ' + (80 + Math.random() * 150) + 'px rgba(255,0,0,' + borderIntensity + ')';
                } else {
                    document.body.style.boxShadow = 'inset 0 0 20px rgba(255,0,0,0.02)';
                }

                if (Math.random() > 0.92) {
                    document.body.style.backgroundColor = 'rgba(255,0,0,0.02)';
                    setTimeout(function() { document.body.style.backgroundColor = ''; }, 50);
                }

            }, 30);

            var glitchInterval = setInterval(function() {
                var elapsed = Date.now() - startTime;
                var progress = Math.min(elapsed / duration, 1);

                textNodes.forEach(function(item) {
                    var distRatio = item.dist / item.maxDist;
                    var threshold = progress * 1.3;
                    var glitchAmount = Math.max(0, Math.min(1, (threshold - distRatio * 0.4) * 2.5));

                    if (glitchAmount > 0) {
                        var original = item.original || '';
                        var glitched = '';
                        for (var i = 0; i < original.length; i++) {
                            if (Math.random() < glitchAmount && original[i] !== ' ' && original[i] !== '\n') {
                                var rand = Math.random();
                                if (rand < 0.08) {
                                    glitched += bloodChars[Math.floor(Math.random() * bloodChars.length)];
                                } else {
                                    glitched += glitchChars[Math.floor(Math.random() * glitchChars.length)];
                                }
                            } else {
                                glitched += original[i];
                            }
                        }
                        item.node.textContent = glitched;
                    }
                });

                if (progress >= 1) {
                    clearInterval(glitchInterval);
                    clearInterval(distortionInterval);
                    document.body.style.transform = '';
                    document.body.style.boxShadow = '';
                    document.body.style.backgroundColor = '';

                    var overlay = document.createElement('div');
                    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.97);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:default;user-select:none;overflow:hidden;';
                    overlay.id = 'horrorOverlay';
                    document.body.appendChild(overlay);

                    var images = ['ghost.png','face1.png','face2.png','face3.png','skull.png','demon.png','scream.png','blood_eyes.png'];
                    var selectedImage = images[Math.floor(Math.random() * images.length)];
                    var img = document.createElement('img');
                    img.src = '/images/horror/' + selectedImage;
                    img.style.cssText = 'max-width:85vw;max-height:65vh;border-radius:12px;box-shadow:0 0 150px rgba(255,0,0,0.2);';
                    img.onerror = function() {
                        this.style.display = 'none';
                        var fallback = document.createElement('div');
                        fallback.style.cssText = 'font-size:10rem;';
                        fallback.textContent = '💀';
                        overlay.insertBefore(fallback, overlay.firstChild);
                    };
                    overlay.appendChild(img);

                    var scale = 0.05;
                    var scaleInterval = setInterval(function() {
                        scale += 0.07;
                        if (scale >= 1) {
                            scale = 1;
                            clearInterval(scaleInterval);
                        }
                        img.style.transform = 'scale(' + scale + ') rotate(' + (scale * 15 - 15) + 'deg)';
                    }, 20);

                    var shakeInterval = setInterval(function() {
                        if (Math.random() > 0.4) {
                            var dx = (Math.random() - 0.5) * 30;
                            var dy = (Math.random() - 0.5) * 30;
                            var dr = (Math.random() - 0.5) * 8;
                            img.style.transform += ' translate(' + dx + 'px, ' + dy + 'px) rotate(' + dr + 'deg)';
                            setTimeout(function() {
                                img.style.transform = img.style.transform.replace(/translate\([^)]*\)/g, '').replace(/rotate\([^)]*\)/g, '');
                            }, 50);
                        }
                    }, 100);

                    var messages = [
                        '你 刚 才 关 门 了 吗 ？',
                        '镜 子 里 的 人 刚 才 笑 了',
                        '你 的 背 后 有 呼 吸 声',
                        '床 底 下 有 人 在 看 你',
                        '你 家 窗 户 外 面 站 着 人',
                        '它 就 在 你 身 后 ！ ！ ！',
                        '快 跑 ！ ！ ！ 它 来 了 ！',
                        '你 已 经 被 锁 定 了 ！',
                        '别 回 头 ！ ！ ！ 别 回 头 ！',
                        '它 正 在 爬 你 的 床 ！',
                        '你 的 天 花 板 上 有 东 西',
                        '⚠️ 你 被 标 记 了 ！ ！ ！',
                        '🔴 无 法 逃 离 。 。 。',
                        '💀 你 的 数 据 已 泄 露',
                        '🔴 它 已 经 进 入 你 的 大 脑'
                    ];
                    var finalMsg = message || messages[Math.floor(Math.random() * messages.length)];

                    var textDiv = document.createElement('div');
                    textDiv.style.cssText = 'color:#ff0000;font-size:3rem;font-family:Courier New,monospace;font-weight:900;text-shadow:0 0 80px rgba(255,0,0,0.5);letter-spacing:8px;margin-top:1rem;text-align:center;padding:0 1rem;';
                    textDiv.textContent = finalMsg;
                    overlay.appendChild(textDiv);

                    var textDistortion = setInterval(function() {
                        var time = Date.now() / 1000;
                        var skew = Math.sin(time * 2.5) * 5;
                        var scaleX = 1 + Math.sin(time * 2) * 0.08;
                        var scaleY = 1 + Math.cos(time * 2.3) * 0.08;
                        var opacity = 0.6 + Math.sin(time * 3.5) * 0.4;
                        var translateX = Math.sin(time * 1.7) * 10;
                        textDiv.style.transform = 'skewX(' + skew + 'deg) scale(' + scaleX + ',' + scaleY + ') translateX(' + translateX + 'px)';
                        textDiv.style.opacity = opacity;
                        var colors = ['#ff0000', '#cc0000', '#ff2200', '#ff0044'];
                        textDiv.style.color = colors[Math.floor(Math.abs(Math.sin(time * 1.3)) * colors.length)];
                        textDiv.style.letterSpacing = (6 + Math.sin(time * 1.8) * 4) + 'px';
                    }, 60);

                    var subDiv = document.createElement('div');
                    subDiv.style.cssText = 'color:rgba(255,0,0,0.06);font-size:0.8rem;margin-top:0.5rem;font-family:Courier New,monospace;letter-spacing:4px;';
                    subDiv.textContent = '⚠️ 你 已 经 无 法 逃 离 ⚠️';
                    overlay.appendChild(subDiv);

                    var flashInterval = setInterval(function() {
                        var flash = document.createElement('div');
                        flash.style.cssText = 'position:fixed;inset:0;background:rgba(255,0,0,' + (0.05 + Math.random() * 0.12) + ');z-index:99998;pointer-events:none;';
                        document.body.appendChild(flash);
                        setTimeout(function() { flash.remove(); }, 80);
                    }, 150);

                    setTimeout(function() {
                        clearInterval(flashInterval);
                        clearInterval(shakeInterval);
                        clearInterval(textDistortion);
                        textNodes.forEach(function(item) {
                            item.node.textContent = item.original || '';
                        });

                        allInteractive.forEach(function(el, index) {
                            el.style.pointerEvents = originalPointers[index] || '';
                            el.style.cursor = '';
                            if (el.tagName === 'A' || el.classList.contains('nav-link') || el.classList.contains('btn') || el.classList.contains('btn-glass')) {
                                el.style.color = '';
                            }
                            if (el.tagName === 'BUTTON' || el.classList.contains('btn') || el.classList.contains('btn-glass')) {
                                el.style.opacity = '';
                                el.style.transform = '';
                            }
                        });

                        if (document.fullscreenElement) {
                            document.exitFullscreen().catch(function() {});
                        }
                        var overlayEl = document.getElementById('horrorOverlay');
                        if (overlayEl) {
                            overlayEl.remove();
                        }
                        document.body.style.transform = '';
                        document.body.style.boxShadow = '';
                        document.body.style.backgroundColor = '';
                    }, 4000);
                }
            }, 50);
        }

        // ============================================================
        // ⭐ 幽灵飘过
        // ============================================================
        function showGhost(message) {
            var ghost = document.createElement('div');
            ghost.style.cssText = 'position:fixed;top:50%;left:-200px;transform:translateY(-50%);font-size:10rem;z-index:99999;pointer-events:none;';
            ghost.textContent = '👻';
            document.body.appendChild(ghost);

            var startTime = Date.now();
            var ghostInterval = setInterval(function() {
                var elapsed = (Date.now() - startTime) / 1000;
                var progress = elapsed / 4;
                if (progress >= 1) {
                    clearInterval(ghostInterval);
                    ghost.remove();
                    return;
                }
                ghost.style.left = (progress * 100 - 20) + '%';
                ghost.style.opacity = progress < 0.1 ? progress * 10 : progress > 0.9 ? (1 - progress) * 10 : 1;
                ghost.style.transform = 'translateY(-50%) scale(' + (0.8 + progress * 0.5) + ')';
            }, 50);
        }

        // ============================================================
        // ⭐ 屏幕震动
        // ============================================================
        function triggerScreenShake(intensity) {
            var duration = intensity === 'hard' ? 800 : intensity === 'medium' ? 500 : 300;
            var strength = intensity === 'hard' ? 25 : intensity === 'medium' ? 12 : 6;

            var container = document.body;
            var startTime = Date.now();
            var shakeInterval = setInterval(function() {
                var elapsed = (Date.now() - startTime) / duration;
                if (elapsed >= 1) {
                    clearInterval(shakeInterval);
                    container.style.transform = '';
                    container.style.backgroundColor = '';
                    return;
                }
                var intensity2 = (1 - elapsed) * strength;
                var x = (Math.random() - 0.5) * intensity2 * 2;
                var y = (Math.random() - 0.5) * intensity2 * 2;
                container.style.transform = 'translate(' + x + 'px, ' + y + 'px) rotate(' + (x / 5) + 'deg)';
                if (Math.random() > 0.7) {
                    container.style.backgroundColor = 'rgba(255,0,0,' + (0.02 + Math.random() * 0.05) + ')';
                }
            }, 30);

            setTimeout(function() {
                clearInterval(shakeInterval);
                container.style.transform = '';
                container.style.backgroundColor = '';
            }, duration + 100);
        }

        document.addEventListener('click', function(e) {
            var item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                var id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
