                    15% { transform: translate(${-strength*1.5}px, ${strength}px) rotate(${-strength/3}deg); }
                    20% { transform: translate(${strength/2}px, ${-strength*1.5}px) rotate(${strength/4}deg); }
                    25% { transform: translate(${-strength/2}px, ${strength/2}px) rotate(${-strength/8}deg); }
                    30% { transform: translate(${strength*1.2}px, ${-strength/3}px) rotate(${strength/6}deg); }
                    35% { transform: translate(${-strength*0.8}px, ${strength*0.8}px) rotate(${-strength/5}deg); }
                    40% { transform: translate(${strength*0.6}px, ${-strength*0.6}px) rotate(${strength/8}deg); }
                    50% { transform: translate(${-strength*0.4}px, ${strength*0.4}px) rotate(${-strength/6}deg); }
                    60% { transform: translate(${strength*0.8}px, ${-strength*0.5}px) rotate(${strength/5}deg); }
                    70% { transform: translate(${-strength*0.5}px, ${strength*0.6}px) rotate(${-strength/4}deg); }
                    80% { transform: translate(${strength*0.3}px, ${-strength*0.3}px) rotate(${strength/8}deg); }
                    90% { transform: translate(${-strength*0.2}px, ${strength*0.2}px) rotate(${-strength/10}deg); }
                    100% { transform: translate(0, 0) rotate(0deg); }
                }
            `;
            document.head.appendChild(shakeStyle);

            container.style.animation = `shakeScreen ${duration}ms ease-in-out`;

            // 红色闪烁
            var flashInterval = setInterval(function() {
                var flash = document.createElement('div');
                flash.style.cssText = `
                    position: fixed;
                    inset: 0;
                    background: rgba(255, 0, 0, ${0.03 + Math.random() * 0.05});
                    z-index: 99998;
                    pointer-events: none;
                `;
                document.body.appendChild(flash);
                setTimeout(function() { flash.remove(); }, 50);
            }, 50);

            // 黑屏闪烁
            var blackInterval = setInterval(function() {
                if (Math.random() > 0.7) {
                    var black = document.createElement('div');
                    black.style.cssText = `
                        position: fixed;
                        inset: 0;
                        background: rgba(0, 0, 0, ${0.1 + Math.random() * 0.3});
                        z-index: 99997;
                        pointer-events: none;
                    `;
                    document.body.appendChild(black);
                    setTimeout(function() { black.remove(); }, 50);
                }
            }, 100);

            setTimeout(function() {
                clearInterval(flashInterval);
                clearInterval(blackInterval);
                container.style.animation = '';
                shakeStyle.remove();
            }, duration);
        }

        // ============================================================
        // 点击通知项标记已读
        // ============================================================
        document.addEventListener('click', function(e) {
            const item = e.target.closest('.notif-item');
            if (item && !item.classList.contains('read')) {
                const id = item.dataset.id;
                if (id) {
                    markNotifRead(id, item);
                }
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
