            var textNodes = [];
            var walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        var parent = node.parentElement;
                        if (parent && !parent.closest('script') && !parent.closest('style') && node.textContent.trim().length > 0) {
                            return NodeFilter.FILTER_ACCEPT;
                        }
                        return NodeFilter.FILTER_REJECT;
                    }
                }
            );

            var node;
            while (node = walker.nextNode()) {
                textNodes.push(node);
            }

            var originalTexts = textNodes.map(function(n) { return n.textContent; });
