@{
    ViewData["Title"] = "🎮 游戏中心";
    var username = ViewBag.Username as string ?? "玩家";
}

<style>
    .game-center {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
    }

    .game-header {
        text-align: center;
        padding: 2rem 0 1.5rem;
    }

    .game-header h1 {
        font-size: 2.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.3rem;
    }

    .game-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 1rem;
    }

    .game-header .user-greeting {
        color: rgba(255,255,255,0.15);
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .game-card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 1.8rem 1.8rem 1.5rem;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
        overflow: hidden;
        min-height: 200px;
    }
</style>

<div class="game-center">

    <!-- ===== 头部 ===== -->
    <div class="game-header">
        <h1>🎮 游戏中心</h1>
        <p class="subtitle">选择你想玩的游戏，放松一下！</p>
        <p class="user-greeting">👋 欢迎回来，<strong>@username</strong></p>
    </div>

    <!-- ===== 游戏卡片网格 ===== -->
    <div class="game-grid">

        <!-- 日常题卡示例 -->
        <a href="/DailyQuestion" class="game-card" style="--card-gradient: linear-gradient(135deg, #8B5CF6, #EC4899);">
            <span class="card-status active">✅ 已上线</span>
            <span class="card-icon">📚</span>
            <div class="card-title">每日一问</div>
            <div class="card-desc">每天一道冷知识，答对积分+10，连续答对有奖励！</div>
            <div class="card-meta">
                <span class="tag hot">🔥 热门</span>
                <span class="tag">🧠 知识</span>
            </div>
        </a>

        <!-- 包含拍题卡片 -->
        @Html.Partial("_SolverCardFragment")

    </div>
</div>
