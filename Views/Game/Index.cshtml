@{
    ViewData["Title"] = "🎮 游戏中心";
    var username = ViewBag.Username as string ?? "玩家";
}

<style>
    .game-center {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
    }

    .game-header {
        text-align: center;
        padding: 2rem 0 1.5rem;
    }

    .game-header h1 {
        font-size: 2.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.3rem;
    }

    .game-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 1rem;
    }

    .game-header .user-greeting {
        color: rgba(255,255,255,0.15);
        font-size: 0.85rem;
        margin-top: 0.3rem;
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
    }

    .game-card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 1.8rem 1.8rem 1.5rem;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
        overflow: hidden;
        min-height: 200px;
    }

    .game-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--card-gradient, linear-gradient(135deg, #8B5CF6, #EC4899));
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .game-card:hover {
        transform: translateY(-8px);
        border-color: rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
    }

    .game-card:hover::before {
        opacity: 1;
    }

    .game-card .card-icon {
        font-size: 2.8rem;
        display: block;
        margin-bottom: 0.5rem;
    }

    .game-card .card-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.2rem;
    }

    .game-card .card-desc {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.3);
        line-height: 1.5;
        margin-bottom: 0.8rem;
    }

    .game-card .card-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.15);
    }

    .game-card .card-meta .tag {
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .game-card .card-meta .tag.hot {
        background: rgba(236,72,153,0.12);
        color: #EC4899;
        border-color: rgba(236,72,153,0.06);
    }

    .game-card .card-meta .tag.new {
        background: rgba(40,167,69,0.12);
        color: #28a745;
        border-color: rgba(40,167,69,0.06);
    }

    .game-card .card-meta .tag.coming {
        background: rgba(255,193,7,0.08);
        color: #ffc107;
        border-color: rgba(255,193,7,0.04);
    }

    .game-card .card-status {
        position: absolute;
        top: 1rem;
        right: 1.2rem;
        font-size: 0.65rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
    }

    .game-card .card-status.active {
        background: rgba(40,167,69,0.1);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.06);
    }

    .game-card .card-status.coming {
        background: rgba(255,193,7,0.08);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.04);
    }

    .game-card.disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .game-card.disabled:hover {
        transform: none;
        background: rgba(255,255,255,0.02);
    }

    .game-card.disabled::before {
        display: none;
    }

    .stats-mini {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 2rem;
        padding: 1rem 0;
        border-top: 1px solid rgba(255,255,255,0.03);
    }

    .stats-mini .stat-item {
        color: rgba(255,255,255,0.15);
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .stats-mini .stat-item strong {
        color: rgba(255,255,255,0.5);
        font-weight: 600;
    }

    @@media (max-width: 640px) {
        .game-header h1 { font-size: 2rem; }
        .game-grid { grid-template-columns: 1fr; gap: 1rem; }
        .game-card { min-height: 160px; padding: 1.2rem 1.2rem; }
        .game-card .card-icon { font-size: 2.2rem; }
        .stats-mini { gap: 1rem; flex-wrap: wrap; }
    }

    @@media (max-width: 400px) {
        .game-header h1 { font-size: 1.6rem; }
        .game-card .card-title { font-size: 1rem; }
        .game-card .card-desc { font-size: 0.75rem; }
    }
</style>

<div class="game-center">

    <!-- ===== 头部 ===== -->
    <div class="game-header">
        <h1>🎮 游戏中心</h1>
        <p class="subtitle">选择你想玩的游戏，放松一下！</p>
        <p class="user-greeting">👋 欢迎回来，<strong>@username</strong></p>
    </div>

    <!-- ===== 游戏卡片网格 ===== -->
    <div class="game-grid">

        <!-- ============================================================
             游戏1：每日一问（已上线）
             ============================================================ -->
        <a href="/DailyQuestion" class="game-card" style="--card-gradient: linear-gradient(135deg, #8B5CF6, #EC4899);">
            <span class="card-status active">✅ 已上线</span>
            <span class="card-icon">📚</span>
            <div class="card-title">每日一问</div>
            <div class="card-desc">每天一道冷知识，答对积分+10，连续答对有奖励！</div>
            <div class="card-meta">
                <span class="tag hot">🔥 热门</span>
                <span class="tag">🧠 知识</span>
            </div>
        </a>

        <!-- ============================================================
             游戏2：游戏建议（已上线）
             ============================================================ -->
        <a href="/GameSuggestion" class="game-card" style="--card-gradient: linear-gradient(135deg, #F59E0B, #F97316);">
            <span class="card-status active">💡 建议</span>
            <span class="card-icon">💡</span>
            <div class="card-title">游戏建议</div>
            <div class="card-desc">有什么想玩的游戏？告诉我们，大家投票决定开发顺序！</div>
            <div class="card-meta">
                <span class="tag hot">🔥 热门</span>
                <span class="tag">💬 互动</span>
            </div>
        </a>

        <!-- ============================================================
             智能拍题入口（小卡片，不破坏布局）
             ============================================================ -->
        <a href="/Solver/Index" class="game-card" style="--card-gradient: linear-gradient(135deg, #06B6D4, #3B82F6); min-height:96px; padding:12px; display:flex; align-items:center; gap:12px;">
            <div style="font-size:1.6rem">📸</div>
            <div>
                <div style="font-weight:700">智能拍题</div>
                <div style="font-size:0.85rem; color:rgba(255,255,255,0.6)">拍照/上传试题，智能识别并逐题解答</div>
            </div>
        </a>

        <!-- ============================================================
             游戏3：人机验证大挑战（⭐ 新增）
             ============================================================ -->
       <a href="/VerifyGame" class="game-card" style="--card-gradient: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);">
    <span class="card-status active">✅ 已上线</span>
    <span class="card-icon">🧩</span>
    <div class="card-title">验证大闯关</div>
    <div class="card-desc">20种验证模式×5关，共100关！难度递增，挑战你的极限！</div>
    <div class="card-meta">
        <span class="tag hot">🔥 热门</span>
        <span class="tag">🧠 脑力</span>
        <span class="tag">🏆 100关</span>
    </div>
</a>
<!-- ===== 多人派对入口（新增） ===== -->
<a href="/Party/Host" class="game-card" style="--card-gradient: linear-gradient(135deg, #00F0FF, #7B61FF, #FF006E);">
    <span class="card-status active" style="background:rgba(0,240,255,0.08);color:#00F0FF;border-color:rgba(0,240,255,0.04);">
        🎉 内测
    </span>
    <span class="card-icon">👥</span>
    <div class="card-title">多人派对</div>
    <div class="card-desc">创建房间，扫码组队，一起挑战！支持 2-20 人实时对战</div>
    <div class="card-meta">
        <span class="tag hot" style="background:rgba(0,240,255,0.08);color:#00F0FF;border-color:rgba(0,240,255,0.04);">🔥 内测</span>
        <span class="tag" style="background:rgba(123,97,255,0.06);color:#7B61FF;">👥 多人</span>
        <span class="tag" style="background:rgba(255,0,110,0.04);color:#FF006E;">⚡ 实时</span>
    </div>
</a>

        <!-- ============================================================
             游戏4：成语填空（开发中）
             ============================================================ -->
        <div class="game-card disabled" style="--card-gradient: linear-gradient(135deg, #F59E0B, #F97316);">
            <span class="card-status coming">🚧 开发中</span>
            <span class="card-icon">📝</span>
            <div class="card-title">成语填空</div>
            <div class="card-desc">补全成语中的空缺字，测试你的成语储备！</div>
            <div class="card-meta">
                <span class="tag coming">⏳ 即将上线</span>
                <span class="tag">📖 语文</span>
            </div>
        </div>

        <!-- ============================================================
             游戏5：打字速度测试（开发中）
             ============================================================ -->
        <div class="game-card disabled" style="--card-gradient: linear-gradient(135deg, #10B981, #34D399);">
            <span class="card-status coming">🚧 开发中</span>
            <span class="card-icon">⌨️</span>
            <div class="card-title">打字速度测试</div>
            <div class="card-desc">测试你的打字速度，看看每分钟能打多少个字！</div>
            <div class="card-meta">
                <span class="tag coming">⏳ 即将上线</span>
                <span class="tag">⌨️ 挑战</span>
            </div>
        </div>

        <!-- ============================================================
             游戏6：记忆翻牌（开发中）
             ============================================================ -->
        <div class="game-card disabled" style="--card-gradient: linear-gradient(135deg, #8B5CF6, #A78BFA);">
            <span class="card-status coming">🚧 开发中</span>
            <span class="card-icon">🃏</span>
            <div class="card-title">记忆翻牌</div>
            <div class="card-desc">翻转卡片，配对相同的图案，考验你的记忆力！</div>
            <div class="card-meta">
                <span class="tag coming">⏳ 即将上线</span>
                <span class="tag">🧠 记忆</span>
            </div>
        </div>

        <!-- ============================================================
             游戏7：谁是卧底？（开发中）
             ============================================================ -->
        <div class="game-card disabled" style="--card-gradient: linear-gradient(135deg, #EC4899, #F472B6);">
            <span class="card-status coming">🚧 开发中</span>
            <span class="card-icon">🕵️</span>
            <div class="card-title">谁是卧底？</div>
            <div class="card-desc">找出隐藏在人群中的卧底，考验你的观察力！</div>
            <div class="card-meta">
                <span class="tag coming">⏳ 即将上线</span>
                <span class="tag">🕵️ 推理</span>
            </div>
        </div>

        <!-- ============================================================
             游戏8：单词挑战（开发中）
             ============================================================ -->
        <div class="game-card disabled" style="--card-gradient: linear-gradient(135deg, #06B6D4, #3B82F6);">
            <span class="card-status coming">🚧 开发中</span>
            <span class="card-icon">🔤</span>
            <div class="card-title">单词挑战</div>
            <div class="card-desc">看中文说英文，测试你的词汇量！</div>
            <div class="card-meta">
                <span class="tag coming">⏳ 即将上线</span>
                <span class="tag">🌍 语言</span>
            </div>
        </div>

    </div>

    <!-- ===== 底部统计 ===== -->
    <div class="stats-mini">
        <span class="stat-item">🎮 已上线 <strong>3</strong> 款</span>
        <span class="stat-item">🚧 开发中 <strong>5</strong> 款</span>
        <span class="stat-item">📅 最后更新 <strong>@DateTime.Now.ToString("yyyy年MM月dd日")</strong></span>
    </div>

</div>

