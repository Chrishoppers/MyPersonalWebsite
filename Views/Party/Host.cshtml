@{
    Layout = null;
    ViewData["Title"] = "✦ 全息派对中枢 ✦";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>✦ 全息派对中枢 ✦</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局重置
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
        }

        /* ===== 粒子背景 ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        #particleCanvas2 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        /* ===== 网格背景 ===== */
        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.008) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.008) 1px, transparent 1px);
            background-size: 60px 60px;
            opacity: 0.5;
        }

        /* ============================================================
           主容器
           ============================================================ */
        .container {
            position: relative;
            z-index: 1;
            width: 100vw;
            height: 100vh;
            max-width: 100%;
            max-height: 100%;
            padding: 1.5vh 2vw;
            display: flex;
            flex-direction: column;
        }

        /* ============================================================
           头部 - 全息风格
           ============================================================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5vh 0 1vh;
            border-bottom: 1px solid rgba(0, 240, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 8px;
        }

        .header .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .brand .logo-icon {
            font-size: clamp(1.5rem, 2.5vw, 3rem);
            animation: logoFloat 4s ease-in-out infinite;
        }

        @@keyframes logoFloat {
            0%, 100% { transform: rotate(-3deg) scale(1); }
            50% { transform: rotate(3deg) scale(1.05); }
        }

        .header .brand h1 {
            font-size: clamp(1.2rem, 2vw, 2.4rem);
            font-weight: 900;
            background: linear-gradient(135deg, #00F0FF, #7B61FF, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 0.02em;
        }

        .header .brand .sub {
            font-size: clamp(0.4rem, 0.5vw, 0.6rem);
            color: rgba(0, 240, 255, 0.06);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            display: block;
            margin-top: -2px;
        }

        .header .status-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .header .status-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 14px;
            border-radius: 40px;
            font-size: clamp(0.5rem, 0.7vw, 0.8rem);
            font-weight: 500;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
            color: rgba(255,255,255,0.15);
        }

        .header .status-badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 2s infinite;
        }

        .header .status-badge .dot.online { background: #00FF88; }
        .header .status-badge .dot.waiting { background: #F59E0B; }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.2); }
        }

        .header .room-code-display {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 16px 4px 12px;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.02);
            border: 1px solid rgba(0, 240, 255, 0.04);
        }

        .header .room-code-display .label {
            font-size: clamp(0.35rem, 0.4vw, 0.5rem);
            color: rgba(255,255,255,0.06);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .header .room-code-display .code {
            font-family: 'Courier New', monospace;
            font-size: clamp(0.8rem, 1.2vw, 1.4rem);
            font-weight: 800;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 3px;
        }

        .header .admin-badge {
            padding: 3px 14px;
            border-radius: 40px;
            font-size: clamp(0.4rem, 0.5vw, 0.6rem);
            font-weight: 600;
            background: rgba(139,92,246,0.06);
            border: 1px solid rgba(139,92,246,0.04);
            color: #8B5CF6;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* ============================================================
           主布局
           ============================================================ */
        .main-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 20px;
            padding: 1vh 0;
            min-height: 0;
        }

        @@media (max-width: 1100px) {
            .main-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }
        }

        /* ============================================================
           全息房间卡
           ============================================================ */
        .holo-card {
            background: rgba(255,255,255,0.015);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0, 240, 255, 0.04);
            border-radius: 24px;
            padding: 1.2rem 1.5rem;
            position: relative;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0,240,255,0.01), transparent 70%);
            pointer-events: none;
        }

        .holo-card .card-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0,240,255,0.08), rgba(123,97,255,0.08), transparent);
            animation: glowPulse 3s ease-in-out infinite;
        }

        @@keyframes glowPulse {
            0%, 100% { opacity: 0.3; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.2); }
        }

        .holo-card .corner {
            position: absolute;
            width: 14px;
            height: 14px;
            border-color: rgba(0, 240, 255, 0.04);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }

        .holo-card .corner.tl { top: 10px; left: 10px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 10px; right: 10px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 10px; left: 10px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 10px; right: 10px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        .holo-card .card-title {
            font-size: clamp(0.5rem, 0.6vw, 0.7rem);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.06);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .holo-card .card-title .accent {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent);
        }

        /* ============================================================
           中间 - 全息二维码 + 房间信息
           ============================================================ */
        .center-section {
            display: flex;
            flex-direction: column;
            gap: 1vh;
            height: 100%;
        }

        .qr-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        .qr-section #qrcode {
            position: relative;
            z-index: 1;
            padding: 8px;
            background: rgba(0,240,255,0.01);
            border-radius: 20px;
            border: 1px solid rgba(0,240,255,0.02);
        }

        .qr-section #qrcode canvas {
            display: block;
            border-radius: 12px;
        }

        .qr-section .qr-hint {
            font-size: clamp(0.4rem, 0.5vw, 0.6rem);
            color: rgba(255,255,255,0.03);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-top: 0.5rem;
        }

        .qr-section .qr-url {
            font-size: clamp(0.3rem, 0.35vw, 0.4rem);
            color: rgba(255,255,255,0.02);
            font-family: 'Courier New', monospace;
            margin-top: 0.2rem;
            max-width: 80%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ============================================================
           右侧面板
           ============================================================ */
        .side-panel {
            display: flex;
            flex-direction: column;
            gap: 1vh;
            height: 100%;
        }

        .side-panel .panel-card {
            flex: 1;
            min-height: 0;
        }

        .side-panel .panel-card:last-child {
            flex: 0.6;
        }

        /* ===== 玩家列表 - 全息风格 ===== */
        .player-list {
            overflow-y: auto;
            max-height: 100%;
            padding-right: 4px;
        }

        .player-list::-webkit-scrollbar {
            width: 3px;
        }

        .player-list::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.01);
            border-radius: 10px;
        }

        .player-list::-webkit-scrollbar-thumb {
            background: rgba(0,240,255,0.06);
            border-radius: 10px;
        }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.4rem 0.6rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            margin-bottom: 4px;
            position: relative;
            overflow: hidden;
        }

        .player-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(180deg, #00F0FF, #7B61FF);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .player-item:hover::before {
            opacity: 0.3;
        }

        .player-item:hover {
            background: rgba(255,255,255,0.02);
            border-color: rgba(0,240,255,0.04);
        }

        .player-item .avatar {
            font-size: clamp(1rem, 1.2vw, 1.5rem);
            width: 32px;
            text-align: center;
            flex-shrink: 0;
        }

        .player-item .info {
            flex: 1;
            min-width: 0;
        }

        .player-item .info .name {
            color: rgba(255,255,255,0.3);
            font-size: clamp(0.65rem, 0.7vw, 0.85rem);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .player-item .info .name .host-tag {
            font-size: 0.4rem;
            padding: 0.05rem 0.5rem;
            border-radius: 20px;
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
            border: 1px solid rgba(139,92,246,0.04);
            font-weight: 600;
        }

        .player-item .info .name .admin-tag {
            font-size: 0.4rem;
            padding: 0.05rem 0.5rem;
            border-radius: 20px;
            background: rgba(0,240,255,0.04);
            color: #00F0FF;
            border: 1px solid rgba(0,240,255,0.02);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .player-item .info .name .admin-tag:hover {
            background: rgba(0,240,255,0.08);
            color: #00F0FF;
        }

        .player-item .status {
            font-size: clamp(0.4rem, 0.5vw, 0.55rem);
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 20px;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .player-item .status.ready {
            background: rgba(0,255,136,0.06);
            color: #00FF88;
            border: 1px solid rgba(0,255,136,0.03);
        }

        .player-item .status.waiting {
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.02);
        }

        .player-item .status.host {
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
            border: 1px solid rgba(139,92,246,0.03);
        }

        .player-item .status.admin {
            background: rgba(0,240,255,0.04);
            color: #00F0FF;
            border: 1px solid rgba(0,240,255,0.02);
        }

        .player-item .actions {
            display: flex;
            gap: 4px;
            flex-shrink: 0;
        }

        .player-item .actions .btn-mini {
            padding: 2px 8px;
            border: none;
            border-radius: 20px;
            font-size: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.06);
        }

        .player-item .actions .btn-mini:hover {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.15);
        }

        .player-item .actions .btn-mini.promote {
            background: rgba(0,240,255,0.03);
            color: rgba(0,240,255,0.1);
        }

        .player-item .actions .btn-mini.promote:hover {
            background: rgba(0,240,255,0.06);
            color: #00F0FF;
        }

        .player-item .actions .btn-mini.kick {
            background: rgba(220,53,69,0.02);
            color: rgba(220,53,69,0.06);
        }

        .player-item .actions .btn-mini.kick:hover {
            background: rgba(220,53,69,0.04);
            color: #dc3545;
        }

        .player-item .actions .btn-mini:disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }

        .player-empty {
            color: rgba(255,255,255,0.02);
            font-size: clamp(0.5rem, 0.6vw, 0.7rem);
            text-align: center;
            padding: 1rem 0;
            letter-spacing: 0.1em;
        }

        /* ============================================================
           统计行
           ============================================================ */
        .stats-row {
            display: flex;
            gap: 1.5rem;
            padding: 0.5rem 0;
            flex-wrap: wrap;
        }

        .stats-row .stat-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: clamp(0.5rem, 0.6vw, 0.7rem);
            color: rgba(255,255,255,0.06);
        }

        .stats-row .stat-item .num {
            font-weight: 700;
            font-size: clamp(0.8rem, 1vw, 1.2rem);
            color: rgba(255,255,255,0.2);
            font-family: 'Courier New', monospace;
        }

        .stats-row .stat-item .num.green { color: #00FF88; }
        .stats-row .stat-item .num.cyan { color: #00F0FF; }
        .stats-row .stat-item .num.gold { color: #F59E0B; }

        /* ============================================================
           ⭐ 转移管理员按钮
           ============================================================ */
        .transfer-section {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.3rem;
            flex-wrap: wrap;
        }

        .transfer-section select {
            flex: 1;
            padding: 0.4rem 0.8rem;
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.04);
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            font-size: 0.6rem;
            outline: none;
            font-family: inherit;
            min-width: 100px;
        }

        .transfer-section select option {
            background: #1a1a2e;
            color: rgba(255,255,255,0.4);
        }

        .transfer-section select:focus {
            border-color: rgba(0,240,255,0.08);
        }

        .transfer-section .btn-transfer {
            padding: 0.4rem 1.2rem;
            border: none;
            border-radius: 30px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            color: #fff;
            font-weight: 600;
            font-size: 0.6rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            white-space: nowrap;
        }

        .transfer-section .btn-transfer:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(0,240,255,0.05);
        }

        .transfer-section .btn-transfer:disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }

        /* ============================================================
           底部 - 开始按钮（超级炫酷）
           ============================================================ */
        .action-bar {
            flex-shrink: 0;
            padding: 0.5vh 0;
            display: flex;
            gap: 0.8rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn-start-game {
            flex: 1;
            min-width: 200px;
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 60px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF, #EC4899);
            background-size: 300% 300%;
            color: #fff;
            font-weight: 800;
            font-size: clamp(0.8rem, 1vw, 1.1rem);
            cursor: pointer;
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            font-family: inherit;
            box-shadow: 0 4px 60px rgba(0,240,255,0.02);
            position: relative;
            overflow: hidden;
            animation: gradientMove 4s ease-in-out infinite;
        }

        @@keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .btn-start-game::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at center, rgba(255,255,255,0.04), transparent 60%);
            opacity: 0;
            transition: opacity 0.6s ease;
            pointer-events: none;
        }

        .btn-start-game:hover:not(:disabled)::before {
            opacity: 1;
        }

        .btn-start-game:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 8px 80px rgba(0,240,255,0.08);
        }

        .btn-start-game:disabled {
            opacity: 0.2;
            cursor: not-allowed;
            transform: none !important;
            animation: none;
        }

        .btn-start-game .sub {
            display: block;
            font-size: clamp(0.4rem, 0.5vw, 0.6rem);
            font-weight: 400;
            opacity: 0.4;
            margin-top: 2px;
        }

        .btn-reset {
            padding: 0.8rem 1.5rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 60px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.1);
            font-weight: 600;
            font-size: clamp(0.6rem, 0.7vw, 0.8rem);
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            white-space: nowrap;
        }

        .btn-reset:hover {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 6px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }
        .toast-msg.warning { background: rgba(245,158,11,0.06); border-color: rgba(245,158,11,0.04); color: #F59E0B; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(16px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 768px) {
            .container { padding: 1vh 1.5vw; }
            .header .brand h1 { font-size: 1rem; }
            .header .status-badge { padding: 2px 10px; font-size: 0.5rem; }
            .header .room-code-display .code { font-size: 0.8rem; letter-spacing: 2px; }
            .holo-card { padding: 0.8rem 1rem; }
            .holo-card .corner { display: none; }
            .main-grid { gap: 8px; }
            .player-item { padding: 0.3rem 0.4rem; }
            .player-item .avatar { font-size: 0.8rem; width: 24px; }
            .btn-start-game { min-width: 140px; padding: 0.6rem 1rem; font-size: 0.8rem; }
            .transfer-section { flex-direction: column; }
            .transfer-section select { min-width: 100%; }
        }

        @@media (max-width: 480px) {
            .container { padding: 0.5vh 1vw; }
            .header .brand .logo-icon { font-size: 1.2rem; }
            .header .brand h1 { font-size: 0.8rem; }
            .header .status-badge { display: none; }
            .header .room-code-display .code { font-size: 0.7rem; }
            .holo-card { padding: 0.5rem 0.6rem; border-radius: 16px; }
            .holo-card .card-title { font-size: 0.4rem; margin-bottom: 0.5rem; }
            .player-item .info .name { font-size: 0.6rem; }
            .player-item .status { font-size: 0.35rem; padding: 1px 6px; }
            .player-item .actions .btn-mini { font-size: 0.4rem; padding: 1px 5px; }
            .btn-start-game { min-width: 100px; padding: 0.5rem 0.8rem; font-size: 0.7rem; }
            .btn-start-game .sub { font-size: 0.35rem; }
            .btn-reset { padding: 0.5rem 0.8rem; font-size: 0.6rem; }
            .stats-row .stat-item .num { font-size: 0.7rem; }
        }
    </style>
</head>
<body>

    <!-- ===== 粒子背景 ===== -->
    <canvas id="particleCanvas"></canvas>
    <canvas id="particleCanvas2"></canvas>
    <div class="grid-overlay"></div>

    <!-- ============================================================
    ⭐ 主容器
    ============================================================ -->
    <div class="container">

        <!-- ===== 头部 ===== -->
        <div class="header">
            <div class="brand">
                <span class="logo-icon">✦</span>
                <div>
                    <h1>全息派对中枢</h1>
                    <span class="sub">✦ 量子纠缠 · 实时同步 ✦</span>
                </div>
            </div>
            <div class="status-group">
                <span class="status-badge">
                    <span class="dot online"></span>
                    <span id="onlineStatus">在线</span>
                </span>
                <span class="status-badge" style="border-color:rgba(0,240,255,0.02);">
                    🎮 <span id="phaseDisplay" style="color:rgba(255,255,255,0.1);">等待中</span>
                </span>
                <div class="room-code-display">
                    <span class="label">✦ 房间</span>
                    <span class="code" id="roomCodeDisplay">------</span>
                </div>
                <span class="admin-badge" id="adminBadge">👑 管理员</span>
            </div>
        </div>

        <!-- ===== 主网格 ===== -->
        <div class="main-grid">

            <!-- ===== 左侧 - 全息二维码 ===== -->
            <div class="holo-card center-section">
                <div class="card-glow"></div>
                <div class="corner tl"></div>
                <div class="corner tr"></div>
                <div class="corner bl"></div>
                <div class="corner br"></div>

                <div class="card-title">📡 全息接入 <span class="accent"></span></div>

                <div class="qr-section">
                    <div id="qrcode">
                        <span style="color:rgba(255,255,255,0.04);font-size:0.7rem;">⏳ 生成中...</span>
                    </div>
                    <div class="qr-hint">✦ 扫码加入派对 ✦</div>
                    <div class="qr-url" id="qrUrlDisplay">--</div>
                </div>

                <!-- 统计 -->
                <div class="stats-row">
                    <span class="stat-item">
                        👥 已加入 <span class="num cyan" id="playerCount">0</span>
                    </span>
                    <span class="stat-item">
                        ✅ 已准备 <span class="num green" id="readyCount">0</span>
                    </span>
                    <span class="stat-item">
                        ⏳ 等待 <span class="num gold" id="waitingCount">0</span>
                    </span>
                </div>
            </div>

            <!-- ===== 右侧面板 ===== -->
            <div class="side-panel">

                <!-- ===== 玩家列表 ===== -->
                <div class="holo-card panel-card">
                    <div class="card-glow"></div>
                    <div class="corner tl"></div>
                    <div class="corner tr"></div>
                    <div class="corner bl"></div>
                    <div class="corner br"></div>

                    <div class="card-title">👥 全息玩家 <span class="accent"></span></div>

                    <div class="player-list" id="playerList">
                        <div class="player-empty">✦ 等待玩家接入 ✦</div>
                    </div>

                    <!-- ⭐ 转移管理员 -->
                    <div class="transfer-section">
                        <select id="transferSelect">
                            <option value="">-- 转移管理员给 --</option>
                        </select>
                        <button class="btn-transfer" id="transferBtn" onclick="transferAdmin()" disabled>
                            👑 转移
                        </button>
                    </div>
                </div>

                <!-- ===== 控制栏 ===== -->
                <div class="holo-card panel-card" style="flex:0.6;">
                    <div class="card-glow"></div>
                    <div class="corner tl"></div>
                    <div class="corner tr"></div>
                    <div class="corner bl"></div>
                    <div class="corner br"></div>

                    <div class="card-title">🎮 控制 <span class="accent"></span></div>

                    <div class="action-bar">
                        <button class="btn-start-game" id="startBtn" onclick="startGame()" disabled>
                            🐺 开始狼人杀
                            <span class="sub" id="startSub">等待所有玩家准备</span>
                        </button>
                        <button class="btn-reset" onclick="resetRoom()">🔄 重置</button>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- ===== Toast ===== -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================
    Scripts
    ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
    </script>

    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(60, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        (function initParticles2() {
            var canvas = document.getElementById('particleCanvas2');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(30, Math.floor(window.innerWidth / 16));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.03,
                    vy: (Math.random() - 0.5) * 0.03,
                    r: Math.random() * 2 + 1,
                    o: Math.random() * 0.04 + 0.005
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(139, 92, 246, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 配置
        // ============================================================
        var config = {
            roomId: null,
            playerId: null,
            players: [],
            maxPlayers: 12,
            minPlayers: 2,
            isHost: true,
            adminId: null,
            isGameStarted: false
        };

        var connection = null;

        // ============================================================
        // 连接 SignalR
        // ============================================================
        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/partyHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // ===== 事件监听 =====
                connection.on('RoomCreated', function(data) {
                    if (data.success) {
                        config.roomId = data.roomId;
                        config.adminId = data.playerId;
                        document.getElementById('roomCodeDisplay').textContent = data.roomId;
                        document.getElementById('qrUrlDisplay').textContent = window.location.origin + '/Party/Player?roomId=' +
                            data.roomId;
                        generateQRCode(data.roomId);
                        showToast('✅ 房间已创建！', 'success');
                    }
                });

                connection.on('PlayerJoined', function(player) {
                    config.players.push(player);
                    updateUI();
                    showToast('🟢 ' + player.nickname + ' 加入了房间', 'success');
                });

                connection.on('PlayerReadyToggled', function(player) {
                    var existing = config.players.find(function(p) { return p.playerId === player.playerId; });
                    if (existing) {
                        existing.isReady = player.isReady;
                        updateUI();
                    }
                });

                connection.on('PlayerLeft', function(playerId) {
                    config.players = config.players.filter(function(p) { return p.playerId !== playerId; });
                    updateUI();
                });

                connection.on('RoomUpdated', function(room) {
                    config.players = room.players || [];
                    config.adminId = room.adminUserIds && room.adminUserIds.length > 0 ? room.adminUserIds[0] : config.adminId;
                    updateUI();
                });

                connection.on('AdminUpdated', function(player) {
                    var existing = config.players.find(function(p) { return p.playerId === player.playerId; });
                    if (existing) {
                        existing.isAdmin = player.isAdmin;
                        updateUI();
                        if (player.playerId === config.playerId && player.isAdmin) {
                            document.getElementById('adminBadge').textContent = '👑 管理员';
                        }
                    }
                });

                connection.on('GameStarted', function(room) {
                    config.isGameStarted = true;
                    document.getElementById('phaseDisplay').textContent = '🎮 游戏中';
                    document.getElementById('startBtn').disabled = true;
                    document.getElementById('startBtn').textContent = '🎮 游戏进行中...';
                    document.getElementById('startBtn').querySelector('.sub').textContent = '';
                    showToast('🚀 游戏已开始！', 'success');
                    setTimeout(function() {
                        window.location.href = '/Werewolf/Host?roomId=' + config.roomId;
                    }, 1500);
                });

                connection.on('GameStartFailed', function(message) {
                    showToast('❌ ' + message, 'error');
                });

                connection.on('Kicked', function(message) {
                    showToast('⚠️ ' + message, 'warning');
                    setTimeout(function() { window.location.reload(); }, 2000);
                });

                // ===== 启动连接 =====
                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        createRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 创建房间
        // ============================================================
        function createRoom() {
            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                setTimeout(createRoom, 1000);
                return;
            }
            connection.invoke('CreateRoom', '房主', 12);
        }

        // ============================================================
        // 生成二维码
        // ============================================================
        function generateQRCode(roomId) {
            var container = document.getElementById('qrcode');
            container.innerHTML = '';
            var url = window.location.origin + '/Party/Player?roomId=' + roomId;

            try {
                new QRCode(container, {
                    text: url,
                    width: 180,
                    height: 180,
                    colorDark: '#00F0FF',
                    colorLight: 'transparent',
                    correctLevel: QRCode.CorrectLevel.H
                });
            } catch (e) {
                container.innerHTML = '<div style="color:rgba(255,255,255,0.1);font-size:0.7rem;padding:1rem;">📱 ' + url +
                    '</div>';
            }
        }

        // ============================================================
        // 更新 UI
        // ============================================================
        function updateUI() {
            updatePlayerList();
            updateStats();
            updateTransferOptions();
            checkStartReady();
            updateAdminBadge();
        }

        function updatePlayerList() {
            var container = document.getElementById('playerList');
            if (config.players.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var html = '';
            config.players.forEach(function(p) {
                var isReady = p.isReady || false;
                var isHost = p.isHost || false;
                var isAdmin = p.isAdmin || false;
                var isSelf = p.playerId === config.playerId;

                var statusText = isHost ? '👑 房主' : isAdmin ? '🛡️ 管理员' : isReady ? '✅ 已准备' : '⏳ 等待';
                var statusClass = isHost ? 'host' : isAdmin ? 'admin' : isReady ? 'ready' : 'waiting';

                html += '<div class="player-item" data-playerid="' + p.playerId + '">';
                html += '<span class="avatar">' + (p.avatarEmoji || '🧑') + '</span>';
                html += '<div class="info">';
                html += '<span class="name">';
                html += p.nickname;
                if (isSelf) html += ' <span style="color:rgba(0,240,255,0.3);font-size:0.4rem;">(你)</span>';
                if (isHost) html += ' <span class="host-tag">👑 房主</span>';
                if (isAdmin && !isHost) html += ' <span class="admin-tag">🛡️ 管理员</span>';
                html += '</span>';
                html += '</div>';
                html += '<span class="status ' + statusClass + '">' + statusText + '</span>';
                html += '<div class="actions">';

                if (isAdmin && !isHost && !isSelf) {
                    html += '<button class="btn-mini promote" onclick="promoteAdmin(\'' + p.playerId + '\')">👑 提升</button>';
                }
                if (!isHost && !isSelf && config.isHost) {
                    html += '<button class="btn-mini kick" onclick="kickPlayer(\'' + p.playerId + '\')">✕</button>';
                }
                html += '</div>';
                html += '</div>';
            });

            container.innerHTML = html;
        }

        function updateStats() {
            var total = config.players.length;
            var ready = config.players.filter(function(p) { return p.isReady; }).length;
            var waiting = total - ready;

            document.getElementById('playerCount').textContent = total;
            document.getElementById('readyCount').textContent = ready;
            document.getElementById('waitingCount').textContent = waiting;

            document.getElementById('phaseDisplay').textContent = total > 0 ? total + ' 人在线' : '等待中';
        }

        function updateTransferOptions() {
            var select = document.getElementById('transferSelect');
            var currentValue = select.value;

            var options = '<option value="">-- 转移管理员给 --</option>';
            config.players.forEach(function(p) {
                if (p.playerId === config.playerId) return;
                var isAdmin = p.isAdmin || false;
                options += '<option value="' + p.playerId + '" ' + (isAdmin ? 'selected' : '') + '>' +
                    (p.avatarEmoji || '🧑') + ' ' + p.nickname +
                    (isAdmin ? ' (管理员)' : '') +
                    '</option>';
            });

            select.innerHTML = options;
            if (currentValue) select.value = currentValue;
            document.getElementById('transferBtn').disabled = select.value === '' || config.players.length <= 1;
        }

        function updateAdminBadge() {
            var self = config.players.find(function(p) { return p.playerId === config.playerId; });
            if (self && self.isAdmin) {
                document.getElementById('adminBadge').textContent = '👑 管理员';
                document.getElementById('adminBadge').style.color = '#00F0FF';
                document.getElementById('adminBadge').style.borderColor = 'rgba(0,240,255,0.06)';
                config.isHost = true;
            } else {
                document.getElementById('adminBadge').textContent = '👤 玩家';
                document.getElementById('adminBadge').style.color = 'rgba(255,255,255,0.06)';
                document.getElementById('adminBadge').style.borderColor = 'rgba(255,255,255,0.02)';
                config.isHost = false;
            }
        }

        // ============================================================
        // 检查是否可以开始
        // ============================================================
        function checkStartReady() {
            var total = config.players.length;
            var ready = config.players.filter(function(p) { return p.isReady; }).length;
            var btn = document.getElementById('startBtn');
            var sub = document.getElementById('startSub');

            if (total >= config.minPlayers && ready === total) {
                btn.disabled = false;
                btn.innerHTML = '🚀 开始狼人杀 <span class="sub" id="startSub">' + total + ' 位玩家已准备</span>';
            } else {
                btn.disabled = true;
                var msg = total < config.minPlayers ? '需要至少 ' + config.minPlayers + ' 位玩家' :
                    (ready < total ? '等待 ' + (total - ready) + ' 位玩家准备' : '等待玩家');
                btn.innerHTML = '🐺 开始狼人杀 <span class="sub" id="startSub">' + msg + '</span>';
            }
        }

        // ============================================================
        // 开始游戏
        // ============================================================
        function startGame() {
            if (!config.roomId) {
                showToast('⚠️ 房间未创建', 'error');
                return;
            }

            if (!config.isHost) {
                showToast('⚠️ 只有管理员可以开始游戏', 'warning');
                return;
            }

            var btn = document.getElementById('startBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 准备中...';

            connection.invoke('StartGame', config.roomId)
                .catch(function(err) {
                    showToast('❌ ' + err, 'error');
                    btn.disabled = false;
                    btn.innerHTML = '🐺 开始狼人杀 <span class="sub">重试</span>';
                });
        }

        // ============================================================
        // ⭐ 转移管理员
        // ============================================================
        function transferAdmin() {
            var select = document.getElementById('transferSelect');
            var targetPlayerId = select.value;

            if (!targetPlayerId) {
                showToast('⚠️ 请选择要转移的玩家', 'warning');
                return;
            }

            var target = config.players.find(function(p) { return p.playerId === targetPlayerId; });
            if (!target) {
                showToast('⚠️ 玩家不存在', 'error');
                return;
            }

            if (!confirm('确定要将管理员权限转移给 ' + target.nickname + ' 吗？')) return;

            connection.invoke('ToggleAdmin', config.roomId, config.playerId, targetPlayerId)
                .then(function() {
                    showToast('👑 管理员已转移给 ' + target.nickname, 'success');
                })
                .catch(function(err) {
                    showToast('❌ 转移失败: ' + err, 'error');
                });
        }

        // ============================================================
        // ⭐ 提升管理员
        // ============================================================
        function promoteAdmin(playerId) {
            var target = config.players.find(function(p) { return p.playerId === playerId; });
            if (!target) return;

            if (!confirm('确定要将 ' + target.nickname + ' 提升为管理员吗？')) return;

            connection.invoke('ToggleAdmin', config.roomId, config.playerId, playerId)
                .then(function() {
                    showToast('✅ ' + target.nickname + ' 已成为管理员', 'success');
                })
                .catch(function(err) {
                    showToast('❌ 操作失败: ' + err, 'error');
                });
        }

        // ============================================================
        // ⭐ 踢出玩家
        // ============================================================
        function kickPlayer(playerId) {
            var target = config.players.find(function(p) { return p.playerId === playerId; });
            if (!target) return;

            if (!confirm('确定要将 ' + target.nickname + ' 踢出房间吗？')) return;

            connection.invoke('KickPlayer', config.roomId, config.playerId, playerId)
                .then(function() {
                    showToast('🗑️ 已踢出 ' + target.nickname, 'info');
                })
                .catch(function(err) {
                    showToast('❌ 操作失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 重置房间
        // ============================================================
        function resetRoom() {
            if (!confirm('确定要重置房间吗？所有玩家将被移出。')) return;
            window.location.reload();
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + (type || 'info');
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 启动
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            connectSignalR();
        });
    </script>

</body>
</html>
