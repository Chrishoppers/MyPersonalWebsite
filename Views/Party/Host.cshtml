            <!-- 房间统计 -->
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.3rem;text-align:center;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.02);">
                <div>
                    <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">在线</div>
                    <div style="font-size:1.2rem;font-weight:700;color:#00FF88;font-family:'Courier New',monospace;" id="onlineCount">0</div>
                </div>
                <div>
                    <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">已准备</div>
                    <div style="font-size:1.2rem;font-weight:700;color:#7B61FF;font-family:'Courier New',monospace;" id="readyCount">0</div>
                </div>
                <div>
                    <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">最大</div>
                    <div style="font-size:1.2rem;font-weight:700;color:rgba(255,255,255,0.2);font-family:'Courier New',monospace;" id="maxCount">20</div>
                </div>
            </div>
        </div>

        <!-- ====== 右侧：玩家列表 ====== -->
        <div class="holo-card players-card">
            <div class="card-title">
                👥 全息玩家列表
                <span class="accent-line"></span>
                <span class="badge-count" id="playerCountBadge">0 人</span>
            </div>

            <!-- 状态统计 -->
            <div class="player-stats">
                <div class="stat-item">
                    🟢 在线 <span class="num online" id="statOnline">0</span>
                </div>
                <div class="stat-item">
                    🟣 已准备 <span class="num ready" id="statReady">0</span>
                </div>
                <div class="stat-item">
                    🟡 等待中 <span class="num waiting" id="statWaiting">0</span>
                </div>
            </div>

            <!-- 玩家列表 -->
            <div class="player-list" id="playerList">
                <div class="empty-players">✦ 等待玩家接入 ✦</div>
            </div>

            <!-- 底部操作 -->
            <div class="host-actions">
                <button class="btn-primary-glow" id="startGameBtn" onclick="startGame()" disabled>
                    <span class="icon">🚀</span> 开始派对
                </button>
                <button class="btn-secondary-glow" onclick="refreshRoom()">
                    🔄 刷新
                </button>
                <button class="btn-danger-glow" onclick="closeRoom()">
                    🗑️ 解散房间
                </button>
                <span class="status-text" id="actionStatusText">● 等待玩家加入</span>
            </div>
        </div>

    </div>

</div>

<!-- ============================================================
     Toast 容器
     ============================================================ -->
<div class="toast-container" id="toastContainer"></div>

<!-- ============================================================
     Scripts
     ============================================================ -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
</script>

<script>
    // ============================================================
    // 粒子背景
    // ============================================================
    (function initParticles() {
        var canvas = document.getElementById('particleCanvas');
        var ctx = canvas.getContext('2d');
        var particles = [];
        var particleCount = 120;
        var mouse = { x: null, y: null };

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        for (var i = 0; i < particleCount; i++) {
            particles.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                radius: Math.random() * 1.2 + 0.3,
                opacity: Math.random() * 0.3 + 0.05
            });
        }

        document.addEventListener('mousemove', function(e) {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (var p of particles) {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

                if (mouse.x !== null) {
                    var dx = mouse.x - p.x;
                    var dy = mouse.y - p.y;
                    var dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < 200) {
                        var force = 0.002;
                        p.vx += dx * force;
                        p.vy += dy * force;
                        var speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
                        if (speed > 0.5) {
                            p.vx = (p.vx / speed) * 0.5;
                            p.vy = (p.vy / speed) * 0.5;
                        }
                    }
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(0, 240, 255, ' + p.opacity + ')';
                ctx.fill();
            }

            for (var i = 0; i < particles.length; i++) {
                for (var j = i + 1; j < particles.length; j++) {
                    var dx = particles[i].x - particles[j].x;
                    var dy = particles[i].y - particles[j].y;
                    var dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < 150) {
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.strokeStyle = 'rgba(0, 240, 255, ' + (0.02 * (1 - dist / 150)) + ')';
                        ctx.lineWidth = 0.5;
                        ctx.stroke();
                    }
                }
            }

            requestAnimationFrame(draw);
        }
        draw();
    })();

    // ============================================================
    // Toast
    // ============================================================
    function showToast(message, type) {
        type = type || 'info';
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + type;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3500);
    }

    // ============================================================
    // 复制房间码
    // ============================================================
    function copyRoomCode() {
        var code = document.getElementById('roomCodeDisplay').textContent;
        if (!code || code === '------') {
            showToast('⚠️ 暂无房间码', 'warning');
            return;
        }
        navigator.clipboard.writeText(code).then(function() {
            showToast('✅ 房间码已复制', 'success');
        }).catch(function() {
            var input = document.createElement('input');
            input.value = code;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            showToast('✅ 房间码已复制', 'success');
        });
    }

    // ============================================================
    // 游戏状态
    // ============================================================
    var gameState = {
        roomId: null,
        playerId: null,
        isHost: true,
        isAdmin: true,
        players: [],
        isGameStarted: false,
        isConnected: false,
        isRoomCreated: false
    };

    // ============================================================
    // SignalR
    // ============================================================
    var connection = null;
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function connectSignalR() {
        try {
            connection = new signalR.HubConnectionBuilder()
                .withUrl('/partyHub')
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // ---- 事件监听 ----
            connection.on('RoomCreated', function(data) {
                console.log('🔍 RoomCreated 收到数据:', JSON.stringify(data));
                
                // 兼容两种数据格式
                var roomId = data?.roomId || data?.room?.roomId;
                var playerId = data?.playerId || data?.room?.hostUserId;
                
                if (roomId) {
                    gameState.roomId = roomId;
                    gameState.playerId = playerId;
                    gameState.isRoomCreated = true;
                    
                    document.getElementById('roomCodeDisplay').textContent = roomId;
                    generateQRCode(roomId);
                    
                    // 更新界面
                    showToast('✅ 房间已创建！房间码: ' + roomId, 'success');
                    updateRoomStatus('waiting');
                    document.getElementById('actionStatusText').textContent = '● 等待玩家加入';
                    
                    // 启用刷新按钮
                    document.querySelector('.btn-secondary-glow').disabled = false;
                } else {
                    console.error('❌ 创建房间失败：未获取到房间码', data);
                    showToast('❌ 创建房间失败，请刷新重试', 'error');
                }
            });

            connection.on('PlayerJoined', function(player) {
                console.log('👤 玩家加入:', player);
                showToast('🟢 ' + player.nickname + ' 加入了派对', 'info');
                addPlayerToList(player);
                updateStats();
            });

            connection.on('PlayerLeft', function(playerId) {
                console.log('👤 玩家离开:', playerId);
                removePlayerFromList(playerId);
                updateStats();
            });

            connection.on('PlayerReadyToggled', function(player) {
                console.log('🔄 玩家准备状态:', player);
                updatePlayerReady(player);
                updateStats();
            });

            connection.on('RoomUpdated', function(room) {
                console.log('📡 房间更新:', room);
                syncRoomData(room);
            });

            connection.on('GameStarted', function(room) {
                gameState.isGameStarted = true;
                showToast('🚀 派对开始！所有玩家进入游戏！', 'success');
                updateRoomStatus('playing');
                document.getElementById('actionStatusText').textContent = '● 游戏进行中...';
                document.getElementById('startGameBtn').disabled = true;
            });

            connection.on('GameStartFailed', function(message) {
                showToast('❌ ' + message, 'error');
            });

            connection.on('Kicked', function(message) {
                showToast('⚠️ ' + message, 'warning');
                setTimeout(function() {
                    window.location.href = '/';
                }, 2000);
            });

            connection.on('AdminUpdated', function(player) {
                console.log('⚡ 管理员更新:', player);
                updatePlayerAdmin(player);
            });

            // ---- 连接 ----
            connection.start()
                .then(function() {
                    gameState.isConnected = true;
                    console.log('✅ SignalR 已连接');
                    
                    // 自动创建房间
                    setTimeout(function() {
                        createRoom();
                    }, 500);
                })
                .catch(function(err) {
                    console.error('❌ SignalR 连接失败:', err);
                    showToast('⚠️ 连接失败，正在重试...', 'warning');
                    setTimeout(function() { connectSignalR(); }, 3000);
                });

        } catch (e) {
            console.error('SignalR 初始化失败:', e);
            showToast('⚠️ 连接失败，请刷新重试', 'error');
        }
    }

    // ============================================================
    // 创建房间
    // ============================================================
    function createRoom() {
        if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
            showToast('⏳ 正在连接...', 'info');
            setTimeout(function() { createRoom(); }, 1000);
            return;
        }

        var hostName = '@username' || 'admin';
        console.log('📡 正在创建房间，主控:', hostName);

        connection.invoke('CreateRoom', hostName, 20, null)
            .then(function(result) {
                console.log('📡 CreateRoom 返回:', result);
                if (result && result.success) {
                    // 如果返回结果中有 roomId，直接使用
                    if (result.roomId && !gameState.roomId) {
                        gameState.roomId = result.roomId;
                        gameState.playerId = result.playerId;
                        gameState.isRoomCreated = true;
                        
                        document.getElementById('roomCodeDisplay').textContent = result.roomId;
                        generateQRCode(result.roomId);
                        showToast('✅ 房间已创建！房间码: ' + result.roomId, 'success');
                        updateRoomStatus('waiting');
                        document.getElementById('actionStatusText').textContent = '● 等待玩家加入';
                    }
                } else if (result && !result.success) {
                    showToast('❌ ' + result.message, 'error');
                }
            })
            .catch(function(err) {
                console.error('❌ 创建房间失败:', err);
                showToast('❌ 创建房间失败: ' + err, 'error');
            });
    }

    // ============================================================
    // 生成二维码
    // ============================================================
    var qrInstance = null;

    function generateQRCode(roomId) {
        var container = document.getElementById('qrcode');
        container.innerHTML = '';

        if (!roomId || roomId === '------') {
            container.innerHTML = '<div class="qr-loading">⏳ 等待房间码...</div>';
            return;
        }

        var url = window.location.origin + '/Party/Player?roomId=' + roomId;

        try {
            qrInstance = new QRCode(container, {
                text: url,
                width: 160,
                height: 160,
                colorDark: '#00F0FF',
                colorLight: 'transparent',
                correctLevel: QRCode.CorrectLevel.H
            });
            console.log('✅ 二维码已生成:', url);
        } catch (e) {
            console.error('❌ 二维码生成失败:', e);
            container.innerHTML = '<div style="padding:1rem;text-align:center;color:rgba(255,255,255,0.1);font-size:0.7rem;">📱 扫码加入<br><span style="font-size:0.5rem;color:rgba(255,255,255,0.04);">' + url + '</span></div>';
        }
    }

    // ============================================================
    // 玩家列表操作
    // ============================================================
    function addPlayerToList(player) {
        var list = document.getElementById('playerList');
        var empty = list.querySelector('.empty-players');
        if (empty) empty.remove();

        var existing = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
        if (existing) return;

        var isSelf = player.playerId === gameState.playerId;
        var isAdmin = player.isAdmin;
        var isHost = player.isHost || false;

        var div = document.createElement('div');
        div.className = 'player-item';
        div.dataset.id = player.playerId;
        div.innerHTML = `
            <div class="avatar ${player.isReady ? 'ready' : 'online'}">${player.avatarEmoji || '🧑'}</div>
            <div class="info">
                <div class="name">
                    ${player.nickname}
                    ${isHost ? '<span class="host-tag">👑 主控</span>' : ''}
                    ${isAdmin && !isHost ? '<span class="admin-tag">⚡ 管理</span>' : ''}
                    ${isSelf ? '<span style="font-size:0.5rem;color:rgba(255,255,255,0.1);">(你)</span>' : ''}
                </div>
                <div class="status-text ${player.isReady ? 'ready' : 'waiting'}">
                    ${player.isReady ? '✅ 已准备' : '⏳ 未准备'}
                </div>
            </div>
            <div class="actions">
                <span class="ready-dot ${player.isReady ? 'ready' : 'waiting'}"></span>
                ${!isSelf && !isHost ? `
                    <button class="btn-icon admin-toggle" onclick="toggleAdmin('${player.playerId}')" title="切换管理员">⚡</button>
                    <button class="btn-icon kick" onclick="kickPlayer('${player.playerId}')" title="踢出">✕</button>
                ` : ''}
                ${isSelf && !isHost ? `
                    <button class="btn-icon" onclick="toggleReady()" title="准备/取消准备" style="color:${player.isReady ? '#7B61FF' : 'rgba(255,255,255,0.08)'}">
                        ${player.isReady ? '✅' : '⏳'}
                    </button>
                ` : ''}
            </div>
        `;

        list.appendChild(div);
        updateStats();
    }

    function removePlayerFromList(playerId) {
        var item = document.querySelector('.player-item[data-id="' + playerId + '"]');
        if (item) item.remove();

        var list = document.getElementById('playerList');
        if (!list.querySelector('.player-item')) {
            list.innerHTML = '<div class="empty-players">✦ 等待玩家接入 ✦</div>';
        }
        updateStats();
    }

    function updatePlayerReady(player) {
        var item = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
        if (!item) return;

        var avatar = item.querySelector('.avatar');
        var statusText = item.querySelector('.status-text');
        var dot = item.querySelector('.ready-dot');

        avatar.className = 'avatar ' + (player.isReady ? 'ready' : 'online');
        statusText.className = 'status-text ' + (player.isReady ? 'ready' : 'waiting');
        statusText.textContent = player.isReady ? '✅ 已准备' : '⏳ 未准备';
        if (dot) {
            dot.className = 'ready-dot ' + (player.isReady ? 'ready' : 'waiting');
        }

        if (player.playerId === gameState.playerId) {
            var selfBtn = item.querySelector('.btn-icon');
            if (selfBtn) {
                selfBtn.textContent = player.isReady ? '✅' : '⏳';
                selfBtn.style.color = player.isReady ? '#7B61FF' : 'rgba(255,255,255,0.08)';
            }
        }

        updateStats();
    }

    function updatePlayerAdmin(player) {
        var item = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
        if (!item) return;

        var nameDiv = item.querySelector('.name');
        var oldTags = nameDiv.querySelectorAll('.admin-tag, .host-tag');
        oldTags.forEach(function(t) { t.remove(); });

        if (player.isHost) {
            var tag = document.createElement('span');
            tag.className = 'host-tag';
            tag.textContent = '👑 主控';
            nameDiv.appendChild(tag);
        } else if (player.isAdmin) {
            var tag = document.createElement('span');
            tag.className = 'admin-tag';
            tag.textContent = '⚡ 管理';
            nameDiv.appendChild(tag);
        }
        updateStats();
    }

    function syncRoomData(room) {
        if (!room || !room.players) return;
        
        var currentIds = new Set();
        document.querySelectorAll('.player-item').forEach(function(el) {
            currentIds.add(el.dataset.id);
        });

        var newIds = new Set();
        room.players.forEach(function(p) {
            newIds.add(p.playerId);
            if (!currentIds.has(p.playerId)) {
                addPlayerToList(p);
            } else {
                updatePlayerReady(p);
                updatePlayerAdmin(p);
            }
        });

        currentIds.forEach(function(id) {
            if (!newIds.has(id)) {
                removePlayerFromList(id);
            }
        });

        updateStats();

        if (room.status === 'playing') {
            gameState.isGameStarted = true;
            updateRoomStatus('playing');
            document.getElementById('actionStatusText').textContent = '● 游戏进行中...';
            document.getElementById('startGameBtn').disabled = true;
        }

        document.getElementById('maxCount').textContent = room.maxPlayers || 20;
    }

    // ============================================================
    // 更新统计
    // ============================================================
    function updateStats() {
        var items = document.querySelectorAll('.player-item');
        var total = items.length;
        var ready = 0;
        var online = 0;

        items.forEach(function(el) {
            var statusText = el.querySelector('.status-text');
            if (statusText && statusText.textContent.includes('已准备')) ready++;
            online++;
        });

        document.getElementById('onlineCount').textContent = total;
        document.getElementById('readyCount').textContent = ready;
        document.getElementById('statOnline').textContent = total;
        document.getElementById('statReady').textContent = ready;
        document.getElementById('statWaiting').textContent = total - ready;
        document.getElementById('playerCountBadge').textContent = total + ' 人';

        var btn = document.getElementById('startGameBtn');
        if (total >= 2 && ready === total && ready > 0) {
            btn.disabled = false;
        } else {
            btn.disabled = true;
        }
    }

    // ============================================================
    // 更新房间状态
    // ============================================================
    function updateRoomStatus(status) {
        var badge = document.getElementById('roomStatusBadge');
        var statusMap = {
            'waiting': '● 等待中',
            'ready': '● 准备就绪',
            'playing': '● 进行中',
            'ended': '● 已结束'
        };
        badge.textContent = statusMap[status] || status;
    }

    // ============================================================
    // 玩家操作
    // ============================================================
    function toggleReady() {
        if (!connection || !gameState.roomId || !gameState.playerId) {
            showToast('⚠️ 房间未创建', 'warning');
            return;
        }
        connection.invoke('ToggleReady', gameState.roomId, gameState.playerId)
            .catch(function(err) {
                console.error('切换准备状态失败:', err);
                showToast('操作失败', 'error');
            });
    }

    function toggleAdmin(targetPlayerId) {
        if (!connection || !gameState.roomId || !gameState.playerId) return;
        if (!confirm('切换该用户的管理员权限？')) return;

        connection.invoke('ToggleAdmin', gameState.roomId, gameState.playerId, targetPlayerId)
            .catch(function(err) {
                console.error('切换管理员失败:', err);
                showToast('操作失败', 'error');
            });
    }

    function kickPlayer(targetPlayerId) {
        if (!connection || !gameState.roomId || !gameState.playerId) return;
        if (!confirm('确定要踢出该玩家吗？')) return;

        connection.invoke('KickPlayer', gameState.roomId, gameState.playerId, targetPlayerId)
            .catch(function(err) {
                console.error('踢出玩家失败:', err);
                showToast('操作失败', 'error');
            });
    }

    function startGame() {
        if (!connection || !gameState.roomId || !gameState.playerId) return;

        var btn = document.getElementById('startGameBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="icon">⏳</span> 启动中...';

        connection.invoke('StartGame', gameState.roomId, gameState.playerId)
            .catch(function(err) {
                console.error('开始游戏失败:', err);
                showToast('开始游戏失败: ' + err, 'error');
                btn.disabled = false;
                btn.innerHTML = '<span class="icon">🚀</span> 开始派对';
            });
    }

    function refreshRoom() {
        if (!connection || !gameState.roomId) {
            showToast('⚠️ 暂无房间', 'warning');
            return;
        }
        showToast('🔄 刷新中...', 'info');
        connection.invoke('RefreshRoom', gameState.roomId)
            .catch(function() {});
    }

    function closeRoom() {
        if (!confirm('确定要解散房间吗？所有玩家将被移出。')) return;
        showToast('🗑️ 房间已解散', 'warning');
        if (connection) {
            connection.stop();
        }
        setTimeout(function() {
            window.location.href = '/Game';
        }, 1500);
    }

    // ============================================================
    // 初始化
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 派对控制中心启动...');
        connectSignalR();
    });
</script>
