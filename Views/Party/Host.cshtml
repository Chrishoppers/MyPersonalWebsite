@{
    Layout = null;
    ViewData["Title"] = "🎉 派对大厅";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🎉 派对大厅</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 16px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0 20px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-wrap: wrap;
            gap: 12px;
        }

        .header .logo {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header .status {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .status .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .header .status .dot.online { background: #00FF88; animation: pulse 2s infinite; }
        .header .status .dot.waiting { background: #F59E0B; animation: pulse 2s infinite; }

        @@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.2); } }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 20px;
            margin-top: 20px;
        }

        @@media (max-width: 1100px) { .main-grid { grid-template-columns: 1fr; } }

        .seating-area {
            background: rgba(255,255,255,0.02);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 24px;
            min-height: 500px;
            position: relative;
            overflow: hidden;
        }

        .seating-area .area-title {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.15);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .seating-area .area-title .count { color: #00F0FF; font-weight: 700; font-size: 0.8rem; }

        .table-container {
            position: relative;
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            aspect-ratio: 1 / 0.85;
        }

        .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30,20,60,0.3), rgba(10,10,30,0.6));
            border: 2px solid rgba(139,92,246,0.04);
            box-shadow: 0 0 80px rgba(139,92,246,0.02), inset 0 0 80px rgba(0,0,0,0.3);
        }

        .table-bg::after {
            content: '';
            position: absolute;
            inset: 10%;
            border-radius: 50%;
            background: radial-gradient(ellipse at 40% 40%, rgba(139,92,246,0.02), transparent 70%);
        }

        .table-pattern {
            position: absolute;
            inset: 15%;
            border-radius: 50%;
            background-image: repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,255,255,0.005) 5deg, transparent 10deg);
            opacity: 0.3;
            pointer-events: none;
        }

        .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .table-center .icon { font-size: 2.4rem; opacity: 0.1; display: block; }
        .table-center .label { font-size: 0.5rem; color: rgba(255,255,255,0.02); text-transform: uppercase; letter-spacing: 0.2em; margin-top: 4px; }

        .seat {
            position: absolute;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.15);
            user-select: none;
            transform: translate(-50%, -50%);
        }

        .seat .seat-number { font-size: 0.9rem; font-weight: 700; font-family: 'Courier New', monospace; color: rgba(255,255,255,0.1); }
        .seat .seat-name { font-size: 0.45rem; font-weight: 500; color: rgba(255,255,255,0.04); max-width: 44px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .seat .seat-emoji { font-size: 0.6rem; display: none; }

        .seat.occupied { border-color: rgba(0,240,255,0.12); background: rgba(0,240,255,0.03); }
        .seat.occupied .seat-number { color: rgba(0,240,255,0.3); }
        .seat.occupied .seat-name { color: rgba(255,255,255,0.15); }

        .seat.ready { border-color: rgba(0,255,136,0.15); background: rgba(0,255,136,0.03); box-shadow: 0 0 40px rgba(0,255,136,0.02); }
        .seat.ready .seat-number { color: #00FF88; }

        .seat.empty:hover { border-color: rgba(139,92,246,0.15); background: rgba(139,92,246,0.04); transform: translate(-50%, -50%) scale(1.08); }

        .side-panel { display: flex; flex-direction: column; gap: 16px; }

        .panel-card {
            background: rgba(255,255,255,0.02);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 20px;
            padding: 18px 20px;
            transition: all 0.4s ease;
        }

        .panel-card:hover { border-color: rgba(255,255,255,0.06); }

        .panel-card .card-title {
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.15);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.04), transparent); }

        .room-code-display {
            text-align: center;
            padding: 12px 0;
            background: rgba(0,240,255,0.02);
            border-radius: 16px;
            border: 1px solid rgba(0,240,255,0.04);
            margin-bottom: 12px;
        }

        .room-code-display .code {
            font-family: 'Courier New', monospace;
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 4px;
        }

        .qr-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 12px;
            background: rgba(255,255,255,0.01);
            border-radius: 16px;
            border: 1px solid rgba(0,240,255,0.04);
            min-height: 160px;
        }

        .qr-container #qrcode { position: relative; z-index: 1; }
        .qr-container .qr-hint { font-size: 0.5rem; color: rgba(255,255,255,0.04); letter-spacing: 0.1em; text-align: center; margin-top: 4px; }

        .player-list {
            max-height: 200px;
            overflow-y: auto;
            font-size: 0.75rem;
            color: rgba(255,255,255,0.1);
            line-height: 2;
        }

        .player-list .player-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            border-bottom: 1px solid rgba(255,255,255,0.02);
        }

        .player-list .player-item .name { flex: 1; color: rgba(255,255,255,0.3); }
        .player-list .player-item .status { font-size: 0.5rem; }
        .player-list .player-item .status.ready { color: #00FF88; }
        .player-list .player-item .status.waiting { color: rgba(255,255,255,0.06); }

        .btn-start-game {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            margin-top: 12px;
            box-shadow: 0 4px 40px rgba(139,92,246,0.05);
        }

        .btn-start-game:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 60px rgba(139,92,246,0.1);
        }

        .btn-start-game:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }

        .btn-start-game .sub {
            display: block;
            font-size: 0.55rem;
            font-weight: 400;
            opacity: 0.5;
            margin-top: 2px;
        }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 8px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.8rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        @@media (max-width: 768px) {
            body { padding: 10px; }
            .header .logo { font-size: 1.2rem; }
            .seat { width: 40px; height: 40px; }
            .seat .seat-number { font-size: 0.65rem; }
            .seat .seat-name { font-size: 0.35rem; max-width: 30px; }
            .room-code-display .code { font-size: 1.4rem; }
            .main-grid { grid-template-columns: 1fr; }
            .panel-card { padding: 12px 14px; }
        }

        @@media (max-width: 480px) {
            .seat { width: 32px; height: 32px; }
            .seat .seat-number { font-size: 0.5rem; }
            .seat .seat-name { display: none; }
            .seat .seat-emoji { display: block; font-size: 0.8rem; }
            .seating-area { padding: 14px; min-height: 300px; }
            .room-code-display .code { font-size: 1.1rem; letter-spacing: 2px; }
            .btn-start-game { font-size: 0.85rem; padding: 12px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <div class="logo"><span>🎉</span> 派对大厅</div>
            <div class="status">
                <span class="dot online"></span> 在线
                <span id="playerCountDisplay">0/0 人</span>
                <span style="color:rgba(255,255,255,0.04);">|</span>
                <span id="phaseDisplay" style="color:rgba(255,255,255,0.08);">🪑 等待就坐</span>
            </div>
        </div>

        <div class="main-grid">
            <div class="seating-area">
                <div class="area-title">🪑 座位图 <span class="count" id="seatCount">0/0 已占</span></div>
                <div class="table-container" id="tableContainer">
                    <div class="table-bg"></div>
                    <div class="table-pattern"></div>
                    <div class="table-center"><span class="icon">🎉</span><span class="label">派对</span></div>
                    <div id="seatsContainer"></div>
                </div>

                <!-- 房间信息 -->
                <div class="room-code-display">
                    <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.15em;">房间码</div>
                    <div class="code" id="roomCodeDisplay">------</div>
                </div>

                <div class="qr-container">
                    <div id="qrcode"><span style="color:rgba(255,255,255,0.04);font-size:0.7rem;">⏳ 生成中...</span></div>
                </div>
                <div class="qr-hint">📱 扫码加入派对</div>

                <!-- ⭐ 开始狼人杀按钮 -->
                <button class="btn-start-game" id="startGameBtn" onclick="startWerewolf()" disabled>
                    🐺 开始狼人杀
                    <span class="sub">所有玩家准备后自动解锁</span>
                </button>
            </div>

            <div class="side-panel">
                <div class="panel-card">
                    <div class="card-title">👥 玩家列表 <span class="accent"></span><span style="font-size:0.6rem;color:rgba(255,255,255,0.06);font-weight:400;" id="playerListCount">0</span></div>
                    <div class="player-list" id="playerList"><span style="color:rgba(255,255,255,0.04);">暂无玩家</span></div>
                </div>

                <div class="panel-card">
                    <div class="card-title">📊 状态 <span class="accent"></span></div>
                    <div style="font-size:0.7rem;color:rgba(255,255,255,0.06);line-height:2;">
                        <div>🟢 在线: <span id="onlineCount">0</span></div>
                        <div>✅ 已准备: <span id="readyCount">0</span></div>
                        <div>⏳ 等待中: <span id="waitingCount">0</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
    </script>

    <script>
        // ============================================================
        // 配置
        // ============================================================
        var config = {
            roomId: null,
            playerId: null,
            seats: [],
            playerCount: 12,
            isGameStarted: false
        };

        var connection = null;

        // ============================================================
        // SignalR 连接
        // ============================================================
        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/partyHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('RoomCreated', function(data) {
                    if (data.success) {
                        config.roomId = data.roomId;
                        config.playerId = data.playerId;
                        document.getElementById('roomCodeDisplay').textContent = data.roomId;
                        generateQRCode(data.roomId);
                        showToast('✅ 房间已创建！', 'success');
                        document.getElementById('phaseDisplay').textContent = '🪑 等待玩家';
                    }
                });

                connection.on('PlayerJoined', function(player) {
                    var seat = config.seats.find(function(s) { return s.number === player.seatNumber; });
                    if (seat) {
                        seat.occupied = true;
                        seat.player = { playerId: player.playerId, name: player.nickname, avatar: player.avatar || '🧑',
                            isReady: false };
                        seat.element.className = 'seat occupied';
                        seat.element.querySelector('.seat-name').textContent = player.nickname;
                        seat.element.querySelector('.seat-emoji').textContent = player.avatar || '🧑';
                        updateSeatCount();
                        updatePlayerList();
                        showToast('🟢 ' + player.nickname + ' 加入了 ' + seat.number + ' 号', 'success');
                    }
                });

                connection.on('PlayerReady', function(data) {
                    var seat = config.seats.find(function(s) { return s.number === data.seatNumber; });
                    if (seat && seat.player) {
                        seat.player.isReady = data.isReady;
                        seat.element.className = data.isReady ? 'seat ready' : 'seat occupied';
                        updatePlayerList();
                        updateStats();
                        checkAllReady();
                    }
                });

                connection.on('PlayerLeft', function(seatNumber) {
                    var seat = config.seats.find(function(s) { return s.number === seatNumber; });
                    if (seat) {
                        seat.occupied = false;
                        seat.player = null;
                        seat.element.className = 'seat empty';
                        seat.element.querySelector('.seat-name').textContent = '空位';
                        seat.element.querySelector('.seat-emoji').textContent = '🪑';
                        updateSeatCount();
                        updatePlayerList();
                        updateStats();
                        checkAllReady();
                    }
                });

                connection.on('GameStarted', function(room) {
                    showToast('🚀 游戏已开始！', 'success');
                    document.getElementById('phaseDisplay').textContent = '🎮 游戏中';
                    document.getElementById('startGameBtn').disabled = true;
                    document.getElementById('startGameBtn').textContent = '🎮 游戏进行中...';
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        createRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 创建房间
        // ============================================================
        function createRoom() {
            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                showToast('⏳ 正在连接...', 'info');
                setTimeout(createRoom, 1000);
                return;
            }

            connection.invoke('CreateRoom', '房主', 12)
                .then(function(result) {
                    if (result && result.success) {
                        // 由 RoomCreated 事件处理
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('❌ 创建房间失败:', err);
                    showToast('❌ 创建房间失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 生成座位图
        // ============================================================
        function generateSeats() {
            var container = document.getElementById('seatsContainer');
            var count = config.playerCount;
            container.innerHTML = '';
            config.seats = [];
            var radius = 38;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);

                config.seats.push({
                    number: i + 1,
                    element: seat,
                    occupied: false,
                    player: null
                });
            }
            updateSeatCount();
        }

        function updateSeatCount() {
            var occupied = config.seats.filter(function(s) { return s.occupied; }).length;
            document.getElementById('seatCount').textContent = occupied + '/' + config.seats.length;
            document.getElementById('playerCountDisplay').textContent = occupied + '/' + config.seats.length;
        }

        // ============================================================
        // 生成二维码
        // ============================================================
        function generateQRCode(roomId) {
            var container = document.getElementById('qrcode');
            container.innerHTML = '';
            var url = window.location.origin + '/Party/Player?roomId=' + roomId;

            try {
                new QRCode(container, {
                    text: url,
                    width: 160,
                    height: 160,
                    colorDark: '#00F0FF',
                    colorLight: 'transparent',
                    correctLevel: QRCode.CorrectLevel.H
                });
            } catch (e) {
                container.innerHTML =
                    '<div style="padding:1rem;text-align:center;color:rgba(255,255,255,0.1);font-size:0.7rem;">📱 扫码加入<br><span style="font-size:0.5rem;color:rgba(255,255,255,0.04);">' +
                    url + '</span></div>';
            }
        }

        // ============================================================
        // 更新玩家列表
        // ============================================================
        function updatePlayerList() {
            var container = document.getElementById('playerList');
            var occupied = config.seats.filter(function(s) { return s.occupied; });

            if (occupied.length === 0) {
                container.innerHTML = '<span style="color:rgba(255,255,255,0.04);">暂无玩家</span>';
                document.getElementById('playerListCount').textContent = '0';
                return;
            }

            var html = '';
            occupied.forEach(function(seat) {
                var player = seat.player;
                var isReady = player && player.isReady;
                html += '<div class="player-item">';
                html += '<span style="font-size:0.6rem;color:rgba(255,255,255,0.05);">#' + seat.number + '</span>';
                html += '<span style="font-size:0.8rem;">' + (player && player.avatar ? player.avatar : '🧑') + '</span>';
                html += '<span class="name">' + (player && player.name ? player.name : '玩家') + '</span>';
                html += '<span class="status ' + (isReady ? 'ready' : 'waiting') + '">' + (isReady ? '✅ 已准备' : '⏳ 等待') +
                    '</span>';
                html += '</div>';
            });

            container.innerHTML = html;
            document.getElementById('playerListCount').textContent = occupied.length;
        }

        // ============================================================
        // 更新统计
        // ============================================================
        function updateStats() {
            var occupied = config.seats.filter(function(s) { return s.occupied; });
            var ready = config.seats.filter(function(s) { return s.occupied && s.player && s.player.isReady; });

            document.getElementById('onlineCount').textContent = occupied.length;
            document.getElementById('readyCount').textContent = ready.length;
            document.getElementById('waitingCount').textContent = occupied.length - ready.length;
        }

        // ============================================================
        // 检查所有玩家是否已准备
        // ============================================================
        function checkAllReady() {
            var occupied = config.seats.filter(function(s) { return s.occupied; });
            var allReady = occupied.every(function(s) { return s.player && s.player.isReady; });

            var btn = document.getElementById('startGameBtn');
            if (allReady && occupied.length === config.playerCount) {
                btn.disabled = false;
                btn.textContent = '🐺 开始狼人杀';
                document.getElementById('phaseDisplay').textContent = '✅ 准备就绪';
            } else {
                btn.disabled = true;
                btn.textContent = '🐺 开始狼人杀';
                document.getElementById('phaseDisplay').textContent = '🪑 等待就坐';
            }
        }

        // ============================================================
        // ⭐ 开始狼人杀 - 跳转到 Werewolf/Host
        // ============================================================
        function startWerewolf() {
            if (!config.roomId) {
                showToast('⚠️ 房间未创建', 'error');
                return;
            }

            var btn = document.getElementById('startGameBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 跳转中...';

            // 通知后端游戏开始
            connection.invoke('StartGame', config.roomId)
                .then(function() {
                    // 跳转到狼人杀主控端
                    window.location.href = '/Werewolf/Host?roomId=' + config.roomId;
                })
                .catch(function(err) {
                    console.error('❌ 开始游戏失败:', err);
                    showToast('❌ 开始游戏失败: ' + err, 'error');
                    btn.disabled = false;
                    btn.textContent = '🐺 开始狼人杀';
                });
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            generateSeats();
            connectSignalR();

            // 模拟玩家（实际通过SignalR）
            setTimeout(function() {
                var demoPlayers = ['Alice', 'Bob', 'Carol', 'David', 'Eve', 'Frank', 'Grace', 'Henry', 'Ivy', 'Jack',
                    'Kevin', 'Lisa'
                ];
                demoPlayers.forEach(function(name, index) {
                    if (index < 12) {
                        var seatNumber = index + 1;
                        var seat = config.seats.find(function(s) { return s.number === seatNumber; });
                        if (seat) {
                            seat.occupied = true;
                            seat.player = {
                                playerId: 'demo_' + seatNumber,
                                name: name,
                                avatar: ['🧑', '👩', '👨', '🦸', '🧙', '🧚', '🤖', '👾', '🦊', '🐺', '🐱', '🐶'][
                                    index
                                ],
                                isReady: index % 2 === 0
                            };
                            seat.element.className = 'seat occupied';
                            seat.element.querySelector('.seat-name').textContent = name;
                            seat.element.querySelector('.seat-emoji').textContent = seat.player.avatar;
                        }
                    }
                });
                updateSeatCount();
                updatePlayerList();
                updateStats();
                checkAllReady();
            }, 1000);
        });
    </script>

</body>
</html>
