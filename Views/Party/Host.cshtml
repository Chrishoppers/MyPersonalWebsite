@{
    ViewData["Title"] = "✦ 派对控制中心 ✦";
    var username = Context.Session.GetString("Username") ?? "admin";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<style>
    /* ============================================================
       全局重置 & 基础
       ============================================================ */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
        background: #05050F; 
        font-family: 'Inter', 'Segoe UI', sans-serif;
        color: #e0e0e0;
        min-height: 100vh;
        overflow: hidden;
        margin: 0;
    }

    /* ============================================================
       粒子背景 Canvas
       ============================================================ */
    #particleCanvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    /* ============================================================
       主容器
       ============================================================ */
    .host-container {
        position: relative;
        z-index: 1;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem 2rem 2rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* ============================================================
       顶部光带
       ============================================================ */
    .top-light-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        z-index: 100;
        background: linear-gradient(90deg, 
            transparent 0%, 
            #00F0FF 15%, 
            #7B61FF 30%, 
            #FF006E 50%, 
            #7B61FF 70%, 
            #00F0FF 85%, 
            transparent 100%
        );
        animation: lightBarPulse 3s ease-in-out infinite;
        box-shadow: 0 0 40px rgba(0, 240, 255, 0.15);
    }

    @@keyframes lightBarPulse {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }

    /* ============================================================
       头部
       ============================================================ */
    .host-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0 1.5rem;
        border-bottom: 1px solid rgba(0, 240, 255, 0.06);
        flex-wrap: wrap;
        gap: 1rem;
    }

    .host-header .left {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .host-header .logo-icon {
        font-size: 2rem;
        animation: logoGlow 2s ease-in-out infinite;
    }

    @@keyframes logoGlow {
        0%, 100% { filter: drop-shadow(0 0 10px rgba(0, 240, 255, 0.1)); }
        50% { filter: drop-shadow(0 0 30px rgba(0, 240, 255, 0.3)); }
    }

    .host-header .title {
        font-size: 1.6rem;
        font-weight: 800;
        background: linear-gradient(135deg, #00F0FF, #7B61FF, #FF006E);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 0.06em;
    }

    .host-header .title .sub {
        font-size: 0.7rem;
        font-weight: 400;
        -webkit-text-fill-color: rgba(255,255,255,0.1);
        letter-spacing: 0.2em;
        display: block;
        margin-top: -0.1rem;
    }

    .host-header .right {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .host-header .user-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 1.2rem 0.4rem 0.8rem;
        border-radius: 40px;
        background: rgba(0, 240, 255, 0.04);
        border: 1px solid rgba(0, 240, 255, 0.06);
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
    }

    .host-header .user-badge .avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00F0FF, #7B61FF);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        color: #fff;
    }

    .host-header .user-badge .role {
        color: #FF006E;
        font-size: 0.55rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        background: rgba(255, 0, 110, 0.08);
        border: 1px solid rgba(255, 0, 110, 0.06);
    }

    .host-header .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #00FF88;
        animation: pulse 2s ease-in-out infinite;
        margin-right: 0.2rem;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(1.2); }
    }

    /* ============================================================
       主网格
       ============================================================ */
    .host-grid {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1.5rem;
        margin-top: 1.5rem;
        flex: 1;
    }

    @@media (max-width: 1100px) {
        .host-grid {
            grid-template-columns: 1fr;
            gap: 1.2rem;
        }
    }

    /* ============================================================
       卡片通用样式（全息毛玻璃）
       ============================================================ */
    .holo-card {
        background: rgba(10, 10, 30, 0.6);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(0, 240, 255, 0.06);
        border-radius: 24px;
        padding: 1.5rem 1.8rem;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .holo-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(ellipse at 30% 30%, rgba(0, 240, 255, 0.015), transparent 70%);
        pointer-events: none;
    }

    .holo-card:hover {
        border-color: rgba(0, 240, 255, 0.12);
        box-shadow: 0 0 60px rgba(0, 240, 255, 0.02);
    }

    .holo-card .card-title {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(0, 240, 255, 0.3);
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .holo-card .card-title .accent-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(0, 240, 255, 0.1), transparent);
    }

    .holo-card .card-title .badge-count {
        font-size: 0.6rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        background: rgba(0, 240, 255, 0.04);
        border: 1px solid rgba(0, 240, 255, 0.04);
        color: rgba(255,255,255,0.2);
    }

    /* ============================================================
       左侧：房间信息
       ============================================================ */
    .room-info-card {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .room-code-display {
        text-align: center;
        padding: 1.2rem 0.5rem;
        background: rgba(0, 240, 255, 0.02);
        border-radius: 16px;
        border: 1px solid rgba(0, 240, 255, 0.04);
        position: relative;
        overflow: hidden;
    }

    .room-code-display::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.02), transparent);
        animation: scanLine 4s ease-in-out infinite;
    }

    @@keyframes scanLine {
        0% { left: -100%; }
        100% { left: 200%; }
    }

    .room-code-display .label {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.08);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        position: relative;
        z-index: 1;
    }

    .room-code-display .code {
        font-family: 'Courier New', monospace;
        font-size: 2.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #00F0FF, #7B61FF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: 6px;
        position: relative;
        z-index: 1;
        text-shadow: 0 0 60px rgba(0, 240, 255, 0.05);
    }

    .room-code-display .copy-btn {
        position: relative;
        z-index: 1;
        background: none;
        border: none;
        color: rgba(255,255,255,0.08);
        cursor: pointer;
        font-size: 0.7rem;
        transition: color 0.3s ease;
        margin-top: 0.2rem;
    }
    .room-code-display .copy-btn:hover { color: rgba(255,255,255,0.2); }

    /* ============================================================
       二维码
       ============================================================ */
    .qr-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0.8rem;
        background: rgba(255,255,255,0.01);
        border-radius: 16px;
        border: 1px solid rgba(0, 240, 255, 0.04);
        position: relative;
        min-height: 180px;
    }

    .qr-container .qr-frame {
        position: absolute;
        inset: -1px;
        border-radius: 16px;
        padding: 2px;
        background: linear-gradient(135deg, rgba(0, 240, 255, 0.05), transparent, rgba(123, 97, 255, 0.05));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .qr-container #qrcode {
        position: relative;
        z-index: 1;
    }

    .qr-container #qrcode img {
        border-radius: 8px;
    }

    .qr-container .qr-hint {
        position: absolute;
        bottom: 0.8rem;
        font-size: 0.5rem;
        color: rgba(255,255,255,0.04);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .qr-container .qr-loading {
        color: rgba(255,255,255,0.06);
        font-size: 0.8rem;
        text-align: center;
        padding: 1rem;
    }

    /* ============================================================
       右侧：玩家列表
       ============================================================ */
    .players-card {
        display: flex;
        flex-direction: column;
        min-height: 400px;
    }

    .players-card .player-stats {
        display: flex;
        gap: 1.2rem;
        padding: 0.6rem 0 1rem;
        flex-wrap: wrap;
        border-bottom: 1px solid rgba(255,255,255,0.02);
        margin-bottom: 1rem;
    }

    .players-card .player-stats .stat-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.2);
    }

    .players-card .player-stats .stat-item .num {
        font-weight: 700;
        font-size: 1.1rem;
        color: #fff;
        font-family: 'Courier New', monospace;
    }

    .players-card .player-stats .stat-item .num.online { color: #00FF88; }
    .players-card .player-stats .stat-item .num.ready { color: #7B61FF; }
    .players-card .player-stats .stat-item .num.waiting { color: #FFB800; }

    /* ============================================================
       玩家列表
       ============================================================ */
    .player-list {
        flex: 1;
        overflow-y: auto;
        max-height: 420px;
        padding-right: 0.3rem;
    }

    .player-list::-webkit-scrollbar { width: 3px; }
    .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
    .player-list::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.08); border-radius: 10px; }

    .player-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.6rem 0.8rem;
        border-radius: 14px;
        margin-bottom: 0.3rem;
        transition: all 0.3s ease;
        border: 1px solid transparent;
        animation: playerEntry 0.5s ease;
    }

    @@keyframes playerEntry {
        from { opacity: 0; transform: translateX(-20px) scale(0.95); }
        to { opacity: 1; transform: translateX(0) scale(1); }
    }

    .player-item:hover {
        background: rgba(255,255,255,0.02);
        border-color: rgba(255,255,255,0.02);
    }

    .player-item .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        transition: all 0.3s ease;
    }

    .player-item .avatar.online { border-color: rgba(0, 255, 136, 0.1); }
    .player-item .avatar.ready { border-color: rgba(123, 97, 255, 0.15); box-shadow: 0 0 30px rgba(123, 97, 255, 0.03); }

    .player-item .info {
        flex: 1;
        min-width: 0;
    }

    .player-item .info .name {
        font-size: 0.85rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex-wrap: wrap;
    }

    .player-item .info .name .host-tag {
        font-size: 0.5rem;
        padding: 0.02rem 0.5rem;
        border-radius: 20px;
        background: rgba(255, 0, 110, 0.08);
        color: #FF006E;
        border: 1px solid rgba(255, 0, 110, 0.04);
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .player-item .info .name .admin-tag {
        font-size: 0.5rem;
        padding: 0.02rem 0.5rem;
        border-radius: 20px;
        background: rgba(0, 240, 255, 0.06);
        color: #00F0FF;
        border: 1px solid rgba(0, 240, 255, 0.04);
        font-weight: 600;
    }

    .player-item .info .status-text {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.1);
    }

    .player-item .info .status-text.ready { color: #7B61FF; }
    .player-item .info .status-text.online { color: #00FF88; }
    .player-item .info .status-text.waiting { color: #FFB800; }

    .player-item .actions {
        display: flex;
        gap: 0.2rem;
        flex-shrink: 0;
    }

    .player-item .actions .btn-icon {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 50%;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.08);
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
    }
    .player-item .actions .btn-icon:hover {
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
    }
    .player-item .actions .btn-icon.kick:hover {
        background: rgba(255, 0, 110, 0.08);
        color: #FF006E;
    }
    .player-item .actions .btn-icon.admin-toggle:hover {
        background: rgba(0, 240, 255, 0.06);
        color: #00F0FF;
    }

    .player-item .ready-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }
    .player-item .ready-dot.ready { background: #7B61FF; box-shadow: 0 0 20px rgba(123, 97, 255, 0.1); }
    .player-item .ready-dot.waiting { background: rgba(255,255,255,0.04); }

    .empty-players {
        text-align: center;
        padding: 2.5rem 0;
        color: rgba(255,255,255,0.04);
        font-size: 0.85rem;
    }

    /* ============================================================
       底部操作栏
       ============================================================ */
    .host-actions {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
        padding-top: 1.2rem;
        border-top: 1px solid rgba(255,255,255,0.02);
        align-items: center;
    }

    .btn-primary-glow {
        padding: 0.7rem 2.2rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #00F0FF, #7B61FF);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        box-shadow: 0 0 40px rgba(0, 240, 255, 0.05);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary-glow:hover:not(:disabled) {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 0 60px rgba(0, 240, 255, 0.1);
    }

    .btn-primary-glow:disabled {
        opacity: 0.3;
        cursor: not-allowed;
        transform: none;
    }

    .btn-primary-glow .icon { font-size: 1.1rem; }

    .btn-secondary-glow {
        padding: 0.7rem 2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .btn-secondary-glow:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
        border-color: rgba(255,255,255,0.06);
    }

    .btn-danger-glow {
        padding: 0.7rem 2rem;
        border: 1px solid rgba(255, 0, 110, 0.04);
        border-radius: 40px;
        background: rgba(255, 0, 110, 0.02);
        color: rgba(255, 0, 110, 0.3);
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .btn-danger-glow:hover {
        background: rgba(255, 0, 110, 0.04);
        color: #FF006E;
    }

    .btn-success-glow {
        padding: 0.7rem 2rem;
        border: 1px solid rgba(0, 255, 136, 0.04);
        border-radius: 40px;
        background: rgba(0, 255, 136, 0.02);
        color: rgba(0, 255, 136, 0.2);
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .btn-success-glow:hover:not(:disabled) {
        background: rgba(0, 255, 136, 0.04);
        color: #00FF88;
    }
    .btn-success-glow:disabled {
        opacity: 0.2;
        cursor: not-allowed;
    }

    .host-actions .status-text {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.06);
        margin-left: auto;
    }

    /* ============================================================
       底部光带
       ============================================================ */
    .bottom-light-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 1px;
        z-index: 100;
        background: linear-gradient(90deg, 
            transparent 0%, 
            rgba(123, 97, 255, 0.2) 25%, 
            rgba(0, 240, 255, 0.1) 50%, 
            rgba(255, 0, 110, 0.2) 75%, 
            transparent 100%
        );
    }

    /* ============================================================
       Toast
       ============================================================ */
    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.6rem 1.5rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: toastIn 0.4s ease;
        font-size: 0.85rem;
        backdrop-filter: blur(20px);
        background: rgba(10, 10, 30, 0.8);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(0, 255, 136, 0.1); border-color: rgba(0, 255, 136, 0.06); color: #00FF88; }
    .toast-msg.error { background: rgba(255, 0, 110, 0.1); border-color: rgba(255, 0, 110, 0.06); color: #FF006E; }
    .toast-msg.info { background: rgba(0, 240, 255, 0.06); border-color: rgba(0, 240, 255, 0.04); color: #00F0FF; }
    .toast-msg.warning { background: rgba(255, 184, 0, 0.06); border-color: rgba(255, 184, 0, 0.04); color: #FFB800; }

    @@keyframes toastIn {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ============================================================
       响应式
       ============================================================ */
    @@media (max-width: 640px) {
        .host-container { padding: 0.8rem 0.8rem 1.5rem; }
        .host-header .title { font-size: 1.1rem; }
        .host-header .right { gap: 0.5rem; }
        .room-code-display .code { font-size: 1.8rem; letter-spacing: 3px; }
        .host-grid { grid-template-columns: 1fr; gap: 1rem; }
        .holo-card { padding: 1rem 1rem; }
        .player-item { padding: 0.4rem 0.5rem; }
        .host-actions { flex-direction: column; align-items: stretch; }
        .host-actions .status-text { text-align: center; margin-left: 0; }
        .btn-primary-glow, .btn-secondary-glow, .btn-danger-glow { justify-content: center; }
        .players-card .player-stats { gap: 0.8rem; }
        .qr-container #qrcode img { width: 140px !important; height: 140px !important; }
    }

    @@media (max-width: 400px) {
        .room-code-display .code { font-size: 1.4rem; letter-spacing: 2px; }
        .host-header .title { font-size: 0.95rem; }
        .holo-card { padding: 0.8rem 0.8rem; }
        .player-item .avatar { width: 28px; height: 28px; font-size: 0.9rem; }
        .player-item .info .name { font-size: 0.75rem; }
    }
</style>

<!-- ============================================================
     粒子背景
     ============================================================ -->
<canvas id="particleCanvas"></canvas>

<!-- ============================================================
     顶部光带
     ============================================================ -->
<div class="top-light-bar"></div>
<div class="bottom-light-bar"></div>

<!-- ============================================================
     主容器
     ============================================================ -->
<div class="host-container">

    <!-- 头部 -->
    <div class="host-header">
        <div class="left">
            <span class="logo-icon">✦</span>
            <div>
                <div class="title">
                    派对控制中心
                    <span class="sub">✦ 全息管理终端 ✦</span>
                </div>
            </div>
        </div>
        <div class="right">
            <div class="user-badge">
                <div class="avatar">A</div>
                <span>@username</span>
                <span class="role">👑 主控</span>
            </div>
            <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);">
                <span class="status-dot"></span> 在线
            </span>
        </div>
    </div>

    <!-- 主网格 -->
    <div class="host-grid">

        <!-- ====== 左侧：房间信息 ====== -->
        <div class="holo-card room-info-card">
            <div class="card-title">
                📡 房间信息
                <span class="accent-line"></span>
