@{
    Layout = null;
    ViewData["Title"] = "✦ 全息派对中枢 ✦";
    var username = Context.Session.GetString("Username") ?? "admin";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>✦ 全息派对中枢 ✦</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局重置 - 可滚动
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            background: #05050F; 
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* ===== 粒子背景 ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        #particleCanvas2 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        /* ===== 网格扫描线 ===== */
        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.005) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 10s linear infinite;
        }

        @@keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        /* ===== 光带 ===== */
        .top-light-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            z-index: 100;
            background: linear-gradient(90deg, 
                transparent 0%, 
                #00F0FF 15%, 
                #7B61FF 30%, 
                #FF006E 50%, 
                #7B61FF 70%, 
                #00F0FF 85%, 
                transparent 100%
            );
            animation: lightBarPulse 3s ease-in-out infinite;
            box-shadow: 0 0 60px rgba(0, 240, 255, 0.1);
        }

        @@keyframes lightBarPulse {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }

        .bottom-light-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            z-index: 100;
            background: linear-gradient(90deg, 
                transparent 0%, 
                rgba(123, 97, 255, 0.3) 25%, 
                rgba(0, 240, 255, 0.15) 50%, 
                rgba(255, 0, 110, 0.3) 75%, 
                transparent 100%
            );
        }

        /* ============================================================
           主容器 - 可滚动
           ============================================================ */
        .host-container {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            padding: 1.5rem 2rem 2rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: 100vh;
        }

        /* ============================================================
           自定义滚动条 - 全息风格
           ============================================================ */
        .host-container::-webkit-scrollbar {
            width: 4px;
        }

        .host-container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.01);
            border-radius: 10px;
        }

        .host-container::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #00F0FF, #7B61FF);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.05);
        }

        .host-container::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #00F0FF, #EC4899);
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.1);
        }

        .host-container {
            scrollbar-width: thin;
            scrollbar-color: #7B61FF rgba(255, 255, 255, 0.01);
        }

        /* ============================================================
           头部
           ============================================================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 1.5rem;
            border-radius: 20px;
            background: rgba(10, 10, 30, 0.4);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.8rem;
            box-shadow: 0 8px 60px rgba(0, 0, 0, 0.3);
        }

        .header .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .brand .icon {
            font-size: 2rem;
            animation: wolfPulse 2s ease-in-out infinite;
            filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.1));
        }

        @@keyframes wolfPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); filter: drop-shadow(0 0 40px rgba(139, 92, 246, 0.3)); }
        }

        .header .brand h1 {
            font-size: 1.3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header .brand .sub {
            font-size: 0.45rem;
            color: rgba(255,255,255,0.04);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            display: block;
            margin-top: -2px;
        }

        .header .status-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .header .room-badge {
            padding: 0.3rem 1.2rem;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.02);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255,0.15);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .header .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            background: #00FF88;
            animation: pulse 2s infinite;
            margin-right: 4px;
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.05);
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(1.3); }
        }

        .header .user-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0.2rem 1rem 0.2rem 0.3rem;
            border-radius: 40px;
            background: rgba(139, 92, 246, 0.03);
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-size: 0.75rem;
            color: rgba(255,255,255,0.2);
        }

        .header .user-badge .avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.65rem;
            font-weight: 700;
            color: #fff;
        }

        /* ============================================================
           主网格
           ============================================================ */
        .host-grid {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 1.5rem;
            margin-top: 1.5rem;
            flex: 1;
            min-height: 0;
        }

        @@media (max-width: 1024px) {
            .host-grid { grid-template-columns: 1fr; gap: 16px; }
        }

        /* ============================================================
           毛玻璃卡片
           ============================================================ */
        .holo-card {
            background: rgba(10, 10, 30, 0.35);
            backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.5s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 80px rgba(0, 0, 0, 0.2);
        }

        .holo-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 24px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), transparent, rgba(0, 240, 255, 0.05));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .holo-card:hover {
            border-color: rgba(139, 92, 246, 0.06);
            box-shadow: 0 20px 100px rgba(0, 0, 0, 0.3);
        }

        .holo-card .card-title {
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.06);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            position: relative;
            z-index: 1;
        }

        .holo-card .card-title .accent {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent);
        }

        .holo-card .card-title .badge {
            font-size: 0.5rem;
            padding: 0.1rem 0.6rem;
            border-radius: 20px;
            background: rgba(139, 92, 246, 0.04);
            color: rgba(255,255,255,0.08);
            border: 1px solid rgba(139, 92, 246, 0.02);
        }

        /* ============================================================
           左侧 - 房间信息
           ============================================================ */
        .room-info-card {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .room-code-display {
            text-align: center;
            padding: 1.2rem 0.5rem;
            background: rgba(0, 240, 255, 0.02);
            border-radius: 16px;
            border: 1px solid rgba(0, 240, 255, 0.04);
            position: relative;
            overflow: hidden;
        }

        .room-code-display::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.02), transparent);
            animation: scanLine 4s ease-in-out infinite;
        }

        @@keyframes scanLine {
            0% { left: -100%; }
            100% { left: 200%; }
        }

        .room-code-display .label {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.08);
            text-transform: uppercase;
            letter-spacing: 0.2em;
            position: relative;
            z-index: 1;
        }

        .room-code-display .code {
            font-family: 'Courier New', monospace;
            font-size: 2.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 6px;
            position: relative;
            z-index: 1;
        }

        .room-code-display .copy-btn {
            position: relative;
            z-index: 1;
            background: none;
            border: none;
            color: rgba(255,255,255,0.08);
            cursor: pointer;
            font-size: 0.7rem;
            transition: color 0.3s ease;
            margin-top: 0.2rem;
            font-family: inherit;
        }
        .room-code-display .copy-btn:hover { color: rgba(255,255,255,0.2); }

        /* ============================================================
           二维码
           ============================================================ */
        .qr-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0.8rem;
            background: rgba(255,255,255,0.01);
            border-radius: 16px;
            border: 1px solid rgba(0, 240, 255, 0.04);
            position: relative;
            min-height: 180px;
        }

        .qr-container .qr-frame {
            position: absolute;
            inset: -1px;
            border-radius: 16px;
            padding: 2px;
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.05), transparent, rgba(123, 97, 255, 0.05));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .qr-container #qrcode { position: relative; z-index: 1; }
        .qr-container #qrcode img { border-radius: 8px; }
        .qr-container .qr-hint {
            position: absolute;
            bottom: 0.8rem;
            font-size: 0.5rem;
            color: rgba(255,255,255,0.04);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .qr-container .qr-loading {
            color: rgba(255,255,255,0.06);
            font-size: 0.8rem;
            text-align: center;
            padding: 1rem;
        }

        /* ============================================================
           游戏选择
           ============================================================ */
        .game-select-btn {
            padding: 0.4rem 1.2rem;
            border-radius: 30px;
            border: 2px solid rgba(255,255,255,0.04);
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.1);
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .game-select-btn:hover {
            border-color: rgba(0, 240, 255, 0.06);
            background: rgba(0, 240, 255, 0.02);
            color: rgba(255,255,255,0.2);
        }

        .game-select-btn.active {
            border-color: rgba(0, 240, 255, 0.06);
            background: rgba(0, 240, 255, 0.03);
            color: rgba(255,255,255,0.3);
        }

        .game-select-btn.coming {
            opacity: 0.3;
            cursor: not-allowed;
        }
        .game-select-btn.coming:hover {
            border-color: rgba(255,255,255,0.04);
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.1);
        }

        /* ============================================================
           玩家列表
           ============================================================ */
        .players-card {
            display: flex;
            flex-direction: column;
            min-height: 400px;
        }

        .players-card .player-stats {
            display: flex;
            gap: 1.2rem;
            padding: 0.6rem 0 1rem;
            flex-wrap: wrap;
            border-bottom: 1px solid rgba(255,255,255,0.02);
            margin-bottom: 1rem;
        }

        .players-card .player-stats .stat-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.75rem;
            color: rgba(255,255,255,0.2);
        }

        .players-card .player-stats .stat-item .num {
            font-weight: 700;
            font-size: 1.1rem;
            color: #fff;
            font-family: 'Courier New', monospace;
        }

        .players-card .player-stats .stat-item .num.online { color: #00FF88; }
        .players-card .player-stats .stat-item .num.ready { color: #7B61FF; }
        .players-card .player-stats .stat-item .num.waiting { color: #FFB800; }

        /* ============================================================
           玩家列表 - 内部滚动
           ============================================================ */
        .player-list {
            flex: 1;
            overflow-y: auto;
            max-height: 350px;
            padding-right: 0.3rem;
        }

        .player-list::-webkit-scrollbar { width: 3px; }
        .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .player-list::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.08); border-radius: 10px; }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.6rem 0.8rem;
            border-radius: 14px;
            margin-bottom: 0.3rem;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            animation: playerEntry 0.5s ease;
        }

        @@keyframes playerEntry {
            from { opacity: 0; transform: translateX(-20px) scale(0.95); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }

        .player-item:hover {
            background: rgba(255,255,255,0.02);
            border-color: rgba(255,255,255,0.02);
        }

        .player-item .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            transition: all 0.3s ease;
        }

        .player-item .avatar.online { border-color: rgba(0, 255, 136, 0.1); }
        .player-item .avatar.ready { border-color: rgba(123, 97, 255, 0.15); box-shadow: 0 0 30px rgba(123, 97, 255, 0.03); }

        .player-item .info {
            flex: 1;
            min-width: 0;
        }

        .player-item .info .name {
            font-size: 0.85rem;
            font-weight: 500;
            color: rgba(255,255,255,0.7);
            display: flex;
            align-items: center;
            gap: 0.3rem;
            flex-wrap: wrap;
        }

        .player-item .info .name .host-tag {
            font-size: 0.5rem;
            padding: 0.02rem 0.5rem;
            border-radius: 20px;
            background: rgba(255, 0, 110, 0.08);
            color: #FF006E;
            border: 1px solid rgba(255, 0, 110, 0.04);
            font-weight: 600;
            letter-spacing: 0.04em;
        }

        .player-item .info .name .admin-tag {
            font-size: 0.5rem;
            padding: 0.02rem 0.5rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.06);
            color: #00F0FF;
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-weight: 600;
        }

        .player-item .info .status-text {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.1);
        }

        .player-item .info .status-text.ready { color: #7B61FF; }
        .player-item .info .status-text.online { color: #00FF88; }
        .player-item .info .status-text.waiting { color: #FFB800; }

        .player-item .actions {
            display: flex;
            gap: 0.2rem;
            flex-shrink: 0;
        }

        .player-item .actions .btn-icon {
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.08);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            font-family: inherit;
        }
        .player-item .actions .btn-icon:hover {
            background: rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }
        .player-item .actions .btn-icon.kick:hover {
            background: rgba(255, 0, 110, 0.08);
            color: #FF006E;
        }
        .player-item .actions .btn-icon.admin-toggle:hover {
            background: rgba(0, 240, 255, 0.06);
            color: #00F0FF;
        }

        .player-item .ready-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }
        .player-item .ready-dot.ready { background: #7B61FF; box-shadow: 0 0 20px rgba(123, 97, 255, 0.1); }
        .player-item .ready-dot.waiting { background: rgba(255,255,255,0.04); }

        .empty-players {
            text-align: center;
            padding: 2.5rem 0;
            color: rgba(255,255,255,0.04);
            font-size: 0.85rem;
        }

        /* ============================================================
           底部操作栏
           ============================================================ */
        .host-actions {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(255,255,255,0.02);
            align-items: center;
        }

        .btn-primary-glow {
            padding: 0.7rem 2.2rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            color: #fff;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.05);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary-glow:hover:not(:disabled) {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 0 60px rgba(0, 240, 255, 0.1);
        }

        .btn-primary-glow:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none;
        }

        .btn-primary-glow .icon { font-size: 1.1rem; }

        .btn-secondary-glow {
            padding: 0.7rem 2rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.3);
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-secondary-glow:hover {
            background: rgba(255,255,255,0.04);
            color: #fff;
            border-color: rgba(255,255,255,0.06);
        }

        .btn-danger-glow {
            padding: 0.7rem 2rem;
            border: 1px solid rgba(255, 0, 110, 0.04);
            border-radius: 40px;
            background: rgba(255, 0, 110, 0.02);
            color: rgba(255, 0, 110, 0.3);
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-danger-glow:hover {
            background: rgba(255, 0, 110, 0.04);
            color: #FF006E;
        }

        .host-actions .status-text {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.06);
            margin-left: auto;
        }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 0.6rem 1.5rem;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.85rem;
            backdrop-filter: blur(20px);
            background: rgba(10, 10, 30, 0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0, 255, 136, 0.1); border-color: rgba(0, 255, 136, 0.06); color: #00FF88; }
        .toast-msg.error { background: rgba(255, 0, 110, 0.1); border-color: rgba(255, 0, 110, 0.06); color: #FF006E; }
        .toast-msg.info { background: rgba(0, 240, 255, 0.06); border-color: rgba(0, 240, 255, 0.04); color: #00F0FF; }
        .toast-msg.warning { background: rgba(255, 184, 0, 0.06); border-color: rgba(255, 184, 0, 0.04); color: #FFB800; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 768px) {
            .host-container { padding: 0.8rem 0.8rem 1.5rem; }
            .header .brand h1 { font-size: 1.1rem; }
            .header .right { gap: 0.5rem; }
            .room-code-display .code { font-size: 1.8rem; letter-spacing: 3px; }
            .host-grid { grid-template-columns: 1fr; gap: 1rem; }
            .holo-card { padding: 1rem 1rem; }
            .player-item { padding: 0.4rem 0.5rem; }
            .host-actions { flex-direction: column; align-items: stretch; }
            .host-actions .status-text { text-align: center; margin-left: 0; }
            .btn-primary-glow, .btn-secondary-glow, .btn-danger-glow { justify-content: center; }
            .player-list { max-height: 250px; }
        }

        @@media (max-width: 480px) {
            .room-code-display .code { font-size: 1.4rem; letter-spacing: 2px; }
            .header .brand h1 { font-size: 0.95rem; }
            .header .brand .icon { font-size: 1.4rem; }
            .header .user-badge { font-size: 0.65rem; padding: 0.2rem 0.8rem 0.2rem 0.5rem; }
            .header .user-badge .avatar { width: 22px; height: 22px; font-size: 0.55rem; }
            .holo-card { padding: 0.8rem 0.8rem; border-radius: 18px; }
            .player-item .avatar { width: 28px; height: 28px; font-size: 0.9rem; }
            .player-item .info .name { font-size: 0.75rem; }
            .game-select-btn { font-size: 0.6rem; padding: 0.3rem 0.8rem; }
            .qr-container #qrcode img { width: 120px !important; height: 120px !important; }
            .btn-primary-glow { font-size: 0.75rem; padding: 0.5rem 1.2rem; }
            .btn-secondary-glow, .btn-danger-glow { font-size: 0.7rem; padding: 0.5rem 1.2rem; }
            .player-list { max-height: 180px; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>
    <canvas id="particleCanvas2"></canvas>
    <div class="grid-overlay"></div>

    <!-- 光带 -->
    <div class="top-light-bar"></div>
    <div class="bottom-light-bar"></div>

    <!-- ============================================================
    ⭐ 主容器 - 可滚动
    ============================================================ -->
    <div class="host-container">

        <!-- ===== 头部 ===== -->
        <div class="header">
            <div class="brand">
                <span class="icon">✦</span>
                <div>
                    <div class="title">
                        全息派对中枢
                        <span class="sub">✦ 量子管理终端 ✦</span>
                    </div>
                </div>
            </div>
            <div class="right">
                <div class="user-badge">
                    <div class="avatar">@(username?.FirstOrDefault().ToString().ToUpper() ?? "A")</div>
                    <span>@username</span>
                    <span class="role">👑 主控</span>
                </div>
                <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);">
                    <span class="status-dot"></span> 在线
                </span>
            </div>
        </div>

        <!-- ===== 主网格 ===== -->
        <div class="host-grid">

            <!-- ===== 左侧面板 ===== -->
            <div style="display:flex;flex-direction:column;gap:1rem;">

                <!-- 房间信息 -->
                <div class="holo-card room-info-card">
                    <div class="card-title">
                        📡 房间信息
                        <span class="accent-line"></span>
                        <span class="badge-count" id="roomStatusBadge">● 等待中</span>
                    </div>

                    <div class="room-code-display">
                        <div class="label">✦ 房间识别码 ✦</div>
                        <div class="code" id="roomCodeDisplay">------</div>
                        <button class="copy-btn" onclick="copyRoomCode()">📋 复制</button>
                    </div>

                    <div class="qr-container">
                        <div class="qr-frame"></div>
                        <div id="qrcode">
                            <div class="qr-loading">⏳ 生成中...</div>
                        </div>
                        <div class="qr-hint">📱 扫码加入派对</div>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.3rem;text-align:center;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.02);">
                        <div>
                            <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">在线</div>
                            <div style="font-size:1.2rem;font-weight:700;color:#00FF88;font-family:'Courier New',monospace;" id="onlineCount">0</div>
                        </div>
                        <div>
                            <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">已准备</div>
                            <div style="font-size:1.2rem;font-weight:700;color:#7B61FF;font-family:'Courier New',monospace;" id="readyCount">0</div>
                        </div>
                        <div>
                            <div style="font-size:0.5rem;color:rgba(255,255,255,0.06);text-transform:uppercase;letter-spacing:0.06em;">最大</div>
                            <div style="font-size:1.2rem;font-weight:700;color:rgba(255,255,255,0.2);font-family:'Courier New',monospace;" id="maxCount">20</div>
                        </div>
                    </div>
                </div>

                <!-- ===== ⭐ 游戏选择 + 设置 ===== -->
                <div class="holo-card" style="flex-shrink:0;">
                    <div class="card-title">
                        🎮 游戏控制台
                        <span class="accent-line"></span>
                        <span class="badge-count" id="gameStatusBadge">● 选择游戏</span>
                    </div>

                    <!-- 游戏选择按钮 -->
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.8rem;">
                        <button class="game-select-btn active" data-game="werewolf" onclick="selectGame('werewolf')">
                            🐺 狼人杀
                        </button>
                        <button class="game-select-btn coming" data-game="spy" onclick="selectGame('spy')" disabled style="position:relative;">
                            🕵️ 谁是卧底
                            <span style="font-size:0.4rem;color:rgba(255,255,255,0.04);display:block;">开发中</span>
                        </button>
                        <button class="game-select-btn coming" data-game="draw" onclick="selectGame('draw')" disabled style="position:relative;">
                            🎨 你画我猜
                            <span style="font-size:0.4rem;color:rgba(255,255,255,0.04);display:block;">开发中</span>
                        </button>
                        <button class="game-select-btn coming" data-game="quiz" onclick="selectGame('quiz')" disabled style="position:relative;">
                            📝 知识竞答
                            <span style="font-size:0.4rem;color:rgba(255,255,255,0.04);display:block;">开发中</span>
                        </button>
                    </div>

                    <!-- 游戏设置 -->
                    <div id="gameSettings" style="background:rgba(255,255,255,0.01);border-radius:12px;padding:0.8rem 1rem;border:1px solid rgba(255,255,255,0.02);">
                        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                            <div>
                                <span style="font-size:0.6rem;color:rgba(255,255,255,0.08);text-transform:uppercase;letter-spacing:0.06em;">当前游戏</span>
                                <div style="font-size:1rem;font-weight:700;color:#fff;" id="selectedGameName">🐺 狼人杀</div>
                            </div>
                            <div style="display:flex;gap:0.8rem;flex-wrap:wrap;align-items:center;">
                                <div style="display:flex;align-items:center;gap:0.3rem;">
                                    <span style="font-size:0.5rem;color:rgba(255,255,255,0.06);">👥 人数</span>
                                    <select id="gamePlayerCount" onchange="updateGameSettings()" style="padding:0.2rem 0.6rem;border-radius:20px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);color:rgba(255,255,255,0.3);font-size:0.65rem;outline:none;font-family:inherit;">
                                        <option value="8">8人</option>
                                        <option value="10" selected>10人</option>
                                        <option value="12">12人</option>
                                        <option value="16">16人</option>
                                    </select>
                                </div>
                                <div style="display:flex;align-items:center;gap:0.3rem;">
                                    <span style="font-size:0.5rem;color:rgba(255,255,255,0.06);">⚙️ 模式</span>
                                    <select id="gameMode" onchange="updateGameSettings()" style="padding:0.2rem 0.6rem;border-radius:20px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);color:rgba(255,255,255,0.3);font-size:0.65rem;outline:none;font-family:inherit;">
                                        <option value="standard">标准</option>
                                        <option value="advanced">进阶</option>
                                        <option value="expert">专家</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div id="gameConfigDetail" style="font-size:0.6rem;color:rgba(255,255,255,0.06);margin-top:0.3rem;">
                            ⚙️ 3狼 · 3神 · 4民 · 10人局 · 标准模式
                        </div>
                    </div>
                </div>

            </div>

            <!-- ===== 右侧：玩家列表 ===== -->
            <div class="holo-card players-card">
                <div class="card-title">
                    👥 全息玩家列表
                    <span class="accent-line"></span>
                    <span class="badge-count" id="playerCountBadge">0 人</span>
                </div>

                <div class="player-stats">
                    <div class="stat-item">
                        🟢 在线 <span class="num online" id="statOnline">0</span>
                    </div>
                    <div class="stat-item">
                        🟣 已准备 <span class="num ready" id="statReady">0</span>
                    </div>
                    <div class="stat-item">
                        🟡 等待中 <span class="num waiting" id="statWaiting">0</span>
                    </div>
                </div>

                <div class="player-list" id="playerList">
                    <div class="empty-players">✦ 等待玩家接入 ✦</div>
                </div>

                <div class="host-actions">
                    <button class="btn-primary-glow" id="startGameBtn" onclick="startGame()" disabled>
                        <span class="icon">🚀</span> 开始 <span id="startGameName">狼人杀</span>
                    </button>
                    <button class="btn-secondary-glow" onclick="refreshRoom()">
                        🔄 刷新
                    </button>
                    <button class="btn-danger-glow" onclick="closeRoom()">
                        🗑️ 解散房间
                    </button>
                    <span class="status-text" id="actionStatusText">● 等待玩家加入</span>
                </div>
            </div>

        </div>

    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
    </script>

    <script>
        // ============================================================
        // 自动全屏
        // ============================================================
        function requestFullscreen() {
            var el = document.documentElement;
            if (el.requestFullscreen) {
                el.requestFullscreen().catch(function() {});
            } else if (el.webkitRequestFullscreen) {
                el.webkitRequestFullscreen();
            } else if (el.msRequestFullscreen) {
                el.msRequestFullscreen();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(requestFullscreen, 300);
        });

        document.addEventListener('click', function() {
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                requestFullscreen();
            }
        });

        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(80, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            var colors = ['rgba(139,92,246,', 'rgba(236,72,153,', 'rgba(245,158,11,', 'rgba(0,240,255,'];
            for (var i = 0; i < count; i++) {
                var color = colors[Math.floor(Math.random() * colors.length)];
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01,
                    color: color
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        (function initParticles2() {
            var canvas = document.getElementById('particleCanvas2');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(30, Math.floor(window.innerWidth / 16));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.03,
                    vy: (Math.random() - 0.5) * 0.03,
                    r: Math.random() * 2 + 1,
                    o: Math.random() * 0.04 + 0.005
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 复制房间码
        // ============================================================
        function copyRoomCode() {
            var code = document.getElementById('roomCodeDisplay').textContent;
            if (!code || code === '------') {
                showToast('⚠️ 暂无房间码', 'warning');
                return;
            }
            navigator.clipboard.writeText(code).then(function() {
                showToast('✅ 房间码已复制', 'success');
            }).catch(function() {
                var input = document.createElement('input');
                input.value = code;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                showToast('✅ 房间码已复制', 'success');
            });
        }

        // ============================================================
        // ⭐ 游戏选择系统
        // ============================================================
        var selectedGame = 'werewolf';
        var gameConfig = {
            werewolf: { 
                name: '🐺 狼人杀', 
                route: '/Werewolf/Waiting', 
                defaultPlayers: 10, 
                modes: ['标准', '进阶', '专家'],
                detail: { 8: '2狼 · 3神 · 3民', 10: '3狼 · 3神 · 4民', 12: '4狼 · 4神 · 4民', 16: '5狼 · 5神 · 6民' }
            },
            spy: { 
                name: '🕵️ 谁是卧底', 
                route: '/Spy/Host', 
                defaultPlayers: 8, 
                modes: ['标准', '困难'],
                detail: { 6: '4人 · 2卧底', 8: '6人 · 2卧底', 10: '7人 · 3卧底' }
            },
            draw: { 
                name: '🎨 你画我猜', 
                route: '/Draw/Host', 
                defaultPlayers: 6, 
                modes: ['标准', '计时'],
                detail: { 4: '4人轮流画', 6: '6人轮流画', 8: '8人轮流画' }
            },
            quiz: { 
                name: '📝 知识竞答', 
                route: '/Quiz/Host', 
                defaultPlayers: 12, 
                modes: ['标准', '抢答'],
                detail: { 6: '6人抢答', 8: '8人抢答', 12: '12人抢答', 16: '16人抢答' }
            }
        };

        function selectGame(game) {
            var btn = document.querySelector('.game-select-btn[data-game="' + game + '"]');
            if (btn && btn.classList.contains('coming')) {
                showToast('⏳ ' + gameConfig[game]?.name + ' 正在开发中，敬请期待！', 'warning');
                return;
            }

            selectedGame = game;
            
            document.querySelectorAll('.game-select-btn').forEach(function(btn) {
                btn.classList.remove('active');
                btn.style.borderColor = 'rgba(255,255,255,0.04)';
                btn.style.background = 'rgba(255,255,255,0.02)';
                btn.style.color = 'rgba(255,255,255,0.1)';
            });
            var activeBtn = document.querySelector('.game-select-btn[data-game="' + game + '"]');
            if (activeBtn) {
                activeBtn.classList.add('active');
                activeBtn.style.borderColor = 'rgba(0,240,255,0.06)';
                activeBtn.style.background = 'rgba(0,240,255,0.03)';
                activeBtn.style.color = 'rgba(255,255,255,0.3)';
            }
            
            var config = gameConfig[game];
            if (config) {
                document.getElementById('selectedGameName').textContent = config.name;
                document.getElementById('startGameName').textContent = config.name.replace(/[🐺🕵️🎨📝]\s*/, '');
                document.getElementById('gameStatusBadge').textContent = '● ' + config.name.replace(/[🐺🕵️🎨📝]\s*/, '');
            }
            
            var playerCounts = { werewolf: [8, 10, 12, 16], spy: [6, 8, 10], draw: [4, 6, 8], quiz: [6, 8, 12, 16] };
            var counts = playerCounts[game] || [8, 10, 12];
            var select = document.getElementById('gamePlayerCount');
            var currentVal = select.value;
            select.innerHTML = '';
            counts.forEach(function(c) {
                var opt = document.createElement('option');
                opt.value = c;
                opt.textContent = c + '人';
                if (c === gameConfig[game]?.defaultPlayers || c === parseInt(currentVal)) opt.selected = true;
                select.appendChild(opt);
            });
            
            updateGameSettings();
            showToast('🎮 已选择 ' + config.name, 'info');
        }

        function updateGameSettings() {
            var config = gameConfig[selectedGame];
            if (!config) return;
            
            var players = document.getElementById('gamePlayerCount').value;
            var mode = document.getElementById('gameMode').value;
            var modeLabel = document.getElementById('gameMode').options[document.getElementById('gameMode').selectedIndex]?.text || '标准';
            
            var detail = (config.detail && config.detail[players]) || players + '人 · ' + modeLabel;
            document.getElementById('gameConfigDetail').textContent = '⚙️ ' + detail + ' · ' + modeLabel + '模式';
            document.getElementById('gameStatusBadge').textContent = '● ' + detail;
        }

        // ============================================================
        // 游戏状态
        // ============================================================
        var gameState = {
            roomId: null,
            playerId: null,
            isHost: true,
            isAdmin: true,
            players: [],
            isGameStarted: false,
            isConnected: false,
            isRoomCreated: false
        };

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/partyHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('RoomCreated', function(data) {
                    console.log('🔍 RoomCreated:', data);

                    var roomId = data?.roomId || data?.room?.roomId;
                    var playerId = data?.playerId || data?.room?.hostUserId;

                    if (roomId) {
                        gameState.roomId = roomId;
                        gameState.playerId = playerId;
                        gameState.isRoomCreated = true;

                        document.getElementById('roomCodeDisplay').textContent = roomId;
                        generateQRCode(roomId);

                        showToast('✅ 房间已创建！房间码: ' + roomId, 'success');
                        updateRoomStatus('waiting');
                        document.getElementById('actionStatusText').textContent = '● 等待玩家加入';
                    } else {
                        console.error('❌ 创建房间失败', data);
                        showToast('❌ 创建房间失败，请刷新重试', 'error');
                    }
                });

                connection.on('PlayerJoined', function(player) {
                    showToast('🟢 ' + player.nickname + ' 加入了派对', 'info');
                    addPlayerToList(player);
                    updateStats();
                });

                connection.on('PlayerLeft', function(playerId) {
                    removePlayerFromList(playerId);
                    updateStats();
                });

                connection.on('PlayerReadyToggled', function(player) {
                    updatePlayerReady(player);
                    updateStats();
                });

                connection.on('RoomUpdated', function(room) {
                    syncRoomData(room);
                });

                connection.on('GameStarted', function(room) {
                    gameState.isGameStarted = true;
                    showToast('🚀 派对开始！所有玩家进入游戏！', 'success');
                    updateRoomStatus('playing');
                    document.getElementById('actionStatusText').textContent = '● 游戏进行中...';
                    document.getElementById('startGameBtn').disabled = true;
                    
                    var config = gameConfig[selectedGame];
                    if (config && config.route) {
                        setTimeout(function() {
                            window.location.href = config.route + '?roomId=' + gameState.roomId;
                        }, 1500);
                    }
                });

                connection.on('GameStartFailed', function(message) {
                    showToast('❌ ' + message, 'error');
                    document.getElementById('startGameBtn').disabled = false;
                });

                connection.on('Kicked', function(message) {
                    showToast('⚠️ ' + message, 'warning');
                    setTimeout(function() {
                        window.location.href = '/';
                    }, 2000);
                });

                connection.on('AdminUpdated', function(player) {
                    updatePlayerAdmin(player);
                });

                connection.start()
                    .then(function() {
                        gameState.isConnected = true;
                        console.log('✅ SignalR 已连接');
                        setTimeout(function() {
                            createRoom();
                        }, 500);
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(function() { connectSignalR(); }, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
                showToast('⚠️ 连接失败，请刷新重试', 'error');
            }
        }

        // ============================================================
        // 创建房间
        // ============================================================
        function createRoom() {
            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                showToast('⏳ 正在连接...', 'info');
                setTimeout(function() { createRoom(); }, 1000);
                return;
            }

            var hostName = '@username' || 'admin';
            console.log('📡 创建房间，主控:', hostName);

            connection.invoke('CreateRoom', hostName, 20, null)
                .then(function(result) {
                    console.log('📡 CreateRoom 返回:', result);
                    if (result && result.success) {
                        if (result.roomId && !gameState.roomId) {
                            gameState.roomId = result.roomId;
                            gameState.playerId = result.playerId;
                            gameState.isRoomCreated = true;

                            document.getElementById('roomCodeDisplay').textContent = result.roomId;
                            generateQRCode(result.roomId);
                            showToast('✅ 房间已创建！房间码: ' + result.roomId, 'success');
                            updateRoomStatus('waiting');
                            document.getElementById('actionStatusText').textContent = '● 等待玩家加入';
                        }
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('❌ 创建房间失败:', err);
                    showToast('❌ 创建房间失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 生成二维码
        // ============================================================
        var qrInstance = null;

        function generateQRCode(roomId) {
            var container = document.getElementById('qrcode');
            container.innerHTML = '';

            if (!roomId || roomId === '------') {
                container.innerHTML = '<div class="qr-loading">⏳ 等待房间码...</div>';
                return;
            }

            var url = window.location.origin + '/Party/Player?roomId=' + roomId;

            try {
                qrInstance = new QRCode(container, {
                    text: url,
                    width: 160,
                    height: 160,
                    colorDark: '#00F0FF',
                    colorLight: 'transparent',
                    correctLevel: QRCode.CorrectLevel.H
                });
                console.log('✅ 二维码已生成:', url);
            } catch (e) {
                console.error('❌ 二维码生成失败:', e);
                container.innerHTML =
                    '<div style="padding:1rem;text-align:center;color:rgba(255,255,255,0.1);font-size:0.7rem;">📱 扫码加入<br><span style="font-size:0.5rem;color:rgba(255,255,255,0.04);">' +
                    url + '</span></div>';
            }
        }

        // ============================================================
        // 玩家列表操作
        // ============================================================
        function addPlayerToList(player) {
            var list = document.getElementById('playerList');
            var empty = list.querySelector('.empty-players');
            if (empty) empty.remove();

            var existing = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
            if (existing) return;

            var isSelf = player.playerId === gameState.playerId;
            var isAdmin = player.isAdmin || false;
            var isHost = player.isHost || false;

            var div = document.createElement('div');
            div.className = 'player-item';
            div.dataset.id = player.playerId;
            div.innerHTML = `
                <div class="avatar ${player.isReady ? 'ready' : 'online'}">${player.avatarEmoji || '🧑'}</div>
                <div class="info">
                    <div class="name">
                        ${player.nickname}
                        ${isHost ? '<span class="host-tag">👑 主控</span>' : ''}
                        ${isAdmin && !isHost ? '<span class="admin-tag">⚡ 管理</span>' : ''}
                        ${isSelf ? '<span style="font-size:0.5rem;color:rgba(255,255,255,0.1);">(你)</span>' : ''}
                    </div>
                    <div class="status-text ${player.isReady ? 'ready' : 'waiting'}">
                        ${player.isReady ? '✅ 已准备' : '⏳ 未准备'}
                    </div>
                </div>
                <div class="actions">
                    <span class="ready-dot ${player.isReady ? 'ready' : 'waiting'}"></span>
                    ${!isSelf && !isHost ? `
                        <button class="btn-icon admin-toggle" onclick="toggleAdmin('${player.playerId}')" title="切换管理员">⚡</button>
                        <button class="btn-icon kick" onclick="kickPlayer('${player.playerId}')" title="踢出">✕</button>
                    ` : ''}
                    ${isSelf && !isHost ? `
                        <button class="btn-icon" onclick="toggleReady()" title="准备/取消准备" style="color:${player.isReady ? '#7B61FF' : 'rgba(255,255,255,0.08)'}">
                            ${player.isReady ? '✅' : '⏳'}
                        </button>
                    ` : ''}
                </div>
            `;

            list.appendChild(div);
            updateStats();
        }

        function removePlayerFromList(playerId) {
            var item = document.querySelector('.player-item[data-id="' + playerId + '"]');
            if (item) item.remove();

            var list = document.getElementById('playerList');
            if (!list.querySelector('.player-item')) {
                list.innerHTML = '<div class="empty-players">✦ 等待玩家接入 ✦</div>';
            }
            updateStats();
        }

        function updatePlayerReady(player) {
            var item = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
            if (!item) return;

            var avatar = item.querySelector('.avatar');
            var statusText = item.querySelector('.status-text');
            var dot = item.querySelector('.ready-dot');

            avatar.className = 'avatar ' + (player.isReady ? 'ready' : 'online');
            statusText.className = 'status-text ' + (player.isReady ? 'ready' : 'waiting');
            statusText.textContent = player.isReady ? '✅ 已准备' : '⏳ 未准备';
            if (dot) {
                dot.className = 'ready-dot ' + (player.isReady ? 'ready' : 'waiting');
            }

            if (player.playerId === gameState.playerId) {
                var selfBtn = item.querySelector('.btn-icon');
                if (selfBtn) {
                    selfBtn.textContent = player.isReady ? '✅' : '⏳';
                    selfBtn.style.color = player.isReady ? '#7B61FF' : 'rgba(255,255,255,0.08)';
                }
            }

            updateStats();
        }

        function updatePlayerAdmin(player) {
            var item = document.querySelector('.player-item[data-id="' + player.playerId + '"]');
            if (!item) return;

            var nameDiv = item.querySelector('.name');
            var oldTags = nameDiv.querySelectorAll('.admin-tag, .host-tag');
            oldTags.forEach(function(t) { t.remove(); });

            if (player.isHost) {
                var tag = document.createElement('span');
                tag.className = 'host-tag';
                tag.textContent = '👑 主控';
                nameDiv.appendChild(tag);
            } else if (player.isAdmin) {
                var tag = document.createElement('span');
                tag.className = 'admin-tag';
                tag.textContent = '⚡ 管理';
                nameDiv.appendChild(tag);
            }
            updateStats();
        }

        function syncRoomData(room) {
            if (!room || !room.players) return;

            var currentIds = new Set();
            document.querySelectorAll('.player-item').forEach(function(el) {
                currentIds.add(el.dataset.id);
            });

            var newIds = new Set();
            room.players.forEach(function(p) {
                newIds.add(p.playerId);
                if (!currentIds.has(p.playerId)) {
                    addPlayerToList(p);
                } else {
                    updatePlayerReady(p);
                    updatePlayerAdmin(p);
                }
            });

            currentIds.forEach(function(id) {
                if (!newIds.has(id)) {
                    removePlayerFromList(id);
                }
            });

            updateStats();

            if (room.status === 'playing') {
                gameState.isGameStarted = true;
                updateRoomStatus('playing');
                document.getElementById('actionStatusText').textContent = '● 游戏进行中...';
                document.getElementById('startGameBtn').disabled = true;
            }

            document.getElementById('maxCount').textContent = room.maxPlayers || 20;
        }

        // ============================================================
        // 更新统计
        // ============================================================
        function updateStats() {
            var items = document.querySelectorAll('.player-item');
            var total = items.length;
            var ready = 0;

            items.forEach(function(el) {
                var statusText = el.querySelector('.status-text');
                if (statusText && statusText.textContent.includes('已准备')) ready++;
            });

            document.getElementById('onlineCount').textContent = total;
            document.getElementById('readyCount').textContent = ready;
            document.getElementById('statOnline').textContent = total;
            document.getElementById('statReady').textContent = ready;
            document.getElementById('statWaiting').textContent = total - ready;
            document.getElementById('playerCountBadge').textContent = total + ' 人';

            var btn = document.getElementById('startGameBtn');
            if (total >= 2 && ready === total && ready > 0) {
                btn.disabled = false;
            } else {
                btn.disabled = true;
            }
        }

        // ============================================================
        // 更新房间状态
        // ============================================================
        function updateRoomStatus(status) {
            var badge = document.getElementById('roomStatusBadge');
            var statusMap = {
                'waiting': '● 等待中',
                'ready': '● 准备就绪',
                'playing': '● 进行中',
                'ended': '● 已结束'
            };
            badge.textContent = statusMap[status] || status;
        }

        // ============================================================
        // 玩家操作
        // ============================================================
        function toggleReady() {
            if (!connection || !gameState.roomId || !gameState.playerId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }
            connection.invoke('ToggleReady', gameState.roomId, gameState.playerId)
                .catch(function(err) {
                    console.error('切换准备状态失败:', err);
                    showToast('操作失败', 'error');
                });
        }

        // ⭐ 切换管理员
        function toggleAdmin(targetPlayerId) {
            if (!connection || !gameState.roomId || !gameState.playerId) return;
            if (!confirm('切换该用户的管理员权限？')) return;

            connection.invoke('ToggleAdmin', gameState.roomId, gameState.playerId, targetPlayerId)
                .then(function() {
                    showToast('✅ 管理员权限已切换', 'success');
                })
                .catch(function(err) {
                    console.error('切换管理员失败:', err);
                    showToast('操作失败', 'error');
                });
        }

        // ⭐ 踢出玩家
        function kickPlayer(targetPlayerId) {
            if (!connection || !gameState.roomId || !gameState.playerId) return;
            if (!confirm('确定要踢出该玩家吗？')) return;

            connection.invoke('KickPlayer', gameState.roomId, gameState.playerId, targetPlayerId)
                .then(function() {
                    showToast('🗑️ 已踢出', 'info');
                })
                .catch(function(err) {
                    console.error('踢出玩家失败:', err);
                    showToast('操作失败', 'error');
                });
        }

        // ⭐ 开始游戏
        // Party/Host.cshtml 中的 startGame()
function startGame() {
    if (!connection || !gameState.roomId || !gameState.playerId) return;

    var btn = document.getElementById('startGameBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="icon">⏳</span> 启动中...';

    var config = gameConfig[selectedGame];
    var gameName = config ? config.name : '游戏';

    // ⭐ 通知服务器，让所有玩家跳转
    connection.invoke('StartGame', gameState.roomId, gameState.playerId)
        .then(function() {
            showToast('🚀 ' + gameName + ' 开始！', 'success');
            // 房主自己也跳转
            window.location.href = '/Werewolf/Waiting?roomId=' + gameState.roomId;
        })
        .catch(function(err) {
            console.error('开始游戏失败:', err);
            showToast('❌ 开始游戏失败: ' + err, 'error');
            btn.disabled = false;
            btn.innerHTML = '<span class="icon">🚀</span> 开始 ' + (config ? config.name.replace(/[🐺🕵️🎨📝]\s*/, '') : '游戏');
        });
}
        function refreshRoom() {
            if (!connection || !gameState.roomId) {
                showToast('⚠️ 暂无房间', 'warning');
                return;
            }
            showToast('🔄 刷新中...', 'info');
            connection.invoke('RefreshRoom', gameState.roomId)
                .catch(function() {});
        }

        function closeRoom() {
            if (!confirm('确定要解散房间吗？所有玩家将被移出。')) return;
            showToast('🗑️ 房间已解散', 'warning');
            if (connection) {
                connection.stop();
            }
            setTimeout(function() {
                window.location.href = '/Game';
            }, 1500);
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 全息派对中枢启动...');
            connectSignalR();
        });
    </script>

</body>
</html>
