@{
    Layout = null;
    ViewData["Title"] = "✦ 全息登机舱 ✦";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>✦ 全息登机舱 ✦</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ===== 所有样式（同之前提供的 Player.cshtml 样式，这里不重复写） ===== */
        /* 直接复制之前 Player.cshtml 的样式部分 */
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>
    <canvas id="particleCanvas2"></canvas>
    <div class="grid-overlay"></div>

    <!-- 主容器 -->
    <div class="player-container">
        <div class="holo-card" id="mainCard">
            <!-- 装饰 -->
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <!-- 头部 -->
            <div class="player-header">
                <div class="icon-wrap">✦</div>
                <h1>全息登机舱</h1>
                <div class="sub">✦ 扫码加入派对 ✦</div>
            </div>

            <!-- 房间信息 -->
            <div class="room-info">
                <div class="label">✦ 派对房间 ✦</div>
                <div class="code" id="roomCodeDisplay">@(string.IsNullOrEmpty(roomId) ? "------" : roomId)</div>
                <div class="host-name">
                    <span class="dot"></span>
                    <span id="hostNameDisplay">🔄 连接中...</span>
                </div>
            </div>

            <!-- 未加入状态 -->
            <div id="joinForm">
                <div class="form-group">
                    <label>👤 你的代号</label>
                    <input type="text" id="nicknameInput" placeholder="输入你的昵称..." maxlength="20" autocomplete="off" />
                </div>

                <div class="form-group">
                    <label>🎨 选择全息头像</label>
                    <div class="avatar-select" id="avatarSelect">
                        <div class="avatar-option selected" data-emoji="🧑">🧑<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="👩">👩<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="👨">👨<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🦸">🦸<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🧙">🧙<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🧚">🧚<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🤖">🤖<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="👾">👾<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🦊">🦊<span class="check-mark">✓</span></div>
                        <div class="avatar-option" data-emoji="🐺">🐺<span class="check-mark">✓</span></div>
                    </div>
                </div>

                <button class="btn-join" id="joinBtn" onclick="joinRoom()">
                    🚀 进入派对
                </button>
            </div>

            <!-- 已加入状态 -->
            <div id="joinedStatus" style="display:none;">
                <div class="joined-status">
                    <span class="big-icon">✅</span>
                    <h2>登机成功</h2>
                    <div class="waiting-text">
                        <span class="pulse-dot"></span>
                        等待主控启动游戏
                    </div>

                    <div class="waiting-ring">
                        <div class="ring"></div>
                        <div class="ring"></div>
                        <div class="ring"></div>
                    </div>

                    <div class="mini-players-section">
                        <div class="mini-label">
                            👥 队友
                            <span class="count" id="miniCount">0</span>
                        </div>
                        <div class="mini-player-list" id="miniPlayerList">
                            <span class="mini-empty">✦ 等待队友加入 ✦</span>
                        </div>
                    </div>

                    <div class="joined-actions">
                        <button class="btn-action ready-btn" id="readyBtn" onclick="toggleReady()">
                            ⏳ 准备
                        </button>
                        <button class="btn-action leave-btn" onclick="leaveRoom()">
                            ✕ 离开
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 自动全屏
        // ============================================================
        function requestFullscreen() {
            var el = document.documentElement;
            if (el.requestFullscreen) {
                el.requestFullscreen().catch(function() {});
            } else if (el.webkitRequestFullscreen) {
                el.webkitRequestFullscreen();
            } else if (el.msRequestFullscreen) {
                el.msRequestFullscreen();
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(requestFullscreen, 300);
        });

        document.addEventListener('click', function() {
            if (!document.fullscreenElement && !document.webkitFullscreenElement) {
                requestFullscreen();
            }
        });

        // ============================================================
        // 粒子背景（2层）
        // ============================================================
        // ... 同之前 Player.cshtml 的粒子代码 ...

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            playerId: null,
            nickname: '',
            avatar: '🧑',
            isJoined: false,
            isReady: false
        };

        // ============================================================
        // 头像选择
        // ============================================================
        document.querySelectorAll('.avatar-option').forEach(function(el) {
            el.addEventListener('click', function() {
                document.querySelectorAll('.avatar-option').forEach(function(e) { e.classList.remove(
                    'selected'); });
                this.classList.add('selected');
                state.avatar = this.dataset.emoji;
            });
        });

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/partyHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('JoinedRoom', function(data) {
                    if (data.success) {
                        state.playerId = data.player.playerId;
                        state.isJoined = true;
                        document.getElementById('joinForm').style.display = 'none';
                        document.getElementById('joinedStatus').style.display = 'block';
                        document.getElementById('hostNameDisplay').textContent = '👑 ' + data.room.hostName;
                        showToast('✅ 登机成功！', 'success');
                        updateMiniList(data.room.players);
                        updateReadyButton();
                    }
                });

                connection.on('PlayerJoined', function(player) {
                    showToast('🟢 ' + player.nickname + ' 加入了派对', 'info');
                    updateMiniListFromEvent();
                });

                connection.on('PlayerLeft', function() {
                    updateMiniListFromEvent();
                });

                connection.on('PlayerReadyToggled', function(player) {
                    if (player.playerId === state.playerId) {
                        state.isReady = player.isReady;
                        updateReadyButton();
                    }
                    updateMiniListFromEvent();
                });

                connection.on('RoomUpdated', function(room) {
                    updateMiniList(room.players);
                });

                connection.on('GameStarted', function(room) {
                    showToast('🚀 派对开始！', 'success');
                    document.querySelector('#joinedStatus .waiting-text').innerHTML = '🎮 游戏进行中...';
                    document.querySelector('.waiting-ring').style.display = 'none';
                    document.querySelector('#joinedStatus h2').textContent = '🎮 游戏中';
                    document.getElementById('readyBtn').style.display = 'none';
                });

                connection.on('Kicked', function(message) {
                    showToast('⚠️ ' + message, 'warning');
                    setTimeout(function() { window.location.href = '/'; }, 2000);
                });

                connection.on('GameStartFailed', function(message) {
                    showToast('❌ ' + message, 'error');
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        validateRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(function() { connectSignalR(); }, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
                showToast('⚠️ 连接失败，请刷新重试', 'error');
            }
        }

        // ============================================================
        // 验证房间
        // ============================================================
        function validateRoom() {
            if (!state.roomId || state.roomId === '------') {
                document.getElementById('hostNameDisplay').textContent = '❌ 无效房间码';
                showToast('❌ 无效的房间码', 'error');
                document.getElementById('joinBtn').disabled = true;
                return;
            }

            fetch('/Party/ValidateRoom?roomId=' + state.roomId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        document.getElementById('hostNameDisplay').textContent = '👑 ' + data.roomName;
                    } else {
                        document.getElementById('hostNameDisplay').textContent = '❌ ' + data.message;
                        showToast('❌ ' + data.message, 'error');
                        document.getElementById('joinBtn').disabled = true;
                    }
                })
                .catch(function() {
                    document.getElementById('hostNameDisplay').textContent = '⚠️ 连接失败';
                });
        }

        // ============================================================
        // 加入房间
        // ============================================================
        function joinRoom() {
            var nickname = document.getElementById('nicknameInput').value.trim();
            if (!nickname) {
                showToast('⚠️ 请输入你的代号', 'error');
                document.getElementById('nicknameInput').focus();
                return;
            }
            if (nickname.length < 2) {
                showToast('⚠️ 代号至少 2 个字符', 'error');
                return;
            }

            state.nickname = nickname;

            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                showToast('⏳ 正在连接...', 'info');
                setTimeout(function() { joinRoom(); }, 500);
                return;
            }

            var btn = document.getElementById('joinBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 登机中...';

            connection.invoke('JoinRoom', state.roomId, nickname, state.avatar)
                .then(function(result) {
                    if (result && result.success) {
                        // 由 JoinedRoom 事件处理
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                        btn.disabled = false;
                        btn.textContent = '🚀 进入派对';
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                    btn.disabled = false;
                    btn.textContent = '🚀 进入派对';
                });
        }

        // ============================================================
        // 准备/取消准备
        // ============================================================
        function toggleReady() {
            if (!connection || !state.roomId || !state.playerId) {
                showToast('⚠️ 未加入房间', 'warning');
                return;
            }

            connection.invoke('ToggleReady', state.roomId, state.playerId)
                .catch(function(err) {
                    console.error('切换准备状态失败:', err);
                    showToast('操作失败', 'error');
                });
        }

        function updateReadyButton() {
            var btn = document.getElementById('readyBtn');
            if (state.isReady) {
                btn.textContent = '✅ 已准备';
                btn.classList.add('is-ready');
            } else {
                btn.textContent = '⏳ 准备';
                btn.classList.remove('is-ready');
            }
        }

        // ============================================================
        // 更新迷你玩家列表
        // ============================================================
        function updateMiniList(players) {
            var container = document.getElementById('miniPlayerList');
            var countEl = document.getElementById('miniCount');
            if (!container) return;

            countEl.textContent = players ? players.length : 0;

            if (!players || players.length === 0) {
                container.innerHTML = '<span class="mini-empty">✦ 等待队友加入 ✦</span>';
                return;
            }

            var html = '';
            players.forEach(function(p) {
                var isReady = p.isReady || false;
                var isHost = p.isHost || false;
                var isSelf = p.playerId === state.playerId;
                var avatarEmoji = p.avatarEmoji || '🧑';
                var name = p.nickname || '玩家';
                html += `
                    <div class="mini-item">
                        <div class="mini-avatar ${isReady ? 'ready' : ''} ${isHost ? 'host' : ''} ${isSelf ? 'self' : ''}">
                            ${avatarEmoji}
                        </div>
                        <div class="mini-name ${isReady ? 'active' : ''}">${name}${isSelf ? ' (你)' : ''}</div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function updateMiniListFromEvent() {
            if (!connection || !state.roomId) return;
            connection.invoke('GetRoomInfo', state.roomId)
                .then(function(room) {
                    if (room) { updateMiniList(room.players || []); }
                })
                .catch(function() {});
        }

        // ============================================================
        // 离开房间
        // ============================================================
        function leaveRoom() {
            if (!confirm('确定要离开房间吗？')) return;
            if (connection) { connection.stop(); }
            window.location.reload();
        }

        // ============================================================
        // 回车键提交
        // ============================================================
        document.getElementById('nicknameInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') joinRoom();
        });

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 全息登机舱启动...');
            connectSignalR();
        });
    </script>

</body>
</html>
