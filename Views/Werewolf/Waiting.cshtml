@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀 · 全息等待大厅";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString() ?? "";
    var username = Context.Session.GetString("Username") ?? "管理员";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀 · 全息等待大厅</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #05050F;
            font-family: 'Inter', sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            margin: 0;
            width: 100vw;
            height: 100vh;
        }

        .fullscreen-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            display: flex;
            flex-direction: column;
            padding: 1.5vh 2vw;
            background: #05050F;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        #particleCanvas2 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.005) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 10s linear infinite;
        }

        @@keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .top-light-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            z-index: 100;
            background: linear-gradient(90deg, transparent 0%, #00F0FF 15%, #7B61FF 30%, #FF006E 50%, #7B61FF 70%, #00F0FF 85%, transparent 100%);
            animation: lightBarPulse 3s ease-in-out infinite;
            box-shadow: 0 0 60px rgba(0, 240, 255, 0.1);
        }

        @@keyframes lightBarPulse {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }

        .bottom-light-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            z-index: 100;
            background: linear-gradient(90deg, transparent 0%, rgba(123, 97, 255, 0.3) 25%, rgba(0, 240, 255, 0.15) 50%, rgba(255, 0, 110, 0.3) 75%, transparent 100%);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 1.5rem;
            border-radius: 20px;
            background: rgba(10, 10, 30, 0.4);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.6rem;
            box-shadow: 0 8px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 2;
        }

        .header .brand { display: flex; align-items: center; gap: 10px; }
        .header .brand .icon { font-size: 1.8rem; animation: wolfPulse 2s ease-in-out infinite; }
        @@keyframes wolfPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
        .header .brand h1 {
            font-size: 1.3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .header .brand .sub { font-size: 0.45rem; color: rgba(255,255,255,0.06); letter-spacing: 0.15em; text-transform: uppercase; display: block; margin-top: -2px; }

        .header .status-group { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .header .room-badge {
            padding: 3px 14px;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.65rem;
            color: rgba(255,255,255, 0.2);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .header .user-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px 3px 6px;
            border-radius: 40px;
            background: rgba(139, 92, 246, 0.04);
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255, 0.3);
        }
        .header .user-badge .avatar {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.5rem;
            font-weight: 700;
            color: #fff;
        }

        .header .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00FF88;
            animation: pulse 2s infinite;
            margin-right: 4px;
        }

        .main-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 18px;
            padding: 0.8rem 0;
            min-height: 0;
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 1024px) {
            .main-grid { grid-template-columns: 1fr; gap: 14px; }
        }

        .holo-card {
            background: rgba(10, 10, 30, 0.35);
            backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            padding: 1.2rem 1.5rem;
            transition: all 0.5s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 80px rgba(0, 0, 0, 0.2);
        }

        .holo-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 24px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), transparent, rgba(0, 240, 255, 0.05));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .holo-card:hover { border-color: rgba(139, 92, 246, 0.06); }

        .holo-card .card-title {
            font-size: 0.55rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.06);
            margin-bottom: 0.6rem;
            display: flex;
            align-items: center;
            gap: 6px;
            position: relative;
            z-index: 1;
        }

        .holo-card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent); }

        .waiting-area {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 260px;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .waiting-area .big-icon {
            font-size: 4.5rem;
            margin-bottom: 0.3rem;
            animation: floatIcon3D 3s ease-in-out infinite;
            filter: drop-shadow(0 0 60px rgba(139, 92, 246, 0.05));
            transform-style: preserve-3d;
            perspective: 800px;
        }

        @@keyframes floatIcon3D {
            0%, 100% { transform: translateY(0) rotateY(0deg) scale(1); }
            25% { transform: translateY(-10px) rotateY(5deg) scale(1.03); }
            75% { transform: translateY(-10px) rotateY(-5deg) scale(1.03); }
        }

        .waiting-area .waiting-title {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientMove 4s ease-in-out infinite;
        }

        @@keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .waiting-area .waiting-sub {
            color: rgba(255,255,255,0.1);
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            margin-top: 0.15rem;
            animation: pulseText 2s ease-in-out infinite;
        }

        @@keyframes pulseText {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .progress-ring-container {
            margin: 1rem auto;
            position: relative;
            width: 120px;
            height: 120px;
        }

        .progress-ring-container svg { transform: rotate(-90deg); }
        .progress-ring-container .ring-bg { fill: none; stroke: rgba(255,255,255,0.02); stroke-width: 6; }
        .progress-ring-container .ring-fg {
            fill: none;
            stroke: url(#ringGradient);
            stroke-width: 6;
            stroke-linecap: round;
            stroke-dasharray: 314.16;
            stroke-dashoffset: 314.16;
            transition: stroke-dashoffset 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.05));
        }

        .progress-ring-container .center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2rem;
            font-weight: 800;
            color: #8B5CF6;
            font-family: 'Courier New', monospace;
            text-shadow: 0 0 40px rgba(139, 92, 246, 0.05);
        }

        .progress-ring-container .center-label {
            position: absolute;
            top: 74%;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.45rem;
            color: rgba(255,255,255,0.04);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            white-space: nowrap;
        }

        .stats-row {
            display: flex;
            gap: 1.5rem;
            padding: 0.3rem 0;
            flex-wrap: wrap;
            justify-content: center;
        }

        .stats-row .stat-item {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.08);
        }

        .stats-row .stat-item .num {
            font-weight: 700;
            font-size: 1rem;
            color: rgba(255,255,255,0.2);
            font-family: 'Courier New', monospace;
        }
        .stats-row .stat-item .num.green { color: #00FF88; }
        .stats-row .stat-item .num.purple { color: #8B5CF6; }
        .stats-row .stat-item .num.gold { color: #F59E0B; }

        .player-list {
            overflow-y: auto;
            max-height: 250px;
            padding-right: 4px;
        }

        .player-list::-webkit-scrollbar { width: 3px; }
        .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .player-list::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.08); border-radius: 10px; }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.5rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.4s ease;
            margin-bottom: 3px;
            animation: playerEntry 0.5s ease;
        }

        @@keyframes playerEntry {
            from { opacity: 0; transform: translateX(-20px) scale(0.95); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }

        .player-item:hover { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); }

        .player-item .avatar { font-size: 1rem; width: 28px; text-align: center; flex-shrink: 0; }
        .player-item .info { flex: 1; min-width: 0; }
        .player-item .info .name {
            color: rgba(255,255,255,0.3);
            font-size: 0.7rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            flex-wrap: wrap;
        }
        .player-item .info .name .ai-tag {
            font-size: 0.35rem;
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            color: #00F0FF;
            border: 1px solid rgba(0, 240, 255, 0.02);
            font-weight: 600;
            animation: aiGlow 2s ease-in-out infinite;
        }
        @@keyframes aiGlow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } }
        .player-item .info .name .me { color: rgba(139, 92, 246, 0.3); font-size: 0.4rem; margin-left: 4px; }

        .player-item .status {
            font-size: 0.4rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }
        .player-item .status.ready { background: rgba(0,255,136,0.06); color: #00FF88; border: 1px solid rgba(0,255,136,0.03); }
        .player-item .status.waiting { background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.02); }
        .player-item .status.host { background: rgba(139, 92, 246, 0.06); color: #8B5CF6; border: 1px solid rgba(139, 92, 246, 0.03); }
        .player-item .status.ai { background: rgba(0, 240, 255, 0.04); color: #00F0FF; border: 1px solid rgba(0, 240, 255, 0.02); }

        .player-item.ai-player { border-color: rgba(0, 240, 255, 0.04); background: rgba(0, 240, 255, 0.01); }
        .player-item.ai-player .avatar { animation: aiAvatarPulse 2s ease-in-out infinite; }
        @@keyframes aiAvatarPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }

        .player-empty {
            color: rgba(255,255,255,0.02);
            font-size: 0.65rem;
            text-align: center;
            padding: 1rem 0;
            letter-spacing: 0.06em;
        }

        .host-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
            padding-top: 0.6rem;
            border-top: 1px solid rgba(255,255,255,0.02);
        }

        .btn-primary {
            padding: 0.5rem 1.8rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            box-shadow: 0 0 40px rgba(139, 92, 246, 0.02);
        }

        .btn-primary:hover:not(:disabled) { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 60px rgba(139, 92, 246, 0.1); }
        .btn-primary:disabled { opacity: 0.2; cursor: not-allowed; transform: none !important; }

        .btn-ai {
            padding: 0.5rem 1.2rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            color: #fff;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.02);
            animation: aiBtnPulse 2s ease-in-out infinite;
        }
        @@keyframes aiBtnPulse { 0%, 100% { box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } 50% { box-shadow: 0 0 40px rgba(0, 240, 255, 0.08); } }
        .btn-ai:hover:not(:disabled) { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 60px rgba(0, 240, 255, 0.1); }
        .btn-ai:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }
        .btn-ai.active { background: linear-gradient(135deg, #00FF88, #00F0FF); }

        .btn-secondary {
            padding: 0.5rem 1.2rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.15);
            font-weight: 500;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }
        .btn-secondary:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); }

        .host-actions .status-text {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.04);
            margin-left: auto;
        }

        .ai-voice-indicator {
            display: none;
            align-items: center;
            gap: 0.4rem;
            padding: 0.2rem 0.8rem;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.5rem;
            color: rgba(0, 240, 255, 0.2);
            margin-top: 0.3rem;
        }
        .ai-voice-indicator.active { display: flex; animation: voicePulse 1s ease-in-out infinite; }
        @@keyframes voicePulse { 0%, 100% { opacity: 0.6; border-color: rgba(0, 240, 255, 0.04); } 50% { opacity: 1; border-color: rgba(0, 240, 255, 0.08); } }
        .ai-voice-indicator .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #00F0FF;
            animation: dotPulse 0.8s ease-in-out infinite;
        }
        @@keyframes dotPulse { 0%, 100% { opacity: 0.3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.3); } }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }
        .toast-msg {
            padding: 5px 16px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.7rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }
        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        @@media (max-width: 768px) {
            .fullscreen-container { padding: 0.5rem 0.6rem 0.8rem; }
            .header .brand h1 { font-size: 1rem; }
            .header .brand .icon { font-size: 1.4rem; }
            .header .room-badge { font-size: 0.5rem; padding: 2px 10px; }
            .waiting-area .waiting-title { font-size: 1.4rem; }
            .waiting-area .big-icon { font-size: 3rem; }
            .progress-ring-container { width: 90px; height: 90px; }
            .progress-ring-container .center-text { font-size: 1.4rem; }
            .main-grid { grid-template-columns: 1fr; gap: 10px; }
            .holo-card { padding: 0.8rem 1rem; }
            .host-actions { flex-direction: column; align-items: stretch; }
            .host-actions .status-text { text-align: center; margin-left: 0; }
            .btn-primary, .btn-ai, .btn-secondary { justify-content: center; }
            .player-list { max-height: 180px; }
            .stats-row { gap: 0.6rem; }
            .header .status-group { gap: 6px; }
        }

        @@media (max-width: 480px) {
            .header .brand h1 { font-size: 0.8rem; }
            .header .brand .icon { font-size: 1.2rem; }
            .header .room-badge { font-size: 0.4rem; padding: 2px 8px; }
            .waiting-area .waiting-title { font-size: 1.1rem; }
            .waiting-area .big-icon { font-size: 2.5rem; }
            .progress-ring-container { width: 70px; height: 70px; }
            .progress-ring-container .center-text { font-size: 1.1rem; }
            .player-item { padding: 0.25rem 0.3rem; }
            .player-item .avatar { font-size: 0.7rem; width: 20px; }
            .player-item .info .name { font-size: 0.6rem; }
            .player-item .status { font-size: 0.35rem; padding: 1px 5px; }
            .btn-primary { font-size: 0.65rem; padding: 0.4rem 1rem; }
            .btn-ai { font-size: 0.6rem; padding: 0.35rem 0.8rem; }
            .btn-secondary { font-size: 0.6rem; padding: 0.35rem 0.8rem; }
        }
    </style>

    <!-- ============ 身份牌揭晓动画 ============ -->
    <style>
        #roleRevealOverlay {
            position: fixed; inset: 0; z-index: 9999; display: none;
            align-items: center; justify-content: center;
            background: radial-gradient(120% 120% at 50% 30%, rgba(20,12,40,0.9), rgba(6,4,14,0.96));
            backdrop-filter: blur(12px);
        }
        #roleRevealOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        @@keyframes overlayFade { from { opacity: 0; } to { opacity: 1; } }

        .role-card-wrap { display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
        .role-card { width: 210px; height: 315px; perspective: 1400px; }
        .role-card-inner {
            position: relative; width: 100%; height: 100%;
            transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.25, 1);
            transform-style: preserve-3d;
        }
        .role-card.flipped .role-card-inner { transform: rotateY(180deg); }
        .role-card-front, .role-card-back {
            position: absolute; inset: 0; backface-visibility: hidden; border-radius: 20px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }
        .role-card-front {
            background: linear-gradient(135deg, #2a1b4d 0%, #120c26 100%);
            border: 1px solid rgba(139,92,246,0.45);
        }
        .role-card-front::before {
            content: ''; position: absolute; inset: 10px; border-radius: 14px;
            border: 1px dashed rgba(255,255,255,0.12);
        }
        .card-back-img { width: 100%; height: 100%; object-fit: cover; border-radius: 20px; }
        .role-card-back {
            background: linear-gradient(160deg, #2a1f45 0%, #140d26 100%);
            border: 1px solid rgba(255,255,255,0.18); transform: rotateY(180deg);
            padding: 0 0 0.7rem; justify-content: flex-start;
        }
        .role-img { width: 100%; height: 78%; object-fit: cover; border-radius: 20px 20px 0 0; }
        .role-card-back::after {
            content: ''; position: absolute; inset: 0; border-radius: 20px; pointer-events: none;
            background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.22) 50%, transparent 70%);
            transform: translateX(-110%); animation: cardShine 2.6s ease-in-out infinite;
        }
        @@keyframes cardShine { 0% { transform: translateX(-110%); } 55%, 100% { transform: translateX(110%); } }
        .role-particle { position: fixed; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; z-index: 9999; }
        .role-name { font-size: 1.9rem; font-weight: 900; color: #fff; margin-top: 0.5rem; letter-spacing: 0.1em; }
        .role-desc { font-size: 0.85rem; color: rgba(255,255,255,0.55); margin-top: 0.5rem; text-align: center; padding: 0 1.2rem; line-height: 1.6; }
        .role-confirm {
            padding: 0.8rem 2.4rem; font-size: 1rem; font-weight: 800; color: #fff;
            background: linear-gradient(135deg, #8B5CF6, #EC4899); border: none; border-radius: 50px;
            cursor: pointer; font-family: inherit; box-shadow: 0 8px 24px rgba(139,92,246,0.4);
            transition: transform 0.2s ease; animation: confirmIn 0.5s ease 0.8s both;
        }
        .role-confirm:hover { transform: translateY(-2px); }
        @@keyframes confirmIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        /* 游戏暂停遮罩 */
        #pauseOverlay {
            position: fixed; inset: 0; z-index: 9997; display: none;
            align-items: center; justify-content: center;
            background: rgba(6,4,14,0.82); backdrop-filter: blur(10px);
        }
        #pauseOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        .pause-box { text-align: center; }
        .pause-icon { font-size: 5rem; animation: pausePulse 1.4s ease-in-out infinite; }
        .pause-title { font-size: 1.8rem; font-weight: 900; color: #fff; margin-top: 0.6rem; letter-spacing: 0.1em; }
        .pause-names { font-size: 1rem; color: #F59E0B; margin-top: 0.5rem; font-weight: 700; }
        .pause-sub { font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 0.4rem; }
        @@keyframes pausePulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.12); opacity: 0.65; } }

        /* 规则说明弹窗 */
        #rulesOverlay { position: fixed; inset: 0; z-index: 9996; display: none; align-items: center; justify-content: center; background: rgba(6,4,14,0.85); backdrop-filter: blur(10px); }
        #rulesOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        .rules-modal { width: min(92vw, 460px); max-height: 82vh; background: linear-gradient(160deg, #1a1430, #0e0a1f); border: 1px solid rgba(139,92,246,0.4); border-radius: 24px; padding: 1.4rem; display: flex; flex-direction: column; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
        .rules-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .rules-title { font-size: 1.1rem; font-weight: 800; color: #fff; }
        .rules-page { color: rgba(255,255,255,0.4); font-size: 0.8rem; }
        .rules-progress { font-size: 0.72rem; color: #4ade80; }
        .rules-body { flex: 1; overflow-y: auto; min-height: 240px; margin-bottom: 1rem; }
        .rules-body .rb-title { font-size: 1.05rem; font-weight: 800; color: #A78BFA; margin-bottom: 0.6rem; }
        .rules-body .rb-item { color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.7; margin: 0.3rem 0; }
        .rules-footer { display: flex; gap: 0.5rem; }
        .rules-btn { flex: 1; padding: 0.65rem; font-size: 0.85rem; font-weight: 700; color: #fff; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; cursor: pointer; font-family: inherit; }
        .rules-btn.confirm { background: linear-gradient(135deg, #8B5CF6, #EC4899); border: none; }

        /* 角色配置弹窗 */
        #roleModal { position: fixed; inset: 0; z-index: 9995; display: none; align-items: center; justify-content: center; background: rgba(6,4,14,0.85); backdrop-filter: blur(10px); }
        #roleModal.show { display: flex; animation: overlayFade 0.3s ease; }
        .role-modal { width: min(92vw, 480px); max-height: 80vh; background: linear-gradient(160deg, #1a1430, #0e0a1f); border: 1px solid rgba(139,92,246,0.4); border-radius: 20px; padding: 1.2rem; display: flex; flex-direction: column; }
        .rm-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }
        .rm-title { font-size: 1.05rem; font-weight: 800; color: #fff; }
        .rm-close { cursor: pointer; color: rgba(255,255,255,0.5); font-size: 1.2rem; }
        .rm-body { flex: 1; overflow-y: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.8rem; }
        .role-check { display: flex; align-items: center; gap: 0.35rem; padding: 0.5rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; cursor: pointer; font-size: 0.8rem; color: rgba(255,255,255,0.8); user-select: none; }
        .role-check.checked { border-color: rgba(139,92,246,0.5); background: rgba(139,92,246,0.14); color: #fff; }
        .rm-footer { display: flex; gap: 0.5rem; }

        /* 极光霓虹背景 */
        .aurora { position: fixed; border-radius: 50%; filter: blur(80px); opacity: 0.45; pointer-events: none; z-index: 0; }
        .aurora-1 { width: 42vw; height: 42vw; background: radial-gradient(circle, rgba(139,92,246,0.55), transparent 70%); top: -10%; left: -6%; animation: auroraFloat 18s ease-in-out infinite; }
        .aurora-2 { width: 36vw; height: 36vw; background: radial-gradient(circle, rgba(236,72,153,0.4), transparent 70%); bottom: -8%; right: -6%; animation: auroraFloat 22s ease-in-out infinite reverse; }
        .aurora-3 { width: 30vw; height: 30vw; background: radial-gradient(circle, rgba(0,240,255,0.35), transparent 70%); top: 38%; left: 58%; animation: auroraFloat 26s ease-in-out infinite; }
        @@keyframes auroraFloat { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(6vw,4vw) scale(1.18); } }

        /* 全息 HUD 特效 */
        .scanlines { position: fixed; inset: 0; z-index: 48; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(255,255,255,0.018) 0 1px, transparent 1px 3px); mix-blend-mode: overlay; }
        .scanbar { position: fixed; left: 0; right: 0; height: 130px; z-index: 49; pointer-events: none; background: linear-gradient(180deg, transparent, rgba(0,240,255,0.07), rgba(139,92,246,0.04), transparent); animation: scanSweep 5s linear infinite; }
        @@keyframes scanSweep { 0% { top: -130px; } 100% { top: 100vh; } }
        .hud-frame { position: fixed; inset: 12px; z-index: 47; pointer-events: none; border: 1px solid rgba(0,240,255,0.08); box-shadow: inset 0 0 46px rgba(0,240,255,0.03); border-radius: 4px; }
        .hud-corner { position: fixed; width: 26px; height: 26px; z-index: 47; pointer-events: none; border: 2px solid rgba(0,240,255,0.35); }
        .hud-corner.tl { top: 18px; left: 18px; border-right: none; border-bottom: none; }
        .hud-corner.tr { top: 18px; right: 18px; border-left: none; border-bottom: none; }
        .hud-corner.bl { bottom: 18px; left: 18px; border-right: none; border-top: none; }
        .hud-corner.br { bottom: 18px; right: 18px; border-left: none; border-top: none; }
        /* 语音识别 */
        .mic-btn { position: fixed; right: 20px; bottom: 20px; z-index: 100; width: 56px; height: 56px; border-radius: 50%; border: 2px solid rgba(0,240,255,0.5); background: linear-gradient(135deg, rgba(0,240,255,0.16), rgba(139,92,246,0.16)); color: #fff; font-size: 1.3rem; cursor: pointer; box-shadow: 0 6px 20px rgba(0,240,255,0.3); transition: all 0.2s ease; }
        .mic-btn:active { transform: scale(0.92); }
        .speech-preview { position: fixed; right: 20px; bottom: 84px; z-index: 100; max-width: 70vw; padding: 0.6rem 1rem; background: rgba(20,12,40,0.92); border: 1px solid rgba(0,240,255,0.3); border-radius: 12px; color: #fff; font-size: 0.9rem; display: none; }
    </style>
</head>
<body>

