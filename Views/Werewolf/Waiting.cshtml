@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀 · 全息等待大厅";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString() ?? "";
    var username = Context.Session.GetString("Username") ?? "管理员";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀 · 全息等待大厅</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #05050F;
            font-family: 'Inter', sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            margin: 0;
            width: 100vw;
            height: 100vh;
        }

        .fullscreen-container {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            display: flex;
            flex-direction: column;
            padding: 1.5vh 2vw;
            background: #05050F;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        #particleCanvas2 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        .grid-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.005) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.005) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: gridMove 10s linear infinite;
        }

        @@keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .top-light-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            z-index: 100;
            background: linear-gradient(90deg, transparent 0%, #00F0FF 15%, #7B61FF 30%, #FF006E 50%, #7B61FF 70%, #00F0FF 85%, transparent 100%);
            animation: lightBarPulse 3s ease-in-out infinite;
            box-shadow: 0 0 60px rgba(0, 240, 255, 0.1);
        }

        @@keyframes lightBarPulse {
            0%, 100% { opacity: 0.4; }
            50% { opacity: 1; }
        }

        .bottom-light-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            z-index: 100;
            background: linear-gradient(90deg, transparent 0%, rgba(123, 97, 255, 0.3) 25%, rgba(0, 240, 255, 0.15) 50%, rgba(255, 0, 110, 0.3) 75%, transparent 100%);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 1.5rem;
            border-radius: 20px;
            background: rgba(10, 10, 30, 0.4);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.6rem;
            box-shadow: 0 8px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            z-index: 2;
        }

        .header .brand { display: flex; align-items: center; gap: 10px; }
        .header .brand .icon { font-size: 1.8rem; animation: wolfPulse 2s ease-in-out infinite; }
        @@keyframes wolfPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
        .header .brand h1 {
            font-size: 1.3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .header .brand .sub { font-size: 0.45rem; color: rgba(255,255,255,0.06); letter-spacing: 0.15em; text-transform: uppercase; display: block; margin-top: -2px; }

        .header .status-group { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .header .room-badge {
            padding: 3px 14px;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.65rem;
            color: rgba(255,255,255, 0.2);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .header .user-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px 3px 6px;
            border-radius: 40px;
            background: rgba(139, 92, 246, 0.04);
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255, 0.3);
        }
        .header .user-badge .avatar {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.5rem;
            font-weight: 700;
            color: #fff;
        }

        .header .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00FF88;
            animation: pulse 2s infinite;
            margin-right: 4px;
        }

        .main-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 18px;
            padding: 0.8rem 0;
            min-height: 0;
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 1024px) {
            .main-grid { grid-template-columns: 1fr; gap: 14px; }
        }

        .holo-card {
            background: rgba(10, 10, 30, 0.35);
            backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            padding: 1.2rem 1.5rem;
            transition: all 0.5s ease;
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 80px rgba(0, 0, 0, 0.2);
        }

        .holo-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 24px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), transparent, rgba(0, 240, 255, 0.05));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
        }

        .holo-card:hover { border-color: rgba(139, 92, 246, 0.06); }

        .holo-card .card-title {
            font-size: 0.55rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.06);
            margin-bottom: 0.6rem;
            display: flex;
            align-items: center;
            gap: 6px;
            position: relative;
            z-index: 1;
        }

        .holo-card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent); }

        .waiting-area {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 260px;
            text-align: center;
            position: relative;
            z-index: 1;
        }

        .waiting-area .big-icon {
            font-size: 4.5rem;
            margin-bottom: 0.3rem;
            animation: floatIcon3D 3s ease-in-out infinite;
            filter: drop-shadow(0 0 60px rgba(139, 92, 246, 0.05));
            transform-style: preserve-3d;
            perspective: 800px;
        }

        @@keyframes floatIcon3D {
            0%, 100% { transform: translateY(0) rotateY(0deg) scale(1); }
            25% { transform: translateY(-10px) rotateY(5deg) scale(1.03); }
            75% { transform: translateY(-10px) rotateY(-5deg) scale(1.03); }
        }

        .waiting-area .waiting-title {
            font-size: 2rem;
            font-weight: 900;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientMove 4s ease-in-out infinite;
        }

        @@keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .waiting-area .waiting-sub {
            color: rgba(255,255,255,0.1);
            font-size: 0.85rem;
            letter-spacing: 0.08em;
            margin-top: 0.15rem;
            animation: pulseText 2s ease-in-out infinite;
        }

        @@keyframes pulseText {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        .progress-ring-container {
            margin: 1rem auto;
            position: relative;
            width: 120px;
            height: 120px;
        }

        .progress-ring-container svg { transform: rotate(-90deg); }
        .progress-ring-container .ring-bg { fill: none; stroke: rgba(255,255,255,0.02); stroke-width: 6; }
        .progress-ring-container .ring-fg {
            fill: none;
            stroke: url(#ringGradient);
            stroke-width: 6;
            stroke-linecap: round;
            stroke-dasharray: 314.16;
            stroke-dashoffset: 314.16;
            transition: stroke-dashoffset 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            filter: drop-shadow(0 0 20px rgba(139, 92, 246, 0.05));
        }

        .progress-ring-container .center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2rem;
            font-weight: 800;
            color: #8B5CF6;
            font-family: 'Courier New', monospace;
            text-shadow: 0 0 40px rgba(139, 92, 246, 0.05);
        }

        .progress-ring-container .center-label {
            position: absolute;
            top: 74%;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.45rem;
            color: rgba(255,255,255,0.04);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            white-space: nowrap;
        }

        .stats-row {
            display: flex;
            gap: 1.5rem;
            padding: 0.3rem 0;
            flex-wrap: wrap;
            justify-content: center;
        }

        .stats-row .stat-item {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.08);
        }

        .stats-row .stat-item .num {
            font-weight: 700;
            font-size: 1rem;
            color: rgba(255,255,255,0.2);
            font-family: 'Courier New', monospace;
        }
        .stats-row .stat-item .num.green { color: #00FF88; }
        .stats-row .stat-item .num.purple { color: #8B5CF6; }
        .stats-row .stat-item .num.gold { color: #F59E0B; }

        .player-list {
            overflow-y: auto;
            max-height: 250px;
            padding-right: 4px;
        }

        .player-list::-webkit-scrollbar { width: 3px; }
        .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .player-list::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.08); border-radius: 10px; }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.4rem 0.5rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.4s ease;
            margin-bottom: 3px;
            animation: playerEntry 0.5s ease;
        }

        @@keyframes playerEntry {
            from { opacity: 0; transform: translateX(-20px) scale(0.95); }
            to { opacity: 1; transform: translateX(0) scale(1); }
        }

        .player-item:hover { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); }

        .player-item .avatar { font-size: 1rem; width: 28px; text-align: center; flex-shrink: 0; }
        .player-item .info { flex: 1; min-width: 0; }
        .player-item .info .name {
            color: rgba(255,255,255,0.3);
            font-size: 0.7rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            flex-wrap: wrap;
        }
        .player-item .info .name .ai-tag {
            font-size: 0.35rem;
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            color: #00F0FF;
            border: 1px solid rgba(0, 240, 255, 0.02);
            font-weight: 600;
            animation: aiGlow 2s ease-in-out infinite;
        }
        @@keyframes aiGlow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } }
        .player-item .info .name .me { color: rgba(139, 92, 246, 0.3); font-size: 0.4rem; margin-left: 4px; }

        .player-item .status {
            font-size: 0.4rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }
        .player-item .status.ready { background: rgba(0,255,136,0.06); color: #00FF88; border: 1px solid rgba(0,255,136,0.03); }
        .player-item .status.waiting { background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.02); }
        .player-item .status.host { background: rgba(139, 92, 246, 0.06); color: #8B5CF6; border: 1px solid rgba(139, 92, 246, 0.03); }
        .player-item .status.ai { background: rgba(0, 240, 255, 0.04); color: #00F0FF; border: 1px solid rgba(0, 240, 255, 0.02); }

        .player-item.ai-player { border-color: rgba(0, 240, 255, 0.04); background: rgba(0, 240, 255, 0.01); }
        .player-item.ai-player .avatar { animation: aiAvatarPulse 2s ease-in-out infinite; }
        @@keyframes aiAvatarPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }

        .player-empty {
            color: rgba(255,255,255,0.02);
            font-size: 0.65rem;
            text-align: center;
            padding: 1rem 0;
            letter-spacing: 0.06em;
        }

        .host-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            align-items: center;
            padding-top: 0.6rem;
            border-top: 1px solid rgba(255,255,255,0.02);
        }

        .btn-primary {
            padding: 0.5rem 1.8rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            box-shadow: 0 0 40px rgba(139, 92, 246, 0.02);
        }

        .btn-primary:hover:not(:disabled) { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 60px rgba(139, 92, 246, 0.1); }
        .btn-primary:disabled { opacity: 0.2; cursor: not-allowed; transform: none !important; }

        .btn-ai {
            padding: 0.5rem 1.2rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            color: #fff;
            font-weight: 700;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.02);
            animation: aiBtnPulse 2s ease-in-out infinite;
        }
        @@keyframes aiBtnPulse { 0%, 100% { box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } 50% { box-shadow: 0 0 40px rgba(0, 240, 255, 0.08); } }
        .btn-ai:hover:not(:disabled) { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 60px rgba(0, 240, 255, 0.1); }
        .btn-ai:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }
        .btn-ai.active { background: linear-gradient(135deg, #00FF88, #00F0FF); }

        .btn-secondary {
            padding: 0.5rem 1.2rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.15);
            font-weight: 500;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }
        .btn-secondary:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); }

        .host-actions .status-text {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.04);
            margin-left: auto;
        }

        .ai-voice-indicator {
            display: none;
            align-items: center;
            gap: 0.4rem;
            padding: 0.2rem 0.8rem;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.5rem;
            color: rgba(0, 240, 255, 0.2);
            margin-top: 0.3rem;
        }
        .ai-voice-indicator.active { display: flex; animation: voicePulse 1s ease-in-out infinite; }
        @@keyframes voicePulse { 0%, 100% { opacity: 0.6; border-color: rgba(0, 240, 255, 0.04); } 50% { opacity: 1; border-color: rgba(0, 240, 255, 0.08); } }
        .ai-voice-indicator .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #00F0FF;
            animation: dotPulse 0.8s ease-in-out infinite;
        }
        @@keyframes dotPulse { 0%, 100% { opacity: 0.3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.3); } }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }
        .toast-msg {
            padding: 5px 16px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.7rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }
        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        @@media (max-width: 768px) {
            .fullscreen-container { padding: 0.5rem 0.6rem 0.8rem; }
            .header .brand h1 { font-size: 1rem; }
            .header .brand .icon { font-size: 1.4rem; }
            .header .room-badge { font-size: 0.5rem; padding: 2px 10px; }
            .waiting-area .waiting-title { font-size: 1.4rem; }
            .waiting-area .big-icon { font-size: 3rem; }
            .progress-ring-container { width: 90px; height: 90px; }
            .progress-ring-container .center-text { font-size: 1.4rem; }
            .main-grid { grid-template-columns: 1fr; gap: 10px; }
            .holo-card { padding: 0.8rem 1rem; }
            .host-actions { flex-direction: column; align-items: stretch; }
            .host-actions .status-text { text-align: center; margin-left: 0; }
            .btn-primary, .btn-ai, .btn-secondary { justify-content: center; }
            .player-list { max-height: 180px; }
            .stats-row { gap: 0.6rem; }
            .header .status-group { gap: 6px; }
        }

        @@media (max-width: 480px) {
            .header .brand h1 { font-size: 0.8rem; }
            .header .brand .icon { font-size: 1.2rem; }
            .header .room-badge { font-size: 0.4rem; padding: 2px 8px; }
            .waiting-area .waiting-title { font-size: 1.1rem; }
            .waiting-area .big-icon { font-size: 2.5rem; }
            .progress-ring-container { width: 70px; height: 70px; }
            .progress-ring-container .center-text { font-size: 1.1rem; }
            .player-item { padding: 0.25rem 0.3rem; }
            .player-item .avatar { font-size: 0.7rem; width: 20px; }
            .player-item .info .name { font-size: 0.6rem; }
            .player-item .status { font-size: 0.35rem; padding: 1px 5px; }
            .btn-primary { font-size: 0.65rem; padding: 0.4rem 1rem; }
            .btn-ai { font-size: 0.6rem; padding: 0.35rem 0.8rem; }
            .btn-secondary { font-size: 0.6rem; padding: 0.35rem 0.8rem; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>
    <canvas id="particleCanvas2"></canvas>
    <div class="grid-overlay"></div>

    <!-- 光带 -->
    <div class="top-light-bar"></div>
    <div class="bottom-light-bar"></div>

    <!-- ============================================================
    ⭐ 全屏容器
    ============================================================ -->
    <div class="fullscreen-container" id="fullscreenContainer">

        <!-- 头部 -->
        <div class="header">
            <div class="brand">
                <span class="icon">🐺</span>
                <div>
                    <h1>狼人杀 · 等待大厅</h1>
                    <span class="sub">✦ 全息匹配中 ✦</span>
                </div>
            </div>
            <div class="status-group">
                <span class="room-badge">✦ 房间 <span id="roomDisplay">@roomId</span></span>
                <span class="user-badge">
                    <span class="avatar">@(username?.FirstOrDefault().ToString().ToUpper() ?? "A")</span>
                    <span>@username</span>
                </span>
                <span style="font-size:0.55rem;color:rgba(255,255,255,0.04);">
                    <span class="status-dot"></span> 在线
                </span>
            </div>
        </div>

        <!-- 主网格 -->
        <div class="main-grid">

            <!-- 左侧：等待主视觉 -->
            <div class="holo-card waiting-area">
                <div class="card-title">
                    📡 匹配状态
                    <span class="accent"></span>
                    <span class="badge" id="statusBadge" style="font-size:0.45rem;padding:0.1rem 0.5rem;border-radius:20px;background:rgba(139,92,246,0.04);color:rgba(255,255,255,0.1);border:1px solid rgba(139,92,246,0.02);">● 等待玩家</span>
                </div>

                <div class="big-icon" id="mainIcon">🐺</div>
                <div class="waiting-title" id="mainTitle">等待玩家加入...</div>
                <div class="waiting-sub" id="mainSub">✦ 分享房间码给好友 ✦</div>

                <!-- 进度环 -->
                <div class="progress-ring-container" id="progressRing">
                    <svg width="120" height="120" viewBox="0 0 120 120">
                        <defs>
                            <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#8B5CF6" />
                                <stop offset="50%" style="stop-color:#EC4899" />
                                <stop offset="100%" style="stop-color:#F59E0B" />
                            </linearGradient>
                        </defs>
                        <circle class="ring-bg" cx="60" cy="60" r="50" />
                        <circle class="ring-fg" id="progressRing" cx="60" cy="60" r="50" />
                    </svg>
                    <div class="center-text" id="progressText">0</div>
                    <div class="center-label">已准备</div>
                </div>

                <!-- 统计 -->
                <div class="stats-row">
                    <span class="stat-item">👥 总人数 <span class="num green" id="totalCount">0</span></span>
                    <span class="stat-item">✅ 已准备 <span class="num purple" id="readyCount">0</span></span>
                    <span class="stat-item">⏳ 等待 <span class="num gold" id="waitingCount">0</span></span>
                </div>
            </div>

            <!-- 右侧面板 -->
            <div class="side-panel" style="display:flex;flex-direction:column;gap:12px;height:100%;">

                <!-- 玩家列表 -->
                <div class="holo-card" style="flex:1;min-height:0;">
                    <div class="card-title">
                        👥 全息玩家列表
                        <span class="accent"></span>
                        <span class="badge" id="playerCountBadge" style="font-size:0.45rem;padding:0.1rem 0.5rem;border-radius:20px;background:rgba(139,92,246,0.04);color:rgba(255,255,255,0.1);border:1px solid rgba(139,92,246,0.02);">0 人</span>
                    </div>

                    <div class="player-list" id="playerList">
                        <div class="player-empty">✦ 等待玩家接入 ✦</div>
                    </div>
                </div>

                <!-- 控制栏 -->
                <div class="holo-card" style="flex-shrink:0;">
                    <div class="card-title">
                        🎮 控制中心
                        <span class="accent"></span>
                    </div>

                    <div class="host-actions">
                        <button class="btn-primary" id="startBtn" onclick="startGame()" disabled>
                            🚀 开始游戏
                        </button>

                        <!-- ⭐ AI陪玩按钮 -->
                        <button class="btn-ai" id="aiBtn" onclick="toggleAI()">
                            🤖 AI陪玩
                        </button>

                        <button class="btn-secondary" onclick="refreshRoom()">🔄 刷新</button>
                        <span class="status-text" id="actionStatus">● 等待玩家加入</span>
                    </div>

                    <!-- ⭐ AI语音识别指示器 -->
                    <div class="ai-voice-indicator" id="aiVoiceIndicator">
                        <span class="dot"></span>
                        AI 正在聆听...
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(80, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            var colors = ['rgba(139,92,246,', 'rgba(236,72,153,', 'rgba(245,158,11,', 'rgba(0,240,255,'];
            for (var i = 0; i < count; i++) {
                var color = colors[Math.floor(Math.random() * colors.length)];
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01,
                    color: color
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        (function initParticles2() {
            var canvas = document.getElementById('particleCanvas2');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(30, Math.floor(window.innerWidth / 16));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.03,
                    vy: (Math.random() - 0.5) * 0.03,
                    r: Math.random() * 2 + 1,
                    o: Math.random() * 0.04 + 0.005
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 全屏
        // ============================================================
        function requestFullscreen() {
            var el = document.documentElement;
            if (el.requestFullscreen) {
                el.requestFullscreen().catch(function() {});
            } else if (el.webkitRequestFullscreen) {
                el.webkitRequestFullscreen();
            } else if (el.msRequestFullscreen) {
                el.msRequestFullscreen();
            }
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // ⭐ AI陪玩系统
        // ============================================================
        var aiEnabled = false;
        var aiPlayerId = null;
        var aiName = '🤖 AI助手';
        var aiAvatar = '🤖';
        var aiComments = [
            '我觉得这局很精彩！', '大家加油！', '我已经准备好了！', '狼人别得意！',
            '好人的胜利就在眼前！', '我支持好人阵营！', '这局游戏太有意思了！', '大家配合得很好！',
            '我觉得预言家可以出来带队！', '女巫的药要省着用！', '守卫要保护好关键人物！',
            '猎人是好人的最后防线！', '白痴要保留技能！', '平民要积极参与投票！',
            '这局狼人很强！', '好人要团结一致！', '我预感这局会赢！', '我已经看穿了一切！'
        ];

        function toggleAI() {
            aiEnabled = !aiEnabled;
            var btn = document.getElementById('aiBtn');
            var indicator = document.getElementById('aiVoiceIndicator');

            if (aiEnabled) {
                btn.textContent = '✅ AI已开启';
                btn.classList.add('active');
                showToast('🤖 AI陪玩已开启，差人也能玩！', 'success');
                indicator.classList.add('active');
                addAIPlayer();
                startAIVoiceRecognition();
                startAICommentLoop();
            } else {
                btn.textContent = '🤖 AI陪玩';
                btn.classList.remove('active');
                showToast('🤖 AI陪玩已关闭', 'info');
                indicator.classList.remove('active');
                removeAIPlayer();
                stopAIVoiceRecognition();
                stopAICommentLoop();
            }
        }

        function addAIPlayer() {
            if (!connection || !state.roomId) {
                showToast('⚠️ 请先创建房间', 'warning');
                aiEnabled = false;
                var btn = document.getElementById('aiBtn');
                btn.textContent = '🤖 AI陪玩';
                btn.classList.remove('active');
                return;
            }

            connection.invoke('AddAI', state.roomId)
                .then(function(result) {
                    if (result && result.success) {
                        aiPlayerId = result.playerId;
                        showToast('🤖 ' + result.message, 'success');
                    } else {
                        showToast('❌ ' + (result?.message || '添加AI失败'), 'error');
                        aiEnabled = false;
                        var btn = document.getElementById('aiBtn');
                        btn.textContent = '🤖 AI陪玩';
                        btn.classList.remove('active');
                    }
                })
                .catch(function(err) {
                    showToast('❌ 添加AI失败: ' + err, 'error');
                    aiEnabled = false;
                    var btn = document.getElementById('aiBtn');
                    btn.textContent = '🤖 AI陪玩';
                    btn.classList.remove('active');
                });
        }

        function removeAIPlayer() {
            // AI玩家由服务端自动移除
        }

        // ============================================================
        // ⭐ AI语音识别
        // ============================================================
        var aiRecognition = null;
        var aiListening = false;

        function startAIVoiceRecognition() {
            try {
                var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (!SpeechRecognition) {
                    console.log('⚠️ 浏览器不支持语音识别');
                    return;
                }

                aiRecognition = new SpeechRecognition();
                aiRecognition.lang = 'zh-CN';
                aiRecognition.continuous = true;
                aiRecognition.interimResults = true;
                aiRecognition.maxAlternatives = 3;

                aiRecognition.onstart = function() { aiListening = true; console.log('🎤 AI语音识别已启动'); };
                aiRecognition.onresult = function(event) {
                    var finalText = '';
                    for (var i = event.resultIndex; i < event.results.length; i++) {
                        var result = event.results[i];
                        var text = result[0].transcript.trim();
                        if (result.isFinal) { finalText += text; }
                    }
                    if (finalText) {
                        console.log('🎤 AI听到:', finalText);
                        processAIInput(finalText);
                    }
                };
                aiRecognition.onerror = function(event) {
                    console.log('🎤 AI语音识别错误:', event.error);
                    if (event.error === 'not-allowed') {
                        showToast('⚠️ 请允许麦克风权限', 'warning');
                    }
                };
                aiRecognition.onend = function() {
                    if (aiEnabled && aiListening) {
                        setTimeout(function() { try { aiRecognition.start(); } catch(e) {} }, 500);
                    }
                };
                aiRecognition.start();
            } catch (e) { console.log('🎤 AI语音识别启动失败:', e); }
        }

        function stopAIVoiceRecognition() {
            aiListening = false;
            if (aiRecognition) { try { aiRecognition.stop(); } catch(e) {} }
        }

        // ============================================================
        // ⭐ AI输入处理（发送给DeepSeek AI）
        // ============================================================
        function processAIInput(text) {
            if (!aiEnabled || !aiPlayerId) return;
            if (!connection || connection.state !== signalR.HubConnectionState.Connected) return;

            // 过滤太短的消息
            if (text.length < 2) return;

            // 发送给服务器，由服务器调用DeepSeek
            connection.invoke('AISpeak', state.roomId, aiPlayerId, text)
                .catch(function(err) {
                    console.log('AI请求失败:', err);
                });
        }

        // ============================================================
        // ⭐ AI自动评论（备用，当AI没反应时）
        // ============================================================
        var aiCommentInterval = null;

        function startAICommentLoop() {
            aiCommentInterval = setInterval(function() {
                if (!aiEnabled || !connection || !state.roomId) return;
                // 只在AI没有发言时偶尔发一条
                if (Math.random() > 0.6) {
                    var comment = aiComments[Math.floor(Math.random() * aiComments.length)];
                    sendAIComment(comment);
                }
            }, 45000 + Math.random() * 20000);
        }

        function stopAICommentLoop() {
            if (aiCommentInterval) { clearInterval(aiCommentInterval);
                aiCommentInterval = null; }
        }

        function sendAIComment(comment) {
            if (!connection || !state.roomId || !aiPlayerId) return;
            connection.invoke('AISpeak', state.roomId, aiPlayerId, comment)
                .catch(function(err) { console.log('AI发言失败:', err); });
            showToast('🤖 AI: ' + comment, 'info');
        }

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            playerId: null,
            players: [],
            isReady: false,
            isGameStarted: false,
            isHost: true,
            maxPlayers: 12,
            minPlayers: 2,
            seatNumber: 0
        };

        var connection = null;

        // ============================================================
        // SignalR
        // ============================================================
        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('JoinedGame', function(data) {
                    if (data && data.success) {
                        state.playerId = data.playerId;
                        state.seatNumber = data.seatNumber || 0;
                        state.isHost = state.seatNumber === 0 || data.isHost === true;
                        showToast('✅ 已加入房间，你是 ' + (state.isHost ? '房主' : state.seatNumber + ' 号'), 'success');
                        updateButtons();
                        setTimeout(requestFullscreen, 500);
                    } else if (data && !data.success) {
                        showToast('❌ ' + data.message, 'error');
                    }
                });

                connection.on('PlayerListUpdate', function(players) {
                    state.players = players || [];
                    updateUI();
                });

                connection.on('AICreated', function(data) {
                    if (data && data.success) { aiPlayerId = data.playerId;
                        showToast('🤖 ' + data.message, 'success'); }
                });

                connection.on('AISpeak', function(playerId, nickname, comment) {
                    showToast('🤖 ' + nickname + ': ' + comment, 'info');
                });

                connection.on('PhaseUpdate', function(phase, day, night) {
                    if (phase === 'dealing' || phase === 'revealing') {
                        state.isGameStarted = true;
                        document.getElementById('statusBadge').textContent = '● 发牌中...';
                        document.getElementById('mainTitle').textContent = '🃏 正在发牌...';
                        document.getElementById('mainSub').textContent = '✦ 请查看你的身份 ✦';
                        document.getElementById('mainIcon').textContent = '🃏';
                        document.getElementById('startBtn').disabled = true;
                        document.getElementById('actionStatus').textContent = '● 游戏已开始';
                        setTimeout(function() {
                            window.location.href = '/Werewolf/Player?roomId=' + state.roomId;
                        }, 2000);
                    }
                });

                connection.on('DisplayMessage', function(message) { showToast('📢 ' + message, 'info'); });
                connection.on('VoiceAnnounce', function(message, type) {
                    showToast('🔊 ' + message, type === 'important' ? 'success' : 'info');
                    speak(message, type === 'important');
                });
                connection.on('GameOver', function(winner) {
                    showToast('🏆 游戏结束！' + (winner === '好人' ? '⭐ 好人胜利！' : '🐺 狼人胜利！'), 'success');
                });
                connection.on('DisbandTimerUpdate', function(data) {
                    if (data) {
                        document.getElementById('actionStatus').textContent = '⏱ 倒计时：' + data.display;
                        document.getElementById('actionStatus').style.color = '#F59E0B';
                    } else {
                        document.getElementById('actionStatus').textContent = '● 所有玩家在线';
                        document.getElementById('actionStatus').style.color = '';
                    }
                });
                connection.on('RoomDisbanded', function(message) {
                    showToast('🏁 ' + message, 'warning');
                    setTimeout(function() { window.location.href = '/Game'; }, 2000);
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        joinRoom(0);

                        // 心跳
                        setInterval(function() {
                            if (connection && connection.state === signalR.HubConnectionState.Connected && state
                                .playerId) {
                                connection.invoke('Heartbeat', state.playerId).catch(function() {});
                            }
                        }, 10000);
                    })
                    .catch(function(err) {
                        console.error('❌ 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
                showToast('⚠️ 连接失败，请刷新重试', 'error');
            }
        }

        // ============================================================
        // ⭐ 加入房间（带重试机制）
        // ============================================================
        function joinRoom(retryCount) {
            retryCount = retryCount || 0;
            var maxRetries = 15;

            if (!state.roomId || state.roomId === '') {
                showToast('⚠️ 房间号无效', 'error');
                return;
            }

            var nickname = '@username' || '管理员';
            var avatar = '👑';

            console.log('📡 尝试加入房间 (第 ' + (retryCount + 1) + ' 次):', state.roomId);

            connection.invoke('JoinGame', state.roomId, nickname, avatar, true)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.isHost = true;
                        state.seatNumber = 0;
                        document.getElementById('actionStatus').textContent = '● 你是房主，等待玩家准备';
                        showToast('✅ 已加入房间，你是房主', 'success');
                        updateButtons();
                        setTimeout(requestFullscreen, 500);

                        if (aiEnabled && !aiPlayerId) {
                            setTimeout(function() { addAIPlayer(); }, 1000);
                        }
                    } else if (result && !result.success) {
                        if (result.message && result.message.includes('房间不存在') && retryCount < maxRetries) {
                            console.log('⏳ 房间尚未创建，等待重试... (' + (retryCount + 1) + '/' + maxRetries + ')');
                            document.getElementById('actionStatus').textContent = '⏳ 等待房间创建... (' + (retryCount + 1) +
                                '/' + maxRetries + ')';
                            setTimeout(function() {
                                joinRoom(retryCount + 1);
                            }, 1000 + retryCount * 300);
                        } else {
                            showToast('❌ ' + result.message, 'error');
                            document.getElementById('actionStatus').textContent = '❌ 加入失败: ' + result.message;
                        }
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    if (retryCount < maxRetries) {
                        console.log('⏳ 连接失败，等待重试... (' + (retryCount + 1) + '/' + maxRetries + ')');
                        document.getElementById('actionStatus').textContent = '⏳ 连接失败，重试中... (' + (retryCount + 1) +
                            '/' + maxRetries + ')';
                        setTimeout(function() {
                            joinRoom(retryCount + 1);
                        }, 1000 + retryCount * 300);
                    } else {
                        showToast('❌ 加入失败: ' + err, 'error');
                        document.getElementById('actionStatus').textContent = '❌ 加入失败，请刷新重试';
                    }
                });
        }

        // ============================================================
        // ⭐ 语音播报
        // ============================================================
        function speak(text, isImportant) {
            try {
                if (!window.speechSynthesis) return;
                window.speechSynthesis.cancel();
                var utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'zh-CN';
                utterance.rate = isImportant ? 0.85 : 0.9;
                utterance.pitch = isImportant ? 0.9 : 1.0;
                utterance.volume = 1;
                var voices = window.speechSynthesis.getVoices();
                var zhVoice = voices.find(function(v) { return v.lang && v.lang.startsWith('zh'); });
                if (zhVoice) utterance.voice = zhVoice;
                window.speechSynthesis.speak(utterance);
            } catch(e) {}
        }

        // 预加载语音
        document.addEventListener('DOMContentLoaded', function() {
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = function() {
                    window.speechSynthesis.getVoices();
                };
            }
            setTimeout(requestFullscreen, 1000);
        });

        // ============================================================
        // 更新UI
        // ============================================================
        function updateUI() {
            var players = state.players || [];
            var total = players.filter(function(p) { return !p.isSpectator; }).length;
            var ready = players.filter(function(p) { return p.isReady && !p.isSpectator; }).length;
            var waiting = total - ready;

            document.getElementById('totalCount').textContent = total;
            document.getElementById('readyCount').textContent = ready;
            document.getElementById('waitingCount').textContent = waiting;
            document.getElementById('playerCountBadge').textContent = total + ' 人';

            var circumference = 314.16;
            var progress = total > 0 ? (ready / total) : 0;
            var offset = circumference - (progress * circumference);
            document.getElementById('progressRing').style.strokeDashoffset = offset;
            document.getElementById('progressText').textContent = ready;

            var statusBadge = document.getElementById('statusBadge');
            var mainTitle = document.getElementById('mainTitle');
            var mainSub = document.getElementById('mainSub');
            var mainIcon = document.getElementById('mainIcon');
            var actionStatus = document.getElementById('actionStatus');
            var startBtn = document.getElementById('startBtn');

            if (total === 0) {
                statusBadge.textContent = '● 等待玩家';
                mainTitle.textContent = '等待玩家加入...';
                mainSub.textContent = '✦ 分享房间码给好友 ✦';
                mainIcon.textContent = '🐺';
                actionStatus.textContent = '● 等待玩家加入';
                startBtn.disabled = true;
            } else if (total < state.minPlayers) {
                statusBadge.textContent = '● 需要更多玩家';
                mainTitle.textContent = '需要至少 ' + state.minPlayers + ' 位玩家';
                mainSub.textContent = '⏳ 当前 ' + total + ' 人，还需 ' + (state.minPlayers - total) + ' 人';
                mainIcon.textContent = '⏳';
                actionStatus.textContent = '● 需要 ' + (state.minPlayers - total) + ' 位玩家';
                startBtn.disabled = true;
            } else if (ready === total && total >= state.minPlayers) {
                statusBadge.textContent = '● 准备就绪';
                mainTitle.textContent = '🎉 所有玩家已准备！';
                mainSub.textContent = '✦ 点击"开始游戏" ✦';
                mainIcon.textContent = '🎉';
                actionStatus.textContent = '● 准备就绪，可以开始';
                if (state.isHost) { startBtn.disabled = false; }
            } else {
                statusBadge.textContent = '● 等待准备';
                mainTitle.textContent = '等待 ' + waiting + ' 位玩家准备...';
                mainSub.textContent = '✅ ' + ready + '/' + total + ' 已准备';
                mainIcon.textContent = '⏳';
                actionStatus.textContent = '● 等待 ' + waiting + ' 位玩家准备';
                startBtn.disabled = true;
            }

            updatePlayerList(players);
        }

        // ============================================================
        // 更新玩家列表
        // ============================================================
        function updatePlayerList(players) {
            var container = document.getElementById('playerList');

            if (!players || players.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var sorted = players.filter(function(p) { return !p.isSpectator; }).sort(function(a, b) {
                return (a.seatNumber || 99) - (b.seatNumber || 99);
            });

            if (sorted.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var html = '';
            sorted.forEach(function(p) {
                var isReady = p.isReady || false;
                var isSelf = p.playerId === state.playerId;
                var isHost = p.isHost || false;
                var isAI = p.isAI || false;
                var isAISelf = p.playerId === aiPlayerId;

                html += '<div class="player-item ' + (isAI ? 'ai-player' : '') + '">';
                html += '<span class="avatar">' + (p.avatarEmoji || '🧑') + '</span>';
                html += '<div class="info">';
                html += '<span class="name">' + p.nickname;
                if (isAI || isAISelf) { html += ' <span class="ai-tag">🤖 AI</span>'; }
                if (isSelf) { html += ' <span class="me">(你)</span>'; }
                html += '</span></div>';
                var statusClass = isHost ? 'host' : (isAI ? 'ai' : (isReady ? 'ready' : 'waiting'));
                var statusText = isHost ? '👑 房主' : (isAI ? '🤖 AI' : (isReady ? '✅ 已准备' : '⏳ 等待'));
                html += '<span class="status ' + statusClass + '">' + statusText + '</span>';
                html += '</div>';
            });

            container.innerHTML = html;
        }

        // ============================================================
        // 更新按钮
        // ============================================================
        function updateButtons() {
            var startBtn = document.getElementById('startBtn');
            if (state.isHost) {
                startBtn.style.display = 'flex';
            } else {
                startBtn.style.display = 'none';
            }
        }

        // ============================================================
        // ⭐ 开始游戏（房主点击后通知所有玩家跳转）
        // ============================================================
        function startGame() {
            if (!connection || !state.roomId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }

            if (!state.isHost) {
                showToast('⚠️ 只有房主可以开始游戏', 'warning');
                return;
            }

            var btn = document.getElementById('startBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 跳转中...';

            // ⭐ 通知所有玩家跳转到座位图
            connection.invoke('StartGameRedirect', state.roomId)
                .then(function() {
                    // 房主自己也跳转
                    window.location.href = '/Werewolf/Host?roomId=' + state.roomId;
                })
                .catch(function(err) {
                    showToast('❌ 开始失败: ' + err, 'error');
                    btn.disabled = false;
                    btn.textContent = '🚀 开始游戏';
                });
        }

        // ============================================================
        // ⭐ 监听跳转指令
        // ============================================================
        connection.on('RedirectToSeat', function(roomId) {
            showToast('🚀 游戏即将开始，跳转中...', 'success');
            setTimeout(function() {
                window.location.href = '/Werewolf/Host?roomId=' + roomId;
            }, 1000);
        });

        // ============================================================
        // 刷新
        // ============================================================
        function refreshRoom() {
            showToast('🔄 刷新中...', 'info');
            if (connection && state.roomId) {
                connection.invoke('JoinGame', state.roomId, '@username', '👑', true)
                    .catch(function() {});
            }
        }

        // ============================================================
        // 启动
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀等待大厅启动...');
            connectSignalR();
        });
    </script>

</body>
</html>
