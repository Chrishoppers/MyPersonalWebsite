@{
    Layout = null;
    ViewData["Title"] = "📜 狼人杀 · 规则";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
    var playerCount = ViewBag.PlayerCount as int? ?? 0;
    var selectedRoles = ViewBag.SelectedRoles as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>📜 狼人杀 · 规则</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .rules-container {
            position: relative;
            z-index: 1;
            max-width: 520px;
            width: 100%;
            animation: containerIn 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @@keyframes containerIn { from { opacity: 0; transform: scale(0.92) translateY(30px); } to { opacity: 1; transform: scale(1) translateY(0); } }

        .holo-card {
            background: rgba(8,8,28,0.85);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0,240,255,0.08);
            border-radius: 28px;
            padding: 20px 18px 18px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0,240,255,0.02);
            max-height: 94vh;
            display: flex;
            flex-direction: column;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0,240,255,0.02), transparent 60%);
            pointer-events: none;
        }

        .holo-card .border-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0,240,255,0.15), rgba(123,97,255,0.15), transparent);
            animation: borderGlow 3s ease-in-out infinite;
        }

        @@keyframes borderGlow { 0%, 100% { opacity: 0.3; transform: scaleX(1); } 50% { opacity: 1; transform: scaleX(1.2); } }

        .holo-card .corner {
            position: absolute;
            width: 14px;
            height: 14px;
            border-color: rgba(0,240,255,0.06);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }
        .holo-card .corner.tl { top: 8px; left: 8px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 8px; right: 8px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 8px; left: 8px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        .rules-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

        .rules-header .left { display: flex; align-items: center; gap: 10px; }
        .rules-header .icon { font-size: 1.6rem; }
        .rules-header h2 { font-size: 1.1rem; font-weight: 700; background: linear-gradient(135deg, #00F0FF, #7B61FF); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .rules-header .page-counter { font-size: 0.65rem; color: rgba(255,255,255,0.06); font-weight: 600; font-family: 'Courier New', monospace; }

        .rules-content {
            flex: 1;
            overflow-y: auto;
            padding: 12px 0 10px;
            min-height: 300px;
            max-height: 420px;
        }

        .rules-content::-webkit-scrollbar { width: 3px; }
        .rules-content::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .rules-content::-webkit-scrollbar-thumb { background: rgba(0,240,255,0.08); border-radius: 10px; }

        .rule-page { display: none; animation: pageIn 0.5s cubic-bezier(0.23, 1, 0.32, 1); }
        .rule-page.active { display: block; }

        @@keyframes pageIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }

        .rule-page .page-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
        .rule-page .page-title .icon { font-size: 1.2rem; }

        .rule-page .rule-item {
            padding: 4px 0 4px 14px;
            border-left: 2px solid rgba(0,240,255,0.04);
            margin-bottom: 3px;
            font-size: 0.78rem;
            color: rgba(255,255,255,0.4);
            line-height: 1.7;
            transition: all 0.3s ease;
        }

        .rule-page .rule-item:hover { border-left-color: rgba(0,240,255,0.1); color: rgba(255,255,255,0.5); }

        .rule-page .rule-item .highlight { color: #00F0FF; font-weight: 600; }
        .rule-page .rule-item .highlight-gold { color: #F59E0B; font-weight: 600; }
        .rule-page .rule-item .highlight-pink { color: #EC4899; font-weight: 600; }
        .rule-page .rule-item .highlight-green { color: #00FF88; font-weight: 600; }
        .rule-page .rule-item .indent { padding-left: 18px; display: block; color: rgba(255,255,255,0.15); font-size: 0.7rem; }

        .rule-page .additional-info {
            margin-top: 8px;
            padding: 6px 12px;
            border-radius: 10px;
            background: rgba(0,240,255,0.02);
            border: 1px solid rgba(0,240,255,0.03);
            font-size: 0.65rem;
            color: rgba(255,255,255,0.1);
        }

        .rules-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 10px;
            border-top: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 6px;
        }

        .btn-nav {
            padding: 6px 16px;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.15);
            font-weight: 500;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-nav:hover:not(:disabled) { background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.06); }
        .btn-nav:disabled { opacity: 0.15; cursor: not-allowed; }

        .btn-nav.primary { background: linear-gradient(135deg, #00F0FF, #7B61FF); border: none; color: #fff; }
        .btn-nav.primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(0,240,255,0.05); }

        .progress-dots { display: flex; gap: 5px; align-items: center; }

        .progress-dots .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            transition: all 0.4s ease;
            cursor: pointer;
        }

        .progress-dots .dot.active { background: #00F0FF; box-shadow: 0 0 20px rgba(0,240,255,0.05); width: 18px; border-radius: 8px; }
        .progress-dots .dot.done { background: rgba(0,240,255,0.1); }

        .rules-confirm { margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.04); text-align: center; flex-shrink: 0; }

        .btn-confirm {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            letter-spacing: 0.04em;
            display: none;
        }

        .btn-confirm.show { display: block; }

        .btn-confirm:hover { transform: translateY(-2px) scale(1.01); box-shadow: 0 8px 60px rgba(0,255,136,0.08); }

        .btn-confirm .sub { display: block; font-size: 0.55rem; font-weight: 400; opacity: 0.4; margin-top: 2px; }

        .toast-container {
            position: fixed;
            bottom: 16px;
            right: 16px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
            max-width: 90%;
        }

        .toast-msg {
            padding: 6px 16px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
            max-width: 100%;
            word-break: break-word;
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        @@media (max-width: 480px) {
            .holo-card { padding: 14px 12px 14px; border-radius: 24px; }
            .holo-card .corner { width: 10px; height: 10px; }
            .rules-header h2 { font-size: 0.95rem; }
            .rules-content { min-height: 240px; max-height: 320px; }
            .rule-page .rule-item { font-size: 0.7rem; padding: 3px 0 3px 10px; }
            .rule-page .page-title { font-size: 0.85rem; }
            .btn-nav { padding: 4px 12px; font-size: 0.6rem; }
            .btn-confirm { padding: 10px; font-size: 0.8rem; }
        }
    </style>
</head>
<body>

    <canvas id="particleCanvas"></canvas>

    <div class="rules-container">
        <div class="holo-card">
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <div class="rules-header">
                <div class="left"><span class="icon">📜</span><h2>游戏规则</h2></div>
                <div class="page-counter"><span id="currentPageDisplay">1</span>/<span id="totalPages">6</span></div>
            </div>

            <div class="rules-content" id="rulesContent">
                <!-- 第1页 -->
                <div class="rule-page active" data-page="0">
                    <div class="page-title"><span class="icon">🏆</span> 胜利条件</div>
                    <div class="rule-item"><span class="highlight-green">⭐ 好人阵营胜利：</span>所有狼人出局</div>
                    <div class="rule-item"><span class="highlight-pink">🐺 狼人阵营胜利（屠边）：</span>所有神职出局 或 所有平民出局</div>
                    <div class="rule-item"><span class="highlight">📊 当前配置：</span>@playerCount 人局</div>
                    <div class="additional-info">⚡ 特殊板子可能存在额外胜利条件（如人狼情侣屠城）</div>
                </div>

                <!-- 第2页 -->
                <div class="rule-page" data-page="1">
                    <div class="page-title"><span class="icon">👥</span> 阵营与角色</div>
                    <div class="rule-item"><span class="highlight-green">🌟 好人阵营（神职 + 平民）</span></div>
                    <div class="rule-item"><span class="indent">胜利条件：所有狼人出局</span></div>
                    <div class="rule-item"><span class="highlight-pink">🐺 狼人阵营</span></div>
                    <div class="rule-item"><span class="indent">胜利条件：屠边（杀光所有神职或所有平民）</span></div>
                    <div class="rule-item"><span class="highlight">💡 神职包括：</span>预言家、女巫、守卫、猎人等</div>
                    <div class="rule-item"><span class="highlight">💡 平民</span>无特殊技能</div>
                    <div class="additional-info">📱 本局角色：@string.Join("、", selectedRoles)</div>
                </div>

                <!-- 第3页 -->
                <div class="rule-page" data-page="2">
                    <div class="page-title"><span class="icon">🌙</span> 昼夜流程</div>
                    <div class="rule-item"><span class="highlight">🌙 夜晚阶段</span></div>
                    <div class="rule-item"><span class="indent">1. 守卫 → 守护一名玩家</span></div>
                    <div class="rule-item"><span class="indent">2. 预言家 → 查验一名玩家</span></div>
                    <div class="rule-item"><span class="indent">3. 狼人 → 统一意见杀害一名玩家</span></div>
                    <div class="rule-item"><span class="indent">4. 女巫 → 解药救人 / 毒药杀人</span></div>
                    <div class="rule-item"><span class="indent">5. 天亮</span></div>
                    <div class="rule-item" style="margin-top:4px;"><span class="highlight-gold">☀️ 白天阶段</span></div>
                    <div class="rule-item"><span class="indent">1. 公布死讯</span></div>
                    <div class="rule-item"><span class="indent">2. 发言阶段</span></div>
                    <div class="rule-item"><span class="indent">3. 投票阶段</span></div>
                    <div class="rule-item"><span class="indent">4. 公布放逐结果</span></div>
                    <div class="rule-item"><span class="indent">5. 天黑</span></div>
                    <div class="additional-info">💡 首夜女巫可自救 ｜ 守卫第一天可守护自己</div>
                </div>

                <!-- 第4页 -->
                <div class="rule-page" data-page="3">
                    <div class="page-title"><span class="icon">📢</span> 发言与投票</div>
                    <div class="rule-item"><span class="highlight">📢 发言规则</span></div>
                    <div class="rule-item"><span class="indent">• 每人发言时间：60秒</span></div>
                    <div class="rule-item"><span class="indent">• 从死者左手边开始顺序发言</span></div>
                    <div class="rule-item"><span class="indent">• 10人以上开启警长竞选</span></div>
                    <div class="rule-item"><span class="indent">• 警长拥有归票权，投票算1.5票</span></div>
                    <div class="rule-item" style="margin-top:4px;"><span class="highlight-gold">🗳️ 投票规则</span></div>
                    <div class="rule-item"><span class="indent">• 每人一票</span></div>
                    <div class="rule-item"><span class="indent">• 平票则PK发言</span></div>
                    <div class="rule-item"><span class="indent">• PK后再平票则平安日</span></div>
                    <div class="rule-item"><span class="highlight-pink">💀 遗言规则</span></div>
                    <div class="rule-item"><span class="indent">• 第一天死亡有遗言</span></div>
                    <div class="rule-item"><span class="indent">• 之后死亡无遗言</span></div>
                </div>

                <!-- 第5页 -->
                <div class="rule-page" data-page="4">
                    <div class="page-title"><span class="icon">🃏</span> 角色技能速查</div>
                    <div class="rule-item"><span class="highlight-pink">🐺 狼人：</span>每晚共同杀害一名玩家</div>
                    <div class="rule-item"><span class="highlight">🔮 预言家：</span>每晚查验一名玩家身份</div>
                    <div class="rule-item"><span class="highlight">🧪 女巫：</span>解药救人，毒药杀人</div>
                    <div class="rule-item"><span class="highlight">🛡️ 守卫：</span>每晚守护一人免遭袭击</div>
                    <div class="rule-item"><span class="highlight-gold">🔫 猎人：</span>死亡时开枪带走一人</div>
                    <div class="rule-item"><span class="highlight-gold">🤡 白痴：</span>被放逐时翻牌免死一次</div>
                    <div class="rule-item"><span class="highlight-gold">⚔️ 骑士：</span>白天挑战一名玩家</div>
                    <div class="rule-item"><span class="highlight-green">👤 平民：</span>无特殊技能</div>
                    <div class="additional-info">📱 点击角色名称查看详细技能说明</div>
                </div>

                <!-- 第6页 -->
                <div class="rule-page" data-page="5">
                    <div class="page-title"><span class="icon">⚡</span> 特殊规则</div>
                    <div class="rule-item"><span class="highlight-pink">🛡️ 同守同救（奶穿）</span></div>
                    <div class="rule-item"><span class="indent">同一晚被守护 + 女巫解救 = 死亡</span></div>
                    <div class="rule-item" style="margin-top:4px;"><span class="highlight-gold">🔫 猎人</span></div>
                    <div class="rule-item"><span class="indent">死亡时可开枪带走一人</span></div>
                    <div class="rule-item"><span class="indent">被女巫毒杀不能开枪</span></div>
                    <div class="rule-item" style="margin-top:4px;"><span class="highlight">🤡 白痴</span></div>
                    <div class="rule-item"><span class="indent">被投票放逐时可翻牌免死一次</span></div>
                    <div class="rule-item"><span class="indent">翻牌后失去投票权，但仍可发言</span></div>
                    <div class="rule-item" style="margin-top:4px;"><span class="highlight-pink">🐺 狼人自爆</span></div>
                    <div class="rule-item"><span class="indent">白天可自爆，立即进入黑夜</span></div>
                    <div class="rule-item"><span class="indent">警长竞选阶段自爆会"吞警徽"</span></div>
                    <div class="additional-info">📖 详细规则可在游戏中查看</div>
                </div>
            </div>

            <div class="rules-footer">
                <button class="btn-nav" id="prevBtn" onclick="changePage(-1)" disabled>← 上一页</button>
                <div class="progress-dots" id="progressDots">
                    <span class="dot active" data-page="0" onclick="goToPage(0)"></span>
                    <span class="dot" data-page="1" onclick="goToPage(1)"></span>
                    <span class="dot" data-page="2" onclick="goToPage(2)"></span>
                    <span class="dot" data-page="3" onclick="goToPage(3)"></span>
                    <span class="dot" data-page="4" onclick="goToPage(4)"></span>
                    <span class="dot" data-page="5" onclick="goToPage(5)"></span>
                </div>
                <button class="btn-nav" id="nextBtn" onclick="changePage(1)">下一页 →</button>
            </div>

            <div class="rules-confirm">
                <button class="btn-confirm" id="confirmBtn" onclick="confirmRules()">
                    ✅ 我已阅读并确认
                    <span class="sub">确认后游戏将正式开始</span>
                </button>
            </div>

        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        // 粒子背景
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(50, Math.floor(window.innerWidth / 10));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.1,
                    vy: (Math.random() - 0.5) * 0.1,
                    r: Math.random() * 1 + 0.3,
                    o: Math.random() * 0.1 + 0.02
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        var currentPage = 0;
        var totalPages = 6;

        function changePage(delta) {
            var newPage = currentPage + delta;
            if (newPage < 0 || newPage >= totalPages) return;
            goToPage(newPage);
        }

        function goToPage(index) {
            if (index < 0 || index >= totalPages) return;

            document.querySelectorAll('.rule-page').forEach(function(el) { el.classList.remove('active'); });
            document.querySelector('.rule-page[data-page="' + index + '"]').classList.add('active');

            document.getElementById('currentPageDisplay').textContent = index + 1;

            document.querySelectorAll('.progress-dots .dot').forEach(function(el, i) {
                el.classList.remove('active', 'done');
                if (i === index) el.classList.add('active');
                else if (i < index) el.classList.add('done');
            });

            document.getElementById('prevBtn').disabled = index === 0;
            document.getElementById('nextBtn').disabled = index === totalPages - 1;

            var confirmBtn = document.getElementById('confirmBtn');
            if (index === totalPages - 1) { confirmBtn.classList.add('show'); } else { confirmBtn.classList.remove(
                'show'); }

            currentPage = index;
        }

        function confirmRules() {
            var btn = document.getElementById('confirmBtn');
            btn.textContent = '✅ 已确认，游戏即将开始...';
            btn.disabled = true;
            btn.style.opacity = '0.6';

            if (window.parent && window.parent.postMessage) {
                window.parent.postMessage({ type: 'rulesConfirmed' }, '*');
            }

            setTimeout(function() { window.close(); }, 2000);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') changePage(-1);
            if (e.key === 'ArrowRight') changePage(1);
            if (e.key === 'Enter') {
                var confirmBtn = document.getElementById('confirmBtn');
                if (confirmBtn.classList.contains('show')) confirmRules();
            }
        });

        var touchStartX = 0;
        document.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; });
        document.addEventListener('touchend', function(e) {
            var diff = touchStartX - e.changedTouches[0].clientX;
            if (Math.abs(diff) > 40) {
                if (diff > 0) changePage(1);
                else changePage(-1);
            }
        });

        document.addEventListener('DOMContentLoaded', function() { goToPage(0); });
    </script>

</body>
</html>
