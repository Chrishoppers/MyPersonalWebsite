@{
    Layout = null;
    var playerCount = ViewBag.PlayerCount ?? 12;
    var selectedRoles = ViewBag.SelectedRoles as List<string> ?? new List<string> { "预言家", "女巫", "守卫", "猎人", "狼人", "狼人", "狼人", "狼人", "平民", "平民", "平民", "平民" };
    var rulePages = MyPersonalWebsite.Utilities.WerewolfRules.GetRulePages(playerCount, selectedRoles);
    var roleDetails = MyPersonalWebsite.Utilities.WerewolfRules.GetRoleDetails();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>📜 狼人杀 · 游戏规则</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            overflow: hidden;
        }

        /* ============================================================
           粒子背景
           ============================================================ */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* ============================================================
           主容器
           ============================================================ */
        .rules-container {
            position: relative;
            z-index: 1;
            max-width: 520px;
            width: 100%;
            animation: containerIn 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @@keyframes containerIn {
            from { opacity: 0; transform: scale(0.92) translateY(30px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        /* ============================================================
           全息卡片
           ============================================================ */
        .holo-card {
            background: rgba(8, 8, 28, 0.85);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0, 240, 255, 0.08);
            border-radius: 32px;
            padding: 24px 20px 20px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0, 240, 255, 0.02);
            max-height: 94vh;
            display: flex;
            flex-direction: column;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0, 240, 255, 0.02), transparent 60%);
            pointer-events: none;
        }

        .holo-card .border-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.15), rgba(123, 97, 255, 0.15), transparent);
            animation: borderGlow 3s ease-in-out infinite;
        }

        @@keyframes borderGlow {
            0%, 100% { opacity: 0.3; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.2); }
        }

        .holo-card .corner {
            position: absolute;
            width: 16px;
            height: 16px;
            border-color: rgba(0, 240, 255, 0.06);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }
        .holo-card .corner.tl { top: 10px; left: 10px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 10px; right: 10px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 10px; left: 10px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 10px; right: 10px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        /* ============================================================
           头部
           ============================================================ */
        .rules-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

        .rules-header .left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .rules-header .icon {
            font-size: 1.6rem;
        }

        .rules-header h2 {
            font-size: 1.1rem;
            font-weight: 700;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .rules-header .page-counter {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.08);
            font-weight: 600;
            font-family: 'Courier New', monospace;
        }

        .rules-header .page-counter .current { color: rgba(255,255,255,0.3); }

        /* ============================================================
           内容
           ============================================================ */
        .rules-content {
            flex: 1;
            overflow-y: auto;
            padding: 16px 0 12px;
            min-height: 300px;
            max-height: 420px;
        }

        .rules-content::-webkit-scrollbar { width: 3px; }
        .rules-content::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .rules-content::-webkit-scrollbar-thumb { background: rgba(0, 240, 255, 0.08); border-radius: 10px; }

        /* ===== 规则页面 ===== */
        .rule-page {
            display: none;
            animation: pageIn 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .rule-page.active { display: block; }

        @@keyframes pageIn {
            from { opacity: 0; transform: translateX(30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .rule-page .page-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .rule-page .page-title .icon { font-size: 1.3rem; }

        .rule-page .rule-item {
            padding: 6px 0 6px 16px;
            border-left: 2px solid rgba(0, 240, 255, 0.06);
            margin-bottom: 4px;
            font-size: 0.82rem;
            color: rgba(255,255,255,0.5);
            line-height: 1.7;
            transition: all 0.3s ease;
        }

        .rule-page .rule-item:hover {
            border-left-color: rgba(0, 240, 255, 0.12);
            color: rgba(255,255,255,0.6);
        }

        .rule-page .rule-item .highlight {
            color: #00F0FF;
            font-weight: 600;
        }

        .rule-page .rule-item .highlight-gold {
            color: #F59E0B;
            font-weight: 600;
        }

        .rule-page .rule-item .highlight-pink {
            color: #EC4899;
            font-weight: 600;
        }

        .rule-page .rule-item .highlight-green {
            color: #00FF88;
            font-weight: 600;
        }

        .rule-page .rule-item .indent {
            padding-left: 20px;
            display: block;
            color: rgba(255,255,255,0.2);
            font-size: 0.75rem;
        }

        .rule-page .rule-item .citation {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.06);
            margin-left: 4px;
        }

        .rule-page .additional-info {
            margin-top: 10px;
            padding: 8px 14px;
            border-radius: 12px;
            background: rgba(0, 240, 255, 0.02);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255,0.12);
        }

        /* ===== 角色卡片 ===== */
        .role-card {
            display: inline-block;
            padding: 4px 12px 4px 8px;
            border-radius: 20px;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            font-size: 0.75rem;
            color: rgba(255,255,255,0.4);
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 2px 4px 2px 0;
        }

        .role-card:hover {
            background: rgba(0, 240, 255, 0.04);
            border-color: rgba(0, 240, 255, 0.08);
            color: #fff;
            transform: scale(1.05);
        }

        .role-card .emoji { margin-right: 2px; }

        /* ============================================================
           底部导航
           ============================================================ */
        .rules-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 8px;
        }

        .btn-nav {
            padding: 8px 18px;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            font-weight: 500;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-nav:hover:not(:disabled) {
            background: rgba(255,255,255,0.04);
            color: #fff;
            border-color: rgba(255,255,255,0.06);
        }

        .btn-nav:disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }

        .btn-nav.primary {
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            border: none;
            color: #fff;
        }

        .btn-nav.primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(0, 240, 255, 0.08);
        }

        /* ===== 进度点 ===== */
        .progress-dots {
            display: flex;
            gap: 6px;
            align-items: center;
        }

        .progress-dots .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            transition: all 0.4s ease;
            cursor: pointer;
        }

        .progress-dots .dot.active {
            background: #00F0FF;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1);
            width: 20px;
            border-radius: 10px;
        }

        .progress-dots .dot.done {
            background: rgba(0, 240, 255, 0.2);
        }

        /* ============================================================
           确认按钮
           ============================================================ */
        .rules-confirm {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid rgba(255,255,255,0.04);
            text-align: center;
            flex-shrink: 0;
        }

        .btn-confirm {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            letter-spacing: 0.04em;
            display: none;
        }

        .btn-confirm.show { display: block; }

        .btn-confirm:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 8px 60px rgba(0, 255, 136, 0.1);
        }

        .btn-confirm .sub {
            display: block;
            font-size: 0.6rem;
            font-weight: 400;
            opacity: 0.5;
            margin-top: 2px;
        }

        /* ============================================================
           角色详情弹窗
           ============================================================ */
        .role-detail-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.92);
            backdrop-filter: blur(30px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 24px;
            animation: overlayIn 0.4s ease;
        }

        .role-detail-overlay.active { display: flex; }

        @@keyframes overlayIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .role-detail-modal {
            background: rgba(20,20,40,0.98);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 28px;
            max-width: 420px;
            width: 100%;
            padding: 28px 24px 24px;
            animation: modalIn 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            max-height: 90vh;
            overflow-y: auto;
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.92) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .role-detail-modal .close-btn {
            float: right;
            background: none;
            border: none;
            color: rgba(255,255,255,0.08);
            font-size: 1.4rem;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .role-detail-modal .close-btn:hover { color: rgba(255,255,255,0.2); }

        .role-detail-modal .role-name {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .role-detail-modal .role-desc {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.3);
            margin-bottom: 12px;
        }

        .role-detail-modal .role-detail {
            font-size: 0.85rem;
            color: rgba(255,255,255,0.4);
            line-height: 1.8;
            white-space: pre-wrap;
            background: rgba(255,255,255,0.02);
            padding: 12px 16px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.02);
        }

        .role-detail-modal .role-tips {
            margin-top: 12px;
            padding: 10px 14px;
            border-radius: 14px;
            background: rgba(245, 158, 11, 0.04);
            border: 1px solid rgba(245, 158, 11, 0.04);
            font-size: 0.8rem;
            color: #F59E0B;
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 480px) {
            .holo-card { padding: 16px 14px 16px; border-radius: 24px; }
            .holo-card .corner { width: 10px; height: 10px; }
            .rules-header h2 { font-size: 0.95rem; }
            .rules-header .icon { font-size: 1.2rem; }
            .rules-content { min-height: 220px; max-height: 320px; }
            .rule-page .rule-item { font-size: 0.75rem; padding: 4px 0 4px 12px; }
            .rule-page .page-title { font-size: 0.95rem; }
            .btn-nav { padding: 6px 12px; font-size: 0.65rem; }
            .btn-confirm { padding: 12px; font-size: 0.9rem; }
            .role-detail-modal { padding: 20px 16px; }
            .role-detail-modal .role-name { font-size: 1.2rem; }
        }

        @@media (max-width: 380px) {
            .rules-content { min-height: 180px; max-height: 260px; }
            .rule-page .rule-item { font-size: 0.7rem; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>

    <!-- ============================================================
         主容器
         ============================================================ -->
    <div class="rules-container">
        <div class="holo-card">
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <!-- 头部 -->
            <div class="rules-header">
                <div class="left">
                    <span class="icon">📜</span>
                    <h2>游戏规则</h2>
                </div>
                <div class="page-counter">
                    <span class="current" id="currentPageDisplay">1</span>/<span id="totalPages">@rulePages.Count</span>
                </div>
            </div>

            <!-- 内容 -->
            <div class="rules-content" id="rulesContent">
                @for (int i = 0; i < rulePages.Count; i++)
                {
                    var page = rulePages[i];
                    <div class="rule-page @(i == 0 ? "active" : "")" data-page="@i">
                        <div class="page-title">
                            <span class="icon">@page.Icon</span>
                            @page.Title
                        </div>

                        @foreach (var item in page.Content)
                        {
                            if (string.IsNullOrEmpty(item))
                            {
                                <div style="height:4px;"></div>
                            }
                            else if (item.StartsWith("  •"))
                            {
                                <div class="rule-item" style="border-left-color: rgba(0, 240, 255, 0.03);">
                                    @Html.Raw(item.Replace("  •", "▸").Trim())
                                </div>
                            }
                            else if (item.StartsWith("  "))
                            {
                                <div class="rule-item" style="border-left-color: rgba(255,255,255,0.02); padding-left: 28px; font-size: 0.75rem; color: rgba(255,255,255,0.15);">
                                    @Html.Raw(item.Trim())
                                </div>
                            }
                            else if (item.Contains("："))
                            {
                                var parts = item.Split('：');
                                <div class="rule-item">
                                    <span style="color: rgba(255,255,255,0.6);">@parts[0]</span>：<span style="color: rgba(255,255,255,0.3);">@parts[1]</span>
                                </div>
                            }
                            else if (item.Contains("📱") || item.Contains("💡"))
                            {
                                <div class="rule-item" style="border-left-color: rgba(245, 158, 11, 0.06);">
                                    @Html.Raw(item)
                                </div>
                            }
                            else if (item.StartsWith("🃏"))
                            {
                                <div class="rule-item" style="border-left-color: rgba(139, 92, 246, 0.06); font-weight: 600; color: rgba(255,255,255,0.3);">
                                    @Html.Raw(item)
                                </div>
                            }
                            else if (item.Contains("角色名称"))
                            {
                                <div class="rule-item" style="border-left-color: rgba(139, 92, 246, 0.03); font-size: 0.7rem; color: rgba(255,255,255,0.08);">
                                    @Html.Raw(item)
                                </div>
                            }
                            else
                            {
                                <div class="rule-item">
                                    @Html.Raw(item)
                                </div>
                            }
                        }

                        @if (!string.IsNullOrEmpty(page.AdditionalInfo))
                        {
                            <div class="additional-info">
                                💡 @page.AdditionalInfo
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 底部导航 -->
            <div class="rules-footer">
                <button class="btn-nav" id="prevBtn" onclick="changePage(-1)" disabled>
                    ← 上一页
                </button>
                <div class="progress-dots" id="progressDots">
                    @for (int i = 0; i < rulePages.Count; i++)
                    {
                        <span class="dot @(i == 0 ? "active" : "")" data-page="@i" onclick="goToPage(@i)"></span>
                    }
                </div>
                <button class="btn-nav" id="nextBtn" onclick="changePage(1)">
                    下一页 →
                </button>
            </div>

            <!-- 确认按钮 -->
            <div class="rules-confirm">
                <button class="btn-confirm" id="confirmBtn" onclick="confirmRules()">
                    ✅ 我已阅读并确认
                    <span class="sub">确认后游戏将正式开始</span>
                </button>
            </div>

        </div>
    </div>

    <!-- ============================================================
         角色详情弹窗
         ============================================================ -->
    <div class="role-detail-overlay" id="roleDetailOverlay">
        <div class="role-detail-modal">
            <button class="close-btn" onclick="closeRoleDetail()">✕</button>
            <div class="role-name" id="detailName">角色名</div>
            <div class="role-desc" id="detailDesc">角色描述</div>
            <div class="role-detail" id="detailContent">详细技能</div>
            <div class="role-tips" id="detailTips">💡 提示</div>
        </div>
    </div>

    <!-- ============================================================
         Scripts
         ============================================================ -->
    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(60, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.12,
                    vy: (Math.random() - 0.5) * 0.12,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.12 + 0.02
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 分页控制
        // ============================================================
        var currentPage = 0;
        var totalPages = @rulePages.Count;

        function changePage(delta) {
            var newPage = currentPage + delta;
            if (newPage < 0 || newPage >= totalPages) return;
            goToPage(newPage);
        }

        function goToPage(index) {
            if (index < 0 || index >= totalPages) return;

            // 切换页面
            document.querySelectorAll('.rule-page').forEach(function(el) {
                el.classList.remove('active');
            });
            document.getElementById('rulesContent').querySelector('.rule-page[data-page="' + index + '"]').classList.add('active');

            // 更新页码
            document.getElementById('currentPageDisplay').textContent = index + 1;

            // 更新进度点
            document.querySelectorAll('.progress-dots .dot').forEach(function(el, i) {
                el.classList.remove('active', 'done');
                if (i === index) el.classList.add('active');
                else if (i < index) el.classList.add('done');
            });

            // 更新按钮
            document.getElementById('prevBtn').disabled = index === 0;
            document.getElementById('nextBtn').disabled = index === totalPages - 1;

            // 最后一页显示确认按钮
            var confirmBtn = document.getElementById('confirmBtn');
            if (index === totalPages - 1) {
                confirmBtn.classList.add('show');
            } else {
                confirmBtn.classList.remove('show');
            }

            currentPage = index;
        }

        // ============================================================
        // 角色详情
        // ============================================================
        var roleDetails = @Html.Raw(Json.Serialize(roleDetails));

        function showRoleDetail(roleName) {
            var detail = roleDetails[roleName];
            if (!detail) return;

            document.getElementById('detailName').textContent = detail.name;
            document.getElementById('detailDesc').textContent = detail.description;
            document.getElementById('detailContent').textContent = detail.detail.trim();
            document.getElementById('detailTips').textContent = detail.tips || '💡 善用你的技能帮助阵营获胜！';

            document.getElementById('roleDetailOverlay').classList.add('active');
        }

        function closeRoleDetail() {
            document.getElementById('roleDetailOverlay').classList.remove('active');
        }

        // 点击背景关闭
        document.getElementById('roleDetailOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeRoleDetail();
        });

        // ============================================================
        // 确认规则
        // ============================================================
        function confirmRules() {
            // 触发确认事件
            if (window.parent && window.parent.postMessage) {
                window.parent.postMessage({ type: 'rulesConfirmed' }, '*');
            }

            // 或者调用父窗口的函数
            if (window.opener && window.opener.onRulesConfirmed) {
                window.opener.onRulesConfirmed();
            }

            // 显示确认成功
            var btn = document.getElementById('confirmBtn');
            btn.textContent = '✅ 已确认，游戏即将开始...';
            btn.disabled = true;
            btn.style.opacity = '0.6';

            // 3秒后自动关闭
            setTimeout(function() {
                window.close();
            }, 3000);
        }

        // ============================================================
        // 键盘快捷键
        // ============================================================
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') changePage(-1);
            if (e.key === 'ArrowRight') changePage(1);
            if (e.key === 'Enter') {
                var confirmBtn = document.getElementById('confirmBtn');
                if (confirmBtn.classList.contains('show')) confirmRules();
            }
            if (e.key === 'Escape') closeRoleDetail();
        });

        // ============================================================
        // 触摸滑动
        // ============================================================
        var touchStartX = 0;
        document.addEventListener('touchstart', function(e) {
            touchStartX = e.touches[0].clientX;
        });

        document.addEventListener('touchend', function(e) {
            var diff = touchStartX - e.changedTouches[0].clientX;
            if (Math.abs(diff) > 50) {
                if (diff > 0) changePage(1);
                else changePage(-1);
            }
        });

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            goToPage(0);
        });
    </script>

</body>
</html>
