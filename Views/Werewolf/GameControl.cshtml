@{
    Layout = null;
    ViewData["Title"] = "🐺 游戏控制中心";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString() ?? "";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 游戏控制中心</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局重置
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
        }

        /* ===== 粒子背景 ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        #particleCanvas2 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.3;
        }

        /* ============================================================
           主容器 - 两种模式共用
           ============================================================ */
        .container {
            width: 100vw;
            height: 100vh;
            max-width: 100%;
            max-height: 100%;
            padding: 1.5vh 2vw;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 1;
        }

        /* ============================================================
           模式切换栏（游戏开始前显示）
           ============================================================ */
        .mode-selector {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 9999;
            background: rgba(8, 8, 28, 0.95);
            backdrop-filter: blur(60px);
            border: 1px solid rgba(0, 240, 255, 0.06);
            border-radius: 32px;
            padding: 3rem 3.5rem;
            max-width: 700px;
            width: 92%;
            text-align: center;
            animation: modalIn 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            box-shadow: 0 0 120px rgba(0, 240, 255, 0.02);
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: translate(-50%, -50%) scale(0.92) translateY(30px); }
            to { opacity: 1; transform: translate(-50%, -50%) scale(1) translateY(0); }
        }

        .mode-selector .title {
            font-size: 2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #00F0FF, #7B61FF, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.2rem;
        }

        .mode-selector .subtitle {
            color: rgba(255,255,255,0.12);
            font-size: 0.9rem;
            margin-bottom: 2rem;
            letter-spacing: 0.06em;
        }

        .mode-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.2rem;
        }

        .mode-option {
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 20px;
            padding: 1.8rem 1.2rem;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
        }

        .mode-option::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(135deg, #00F0FF, #7B61FF);
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .mode-option:hover {
            background: rgba(255,255,255,0.04);
            border-color: rgba(0, 240, 255, 0.06);
            transform: translateY(-4px) scale(1.01);
        }

        .mode-option:hover::before { opacity: 1; }

        .mode-option .mode-icon { font-size: 3.5rem; display: block; margin-bottom: 0.5rem; }
        .mode-option .mode-name { font-size: 1.2rem; font-weight: 700; color: #fff; }
        .mode-option .mode-desc {
            color: rgba(255,255,255,0.2);
            font-size: 0.8rem;
            margin-top: 0.2rem;
            line-height: 1.6;
        }
        .mode-option .mode-device {
            display: inline-block;
            margin-top: 0.5rem;
            padding: 0.1rem 0.8rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            color: rgba(0, 240, 255, 0.3);
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .mode-option.selected {
            border-color: #00F0FF;
            background: rgba(0, 240, 255, 0.04);
            box-shadow: 0 0 60px rgba(0, 240, 255, 0.02);
        }

        .mode-option.selected::before { opacity: 1; }

        .mode-option .check-mark {
            position: absolute;
            top: 0.8rem;
            right: 1rem;
            font-size: 0.8rem;
            color: #00F0FF;
            opacity: 0;
            transform: scale(0.5);
            transition: all 0.4s ease;
        }

        .mode-option.selected .check-mark { opacity: 1; transform: scale(1); }

        .mode-hint {
            margin-top: 1.5rem;
            color: rgba(255,255,255,0.04);
            font-size: 0.6rem;
            letter-spacing: 0.1em;
        }

        /* ============================================================
           头部
           ============================================================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5vh 0 1vh;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

        .header .logo {
            font-size: clamp(1rem, 2vw, 2.2rem);
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header .status {
            font-size: clamp(0.5rem, 0.8vw, 0.9rem);
            color: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .status .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .header .status .dot.online { background: #00FF88; animation: pulse 2s infinite; }

        .header .phase-badge {
            padding: 2px 14px;
            border-radius: 40px;
            font-size: clamp(0.5rem, 0.8vw, 0.9rem);
            font-weight: 600;
            background: rgba(0,240,255,0.04);
            border: 1px solid rgba(0,240,255,0.04);
            color: rgba(255,255,255,0.15);
        }

        @@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(1.2); } }

        /* ============================================================
           模式标签
           ============================================================ */
        .mode-tag {
            display: none;
            font-size: clamp(0.4rem, 0.5vw, 0.6rem);
            color: rgba(0, 240, 255, 0.15);
            letter-spacing: 0.15em;
            text-transform: uppercase;
            padding: 2px 10px;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
        }

        .mode-tag.show { display: inline-block; }
        .mode-tag.tv { color: #4facfe; border-color: rgba(79,172,254,0.06); background: rgba(79,172,254,0.03); }
        .mode-tag.table { color: #F59E0B; border-color: rgba(245,158,11,0.06); background: rgba(245,158,11,0.03); }

        /* ============================================================
           主显示区域
           ============================================================ */
        .main-display {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 0;
            position: relative;
            padding: 0.5vh 0;
        }

        .display-content {
            text-align: center;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.6s ease;
            padding: 0.5vh 0;
        }

        @@keyframes fadeIn { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }

        .display-content .big-icon {
            font-size: clamp(2.5rem, 8vw, 7rem);
            margin-bottom: 0.3vh;
            opacity: 0.5;
            animation: iconFloat 3s ease-in-out infinite;
        }

        @@keyframes iconFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

        .display-content .big-text {
            font-size: clamp(1.8rem, 4.5vw, 4.5rem);
            font-weight: 900;
            line-height: 1.2;
            margin-bottom: 0.2vh;
            letter-spacing: 0.02em;
        }

        .display-content .big-text.night { color: #4facfe; text-shadow: 0 0 60px rgba(79,172,254,0.08); }
        .display-content .big-text.day { color: #F59E0B; text-shadow: 0 0 60px rgba(245,158,11,0.08); }
        .display-content .big-text.death { color: #dc3545; text-shadow: 0 0 60px rgba(220,53,69,0.08); }
        .display-content .big-text.sheriff { color: #F59E0B; text-shadow: 0 0 60px rgba(245,158,11,0.08); }
        .display-content .big-text.win { background: linear-gradient(135deg, #F59E0B, #EC4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

        .display-content .sub-text {
            font-size: clamp(0.7rem, 1.2vw, 1.5rem);
            color: rgba(255,255,255,0.12);
            letter-spacing: 0.06em;
            font-weight: 300;
        }

        .display-content .timer-text {
            font-size: clamp(1rem, 2vw, 2.5rem);
            color: #F59E0B;
            font-weight: 700;
            font-family: 'Courier New', monospace;
            margin-top: 0.3vh;
            animation: pulse 2s ease-in-out infinite;
        }

        /* ===== 死亡列表 ===== */
        .death-list {
            display: flex;
            gap: 1vw;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 1vh;
        }

        .death-list .death-item {
            padding: 0.5vh 1.5vw;
            border-radius: 40px;
            background: rgba(220,53,69,0.06);
            border: 1px solid rgba(220,53,69,0.04);
            color: #dc3545;
            font-weight: 700;
            font-size: clamp(0.8rem, 1.5vw, 1.8rem);
            animation: deathPulse 1.5s ease-in-out infinite;
        }

        @@keyframes deathPulse { 0%, 100% { opacity: 0.6; transform: scale(1); } 50% { opacity: 1; transform: scale(1.05); } }

        /* ===== 警长显示 ===== */
        .sheriff-display {
            margin-top: 0.8vh;
            padding: 0.6vh 1.5vw;
            border-radius: 14px;
            background: rgba(245,158,11,0.03);
            border: 1px solid rgba(245,158,11,0.03);
            text-align: center;
            display: none;
            font-size: clamp(0.7rem, 1vw, 1.3rem);
        }

        .sheriff-display.show { display: block; animation: fadeIn 0.5s ease; }
        .sheriff-display .sheriff-name { color: #F59E0B; font-weight: 700; }

        /* ===== 消息弹出 ===== */
        .message-popup {
            position: absolute;
            bottom: 3vh;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            padding: 0.8vh 2vw;
            border-radius: 14px;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.03);
            color: rgba(255,255,255,0.6);
            font-size: clamp(0.8rem, 1.5vw, 1.8rem);
            font-weight: 500;
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            pointer-events: none;
            max-width: 90vw;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .message-popup.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* ============================================================
           ⭐ 座位图 - TV模式（大屏）
           ============================================================ */
        .seat-map-tv {
            display: none;
            position: relative;
            width: 100%;
            max-width: 600px;
            aspect-ratio: 1 / 0.9;
            margin: 0 auto;
        }

        .seat-map-tv.active { display: block; animation: fadeIn 0.6s ease; }

        .seat-map-tv .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30,20,60,0.15), rgba(10,10,30,0.3));
            border: 1px solid rgba(255,255,255,0.02);
        }

        .seat-map-tv .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .seat-map-tv .table-center .icon { font-size: clamp(1.5rem, 2.5vw, 3rem); opacity: 0.05; display: block; }
        .seat-map-tv .table-center .label { font-size: clamp(0.4rem, 0.5vw, 0.6rem); color: rgba(255,255,255,0.01); text-transform: uppercase; letter-spacing: 0.2em; }

        /* TV模式座位 - 玩家面朝屏幕（外侧） */
        .seat-tv {
            position: absolute;
            width: clamp(32px, 5vw, 52px);
            height: clamp(32px, 5vw, 52px);
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.03);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            font-size: clamp(0.4rem, 0.6vw, 0.7rem);
            color: rgba(255,255,255,0.1);
            transform: translate(-50%, -50%);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
        }

        .seat-tv .seat-number {
            font-size: clamp(0.5rem, 0.7vw, 0.9rem);
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: rgba(255,255,255,0.06);
        }

        .seat-tv .seat-name {
            font-size: clamp(0.3rem, 0.4vw, 0.5rem);
            font-weight: 500;
            color: rgba(255,255,255,0.03);
            max-width: 40px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .seat-tv .seat-emoji { font-size: clamp(0.5rem, 0.7vw, 0.9rem); display: none; }

        .seat-tv.occupied { border-color: rgba(0,240,255,0.1); background: rgba(0,240,255,0.02); }
        .seat-tv.occupied .seat-number { color: rgba(0,240,255,0.2); }
        .seat-tv.occupied .seat-name { color: rgba(255,255,255,0.1); }

        .seat-tv.ready { border-color: rgba(0,255,136,0.12); background: rgba(0,255,136,0.02); box-shadow: 0 0 30px rgba(0,255,136,0.02); }
        .seat-tv.ready .seat-number { color: #00FF88; }

        .seat-tv.dead { border-color: rgba(220,53,69,0.06); background: rgba(220,53,69,0.01); opacity: 0.25; }
        .seat-tv.sheriff { border-color: #F59E0B; box-shadow: 0 0 50px rgba(245,158,11,0.03); }
        .seat-tv.sheriff .seat-number { color: #F59E0B; }

        /* ============================================================
           ⭐ 座位图 - Table模式（桌面中屏）
           ============================================================ */
        .seat-map-table {
            display: none;
            position: relative;
            width: 100%;
            max-width: 500px;
            aspect-ratio: 1 / 0.9;
            margin: 0 auto;
        }

        .seat-map-table.active { display: block; animation: fadeIn 0.6s ease; }

        .seat-map-table .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30,20,60,0.2), rgba(10,10,30,0.4));
            border: 2px solid rgba(255,255,255,0.02);
            box-shadow: 0 0 80px rgba(0,0,0,0.3), inset 0 0 80px rgba(0,0,0,0.2);
        }

        .seat-map-table .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .seat-map-table .table-center .icon {
            font-size: clamp(1.8rem, 3vw, 3.5rem);
            opacity: 0.04;
            display: block;
            animation: tableCenterPulse 3s ease-in-out infinite;
        }

        @@keyframes tableCenterPulse { 0%, 100% { opacity: 0.03; transform: scale(1); } 50% { opacity: 0.06; transform: scale(1.05); } }

        .seat-map-table .table-center .label {
            font-size: clamp(0.3rem, 0.4vw, 0.5rem);
            color: rgba(255,255,255,0.01);
            text-transform: uppercase;
            letter-spacing: 0.2em;
        }

        /* Table模式座位 - 玩家面向圆心（环绕） */
        .seat-table {
            position: absolute;
            width: clamp(36px, 5.5vw, 56px);
            height: clamp(36px, 5.5vw, 56px);
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.03);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            font-size: clamp(0.4rem, 0.6vw, 0.7rem);
            color: rgba(255,255,255,0.1);
            transform: translate(-50%, -50%);
            box-shadow: 0 0 30px rgba(0,0,0,0.15);
        }

        .seat-table .seat-number {
            font-size: clamp(0.55rem, 0.8vw, 1rem);
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: rgba(255,255,255,0.06);
        }

        .seat-table .seat-name {
            font-size: clamp(0.3rem, 0.4vw, 0.5rem);
            font-weight: 500;
            color: rgba(255,255,255,0.03);
            max-width: 44px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .seat-table .seat-emoji {
            font-size: clamp(0.6rem, 0.8vw, 1rem);
            display: none;
        }

        .seat-table.occupied { border-color: rgba(0,240,255,0.1); background: rgba(0,240,255,0.02); }
        .seat-table.occupied .seat-number { color: rgba(0,240,255,0.2); }
        .seat-table.occupied .seat-name { color: rgba(255,255,255,0.1); }

        .seat-table.ready { border-color: rgba(0,255,136,0.12); background: rgba(0,255,136,0.02); box-shadow: 0 0 40px rgba(0,255,136,0.02); }
        .seat-table.ready .seat-number { color: #00FF88; }

        .seat-table.dead { border-color: rgba(220,53,69,0.06); background: rgba(220,53,69,0.01); opacity: 0.25; }
        .seat-table.sheriff { border-color: #F59E0B; box-shadow: 0 0 50px rgba(245,158,11,0.03); }
        .seat-table.sheriff .seat-number { color: #F59E0B; }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 6px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        /* ============================================================
           响应式
           ============================================================ */
        @media (max-width: 768px) {
            .mode-selector { padding: 1.8rem 1.5rem; }
            .mode-selector .title { font-size: 1.4rem; }
            .mode-grid { grid-template-columns: 1fr; gap: 0.8rem; }
            .mode-option { padding: 1.2rem; }
            .mode-option .mode-icon { font-size: 2.5rem; }

            .container { padding: 0.8vh 1.5vw; }
            .seat-tv { width: 28px; height: 28px; }
            .seat-table { width: 32px; height: 32px; }
            .seat-tv .seat-number { font-size: 0.4rem; }
            .seat-table .seat-number { font-size: 0.45rem; }
            .seat-tv .seat-name { display: none; }
            .seat-table .seat-name { display: none; }
            .seat-tv .seat-emoji { display: block; font-size: 0.7rem; }
            .seat-table .seat-emoji { display: block; font-size: 0.8rem; }
            .message-popup { white-space: normal; font-size: clamp(0.6rem, 2vw, 1rem); padding: 0.5vh 2vw; bottom: 2vh; }
        }

        @media (max-width: 480px) {
            .mode-selector { padding: 1.2rem 1rem; border-radius: 24px; }
            .mode-selector .title { font-size: 1.2rem; }
            .mode-option { padding: 0.8rem; border-radius: 14px; }
            .mode-option .mode-icon { font-size: 2rem; }

            .seat-tv { width: 22px; height: 22px; }
            .seat-table { width: 26px; height: 26px; }
            .seat-tv .seat-number { font-size: 0.3rem; }
            .seat-table .seat-number { font-size: 0.35rem; }
            .seat-tv .seat-emoji { font-size: 0.55rem; }
            .seat-table .seat-emoji { font-size: 0.6rem; }
        }

        @media (min-height: 800px) and (min-width: 1200px) {
            .seat-tv { width: 60px; height: 60px; }
            .seat-table { width: 65px; height: 65px; }
            .seat-tv .seat-number { font-size: 1rem; }
            .seat-table .seat-number { font-size: 1.1rem; }
            .seat-tv .seat-name { font-size: 0.5rem; max-width: 50px; }
            .seat-table .seat-name { font-size: 0.55rem; max-width: 55px; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>
    <canvas id="particleCanvas2"></canvas>

    <!-- ============================================================
    ⭐ 模式选择器（游戏开始前显示）
    ============================================================ -->
    <div class="mode-selector" id="modeSelector">
        <div class="title">🎯 选择显示模式</div>
        <p class="subtitle">✦ 根据你的设备选择最佳显示方式 ✦</p>

        <div class="mode-grid">
            <div class="mode-option selected" data-mode="tv" onclick="selectMode('tv')">
                <span class="check-mark">✅</span>
                <span class="mode-icon">🖥️</span>
                <div class="mode-name">大屏模式</div>
                <div class="mode-desc">适合电脑、电视、投影仪<br />所有玩家面朝屏幕</div>
                <span class="mode-device">💻 电脑 · 电视 · 投影</span>
            </div>

            <div class="mode-option" data-mode="table" onclick="selectMode('table')">
                <span class="check-mark">✅</span>
                <span class="mode-icon">📱</span>
                <div class="mode-name">桌面模式</div>
                <div class="mode-desc">适合iPad、平板横放中央<br />座位环绕四周显示</div>
                <span class="mode-device">📱 iPad · 平板 · 手机</span>
            </div>
        </div>

        <button onclick="confirmMode()" style="margin-top: 1.8rem; padding: 0.8rem 3rem; border: none; border-radius: 60px; background: linear-gradient(135deg, #00F0FF, #7B61FF, #EC4899); color: #fff; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.4s ease; font-family: inherit; box-shadow: 0 4px 40px rgba(0,240,255,0.05);">
            🚀 进入游戏
        </button>

        <div class="mode-hint">✦ 游戏开始后可通过 URL 参数切换：?mode=tv 或 ?mode=table ✦</div>
    </div>

    <!-- ============================================================
    ⭐ 主容器（游戏开始后显示）
    ============================================================ -->
    <div class="container" id="mainContainer" style="display:none;">

        <div class="header">
            <div class="logo"><span>🐺</span> 游戏控制中心</div>
            <div class="status">
                <span class="dot online"></span> 在线
                <span id="playerCountDisplay">0/0 人</span>
                <span style="color:rgba(255,255,255,0.04);">|</span>
                <span class="phase-badge" id="phaseBadge">⏳ 等待开始</span>
                <span class="mode-tag" id="modeTag">🖥️ 大屏模式</span>
            </div>
        </div>

        <!-- ===== 主显示区域 ===== -->
        <div class="main-display" id="mainDisplay">
            <div class="display-content" id="displayContent">
                <span class="big-icon">🐺</span>
                <div class="big-text" style="color:rgba(255,255,255,0.03);">等待开始</div>
                <div class="sub-text">✦ AI 自动推进游戏流程 ✦</div>
            </div>

            <div class="sheriff-display" id="sheriffDisplay">
                👑 警长：<span class="sheriff-name" id="sheriffName">-</span>
            </div>

            <div class="message-popup" id="messagePopup"></div>
        </div>

        <!-- ===== 座位图 - TV模式 ===== -->
        <div class="seat-map-tv" id="seatMapTV">
            <div class="table-bg"></div>
            <div class="table-center"><span class="icon">🐺</span><span class="label">狼人杀</span></div>
            <div id="seatsContainerTV"></div>
        </div>

        <!-- ===== 座位图 - Table模式 ===== -->
        <div class="seat-map-table" id="seatMapTable">
            <div class="table-bg"></div>
            <div class="table-center"><span class="icon">🐺</span><span class="label">狼人杀</span></div>
            <div id="seatsContainerTable"></div>
        </div>

    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================
    Scripts
    ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(60, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        (function initParticles2() {
            var canvas = document.getElementById('particleCanvas2');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(30, Math.floor(window.innerWidth / 16));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.03,
                    vy: (Math.random() - 0.5) * 0.03,
                    r: Math.random() * 2 + 1,
                    o: Math.random() * 0.04 + 0.005
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(139, 92, 246, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 模式选择
        // ============================================================
        var selectedMode = 'tv';
        var isGameStarted = false;

        function selectMode(mode) {
            selectedMode = mode;
            document.querySelectorAll('.mode-option').forEach(function(el) {
                el.classList.toggle('selected', el.dataset.mode === mode);
            });
        }

        function confirmMode() {
            document.getElementById('modeSelector').style.display = 'none';
            document.getElementById('mainContainer').style.display = 'flex';

            // 更新模式标签
            var tag = document.getElementById('modeTag');
            if (selectedMode === 'tv') {
                tag.textContent = '🖥️ 大屏模式';
                tag.className = 'mode-tag show tv';
                document.getElementById('seatMapTV').classList.add('active');
                document.getElementById('seatMapTable').classList.remove('active');
                generateSeatsTV();
            } else {
                tag.textContent = '📱 桌面模式';
                tag.className = 'mode-tag show table';
                document.getElementById('seatMapTable').classList.add('active');
                document.getElementById('seatMapTV').classList.remove('active');
                generateSeatsTable();
            }

            connectSignalR();
            showToast('✅ 已切换至 ' + (selectedMode === 'tv' ? '大屏模式' : '桌面模式'), 'success');
        }

        // ============================================================
        // 配置
        // ============================================================
        var config = {
            roomId: '@roomId',
            phase: 'waiting',
            day: 0,
            night: 0,
            players: [],
            aliveCount: 0,
            wolfCount: 0,
            godCount: 0,
            villagerCount: 0,
            isGameOver: false,
            isSheriff: false,
            sheriffId: -1,
            playerCount: 12
        };

        // ============================================================
        // 生成座位 - TV模式（圆形，玩家朝外）
        // ============================================================
        function generateSeatsTV() {
            var container = document.getElementById('seatsContainerTV');
            var count = config.playerCount || 12;
            container.innerHTML = '';
            var radius = 38;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat-tv empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);
                config.seatsTV = config.seatsTV || [];
                config.seatsTV.push({ number: i + 1, element: seat, occupied: false, player: null, isDead: false,
                    isSheriff: false });
            }
            updateSeatCountTV();
        }

        // ============================================================
        // 生成座位 - Table模式（圆形，玩家朝圆心）
        // ============================================================
        function generateSeatsTable() {
            var container = document.getElementById('seatsContainerTable');
            var count = config.playerCount || 12;
            container.innerHTML = '';
            var radius = 40;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat-table empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);
                config.seatsTable = config.seatsTable || [];
                config.seatsTable.push({ number: i + 1, element: seat, occupied: false, player: null, isDead: false,
                    isSheriff: false });
            }
            updateSeatCountTable();
        }

        function updateSeatCountTV() {
            if (!config.seatsTV) return;
            var occupied = config.seatsTV.filter(function(s) { return s.occupied; }).length;
            document.getElementById('playerCountDisplay').textContent = occupied + '/' + config.seatsTV.length;
        }

        function updateSeatCountTable() {
            if (!config.seatsTable) return;
            var occupied = config.seatsTable.filter(function(s) { return s.occupied; }).length;
            document.getElementById('playerCountDisplay').textContent = occupied + '/' + config.seatsTable.length;
        }

        // ============================================================
        // 更新座位 - TV模式
        // ============================================================
        function updateSeatsTV(players) {
            if (!config.seatsTV) return;
            config.seatsTV.forEach(function(seat) {
                var player = players.find(function(p) { return p.seatNumber === seat.number && !p.isSpectator; });
                if (player) {
                    seat.occupied = true;
                    seat.player = player;
                    seat.isDead = !player.isAlive;
                    seat.isSheriff = player.isSheriff || false;
                    seat.element.className = 'seat-tv' +
                        (seat.isDead ? ' dead' : '') +
                        (seat.isSheriff ? ' sheriff' : '') +
                        (player.isReady ? ' ready' : ' occupied');
                    seat.element.querySelector('.seat-name').textContent = player.nickname || '玩家';
                    seat.element.querySelector('.seat-emoji').textContent = player.avatarEmoji || '🧑';
                } else {
                    seat.occupied = false;
                    seat.player = null;
                    seat.isDead = false;
                    seat.isSheriff = false;
                    seat.element.className = 'seat-tv empty';
                    seat.element.querySelector('.seat-name').textContent = '空位';
                    seat.element.querySelector('.seat-emoji').textContent = '🪑';
                }
            });
            updateSeatCountTV();
        }

        // ============================================================
        // 更新座位 - Table模式
        // ============================================================
        function updateSeatsTable(players) {
            if (!config.seatsTable) return;
            config.seatsTable.forEach(function(seat) {
                var player = players.find(function(p) { return p.seatNumber === seat.number && !p.isSpectator; });
                if (player) {
                    seat.occupied = true;
                    seat.player = player;
                    seat.isDead = !player.isAlive;
                    seat.isSheriff = player.isSheriff || false;
                    seat.element.className = 'seat-table' +
                        (seat.isDead ? ' dead' : '') +
                        (seat.isSheriff ? ' sheriff' : '') +
                        (player.isReady ? ' ready' : ' occupied');
                    seat.element.querySelector('.seat-name').textContent = player.nickname || '玩家';
                    seat.element.querySelector('.seat-emoji').textContent = player.avatarEmoji || '🧑';
                } else {
                    seat.occupied = false;
                    seat.player = null;
                    seat.isDead = false;
                    seat.isSheriff = false;
                    seat.element.className = 'seat-table empty';
                    seat.element.querySelector('.seat-name').textContent = '空位';
                    seat.element.querySelector('.seat-emoji').textContent = '🪑';
                }
            });
            updateSeatCountTable();
        }

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('PlayerListUpdate', function(players) {
                    config.players = players;
                    if (selectedMode === 'tv') {
                        updateSeatsTV(players);
                    } else {
                        updateSeatsTable(players);
                    }
                    updateStats(players);
                });

                connection.on('PhaseUpdate', function(phase, day, night) {
                    config.phase = phase;
                    config.day = day || 0;
                    config.night = night || 0;
                    updatePhaseDisplay(phase, day, night);
                    updateDisplay(phase);
                });

                connection.on('DisplayMessage', function(message) {
                    showDisplayMessage(message);
                });

                connection.on('VoiceAnnounce', function(message, type) {
                    showDisplayMessage('🔊 ' + message);
                    speak(message, type === 'important');
                });

                connection.on('DeathAnnounce', function(data) {
                    if (data.deaths && data.deaths.length > 0) {
                        showDeathAnnounce(data.deaths, data.message);
                    } else {
                        showDisplayMessage('🕊️ ' + data.message);
                    }
                });

                connection.on('SheriffElected', function(data) {
                    config.isSheriff = true;
                    config.sheriffId = data.seatNumber;
                    document.getElementById('sheriffDisplay').classList.add('show');
                    document.getElementById('sheriffName').textContent = data.seatNumber + '号 ' + data.nickname;
                    showDisplayMessage('👑 ' + data.seatNumber + '号当选警长！');
                });

                connection.on('GameOver', function(winner) {
                    config.isGameOver = true;
                    var msg = winner === '好人' ? '⭐ 好人阵营胜利！' : '🐺 狼人阵营胜利！';
                    showDisplayMessage('🏆 ' + msg);
                    document.getElementById('phaseBadge').textContent = '🏁 ' + msg;
                    speak(msg, true);
                });

                connection.on('PlayerDeath', function(data) {
                    showDisplayMessage('💀 ' + data.seatNumber + '号 ' + data.nickname + ' 死亡');
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        connection.invoke('JoinControlCenter', config.roomId);
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 更新显示
        // ============================================================
        function updateStats(players) {
            var alive = players.filter(function(p) { return p.isAlive && !p.isSpectator; });
            var wolves = players.filter(function(p) { return p.role === 'Werewolf' && p.isAlive && !p.isSpectator; });

            config.aliveCount = alive.length;
            config.wolfCount = wolves.length;
        }

        var phaseMap = {
            'setup': { label: '⚙️ 设置中', icon: '⚙️' },
            'seating': { label: '🪑 就坐中', icon: '🪑' },
            'dealing': { label: '🃏 发牌中', icon: '🃏' },
            'revealing': { label: '📩 查看身份', icon: '📩' },
            'sheriff_election': { label: '👑 警长竞选', icon: '👑' },
            'night_guard': { label: '🌙 守卫行动', icon: '🛡️' },
            'night_seer': { label: '🌙 预言家行动', icon: '🔮' },
            'night_werewolf': { label: '🌙 狼人行动', icon: '🐺' },
            'night_witch': { label: '🌙 女巫行动', icon: '🧪' },
            'night_resolve': { label: '🌙 结算中', icon: '⚖️' },
            'day_announce': { label: '☀️ 公布死讯', icon: '📢' },
            'day_speech': { label: '☀️ 发言阶段', icon: '📢' },
            'day_voting': { label: '☀️ 投票阶段', icon: '🗳️' },
            'day_pk': { label: '☀️ PK发言', icon: '⚖️' },
            'day_resolve': { label: '☀️ 公布结果', icon: '⚖️' },
            'hunter_shoot': { label: '🔫 猎人开枪', icon: '🔫' },
            'gameover': { label: '🏁 游戏结束', icon: '🏁' }
        };

        function updatePhaseDisplay(phase, day, night) {
            var badge = document.getElementById('phaseBadge');
            var info = phaseMap[phase] || { label: phase, icon: '❓' };
            badge.textContent = info.icon + ' ' + info.label;

            if (phase === 'sheriff_election') badge.style.color = '#F59E0B';
            else if (phase === 'day_announce' || phase === 'day_speech' || phase === 'day_voting' || phase === 'day_pk' ||
                phase === 'day_resolve' || phase === 'hunter_shoot') {
                badge.style.color = '#F59E0B';
            } else if (phase.startsWith('night') || phase === 'night_resolve') {
                badge.style.color = '#4facfe';
            } else if (phase === 'gameover') {
                badge.style.color = '#EC4899';
            } else {
                badge.style.color = 'rgba(255,255,255,0.15)';
            }
        }

        // ============================================================
        // 显示更新
        // ============================================================
        function updateDisplay(phase) {
            var content = document.getElementById('displayContent');

            var phases = {
                'setup': '<span class="big-icon">🐺</span><div class="big-text" style="color:rgba(255,255,255,0.03);">等待开始</div><div class="sub-text">✦ AI 自动推进游戏流程 ✦</div>',
                'seating': '<span class="big-icon">🪑</span><div class="big-text" style="color:rgba(255,255,255,0.03);">等待就坐</div><div class="sub-text">✦ 请所有玩家就坐 ✦</div>',
                'dealing': '<span class="big-icon">🃏</span><div class="big-text" style="color:#8B5CF6;">洗牌发牌中...</div><div class="sub-text">✦ 请稍候 ✦</div>',
                'revealing': '<span class="big-icon">📩</span><div class="big-text" style="color:#8B5CF6;">查看你的身份</div><div class="sub-text">✦ 请在手机上查看身份牌 ✦</div>',
                'sheriff_election': '<span class="big-icon">👑</span><div class="big-text sheriff">警长竞选</div><div class="sub-text">✦ 请参与竞选的玩家发言 ✦</div>',
                'night_guard': '<span class="big-icon">🛡️</span><div class="big-text night">守卫请行动</div><div class="sub-text">✦ 守卫请在手机上选择守护目标 ✦</div><div class="timer-text">⏱ 20s</div>',
                'night_seer': '<span class="big-icon">🔮</span><div class="big-text night">预言家请行动</div><div class="sub-text">✦ 预言家请在手机上选择查验目标 ✦</div><div class="timer-text">⏱ 20s</div>',
                'night_werewolf': '<span class="big-icon">🐺</span><div class="big-text night">狼人请行动</div><div class="sub-text">✦ 所有狼人请统一选择杀害目标 ✦</div><div class="timer-text">⏱ 30s</div>',
                'night_witch': '<span class="big-icon">🧪</span><div class="big-text night">女巫请行动</div><div class="sub-text">✦ 女巫请选择解药或毒药 ✦</div><div class="timer-text">⏱ 20s</div>',
                'night_resolve': '<span class="big-icon">⚖️</span><div class="big-text night">结算中...</div><div class="sub-text">✦ 正在计算今晚结果 ✦</div>',
                'day_announce': '<span class="big-icon">📢</span><div class="big-text day">天亮了</div><div class="sub-text" id="deathAnnounce">✦ 昨晚是平安夜 ✦</div><div class="death-list" id="deathList"></div>',
                'day_speech': '<span class="big-icon">📢</span><div class="big-text day">发言阶段</div><div class="sub-text">✦ 请按顺序发言 ✦</div>',
                'day_voting': '<span class="big-icon">🗳️</span><div class="big-text day">投票阶段</div><div class="sub-text">✦ 请在手机上投票放逐 ✦</div><div class="timer-text">⏱ 45s</div>',
                'day_pk': '<span class="big-icon">⚖️</span><div class="big-text day">PK发言</div><div class="sub-text">✦ 平票，PK玩家发言 ✦</div>',
                'day_resolve': '<span class="big-icon">⚖️</span><div class="big-text day">公布结果</div><div class="sub-text" id="voteResult">✦ 等待投票结果 ✦</div>',
                'hunter_shoot': '<span class="big-icon">🔫</span><div class="big-text" style="color:#F59E0B;">猎人开枪</div><div class="sub-text">✦ 猎人选择开枪目标 ✦</div><div class="timer-text">⏱ 20s</div>',
                'gameover': '<span class="big-icon">🏁</span><div class="big-text win">游戏结束</div><div class="sub-text" id="gameoverMessage">✦ 等待结果 ✦</div>'
            };

            content.innerHTML = phases[phase] || phases.setup;
        }

        function showDeathAnnounce(deaths, message) {
            var content = document.getElementById('displayContent');
            var list = document.getElementById('deathList');

            if (!list) {
                var html =
                    '<span class="big-icon">📢</span><div class="big-text day">天亮了</div><div class="sub-text">' +
                    message + '</div><div class="death-list" id="deathList">';
                deaths.forEach(function(d) { html += '<span class="death-item">💀 ' + d + '</span>'; });
                html += '</div>';
                content.innerHTML = html;
                return;
            }

            list.innerHTML = '';
            deaths.forEach(function(d) {
                var item = document.createElement('span');
                item.className = 'death-item';
                item.textContent = '💀 ' + d;
                list.appendChild(item);
            });
            var subText = content.querySelector('.sub-text');
            if (subText) subText.textContent = message;
        }

        // ============================================================
        // 消息显示
        // ============================================================
        var messageTimeout = null;

        function showDisplayMessage(message) {
            var popup = document.getElementById('messagePopup');
            popup.textContent = message;
            popup.classList.add('show');
            clearTimeout(messageTimeout);
            messageTimeout = setTimeout(function() {
                popup.classList.remove('show');
            }, 6000);
        }

        // ============================================================
        // 语音播报
        // ============================================================
        function speak(text, isImportant) {
            try {
                if (!window.speechSynthesis) return;
                window.speechSynthesis.cancel();
                var utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'zh-CN';
                utterance.rate = isImportant ? 0.85 : 0.9;
                utterance.pitch = isImportant ? 0.9 : 1.0;
                utterance.volume = 1;
                var voices = window.speechSynthesis.getVoices();
                var zhVoice = voices.find(function(v) { return v.lang && v.lang.startsWith('zh'); });
                if (zhVoice) utterance.voice = zhVoice;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}
        }

        // 预加载语音
        document.addEventListener('DOMContentLoaded', function() {
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = function() {
                    window.speechSynthesis.getVoices();
                };
            }
        });

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 游戏控制中心启动...');

            // 默认选中 TV 模式
            selectMode('tv');

            // URL 参数自动选择模式
            var urlParams = new URLSearchParams(window.location.search);
            var modeParam = urlParams.get('mode');
            if (modeParam === 'tv' || modeParam === 'table') {
                selectMode(modeParam);
            }

            // 如果有房间ID且参数中有 autoStart=1，自动确认模式进入游戏
            var autoStart = urlParams.get('autoStart');
            if (autoStart === '1' && config.roomId) {
                setTimeout(confirmMode, 500);
            }
        });
    </script>

</body>
</html>
