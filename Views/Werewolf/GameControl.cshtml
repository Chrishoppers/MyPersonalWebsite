@{
    Layout = null;
    ViewData["Title"] = "🐺 游戏控制中心";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 游戏控制中心</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 16px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        /* ===== 顶部 ===== */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0 20px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-wrap: wrap;
            gap: 12px;
        }

        .header .logo {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header .phase-badge {
            padding: 4px 16px;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 600;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            color: rgba(255,255,255,0.15);
        }

        .header .phase-badge .night { color: #4facfe; }
        .header .phase-badge .day { color: #F59E0B; }

        /* ===== 主网格 ===== */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 20px;
            margin-top: 20px;
        }

        @@media (max-width: 1100px) {
            .main-grid { grid-template-columns: 1fr; }
        }

        /* ===== 卡片 ===== */
        .card {
            background: rgba(255,255,255,0.02);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 20px;
            padding: 20px;
            transition: all 0.4s ease;
        }

        .card:hover { border-color: rgba(255,255,255,0.06); }
        .card .card-title {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.15);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.04), transparent); }

        /* ===== 大屏显示 ===== */
        .main-display {
            min-height: 400px;
            display: flex;
            flex-direction: column;
        }

        .main-display .display-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
            text-align: center;
            min-height: 350px;
            transition: all 0.5s ease;
        }

        .main-display .display-content .big-icon { font-size: 4rem; margin-bottom: 8px; opacity: 0.3; }
        .main-display .display-content .big-text { font-size: 2.4rem; font-weight: 800; margin-bottom: 4px; }
        .main-display .display-content .big-text.night { color: #4facfe; }
        .main-display .display-content .big-text.day { color: #F59E0B; }
        .main-display .display-content .big-text.death { color: #dc3545; }
        .main-display .display-content .big-text.sheriff { color: #F59E0B; }
        .main-display .display-content .sub-text { font-size: 1rem; color: rgba(255,255,255,0.15); letter-spacing: 0.06em; }

        .main-display .display-content .death-list {
            margin-top: 12px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .main-display .display-content .death-list .death-item {
            padding: 8px 16px;
            border-radius: 40px;
            background: rgba(220, 53, 69, 0.06);
            border: 1px solid rgba(220, 53, 69, 0.06);
            color: #dc3545;
            font-weight: 600;
            font-size: 0.9rem;
            animation: deathPulse 1.5s ease-in-out infinite;
        }

        @@keyframes deathPulse {
            0%, 100% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.05); }
        }

        /* ===== 暗夜/白天过渡特效 ===== */
        .phase-transition {
            position: fixed;
            inset: 0;
            z-index: 9997;
            pointer-events: none;
            display: none;
        }

        .phase-transition.active { display: block; animation: phaseFlash 1.2s ease-out; }

        @@keyframes phaseFlash {
            0% { background: rgba(0,0,0,0); }
            30% { background: rgba(0,0,0,0.8); }
            70% { background: rgba(0,0,0,0.8); }
            100% { background: rgba(0,0,0,0); }
        }

        .phase-transition.night { background: rgba(0,0,20,0.95); animation: nightFall 1.5s ease; }
        .phase-transition.day { background: rgba(255,255,200,0.2); animation: dayRise 1.5s ease; }

        @@keyframes nightFall {
            0% { opacity: 0; }
            50% { opacity: 1; }
            100% { opacity: 0.8; }
        }

        @@keyframes dayRise {
            0% { opacity: 0.8; background: rgba(0,0,0,0.9); }
            50% { opacity: 0.5; background: rgba(255,255,200,0.15); }
            100% { opacity: 0; }
        }

        /* ===== 警长选举 ===== */
        .sheriff-display {
            margin-top: 12px;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(245, 158, 11, 0.04);
            border: 1px solid rgba(245, 158, 11, 0.04);
            text-align: center;
            display: none;
        }

        .sheriff-display.show { display: block; animation: fadeIn 0.5s ease; }
        .sheriff-display .sheriff-name { color: #F59E0B; font-weight: 700; font-size: 1.1rem; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ===== 玩家状态 ===== */
        .player-status-list {
            max-height: 300px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .player-status-list::-webkit-scrollbar { width: 3px; }
        .player-status-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.04); border-radius: 10px; }

        .player-status-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.3s ease;
            font-size: 0.75rem;
        }

        .player-status-item .seat { color: rgba(255,255,255,0.05); font-weight: 700; min-width: 20px; }
        .player-status-item .avatar { font-size: 0.9rem; }
        .player-status-item .name { flex: 1; color: rgba(255,255,255,0.3); }
        .player-status-item .role { font-size: 0.6rem; padding: 0 6px; border-radius: 10px; opacity: 0.2; }
        .player-status-item .status-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
        .player-status-item .status-dot.alive { background: #00FF88; }
        .player-status-item .status-dot.dead { background: #dc3545; }
        .player-status-item .status-dot.sheriff { background: #F59E0B; box-shadow: 0 0 20px rgba(245,158,11,0.1); }

        .player-status-item.dead { opacity: 0.3; }

        /* ===== 控制按钮 ===== */
        .control-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
        }

        .btn-control {
            flex: 1;
            padding: 10px 14px;
            border: none;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            min-width: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-control.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
        .btn-control.primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(139,92,246,0.15); }
        .btn-control.primary:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }

        .btn-control.success { background: linear-gradient(135deg, #00FF88, #00F0FF); color: #05050F; }
        .btn-control.success:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(0,255,136,0.1); }

        .btn-control.danger { background: rgba(255,0,110,0.08); border: 1px solid rgba(255,0,110,0.04); color: rgba(255,0,110,0.3); }
        .btn-control.danger:hover:not(:disabled) { background: rgba(255,0,110,0.12); }

        .btn-control.secondary { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); color: rgba(255,255,255,0.2); }
        .btn-control.secondary:hover:not(:disabled) { background: rgba(255,255,255,0.04); color: #fff; }

        .btn-control:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }

        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            border-bottom: 1px solid rgba(255,255,255,0.02);
            font-size: 0.75rem;
            color: rgba(255,255,255,0.1);
        }
        .info-row .label { color: rgba(255,255,255,0.04); }
        .info-row .value { color: rgba(255,255,255,0.15); font-weight: 600; }

        .phase-hint {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.04);
            text-align: center;
            margin-top: 8px;
        }

        /* ===== Toast ===== */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 8px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.8rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @@media (max-width: 768px) {
            body { padding: 10px; }
            .header .logo { font-size: 1.2rem; }
            .main-display .display-content .big-text { font-size: 1.6rem; }
            .main-display .display-content .big-icon { font-size: 2.8rem; }
            .main-display .display-content .sub-text { font-size: 0.8rem; }
            .card { padding: 14px; }
            .control-buttons { flex-direction: column; }
            .btn-control { padding: 8px 12px; font-size: 0.75rem; }
        }

        @@media (max-width: 480px) {
            .main-display .display-content .big-text { font-size: 1.2rem; }
            .main-display .display-content .big-icon { font-size: 2rem; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- 顶部 -->
        <div class="header">
            <div class="logo">
                <span>🐺</span> 游戏控制中心
            </div>
            <div>
                <span class="phase-badge" id="phaseBadge">⏳ 等待开始</span>
                <span class="phase-badge" style="margin-left:8px;" id="roundBadge">第 0 天</span>
            </div>
        </div>

        <!-- 主网格 -->
        <div class="main-grid">

            <!-- 大屏显示 -->
            <div class="card main-display">
                <div class="card-title">
                    📺 主屏幕
                    <span class="accent"></span>
                    <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);" id="statusTime">--:--</span>
                </div>

                <div class="display-content" id="displayContent">
                    <span class="big-icon">🐺</span>
                    <div class="big-text" style="color:rgba(255,255,255,0.05);">等待开始</div>
                    <div class="sub-text">✦ 所有玩家准备后自动开始 ✦</div>
                </div>

                <!-- 警长显示 -->
                <div class="sheriff-display" id="sheriffDisplay">
                    👑 警长：<span class="sheriff-name" id="sheriffName">-</span>
                </div>
            </div>

            <!-- 右侧面板 -->
            <div class="side-panel" style="display:flex;flex-direction:column;gap:16px;">

                <!-- 游戏信息 -->
                <div class="card">
                    <div class="card-title">
                        📊 游戏信息
                        <span class="accent"></span>
                    </div>
                    <div class="info-row"><span class="label">存活</span><span class="value" id="aliveCount">0</span></div>
                    <div class="info-row"><span class="label">狼人</span><span class="value" id="wolfCount">0</span></div>
                    <div class="info-row"><span class="label">神职</span><span class="value" id="godCount">0</span></div>
                    <div class="info-row"><span class="label">平民</span><span class="value" id="villagerCount">0</span></div>
                    <div class="info-row" style="border-bottom:none;"><span class="label">状态</span><span class="value" id="gameStatusText" style="color:#00F0FF;">⚙️ 设置中</span></div>
                </div>

                <!-- 控制按钮 -->
                <div class="card">
                    <div class="card-title">
                        🎮 控制
                        <span class="accent"></span>
                    </div>

                    <div class="control-buttons">
                        <button class="btn-control primary" id="btnNextPhase" onclick="nextPhase()">▶️ 下一步</button>
                        <button class="btn-control secondary" onclick="skipPhase()">⏭️ 跳过</button>
                        <button class="btn-control danger" onclick="endGame()">🏁 结束</button>
                    </div>

                    <div class="phase-hint" id="phaseHint">💡 点击"下一步"推进游戏流程</div>
                </div>

                <!-- 玩家状态 -->
                <div class="card">
                    <div class="card-title">
                        👥 玩家状态
                        <span class="accent"></span>
                        <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);" id="playerCountDisplay">0</span>
                    </div>
                    <div class="player-status-list" id="playerStatusList">
                        <span style="color:rgba(255,255,255,0.04);font-size:0.7rem;">暂无玩家</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 暗夜/白天过渡 -->
    <div class="phase-transition" id="phaseTransition"></div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        var roomId = '@roomId';
        var config = {
            phase: 'waiting',
            day: 0,
            night: 0,
            players: [],
            aliveCount: 0,
            wolfCount: 0,
            godCount: 0,
            villagerCount: 0,
            isGameOver: false,
            isSheriff: false,
            sheriffId: -1
        };

        var phaseMap = {
            'setup': { label: '⚙️ 设置中', icon: '⚙️' },
            'seating': { label: '🪑 就坐中', icon: '🪑' },
            'dealing': { label: '🃏 发牌中', icon: '🃏' },
            'revealing': { label: '📩 查看身份', icon: '📩' },
            'sheriff_election': { label: '👑 警长竞选', icon: '👑' },
            'night_guard': { label: '🌙 守卫行动', icon: '🛡️' },
            'night_seer': { label: '🌙 预言家行动', icon: '🔮' },
            'night_werewolf': { label: '🌙 狼人行动', icon: '🐺' },
            'night_witch': { label: '🌙 女巫行动', icon: '🧪' },
            'night_resolve': { label: '🌙 结算中', icon: '⚖️' },
            'day_announce': { label: '☀️ 公布死讯', icon: '📢' },
            'day_speech': { label: '☀️ 发言阶段', icon: '📢' },
            'day_voting': { label: '☀️ 投票阶段', icon: '🗳️' },
            'day_pk': { label: '☀️ PK发言', icon: '⚖️' },
            'day_resolve': { label: '☀️ 公布结果', icon: '⚖️' },
            'hunter_shoot': { label: '🔫 猎人开枪', icon: '🔫' },
            'gameover': { label: '🏁 游戏结束', icon: '🏁' }
        };

        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('PlayerListUpdate', function(players) {
                    config.players = players;
                    updatePlayerList(players);
                    updateStats(players);
                });

                connection.on('PhaseUpdate', function(phase, day, night) {
                    config.phase = phase;
                    config.day = day || 0;
                    config.night = night || 0;
                    updatePhaseDisplay(phase, day, night);
                    updateDisplay(phase);
                });

                connection.on('VoiceAnnounce', function(message) {
                    showDisplayMessage(message);
                });

                connection.on('DisplayMessage', function(message) {
                    showDisplayMessage(message);
                });

                connection.on('DeathAnnounce', function(data) {
                    if (data.deaths && data.deaths.length > 0) {
                        showDeathAnnounce(data.deaths, data.message);
                    } else {
                        showDisplayMessage('🕊️ ' + data.message);
                    }
                });

                connection.on('SheriffElected', function(data) {
                    config.isSheriff = true;
                    config.sheriffId = data.seatNumber;
                    document.getElementById('sheriffDisplay').classList.add('show');
                    document.getElementById('sheriffName').textContent = data.seatNumber + '号 ' + data.nickname;
                    showDisplayMessage('👑 ' + data.seatNumber + '号当选警长！');
                    showToast('👑 ' + data.seatNumber + '号当选警长！', 'success');
                });

                connection.on('SheriffCandidateUpdate', function(candidates) {
                    showDisplayMessage('👑 参与竞选：' + candidates.join('、') + ' 号');
                });

                connection.on('GameOver', function(winner) {
                    config.isGameOver = true;
                    var msg = winner === '好人' ? '⭐ 好人阵营胜利！' : '🐺 狼人阵营胜利！';
                    showDisplayMessage('🏆 ' + msg);
                    document.getElementById('phaseBadge').textContent = '🏁 ' + msg;
                    document.getElementById('gameStatusText').textContent = '🏁 ' + msg;
                    document.getElementById('btnNextPhase').disabled = true;
                    showToast('🏆 ' + msg, 'success');

                    // 胜利特效
                    showVictoryEffect(winner);
                });

                connection.on('PlayerDeath', function(data) {
                    showDisplayMessage('💀 ' + data.seatNumber + '号 ' + data.nickname + ' 死亡');
                    showDeathEffect(data.seatNumber);
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        connection.invoke('JoinControlCenter', roomId);
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        function updatePlayerList(players) {
            var container = document.getElementById('playerStatusList');
            if (!players || players.length === 0) {
                container.innerHTML = '<span style="color:rgba(255,255,255,0.04);font-size:0.7rem;">暂无玩家</span>';
                document.getElementById('playerCountDisplay').textContent = '0';
                return;
            }

            var html = '';
            var sorted = players.sort(function(a, b) { return a.seatNumber - b.seatNumber; });

            sorted.forEach(function(p) {
                if (p.isSpectator) return;
                var isAlive = p.isAlive;
                var isSheriff = p.isSheriff;

                html += '<div class="player-status-item ' + (!isAlive ? 'dead' : '') + '">';
                html += '<span class="seat">#' + p.seatNumber + '</span>';
                html += '<span class="avatar">' + (p.avatarEmoji || '🧑') + '</span>';
                html += '<span class="name">' + p.nickname + '</span>';
                if (isSheriff) { html += '<span class="status-dot sheriff"></span>'; }
                html += '<span class="status-dot ' + (isAlive ? 'alive' : 'dead') + '"></span>';
                html += '<span class="role">' + (p.role || '') + '</span>';
                html += '</div>';
            });

            container.innerHTML = html;
            document.getElementById('playerCountDisplay').textContent = sorted.filter(p => !p.isSpectator).length;
        }

        function updateStats(players) {
            var alive = players.filter(function(p) { return p.isAlive && !p.isSpectator; });
            var wolves = players.filter(function(p) { return p.role === 'Werewolf' && p.isAlive && !p.isSpectator; });
            var gods = players.filter(function(p) {
                var role = p.role;
                return role !== 'Werewolf' && role !== 'Villager' && p.isAlive && !p.isSpectator;
            });
            var villagers = players.filter(function(p) { return p.role === 'Villager' && p.isAlive && !p.isSpectator; });

            config.aliveCount = alive.length;
            config.wolfCount = wolves.length;
            config.godCount = gods.length;
            config.villagerCount = villagers.length;

            document.getElementById('aliveCount').textContent = alive.length;
            document.getElementById('wolfCount').textContent = wolves.length;
            document.getElementById('godCount').textContent = gods.length;
            document.getElementById('villagerCount').textContent = villagers.length;
        }

        function updatePhaseDisplay(phase, day, night) {
            var badge = document.getElementById('phaseBadge');
            var roundBadge = document.getElementById('roundBadge');

            var info = phaseMap[phase] || { label: phase, icon: '❓' };
            badge.textContent = info.icon + ' ' + info.label;

            if (phase === 'sheriff_election') {
                roundBadge.textContent = '👑 警长竞选';
                badge.style.color = '#F59E0B';
            } else if (phase === 'day_announce' || phase === 'day_speech' || phase === 'day_voting' || phase === 'day_pk' ||
                phase === 'day_resolve' || phase === 'hunter_shoot') {
                roundBadge.textContent = '☀️ 第 ' + (day || 0) + ' 天';
                badge.style.color = '#F59E0B';
            } else if (phase.startsWith('night') || phase === 'night_resolve') {
                roundBadge.textContent = '🌙 第 ' + (night || 0) + ' 夜';
                badge.style.color = '#4facfe';
            } else if (phase === 'gameover') {
                roundBadge.textContent = '🏁 游戏结束';
                badge.style.color = '#EC4899';
            } else {
                roundBadge.textContent = '⏳ 准备中';
                badge.style.color = 'rgba(255,255,255,0.15)';
            }

            var statusMap = {
                'setup': '⚙️ 设置中',
                'seating': '🪑 等待玩家就坐',
                'dealing': '🃏 发牌中',
                'revealing': '📩 玩家查看身份',
                'sheriff_election': '👑 警长竞选',
                'night_guard': '🛡️ 守卫行动中...',
                'night_seer': '🔮 预言家查验中...',
                'night_werewolf': '🐺 狼人行动中...',
                'night_witch': '🧪 女巫行动中...',
                'night_resolve': '⚖️ 结算中...',
                'day_announce': '📢 公布死讯',
                'day_speech': '📢 发言阶段',
                'day_voting': '🗳️ 投票阶段',
                'day_pk': '⚖️ PK发言',
                'day_resolve': '⚖️ 公布结果',
                'hunter_shoot': '🔫 猎人开枪',
                'gameover': '🏁 游戏结束'
            };

            document.getElementById('gameStatusText').textContent = statusMap[phase] || phase;
        }

        function updateDisplay(phase) {
            var content = document.getElementById('displayContent');

            switch (phase) {
                case 'setup':
                case 'seating':
                    content.innerHTML =
                        `<span class="big-icon">🐺</span><div class="big-text" style="color:rgba(255,255,255,0.05);">等待开始</div><div class="sub-text">✦ 所有玩家准备后自动开始 ✦</div>`;
                    break;

                case 'dealing':
                    content.innerHTML =
                        `<span class="big-icon">🃏</span><div class="big-text" style="color:#8B5CF6;">洗牌发牌中...</div><div class="sub-text">✦ 请稍候 ✦</div>`;
                    break;

                case 'revealing':
                    content.innerHTML =
                        `<span class="big-icon">📩</span><div class="big-text" style="color:#8B5CF6;">查看你的身份</div><div class="sub-text">✦ 请在手机上查看身份牌 ✦</div>`;
                    break;

                case 'sheriff_election':
                    content.innerHTML =
                        `<span class="big-icon">👑</span><div class="big-text sheriff">警长竞选</div><div class="sub-text">✦ 请参与竞选的玩家发言 ✦</div>`;
                    break;

                case 'night_guard':
                    content.innerHTML =
                        `<span class="big-icon">🛡️</span><div class="big-text night">守卫请行动</div><div class="sub-text">✦ 守卫请在手机上选择守护目标 ✦</div>`;
                    break;

                case 'night_seer':
                    content.innerHTML =
                        `<span class="big-icon">🔮</span><div class="big-text night">预言家请行动</div><div class="sub-text">✦ 预言家请在手机上选择查验目标 ✦</div>`;
                    break;

                case 'night_werewolf':
                    content.innerHTML =
                        `<span class="big-icon">🐺</span><div class="big-text night">狼人请行动</div><div class="sub-text">✦ 所有狼人请在手机上统一选择杀害目标 ✦</div>`;
                    break;

                case 'night_witch':
                    content.innerHTML =
                        `<span class="big-icon">🧪</span><div class="big-text night">女巫请行动</div><div class="sub-text">✦ 女巫请在手机上选择解药或毒药 ✦</div>`;
                    break;

                case 'night_resolve':
                    content.innerHTML =
                        `<span class="big-icon">⚖️</span><div class="big-text night">结算中...</div><div class="sub-text">✦ 正在计算今晚结果 ✦</div>`;
                    break;

                case 'day_announce':
                    content.innerHTML =
                        `<span class="big-icon">📢</span><div class="big-text day">天亮了</div><div class="sub-text" id="deathAnnounce">✦ 昨晚是平安夜 ✦</div><div class="death-list" id="deathList"></div>`;
                    break;

                case 'day_speech':
                    content.innerHTML =
                        `<span class="big-icon">📢</span><div class="big-text day">发言阶段</div><div class="sub-text">✦ 请按顺序发言 ✦</div>`;
                    break;

                case 'day_voting':
                    content.innerHTML =
                        `<span class="big-icon">🗳️</span><div class="big-text day">投票阶段</div><div class="sub-text">✦ 请在手机上投票放逐 ✦</div>`;
                    break;

                case 'day_pk':
                    content.innerHTML =
                        `<span class="big-icon">⚖️</span><div class="big-text day">PK发言</div><div class="sub-text">✦ 平票，PK玩家发言 ✦</div>`;
                    break;

                case 'day_resolve':
                    content.innerHTML =
                        `<span class="big-icon">⚖️</span><div class="big-text day">公布结果</div><div class="sub-text" id="voteResult">✦ 等待投票结果 ✦</div>`;
                    break;

                case 'hunter_shoot':
                    content.innerHTML =
                        `<span class="big-icon">🔫</span><div class="big-text" style="color:#F59E0B;">猎人开枪</div><div class="sub-text">✦ 猎人选择开枪目标 ✦</div>`;
                    break;

                case 'gameover':
                    break;

                default:
                    content.innerHTML =
                        `<span class="big-icon">🐺</span><div class="big-text" style="color:rgba(255,255,255,0.05);">游戏中</div><div class="sub-text">✦ 等待下一阶段 ✦</div>`;
            }
        }

        function showDeathAnnounce(deaths, message) {
            var content = document.getElementById('displayContent');
            var list = document.getElementById('deathList');

            if (!list) {
                // 如果还没有死亡列表，重建内容
                var html =
                    `<span class="big-icon">📢</span><div class="big-text day">天亮了</div><div class="sub-text">${message}</div><div class="death-list" id="deathList">`;
                deaths.forEach(function(d) {
                    html += `<span class="death-item">💀 ${d}</span>`;
                });
                html += `</div>`;
                content.innerHTML = html;
                return;
            }

            // 更新现有列表
            list.innerHTML = '';
            deaths.forEach(function(d) {
                var item = document.createElement('span');
                item.className = 'death-item';
                item.textContent = '💀 ' + d;
                list.appendChild(item);
            });

            var subText = content.querySelector('.sub-text');
            if (subText) subText.textContent = message;
        }

        function showDisplayMessage(message) {
            var content = document.getElementById('displayContent');
            var existing = content.querySelector('.display-message');
            if (existing) existing.remove();

            var msgDiv = document.createElement('div');
            msgDiv.className = 'sub-text display-message';
            msgDiv.style.cssText = 'margin-top:4px;color:#8B5CF6;font-weight:600;animation:fadeIn 0.5s ease;';
            msgDiv.textContent = '🔊 ' + message;

            // 如果内容中已有 sub-text，在它后面插入
            var subText = content.querySelector('.sub-text:last-child');
            if (subText && subText !== msgDiv) {
                content.appendChild(msgDiv);
            } else {
                content.appendChild(msgDiv);
            }

            setTimeout(function() {
                if (msgDiv.parentNode) msgDiv.remove();
            }, 8000);
        }

        function showDeathEffect(seatNumber) {
            // 简单红色闪光
            var flash = document.createElement('div');
            flash.style.cssText =
                'position:fixed;inset:0;z-index:9996;background:rgba(220,53,69,0.05);pointer-events:none;animation:deathFlash 0.8s ease-out;';
            document.body.appendChild(flash);
            setTimeout(function() { flash.remove(); }, 800);
        }

        function showVictoryEffect(winner) {
            var color = winner === '好人' ? '#F59E0B' : '#dc3545';
            for (var i = 0; i < 20; i++) {
                setTimeout(function() {
                    var particle = document.createElement('div');
                    var size = Math.random() * 10 + 5;
                    var x = Math.random() * window.innerWidth;
                    var y = Math.random() * window.innerHeight;
                    particle.style.cssText =
                        `position:fixed;z-index:9998;pointer-events:none;width:${size}px;height:${size}px;border-radius:50%;background:${color};left:${x}px;top:${y}px;animation:particleRise ${2 + Math.random() * 2}s ease-out forwards;opacity:0.8;`;
                    document.body.appendChild(particle);
                    setTimeout(function() { particle.remove(); }, 4000);
                }, i * 100);
            }
        }

        // ===== 控制按钮 =====
        function nextPhase() {
            if (config.isGameOver) { showToast('⚠️ 游戏已结束', 'warning'); return; }
            if (!connection) { showToast('⚠️ 未连接', 'error'); return; }
            connection.invoke('NextPhase', roomId).catch(function(err) {
                showToast('操作失败: ' + err, 'error');
            });
        }

        function skipPhase() {
            if (config.isGameOver) { showToast('⚠️ 游戏已结束', 'warning'); return; }
            if (!connection) { showToast('⚠️ 未连接', 'error'); return; }
            if (!confirm('确定要跳过当前阶段吗？')) return;
            connection.invoke('SkipPhase', roomId).catch(function(err) {
                showToast('操作失败: ' + err, 'error');
            });
        }

        function endGame() {
            if (!confirm('确定要结束本局游戏吗？')) return;
            if (!connection) { showToast('⚠️ 未连接', 'error'); return; }
            connection.invoke('EndGame', roomId).catch(function(err) {
                showToast('操作失败: ' + err, 'error');
            });
        }

        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ===== 初始化 =====
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🎮 游戏控制中心启动...');
            connectSignalR();
        });
    </script>

</body>
</html>
