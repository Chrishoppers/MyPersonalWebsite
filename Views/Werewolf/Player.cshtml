@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            overflow: hidden;
        }

        /* 粒子背景 */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* ============================================================
           主容器
           ============================================================ */
        .player-container {
            position: relative;
            z-index: 1;
            max-width: 420px;
            width: 100%;
            animation: containerIn 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @@keyframes containerIn {
            from { opacity: 0; transform: scale(0.92) translateY(30px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        /* ============================================================
           全息卡片
           ============================================================ */
        .holo-card {
            background: rgba(8, 8, 28, 0.85);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0, 240, 255, 0.08);
            border-radius: 32px;
            padding: 20px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0, 240, 255, 0.02);
            min-height: 400px;
            display: flex;
            flex-direction: column;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0, 240, 255, 0.02), transparent 60%);
            pointer-events: none;
        }

        .holo-card .border-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.15), rgba(123, 97, 255, 0.15), transparent);
            animation: borderGlow 3s ease-in-out infinite;
        }

        @@keyframes borderGlow {
            0%, 100% { opacity: 0.3; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.2); }
        }

        .holo-card .corner {
            position: absolute;
            width: 16px;
            height: 16px;
            border-color: rgba(0, 240, 255, 0.06);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }
        .holo-card .corner.tl { top: 10px; left: 10px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 10px; right: 10px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 10px; left: 10px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 10px; right: 10px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        /* ============================================================
           顶部信息
           ============================================================ */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

        .top-bar .room-code {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.08);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .top-bar .seat-number {
            font-size: 0.8rem;
            font-weight: 700;
            color: rgba(0, 240, 255, 0.3);
            font-family: 'Courier New', monospace;
        }

        .top-bar .phase-badge {
            font-size: 0.5rem;
            padding: 2px 10px;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            color: rgba(255,255,255,0.15);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* ============================================================
           身份卡片
           ============================================================ */
        .identity-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 16px 0;
            position: relative;
        }

        .identity-card .card-container {
            width: 180px;
            height: 252px;
            perspective: 800px;
            cursor: pointer;
            position: relative;
        }

        .identity-card .card-container .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            transform-style: preserve-3d;
        }

        .identity-card .card-container .card-inner.flipped {
            transform: rotateY(180deg);
        }

        .identity-card .card-container .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 0 60px rgba(139, 92, 246, 0.05);
        }

        .identity-card .card-container .card-face img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .identity-card .card-container .card-face .card-label {
            position: absolute;
            bottom: 12px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 0.6rem;
            color: rgba(255,255,255,0.05);
            letter-spacing: 0.2em;
            text-transform: uppercase;
        }

        .identity-card .card-container .card-face.back {
            transform: rotateY(180deg);
        }

        /* 翻牌提示 */
        .identity-card .flip-hint {
            margin-top: 12px;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.06);
            animation: pulse 2s ease-in-out infinite;
            letter-spacing: 0.06em;
        }

        /* ============================================================
           角色信息
           ============================================================ */
        .role-info {
            margin-top: 12px;
            padding: 12px 16px;
            background: rgba(255,255,255,0.02);
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.03);
            text-align: center;
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .role-info.show { display: block; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .role-info .role-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 2px;
        }

        .role-info .role-desc {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.2);
            line-height: 1.6;
        }

        .role-info .role-detail {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.12);
            margin-top: 4px;
            line-height: 1.6;
            white-space: pre-wrap;
            text-align: left;
            padding: 8px 12px;
            background: rgba(255,255,255,0.02);
            border-radius: 10px;
        }

        /* ============================================================
           按钮
           ============================================================ */
        .btn-actions {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        .btn-action {
            flex: 1;
            padding: 10px 14px;
            border: none;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            min-width: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-action.primary {
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
        }

        .btn-action.primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(139, 92, 246, 0.15);
        }

        .btn-action.primary:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .btn-action.secondary {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }

        .btn-action.secondary:hover:not(:disabled) {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .btn-action.success {
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
        }

        .btn-action.success:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(0, 255, 136, 0.1);
        }

        /* ============================================================
           观战模式
           ============================================================ */
        .spectator-mode {
            text-align: center;
            padding: 20px 0;
        }

        .spectator-mode .icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 8px;
            opacity: 0.3;
        }

        .spectator-mode h2 {
            font-size: 1.2rem;
            font-weight: 700;
            color: rgba(255,255,255,0.2);
        }

        .spectator-mode p {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.06);
            margin-top: 4px;
        }

        /* ============================================================
           游戏状态（白天/黑夜）
           ============================================================ */
        .game-status {
            text-align: center;
            padding: 6px 0;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.06);
            letter-spacing: 0.06em;
        }

        .game-status .night {
            color: #4facfe;
        }
        .game-status .day {
            color: #F59E0B;
        }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
            max-width: 90%;
        }

        .toast-msg {
            padding: 8px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.8rem;
            backdrop-filter: blur(20px);
            background: rgba(10, 10, 30, 0.8);
            border: 1px solid rgba(255,255,255,0.04);
            max-width: 100%;
            word-break: break-word;
        }

        .toast-msg.success { background: rgba(0, 255, 136, 0.08); border-color: rgba(0, 255, 136, 0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255, 0, 110, 0.08); border-color: rgba(255, 0, 110, 0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0, 240, 255, 0.06); border-color: rgba(0, 240, 255, 0.04); color: #00F0FF; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 480px) {
            .holo-card { padding: 14px; border-radius: 24px; min-height: 340px; }
            .holo-card .corner { width: 10px; height: 10px; }
            .identity-card .card-container { width: 140px; height: 196px; }
            .top-bar .seat-number { font-size: 0.65rem; }
            .top-bar .phase-badge { font-size: 0.4rem; padding: 1px 8px; }
            .role-info .role-name { font-size: 0.95rem; }
            .role-info .role-desc { font-size: 0.65rem; }
            .btn-action { font-size: 0.75rem; padding: 8px 10px; }
        }

        @@media (max-width: 380px) {
            .identity-card .card-container { width: 120px; height: 168px; }
            .holo-card { padding: 10px; border-radius: 20px; min-height: 300px; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>

    <!-- ============================================================
         主容器
         ============================================================ -->
    <div class="player-container">

        <div class="holo-card" id="mainCard">
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <!-- 顶部栏 -->
            <div class="top-bar">
                <span class="room-code">✦ <span id="roomDisplay">@(string.IsNullOrEmpty(roomId) ? "------" : roomId)</span></span>
                <span class="seat-number" id="seatDisplay">🪑 等待中</span>
                <span class="phase-badge" id="phaseBadge">⚙️ 准备</span>
            </div>

            <!-- ===== 身份卡片 ===== -->
            <div class="identity-card" id="identityCard">
                <div class="card-container" id="cardContainer">
                    <div class="card-inner" id="cardInner">
                        <!-- 正面（卡背） -->
                        <div class="card-face front">
                            <img src="/images/werewolf/cards/card_back.jpg" alt="卡背" id="cardBackImg" />
                            <div class="card-label">✦ 点击翻牌 ✦</div>
                        </div>
                        <!-- 背面（身份牌） -->
                        <div class="card-face back">
                            <img src="" alt="身份" id="roleCardImg" />
                            <div class="card-label" id="roleLabel">角色名称</div>
                        </div>
                    </div>
                </div>
                <div class="flip-hint" id="flipHint">👆 点击卡片查看身份</div>

                <!-- 角色信息 -->
                <div class="role-info" id="roleInfo">
                    <div class="role-name" id="roleName">角色名</div>
                    <div class="role-desc" id="roleDesc">角色描述</div>
                    <div class="role-detail" id="roleDetail">详细技能</div>
                </div>
            </div>

            <!-- ===== 观战模式 ===== -->
            <div class="spectator-mode" id="spectatorMode" style="display:none;">
                <span class="icon">👁️</span>
                <h2>观战模式</h2>
                <p>你正在观看本局游戏</p>
            </div>

            <!-- ===== 按钮 ===== -->
            <div class="btn-actions" id="btnActions">
                <button class="btn-action success" id="revealBtn" onclick="toggleReveal()">
                    🃏 查看身份
                </button>
                <button class="btn-action secondary" id="readyBtn" onclick="toggleReady()" disabled>
                    ⏳ 准备
                </button>
                <button class="btn-action secondary" id="rulesBtn" onclick="showRules()" style="flex:0.5;">
                    📖 规则
                </button>
            </div>

            <!-- 游戏状态 -->
            <div class="game-status" id="gameStatus">
                <span>✦ 等待游戏开始 ✦</span>
            </div>

        </div>

    </div>

    <!-- ============================================================
         Toast
         ============================================================ -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================
         Scripts
         ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 角色信息映射
        // ============================================================
        var roleData = {
            '狼人': {
                icon: '🐺',
                image: '/images/werewolf/cards/狼人.jpg',
                desc: '每晚可以共同杀害一名玩家',
                detail: '【技能】每晚可共同杀害一名玩家。\n【规则】所有狼人需投票统一意见。\n【自爆】白天可自爆，立即进入黑夜。'
            },
            '预言家': {
                icon: '🔮',
                image: '/images/werewolf/cards/预言家.jpg',
                desc: '每晚可以查验一名玩家的阵营',
                detail: '【技能】每晚可查验一名玩家身份（好人/狼人）。\n【规则】查验结果仅自己可见。'
            },
            '女巫': {
                icon: '🧪',
                image: '/images/werewolf/cards/女巫.jpg',
                desc: '拥有解药和毒药各一瓶',
                detail: '【技能】拥有解药和毒药各一瓶。\n【规则】解药可救人（首夜可自救），毒药可杀人。'
            },
            '守卫': {
                icon: '🛡️',
                image: '/images/werewolf/cards/守卫.jpg',
                desc: '每晚守护一名玩家免遭狼人袭击',
                detail: '【技能】每晚可守护一名玩家免受狼人袭击。\n【规则】不能连续两晚守护同一个人。\n【特殊】第一天可以守护自己。'
            },
            '猎人': {
                icon: '🔫',
                image: '/images/werewolf/cards/猎人.jpg',
                desc: '死亡时可以开枪带走一名玩家',
                detail: '【技能】死亡时可开枪带走一名玩家。\n【规则】被毒杀不能开枪。'
            },
            '白痴': {
                icon: '🤡',
                image: '/images/werewolf/cards/白痴.jpg',
                desc: '被放逐时可翻牌免死一次',
                detail: '【技能】被投票放逐时可翻牌免死一次。\n【规则】翻牌后失去投票权，但仍可发言。'
            },
            '骑士': {
                icon: '⚔️',
                image: '/images/werewolf/cards/骑士.jpg',
                desc: '白天可挑战一名玩家',
                detail: '【技能】白天可挑战一名玩家。\n【规则】若挑战目标为狼人，目标直接死亡。'
            },
            '平民': {
                icon: '👤',
                image: '/images/werewolf/cards/平民.jpg',
                desc: '无特殊技能，通过发言投票找出狼人',
                detail: '【技能】无特殊技能。\n【规则】通过发言和投票帮助好人阵营获胜。'
            }
        };

        var cardBackImage = '/images/werewolf/cards/card_back.jpg';

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            seatNumber: 0,
            playerId: null,
            nickname: '',
            avatar: '🧑',
            isReady: false,
            isRevealed: false,
            role: null,
            isSpectator: false,
            isGameStarted: false,
            phase: 'waiting' // waiting | night | day | speech | voting
        };

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // ===== 收到身份 =====
                connection.on('ReceiveRole', function(data) {
                    console.log('📩 收到身份:', data);
                    state.role = data.role;
                    state.seatNumber = data.seatNumber;
                    state.isSpectator = data.isSpectator || false;

                    document.getElementById('seatDisplay').textContent = '🪑 ' + data.seatNumber + ' 号';

                    if (state.isSpectator) {
                        document.getElementById('identityCard').style.display = 'none';
                        document.getElementById('spectatorMode').style.display = 'block';
                        document.getElementById('readyBtn').disabled = true;
                        document.getElementById('revealBtn').disabled = true;
                        showToast('👁️ 你已进入观战模式', 'info');
                        return;
                    }

                    // 显示身份卡
                    var roleImg = document.getElementById('roleCardImg');
                    var roleLabel = document.getElementById('roleLabel');
                    var roleInfo = roleData[data.role];

                    if (roleInfo) {
                        roleImg.src = roleInfo.image;
                        roleLabel.textContent = data.role + ' ' + roleInfo.icon;
                    } else {
                        roleImg.src = '/images/werewolf/cards/平民.jpg';
                        roleLabel.textContent = data.role;
                    }

                    // 启用按钮
                    document.getElementById('readyBtn').disabled = false;
                    document.getElementById('readyBtn').textContent = '⏳ 准备';
                    document.getElementById('readyBtn').classList.remove('is-ready');

                    showToast('📩 你抽到了 ' + data.role, 'info');

                    // 游戏已开始
                    state.isGameStarted = true;
                    document.getElementById('phaseBadge').textContent = '🎮 游戏中';
                });

                // ===== 游戏状态更新 =====
                connection.on('GamePhaseUpdate', function(data) {
                    console.log('🔄 游戏阶段:', data);
                    state.phase = data.phase;
                    updatePhaseDisplay(data);
                });

                // ===== 玩家准备状态 =====
                connection.on('PlayerReadyUpdate', function(data) {
                    // 更新UI
                });

                // ===== 语音播报 =====
                connection.on('VoiceAnnounce', function(message, importance) {
                    playVoiceAnnounce(message, importance);
                });

                // ===== 开始连接 =====
                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        // 加入房间
                        joinRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 加入房间
        // ============================================================
        function joinRoom() {
            if (!state.roomId || state.roomId === '------') {
                showToast('❌ 无效的房间码', 'error');
                return;
            }

            var nickname = prompt('请输入你的昵称：', '玩家' + Math.floor(Math.random() * 100));
            if (!nickname || nickname.trim() === '') {
                nickname = '玩家' + Math.floor(Math.random() * 100);
            }
            state.nickname = nickname.trim();

            // 选择头像
            var avatars = ['🧑', '👩', '👨', '🦸', '🧙', '🧚', '🤖', '👾', '🦊', '🐺'];
            var avatarIndex = Math.floor(Math.random() * avatars.length);
            state.avatar = avatars[avatarIndex];

            connection.invoke('JoinGame', state.roomId, state.nickname, state.avatar)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.seatNumber = result.seatNumber;
                        document.getElementById('seatDisplay').textContent = '🪑 ' + result.seatNumber + ' 号';
                        document.getElementById('roomDisplay').textContent = state.roomId;
                        showToast('✅ 已加入房间，你是 ' + result.seatNumber + ' 号', 'success');
                    } else if (result && !result.success) {
                        // 可能是观战
                        if (result.isSpectator) {
                            state.isSpectator = true;
                            document.getElementById('identityCard').style.display = 'none';
                            document.getElementById('spectatorMode').style.display = 'block';
                            document.getElementById('readyBtn').disabled = true;
                            document.getElementById('revealBtn').disabled = true;
                            showToast('👁️ 座位已满，你进入观战模式', 'info');
                        } else {
                            showToast('❌ ' + result.message, 'error');
                        }
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 翻牌
        // ============================================================
        function toggleReveal() {
            var inner = document.getElementById('cardInner');
            var hint = document.getElementById('flipHint');
            var btn = document.getElementById('revealBtn');

            state.isRevealed = !state.isRevealed;

            if (state.isRevealed) {
                inner.classList.add('flipped');
                hint.textContent = '🔄 点击翻回卡背';
                btn.textContent = '🔒 隐藏身份';

                // 显示角色信息
                var roleInfo = document.getElementById('roleInfo');
                var roleName = document.getElementById('roleName');
                var roleDesc = document.getElementById('roleDesc');
                var roleDetail = document.getElementById('roleDetail');

                var data = roleData[state.role];
                if (data) {
                    roleName.textContent = data.icon + ' ' + state.role;
                    roleDesc.textContent = data.desc;
                    roleDetail.textContent = data.detail;
                } else {
                    roleName.textContent = state.role;
                    roleDesc.textContent = '查看身份';
                    roleDetail.textContent = '暂无详细说明';
                }
                roleInfo.classList.add('show');

                // 语音播报（第一次翻牌时）
                if (!state._hasAnnounced) {
                    state._hasAnnounced = true;
                    announceRole(state.role);
                }

            } else {
                inner.classList.remove('flipped');
                hint.textContent = '👆 点击卡片查看身份';
                btn.textContent = '🃏 查看身份';
                document.getElementById('roleInfo').classList.remove('show');
            }
        }

        // ============================================================
        // 语音播报（TTS）
        // ============================================================
        function announceRole(role) {
            var text = '你是 ' + role;
            var data = roleData[role];
            if (data) {
                text += '，' + data.desc;
            }
            speakText(text);
        }

        function speakText(text) {
            if (!window.speechSynthesis) {
                console.warn('TTS 不可用');
                return;
            }

            // 取消之前的语音
            window.speechSynthesis.cancel();

            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'zh-CN';
            utterance.rate = 0.9;
            utterance.pitch = 1.1;
            utterance.volume = 1;

            // 选择中文语音
            var voices = window.speechSynthesis.getVoices();
            var zhVoice = voices.find(function(v) { return v.lang.startsWith('zh'); });
            if (zhVoice) utterance.voice = zhVoice;

            window.speechSynthesis.speak(utterance);
        }

        // ============================================================
        // 语音播报（游戏内）
        // ============================================================
        function playVoiceAnnounce(message, importance) {
            if (importance === 'high') {
                // 重要内容播放两遍
                speakText(message);
                setTimeout(function() {
                    speakText(message);
                }, 2000);
            } else {
                speakText(message);
            }

            // 显示在状态栏
            document.getElementById('gameStatus').innerHTML = '<span style="color:rgba(255,255,255,0.3);">🔊 ' + message +
                '</span>';
        }

        // ============================================================
        // 准备
        // ============================================================
        function toggleReady() {
            if (!connection || !state.playerId) {
                showToast('⚠️ 未加入房间', 'warning');
                return;
            }

            state.isReady = !state.isReady;
            var btn = document.getElementById('readyBtn');

            if (state.isReady) {
                btn.textContent = '✅ 已准备';
                btn.classList.add('is-ready');
                btn.style.color = '#00FF88';
                btn.style.borderColor = 'rgba(0,255,136,0.06)';
                showToast('✅ 已准备，等待其他玩家...', 'success');
            } else {
                btn.textContent = '⏳ 准备';
                btn.classList.remove('is-ready');
                btn.style.color = '';
                btn.style.borderColor = '';
                showToast('⏳ 已取消准备', 'info');
            }

            connection.invoke('ToggleReady', state.playerId, state.isReady)
                .catch(function(err) {
                    console.error('切换准备状态失败:', err);
                    showToast('操作失败', 'error');
                    state.isReady = !state.isReady;
                });
        }

        // ============================================================
        // 更新阶段显示
        // ============================================================
        function updatePhaseDisplay(data) {
            var badge = document.getElementById('phaseBadge');
            var status = document.getElementById('gameStatus');

            switch (data.phase) {
                case 'night':
                    badge.textContent = '🌙 夜晚';
                    badge.style.color = '#4facfe';
                    status.innerHTML = '<span style="color:#4facfe;">🌙 天黑了，请闭眼...</span>';
                    break;
                case 'day':
                    badge.textContent = '☀️ 白天';
                    badge.style.color = '#F59E0B';
                    status.innerHTML = '<span style="color:#F59E0B;">☀️ 天亮了！</span>';
                    break;
                case 'speech':
                    badge.textContent = '📢 发言';
                    badge.style.color = '#8B5CF6';
                    status.innerHTML = '<span style="color:rgba(255,255,255,0.3);">📢 ' + data.speaker + ' 号正在发言</span>';
                    break;
                case 'voting':
                    badge.textContent = '🗳️ 投票';
                    badge.style.color = '#EC4899';
                    status.innerHTML = '<span style="color:#EC4899;">🗳️ 投票阶段</span>';
                    break;
                default:
                    badge.textContent = '🎮 游戏中';
                    badge.style.color = 'rgba(255,255,255,0.15)';
                    status.innerHTML = '<span>✦ 等待指令 ✦</span>';
            }
        }

        // ============================================================
        // 显示规则
        // ============================================================
        function showRules() {
            // 弹出规则弹窗（可以复用之前的规则页面）
            window.open('/Werewolf/Rules?roomId=' + state.roomId, '_blank', 'width=480,height=700');
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(50, Math.floor(window.innerWidth / 10));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.1,
                    vy: (Math.random() - 0.5) * 0.1,
                    r: Math.random() * 1 + 0.3,
                    o: Math.random() * 0.1 + 0.02
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀玩家端启动...');
            // 预加载语音
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = function() {
                    window.speechSynthesis.getVoices();
                };
            }
            connectSignalR();
        });
    </script>

</body>
</html>
