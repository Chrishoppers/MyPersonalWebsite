@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            overflow: hidden;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* ============================================================
           主容器
           ============================================================ */
        .player-container {
            position: relative;
            z-index: 1;
            max-width: 440px;
            width: 100%;
            animation: containerIn 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @@keyframes containerIn {
            from { opacity: 0; transform: scale(0.92) translateY(30px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        /* ============================================================
           全息卡片
           ============================================================ */
        .holo-card {
            background: rgba(8, 8, 28, 0.88);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0, 240, 255, 0.08);
            border-radius: 28px;
            padding: 18px 16px 20px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0, 240, 255, 0.02);
            min-height: 420px;
            display: flex;
            flex-direction: column;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0, 240, 255, 0.02), transparent 60%);
            pointer-events: none;
        }

        .holo-card .border-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.15), rgba(123, 97, 255, 0.15), transparent);
            animation: borderGlow 3s ease-in-out infinite;
        }

        @@keyframes borderGlow {
            0%, 100% { opacity: 0.3; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.2); }
        }

        .holo-card .corner {
            position: absolute;
            width: 14px;
            height: 14px;
            border-color: rgba(0, 240, 255, 0.06);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }
        .holo-card .corner.tl { top: 8px; left: 8px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 8px; right: 8px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 8px; left: 8px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        /* ============================================================
           顶部栏
           ============================================================ */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
        }

        .top-bar .room-code {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.06);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .top-bar .seat-number {
            font-size: 0.75rem;
            font-weight: 700;
            color: rgba(0, 240, 255, 0.3);
            font-family: 'Courier New', monospace;
        }

        .top-bar .phase-badge {
            font-size: 0.45rem;
            padding: 2px 10px;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            border: 1px solid rgba(0, 240, 255, 0.04);
            color: rgba(255,255,255,0.15);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* ============================================================
           游戏状态
           ============================================================ */
        .game-status {
            text-align: center;
            padding: 6px 0 10px;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.06);
            letter-spacing: 0.06em;
            flex-shrink: 0;
        }

        .game-status .night { color: #4facfe; }
        .game-status .day { color: #F59E0B; }
        .game-status .action { color: #8B5CF6; }

        /* ============================================================
           身份卡片
           ============================================================ */
        .identity-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px 0;
            position: relative;
        }

        .identity-card .card-container {
            width: 140px;
            height: 196px;
            perspective: 800px;
            cursor: pointer;
            position: relative;
        }

        .identity-card .card-container .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            transform-style: preserve-3d;
        }

        .identity-card .card-container .card-inner.flipped {
            transform: rotateY(180deg);
        }

        .identity-card .card-container .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 0 60px rgba(139, 92, 246, 0.05);
        }

        .identity-card .card-container .card-face img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .identity-card .card-container .card-face .card-label {
            position: absolute;
            bottom: 8px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 0.5rem;
            color: rgba(255,255,255,0.05);
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .identity-card .card-container .card-face.back {
            transform: rotateY(180deg);
        }

        .identity-card .flip-hint {
            margin-top: 8px;
            font-size: 0.6rem;
            color: rgba(255,255,255,0.06);
            animation: pulse 2s ease-in-out infinite;
            letter-spacing: 0.06em;
        }

        /* ============================================================
           角色信息
           ============================================================ */
        .role-info {
            margin-top: 8px;
            padding: 10px 14px;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.03);
            text-align: center;
            display: none;
            animation: fadeIn 0.5s ease;
            width: 100%;
        }

        .role-info.show { display: block; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .role-info .role-name {
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 2px;
        }

        .role-info .role-desc {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.2);
            line-height: 1.6;
        }

        .role-info .role-detail {
            font-size: 0.65rem;
            color: rgba(255,255,255,0.12);
            margin-top: 4px;
            line-height: 1.6;
            white-space: pre-wrap;
            text-align: left;
            padding: 6px 10px;
            background: rgba(255,255,255,0.02);
            border-radius: 8px;
        }

        /* ============================================================
           观战模式
           ============================================================ */
        .spectator-mode {
            text-align: center;
            padding: 30px 0;
        }

        .spectator-mode .icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 8px;
            opacity: 0.3;
        }

        .spectator-mode h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: rgba(255,255,255,0.15);
        }

        .spectator-mode p {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.06);
            margin-top: 4px;
        }

        /* ============================================================
           ⭐ 行动面板（各角色专用）
           ============================================================ */
        .action-panel {
            display: none;
            width: 100%;
            margin-top: 4px;
            animation: fadeIn 0.5s ease;
        }

        .action-panel.show { display: block; }

        .action-panel .action-title {
            font-size: 0.7rem;
            font-weight: 600;
            color: rgba(255,255,255,0.15);
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: 0.06em;
        }

        .action-panel .action-title .highlight { color: #8B5CF6; }

        /* 目标选择网格 */
        .target-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin: 4px 0 8px;
        }

        .target-btn {
            padding: 8px 4px;
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 12px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            text-align: center;
        }

        .target-btn:hover:not(:disabled) {
            border-color: rgba(139,92,246,0.12);
            background: rgba(139,92,246,0.04);
            color: #fff;
        }

        .target-btn:disabled {
            opacity: 0.2;
            cursor: not-allowed;
        }

        .target-btn .sub {
            display: block;
            font-size: 0.45rem;
            font-weight: 400;
            color: rgba(255,255,255,0.04);
            margin-top: 2px;
        }

        .target-btn.selected {
            border-color: #8B5CF6;
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
            box-shadow: 0 0 40px rgba(139,92,246,0.02);
        }

        .target-btn .status-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-left: 2px;
        }
        .target-btn .status-dot.alive { background: #00FF88; }
        .target-btn .status-dot.dead { background: #dc3545; }

        /* 行动按钮 */
        .action-btns {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .action-btns .btn-action {
            flex: 1;
            padding: 8px 10px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .action-btns .btn-action.primary {
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
        }

        .action-btns .btn-action.primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(139,92,246,0.1);
        }

        .action-btns .btn-action.secondary {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }

        .action-btns .btn-action.secondary:hover:not(:disabled) {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .action-btns .btn-action:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }

        .action-btns .btn-action.success {
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
        }

        .action-btns .btn-action.danger {
            background: rgba(255, 0, 110, 0.08);
            border: 1px solid rgba(255, 0, 110, 0.04);
            color: rgba(255, 0, 110, 0.3);
        }

        .action-btns .btn-action.danger:hover:not(:disabled) {
            background: rgba(255, 0, 110, 0.12);
        }

        /* 狼人投票状态 */
        .wolf-vote-status {
            text-align: center;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.06);
            margin: 4px 0;
        }

        .wolf-vote-status .progress {
            color: #dc3545;
            font-weight: 600;
        }

        /* 查验结果 */
        .check-result {
            margin: 6px 0;
            padding: 8px 14px;
            border-radius: 12px;
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .check-result.show { display: block; }
        .check-result.werewolf { background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.06); color: #dc3545; }
        .check-result.good { background: rgba(0,255,136,0.08); border: 1px solid rgba(0,255,136,0.06); color: #00FF88; }

        /* 投票结果 */
        .vote-result {
            margin: 6px 0;
            padding: 8px 14px;
            border-radius: 12px;
            text-align: center;
            font-size: 0.8rem;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.15);
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .vote-result.show { display: block; }

        /* ============================================================
           底部按钮
           ============================================================ */
        .bottom-actions {
            display: flex;
            gap: 6px;
            margin-top: 8px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        .bottom-actions .btn-bottom {
            flex: 1;
            padding: 8px 10px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .bottom-actions .btn-bottom.primary {
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
        }

        .bottom-actions .btn-bottom.primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(139,92,246,0.1);
        }

        .bottom-actions .btn-bottom.secondary {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }

        .bottom-actions .btn-bottom.secondary:hover:not(:disabled) {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .bottom-actions .btn-bottom.success {
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
        }

        .bottom-actions .btn-bottom:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }

        .bottom-actions .btn-bottom .badge {
            font-size: 0.5rem;
            background: rgba(255,255,255,0.04);
            padding: 0 6px;
            border-radius: 10px;
            color: rgba(255,255,255,0.2);
        }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 16px;
            right: 16px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
            max-width: 90%;
        }

        .toast-msg {
            padding: 6px 16px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10, 10, 30, 0.8);
            border: 1px solid rgba(255,255,255,0.04);
            max-width: 100%;
            word-break: break-word;
        }

        .toast-msg.success { background: rgba(0, 255, 136, 0.08); border-color: rgba(0, 255, 136, 0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255, 0, 110, 0.08); border-color: rgba(255, 0, 110, 0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0, 240, 255, 0.06); border-color: rgba(0, 240, 255, 0.04); color: #00F0FF; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(16px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 480px) {
            .holo-card { padding: 12px 10px 14px; border-radius: 24px; min-height: 360px; }
            .holo-card .corner { width: 10px; height: 10px; }
            .identity-card .card-container { width: 120px; height: 168px; }
            .top-bar .seat-number { font-size: 0.65rem; }
            .target-grid { grid-template-columns: repeat(4, 1fr); gap: 4px; }
            .target-btn { font-size: 0.7rem; padding: 6px 2px; }
            .action-btns .btn-action { font-size: 0.65rem; padding: 6px 8px; }
            .bottom-actions .btn-bottom { font-size: 0.65rem; padding: 6px 8px; }
            .role-info .role-name { font-size: 0.85rem; }
            .role-info .role-desc { font-size: 0.6rem; }
        }

        @@media (max-width: 380px) {
            .identity-card .card-container { width: 100px; height: 140px; }
            .holo-card { padding: 8px 6px 10px; border-radius: 20px; min-height: 320px; }
            .target-grid { grid-template-columns: repeat(4, 1fr); gap: 3px; }
            .target-btn { font-size: 0.6rem; padding: 4px 2px; border-radius: 8px; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>

    <!-- ============================================================
         主容器
         ============================================================ -->
    <div class="player-container">

        <div class="holo-card" id="mainCard">
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <!-- 顶部栏 -->
            <div class="top-bar">
                <span class="room-code">✦ <span id="roomDisplay">@(string.IsNullOrEmpty(roomId) ? "------" : roomId)</span></span>
                <span class="seat-number" id="seatDisplay">🪑 等待中</span>
                <span class="phase-badge" id="phaseBadge">⚙️ 准备</span>
            </div>

            <!-- 游戏状态 -->
            <div class="game-status" id="gameStatus">
                <span>✦ 等待游戏开始 ✦</span>
            </div>

            <!-- ===== 身份卡片 ===== -->
            <div class="identity-card" id="identityCard">
                <div class="card-container" id="cardContainer">
                    <div class="card-inner" id="cardInner">
                        <div class="card-face front">
                            <img src="/images/werewolf/cards/card_back.jpg" alt="卡背" id="cardBackImg" />
                            <div class="card-label">✦ 点击翻牌 ✦</div>
                        </div>
                        <div class="card-face back">
                            <img src="" alt="身份" id="roleCardImg" />
                            <div class="card-label" id="roleLabel">角色名称</div>
                        </div>
                    </div>
                </div>
                <div class="flip-hint" id="flipHint">👆 点击卡片查看身份</div>

                <!-- 角色信息 -->
                <div class="role-info" id="roleInfo">
                    <div class="role-name" id="roleName">角色名</div>
                    <div class="role-desc" id="roleDesc">角色描述</div>
                    <div class="role-detail" id="roleDetail">详细技能</div>
                </div>
            </div>

            <!-- ===== 观战模式 ===== -->
            <div class="spectator-mode" id="spectatorMode" style="display:none;">
                <span class="icon">👁️</span>
                <h2>观战模式</h2>
                <p>你正在观看本局游戏</p>
            </div>

            <!-- ===== ⭐ 行动面板（各角色专用） ===== -->
            <div class="action-panel" id="actionPanel">
                <div class="action-title" id="actionTitle">⏳ 等待行动...</div>

                <!-- 目标选择网格 -->
                <div class="target-grid" id="targetGrid"></div>

                <!-- 查验结果 -->
                <div class="check-result" id="checkResult"></div>

                <!-- 投票结果 -->
                <div class="vote-result" id="voteResult"></div>

                <!-- 狼人投票状态 -->
                <div class="wolf-vote-status" id="wolfVoteStatus" style="display:none;">
                    已投票 <span class="progress" id="wolfVotedCount">0</span>/<span id="wolfTotalCount">0</span>
                </div>

                <!-- 行动按钮 -->
                <div class="action-btns" id="actionBtns">
                    <button class="btn-action primary" id="actionConfirmBtn" onclick="confirmAction()">✅ 确认</button>
                    <button class="btn-action secondary" onclick="cancelAction()">✕ 取消</button>
                </div>
            </div>

            <!-- ===== 底部按钮 ===== -->
            <div class="bottom-actions" id="bottomActions">
                <button class="btn-bottom primary" id="revealBtn" onclick="toggleReveal()">
                    🃏 查看身份
                </button>
                <button class="btn-bottom secondary" id="readyBtn" onclick="toggleReady()" disabled>
                    ⏳ 准备
                </button>
                <button class="btn-bottom secondary" onclick="showRules()" style="flex:0.5;">
                    📖 规则
                </button>
            </div>

        </div>

    </div>

    <!-- ============================================================
         Toast
         ============================================================ -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================
         Scripts
         ============================================================ -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 角色信息映射
        // ============================================================
        var roleData = {
            '狼人': {
                icon: '🐺',
                image: '/images/werewolf/cards/狼人.jpg',
                desc: '每晚可以共同杀害一名玩家',
