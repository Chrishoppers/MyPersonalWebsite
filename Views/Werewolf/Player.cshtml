@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀 · 座位图";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString() ?? "";
    var username = Context.Session.GetString("Username") ?? "管理员";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀 · 座位图</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #05050F;
            font-family: 'Inter', sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            padding: 16px;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .container {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 1rem 1.5rem 1.5rem;
        }

        /* ===== 3D粒子 ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* 头部 */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 1.5rem;
            border-radius: 20px;
            background: rgba(10, 10, 30, 0.4);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.8rem;
            box-shadow: 0 8px 60px rgba(0, 0, 0, 0.3);
        }

        .header .brand { display: flex; align-items: center; gap: 12px; }
        .header .brand .icon { font-size: 2rem; animation: wolfPulse 2s ease-in-out infinite; }
        @@keyframes wolfPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
        .header .brand h1 {
            font-size: 1.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header .brand .sub { font-size: 0.5rem; color: rgba(255,255,255,0.06); letter-spacing: 0.15em; text-transform: uppercase; display: block; margin-top: -2px; }

        .header .status-group { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .header .room-badge {
            padding: 4px 16px;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255, 0.2);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .header .user-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px 4px 8px;
            border-radius: 40px;
            background: rgba(139, 92, 246, 0.04);
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-size: 0.75rem;
            color: rgba(255,255,255,0.3);
        }

        .header .user-badge .avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            font-weight: 700;
            color: #fff;
        }

        .header .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00FF88;
            animation: pulse 2s infinite;
            margin-right: 4px;
        }

        /* 主布局 */
        .main-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 20px;
            padding: 1rem 0;
            min-height: 0;
        }

        @@media (max-width: 1024px) { .main-grid { grid-template-columns: 1fr; gap: 16px; } }

        /* 座位图区域 */
        .seating-area {
            background: rgba(255,255,255,0.015);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .seating-area .area-title {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.08);
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .seating-area .area-title .count {
            color: #00F0FF;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .table-container {
            position: relative;
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            flex: 1;
            aspect-ratio: 1 / 0.9;
        }

        .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30,20,60,0.2), rgba(10,10,30,0.4));
            border: 2px solid rgba(139, 92, 246, 0.03);
            box-shadow: 0 0 80px rgba(139, 92, 246, 0.02), inset 0 0 80px rgba(0,0,0,0.2);
        }

        .table-pattern {
            position: absolute;
            inset: 15%;
            border-radius: 50%;
            background-image: repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,255,255,0.005) 5deg, transparent 10deg);
            opacity: 0.3;
            pointer-events: none;
        }

        .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .table-center .icon { font-size: 2rem; opacity: 0.08; display: block; }
        .table-center .label { font-size: 0.45rem; color: rgba(255,255,255,0.01); text-transform: uppercase; letter-spacing: 0.2em; }

        /* 座位 */
        .seat {
            position: absolute;
            width: clamp(44px, 5.5vw, 64px);
            height: clamp(44px, 5.5vw, 64px);
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
            user-select: none;
        }

        .seat .seat-number {
            font-size: clamp(0.6rem, 0.7vw, 0.9rem);
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: rgba(255,255,255,0.06);
            transition: all 0.3s ease;
        }

        .seat .seat-name {
            font-size: clamp(0.3rem, 0.4vw, 0.5rem);
            font-weight: 500;
            color: rgba(255,255,255,0.03);
            max-width: 44px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .seat .seat-emoji { font-size: clamp(0.7rem, 0.9vw, 1.1rem); display: none; }

        .seat.empty { border-color: rgba(255,255,255,0.03); background: rgba(255,255,255,0.01); }
        .seat.empty:hover {
            border-color: rgba(0, 240, 255, 0.15);
            background: rgba(0, 240, 255, 0.03);
            transform: translate(-50%, -50%) scale(1.1);
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.03);
        }

        .seat.occupied { border-color: rgba(0, 240, 255, 0.08); background: rgba(0, 240, 255, 0.02); }
        .seat.occupied .seat-number { color: rgba(0, 240, 255, 0.15); }
        .seat.occupied .seat-name { color: rgba(255,255,255,0.08); }

        .seat.occupied:hover {
            border-color: rgba(245, 158, 11, 0.15);
            background: rgba(245, 158, 11, 0.02);
            transform: translate(-50%, -50%) scale(1.08);
            box-shadow: 0 0 40px rgba(245, 158, 11, 0.02);
        }

        .seat.self {
            border-color: rgba(0, 240, 255, 0.15);
            background: rgba(0, 240, 255, 0.04);
            box-shadow: 0 0 50px rgba(0, 240, 255, 0.03);
        }
        .seat.self .seat-number { color: #00F0FF; }
        .seat.self .seat-name { color: rgba(255,255,255,0.15); }

        .seat.ready { border-color: rgba(0, 255, 136, 0.12); background: rgba(0, 255, 136, 0.02); box-shadow: 0 0 40px rgba(0, 255, 136, 0.02); }
        .seat.ready .seat-number { color: #00FF88; }

        .seat.swap-request { border-color: #F59E0B; animation: swapPulse 1s ease-in-out infinite; box-shadow: 0 0 60px rgba(245, 158, 11, 0.05); }
        @@keyframes swapPulse { 0%, 100% { border-color: #F59E0B; box-shadow: 0 0 20px rgba(245, 158, 11, 0.02); } 50% { border-color: #F59E0B; box-shadow: 0 0 60px rgba(245, 158, 11, 0.08); } }

        .seat.host { border-color: rgba(139, 92, 246, 0.12); }
        .seat.host .seat-number { color: #8B5CF6; }

        .seat.ai { border-color: rgba(0, 240, 255, 0.08); background: rgba(0, 240, 255, 0.02); animation: aiSeatPulse 2s ease-in-out infinite; }
        @@keyframes aiSeatPulse { 0%, 100% { box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } 50% { box-shadow: 0 0 40px rgba(0, 240, 255, 0.05); } }

        @@media (max-width: 640px) {
            .seat { width: 32px; height: 32px; }
            .seat .seat-number { font-size: 0.4rem; }
            .seat .seat-name { display: none; }
            .seat .seat-emoji { display: block; font-size: 0.7rem; }
        }

        @@media (max-width: 480px) {
            .seat { width: 26px; height: 26px; border-width: 1.5px; }
            .seat .seat-number { font-size: 0.35rem; }
            .seat .seat-emoji { font-size: 0.6rem; }
            .seating-area { padding: 0.8rem; }
        }

        /* 右侧面板 */
        .holo-card {
            background: rgba(255,255,255,0.015);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(139, 92, 246, 0.01), transparent 70%);
            pointer-events: none;
        }

        .holo-card .card-title {
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255,255,255,0.08);
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .holo-card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent); }

        .player-list {
            overflow-y: auto;
            max-height: 280px;
            padding-right: 4px;
        }

        .player-list::-webkit-scrollbar { width: 3px; }
        .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .player-list::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.08); border-radius: 10px; }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.4rem 0.6rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.3s ease;
            margin-bottom: 4px;
        }

        .player-item:hover { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); }

        .player-item .avatar { font-size: 1rem; width: 28px; text-align: center; flex-shrink: 0; }
        .player-item .info { flex: 1; min-width: 0; }
        .player-item .info .name {
            color: rgba(255,255,255,0.3);
            font-size: 0.75rem;
            font-weight: 500;
        }
        .player-item .info .name .ai-tag {
            font-size: 0.4rem;
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            color: #00F0FF;
            border: 1px solid rgba(0, 240, 255, 0.02);
            font-weight: 600;
            animation: aiGlow 2s ease-in-out infinite;
        }
        @@keyframes aiGlow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } }
        .player-item .info .name .me { color: rgba(139, 92, 246, 0.3); font-size: 0.45rem; margin-left: 4px; }
        .player-item .info .name .seat-tag { color: rgba(0, 240, 255, 0.2); font-size: 0.5rem; font-family: 'Courier New', monospace; margin-left: 4px; }

        .player-item .status {
            font-size: 0.45rem;
            font-weight: 600;
            padding: 1px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .player-item .status.ready { background: rgba(0,255,136,0.06); color: #00FF88; border: 1px solid rgba(0,255,136,0.03); }
        .player-item .status.waiting { background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.02); }
        .player-item .status.host { background: rgba(139, 92, 246, 0.06); color: #8B5CF6; border: 1px solid rgba(139, 92, 246, 0.03); }
        .player-item .status.ai { background: rgba(0, 240, 255, 0.04); color: #00F0FF; border: 1px solid rgba(0, 240, 255, 0.02); }

        .player-empty {
            color: rgba(255,255,255,0.02);
            font-size: 0.7rem;
            text-align: center;
            padding: 1rem 0;
            letter-spacing: 0.06em;
        }

        .host-actions {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            align-items: center;
            padding-top: 0.8rem;
            border-top: 1px solid rgba(255,255,255,0.02);
        }

        .btn-primary {
            padding: 0.6rem 2rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 0 40px rgba(139, 92, 246, 0.02);
        }

        .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 60px rgba(139, 92, 246, 0.1); }
        .btn-primary:disabled { opacity: 0.2; cursor: not-allowed; transform: none !important; }

        .btn-secondary {
            padding: 0.6rem 1.5rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.15);
            font-weight: 500;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-secondary:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); }

        .btn-bot {
            padding: 0.6rem 1.5rem;
            border: 1px solid rgba(245,158,11,0.04);
            border-radius: 40px;
            background: rgba(245,158,11,0.02);
            color: rgba(245,158,11,0.15);
            font-weight: 500;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-bot:hover { background: rgba(245,158,11,0.04); color: #F59E0B; }

        .host-actions .status-text {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.04);
            margin-left: auto;
        }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 6px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        /* 换座弹窗 */
        .swap-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(20px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            animation: modalFadeIn 0.3s ease;
        }
        .swap-modal-overlay.active { display: flex; }
        @@keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

        .swap-modal {
            background: rgba(16, 16, 30, 0.98);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            max-width: 420px;
            width: 100%;
            padding: 2rem;
            box-shadow: 0 32px 120px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .swap-modal .modal-icon { font-size: 3rem; margin-bottom: 0.3rem; }
        .swap-modal h3 { color: #F59E0B; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.3rem; }
        .swap-modal p { color: rgba(255,255,255,0.3); font-size: 0.9rem; margin-bottom: 1.2rem; line-height: 1.6; }
        .swap-modal .player-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            padding: 0.8rem;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            margin-bottom: 1.2rem;
        }
        .swap-modal .player-info .avatar { font-size: 1.8rem; }
        .swap-modal .player-info .name { color: #fff; font-weight: 600; font-size: 1rem; }
        .swap-modal .player-info .seat { color: rgba(0,240,255,0.3); font-size: 0.8rem; font-family: 'Courier New', monospace; }

        .swap-modal .btn-group { display: flex; gap: 0.8rem; flex-wrap: wrap; }
        .swap-modal .btn-group .btn-swap {
            flex: 1;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 80px;
        }
        .swap-modal .btn-group .btn-swap.accept { background: linear-gradient(135deg, #00FF88, #00F0FF); color: #05050F; }
        .swap-modal .btn-group .btn-swap.accept:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(0,255,136,0.1); }
        .swap-modal .btn-group .btn-swap.reject { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.2); }
        .swap-modal .btn-group .btn-swap.reject:hover { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.4); }

        @@media (max-width: 768px) {
            .container { padding: 0.5rem 0.8rem 1rem; }
            .header .brand h1 { font-size: 1rem; }
            .header .room-badge { font-size: 0.55rem; padding: 2px 10px; }
            .holo-card { padding: 1rem; }
            .host-actions { flex-direction: column; align-items: stretch; }
            .host-actions .status-text { text-align: center; margin-left: 0; }
            .btn-primary, .btn-secondary, .btn-bot { justify-content: center; }
            .swap-modal { padding: 1.2rem; }
        }

        @@media (max-width: 480px) {
            .header .brand .icon { font-size: 1.4rem; }
            .header .brand h1 { font-size: 0.85rem; }
            .swap-modal .player-info .avatar { font-size: 1.4rem; }
            .swap-modal h3 { font-size: 1rem; }
        }
    </style>
</head>
<body>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>

    <div class="container">

        <!-- 头部 -->
        <div class="header">
            <div class="brand">
                <span class="icon">🐺</span>
                <div>
                    <h1>狼人杀 · 座位图</h1>
                    <span class="sub">✦ 点击空位坐下 · 点击玩家换座 ✦</span>
                </div>
            </div>
            <div class="status-group">
                <span class="room-badge">✦ 房间 <span id="roomDisplay">@roomId</span></span>
                <span class="user-badge">
                    <span class="avatar">@(username?.FirstOrDefault().ToString().ToUpper() ?? "A")</span>
                    <span>@username</span>
                </span>
                <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);">
                    <span class="status-dot"></span> 在线
                </span>
            </div>
        </div>

        <!-- 主网格 -->
        <div class="main-grid">

            <!-- 座位图 -->
            <div class="seating-area">
                <div class="area-title">
                    🪑 座位图
                    <span class="count" id="seatCount">0/12 已占</span>
                    <span class="hint" style="font-size:0.5rem;color:rgba(255,255,255,0.04);margin-left:auto;letter-spacing:0.06em;">👆 点击交互</span>
                </div>
                <div class="table-container" id="tableContainer">
                    <div class="table-bg"></div>
                    <div class="table-pattern"></div>
                    <div class="table-center">
                        <span class="icon">🐺</span>
                        <span class="label">狼人杀</span>
                    </div>
                    <div id="seatsContainer"></div>
                </div>
            </div>

            <!-- 右侧面板 -->
            <div class="side-panel" style="display:flex;flex-direction:column;gap:16px;height:100%;">

                <!-- 玩家列表 -->
                <div class="holo-card" style="flex:1;min-height:0;">
                    <div class="card-title">
                        👥 玩家列表
                        <span class="accent"></span>
                        <span class="badge-count" style="font-size:0.5rem;padding:0.1rem 0.6rem;border-radius:20px;background:rgba(139,92,246,0.04);color:rgba(255,255,255,0.1);border:1px solid rgba(139,92,246,0.02);" id="playerCountBadge">0 人</span>
                    </div>

                    <div class="player-list" id="playerList">
                        <div class="player-empty">✦ 等待玩家接入 ✦</div>
                    </div>
                </div>

                <!-- 控制栏 -->
                <div class="holo-card" style="flex:0.6;">
                    <div class="card-title">
                        🎮 控制
                        <span class="accent"></span>
                    </div>

                    <div class="host-actions">
                        <button class="btn-primary" id="startBtn" onclick="startGame()" disabled>
                            🃏 洗牌发牌
                        </button>
                        <button class="btn-secondary" onclick="refreshRoom()">🔄 刷新</button>
                        <button class="btn-bot" onclick="addBots(3)">🤖 +3机器人</button>
                        <span class="status-text" id="actionStatus">● 等待玩家就坐</span>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- 换座弹窗 -->
    <div class="swap-modal-overlay" id="swapModal">
        <div class="swap-modal">
            <div class="modal-icon">🔄</div>
            <h3 id="swapModalTitle">换座请求</h3>
            <p id="swapModalDesc">玩家想和你交换座位</p>
            <div class="player-info" id="swapPlayerInfo">
                <span class="avatar" id="swapAvatar">🧑</span>
                <span class="name" id="swapName">玩家</span>
                <span class="seat" id="swapSeat">#0</span>
            </div>
            <div class="btn-group">
                <button class="btn-swap accept" onclick="acceptSwap()">✅ 接受</button>
                <button class="btn-swap reject" onclick="rejectSwap()">✕ 拒绝</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(80, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            var colors = ['rgba(139,92,246,', 'rgba(236,72,153,', 'rgba(245,158,11,', 'rgba(0,240,255,'];
            for (var i = 0; i < count; i++) {
                var color = colors[Math.floor(Math.random() * colors.length)];
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01,
                    color: color
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            playerId: null,
            seatNumber: 0,
            isHost: true,
            isReady: false,
            players: [],
            seats: [],
            mySeat: null,
            swapTarget: null
        };

        var connection = null;
        var swapRequestId = null;

        // ============================================================
        // SignalR
        // ============================================================
        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // 事件监听
                connection.on('JoinedGame', function(data) {
                    if (data && data.success) {
                        state.playerId = data.playerId;
                        state.seatNumber = data.seatNumber || 0;
                        state.isHost = state.seatNumber === 0 || data.isHost === true;
                        showToast('✅ 已加入房间，你是 ' + (state.isHost ? '房主' : state.seatNumber + ' 号'), 'success');
                        updateUI();
                    }
                });

                connection.on('PlayerListUpdate', function(players) {
                    state.players = players || [];
                    updateUI();
                });

                connection.on('SeatUpdate', function(seatNumber, player) {
                    updateSeat(seatNumber, player);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SeatTaken', function(seatNumber, player) {
                    showToast('🪑 ' + player.nickname + ' 坐到了 ' + seatNumber + ' 号', 'success');
                    updateSeat(seatNumber, player);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SeatReleased', function(seatNumber) {
                    updateSeat(seatNumber, null);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SwapRequest', function(fromPlayer, targetSeat) {
                    var from = state.players.find(function(p) { return p.playerId === fromPlayer.playerId; });
                    if (!from) return;

                    swapRequestId = fromPlayer.playerId;
                    document.getElementById('swapAvatar').textContent = from.avatarEmoji || '🧑';
                    document.getElementById('swapName').textContent = from.nickname;
                    document.getElementById('swapSeat').textContent = '#' + targetSeat;
                    document.getElementById('swapModalTitle').textContent = '🔄 换座请求';
                    document.getElementById('swapModalDesc').textContent = from.nickname + ' 想和你交换座位';
                    document.getElementById('swapModal').classList.add('active');
                });

                connection.on('SwapAccepted', function(seat1, seat2, player1, player2) {
                    showToast('✅ ' + player1.nickname + ' 和 ' + player2.nickname + ' 交换了座位', 'success');
                    updateSeat(seat1, player2);
                    updateSeat(seat2, player1);
                    updateUI();
                    updateSeatCount();
                    document.getElementById('swapModal').classList.remove('active');
                });

                connection.on('SwapRejected', function(fromPlayer) {
                    showToast('❌ ' + fromPlayer.nickname + ' 拒绝了换座请求', 'error');
                    document.getElementById('swapModal').classList.remove('active');
                });

                connection.on('PhaseUpdate', function(phase) {
                    if (phase === 'dealing' || phase === 'revealing') {
                        document.getElementById('actionStatus').textContent = '● 发牌中...';
                        document.getElementById('startBtn').disabled = true;
                        setTimeout(function() {
                            window.location.href = '/Werewolf/Player?roomId=' + state.roomId;
                        }, 2000);
                    }
                    if (phase === 'gameover') {
                        document.getElementById('actionStatus').textContent = '● 游戏已结束';
                        document.getElementById('startBtn').disabled = true;
                    }
                });

                connection.on('DisplayMessage', function(message) {
                    showToast('📢 ' + message, 'info');
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        joinRoom();

                        // 心跳
                        setInterval(function() {
                            if (connection && connection.state === signalR.HubConnectionState.Connected && state
                                .playerId) {
                                connection.invoke('Heartbeat', state.playerId).catch(function() {});
                            }
                        }, 10000);
                    })
                    .catch(function(err) {
                        console.error('❌ 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
                showToast('⚠️ 连接失败，请刷新重试', 'error');
            }
        }

        // ============================================================
        // 加入房间（4个参数）
        // ============================================================
        function joinRoom() {
            if (!state.roomId || state.roomId === '') {
                showToast('⚠️ 房间号无效', 'error');
                return;
            }

            var nickname = '@username' || '管理员';
            var avatar = '👑';

            connection.invoke('JoinGame', state.roomId, nickname, avatar, true)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.isHost = true;
                        state.seatNumber = 0;
                        document.getElementById('actionStatus').textContent = '● 你是房主，等待玩家就坐';
                        showToast('✅ 已加入房间，你是房主', 'success');
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 生成座位
        // ============================================================
        function generateSeats() {
            var container = document.getElementById('seatsContainer');
            var count = 12;
            container.innerHTML = '';
            state.seats = [];
            var radius = 38;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';
                seat.onclick = function() {
                    var seatNum = parseInt(this.dataset.seat);
                    onSeatClick(seatNum);
                };

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);

                state.seats.push({
                    number: i + 1,
                    element: seat,
                    occupied: false,
                    player: null,
                    isReady: false,
                    isAI: false
                });
            }
            updateSeatCount();
        }

        // ============================================================
        // 更新座位
        // ============================================================
        function updateSeat(seatNumber, player) {
            var seat = state.seats.find(function(s) { return s.number === seatNumber; });
            if (!seat) return;

            if (player) {
                seat.occupied = true;
                seat.player = player;
                seat.isReady = player.isReady || false;
                seat.isAI = player.isAI || false;
                seat.element.className = 'seat occupied';
                if (player.playerId === state.playerId) {
                    seat.element.classList.add('self');
                    state.mySeat = seatNumber;
                }
                if (player.isReady) {
                    seat.element.classList.add('ready');
                }
                if (player.isHost) {
                    seat.element.classList.add('host');
                }
                if (player.isAI) {
                    seat.element.classList.add('ai');
                }
                seat.element.querySelector('.seat-name').textContent = player.nickname;
                seat.element.querySelector('.seat-emoji').textContent = player.avatarEmoji || '🧑';
            } else {
                seat.occupied = false;
                seat.player = null;
                seat.isReady = false;
                seat.isAI = false;
                seat.element.className = 'seat empty';
                if (state.mySeat === seatNumber) {
                    state.mySeat = null;
                }
                seat.element.querySelector('.seat-name').textContent = '空位';
                seat.element.querySelector('.seat-emoji').textContent = '🪑';
            }
        }

        // ============================================================
        // 座位点击处理
        // ============================================================
        function onSeatClick(seatNumber) {
            var seat = state.seats.find(function(s) { return s.number === seatNumber; });
            if (!seat) return;

            if (seat.occupied && seat.player && seat.player.playerId === state.playerId) {
                showToast('💡 这是你的座位', 'info');
                return;
            }

            // 空位 → 坐下
            if (!seat.occupied) {
                connection.invoke('TakeSeat', state.playerId, seatNumber)
                    .then(function(result) {
                        if (result && result.success) {
                            showToast('🪑 你坐到了 ' + seatNumber + ' 号', 'success');
                        } else if (result && !result.success) {
                            showToast('❌ ' + result.message, 'error');
                        }
                    })
                    .catch(function(err) {
                        showToast('❌ 坐下失败: ' + err, 'error');
                    });
                return;
            }

            // 已占座位 → 请求换座
            if (seat.occupied && seat.player && seat.player.playerId !== state.playerId) {
                if (confirm('要请求 ' + seat.player.nickname + ' 和你换座位吗？')) {
                    connection.invoke('RequestSwapSeat', state.playerId, seatNumber)
                        .then(function(result) {
                            if (result && result.success) {
                                showToast('📨 已发送换座请求给 ' + seat.player.nickname, 'info');
                            } else if (result && !result.success) {
                                showToast('❌ ' + result.message, 'error');
                            }
                        })
                        .catch(function(err) {
                            showToast('❌ 请求失败: ' + err, 'error');
                        });
                }
            }
        }

        // ============================================================
        // 接受/拒绝换座
        // ============================================================
        function acceptSwap() {
            if (!swapRequestId) return;
            connection.invoke('AcceptSwapSeat', state.playerId, swapRequestId, true)
                .catch(function(err) { showToast('❌ 接受失败: ' + err, 'error'); });
            document.getElementById('swapModal').classList.remove('active');
            swapRequestId = null;
        }

        function rejectSwap() {
            if (!swapRequestId) return;
            connection.invoke('AcceptSwapSeat', state.playerId, swapRequestId, false)
                .catch(function(err) { showToast('❌ 拒绝失败: ' + err, 'error'); });
            document.getElementById('swapModal').classList.remove('active');
            swapRequestId = null;
        }

        // ============================================================
        // 添加机器人
        // ============================================================
        function addBots(count) {
            if (!connection || !state.roomId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }

            if (!confirm('确定要添加 ' + count + ' 个机器人吗？（仅测试用）')) return;

            connection.invoke('AddBots', state.roomId, count)
                .then(function(result) {
                    if (result && result.success) {
                        showToast('✅ ' + result.message, 'success');
                    } else {
                        showToast('❌ ' + (result?.message || '添加失败'), 'error');
                    }
                })
                .catch(function(err) {
                    showToast('❌ 添加失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 更新UI
        // ============================================================
        function updateUI() {
            var players = state.players || [];
            var total = players.filter(function(p) { return !p.isSpectator; }).length;
            var ready = players.filter(function(p) { return p.isReady && !p.isSpectator; }).length;

            document.getElementById('playerCountBadge').textContent = total + ' 人';
            updatePlayerList(players);

            var seated = players.filter(function(p) { return p.seatNumber > 0 && !p.isSpectator; });
            seated.forEach(function(p) {
                updateSeat(p.seatNumber, p);
            });

            var occupied = state.seats.filter(function(s) { return s.occupied; }).length;
            var allReady = state.seats.filter(function(s) { return s.occupied && !s.isReady; }).length === 0;

            var btn = document.getElementById('startBtn');
            if (occupied >= 2 && allReady) {
                btn.disabled = false;
                document.getElementById('actionStatus').textContent = '● ' + occupied + '/' + state.seats.length + ' 已就坐，可以发牌';
            } else {
                btn.disabled = true;
                var msg = occupied < 2 ? '需要至少2人就坐' : '等待所有玩家准备';
                document.getElementById('actionStatus').textContent = '● ' + msg;
            }
        }

        function updatePlayerList(players) {
            var container = document.getElementById('playerList');

            if (!players || players.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var sorted = players.filter(function(p) { return !p.isSpectator; }).sort(function(a, b) {
                return (a.seatNumber || 99) - (b.seatNumber || 99);
            });

            if (sorted.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var html = '';
            sorted.forEach(function(p) {
                var isReady = p.isReady || false;
                var isSelf = p.playerId === state.playerId;
                var isHost = p.isHost || false;
                var isAI = p.isAI || false;
                var seatDisplay = p.seatNumber > 0 ? '#' + p.seatNumber : '💺';

                html += '<div class="player-item">';
                html += '<span class="avatar">' + (p.avatarEmoji || '🧑') + '</span>';
                html += '<div class="info">';
                html += '<span class="name">' + p.nickname + (isSelf ? ' <span class="me">(你)</span>' : '');
                if (isAI) { html += ' <span class="ai-tag">🤖 AI</span>'; }
                html += '<span class="seat-tag">' + seatDisplay + '</span>';
                html += '</span></div>';
                var statusClass = isHost ? 'host' : (isAI ? 'ai' : (isReady ? 'ready' : 'waiting'));
                var statusText = isHost ? '👑 房主' : (isAI ? '🤖 AI' : (isReady ? '✅ 已准备' : '⏳ 等待'));
                html += '<span class="status ' + statusClass + '">' + statusText + '</span>';
                html += '</div>';
            });

            container.innerHTML = html;
        }

        function updateSeatCount() {
            var occupied = state.seats.filter(function(s) { return s.occupied; }).length;
            document.getElementById('seatCount').textContent = occupied + '/' + state.seats.length + ' 已占';
        }

        // ============================================================
        // 开始游戏
        // ============================================================
        function startGame() {
            if (!connection || !state.roomId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }

            var btn = document.getElementById('startBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 发牌中...';

            connection.invoke('StartDealing', state.roomId)
                .catch(function(err) {
                    console.error('开始游戏失败:', err);
                    showToast('❌ 开始失败: ' + err, 'error');
                    btn.disabled = false;
                    btn.textContent = '🃏 洗牌发牌';
                });
        }

        // ============================================================
        // 刷新
        // ============================================================
        function refreshRoom() {
            showToast('🔄 刷新中...', 'info');
            if (connection && state.roomId) {
                connection.invoke('JoinGame', state.roomId, '@username', '👑', true)
                    .catch(function() {});
            }
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀座位图启动...');
            generateSeats();
            connectSignalR();
        });
    </script>

</body>
</html>
