@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString();
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            overflow: hidden;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .player-container {
            position: relative;
            z-index: 1;
            max-width: 440px;
            width: 100%;
            animation: containerIn 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        @@keyframes containerIn {
            from { opacity: 0; transform: scale(0.92) translateY(30px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .holo-card {
            background: rgba(8, 8, 28, 0.88);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(0, 240, 255, 0.08);
            border-radius: 28px;
            padding: 16px 14px 18px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 0 80px rgba(0, 240, 255, 0.02);
            min-height: 420px;
            display: flex;
            flex-direction: column;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(0, 240, 255, 0.02), transparent 60%);
            pointer-events: none;
        }

        .holo-card .border-glow {
            position: absolute;
            top: -1px;
            left: 20%;
            right: 20%;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.15), rgba(123, 97, 255, 0.15), transparent);
            animation: borderGlow 3s ease-in-out infinite;
        }

        @@keyframes borderGlow {
            0%, 100% { opacity: 0.3; transform: scaleX(1); }
            50% { opacity: 1; transform: scaleX(1.2); }
        }

        .holo-card .corner {
            position: absolute;
            width: 14px;
            height: 14px;
            border-color: rgba(0, 240, 255, 0.06);
            border-style: solid;
            border-width: 0;
            transition: all 0.6s ease;
        }
        .holo-card .corner.tl { top: 8px; left: 8px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
        .holo-card .corner.tr { top: 8px; right: 8px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
        .holo-card .corner.bl { bottom: 8px; left: 8px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
        .holo-card .corner.br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 4px;
        }

        .top-bar .room-code { font-size: 0.5rem; color: rgba(255,255,255,0.06); font-family: 'Courier New', monospace; letter-spacing: 2px; }
        .top-bar .seat-number { font-size: 0.7rem; font-weight: 700; color: rgba(0, 240, 255, 0.3); font-family: 'Courier New', monospace; }
        .top-bar .phase-badge { font-size: 0.45rem; padding: 2px 10px; border-radius: 20px; background: rgba(0, 240, 255, 0.04); border: 1px solid rgba(0, 240, 255, 0.04); color: rgba(255,255,255,0.15); text-transform: uppercase; letter-spacing: 0.1em; }

        .game-status {
            text-align: center;
            padding: 4px 0 6px;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.06);
            letter-spacing: 0.06em;
            flex-shrink: 0;
        }

        .game-status .night { color: #4facfe; }
        .game-status .day { color: #F59E0B; }
        .game-status .action { color: #8B5CF6; }

        .identity-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 8px 0;
            position: relative;
        }

        .identity-card .card-container {
            width: 140px;
            height: 196px;
            perspective: 800px;
            cursor: pointer;
            position: relative;
        }

        .identity-card .card-container .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            transform-style: preserve-3d;
        }

        .identity-card .card-container .card-inner.flipped { transform: rotateY(180deg); }

        .identity-card .card-container .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 0 60px rgba(139, 92, 246, 0.05);
        }

        .identity-card .card-container .card-face img { width: 100%; height: 100%; object-fit: cover; }
        .identity-card .card-container .card-face .card-label {
            position: absolute;
            bottom: 8px;
            left: 0;
            right: 0;
            text-align: center;
            font-size: 0.5rem;
            color: rgba(255,255,255,0.05);
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .identity-card .card-container .card-face.back { transform: rotateY(180deg); }
        .identity-card .flip-hint { margin-top: 8px; font-size: 0.6rem; color: rgba(255,255,255,0.06); animation: pulse 2s ease-in-out infinite; letter-spacing: 0.06em; }

        @@keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

        .role-info {
            margin-top: 8px;
            padding: 10px 14px;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.03);
            text-align: center;
            display: none;
            animation: fadeIn 0.5s ease;
            width: 100%;
        }

        .role-info.show { display: block; }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .role-info .role-name { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 2px; }
        .role-info .role-desc { font-size: 0.7rem; color: rgba(255,255,255,0.2); line-height: 1.6; }
        .role-info .role-detail { font-size: 0.65rem; color: rgba(255,255,255,0.12); margin-top: 4px; line-height: 1.6; white-space: pre-wrap; text-align: left; padding: 6px 10px; background: rgba(255,255,255,0.02); border-radius: 8px; }

        .spectator-mode { text-align: center; padding: 30px 0; }
        .spectator-mode .icon { font-size: 3rem; display: block; margin-bottom: 8px; opacity: 0.3; }
        .spectator-mode h2 { font-size: 1.1rem; font-weight: 700; color: rgba(255,255,255,0.15); }
        .spectator-mode p { font-size: 0.75rem; color: rgba(255,255,255,0.06); margin-top: 4px; }

        .action-panel {
            display: none;
            width: 100%;
            margin-top: 4px;
            animation: fadeIn 0.5s ease;
        }

        .action-panel.show { display: block; }

        .action-panel .action-title {
            font-size: 0.7rem;
            font-weight: 600;
            color: rgba(255,255,255,0.15);
            text-align: center;
            margin-bottom: 6px;
            letter-spacing: 0.06em;
        }

        .target-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin: 4px 0 8px;
        }

        .target-btn {
            padding: 8px 4px;
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 12px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            text-align: center;
        }

        .target-btn:hover:not(:disabled) {
            border-color: rgba(139,92,246,0.12);
            background: rgba(139,92,246,0.04);
            color: #fff;
        }

        .target-btn:disabled { opacity: 0.2; cursor: not-allowed; }

        .target-btn .sub { display: block; font-size: 0.45rem; font-weight: 400; color: rgba(255,255,255,0.04); margin-top: 2px; }

        .target-btn.selected {
            border-color: #8B5CF6;
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
            box-shadow: 0 0 40px rgba(139,92,246,0.02);
        }

        .target-btn .status-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-left: 2px; }
        .target-btn .status-dot.alive { background: #00FF88; }
        .target-btn .status-dot.dead { background: #dc3545; }

        .action-btns {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: 6px;
        }

        .action-btns .btn-action {
            flex: 1;
            padding: 8px 10px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .action-btns .btn-action.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
        .action-btns .btn-action.primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(139,92,246,0.1); }
        .action-btns .btn-action.secondary { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); color: rgba(255,255,255,0.2); }
        .action-btns .btn-action.secondary:hover:not(:disabled) { background: rgba(255,255,255,0.04); color: #fff; }
        .action-btns .btn-action:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }
        .action-btns .btn-action.success { background: linear-gradient(135deg, #00FF88, #00F0FF); color: #05050F; }
        .action-btns .btn-action.danger { background: rgba(255,0,110,0.08); border: 1px solid rgba(255,0,110,0.04); color: rgba(255,0,110,0.3); }
        .action-btns .btn-action.danger:hover:not(:disabled) { background: rgba(255,0,110,0.12); }

        .check-result {
            margin: 6px 0;
            padding: 8px 14px;
            border-radius: 12px;
            text-align: center;
            font-weight: 600;
            font-size: 0.85rem;
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .check-result.show { display: block; }
        .check-result.werewolf { background: rgba(220,53,69,0.08); border: 1px solid rgba(220,53,69,0.06); color: #dc3545; }
        .check-result.good { background: rgba(0,255,136,0.08); border: 1px solid rgba(0,255,136,0.06); color: #00FF88; }

        .vote-result {
            margin: 6px 0;
            padding: 8px 14px;
            border-radius: 12px;
            text-align: center;
            font-size: 0.8rem;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.15);
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .vote-result.show { display: block; }

        .wolf-vote-status {
            text-align: center;
            font-size: 0.65rem;
            color: rgba(255,255,255,0.06);
            margin: 4px 0;
            display: none;
        }

        .wolf-vote-status .progress { color: #dc3545; font-weight: 600; }

        .wolf-explode-btn {
            display: none;
            width: 100%;
            padding: 6px;
            border: 2px solid rgba(220,53,69,0.06);
            border-radius: 12px;
            background: rgba(220,53,69,0.02);
            color: rgba(220,53,69,0.3);
            font-weight: 600;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            text-align: center;
            margin-top: 4px;
        }

        .wolf-explode-btn:hover { background: rgba(220,53,69,0.04); color: #dc3545; }
        .wolf-explode-btn.show { display: block; }

        .bottom-actions {
            display: flex;
            gap: 6px;
            margin-top: 8px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        .bottom-actions .btn-bottom {
            flex: 1;
            padding: 8px 10px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .bottom-actions .btn-bottom.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
        .bottom-actions .btn-bottom.primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(139,92,246,0.1); }
        .bottom-actions .btn-bottom.secondary { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); color: rgba(255,255,255,0.2); }
        .bottom-actions .btn-bottom.secondary:hover:not(:disabled) { background: rgba(255,255,255,0.04); color: #fff; }
        .bottom-actions .btn-bottom:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }
        .bottom-actions .btn-bottom.success { background: linear-gradient(135deg, #00FF88, #00F0FF); color: #05050F; }

        .toast-container {
            position: fixed;
            bottom: 16px;
            right: 16px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
            max-width: 90%;
        }

        .toast-msg {
            padding: 6px 16px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
            max-width: 100%;
            word-break: break-word;
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(16px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @@media (max-width: 480px) {
            .holo-card { padding: 12px 10px 14px; border-radius: 24px; min-height: 360px; }
            .holo-card .corner { width: 10px; height: 10px; }
            .identity-card .card-container { width: 120px; height: 168px; }
            .top-bar .seat-number { font-size: 0.65rem; }
            .target-grid { grid-template-columns: repeat(4, 1fr); gap: 4px; }
            .target-btn { font-size: 0.7rem; padding: 6px 2px; }
            .action-btns .btn-action { font-size: 0.65rem; padding: 6px 8px; }
            .bottom-actions .btn-bottom { font-size: 0.65rem; padding: 6px 8px; }
            .role-info .role-name { font-size: 0.85rem; }
            .role-info .role-desc { font-size: 0.6rem; }
        }

        @@media (max-width: 380px) {
            .identity-card .card-container { width: 100px; height: 140px; }
            .holo-card { padding: 8px 6px 10px; border-radius: 20px; min-height: 320px; }
            .target-grid { grid-template-columns: repeat(4, 1fr); gap: 3px; }
            .target-btn { font-size: 0.6rem; padding: 4px 2px; border-radius: 8px; }
        }
    </style>
</head>
<body>

    <canvas id="particleCanvas"></canvas>

    <div class="player-container">

        <div class="holo-card" id="mainCard">
            <div class="border-glow"></div>
            <div class="corner tl"></div>
            <div class="corner tr"></div>
            <div class="corner bl"></div>
            <div class="corner br"></div>

            <div class="top-bar">
                <span class="room-code">✦ <span id="roomDisplay">@(string.IsNullOrEmpty(roomId) ? "------" : roomId)</span></span>
                <span class="seat-number" id="seatDisplay">🪑 等待中</span>
                <span class="phase-badge" id="phaseBadge">⚙️ 准备</span>
            </div>

            <div class="game-status" id="gameStatus"><span>✦ 等待游戏开始 ✦</span></div>

            <!-- 身份卡片 -->
            <div class="identity-card" id="identityCard">
                <div class="card-container" id="cardContainer">
                    <div class="card-inner" id="cardInner">
                        <div class="card-face front">
                            <img src="/images/werewolf/cards/card_back.jpg" alt="卡背" id="cardBackImg" />
                            <div class="card-label">✦ 点击翻牌 ✦</div>
                        </div>
                        <div class="card-face back">
                            <img src="" alt="身份" id="roleCardImg" />
                            <div class="card-label" id="roleLabel">角色名称</div>
                        </div>
                    </div>
                </div>
                <div class="flip-hint" id="flipHint">👆 点击卡片查看身份</div>

                <div class="role-info" id="roleInfo">
                    <div class="role-name" id="roleName">角色名</div>
                    <div class="role-desc" id="roleDesc">角色描述</div>
                    <div class="role-detail" id="roleDetail">详细技能</div>
                </div>
            </div>

            <!-- 观战模式 -->
            <div class="spectator-mode" id="spectatorMode" style="display:none;">
                <span class="icon">👁️</span>
                <h2>观战模式</h2>
                <p>你正在观看本局游戏</p>
            </div>

            <!-- 行动面板 -->
            <div class="action-panel" id="actionPanel">
                <div class="action-title" id="actionTitle">⏳ 等待行动...</div>
                <div class="target-grid" id="targetGrid"></div>
                <div class="check-result" id="checkResult"></div>
                <div class="vote-result" id="voteResult"></div>
                <div class="wolf-vote-status" id="wolfVoteStatus"><span class="progress" id="wolfVotedCount">0</span>/<span id="wolfTotalCount">0</span> 已投票</div>
                <button class="wolf-explode-btn" id="wolfExplodeBtn" onclick="wolfExplode()">💥 自爆</button>
                <div class="action-btns" id="actionBtns">
                    <button class="btn-action primary" id="actionConfirmBtn" onclick="confirmAction()">✅ 确认</button>
                    <button class="btn-action secondary" onclick="cancelAction()">✕ 取消</button>
                </div>
            </div>

            <!-- 底部按钮 -->
            <div class="bottom-actions" id="bottomActions">
                <button class="btn-bottom primary" id="revealBtn" onclick="toggleReveal()">🃏 查看身份</button>
                <button class="btn-bottom secondary" id="readyBtn" onclick="toggleReady()" disabled>⏳ 准备</button>
                <button class="btn-bottom secondary" onclick="showRules()" style="flex:0.5;">📖 规则</button>
            </div>

        </div>

    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 角色数据
        // ============================================================
        var roleData = {
            '狼人': {
                icon: '🐺',
                image: '/images/werewolf/cards/狼人.jpg',
                desc: '每晚可以共同杀害一名玩家',
                detail: '【技能】每晚可共同杀害一名玩家。\n【规则】所有狼人需投票统一意见。\n【自爆】白天可自爆，立即进入黑夜。'
            },
            '预言家': {
                icon: '🔮',
                image: '/images/werewolf/cards/预言家.jpg',
                desc: '每晚可以查验一名玩家的阵营',
                detail: '【技能】每晚可查验一名玩家身份（好人/狼人）。\n【规则】查验结果仅自己可见。'
            },
            '女巫': {
                icon: '🧪',
                image: '/images/werewolf/cards/女巫.jpg',
                desc: '拥有解药和毒药各一瓶',
                detail: '【技能】拥有解药和毒药各一瓶。\n【规则】解药可救人（首夜可自救），毒药可杀人。'
            },
            '守卫': {
                icon: '🛡️',
                image: '/images/werewolf/cards/守卫.jpg',
                desc: '每晚守护一名玩家免遭狼人袭击',
                detail: '【技能】每晚可守护一名玩家免受狼人袭击。\n【规则】不能连续两晚守护同一个人。\n【特殊】第一天可以守护自己。'
            },
            '猎人': {
                icon: '🔫',
                image: '/images/werewolf/cards/猎人.jpg',
                desc: '死亡时可以开枪带走一名玩家',
                detail: '【技能】死亡时可开枪带走一名玩家。\n【规则】被毒杀不能开枪。'
            },
            '白痴': {
                icon: '🤡',
                image: '/images/werewolf/cards/白痴.jpg',
                desc: '被放逐时可翻牌免死一次',
                detail: '【技能】被投票放逐时可翻牌免死一次。\n【规则】翻牌后失去投票权，但仍可发言。'
            },
            '骑士': {
                icon: '⚔️',
                image: '/images/werewolf/cards/骑士.jpg',
                desc: '白天可挑战一名玩家',
                detail: '【技能】白天可挑战一名玩家。\n【规则】若挑战目标为狼人，目标直接死亡。'
            },
            '平民': {
                icon: '👤',
                image: '/images/werewolf/cards/平民.jpg',
                desc: '无特殊技能，通过发言投票找出狼人',
                detail: '【技能】无特殊技能。\n【规则】通过发言和投票帮助好人阵营获胜。'
            }
        };

        var cardBackImage = '/images/werewolf/cards/card_back.jpg';

        // ============================================================
        // 状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            seatNumber: 0,
            playerId: null,
            nickname: '',
            avatar: '🧑',
            isReady: false,
            isRevealed: false,
            role: null,
            isSpectator: false,
            isGameStarted: false,
            phase: 'waiting',
            selectedTarget: -1,
            isWolf: false,
            isSeer: false,
            isWitch: false,
            isGuard: false,
            isHunter: false,
            isFool: false,
            isKnight: false,
            canExplode: false
        };

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // ===== 收到身份 =====
                connection.on('ReceiveRole', function(data) {
                    console.log('📩 收到身份:', data);
                    state.role = data.role;
                    state.seatNumber = data.seatNumber;
                    state.isSpectator = data.isSpectator || false;

                    document.getElementById('seatDisplay').textContent = '🪑 ' + data.seatNumber + ' 号';

                    if (state.isSpectator) {
                        document.getElementById('identityCard').style.display = 'none';
                        document.getElementById('spectatorMode').style.display = 'block';
                        document.getElementById('readyBtn').disabled = true;
                        document.getElementById('revealBtn').disabled = true;
                        showToast('👁️ 你已进入观战模式', 'info');
                        return;
                    }

                    var info = roleData[data.role];
                    if (info) {
                        document.getElementById('roleCardImg').src = info.image;
                        document.getElementById('roleLabel').textContent = data.role + ' ' + info.icon;
                    } else {
                        document.getElementById('roleCardImg').src = '/images/werewolf/cards/平民.jpg';
                        document.getElementById('roleLabel').textContent = data.role;
                    }

                    // 标记角色类型
                    state.isWolf = data.role === '狼人';
                    state.isSeer = data.role === '预言家';
                    state.isWitch = data.role === '女巫';
                    state.isGuard = data.role === '守卫';
                    state.isHunter = data.role === '猎人';
                    state.isFool = data.role === '白痴';
                    state.isKnight = data.role === '骑士';
                    state.canExplode = state.isWolf;

                    document.getElementById('readyBtn').disabled = false;
                    document.getElementById('readyBtn').textContent = '⏳ 准备';
                    state.isGameStarted = true;
                    document.getElementById('phaseBadge').textContent = '🎮 游戏中';
                    showToast('📩 你抽到了 ' + data.role, 'info');

                    // 如果是狼人，显示自爆按钮
                    if (state.isWolf) {
                        document.getElementById('wolfExplodeBtn').classList.add('show');
                    }
                });

                // ===== 阶段更新 =====
                connection.on('PhaseUpdate', function(phase, day, night) {
                    state.phase = phase;
                    updatePhaseDisplay(phase, day, night);
                    handleActionPanel(phase);
                });

                // ===== 守卫行动 =====
                connection.on('GuardAction', function(data) {
                    showActionPanel('🛡️ 守卫行动', '请选择要守护的玩家');
                    renderTargetGrid(data.targets, data.canProtectSelf, data.lastProtected);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'guard';
                });

                // ===== 预言家行动 =====
                connection.on('SeerAction', function(data) {
                    showActionPanel('🔮 预言家查验', '请选择要查验的玩家');
                    renderTargetGrid(data.targets, true, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'seer';
                });

                connection.on('SeerResult', function(data) {
                    var result = document.getElementById('checkResult');
                    result.className = 'check-result show ' + (data.isWerewolf ? 'werewolf' : 'good');
                    result.textContent = data.result + ' (' + data.targetSeat + '号)';
                    setTimeout(function() { result.className = 'check-result'; }, 5000);
                });

                // ===== 狼人行动 =====
                connection.on('WerewolfAction', function(data) {
                    showActionPanel('🐺 狼人行动', '请选择要杀害的玩家');
                    renderTargetGrid(data.targets, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'werewolf';
                    document.getElementById('wolfVoteStatus').style.display = 'block';
                    document.getElementById('wolfTotalCount').textContent = data.wolfSeats.length;
                    document.getElementById('wolfVotedCount').textContent = '0';
                });

                connection.on('WolfVoteStatus', function(data) {
                    document.getElementById('wolfVotedCount').textContent = data.voted;
                    if (data.voted === data.total) {
                        document.getElementById('wolfVoteStatus').innerHTML = '✅ 所有狼人已投票';
                    }
                });

                // ===== 女巫行动 =====
                connection.on('WitchAction', function(data) {
                    showActionPanel('🧪 女巫行动', '请选择解药或毒药');
                    renderWitchPanel(data.deathSeats, data.canSaveFirstNight);
                    document.getElementById('actionConfirmBtn').dataset.action = 'witch';
                });

                // ===== 投票行动 =====
                connection.on('VotingAction', function(data) {
                    var title = data.isPK ? '⚖️ PK投票' : '🗳️ 投票放逐';
                    showActionPanel(title, '请选择要放逐的玩家');
                    renderTargetGrid(data.targets, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'vote';
                    document.getElementById('actionConfirmBtn').textContent = data.isPK ? '🗳️ PK投票' : '🗳️ 投票';
                });

                // ===== 警长竞选 =====
                connection.on('SheriffElectionStart', function(data) {
                    showActionPanel('👑 警长竞选', '你是否参与竞选？');
                    var grid = document.getElementById('targetGrid');
                    grid.innerHTML = `
                        <button class="target-btn" onclick="joinSheriffElection()" style="grid-column:1/3;border-color:rgba(245,158,11,0.06);color:#F59E0B;">
                            ✅ 参与竞选
                            <span class="sub">发言争取支持</span>
                        </button>
                        <button class="target-btn" onclick="skipSheriffElection()" style="grid-column:3/5;border-color:rgba(255,255,255,0.02);color:rgba(255,255,255,0.1);">
                            ⏭️ 不参与
                            <span class="sub">警下投票</span>
                        </button>
                    `;
                    document.getElementById('actionConfirmBtn').style.display = 'none';
                    document.getElementById('actionConfirmBtn').dataset.action = 'sheriff';
                });

                connection.on('SheriffVote', function(data) {
                    showActionPanel('👑 警长投票', '请选择你要投票的候选人');
                    renderTargetGrid(data.candidates, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'sheriff_vote';
                    document.getElementById('actionConfirmBtn').textContent = '🗳️ 投票';
                });

                // ===== 猎人开枪 =====
                connection.on('HunterShootAction', function(data) {
                    showActionPanel('🔫 猎人开枪', '请选择要带走的玩家');
                    renderTargetGrid(data.targets, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'hunter';
                    document.getElementById('actionConfirmBtn').textContent = '🔫 开枪';
                });

                // ===== 游戏结束 =====
                connection.on('GameOver', function(winner) {
                    var msg = winner === '好人' ? '⭐ 好人阵营胜利！' : '🐺 狼人阵营胜利！';
                    showToast('🏆 ' + msg, 'success');
                    document.getElementById('gameStatus').innerHTML = '<span style="color:#F59E0B;">🏆 ' + msg + '</span>';
                    document.getElementById('phaseBadge').textContent = '🏁 游戏结束';
                    document.getElementById('actionPanel').classList.remove('show');
                    document.getElementById('revealBtn').disabled = true;
                    document.getElementById('readyBtn').disabled = true;
                    document.getElementById('wolfExplodeBtn').classList.remove('show');
                });

                // ===== PK行动 =====
                connection.on('PKAction', function(data) {
                    showActionPanel('⚖️ PK发言', '请发言争取支持');
                    var grid = document.getElementById('targetGrid');
                    grid.innerHTML =
                        `<div style="grid-column:1/-1;text-align:center;padding:8px;color:rgba(255,255,255,0.1);font-size:0.8rem;">📢 你是PK玩家，请发言</div>`;
                    document.getElementById('actionConfirmBtn').style.display = 'none';
                });

                // ===== 连接 =====
                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        joinRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 加入房间
        // ============================================================
        function joinRoom() {
            if (!state.roomId || state.roomId === '------') {
                showToast('❌ 无效的房间码', 'error');
                return;
            }

            var nickname = prompt('请输入你的昵称：', '玩家' + Math.floor(Math.random() * 100));
            if (!nickname || nickname.trim() === '') { nickname = '玩家' + Math.floor(Math.random() * 100); }
            state.nickname = nickname.trim();

            var avatars = ['🧑', '👩', '👨', '🦸', '🧙', '🧚', '🤖', '👾', '🦊', '🐺'];
            state.avatar = avatars[Math.floor(Math.random() * avatars.length)];

            connection.invoke('JoinGame', state.roomId, state.nickname, state.avatar)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.seatNumber = result.seatNumber;
                        document.getElementById('seatDisplay').textContent = '🪑 ' + result.seatNumber + ' 号';
                        document.getElementById('roomDisplay').textContent = state.roomId;
                        showToast('✅ 已加入房间，你是 ' + result.seatNumber + ' 号', 'success');
                    } else if (result && result.isSpectator) {
                        state.isSpectator = true;
                        document.getElementById('identityCard').style.display = 'none';
                        document.getElementById('spectatorMode').style.display = 'block';
                        document.getElementById('readyBtn').disabled = true;
                        document.getElementById('revealBtn').disabled = true;
                        showToast('👁️ 座位已满，你进入观战模式', 'info');
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 行动面板
        // ============================================================
        function showActionPanel(title, subtitle) {
            var panel = document.getElementById('actionPanel');
            var titleEl = document.getElementById('actionTitle');
            panel.classList.add('show');
            titleEl.innerHTML = title + ' <span style="color:rgba(255,255,255,0.1);font-size:0.6rem;font-weight:400;">' + subtitle +
                '</span>';
            document.getElementById('checkResult').className = 'check-result';
            document.getElementById('voteResult').className = 'vote-result';
            document.getElementById('wolfVoteStatus').style.display = 'none';
            var confirmBtn = document.getElementById('actionConfirmBtn');
            confirmBtn.style.display = 'flex';
            confirmBtn.textContent = '✅ 确认';
            confirmBtn.disabled = false;
            document.getElementById('wolfExplodeBtn').classList.remove('show');
            if (state.isWolf) {
                document.getElementById('wolfExplodeBtn').classList.add('show');
            }
        }

        function hideActionPanel() {
            document.getElementById('actionPanel').classList.remove('show');
        }

        // ============================================================
        // 渲染目标网格
        // ============================================================
        function renderTargetGrid(targets, canSelectSelf, lastProtected) {
            var grid = document.getElementById('targetGrid');
            grid.innerHTML = '';

            if (!targets || targets.length === 0) {
                grid.innerHTML =
                    '<div style="text-align:center;color:rgba(255,255,255,0.04);font-size:0.7rem;grid-column:1/-1;padding:8px 0;">暂无可用目标</div>';
                return;
            }

            targets.forEach(function(seat) {
                var btn = document.createElement('button');
                btn.className = 'target-btn';
                btn.dataset.seat = seat;

                var isSelf = state.seatNumber === seat;
                var isDisabled = false;

                if (isSelf && !canSelectSelf) {
                    isDisabled = true;
                    btn.innerHTML = seat + ' 号 <span class="sub">自己</span>';
                } else if (lastProtected && lastProtected === seat) {
                    isDisabled = true;
                    btn.innerHTML = seat + ' 号 <span class="sub">已守护</span>';
                } else {
                    btn.innerHTML = seat + ' 号 <span class="status-dot alive"></span>';
                }

                if (isDisabled) { btn.disabled = true; }

                btn.addEventListener('click', function() {
                    if (this.disabled) return;
                    document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                    this.classList.add('selected');
                    state.selectedTarget = parseInt(this.dataset.seat);
                });

                grid.appendChild(btn);
            });
        }

        // ============================================================
        // 女巫面板
        // ============================================================
        function renderWitchPanel(deaths, canSaveFirstNight) {
            var grid = document.getElementById('targetGrid');
            grid.innerHTML = '';

            var hasDeath = deaths && deaths.length > 0;
            var canSave = hasDeath && (canSaveFirstNight || deaths.indexOf(state.seatNumber) === -1 || canSaveFirstNight);

            var antidoteDiv = document.createElement('div');
            antidoteDiv.style.cssText =
                'grid-column:1/3;padding:8px;border:2px solid rgba(0,255,136,0.04);border-radius:12px;cursor:pointer;text-align:center;transition:all 0.3s ease;background:rgba(255,255,255,0.01);';
            antidoteDiv.innerHTML =
                '<span style="font-size:1.2rem;">💚</span><br><span style="font-size:0.7rem;color:rgba(255,255,255,0.15);">解药</span><br><span style="font-size:0.55rem;color:rgba(255,255,255,0.04);">' +
                (hasDeath ? '救活 ' + deaths.join(',') + ' 号' : '无人可救') + '</span>';
            antidoteDiv.dataset.action = 'antidote';
            if (!hasDeath || !canSave) {
                antidoteDiv.style.opacity = '0.3';
                antidoteDiv.style.cursor = 'not-allowed';
            }
            antidoteDiv.addEventListener('click', function() {
                if (this.style.opacity === '0.3') return;
                document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                this.classList.add('selected');
                state.selectedTarget = -1;
                document.getElementById('actionConfirmBtn').dataset.action = 'antidote';
                document.getElementById('actionConfirmBtn').textContent = '💚 使用解药';
            });
            grid.appendChild(antidoteDiv);

            var poisonDiv = document.createElement('div');
            poisonDiv.style.cssText =
                'grid-column:3/5;padding:8px;border:2px solid rgba(220,53,69,0.04);border-radius:12px;cursor:pointer;text-align:center;transition:all 0.3s ease;background:rgba(255,255,255,0.01);';
            poisonDiv.innerHTML =
                '<span style="font-size:1.2rem;">☠️</span><br><span style="font-size:0.7rem;color:rgba(255,255,255,0.15);">毒药</span><br><span style="font-size:0.55rem;color:rgba(255,255,255,0.04);">选择目标</span>';
            poisonDiv.dataset.action = 'poison';
            poisonDiv.addEventListener('click', function() {
                document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                this.classList.add('selected');
                state.selectedTarget = -1;
                document.getElementById('actionConfirmBtn').dataset.action = 'poison';
                document.getElementById('actionConfirmBtn').textContent = '☠️ 使用毒药';
                showPoisonTargets();
            });
            grid.appendChild(poisonDiv);
        }

        function showPoisonTargets() {
            var grid = document.getElementById('targetGrid');
            grid.innerHTML = '';

            for (var i = 1; i <= 12; i++) {
                if (i === state.seatNumber) continue;
                var btn = document.createElement('button');
                btn.className = 'target-btn';
                btn.dataset.seat = i;
                btn.innerHTML = i + ' 号 <span class="status-dot alive"></span>';
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                    this.classList.add('selected');
                    state.selectedTarget = parseInt(this.dataset.seat);
                });
                grid.appendChild(btn);
            }
        }

        // ============================================================
        // 确认行动
        // ============================================================
        function confirmAction() {
            var action = document.getElementById('actionConfirmBtn').dataset.action;
            var btn = document.getElementById('actionConfirmBtn');
            btn.disabled = true;

            switch (action) {
                case 'guard':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要守护的玩家', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('GuardProtect', state.playerId, state.selectedTarget)
                        .then(function() { showToast('✅ 已守护 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'seer':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要查验的玩家', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('SeerCheck', state.playerId, state.selectedTarget)
                        .then(function() { showToast('🔮 正在查验 ' + state.selectedTarget + ' 号...', 'info');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'werewolf':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要杀害的玩家', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('WerewolfVote', state.playerId, state.selectedTarget)
                        .then(function() {
                            showToast('🐺 已投票 ' + state.selectedTarget + ' 号', 'success');
                            document.getElementById('wolfVotedCount').textContent = parseInt(document.getElementById(
                                'wolfVotedCount').textContent) + 1;
                            hideActionPanel();
                        })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'witch':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择毒药目标', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('WitchAction', state.playerId, false, true, state.selectedTarget)
                        .then(function() { showToast('☠️ 已毒杀 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'antidote':
                    connection.invoke('WitchAction', state.playerId, true, false, -1)
                        .then(function() { showToast('💚 已使用解药', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'vote':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要放逐的玩家', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('DayVote', state.playerId, state.selectedTarget)
                        .then(function() { showToast('🗳️ 已投票 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'sheriff_vote':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要投票的候选人', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('SheriffVote', state.playerId, state.selectedTarget)
                        .then(function() { showToast('🗳️ 已投票给 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                case 'hunter':
                    if (state.selectedTarget < 0) { showToast('⚠️ 请选择要带走的目标', 'warning');
                        btn.disabled = false; return; }
                    connection.invoke('HunterShoot', state.playerId, state.selectedTarget)
                        .then(function() { showToast('🔫 已开枪带走 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel(); })
                        .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false; });
                    break;

                default:
                    showToast('⚠️ 未知操作', 'warning');
                    btn.disabled = false;
            }
        }

        // ============================================================
        // 警长竞选
        // ============================================================
        function joinSheriffElection() {
            connection.invoke('JoinSheriffElection', state.playerId)
                .then(function() {
                    showToast('✅ 已参与警长竞选', 'success');
                    hideActionPanel();
                })
                .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error'); });
        }

        function skipSheriffElection() {
            showToast('⏭️ 已跳过竞选', 'info');
            hideActionPanel();
        }

        // ============================================================
        // 狼人自爆
        // ============================================================
        function wolfExplode() {
            if (!state.isWolf) return;
            if (!confirm('确定要自爆吗？自爆后立即进入黑夜！')) return;
            connection.invoke('WerewolfExplode', state.playerId)
                .then(function() {
                    showToast('💥 狼人自爆！', 'error');
                    hideActionPanel();
                    document.getElementById('wolfExplodeBtn').classList.remove('show');
                })
                .catch(function(err) { showToast('❌ 操作失败: ' + err, 'error'); });
        }

        // ============================================================
        // 取消行动
        // ============================================================
        function cancelAction() {
            state.selectedTarget = -1;
            document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
            document.getElementById('actionPanel').classList.remove('show');
            showToast('✕ 已取消', 'info');
        }

        // ============================================================
        // 翻牌
        // ============================================================
        function toggleReveal() {
            var inner = document.getElementById('cardInner');
            var hint = document.getElementById('flipHint');
            var btn = document.getElementById('revealBtn');

            state.isRevealed = !state.isRevealed;

            if (state.isRevealed) {
                inner.classList.add('flipped');
                hint.textContent = '🔄 点击翻回卡背';
                btn.textContent = '🔒 隐藏身份';

                var info = document.getElementById('roleInfo');
                var name = document.getElementById('roleName');
                var desc = document.getElementById('roleDesc');
                var detail = document.getElementById('roleDetail');

                var data = roleData[state.role];
                if (data) {
                    name.textContent = data.icon + ' ' + state.role;
                    desc.textContent = data.desc;
                    detail.textContent = data.detail;
                } else {
                    name.textContent = state.role;
                    desc.textContent = '查看身份';
                    detail.textContent = '暂无详细说明';
                }
                info.classList.add('show');
            } else {
                inner.classList.remove('flipped');
                hint.textContent = '👆 点击卡片查看身份';
                btn.textContent = '🃏 查看身份';
                document.getElementById('roleInfo').classList.remove('show');
            }
        }

        // ============================================================
        // 准备
        // ============================================================
        function toggleReady() {
            if (!connection || !state.playerId) { showToast('⚠️ 未加入房间', 'warning'); return; }

            state.isReady = !state.isReady;
            var btn = document.getElementById('readyBtn');

            if (state.isReady) {
                btn.textContent = '✅ 已准备';
                btn.style.color = '#00FF88';
                showToast('✅ 已准备，等待其他玩家...', 'success');
            } else {
                btn.textContent = '⏳ 准备';
                btn.style.color = '';
                showToast('⏳ 已取消准备', 'info');
            }

            connection.invoke('ToggleReady', state.playerId, state.isReady)
                .catch(function(err) {
                    console.error('切换准备状态失败:', err);
                    showToast('操作失败', 'error');
                    state.isReady = !state.isReady;
                });
        }

        // ============================================================
        // 阶段更新
        // ============================================================
        function updatePhaseDisplay(phase, day, night) {
            var badge = document.getElementById('phaseBadge');
            var status = document.getElementById('gameStatus');

            var phaseMap = {
                'setup': { label: '⚙️ 设置', color: 'rgba(255,255,255,0.15)' },
                'seating': { label: '🪑 就坐', color: 'rgba(255,255,255,0.15)' },
                'dealing': { label: '🃏 发牌', color: '#8B5CF6' },
                'revealing': { label: '📩 查看身份', color: '#8B5CF6' },
                'sheriff_election': { label: '👑 竞选', color: '#F59E0B' },
                'night_guard': { label: '🌙 守卫', color: '#4facfe' },
                'night_seer': { label: '🌙 预言家', color: '#4facfe' },
                'night_werewolf': { label: '🌙 狼人', color: '#4facfe' },
                'night_witch': { label: '🌙 女巫', color: '#4facfe' },
                'night_resolve': { label: '🌙 结算', color: '#4facfe' },
                'day_announce': { label: '☀️ 天亮了', color: '#F59E0B' },
                'day_speech': { label: '☀️ 发言', color: '#F59E0B' },
                'day_voting': { label: '☀️ 投票', color: '#F59E0B' },
                'day_pk': { label: '☀️ PK', color: '#F59E0B' },
                'day_resolve': { label: '☀️ 结果', color: '#F59E0B' },
                'hunter_shoot': { label: '🔫 猎人', color: '#F59E0B' },
                'gameover': { label: '🏁 结束', color: '#EC4899' }
            };

            var info = phaseMap[phase] || { label: phase, color: 'rgba(255,255,255,0.15)' };
            badge.textContent = info.label;
            badge.style.color = info.color;

            var statusMap = {
                'setup': '✦ 等待开始 ✦',
                'seating': '🪑 等待玩家就坐',
                'dealing': '🃏 发牌中...',
                'revealing': '📩 请查看身份',
                'sheriff_election': '👑 警长竞选',
                'night_guard': '🌙 守卫行动中...',
                'night_seer': '🌙 预言家查验中...',
                'night_werewolf': '🌙 狼人行动中...',
                'night_witch': '🌙 女巫行动中...',
                'night_resolve': '⚖️ 结算中...',
                'day_announce': '☀️ 公布死讯',
                'day_speech': '📢 发言阶段',
                'day_voting': '🗳️ 投票阶段',
                'day_pk': '⚖️ PK发言',
                'day_resolve': '⚖️ 公布结果',
                'hunter_shoot': '🔫 猎人开枪',
                'gameover': '🏁 游戏结束'
            };

            status.textContent = statusMap[phase] || phase;
            status.className = 'game-status';
            if (phase.startsWith('night')) status.classList.add('night');
            else if (phase.startsWith('day')) status.classList.add('day');
            else if (phase === 'revealing' || phase === 'dealing' || phase === 'sheriff_election') status.classList.add(
            'action');
        }

        function handleActionPanel(phase) {
            var noActionPhases = ['setup', 'seating', 'dealing', 'revealing', 'night_resolve', 'day_announce', 'day_speech',
                'day_resolve', 'gameover'
            ];
            if (noActionPhases.indexOf(phase) !== -1) {
                hideActionPanel();
            }
        }

        // ============================================================
        // 显示规则
        // ============================================================
        function showRules() {
            window.open('/Werewolf/Rules?roomId=' + state.roomId, '_blank', 'width=480,height=700');
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(50, Math.floor(window.innerWidth / 10));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.1,
                    vy: (Math.random() - 0.5) * 0.1,
                    r: Math.random() * 1 + 0.3,
                    o: Math.random() * 0.1 + 0.02
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀玩家端启动...');
            connectSignalR();
        });
    </script>

