        var cardBackImage = '/images/werewolf/cards/card_back.jpg';

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            seatNumber: 0,
            playerId: null,
            nickname: '',
            avatar: '🧑',
            isReady: false,
            isRevealed: false,
            role: null,
            isSpectator: false,
            isGameStarted: false,
            phase: 'waiting',
            // 行动状态
            selectedTarget: -1,
            wolfVoted: false,
            hasVoted: false,
            isWolfLeader: false
        };

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // ============================================================
                // 事件：收到身份
                // ============================================================
                connection.on('ReceiveRole', function(data) {
                    console.log('📩 收到身份:', data);
                    state.role = data.role;
                    state.seatNumber = data.seatNumber;
                    state.isSpectator = data.isSpectator || false;

                    document.getElementById('seatDisplay').textContent = '🪑 ' + data.seatNumber + ' 号';

                    if (state.isSpectator) {
                        document.getElementById('identityCard').style.display = 'none';
                        document.getElementById('spectatorMode').style.display = 'block';
                        document.getElementById('readyBtn').disabled = true;
                        document.getElementById('revealBtn').disabled = true;
                        showToast('👁️ 你已进入观战模式', 'info');
                        return;
                    }

                    var roleImg = document.getElementById('roleCardImg');
                    var roleLabel = document.getElementById('roleLabel');
                    var info = roleData[data.role];

                    if (info) {
                        roleImg.src = info.image;
                        roleLabel.textContent = data.role + ' ' + info.icon;
                    } else {
                        roleImg.src = '/images/werewolf/cards/平民.jpg';
                        roleLabel.textContent = data.role;
                    }

                    document.getElementById('readyBtn').disabled = false;
                    document.getElementById('readyBtn').textContent = '⏳ 准备';
                    document.getElementById('readyBtn').classList.remove('is-ready');

                    state.isGameStarted = true;
                    document.getElementById('phaseBadge').textContent = '🎮 游戏中';

                    showToast('📩 你抽到了 ' + data.role, 'info');
                });

                // ============================================================
                // 事件：阶段更新
                // ============================================================
                connection.on('PhaseUpdate', function(phase, day, night) {
                    state.phase = phase;
                    updatePhaseDisplay(phase, day, night);
                    handleActionPanel(phase);
                });

                // ============================================================
                // 事件：守卫行动
                // ============================================================
                connection.on('GuardAction', function(data) {
                    showActionPanel('🛡️ 守卫行动', '请选择要守护的玩家');
                    renderTargetGrid(data.targets, data.canProtectSelf, data.lastProtected);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'guard';
                });

                // ============================================================
                // 事件：预言家行动
                // ============================================================
                connection.on('SeerAction', function(data) {
                    showActionPanel('🔮 预言家查验', '请选择要查验的玩家');
                    renderTargetGrid(data.targets, true, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'seer';
                });

                // ============================================================
                // 事件：预言家结果
                // ============================================================
                connection.on('SeerResult', function(data) {
                    var result = document.getElementById('checkResult');
                    result.className = 'check-result show ' + (data.isWerewolf ? 'werewolf' : 'good');
                    result.textContent = data.result + ' (' + data.targetSeat + '号)';
                    setTimeout(function() { result.className = 'check-result'; }, 5000);
                });

                // ============================================================
                // 事件：狼人行动
                // ============================================================
                connection.on('WerewolfAction', function(data) {
                    showActionPanel('🐺 狼人行动', '请选择要杀害的玩家');
                    renderTargetGrid(data.targets, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'werewolf';

                    document.getElementById('wolfVoteStatus').style.display = 'block';
                    document.getElementById('wolfTotalCount').textContent = data.wolfSeats.length;
                    document.getElementById('wolfVotedCount').textContent = '0';
                });

                // ============================================================
                // 事件：狼人投票状态
                // ============================================================
                connection.on('WolfVoteStatus', function(data) {
                    document.getElementById('wolfVotedCount').textContent = data.voted;
                    if (data.voted === data.total) {
                        document.getElementById('wolfVoteStatus').innerHTML = '✅ 所有狼人已投票';
                    }
                });

                // ============================================================
                // 事件：女巫行动
                // ============================================================
                connection.on('WitchAction', function(data) {
                    showActionPanel('🧪 女巫行动', '请选择解药或毒药');
                    var targets = data.deathSeats || [];
                    renderWitchPanel(targets);
                    document.getElementById('actionConfirmBtn').dataset.action = 'witch';
                });

                // ============================================================
                // 事件：投票行动
                // ============================================================
                connection.on('VotingAction', function(data) {
                    showActionPanel('🗳️ 投票放逐', '请选择要放逐的玩家');
                    renderTargetGrid(data.targets, false, null);
                    state.selectedTarget = -1;
                    document.getElementById('actionConfirmBtn').dataset.action = 'vote';
                    document.getElementById('actionConfirmBtn').textContent = '🗳️ 投票';
                });

                // ============================================================
                // 事件：语音播报
                // ============================================================
                connection.on('VoiceAnnounce', function(message, importance) {
                    document.getElementById('gameStatus').innerHTML = '<span class="action">🔊 ' + message + '</span>';
                    if (importance === 'high') {
                        speakText(message);
                        setTimeout(function() { speakText(message); }, 2000);
                    } else {
                        speakText(message);
                    }
                });

                // ============================================================
                // 事件：死亡公告
                // ============================================================
                connection.on('DeathAnnounce', function(data) {
                    if (data.deaths && data.deaths.length > 0) {
                        showToast('💀 ' + data.message, 'error');
                    } else {
                        showToast('🕊️ ' + data.message, 'info');
                    }
                });

                // ============================================================
                // 事件：游戏结束
                // ============================================================
                connection.on('GameOver', function(winner) {
                    var msg = winner === '好人' ? '⭐ 好人阵营胜利！' : '🐺 狼人阵营胜利！';
                    showToast('🏆 ' + msg, 'success');
                    document.getElementById('gameStatus').innerHTML = '<span style="color:#F59E0B;">🏆 ' + msg + '</span>';
                    document.getElementById('phaseBadge').textContent = '🏁 游戏结束';
                    document.getElementById('actionPanel').classList.remove('show');
                    document.getElementById('revealBtn').disabled = true;
                    document.getElementById('readyBtn').disabled = true;
                });

                // ============================================================
                // 连接
                // ============================================================
                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        joinRoom();
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        // ============================================================
        // 加入房间
        // ============================================================
        function joinRoom() {
            if (!state.roomId || state.roomId === '------') {
                showToast('❌ 无效的房间码', 'error');
                return;
            }

            var nickname = prompt('请输入你的昵称：', '玩家' + Math.floor(Math.random() * 100));
            if (!nickname || nickname.trim() === '') {
                nickname = '玩家' + Math.floor(Math.random() * 100);
            }
            state.nickname = nickname.trim();

            var avatars = ['🧑', '👩', '👨', '🦸', '🧙', '🧚', '🤖', '👾', '🦊', '🐺'];
            state.avatar = avatars[Math.floor(Math.random() * avatars.length)];

            connection.invoke('JoinGame', state.roomId, state.nickname, state.avatar)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.seatNumber = result.seatNumber;
                        document.getElementById('seatDisplay').textContent = '🪑 ' + result.seatNumber + ' 号';
                        document.getElementById('roomDisplay').textContent = state.roomId;
                        showToast('✅ 已加入房间，你是 ' + result.seatNumber + ' 号', 'success');
                    } else if (result && result.isSpectator) {
                        state.isSpectator = true;
                        document.getElementById('identityCard').style.display = 'none';
                        document.getElementById('spectatorMode').style.display = 'block';
                        document.getElementById('readyBtn').disabled = true;
                        document.getElementById('revealBtn').disabled = true;
                        showToast('👁️ 座位已满，你进入观战模式', 'info');
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                });
        }

        // ============================================================
        // ⭐ 行动面板控制
        // ============================================================
        function showActionPanel(title, subtitle) {
            var panel = document.getElementById('actionPanel');
            var titleEl = document.getElementById('actionTitle');
            panel.classList.add('show');
            titleEl.innerHTML = title + ' <span style="color:rgba(255,255,255,0.1);font-size:0.6rem;font-weight:400;">' + subtitle +
                '</span>';

            // 隐藏之前的检查结果
            document.getElementById('checkResult').className = 'check-result';
            document.getElementById('voteResult').className = 'vote-result';
            document.getElementById('wolfVoteStatus').style.display = 'none';

            // 重置确认按钮
            var confirmBtn = document.getElementById('actionConfirmBtn');
            confirmBtn.textContent = '✅ 确认';
            confirmBtn.disabled = false;
        }

        function hideActionPanel() {
            document.getElementById('actionPanel').classList.remove('show');
        }

        // ============================================================
        // ⭐ 渲染目标网格
        // ============================================================
        function renderTargetGrid(targets, canSelectSelf, lastProtected) {
            var grid = document.getElementById('targetGrid');
            grid.innerHTML = '';

            if (!targets || targets.length === 0) {
                grid.innerHTML =
                    '<div style="text-align:center;color:rgba(255,255,255,0.04);font-size:0.7rem;grid-column:1/-1;padding:8px 0;">暂无可用目标</div>';
                return;
            }

            targets.forEach(function(seat) {
                var btn = document.createElement('button');
                btn.className = 'target-btn';
                btn.dataset.seat = seat;
                btn.textContent = seat + ' 号';

                var isSelf = state.seatNumber === seat;
                var isDisabled = false;

                if (isSelf && !canSelectSelf) {
                    isDisabled = true;
                    btn.innerHTML = seat + ' 号 <span class="sub">自己</span>';
                } else if (lastProtected && lastProtected === seat) {
                    isDisabled = true;
                    btn.innerHTML = seat + ' 号 <span class="sub">已守护</span>';
                } else {
                    btn.innerHTML = seat + ' 号 <span class="status-dot alive"></span>';
                }

                if (isDisabled) {
                    btn.disabled = true;
                }

                btn.addEventListener('click', function() {
                    if (this.disabled) return;
                    document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove(
                        'selected'); });
                    this.classList.add('selected');
                    state.selectedTarget = parseInt(this.dataset.seat);
                });

                grid.appendChild(btn);
            });
        }

        // ============================================================
        // ⭐ 女巫面板
        // ============================================================
        function renderWitchPanel(deaths) {
            var grid = document.getElementById('targetGrid');
            grid.innerHTML = '';

            var hasDeath = deaths && deaths.length > 0;

            // 解药选项
            var antidoteDiv = document.createElement('div');
            antidoteDiv.style.cssText =
                'grid-column:1/3;padding:8px;border:2px solid rgba(0,255,136,0.04);border-radius:12px;cursor:pointer;text-align:center;transition:all 0.3s ease;background:rgba(255,255,255,0.01);';
            antidoteDiv.innerHTML =
                '<span style="font-size:1.2rem;">💚</span><br><span style="font-size:0.7rem;color:rgba(255,255,255,0.15);">解药</span><br><span style="font-size:0.55rem;color:rgba(255,255,255,0.04);">' +
                (hasDeath ? '救活 ' + deaths.join(',') + ' 号' : '无人可救') + '</span>';
            antidoteDiv.dataset.action = 'antidote';
            if (!hasDeath) {
                antidoteDiv.style.opacity = '0.3';
                antidoteDiv.style.cursor = 'not-allowed';
            }
            antidoteDiv.addEventListener('click', function() {
                if (this.style.opacity === '0.3') return;
                document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                this.classList.add('selected');
                state.selectedTarget = -1;
                document.getElementById('actionConfirmBtn').dataset.action = 'antidote';
                document.getElementById('actionConfirmBtn').textContent = '💚 使用解药';
            });
            grid.appendChild(antidoteDiv);

            // 毒药选项
            var poisonDiv = document.createElement('div');
            poisonDiv.style.cssText =
                'grid-column:3/5;padding:8px;border:2px solid rgba(220,53,69,0.04);border-radius:12px;cursor:pointer;text-align:center;transition:all 0.3s ease;background:rgba(255,255,255,0.01);';
            poisonDiv.innerHTML =
                '<span style="font-size:1.2rem;">☠️</span><br><span style="font-size:0.7rem;color:rgba(255,255,255,0.15);">毒药</span><br><span style="font-size:0.55rem;color:rgba(255,255,255,0.04);">选择目标</span>';
            poisonDiv.dataset.action = 'poison';
            poisonDiv.addEventListener('click', function() {
                if (this.style.opacity === '0.3') return;
                document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
                this.classList.add('selected');
                state.selectedTarget = -1;
                document.getElementById('actionConfirmBtn').dataset.action = 'poison';
                document.getElementById('actionConfirmBtn').textContent = '☠️ 使用毒药';

                // 显示可毒目标
                showPoisonTargets();
            });
            grid.appendChild(poisonDiv);
        }

        function showPoisonTargets() {
            var grid = document.getElementById('targetGrid');
            // 清除已有选项（保留毒药选项）
            var poisonOption = grid.querySelector('[data-action="poison"]');
            var antidoteOption = grid.querySelector('[data-action="antidote"]');

            // 获取所有存活玩家（除了自己）
            // 这里简化，实际从服务器获取
            showToast('👆 点击下方目标选择毒药目标', 'info');

            // 重新渲染网格为可毒目标
            grid.innerHTML = '';
            if (antidoteOption) grid.appendChild(antidoteOption);
            if (poisonOption) grid.appendChild(poisonOption);

            // 添加可毒目标（示例：1-12号）
            for (var i = 1; i <= 12; i++) {
                if (i === state.seatNumber) continue;
                var btn = document.createElement('button');
                btn.className = 'target-btn';
                btn.dataset.seat = i;
                btn.textContent = i + ' 号';
                btn.innerHTML = i + ' 号 <span class="status-dot alive"></span>';
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove(
                        'selected'); });
                    this.classList.add('selected');
                    state.selectedTarget = parseInt(this.dataset.seat);
                });
                grid.appendChild(btn);
            }
        }

        // ============================================================
        // ⭐ 确认行动
        // ============================================================
        function confirmAction() {
            var action = document.getElementById('actionConfirmBtn').dataset.action;
            var btn = document.getElementById('actionConfirmBtn');
            btn.disabled = true;

            switch (action) {
                case 'guard':
                    if (state.selectedTarget < 0) {
                        showToast('⚠️ 请选择要守护的玩家', 'warning');
                        btn.disabled = false;
                        return;
                    }
                    connection.invoke('GuardProtect', state.playerId, state.selectedTarget)
                        .then(function() {
                            showToast('✅ 已守护 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                case 'seer':
                    if (state.selectedTarget < 0) {
                        showToast('⚠️ 请选择要查验的玩家', 'warning');
                        btn.disabled = false;
                        return;
                    }
                    connection.invoke('SeerCheck', state.playerId, state.selectedTarget)
                        .then(function() {
                            showToast('🔮 正在查验 ' + state.selectedTarget + ' 号...', 'info');
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                case 'werewolf':
                    if (state.selectedTarget < 0) {
                        showToast('⚠️ 请选择要杀害的玩家', 'warning');
                        btn.disabled = false;
                        return;
                    }
                    connection.invoke('WerewolfVote', state.playerId, state.selectedTarget)
                        .then(function() {
                            showToast('🐺 已投票 ' + state.selectedTarget + ' 号', 'success');
                            document.getElementById('wolfVotedCount').textContent = parseInt(document.getElementById(
                                'wolfVotedCount').textContent) + 1;
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                case 'witch':
                    // 女巫行动通过弹窗选择
                    if (state.selectedTarget < 0) {
                        showToast('⚠️ 请选择毒药目标', 'warning');
                        btn.disabled = false;
                        return;
                    }
                    connection.invoke('WitchAction', state.playerId, false, true, state.selectedTarget)
                        .then(function() {
                            showToast('☠️ 已毒杀 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                case 'antidote':
                    connection.invoke('WitchAction', state.playerId, true, false, -1)
                        .then(function() {
                            showToast('💚 已使用解药', 'success');
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                case 'vote':
                    if (state.selectedTarget < 0) {
                        showToast('⚠️ 请选择要放逐的玩家', 'warning');
                        btn.disabled = false;
                        return;
                    }
                    connection.invoke('DayVote', state.playerId, state.selectedTarget)
                        .then(function() {
                            showToast('🗳️ 已投票 ' + state.selectedTarget + ' 号', 'success');
                            hideActionPanel();
                        })
                        .catch(function(err) {
                            showToast('❌ 操作失败: ' + err, 'error');
                            btn.disabled = false;
                        });
                    break;

                default:
                    showToast('⚠️ 未知操作', 'warning');
                    btn.disabled = false;
            }
        }

        // ============================================================
        // 取消行动
        // ============================================================
        function cancelAction() {
            state.selectedTarget = -1;
            document.querySelectorAll('.target-btn').forEach(function(b) { b.classList.remove('selected'); });
            document.getElementById('actionPanel').classList.remove('show');
            showToast('✕ 已取消', 'info');
        }

        // ============================================================
        // 阶段显示更新
        // ============================================================
        function updatePhaseDisplay(phase, day, night) {
            var badge = document.getElementById('phaseBadge');
            var status = document.getElementById('gameStatus');

            var phaseMap = {
                'setup': { label: '⚙️ 设置', color: 'rgba(255,255,255,0.15)' },
                'seating': { label: '🪑 就坐', color: 'rgba(255,255,255,0.15)' },
                'dealing': { label: '🃏 发牌', color: '#8B5CF6' },
                'revealing': { label: '📩 查看身份', color: '#8B5CF6' },
                'night_guard': { label: '🌙 守卫', color: '#4facfe' },
                'night_seer': { label: '🌙 预言家', color: '#4facfe' },
                'night_werewolf': { label: '🌙 狼人', color: '#4facfe' },
                'night_witch': { label: '🌙 女巫', color: '#4facfe' },
                'night_resolve': { label: '🌙 结算', color: '#4facfe' },
                'day_announce': { label: '☀️ 天亮了', color: '#F59E0B' },
                'day_speech': { label: '☀️ 发言', color: '#F59E0B' },
                'day_voting': { label: '☀️ 投票', color: '#F59E0B' },
                'day_resolve': { label: '☀️ 结果', color: '#F59E0B' },
                'gameover': { label: '🏁 结束', color: '#EC4899' }
            };

            var info = phaseMap[phase] || { label: phase, color: 'rgba(255,255,255,0.15)' };
            badge.textContent = info.label;
            badge.style.color = info.color;

            var statusMap = {
                'setup': '✦ 等待开始 ✦',
                'seating': '🪑 等待玩家就坐',
                'dealing': '🃏 发牌中...',
                'revealing': '📩 请查看身份',
                'night_guard': '🌙 守卫行动中...',
                'night_seer': '🌙 预言家查验中...',
                'night_werewolf': '🌙 狼人行动中...',
                'night_witch': '🌙 女巫行动中...',
                'night_resolve': '⚖️ 结算中...',
                'day_announce': '☀️ 公布死讯',
                'day_speech': '📢 发言阶段',
                'day_voting': '🗳️ 投票阶段',
                'day_resolve': '⚖️ 公布结果',
                'gameover': '🏁 游戏结束'
            };

            status.textContent = statusMap[phase] || phase;
            status.className = 'game-status';
            if (phase.startsWith('night')) status.classList.add('night');
            else if (phase.startsWith('day')) status.classList.add('day');
            else if (phase === 'revealing' || phase === 'dealing') status.classList.add('action');
        }

        // ============================================================
        // 处理行动面板
        // ============================================================
        function handleActionPanel(phase) {
            // 如果是玩家自己的角色行动阶段，面板会由对应事件触发
            // 如果不需要行动，隐藏面板
            var noActionPhases = ['setup', 'seating', 'dealing', 'revealing', 'night_resolve', 'day_announce', 'day_speech',
                'day_resolve', 'gameover'
            ];
            if (noActionPhases.indexOf(phase) !== -1) {
                hideActionPanel();
            }
        }

        // ============================================================
        // 翻牌
        // ============================================================
        function toggleReveal() {
            var inner = document.getElementById('cardInner');
            var hint = document.getElementById('flipHint');
            var btn = document.getElementById('revealBtn');

            state.isRevealed = !state.isRevealed;

            if (state.isRevealed) {
                inner.classList.add('flipped');
                hint.textContent = '🔄 点击翻回卡背';
                btn.textContent = '🔒 隐藏身份';

                var roleInfo = document.getElementById('roleInfo');
                var roleName = document.getElementById('roleName');
                var roleDesc = document.getElementById('roleDesc');
                var roleDetail = document.getElementById('roleDetail');

                var data = roleData[state.role];
                if (data) {
                    roleName.textContent = data.icon + ' ' + state.role;
                    roleDesc.textContent = data.desc;
                    roleDetail.textContent = data.detail;
                } else {
                    roleName.textContent = state.role;
                    roleDesc.textContent = '查看身份';
                    roleDetail.textContent = '暂无详细说明';
                }
                roleInfo.classList.add('show');

                if (!state._hasAnnounced) {
                    state._hasAnnounced = true;
                    var text = '你是 ' + state.role;
                    if (data) text += '，' + data.desc;
                    speakText(text);
                }

            } else {
                inner.classList.remove('flipped');
                hint.textContent = '👆 点击卡片查看身份';
                btn.textContent = '🃏 查看身份';
                document.getElementById('roleInfo').classList.remove('show');
            }
        }

        // ============================================================
        // 语音播报（TTS）
        // ============================================================
        function speakText(text) {
            if (!window.speechSynthesis) return;
            window.speechSynthesis.cancel();
            var utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'zh-CN';
            utterance.rate = 0.9;
            utterance.pitch = 1.1;
            var voices = window.speechSynthesis.getVoices();
            var zhVoice = voices.find(function(v) { return v.lang.startsWith('zh'); });
            if (zhVoice) utterance.voice = zhVoice;
            window.speechSynthesis.speak(utterance);
        }

        // ============================================================
        // 准备
        // ============================================================
        function toggleReady() {
            if (!connection || !state.playerId) {
                showToast('⚠️ 未加入房间', 'warning');
                return;
            }

            state.isReady = !state.isReady;
            var btn = document.getElementById('readyBtn');

            if (state.isReady) {
                btn.textContent = '✅ 已准备';
                btn.style.color = '#00FF88';
                btn.style.borderColor = 'rgba(0,255,136,0.06)';
                showToast('✅ 已准备，等待其他玩家...', 'success');
            } else {
                btn.textContent = '⏳ 准备';
                btn.style.color = '';
                btn.style.borderColor = '';
                showToast('⏳ 已取消准备', 'info');
            }

            connection.invoke('ToggleReady', state.playerId, state.isReady)
                .catch(function(err) {
                    console.error('切换准备状态失败:', err);
                    showToast('操作失败', 'error');
                    state.isReady = !state.isReady;
                });
        }

        // ============================================================
        // 显示规则
        // ============================================================
        function showRules() {
            window.open('/Werewolf/Rules?roomId=' + state.roomId, '_blank', 'width=480,height=700');
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(50, Math.floor(window.innerWidth / 10));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (var i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.1,
                    vy: (Math.random() - 0.5) * 0.1,
                    r: Math.random() * 1 + 0.3,
                    o: Math.random() * 0.1 + 0.02
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, ' + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀玩家端启动...');
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = function() {
                    window.speechSynthesis.getVoices();
                };
            }
            connectSignalR();
        });
    </script>

</body>
</html>
