@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀 · 座位图";
    var roomId = ViewBag.RoomId as string ?? Context.Request.Query["roomId"].ToString() ?? "";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀 · 座位图</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #05050F;
            font-family: 'Inter', sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow: hidden;
            padding: 16px;
        }

        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .container {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 1rem 1.5rem 1.5rem;
        }

        /* ===== 3D粒子 ===== */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* 头部 */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 1.5rem;
            border-radius: 20px;
            background: rgba(10, 10, 30, 0.4);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.8rem;
            box-shadow: 0 8px 60px rgba(0, 0, 0, 0.3);
        }

        .header .brand { display: flex; align-items: center; gap: 12px; }
        .header .brand .icon { font-size: 2rem; animation: wolfPulse 2s ease-in-out infinite; }
        @@keyframes wolfPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
        .header .brand h1 {
            font-size: 1.4rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header .brand .sub { font-size: 0.5rem; color: rgba(255,255,255,0.06); letter-spacing: 0.15em; text-transform: uppercase; display: block; margin-top: -2px; }

        .header .status-group { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .header .room-badge {
            padding: 4px 16px;
            border-radius: 40px;
            background: rgba(0, 240, 255, 0.03);
            border: 1px solid rgba(0, 240, 255, 0.04);
            font-size: 0.7rem;
            color: rgba(255,255,255, 0.2);
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        .header .user-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px 4px 8px;
            border-radius: 40px;
            background: rgba(139, 92, 246, 0.04);
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-size: 0.75rem;
            color: rgba(255,255,255,0.3);
        }

        .header .user-badge .avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.55rem;
            font-weight: 700;
            color: #fff;
        }

        .header .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #00FF88;
            animation: pulse 2s infinite;
            margin-right: 4px;
        }

        /* 主布局 */
        .main-grid {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 20px;
            padding: 1rem 0;
            min-height: 0;
        }

        @@media (max-width: 1024px) { .main-grid { grid-template-columns: 1fr; gap: 16px; } }

        /* 座位图区域 */
        .seating-area {
            background: rgba(255,255,255,0.015);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .seating-area .area-title {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.08);
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .seating-area .area-title .count {
            color: #00F0FF;
            font-weight: 700;
            font-size: 0.8rem;
        }

        .table-container {
            position: relative;
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            flex: 1;
            aspect-ratio: 1 / 0.9;
        }

        .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30,20,60,0.2), rgba(10,10,30,0.4));
            border: 2px solid rgba(139, 92, 246, 0.03);
            box-shadow: 0 0 80px rgba(139, 92, 246, 0.02), inset 0 0 80px rgba(0,0,0,0.2);
        }

        .table-pattern {
            position: absolute;
            inset: 15%;
            border-radius: 50%;
            background-image: repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,255,255,0.005) 5deg, transparent 10deg);
            opacity: 0.3;
            pointer-events: none;
        }

        .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .table-center .icon { font-size: 2rem; opacity: 0.08; display: block; }
        .table-center .label { font-size: 0.45rem; color: rgba(255,255,255,0.01); text-transform: uppercase; letter-spacing: 0.2em; }

        /* 座位 */
        .seat {
            position: absolute;
            width: clamp(44px, 5.5vw, 64px);
            height: clamp(44px, 5.5vw, 64px);
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 20px rgba(0,0,0,0.2);
            user-select: none;
        }

        .seat .seat-number {
            font-size: clamp(0.6rem, 0.7vw, 0.9rem);
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: rgba(255,255,255,0.06);
            transition: all 0.3s ease;
        }

        .seat .seat-name {
            font-size: clamp(0.3rem, 0.4vw, 0.5rem);
            font-weight: 500;
            color: rgba(255,255,255,0.03);
            max-width: 44px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .seat .seat-emoji { font-size: clamp(0.7rem, 0.9vw, 1.1rem); display: none; }

        .seat.empty { border-color: rgba(255,255,255,0.03); background: rgba(255,255,255,0.01); }
        .seat.empty:hover {
            border-color: rgba(0, 240, 255, 0.15);
            background: rgba(0, 240, 255, 0.03);
            transform: translate(-50%, -50%) scale(1.1);
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.03);
        }

        .seat.occupied { border-color: rgba(0, 240, 255, 0.08); background: rgba(0, 240, 255, 0.02); }
        .seat.occupied .seat-number { color: rgba(0, 240, 255, 0.15); }
        .seat.occupied .seat-name { color: rgba(255,255,255,0.08); }

        .seat.occupied:hover {
            border-color: rgba(245, 158, 11, 0.15);
            background: rgba(245, 158, 11, 0.02);
            transform: translate(-50%, -50%) scale(1.08);
            box-shadow: 0 0 40px rgba(245, 158, 11, 0.02);
        }

        .seat.self {
            border-color: rgba(0, 240, 255, 0.15);
            background: rgba(0, 240, 255, 0.04);
            box-shadow: 0 0 50px rgba(0, 240, 255, 0.03);
        }
        .seat.self .seat-number { color: #00F0FF; }
        .seat.self .seat-name { color: rgba(255,255,255,0.15); }

        .seat.ready { border-color: rgba(0, 255, 136, 0.12); background: rgba(0, 255, 136, 0.02); box-shadow: 0 0 40px rgba(0, 255, 136, 0.02); }
        .seat.ready .seat-number { color: #00FF88; }

        .seat.swap-request { border-color: #F59E0B; animation: swapPulse 1s ease-in-out infinite; box-shadow: 0 0 60px rgba(245, 158, 11, 0.05); }
        @@keyframes swapPulse { 0%, 100% { border-color: #F59E0B; box-shadow: 0 0 20px rgba(245, 158, 11, 0.02); } 50% { border-color: #F59E0B; box-shadow: 0 0 60px rgba(245, 158, 11, 0.08); } }

        .seat.host { border-color: rgba(139, 92, 246, 0.12); }
        .seat.host .seat-number { color: #8B5CF6; }

        .seat.ai { border-color: rgba(0, 240, 255, 0.08); background: rgba(0, 240, 255, 0.02); animation: aiSeatPulse 2s ease-in-out infinite; }
        @@keyframes aiSeatPulse { 0%, 100% { box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } 50% { box-shadow: 0 0 40px rgba(0, 240, 255, 0.05); } }

        @@media (max-width: 640px) {
            .seat { width: 32px; height: 32px; }
            .seat .seat-number { font-size: 0.4rem; }
            .seat .seat-name { display: none; }
            .seat .seat-emoji { display: block; font-size: 0.7rem; }
        }

        @@media (max-width: 480px) {
            .seat { width: 26px; height: 26px; border-width: 1.5px; }
            .seat .seat-number { font-size: 0.35rem; }
            .seat .seat-emoji { font-size: 0.6rem; }
            .seating-area { padding: 0.8rem; }
        }

        /* 右侧面板 */
        .holo-card {
            background: rgba(255,255,255,0.015);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 1.5rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .holo-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 30%, rgba(139, 92, 246, 0.01), transparent 70%);
            pointer-events: none;
        }

        .holo-card .card-title {
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255,255,255,0.08);
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .holo-card .card-title .accent { flex: 1; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.03), transparent); }

        .player-list {
            overflow-y: auto;
            max-height: 280px;
            padding-right: 4px;
        }

        .player-list::-webkit-scrollbar { width: 3px; }
        .player-list::-webkit-scrollbar-track { background: rgba(255,255,255,0.01); border-radius: 10px; }
        .player-list::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.08); border-radius: 10px; }

        .player-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.4rem 0.6rem;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.02);
            transition: all 0.3s ease;
            margin-bottom: 4px;
        }

        .player-item:hover { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); }

        .player-item .avatar { font-size: 1rem; width: 28px; text-align: center; flex-shrink: 0; }
        .player-item .info { flex: 1; min-width: 0; }
        .player-item .info .name {
            color: rgba(255,255,255,0.3);
            font-size: 0.75rem;
            font-weight: 500;
        }
        .player-item .info .name .ai-tag {
            font-size: 0.4rem;
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
            background: rgba(0, 240, 255, 0.04);
            color: #00F0FF;
            border: 1px solid rgba(0, 240, 255, 0.02);
            font-weight: 600;
            animation: aiGlow 2s ease-in-out infinite;
        }
        @@keyframes aiGlow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; box-shadow: 0 0 20px rgba(0, 240, 255, 0.02); } }
        .player-item .info .name .me { color: rgba(139, 92, 246, 0.3); font-size: 0.45rem; margin-left: 4px; }
        .player-item .info .name .seat-tag { color: rgba(0, 240, 255, 0.2); font-size: 0.5rem; font-family: 'Courier New', monospace; margin-left: 4px; }

        .player-item .status {
            font-size: 0.45rem;
            font-weight: 600;
            padding: 1px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .player-item .status.ready { background: rgba(0,255,136,0.06); color: #00FF88; border: 1px solid rgba(0,255,136,0.03); }
        .player-item .status.waiting { background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.02); }
        .player-item .status.host { background: rgba(139, 92, 246, 0.06); color: #8B5CF6; border: 1px solid rgba(139, 92, 246, 0.03); }
        .player-item .status.ai { background: rgba(0, 240, 255, 0.04); color: #00F0FF; border: 1px solid rgba(0, 240, 255, 0.02); }

        .player-empty {
            color: rgba(255,255,255,0.02);
            font-size: 0.7rem;
            text-align: center;
            padding: 1rem 0;
            letter-spacing: 0.06em;
        }

        .host-actions {
            display: flex;
            gap: 0.8rem;
            flex-wrap: wrap;
            align-items: center;
            padding-top: 0.8rem;
            border-top: 1px solid rgba(255,255,255,0.02);
        }

        .btn-primary {
            padding: 0.6rem 2rem;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 0 40px rgba(139, 92, 246, 0.02);
        }

        .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 60px rgba(139, 92, 246, 0.1); }
        .btn-primary:disabled { opacity: 0.2; cursor: not-allowed; transform: none !important; }

        .btn-secondary {
            padding: 0.6rem 1.5rem;
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 40px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.15);
            font-weight: 500;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-secondary:hover { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); }

        .btn-bot {
            padding: 0.6rem 1.5rem;
            border: 1px solid rgba(245,158,11,0.04);
            border-radius: 40px;
            background: rgba(245,158,11,0.02);
            color: rgba(245,158,11,0.15);
            font-weight: 500;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-bot:hover { background: rgba(245,158,11,0.04); color: #F59E0B; }

        .host-actions .status-text {
            font-size: 0.6rem;
            color: rgba(255,255,255,0.04);
            margin-left: auto;
        }

        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 6px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.75rem;
            backdrop-filter: blur(20px);
            background: rgba(10,10,30,0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0,255,136,0.08); border-color: rgba(0,255,136,0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255,0,110,0.08); border-color: rgba(255,0,110,0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0,240,255,0.06); border-color: rgba(0,240,255,0.04); color: #00F0FF; }

        @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

        /* 换座弹窗 */
        .swap-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(20px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            animation: modalFadeIn 0.3s ease;
        }
        .swap-modal-overlay.active { display: flex; }
        @@keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

        .swap-modal {
            background: rgba(16, 16, 30, 0.98);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            max-width: 420px;
            width: 100%;
            padding: 2rem;
            box-shadow: 0 32px 120px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .swap-modal .modal-icon { font-size: 3rem; margin-bottom: 0.3rem; }
        .swap-modal h3 { color: #F59E0B; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.3rem; }
        .swap-modal p { color: rgba(255,255,255,0.3); font-size: 0.9rem; margin-bottom: 1.2rem; line-height: 1.6; }
        .swap-modal .player-info {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            padding: 0.8rem;
            background: rgba(255,255,255,0.02);
            border-radius: 12px;
            margin-bottom: 1.2rem;
        }
        .swap-modal .player-info .avatar { font-size: 1.8rem; }
        .swap-modal .player-info .name { color: #fff; font-weight: 600; font-size: 1rem; }
        .swap-modal .player-info .seat { color: rgba(0,240,255,0.3); font-size: 0.8rem; font-family: 'Courier New', monospace; }

        .swap-modal .btn-group { display: flex; gap: 0.8rem; flex-wrap: wrap; }
        .swap-modal .btn-group .btn-swap {
            flex: 1;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            min-width: 80px;
        }
        .swap-modal .btn-group .btn-swap.accept { background: linear-gradient(135deg, #00FF88, #00F0FF); color: #05050F; }
        .swap-modal .btn-group .btn-swap.accept:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(0,255,136,0.1); }
        .swap-modal .btn-group .btn-swap.reject { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.2); }
        .swap-modal .btn-group .btn-swap.reject:hover { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.4); }

        @@media (max-width: 768px) {
            .container { padding: 0.5rem 0.8rem 1rem; }
            .header .brand h1 { font-size: 1rem; }
            .header .room-badge { font-size: 0.55rem; padding: 2px 10px; }
            .holo-card { padding: 1rem; }
            .host-actions { flex-direction: column; align-items: stretch; }
            .host-actions .status-text { text-align: center; margin-left: 0; }
            .btn-primary, .btn-secondary, .btn-bot { justify-content: center; }
            .swap-modal { padding: 1.2rem; }
        }

        @@media (max-width: 480px) {
            .header .brand .icon { font-size: 1.4rem; }
            .header .brand h1 { font-size: 0.85rem; }
            .swap-modal .player-info .avatar { font-size: 1.4rem; }
            .swap-modal h3 { font-size: 1rem; }
        }
    </style>

    <!-- ============ 身份牌揭晓动画 ============ -->
    <style>
        #roleRevealOverlay {
            position: fixed; inset: 0; z-index: 9999; display: none;
            align-items: center; justify-content: center;
            background: radial-gradient(120% 120% at 50% 30%, rgba(20,12,40,0.9), rgba(6,4,14,0.96));
            backdrop-filter: blur(12px);
        }
        #roleRevealOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        @@keyframes overlayFade { from { opacity: 0; } to { opacity: 1; } }
        .role-card-wrap { display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
        .role-card { width: 210px; height: 315px; perspective: 1400px; }
        .role-card-inner {
            position: relative; width: 100%; height: 100%;
            transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.25, 1);
            transform-style: preserve-3d;
        }
        .role-card.flipped .role-card-inner { transform: rotateY(180deg); }
        .role-card-front, .role-card-back {
            position: absolute; inset: 0; backface-visibility: hidden; border-radius: 20px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }
        .role-card-front {
            background: linear-gradient(135deg, #2a1b4d 0%, #120c26 100%);
            border: 1px solid rgba(139,92,246,0.45);
        }
        .role-card-front::before {
            content: ''; position: absolute; inset: 10px; border-radius: 14px;
            border: 1px dashed rgba(255,255,255,0.12);
        }
        .card-back-img { width: 100%; height: 100%; object-fit: cover; border-radius: 20px; }
        .role-card-back {
            background: linear-gradient(160deg, #2a1f45 0%, #140d26 100%);
            border: 1px solid rgba(255,255,255,0.18); transform: rotateY(180deg);
            padding: 0 0 0.7rem; justify-content: flex-start;
        }
        .role-img { width: 100%; height: 78%; object-fit: cover; border-radius: 20px 20px 0 0; }
        .role-card-back::after {
            content: ''; position: absolute; inset: 0; border-radius: 20px; pointer-events: none;
            background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.22) 50%, transparent 70%);
            transform: translateX(-110%); animation: cardShine 2.6s ease-in-out infinite;
        }
        @@keyframes cardShine { 0% { transform: translateX(-110%); } 55%, 100% { transform: translateX(110%); } }
        .role-particle { position: fixed; width: 8px; height: 8px; border-radius: 50%; pointer-events: none; z-index: 9999; }
        .role-name { font-size: 1.9rem; font-weight: 900; color: #fff; margin-top: 0.5rem; letter-spacing: 0.1em; }
        .role-desc { font-size: 0.85rem; color: rgba(255,255,255,0.55); margin-top: 0.5rem; text-align: center; padding: 0 1.2rem; line-height: 1.6; }
        .role-confirm {
            padding: 0.8rem 2.4rem; font-size: 1rem; font-weight: 800; color: #fff;
            background: linear-gradient(135deg, #8B5CF6, #EC4899); border: none; border-radius: 50px;
            cursor: pointer; font-family: inherit; box-shadow: 0 8px 24px rgba(139,92,246,0.4);
            transition: transform 0.2s ease; animation: confirmIn 0.5s ease 0.8s both;
        }
        .role-confirm:hover { transform: translateY(-2px); }
        @@keyframes confirmIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        /* 游戏暂停遮罩 */
        #pauseOverlay {
            position: fixed; inset: 0; z-index: 9997; display: none;
            align-items: center; justify-content: center;
            background: rgba(6,4,14,0.82); backdrop-filter: blur(10px);
        }
        #pauseOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        .pause-box { text-align: center; }
        .pause-icon { font-size: 5rem; animation: pausePulse 1.4s ease-in-out infinite; }
        .pause-title { font-size: 1.8rem; font-weight: 900; color: #fff; margin-top: 0.6rem; letter-spacing: 0.1em; }
        .pause-names { font-size: 1rem; color: #F59E0B; margin-top: 0.5rem; font-weight: 700; }
        .pause-sub { font-size: 0.85rem; color: rgba(255,255,255,0.4); margin-top: 0.4rem; }
        @@keyframes pausePulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.12); opacity: 0.65; } }

        /* 规则说明弹窗 */
        #rulesOverlay { position: fixed; inset: 0; z-index: 9996; display: none; align-items: center; justify-content: center; background: rgba(6,4,14,0.85); backdrop-filter: blur(10px); }
        #rulesOverlay.show { display: flex; animation: overlayFade 0.3s ease; }
        .rules-modal { width: min(92vw, 460px); max-height: 82vh; background: linear-gradient(160deg, #1a1430, #0e0a1f); border: 1px solid rgba(139,92,246,0.4); border-radius: 24px; padding: 1.4rem; display: flex; flex-direction: column; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
        .rules-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .rules-title { font-size: 1.1rem; font-weight: 800; color: #fff; }
        .rules-page { color: rgba(255,255,255,0.4); font-size: 0.8rem; }
        .rules-progress { font-size: 0.72rem; color: #4ade80; }
        .rules-body { flex: 1; overflow-y: auto; min-height: 240px; margin-bottom: 1rem; }
        .rules-body .rb-title { font-size: 1.05rem; font-weight: 800; color: #A78BFA; margin-bottom: 0.6rem; }
        .rules-body .rb-item { color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.7; margin: 0.3rem 0; }
        .rules-footer { display: flex; gap: 0.5rem; }
        .rules-btn { flex: 1; padding: 0.65rem; font-size: 0.85rem; font-weight: 700; color: #fff; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; cursor: pointer; font-family: inherit; }
        .rules-btn.confirm { background: linear-gradient(135deg, #8B5CF6, #EC4899); border: none; }

        /* 游客登录入口 */
        #guestEntry { position: fixed; inset: 0; z-index: 10000; display: none; align-items: center; justify-content: center; background: rgba(6,4,14,0.9); backdrop-filter: blur(12px); }
        .ge-box { width: min(90vw, 400px); background: linear-gradient(160deg, #1a1430, #0e0a1f); border: 1px solid rgba(0,240,255,0.3); border-radius: 22px; padding: 1.6rem; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.6); }
        .ge-title { font-size: 1.3rem; font-weight: 800; color: #fff; }
        .ge-desc { font-size: 0.82rem; color: rgba(255,255,255,0.4); margin: 0.4rem 0 1rem; }
        .ge-box input { width: 100%; padding: 0.7rem 1rem; font-size: 1rem; color: #fff; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; font-family: inherit; outline: none; margin-bottom: 1rem; }
        .ge-avatars { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1rem; }
        .ge-avatar { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; background: rgba(255,255,255,0.05); border: 2px solid transparent; cursor: pointer; transition: all 0.15s ease; }
        .ge-avatar.sel { border-color: #00F0FF; background: rgba(0,240,255,0.12); }
        .ge-btn { padding: 0.75rem 2.4rem; font-size: 1rem; font-weight: 800; color: #fff; background: linear-gradient(135deg, #00F0FF, #7B61FF, #EC4899); border: none; border-radius: 50px; cursor: pointer; font-family: inherit; }
    </style>
</head>
<body>

    <!-- 身份牌揭晓动画 -->
    <div id="roleRevealOverlay">
        <div class="role-card-wrap">
            <div class="role-card" id="roleCard">
                <div class="role-card-inner">
                    <div class="role-card-front">
                        <img src="/images/werewolf/牌背.png" class="card-back-img" alt="卡背" />
                    </div>
                    <div class="role-card-back">
                        <img src="" id="roleImg" class="role-img" alt="身份" />
                        <div class="role-name" id="roleName">平民</div>
                        <div class="role-desc" id="roleDesc">无特殊技能</div>
                    </div>
                </div>
            </div>
            <button class="role-confirm" id="roleConfirmBtn" onclick="hideRoleCard()">👌 我记住了</button>
        </div>
    </div>

    <!-- 游戏暂停遮罩 -->
    <div id="pauseOverlay">
        <div class="pause-box">
            <div class="pause-icon">⏸️</div>
            <div class="pause-title">游戏已暂停</div>
            <div class="pause-names" id="pauseNames"></div>
            <div class="pause-sub">等待玩家回来…</div>
        </div>
    </div>

    <!-- 规则说明弹窗 -->
    <div id="rulesOverlay">
        <div class="rules-modal">
            <div class="rules-header">
                <span class="rules-title">📜 狼人杀 · 游戏规则</span>
                <span class="rules-page" id="rulesPage">1/5</span>
            </div>
            <div class="rules-body" id="rulesBody"></div>
            <div class="rules-footer">
                <button class="rules-btn" id="rulesPrev" onclick="rulesPrev()">← 上一页</button>
                <button class="rules-btn" id="rulesNext" onclick="rulesNext()">下一页 →</button>
                <button class="rules-btn confirm" id="rulesConfirm" onclick="confirmRules()" style="display:none;">✅ 我已阅读并确认</button>
            </div>
            <div class="rules-progress" id="rulesProgress" style="text-align:center;margin-top:0.6rem;"></div>
        </div>
    </div>

    <!-- 游客登录入口 -->
    <div id="guestEntry" style="display:none;">
        <div class="ge-box">
            <div class="ge-title">👋 欢迎进入狼人杀</div>
            <div class="ge-desc">选择头像并输入昵称，以游客身份加入</div>
            <input type="text" id="guestName" maxlength="12" placeholder="输入昵称…" />
            <div class="ge-avatars" id="geAvatars"></div>
            <button class="ge-btn" onclick="joinRoom()">🎮 加入游戏</button>
        </div>
    </div>

    <!-- 粒子背景 -->
    <canvas id="particleCanvas"></canvas>

    <div class="container">

        <!-- 头部 -->
        <div class="header">
            <div class="brand">
                <span class="icon">🐺</span>
                <div>
                    <h1>狼人杀 · 座位图</h1>
                    <span class="sub">✦ 点击空位坐下 · 点击玩家换座 ✦</span>
                </div>
            </div>
            <div class="status-group">
                <span class="room-badge">✦ 房间 <span id="roomDisplay">@roomId</span></span>
                <span class="user-badge">
                    <span class="avatar">@(username?.FirstOrDefault().ToString().ToUpper() ?? "A")</span>
                    <span>@username</span>
                </span>
                <span style="font-size:0.6rem;color:rgba(255,255,255,0.04);">
                    <span class="status-dot"></span> 在线
                </span>
            </div>
        </div>

        <!-- 主网格 -->
        <div class="main-grid">

            <!-- 座位图 -->
            <div class="seating-area">
                <div class="area-title">
                    🪑 座位图
                    <span class="count" id="seatCount">0/12 已占</span>
                    <span class="hint" style="font-size:0.5rem;color:rgba(255,255,255,0.04);margin-left:auto;letter-spacing:0.06em;">👆 点击交互</span>
                </div>
                <div class="table-container" id="tableContainer">
                    <div class="table-bg"></div>
                    <div class="table-pattern"></div>
                    <div class="table-center">
                        <span class="icon">🐺</span>
                        <span class="label">狼人杀</span>
                    </div>
                    <div id="seatsContainer"></div>
                </div>
            </div>

            <!-- 右侧面板 -->
            <div class="side-panel" style="display:flex;flex-direction:column;gap:16px;height:100%;">

                <!-- 玩家列表 -->
                <div class="holo-card" style="flex:1;min-height:0;">
                    <div class="card-title">
                        👥 玩家列表
                        <span class="accent"></span>
                        <span class="badge-count" style="font-size:0.5rem;padding:0.1rem 0.6rem;border-radius:20px;background:rgba(139,92,246,0.04);color:rgba(255,255,255,0.1);border:1px solid rgba(139,92,246,0.02);" id="playerCountBadge">0 人</span>
                    </div>

                    <div class="player-list" id="playerList">
                        <div class="player-empty">✦ 等待玩家接入 ✦</div>
                    </div>
                </div>

                <!-- 控制栏 -->
                <div class="holo-card" style="flex:0.6;">
                    <div class="card-title">
                        🎮 控制
                        <span class="accent"></span>
                    </div>

                    <div class="host-actions">
                        <button class="btn-primary" id="startBtn" onclick="startGame()" disabled>
                            🃏 洗牌发牌
                        </button>
                        <button class="btn-secondary" onclick="refreshRoom()">🔄 刷新</button>
                        <button class="btn-bot" onclick="addBots(3)">🤖 +3机器人</button>
                        <span class="status-text" id="actionStatus">● 等待玩家就坐</span>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- 换座弹窗 -->
    <div class="swap-modal-overlay" id="swapModal">
        <div class="swap-modal">
            <div class="modal-icon">🔄</div>
            <h3 id="swapModalTitle">换座请求</h3>
            <p id="swapModalDesc">玩家想和你交换座位</p>
            <div class="player-info" id="swapPlayerInfo">
                <span class="avatar" id="swapAvatar">🧑</span>
                <span class="name" id="swapName">玩家</span>
                <span class="seat" id="swapSeat">#0</span>
            </div>
            <div class="btn-group">
                <button class="btn-swap accept" onclick="acceptSwap()">✅ 接受</button>
                <button class="btn-swap reject" onclick="rejectSwap()">✕ 拒绝</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>

    <script>
        // ============================================================
        // 粒子背景
        // ============================================================
        (function initParticles() {
            var canvas = document.getElementById('particleCanvas');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var particles = [];
            var count = Math.min(80, Math.floor(window.innerWidth / 8));

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            var colors = ['rgba(139,92,246,', 'rgba(236,72,153,', 'rgba(245,158,11,', 'rgba(0,240,255,'];
            for (var i = 0; i < count; i++) {
                var color = colors[Math.floor(Math.random() * colors.length)];
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.06,
                    vy: (Math.random() - 0.5) * 0.06,
                    r: Math.random() * 1.2 + 0.3,
                    o: Math.random() * 0.08 + 0.01,
                    color: color
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                for (var p of particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.color + p.o + ')';
                    ctx.fill();
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // 游戏状态
        // ============================================================
        var state = {
            roomId: '@roomId',
            playerId: null,
            seatNumber: 0,
            isHost: true,
            isReady: false,
            players: [],
            seats: [],
            mySeat: null,
            swapTarget: null
        };

        var connection = null;
        var swapRequestId = null;

        // ============================================================
        // SignalR
        // ============================================================
        // ============ 身份牌揭晓 ============
        var ROLE_INFO = {
            Villager: ['👤', '平民', '无特殊技能，通过发言投票找出狼人', '#4ade80'],
            Werewolf: ['🐺', '狼人', '每晚与狼队友共同杀害一名玩家', '#f87171'],
            Seer: ['🔮', '预言家', '每晚查验一名玩家的身份', '#60a5fa'],
            Witch: ['🧪', '女巫', '解药救人，毒药杀人', '#a78bfa'],
            Guard: ['🛡️', '守卫', '每晚守护一名玩家免受袭击', '#34d399'],
            Hunter: ['🔫', '猎人', '死亡时可开枪带走一名玩家', '#fb923c'],
            Fool: ['🤡', '白痴', '被投票放逐时可翻牌免死一次', '#facc15'],
            Knight: ['⚔️', '骑士', '白天可挑战一名玩家', '#fbbf24'],
            Bomber: ['💣', '炸弹人', '被放逐时随机带走一名投自己的玩家', '#f87171'],
            WolfBeauty: ['💃', '狼美人', '狼人阵营，夜晚可魅惑一名玩家', '#ec4899'],
            WhiteWolfKing: ['🤍', '白狼王', '狼人阵营，死亡可开枪', '#f9a8d4'],
            OldRogue: ['🧔', '老流氓', '神民，可免疫一次放逐', '#a78bfa'],
            BearTamer: ['🐻', '训熊师', '神民，夜晚可查验相邻玩家是否有狼', '#fbbf24'],
            WildChild: ['🧒', '野孩子', '首夜认榜样，榜样出局则变狼', '#34d399']
        };
        var ROLE_IMG = {
            Villager: '平民.jpg', Werewolf: '狼人.jpg', Seer: '预言家.jpg', Witch: '女巫.jpg',
            Guard: '守卫.jpg', Hunter: '猎人.jpg', Fool: '白痴.jpg', Knight: '骑士.jpg',
            WolfKing: '狼王.jpg', Elder: '平民.jpg', Cupid: '丘比特.jpg', Thief: '盗贼.jpg',
            SilenceElder: '禁言长老.jpg', HiddenWolf: '隐狼.jpg',
            Bomber: '炸弹人.jpg', WolfBeauty: '狼美人.jpg', WhiteWolfKing: '白狼王.jpg',
            OldRogue: '老流氓.jpg', BearTamer: '训熊师.jpg', WildChild: '野孩子.jpg'
        };
        function showRoleCard(role, lowerRole) {
            var info = ROLE_INFO[role] || ['👤', role || '?', '', '#4ade80'];
            document.getElementById('roleImg').src = '/images/werewolf/' + (ROLE_IMG[role] || '平民.jpg');
            document.getElementById('roleName').textContent = info[1];
            document.getElementById('roleName').style.color = info[3];
            document.getElementById('roleCard').style.boxShadow = '0 20px 60px ' + info[3] + '66, 0 0 30px ' + info[3] + '33';
            var desc = info[2];
            if (lowerRole) {
                var li = ROLE_INFO[lowerRole] || ['👤', lowerRole, '', '#fff'];
                desc += '<br><span style="color:#F59E0B;font-size:0.8em;">🃏 下身份：' + li[0] + ' ' + li[1] + '</span>';
            }
            document.getElementById('roleDesc').innerHTML = desc;
            var overlay = document.getElementById('roleRevealOverlay');
            var card = document.getElementById('roleCard');
            card.classList.remove('flipped');
            overlay.classList.add('show');
            setTimeout(function () { card.classList.add('flipped'); }, 350);
            setTimeout(function () { roleBurst(info[3]); }, 500);
        }
        function roleBurst(color) {
            var card = document.getElementById('roleCard');
            if (!card) return;
            var r = card.getBoundingClientRect();
            var cx = r.left + r.width / 2;
            var cy = r.top + r.height / 2;
            for (var i = 0; i < 20; i++) {
                var p = document.createElement('div');
                p.className = 'role-particle';
                p.style.left = (cx - 4) + 'px';
                p.style.top = (cy - 4) + 'px';
                p.style.background = color;
                p.style.boxShadow = '0 0 12px ' + color;
                document.body.appendChild(p);
                var ang = (i / 20) * 360 * Math.PI / 180;
                var dist = 70 + Math.random() * 90;
                var dx = Math.cos(ang) * dist;
                var dy = Math.sin(ang) * dist;
                p.animate([
                    { transform: 'translate(0,0) scale(1)', opacity: 1 },
                    { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.2)', opacity: 0 }
                ], { duration: 750 + Math.random() * 400, easing: 'ease-out', fill: 'forwards' });
                setTimeout(function() { p.remove(); }, 1300);
            }
        }
        function hideRoleCard() {
            document.getElementById('roleRevealOverlay').classList.remove('show');
        }

        // ============ 规则说明弹窗 ============
        var RULES_PAGES = [
            { title: '🎯 胜利条件', items: ['⭐ 好人阵营：所有狼人出局', '🐺 狼人阵营（屠边）：所有神职出局 或 所有平民出局'] },
            { title: '🌙 昼夜流程', items: ['🌙 夜晚：守卫 → 预言家 → 狼人 → 女巫 → 天亮', '☀️ 白天：公布死讯 → 发言 → 投票 → 放逐 → 天黑'] },
            { title: '📢 发言规则', items: ['• 每人发言 60 秒', '• 从死者左手边开始顺序发言', '• 警长有归票权，投票算 1.5 票', '• 平票则 PK 发言，再平票则平安日'] },
            { title: '🃏 角色技能', items: ['🔮 预言家：每晚查验一名玩家', '🧪 女巫：解药救人、毒药杀人', '🛡️ 守卫：每晚守护一人', '🔫 猎人：死亡时可开枪带走一人', '🤡 白痴：被放逐时翻牌免死'] },
            { title: '⚡ 特殊规则', items: ['🛡️ 同守同救（奶穿）会死亡', '🔫 猎人被毒杀不能开枪', '💀 首夜女巫可自救，守卫首夜可自守', '💥 狼人白天可自爆，直接进入黑夜'] }
        ];
        var rulesIndex = 0;
        function renderRules() {
            var p = RULES_PAGES[rulesIndex];
            document.getElementById('rulesPage').textContent = (rulesIndex + 1) + '/' + RULES_PAGES.length;
            var html = '<div class="rb-title">' + p.title + '</div>';
            for (var i = 0; i < p.items.length; i++) html += '<div class="rb-item">' + p.items[i] + '</div>';
            document.getElementById('rulesBody').innerHTML = html;
            document.getElementById('rulesPrev').style.display = rulesIndex === 0 ? 'none' : 'block';
            document.getElementById('rulesNext').style.display = rulesIndex === RULES_PAGES.length - 1 ? 'none' : 'block';
            document.getElementById('rulesConfirm').style.display = rulesIndex === RULES_PAGES.length - 1 ? 'block' : 'none';
        }
        function showRules() { rulesIndex = 0; document.getElementById('rulesOverlay').classList.add('show'); renderRules(); }
        function hideRules() { document.getElementById('rulesOverlay').classList.remove('show'); }
        function rulesPrev() { if (rulesIndex > 0) { rulesIndex--; renderRules(); } }
        function rulesNext() { if (rulesIndex < RULES_PAGES.length - 1) { rulesIndex++; renderRules(); } }
        function confirmRules() {
            hideRules();
            if (connection && connection.state === signalR.HubConnectionState.Connected && state.playerId) {
                connection.invoke('ConfirmRules', state.playerId).catch(function() {});
            }
        }

        // ============ 游客头像选择 ============
        var GUEST_AVATARS = ['🐱', '🐶', '🐼', '🦊', '🐸', '🐵', '🦁', '🐯', '🐨', '🐷', '🐰', '🦄'];
        window.guestAvatar = '🐱';
        function renderGuestAvatars() {
            var html = '';
            GUEST_AVATARS.forEach(function(a) {
                html += '<div class="ge-avatar' + (a === window.guestAvatar ? ' sel' : '') + '" onclick="pickGuestAvatar(this,\'' + a + '\')">' + a + '</div>';
            });
            document.getElementById('geAvatars').innerHTML = html;
        }
        function pickGuestAvatar(el, a) {
            window.guestAvatar = a;
            var avs = document.querySelectorAll('.ge-avatar');
            for (var i = 0; i < avs.length; i++) avs[i].classList.remove('sel');
            el.classList.add('sel');
        }
        renderGuestAvatars();

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                // 事件监听
                connection.on('JoinedGame', function(data) {
                    if (data && data.success) {
                        state.playerId = data.playerId;
                        state.seatNumber = data.seatNumber || 0;
                        state.isHost = state.seatNumber === 0 || data.isHost === true;
                        showToast('✅ 已加入房间，你是 ' + (state.isHost ? '房主' : state.seatNumber + ' 号'), 'success');
                        updateUI();
                    }
                });

                connection.on('PlayerListUpdate', function(players) {
                    state.players = players || [];
                    updateUI();
                });

                connection.on('SeatUpdate', function(seatNumber, player) {
                    updateSeat(seatNumber, player);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SeatTaken', function(seatNumber, player) {
                    showToast('🪑 ' + player.nickname + ' 坐到了 ' + seatNumber + ' 号', 'success');
                    updateSeat(seatNumber, player);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SeatReleased', function(seatNumber) {
                    updateSeat(seatNumber, null);
                    updateUI();
                    updateSeatCount();
                });

                connection.on('SwapRequest', function(fromPlayer, targetSeat) {
                    var from = state.players.find(function(p) { return p.playerId === fromPlayer.playerId; });
                    if (!from) return;

                    swapRequestId = fromPlayer.playerId;
                    document.getElementById('swapAvatar').textContent = from.avatarEmoji || '🧑';
                    document.getElementById('swapName').textContent = from.nickname;
                    document.getElementById('swapSeat').textContent = '#' + targetSeat;
                    document.getElementById('swapModalTitle').textContent = '🔄 换座请求';
                    document.getElementById('swapModalDesc').textContent = from.nickname + ' 想和你交换座位';
                    document.getElementById('swapModal').classList.add('active');
                });

                connection.on('SwapAccepted', function(seat1, seat2, player1, player2) {
                    showToast('✅ ' + player1.nickname + ' 和 ' + player2.nickname + ' 交换了座位', 'success');
                    updateSeat(seat1, player2);
                    updateSeat(seat2, player1);
                    updateUI();
                    updateSeatCount();
                    document.getElementById('swapModal').classList.remove('active');
                });

                connection.on('SwapRejected', function(fromPlayer) {
                    showToast('❌ ' + fromPlayer.nickname + ' 拒绝了换座请求', 'error');
                    document.getElementById('swapModal').classList.remove('active');
                });

                connection.on('PhaseUpdate', function(phase) {
                    if (phase === 'dealing' || phase === 'revealing') {
                        document.getElementById('actionStatus').textContent = '● 发牌中...';
                        document.getElementById('startBtn').disabled = true;
                        setTimeout(function() {
                            window.location.href = '/Werewolf/Player?roomId=' + state.roomId;
                        }, 2000);
                    }
                    if (phase === 'gameover') {
                        document.getElementById('actionStatus').textContent = '● 游戏已结束';
                        document.getElementById('startBtn').disabled = true;
                    }
                });

                connection.on('ReceiveRole', function(data) {
                    if (data && !data.isSpectator) showRoleCard(data.role, data.lowerRole);
                });

                connection.on('PauseState', function(data) {
                    var ov = document.getElementById('pauseOverlay');
                    if (!ov) return;
                    if (data && data.paused) {
                        document.getElementById('pauseNames').textContent = '掉线：' + (data.names || '未知');
                        ov.classList.add('show');
                    } else {
                        ov.classList.remove('show');
                    }
                });

                connection.on('ShowRules', function(data) {
                    document.getElementById('rulesProgress').textContent = (data ? data.confirmed : 0) + '/' + (data ? data.total : 0) + ' 已确认';
                    showRules();
                });
                connection.on('RulesConfirmProgress', function(data) {
                    document.getElementById('rulesProgress').textContent = (data ? data.confirmed : 0) + '/' + (data ? data.total : 0) + ' 已确认';
                });

                connection.on('DisplayMessage', function(message) {
                    showToast('📢 ' + message, 'info');
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        if (@(ViewBag.IsLoggedIn ? "true" : "false")) {
                            joinRoom();
                        } else {
                            document.getElementById('guestEntry').style.display = 'flex';
                        }

                        // 心跳
                        setInterval(function() {
                            if (connection && connection.state === signalR.HubConnectionState.Connected && state
                                .playerId) {
                                connection.invoke('Heartbeat', state.playerId).catch(function() {});
                            }
                        }, 10000);
                    })
                    .catch(function(err) {
                        console.error('❌ 连接失败:', err);
                        showToast('⚠️ 连接失败，正在重试...', 'warning');
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
                showToast('⚠️ 连接失败，请刷新重试', 'error');
            }
        }

        // ============================================================
        // 加入房间（4个参数）
        // ============================================================
        function joinRoom() {
            if (!state.roomId || state.roomId === '') {
                showToast('⚠️ 房间号无效', 'error');
                return;
            }

            var loggedIn = @(ViewBag.IsLoggedIn ? "true" : "false");
            var accountName = '@ViewBag.Username';
            var nickname, avatar;
            if (loggedIn) {
                nickname = accountName || '玩家';
                avatar = '😊';
            } else {
                nickname = (document.getElementById('guestName') ? document.getElementById('guestName').value.trim() : '') || ('游客_' + Math.floor(Math.random() * 9000 + 1000));
                avatar = window.guestAvatar || '🐱';
            }

            connection.invoke('JoinGame', state.roomId, nickname, avatar, false)
                .then(function(result) {
                    if (result && result.success) {
                        state.playerId = result.playerId;
                        state.isHost = result.isHost === true;
                        state.seatNumber = result.seatNumber || 0;
                        document.getElementById('actionStatus').textContent = '● 已加入：' + nickname;
                        showToast('✅ 已加入房间', 'success');
                        // 重连后补拉身份牌
                        connection.invoke('GetMyRole', result.playerId).then(function(r) {
                            if (r && r.role && !r.isSpectator) showRoleCard(r.role, r.lowerRole);
                        }).catch(function() {});
                    } else if (result && !result.success) {
                        showToast('❌ ' + result.message, 'error');
                    }
                })
                .catch(function(err) {
                    console.error('加入房间失败:', err);
                    showToast('❌ 加入失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 生成座位
        // ============================================================
        function generateSeats() {
            var container = document.getElementById('seatsContainer');
            var count = 12;
            container.innerHTML = '';
            state.seats = [];
            var radius = 38;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';
                seat.onclick = function() {
                    var seatNum = parseInt(this.dataset.seat);
                    onSeatClick(seatNum);
                };

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);

                state.seats.push({
                    number: i + 1,
                    element: seat,
                    occupied: false,
                    player: null,
                    isReady: false,
                    isAI: false
                });
            }
            updateSeatCount();
        }

        // ============================================================
        // 更新座位
        // ============================================================
        function updateSeat(seatNumber, player) {
            var seat = state.seats.find(function(s) { return s.number === seatNumber; });
            if (!seat) return;

            if (player) {
                seat.occupied = true;
                seat.player = player;
                seat.isReady = player.isReady || false;
                seat.isAI = player.isAI || false;
                seat.element.className = 'seat occupied';
                if (player.playerId === state.playerId) {
                    seat.element.classList.add('self');
                    state.mySeat = seatNumber;
                }
                if (player.isReady) {
                    seat.element.classList.add('ready');
                }
                if (player.isHost) {
                    seat.element.classList.add('host');
                }
                if (player.isAI) {
                    seat.element.classList.add('ai');
                }
                seat.element.querySelector('.seat-name').textContent = player.nickname;
                seat.element.querySelector('.seat-emoji').textContent = player.avatarEmoji || '🧑';
            } else {
                seat.occupied = false;
                seat.player = null;
                seat.isReady = false;
                seat.isAI = false;
                seat.element.className = 'seat empty';
                if (state.mySeat === seatNumber) {
                    state.mySeat = null;
                }
                seat.element.querySelector('.seat-name').textContent = '空位';
                seat.element.querySelector('.seat-emoji').textContent = '🪑';
            }
        }

        // ============================================================
        // 座位点击处理
        // ============================================================
        function onSeatClick(seatNumber) {
            var seat = state.seats.find(function(s) { return s.number === seatNumber; });
            if (!seat) return;

            if (seat.occupied && seat.player && seat.player.playerId === state.playerId) {
                showToast('💡 这是你的座位', 'info');
                return;
            }

            // 空位 → 坐下
            if (!seat.occupied) {
                connection.invoke('TakeSeat', state.playerId, seatNumber)
                    .then(function(result) {
                        if (result && result.success) {
                            showToast('🪑 你坐到了 ' + seatNumber + ' 号', 'success');
                        } else if (result && !result.success) {
                            showToast('❌ ' + result.message, 'error');
                        }
                    })
                    .catch(function(err) {
                        showToast('❌ 坐下失败: ' + err, 'error');
                    });
                return;
            }

            // 已占座位 → 请求换座
            if (seat.occupied && seat.player && seat.player.playerId !== state.playerId) {
                if (confirm('要请求 ' + seat.player.nickname + ' 和你换座位吗？')) {
                    connection.invoke('RequestSwapSeat', state.playerId, seatNumber)
                        .then(function(result) {
                            if (result && result.success) {
                                showToast('📨 已发送换座请求给 ' + seat.player.nickname, 'info');
                            } else if (result && !result.success) {
                                showToast('❌ ' + result.message, 'error');
                            }
                        })
                        .catch(function(err) {
                            showToast('❌ 请求失败: ' + err, 'error');
                        });
                }
            }
        }

        // ============================================================
        // 接受/拒绝换座
        // ============================================================
        function acceptSwap() {
            if (!swapRequestId) return;
            connection.invoke('AcceptSwapSeat', state.playerId, swapRequestId, true)
                .catch(function(err) { showToast('❌ 接受失败: ' + err, 'error'); });
            document.getElementById('swapModal').classList.remove('active');
            swapRequestId = null;
        }

        function rejectSwap() {
            if (!swapRequestId) return;
            connection.invoke('AcceptSwapSeat', state.playerId, swapRequestId, false)
                .catch(function(err) { showToast('❌ 拒绝失败: ' + err, 'error'); });
            document.getElementById('swapModal').classList.remove('active');
            swapRequestId = null;
        }

        // ============================================================
        // 添加机器人
        // ============================================================
        function addBots(count) {
            if (!connection || !state.roomId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }

            if (!confirm('确定要添加 ' + count + ' 个机器人吗？（仅测试用）')) return;

            connection.invoke('AddBots', state.roomId, count)
                .then(function(result) {
                    if (result && result.success) {
                        showToast('✅ ' + result.message, 'success');
                    } else {
                        showToast('❌ ' + (result?.message || '添加失败'), 'error');
                    }
                })
                .catch(function(err) {
                    showToast('❌ 添加失败: ' + err, 'error');
                });
        }

        // ============================================================
        // 更新UI
        // ============================================================
        function updateUI() {
            var players = state.players || [];
            var total = players.filter(function(p) { return !p.isSpectator; }).length;
            var ready = players.filter(function(p) { return p.isReady && !p.isSpectator; }).length;

            document.getElementById('playerCountBadge').textContent = total + ' 人';
            updatePlayerList(players);

            var seated = players.filter(function(p) { return p.seatNumber > 0 && !p.isSpectator; });
            seated.forEach(function(p) {
                updateSeat(p.seatNumber, p);
            });

            var occupied = state.seats.filter(function(s) { return s.occupied; }).length;
            var allReady = state.seats.filter(function(s) { return s.occupied && !s.isReady; }).length === 0;

            var btn = document.getElementById('startBtn');
            if (occupied >= 2 && allReady) {
                btn.disabled = false;
                document.getElementById('actionStatus').textContent = '● ' + occupied + '/' + state.seats.length + ' 已就坐，可以发牌';
            } else {
                btn.disabled = true;
                var msg = occupied < 2 ? '需要至少2人就坐' : '等待所有玩家准备';
                document.getElementById('actionStatus').textContent = '● ' + msg;
            }
        }

        function updatePlayerList(players) {
            var container = document.getElementById('playerList');

            if (!players || players.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var sorted = players.filter(function(p) { return !p.isSpectator; }).sort(function(a, b) {
                return (a.seatNumber || 99) - (b.seatNumber || 99);
            });

            if (sorted.length === 0) {
                container.innerHTML = '<div class="player-empty">✦ 等待玩家接入 ✦</div>';
                return;
            }

            var html = '';
            sorted.forEach(function(p) {
                var isReady = p.isReady || false;
                var isSelf = p.playerId === state.playerId;
                var isHost = p.isHost || false;
                var isAI = p.isAI || false;
                var seatDisplay = p.seatNumber > 0 ? '#' + p.seatNumber : '💺';

                html += '<div class="player-item">';
                html += '<span class="avatar">' + (p.avatarEmoji || '🧑') + '</span>';
                html += '<div class="info">';
                html += '<span class="name">' + p.nickname + (isSelf ? ' <span class="me">(你)</span>' : '');
                if (isAI) { html += ' <span class="ai-tag">🤖 AI</span>'; }
                html += '<span class="seat-tag">' + seatDisplay + '</span>';
                html += '</span></div>';
                var statusClass = isHost ? 'host' : (isAI ? 'ai' : (isReady ? 'ready' : 'waiting'));
                var statusText = isHost ? '👑 房主' : (isAI ? '🤖 AI' : (isReady ? '✅ 已准备' : '⏳ 等待'));
                html += '<span class="status ' + statusClass + '">' + statusText + '</span>';
                html += '</div>';
            });

            container.innerHTML = html;
        }

        function updateSeatCount() {
            var occupied = state.seats.filter(function(s) { return s.occupied; }).length;
            document.getElementById('seatCount').textContent = occupied + '/' + state.seats.length + ' 已占';
        }

        // ============================================================
        // 开始游戏
        // ============================================================
        function startGame() {
            if (!connection || !state.roomId) {
                showToast('⚠️ 房间未创建', 'warning');
                return;
            }

            var btn = document.getElementById('startBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 发牌中...';

            connection.invoke('StartDealing', state.roomId)
                .catch(function(err) {
                    console.error('开始游戏失败:', err);
                    showToast('❌ 开始失败: ' + err, 'error');
                    btn.disabled = false;
                    btn.textContent = '🃏 洗牌发牌';
                });
        }

        // ============================================================
        // 刷新
        // ============================================================
        function refreshRoom() {
            showToast('🔄 刷新中...', 'info');
            if (connection && state.roomId) {
                connection.invoke('JoinGame', state.roomId, '@username', '👑', true)
                    .catch(function() {});
            }
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🐺 狼人杀座位图启动...');
            generateSeats();
            connectSignalR();
        });
    </script>

</body>
</html>
