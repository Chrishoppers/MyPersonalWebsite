@{
    Layout = null;
    ViewData["Title"] = "🐺 狼人杀 · 主控台";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>🐺 狼人杀 · 主控台</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        /* ============================================================
           全局
           ============================================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #05050F;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 16px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        /* ============================================================
           顶部
           ============================================================ */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0 20px;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            flex-wrap: wrap;
            gap: 12px;
        }

        .header .logo {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header .logo span { font-size: 1.8rem; -webkit-text-fill-color: initial; }

        .header .status {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        .header .status .dot.online { background: #00FF88; animation: pulse 2s infinite; }
        .header .status .dot.waiting { background: #F59E0B; animation: pulse 2s infinite; }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.2); }
        }

        /* ============================================================
           主体
           ============================================================ */
        .main-content {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 20px;
            margin-top: 20px;
        }

        @@media (max-width: 1100px) {
            .main-content { grid-template-columns: 1fr; }
        }

        /* ============================================================
           座位图
           ============================================================ */
        .seating-area {
            background: rgba(255,255,255,0.02);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 24px;
            padding: 24px;
            min-height: 500px;
            position: relative;
            overflow: hidden;
        }

        .seating-area .area-title {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.15);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .seating-area .area-title .count {
            color: #00F0FF;
            font-weight: 700;
            font-size: 0.8rem;
        }

        /* ===== 桌子 ===== */
        .table-container {
            position: relative;
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            aspect-ratio: 1 / 0.85;
        }

        .table-bg {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(ellipse at center, rgba(30, 20, 60, 0.3), rgba(10, 10, 30, 0.6));
            border: 2px solid rgba(139, 92, 246, 0.04);
            box-shadow: 0 0 80px rgba(139, 92, 246, 0.02), inset 0 0 80px rgba(0, 0, 0, 0.3);
        }

        .table-bg::after {
            content: '';
            position: absolute;
            inset: 10%;
            border-radius: 50%;
            background: radial-gradient(ellipse at 40% 40%, rgba(139, 92, 246, 0.02), transparent 70%);
        }

        .table-pattern {
            position: absolute;
            inset: 15%;
            border-radius: 50%;
            background-image: 
                repeating-conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,255,255,0.005) 5deg, transparent 10deg);
            opacity: 0.3;
            pointer-events: none;
        }

        .table-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
            z-index: 2;
        }

        .table-center .icon { font-size: 2.4rem; opacity: 0.1; display: block; }
        .table-center .label { font-size: 0.5rem; color: rgba(255,255,255,0.02); text-transform: uppercase; letter-spacing: 0.2em; margin-top: 4px; }

        /* ===== 座位 ===== */
        .seat {
            position: absolute;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255,255,255,0.02);
            border: 2px solid rgba(255,255,255,0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 3;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.15);
            user-select: none;
            transform: translate(-50%, -50%);
        }

        .seat .seat-number {
            font-size: 0.9rem;
            font-weight: 700;
            font-family: 'Courier New', monospace;
            color: rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }

        .seat .seat-name {
            font-size: 0.45rem;
            font-weight: 500;
            color: rgba(255,255,255,0.04);
            max-width: 44px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .seat .seat-emoji { font-size: 0.6rem; display: none; }

        .seat.occupied {
            border-color: rgba(0, 240, 255, 0.12);
            background: rgba(0, 240, 255, 0.03);
        }

        .seat.occupied .seat-number { color: rgba(0, 240, 255, 0.3); }
        .seat.occupied .seat-name { color: rgba(255,255,255,0.15); }

        .seat.ready {
            border-color: rgba(0, 255, 136, 0.15);
            background: rgba(0, 255, 136, 0.03);
            box-shadow: 0 0 40px rgba(0, 255, 136, 0.02);
        }

        .seat.ready .seat-number { color: #00FF88; }

        .seat.empty:hover {
            border-color: rgba(139, 92, 246, 0.15);
            background: rgba(139, 92, 246, 0.04);
            transform: translate(-50%, -50%) scale(1.08);
        }

        .seat.dead {
            border-color: rgba(220, 53, 69, 0.08);
            background: rgba(220, 53, 69, 0.02);
            opacity: 0.3;
        }

        .seat.sheriff {
            border-color: #F59E0B;
            box-shadow: 0 0 40px rgba(245, 158, 11, 0.05);
            animation: sheriffGlow 2s ease-in-out infinite;
        }

        @@keyframes sheriffGlow {
            0%, 100% { box-shadow: 0 0 20px rgba(245, 158, 11, 0.02); }
            50% { box-shadow: 0 0 60px rgba(245, 158, 11, 0.08); }
        }

        .seat.sheriff .seat-number { color: #F59E0B; }

        /* ===== 发牌动画卡片 ===== */
        .card-fly {
            position: fixed;
            width: 70px;
            height: 98px;
            border-radius: 12px;
            background: transparent;
            z-index: 999;
            pointer-events: none;
            transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            opacity: 0;
            transform: scale(0.3) rotate(180deg);
            box-shadow: 0 0 60px rgba(139, 92, 246, 0.05);
        }

        .card-fly.show {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }

        .card-fly img {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            object-fit: cover;
            box-shadow: 0 0 60px rgba(139, 92, 246, 0.05);
        }

        /* ============================================================
           右侧面板
           ============================================================ */
        .side-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .panel-card {
            background: rgba(255,255,255,0.02);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 20px;
            padding: 18px 20px;
            transition: all 0.4s ease;
        }

        .panel-card:hover { border-color: rgba(255,255,255,0.06); }

        .panel-card .card-title {
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.15);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-card .card-title .accent {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,255,255,0.04), transparent);
        }

        .config-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .config-btn {
            padding: 8px 6px;
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 12px;
            background: rgba(255,255,255,0.02);
            color: rgba(255,255,255,0.2);
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            text-align: center;
        }

        .config-btn:hover {
            border-color: rgba(139,92,246,0.12);
            background: rgba(139,92,246,0.03);
        }

        .config-btn.active {
            border-color: #8B5CF6;
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
        }

        .config-btn .sub {
            display: block;
            font-size: 0.5rem;
            font-weight: 400;
            color: rgba(255,255,255,0.06);
            margin-top: 2px;
        }

        .role-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }

        .role-option {
            padding: 8px 4px;
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 10px;
            background: rgba(255,255,255,0.02);
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            font-family: inherit;
            color: rgba(255,255,255,0.2);
            font-size: 0.65rem;
        }

        .role-option:hover {
            border-color: rgba(139,92,246,0.1);
            background: rgba(139,92,246,0.03);
        }

        .role-option.selected {
            border-color: #8B5CF6;
            background: rgba(139,92,246,0.06);
            color: #8B5CF6;
        }

        .role-option .icon { font-size: 1.2rem; display: block; }
        .role-option .name { font-weight: 600; }
        .role-option .desc { font-size: 0.45rem; color: rgba(255,255,255,0.06); display: block; margin-top: 2px; }

        .action-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-action {
            flex: 1;
            padding: 10px 14px;
            border: none;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s ease;
            font-family: inherit;
            min-width: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-action.primary {
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
        }

        .btn-action.primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(139, 92, 246, 0.15);
        }

        .btn-action.primary:disabled {
            opacity: 0.3;
            cursor: not-allowed;
            transform: none !important;
        }

        .btn-action.secondary {
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.04);
            color: rgba(255,255,255,0.2);
        }

        .btn-action.secondary:hover:not(:disabled) {
            background: rgba(255,255,255,0.04);
            color: #fff;
        }

        .btn-action.success {
            background: linear-gradient(135deg, #00FF88, #00F0FF);
            color: #05050F;
        }

        .btn-action.success:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 40px rgba(0, 255, 136, 0.1);
        }

        .btn-action.danger {
            background: rgba(255, 0, 110, 0.08);
            border: 1px solid rgba(255, 0, 110, 0.04);
            color: rgba(255, 0, 110, 0.3);
        }

        .btn-action.danger:hover:not(:disabled) {
            background: rgba(255, 0, 110, 0.12);
        }

        .status-info {
            font-size: 0.75rem;
            color: rgba(255,255,255,0.08);
            line-height: 1.8;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255,255,255,0.02);
        }

        /* ============================================================
           发牌遮罩
           ============================================================ */
        .dealing-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.92);
            backdrop-filter: blur(30px);
            z-index: 9998;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        .dealing-overlay.active { display: flex; }

        .dealing-overlay .title {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
            animation: titlePulse 2s ease-in-out infinite;
        }

        @@keyframes titlePulse {
            0%, 100% { opacity: 0.6; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.02); }
        }

        .dealing-overlay .sub {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.1);
            letter-spacing: 0.2em;
        }

        .dealing-overlay .progress-ring {
            margin-top: 30px;
            width: 60px;
            height: 60px;
            border: 3px solid rgba(255,255,255,0.02);
            border-top-color: #8B5CF6;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .dealing-overlay .deal-progress-text {
            margin-top: 20px;
            font-size: 0.7rem;
            color: rgba(255,255,255,0.04);
        }

        /* ============================================================
           Toast
           ============================================================ */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 4px;
            align-items: flex-end;
        }

        .toast-msg {
            padding: 8px 18px;
            border-radius: 40px;
            color: #fff;
            font-weight: 500;
            animation: toastIn 0.4s ease;
            font-size: 0.8rem;
            backdrop-filter: blur(20px);
            background: rgba(10, 10, 30, 0.8);
            border: 1px solid rgba(255,255,255,0.04);
        }

        .toast-msg.success { background: rgba(0, 255, 136, 0.08); border-color: rgba(0, 255, 136, 0.04); color: #00FF88; }
        .toast-msg.error { background: rgba(255, 0, 110, 0.08); border-color: rgba(255, 0, 110, 0.04); color: #FF006E; }
        .toast-msg.info { background: rgba(0, 240, 255, 0.06); border-color: rgba(0, 240, 255, 0.04); color: #00F0FF; }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 768px) {
            body { padding: 10px; }
            .header .logo { font-size: 1.2rem; }
            .header .status { font-size: 0.6rem; }
            .seating-area { padding: 14px; min-height: 300px; }
            .seat { width: 40px; height: 40px; }
            .seat .seat-number { font-size: 0.65rem; }
            .seat .seat-name { font-size: 0.35rem; max-width: 30px; }
            .table-container { max-width: 100%; }
            .dealing-overlay .title { font-size: 1.4rem; }
            .config-grid { grid-template-columns: 1fr; }
            .role-grid { grid-template-columns: repeat(2, 1fr); }
            .panel-card { padding: 12px 14px; }
            .action-buttons { flex-direction: column; }
            .card-fly { width: 50px; height: 70px; }
        }

        @@media (max-width: 480px) {
            .seat { width: 32px; height: 32px; }
            .seat .seat-number { font-size: 0.5rem; }
            .seat .seat-name { display: none; }
            .seat .seat-emoji { display: block; font-size: 0.8rem; }
            .seating-area { padding: 10px; min-height: 250px; }
            .table-center .icon { font-size: 1.4rem; }
            .card-fly { width: 40px; height: 56px; }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- 顶部 -->
        <div class="header">
            <div class="logo">
                <span>🐺</span> 狼人杀 · 主控台
            </div>
            <div class="status">
                <span class="dot online"></span> 在线
                <span id="playerCountDisplay">0/0 人</span>
                <span style="color:rgba(255,255,255,0.04);">|</span>
                <span id="phaseDisplay" style="color:rgba(255,255,255,0.08);">⚙️ 设置中</span>
            </div>
        </div>

        <!-- 主体 -->
        <div class="main-content">

            <!-- 座位图 -->
            <div class="seating-area" id="seatingArea">
                <div class="area-title">
                    🪑 座位图
                    <span class="count" id="seatCount">0/0 已占</span>
                </div>

                <div class="table-container" id="tableContainer">
                    <div class="table-bg"></div>
                    <div class="table-pattern"></div>
                    <div class="table-center">
                        <span class="icon">🐺</span>
                        <span class="label">狼人杀</span>
                    </div>
                    <div id="seatsContainer"></div>
                </div>
            </div>

            <!-- 右侧面板 -->
            <div class="side-panel">

                <!-- 游戏设置 -->
                <div class="panel-card">
                    <div class="card-title">
                        ⚙️ 游戏设置
                        <span class="accent"></span>
                    </div>

                    <div style="margin-bottom:10px;">
                        <div style="font-size:0.6rem;color:rgba(255,255,255,0.08);margin-bottom:4px;">👥 玩家人数</div>
                        <div class="config-grid" id="playerCountSelector">
                            <button class="config-btn" data-count="8" onclick="selectPlayerCount(8)">
                                8人
                                <span class="sub">2狼·3神·3民</span>
                            </button>
                            <button class="config-btn active" data-count="10" onclick="selectPlayerCount(10)">
                                10人
                                <span class="sub">3狼·3神·4民</span>
                            </button>
                            <button class="config-btn" data-count="12" onclick="selectPlayerCount(12)">
                                12人
                                <span class="sub">4狼·4神·4民</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <div style="font-size:0.6rem;color:rgba(255,255,255,0.08);margin-bottom:4px;">🃏 神职配置</div>
                        <div class="role-grid" id="roleSelector">
                            <div class="role-option selected" data-role="预言家" onclick="toggleRole(this)">
                                <span class="icon">🔮</span>
                                <span class="name">预言家</span>
                            </div>
                            <div class="role-option selected" data-role="女巫" onclick="toggleRole(this)">
                                <span class="icon">🧪</span>
                                <span class="name">女巫</span>
                            </div>
                            <div class="role-option selected" data-role="守卫" onclick="toggleRole(this)">
                                <span class="icon">🛡️</span>
                                <span class="name">守卫</span>
                            </div>
                            <div class="role-option" data-role="猎人" onclick="toggleRole(this)">
                                <span class="icon">🔫</span>
                                <span class="name">猎人</span>
                            </div>
                            <div class="role-option" data-role="白痴" onclick="toggleRole(this)">
                                <span class="icon">🤡</span>
                                <span class="name">白痴</span>
                            </div>
                            <div class="role-option" data-role="骑士" onclick="toggleRole(this)">
                                <span class="icon">⚔️</span>
                                <span class="name">骑士</span>
                            </div>
                        </div>
                        <div style="font-size:0.45rem;color:rgba(255,255,255,0.04);margin-top:4px;text-align:center;">
                            💡 选择本局使用的神职角色
                        </div>
                    </div>
                </div>

                <!-- 操作 -->
                <div class="panel-card">
                    <div class="card-title">
                        🎮 控制
                        <span class="accent"></span>
                    </div>

                    <div class="action-buttons">
                        <button class="btn-action primary" id="startGameBtn" onclick="startGame()">
                            🃏 洗牌发牌
                        </button>
                        <button class="btn-action secondary" onclick="resetSeats()">
                            🔄 重置
                        </button>
                    </div>

                    <div class="status-info" id="gameStatusText">
                        📌 请选择人数和角色配置，然后点击"洗牌发牌"
                    </div>
                </div>

                <!-- 玩家列表 -->
                <div class="panel-card">
                    <div class="card-title">
                        👥 玩家列表
                        <span class="accent"></span>
                        <span style="font-size:0.6rem;color:rgba(255,255,255,0.06);font-weight:400;" id="playerListCount">0</span>
                    </div>
                    <div id="playerList" style="max-height:120px;overflow-y:auto;font-size:0.75rem;color:rgba(255,255,255,0.1);line-height:2;">
                        <span style="color:rgba(255,255,255,0.04);">暂无玩家</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 发牌遮罩 -->
    <div class="dealing-overlay" id="dealingOverlay">
        <div class="title">🃏 洗牌中...</div>
        <div class="sub">✦ 请稍候 ✦</div>
        <div class="progress-ring"></div>
        <div class="deal-progress-text" id="dealProgressText">准备发牌...</div>
    </div>

    <!-- Toast -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js">
    </script>

    <script>
        // ============================================================
        // 角色图片映射
        // ============================================================
        var roleImages = {
            '狼人': '/images/werewolf/cards/狼人.jpg',
            '预言家': '/images/werewolf/cards/预言家.jpg',
            '女巫': '/images/werewolf/cards/女巫.jpg',
            '守卫': '/images/werewolf/cards/守卫.jpg',
            '猎人': '/images/werewolf/cards/猎人.jpg',
            '白痴': '/images/werewolf/cards/白痴.jpg',
            '骑士': '/images/werewolf/cards/骑士.jpg',
            '平民': '/images/werewolf/cards/平民.jpg'
        };

        var cardBackImage = '/images/werewolf/cards/card_back.jpg';

        // ============================================================
        // 配置
        // ============================================================
        var config = {
            playerCount: 10,
            selectedRoles: ['预言家', '女巫', '守卫'],
            players: [],
            seats: [],
            isDealing: false,
            isGameStarted: false,
            roomId: null
        };

        // ============================================================
        // 座位图生成
        // ============================================================
        function generateSeats() {
            var container = document.getElementById('seatsContainer');
            var count = config.playerCount;
            container.innerHTML = '';

            config.seats = [];
            var radius = 38;

            for (var i = 0; i < count; i++) {
                var angle = (i / count) * 360 - 90;
                var rad = angle * Math.PI / 180;
                var x = 50 + radius * Math.cos(rad);
                var y = 50 + radius * Math.sin(rad);

                var seat = document.createElement('div');
                seat.className = 'seat empty';
                seat.dataset.seat = i + 1;
                seat.style.left = x + '%';
                seat.style.top = y + '%';

                var numberSpan = document.createElement('span');
                numberSpan.className = 'seat-number';
                numberSpan.textContent = i + 1;
                seat.appendChild(numberSpan);

                var nameSpan = document.createElement('span');
                nameSpan.className = 'seat-name';
                nameSpan.textContent = '空位';
                seat.appendChild(nameSpan);

                var emojiSpan = document.createElement('span');
                emojiSpan.className = 'seat-emoji';
                emojiSpan.textContent = '🪑';
                seat.appendChild(emojiSpan);

                container.appendChild(seat);

                config.seats.push({
                    number: i + 1,
                    element: seat,
                    occupied: false,
                    player: null,
                    isDead: false,
                    isSheriff: false
                });
            }

            updateSeatCount();
        }

        function updateSeatCount() {
            var occupied = config.seats.filter(function(s) { return s.occupied; }).length;
            document.getElementById('seatCount').textContent = occupied + '/' + config.seats.length;
            document.getElementById('playerCountDisplay').textContent = occupied + '/' + config.seats.length;
        }

        // ============================================================
        // 玩家选择人数
        // ============================================================
        function selectPlayerCount(count) {
            if (config.isGameStarted) {
                showToast('⚠️ 游戏已开始，无法更改人数', 'error');
                return;
            }

            config.playerCount = count;

            document.querySelectorAll('#playerCountSelector .config-btn').forEach(function(btn) {
                btn.classList.toggle('active', parseInt(btn.dataset.count) === count);
            });

            var defaultRoles = {
                8: ['预言家', '女巫', '猎人'],
                10: ['预言家', '女巫', '守卫'],
                12: ['预言家', '女巫', '守卫', '猎人']
            };

            var roles = defaultRoles[count] || ['预言家', '女巫', '守卫'];

            document.querySelectorAll('#roleSelector .role-option').forEach(function(el) {
                var isSelected = roles.indexOf(el.dataset.role) !== -1;
                el.classList.toggle('selected', isSelected);
            });

            config.selectedRoles = roles;
            generateSeats();
            updatePlayerList();
            showToast('✅ 已切换至 ' + count + ' 人局', 'success');
        }

        // ============================================================
        // 角色切换
        // ============================================================
        function toggleRole(element) {
            if (config.isGameStarted) {
                showToast('⚠️ 游戏已开始，无法更改配置', 'error');
                return;
            }

            element.classList.toggle('selected');

            config.selectedRoles = [];
            document.querySelectorAll('#roleSelector .role-option.selected').forEach(function(el) {
                config.selectedRoles.push(el.dataset.role);
            });

            showToast('✅ 已更新角色配置', 'info');
        }

        // ============================================================
        // 更新玩家列表
        // ============================================================
        function updatePlayerList() {
            var container = document.getElementById('playerList');
            var occupied = config.seats.filter(function(s) { return s.occupied; });

            if (occupied.length === 0) {
                container.innerHTML = '<span style="color:rgba(255,255,255,0.04);">暂无玩家</span>';
                document.getElementById('playerListCount').textContent = '0';
                return;
            }

            var html = '';
            occupied.forEach(function(seat) {
                var player = seat.player;
                var isReady = player && player.isReady;
                var isDead = seat.isDead;
                var isSheriff = seat.isSheriff;

                html += '<div style="display:flex;align-items:center;gap:6px;padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.02);' +
                    (isDead ? 'opacity:0.3;' : '') + '">';
                html += '<span style="font-size:0.6rem;color:rgba(255,255,255,0.05);">#' + seat.number + '</span>';
                html += '<span style="font-size:0.8rem;">' + (player && player.avatar ? player.avatar : '🧑') + '</span>';
                html += '<span style="flex:1;color:rgba(255,255,255,0.3);font-size:0.7rem;">' + (player && player.name ? player
                    .name : '玩家') + '</span>';
                if (isSheriff) {
                    html += '<span style="font-size:0.5rem;color:#F59E0B;">👑</span>';
                }
                if (isDead) {
                    html += '<span style="font-size:0.5rem;color:#dc3545;">💀</span>';
                } else if (isReady) {
                    html += '<span style="font-size:0.5rem;color:#00FF88;">✅</span>';
                } else {
                    html += '<span style="font-size:0.5rem;color:rgba(255,255,255,0.06);">⏳</span>';
                }
                html += '</div>';
            });

            container.innerHTML = html;
            document.getElementById('playerListCount').textContent = occupied.length;
        }

        // ============================================================
        // 重置
        // ============================================================
        function resetSeats() {
            if (config.isGameStarted) {
                if (!confirm('游戏已开始，重置将清除所有进度，确定吗？')) return;
            }

            config.isGameStarted = false;
            config.seats.forEach(function(seat) {
                seat.occupied = false;
                seat.player = null;
                seat.isDead = false;
                seat.isSheriff = false;
                seat.element.className = 'seat empty';
                seat.element.querySelector('.seat-name').textContent = '空位';
                seat.element.querySelector('.seat-emoji').textContent = '🪑';
            });

            document.getElementById('gameStatusText').textContent = '📌 已重置，请重新配置';
            document.getElementById('phaseDisplay').textContent = '⚙️ 设置中';
            document.getElementById('startGameBtn').disabled = false;
            document.getElementById('startGameBtn').innerHTML = '🃏 洗牌发牌';

            updateSeatCount();
            updatePlayerList();
            showToast('🔄 已重置', 'info');
        }

        // ============================================================
        // 开始游戏（洗牌发牌）
        // ============================================================
        function startGame() {
            if (config.isDealing) return;

            var occupied = config.seats.filter(function(s) { return s.occupied; });
            if (occupied.length < config.playerCount) {
                showToast('⚠️ 还有 ' + (config.playerCount - occupied.length) + ' 个座位未占，请等待所有玩家就坐', 'warning');
                return;
            }

            var notReady = config.seats.filter(function(s) {
                return s.occupied && s.player && !s.player.isReady;
            });

            if (notReady.length > 0) {
                showToast('⚠️ 还有 ' + notReady.length + ' 位玩家未准备', 'warning');
                return;
            }

            config.isDealing = true;
            document.getElementById('startGameBtn').disabled = true;
            document.getElementById('startGameBtn').innerHTML = '⏳ 发牌中...';

            var overlay = document.getElementById('dealingOverlay');
            overlay.classList.add('active');

            simulateDealing();
        }

        // ============================================================
        // 模拟发牌动画
        // ============================================================
        function simulateDealing() {
            var players = config.seats.filter(function(s) { return s.occupied; });
            var total = players.length;
            var current = 0;

            var roles = generateRoles();
            var shuffledRoles = shuffleArray(roles);

            players.forEach(function(seat, index) {
                seat.player.role = shuffledRoles[index] || '平民';
                seat.player.hasRevealed = false;
            });

            var title = document.getElementById('dealingOverlay').querySelector('.title');
            var progressText = document.getElementById('dealProgressText');

            title.textContent = '🃏 发牌中...';

            function dealNext() {
                if (current >= total) {
                    progressText.textContent = '✅ 发牌完成！请查看你的身份';
                    title.textContent = '🎉 发牌完成！';

                    setTimeout(function() {
                        document.getElementById('dealingOverlay').classList.remove('active');
                        config.isDealing = false;
                        config.isGameStarted = true;

                        document.getElementById('phaseDisplay').textContent = '🃏 发牌完成';
                        document.getElementById('startGameBtn').innerHTML = '📋 查看身份';
                        document.getElementById('startGameBtn').disabled = false;
                        document.getElementById('gameStatusText').textContent = '🎮 所有玩家已收到身份';

                        showToast('🎉 发牌完成！', 'success');
                        notifyPlayersToReveal();

                    }, 2000);
                    return;
                }

                var seat = players[current];
                var role = seat.player.role;

                progressText.textContent = '📤 发给 ' + seat.number + ' 号... (' + (current + 1) + '/' + total + ')';

                createFlyingCard(seat, role, function() {
                    current++;
                    setTimeout(dealNext, 350);
                });
            }

            setTimeout(dealNext, 500);
        }

        // ============================================================
        // 飞牌动画
        // ============================================================
        function createFlyingCard(seat, role, callback) {
            var card = document.createElement('div');
            card.className = 'card-fly show';
            card.innerHTML = '<img src="' + cardBackImage + '" style="width:100%;height:100%;border-radius:12px;object-fit:cover;" />';

            var startX = window.innerWidth / 2 - 35;
            var startY = window.innerHeight / 2 - 49;

            var seatEl = seat.element;
            var rect = seatEl.getBoundingClientRect();
            var targetX = rect.left + rect.width / 2 - 35;
            var targetY = rect.top + rect.height / 2 - 49;

            card.style.left = startX + 'px';
            card.style.top = startY + 'px';
            card.style.opacity = '1';
            card.style.transform = 'scale(0.3) rotate(180deg)';
            card.style.width = '70px';
            card.style.height = '98px';
            card.style.borderRadius = '12px';
            card.style.boxShadow = '0 0 60px rgba(139,92,246,0.05)';
            document.body.appendChild(card);

            requestAnimationFrame(function() {
                card.style.left = targetX + 'px';
                card.style.top = targetY + 'px';
                card.style.transform = 'scale(1) rotate(0deg)';
                card.style.boxShadow = '0 0 100px rgba(139,92,246,0.1)';
            });

            setTimeout(function() {
                var roleImage = roleImages[role] || '/images/werewolf/cards/平民.jpg';
                card.innerHTML = '<img src="' + roleImage +
                    '" style="width:100%;height:100%;border-radius:12px;object-fit:cover;border:2px solid rgba(139,92,246,0.08);" />';
                card.style.boxShadow = '0 0 120px rgba(139,92,246,0.15)';
                card.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1)';
                card.style.transform = 'rotateY(180deg)';

                setTimeout(function() {
                    card.style.transform = 'rotateY(0deg)';
                }, 100);

                setTimeout(function() {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    setTimeout(function() {
                        card.remove();
                        if (callback) callback();
                    }, 300);
                }, 1500);

            }, 700);
        }

        // ============================================================
        // 生成角色分配
        // ============================================================
        function generateRoles() {
            var count = config.playerCount;
            var roles = [];

            var wolfCount = count === 8 ? 2 : (count === 10 ? 3 : 4);
            for (var i = 0; i < wolfCount; i++) {
                roles.push('狼人');
            }

            var selectedRoles = config.selectedRoles.slice();
            while (selectedRoles.length < 3) {
                var defaultRoles = ['预言家', '女巫', '守卫', '猎人', '白痴', '骑士'];
                for (var d of defaultRoles) {
                    if (selectedRoles.indexOf(d) === -1) {
                        selectedRoles.push(d);
                        break;
                    }
                }
            }

            var maxGods = count === 8 ? 3 : (count === 10 ? 4 : 5);
            while (selectedRoles.length > maxGods) {
                selectedRoles.pop();
            }

            for (var r of selectedRoles) {
                roles.push(r);
            }

            while (roles.length < count) {
                roles.push('平民');
            }

            return roles;
        }

        // ============================================================
        // 工具函数
        // ============================================================
        function shuffleArray(array) {
            var arr = array.slice();
            for (var i = arr.length - 1; i > 0; i--) {
                var j = Math.floor(Math.random() * (i + 1));
                var temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
            return arr;
        }

        // ============================================================
        // 通知玩家查看身份
        // ============================================================
        function notifyPlayersToReveal() {
            var playerData = config.seats
                .filter(function(s) { return s.occupied && s.player; })
                .map(function(s) {
                    return {
                        seatNumber: s.number,
                        playerId: s.player.playerId || 'player_' + s.number,
                        role: s.player.role || '平民',
                        nickname: s.player.name || '玩家' + s.number,
                        avatar: s.player.avatar || '🧑'
                    };
                });

            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke('SendPlayerRoles', playerData).catch(function(err) {
                    console.error('❌ 发送身份失败:', err);
                });
            }

            window._playerRoles = playerData;
        }

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3500);
        }

        // ============================================================
        // SignalR
        // ============================================================
        var connection = null;

        function connectSignalR() {
            try {
                connection = new signalR.HubConnectionBuilder()
                    .withUrl('/werewolfHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on('PlayerJoined', function(player) {
                    var seat = config.seats.find(function(s) { return s.number === player.seatNumber; });
                    if (seat) {
                        seat.occupied = true;
                        seat.player = {
                            playerId: player.playerId,
                            name: player.nickname,
                            avatar: player.avatar || '🧑',
                            isReady: false
                        };
                        seat.element.className = 'seat occupied';
                        seat.element.querySelector('.seat-name').textContent = player.nickname;
                        seat.element.querySelector('.seat-emoji').textContent = player.avatar || '🧑';
                        updateSeatCount();
                        updatePlayerList();
                        showToast('🟢 ' + player.nickname + ' 加入了 ' + seat.number + ' 号', 'success');
                    }
                });

                connection.on('PlayerReady', function(data) {
                    var seat = config.seats.find(function(s) { return s.number === data.seatNumber; });
                    if (seat && seat.player) {
                        seat.player.isReady = data.isReady;
                        seat.element.className = data.isReady ? 'seat ready' : 'seat occupied';
                        updatePlayerList();
                        checkAllReady();
                    }
                });

                connection.on('PlayerLeft', function(seatNumber) {
                    var seat = config.seats.find(function(s) { return s.number === seatNumber; });
                    if (seat) {
                        seat.occupied = false;
                        seat.player = null;
                        seat.element.className = 'seat empty';
                        seat.element.querySelector('.seat-name').textContent = '空位';
                        seat.element.querySelector('.seat-emoji').textContent = '🪑';
                        updateSeatCount();
                        updatePlayerList();
                    }
                });

                connection.on('PhaseUpdate', function(phase) {
                    var phaseNames = {
                        'setup': '⚙️ 设置中',
                        'seating': '🪑 就坐中',
                        'dealing': '🃏 发牌中',
                        'revealing': '📩 查看身份',
                        'sheriff_election': '👑 警长竞选',
                        'night_guard': '🌙 守卫行动',
                        'night_seer': '🌙 预言家行动',
                        'night_werewolf': '🌙 狼人行动',
                        'night_witch': '🌙 女巫行动',
                        'night_resolve': '🌙 结算中',
                        'day_announce': '☀️ 公布死讯',
                        'day_speech': '☀️ 发言阶段',
                        'day_voting': '☀️ 投票阶段',
                        'day_pk': '☀️ PK发言',
                        'day_resolve': '☀️ 公布结果',
                        'hunter_shoot': '🔫 猎人开枪',
                        'gameover': '🏁 游戏结束'
                    };
                    document.getElementById('phaseDisplay').textContent = phaseNames[phase] || phase;
                });

                connection.on('PlayerDeath', function(data) {
                    var seat = config.seats.find(function(s) { return s.number === data.seatNumber; });
                    if (seat) {
                        seat.isDead = true;
                        seat.element.classList.add('dead');
                        seat.element.querySelector('.seat-name').textContent = '💀 ' + data.nickname;
                        updatePlayerList();
                        showToast('💀 ' + data.seatNumber + '号 ' + data.nickname + ' 死亡', 'error');
                    }
                });

                connection.on('SheriffElected', function(data) {
                    var seat = config.seats.find(function(s) { return s.number === data.seatNumber; });
                    if (seat) {
                        seat.isSheriff = true;
                        seat.element.classList.add('sheriff');
                        seat.element.querySelector('.seat-name').textContent = '👑 ' + data.nickname;
                        updatePlayerList();
                        showToast('👑 ' + data.seatNumber + '号当选警长！', 'success');
                    }
                });

                connection.on('GameOver', function(winner) {
                    var msg = winner === '好人' ? '⭐ 好人阵营胜利！' : '🐺 狼人阵营胜利！';
                    document.getElementById('phaseDisplay').textContent = '🏁 ' + msg;
                    showToast('🏆 ' + msg, 'success');
                    document.getElementById('startGameBtn').disabled = true;
                });

                connection.start()
                    .then(function() {
                        console.log('✅ SignalR 已连接');
                        connection.invoke('HostReady');
                    })
                    .catch(function(err) {
                        console.error('❌ SignalR 连接失败:', err);
                        setTimeout(connectSignalR, 3000);
                    });

            } catch (e) {
                console.error('SignalR 初始化失败:', e);
            }
        }

        function checkAllReady() {
            var occupied = config.seats.filter(function(s) { return s.occupied; });
            var allReady = occupied.every(function(s) { return s.player && s.player.isReady; });

            if (allReady && occupied.length === config.playerCount) {
                document.getElementById('gameStatusText').textContent = '✅ 所有玩家已准备！点击"洗牌发牌"';
                document.getElementById('startGameBtn').disabled = false;
                document.getElementById('startGameBtn').innerHTML = '🃏 洗牌发牌';
            }
        }

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            selectPlayerCount(10);
            connectSignalR();

            // 模拟玩家（实际通过SignalR）
            setTimeout(function() {
                var demoPlayers = ['Alice', 'Bob', 'Carol', 'David', 'Eve', 'Frank', 'Grace', 'Henry', 'Ivy', 'Jack'];
                demoPlayers.forEach(function(name, index) {
                    if (index < 10) {
                        var seatNumber = index + 1;
                        var seat = config.seats.find(function(s) { return s.number === seatNumber; });
                        if (seat) {
                            seat.occupied = true;
                            seat.player = {
                                playerId: 'demo_' + seatNumber,
                                name: name,
                                avatar: ['🧑', '👩', '👨', '🦸', '🧙', '🧚', '🤖', '👾', '🦊', '🐺'][index],
                                isReady: index % 2 === 0
                            };
                            seat.element.className = 'seat occupied';
                            seat.element.querySelector('.seat-name').textContent = name;
                            seat.element.querySelector('.seat-emoji').textContent = seat.player.avatar;
                        }
                    }
                });
                updateSeatCount();
                updatePlayerList();
                checkAllReady();
            }, 1000);
        });
    </script>

</body>
</html>
