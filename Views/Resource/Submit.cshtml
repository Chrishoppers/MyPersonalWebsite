@model MyPersonalWebsite.Models.ResourceRequest
@{
    ViewData["Title"] = "📦 资源申请";
    var user = ViewBag.User as MyPersonalWebsite.Models.User;
    var userName = ViewBag.UserName as string ?? "";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var supportedPlatforms = ViewBag.SupportedPlatforms as List<string> ?? new List<string>();
}

<style>
    .resource-container {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .resource-header {
        text-align: center;
        padding: 1.5rem 0 1rem;
    }

    .resource-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .resource-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
    }

    .card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 2rem 2.2rem;
        margin-bottom: 1.5rem;
    }

    .card .card-title {
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-group label {
        display: block;
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
    }

    .form-group label .required {
        color: #dc3545;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: rgba(139,92,246,0.15);
        background: rgba(255,255,255,0.04);
    }

    .form-group input:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 60px;
    }

    .form-group .hint {
        color: rgba(255,255,255,0.08);
        font-size: 0.65rem;
        margin-top: 0.2rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-row-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
    }

    /* 里克特量表 */
    .likert-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }

    .likert-table th,
    .likert-table td {
        padding: 0.5rem 0.5rem;
        border: 1px solid rgba(255,255,255,0.04);
        text-align: center;
    }

    .likert-table th {
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        font-weight: 500;
        font-size: 0.75rem;
    }

    .likert-table td:first-child {
        color: rgba(255,255,255,0.4);
        font-weight: 500;
        text-align: left;
        padding-left: 1rem;
        background: rgba(255,255,255,0.01);
    }

    .likert-table td {
        color: rgba(255,255,255,0.1);
    }

    .likert-table input[type="radio"] {
        accent-color: #8B5CF6;
        width: 16px;
        height: 16px;
        cursor: pointer;
        background: transparent;
    }

    .likert-table input[type="radio"]:checked {
        background: #8B5CF6;
    }

    .likert-table .radio-label {
        display: inline-block;
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.1);
        transition: all 0.3s ease;
    }

    .likert-table input[type="radio"]:checked+.radio-label {
        color: #8B5CF6;
    }

    /* 平台选择 */
    .platform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 0.5rem;
    }

    .platform-option {
        padding: 0.5rem 0.3rem;
        border: 2px solid rgba(255,255,255,0.04);
        border-radius: 12px;
        background: rgba(255,255,255,0.01);
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        color: rgba(255,255,255,0.2);
        font-size: 0.8rem;
        font-weight: 500;
        user-select: none;
    }

    .platform-option:hover {
        border-color: rgba(139,92,246,0.1);
        background: rgba(139,92,246,0.02);
        color: rgba(255,255,255,0.4);
    }

    .platform-option.selected {
        border-color: #8B5CF6;
        background: rgba(139,92,246,0.06);
        color: #8B5CF6;
    }

    .platform-option.disabled {
        opacity: 0.3;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* 验证按钮 */
    .btn-verify {
        padding: 0.6rem 1.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
        font-family: inherit;
    }

    .btn-verify:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .btn-verify:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-verify.verified {
        background: linear-gradient(135deg, #28a745, #34D399);
    }

    /* 提交按钮 */
    .btn-submit {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-top: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108,60,225,0.2);
    }

    .btn-submit:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    /* ===== 免责声明弹窗 ===== */
    .disclaimer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(30px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        animation: modalFadeIn 0.4s ease;
        overflow-y: auto;
    }

    .disclaimer-overlay.active {
        display: flex;
    }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.96);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .disclaimer-modal {
        background: rgba(20, 20, 40, 0.98);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 28px;
        max-width: 720px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 2rem 2.2rem;
        box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
    }

    .disclaimer-modal::-webkit-scrollbar {
        width: 4px;
    }
    .disclaimer-modal::-webkit-scrollbar-thumb {
        background: rgba(139,92,246,0.15);
        border-radius: 10px;
    }

    .disclaimer-modal .modal-title {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
        text-align: center;
    }

    .disclaimer-modal .modal-sub {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.85rem;
        margin-bottom: 1rem;
        text-align: center;
    }

    .disclaimer-modal .disclaimer-section {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .disclaimer-modal .disclaimer-section .section-title {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .disclaimer-modal .disclaimer-section .item {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.25);
        line-height: 1.8;
        padding: 0.1rem 0;
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
    }

    .disclaimer-modal .disclaimer-section .item .mark {
        color: rgba(139, 92, 246, 0.2);
        font-weight: 700;
        flex-shrink: 0;
    }

    .disclaimer-modal .disclaimer-section .item strong {
        color: rgba(255, 255, 255, 0.4);
    }

    .disclaimer-modal .disclaimer-section .item .highlight-pink {
        color: #EC4899;
    }

    .disclaimer-modal .disclaimer-section .item .highlight-purple {
        color: #8B5CF6;
    }

    .disclaimer-modal .disclaimer-check {
        margin-top: 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        background: rgba(40, 167, 69, 0.04);
        border-radius: 12px;
        border: 1px solid rgba(40, 167, 69, 0.04);
    }

    .disclaimer-modal .disclaimer-check .check-row {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
    }

    .disclaimer-modal .disclaimer-check input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #8B5CF6;
        cursor: pointer;
        flex-shrink: 0;
        margin-top: 0.1rem;
    }

    .disclaimer-modal .disclaimer-check label {
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.8rem;
        cursor: pointer;
        line-height: 1.5;
    }

    .disclaimer-modal .disclaimer-check label strong {
        color: #8B5CF6;
    }

    .disclaimer-modal .disclaimer-check label .highlight-pink {
        color: #EC4899;
        font-weight: 600;
    }

    .disclaimer-modal .modal-actions {
        display: flex;
        gap: 0.8rem;
        margin-top: 1.2rem;
        flex-wrap: wrap;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer {
        flex: 1;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        min-width: 120px;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.accept {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.accept:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108, 60, 225, 0.2);
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.accept:disabled {
        opacity: 0.3;
        cursor: not-allowed;
        transform: none;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.reject {
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.reject:hover {
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.4);
    }

    .alert-warning {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(255, 193, 7, 0.04);
        border: 1px solid rgba(255, 193, 7, 0.06);
        color: rgba(255, 193, 7, 0.4);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-success {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(40, 167, 69, 0.04);
        border: 1px solid rgba(40, 167, 69, 0.06);
        color: #28a745;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-danger {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(220, 53, 69, 0.04);
        border: 1px solid rgba(220, 53, 69, 0.06);
        color: #dc3545;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .verify-result {
        margin-top: 0.3rem;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.3rem 0.8rem;
        border-radius: 8px;
        display: none;
    }

    .verify-result.success {
        display: block;
        background: rgba(40, 167, 69, 0.06);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.04);
    }

    .verify-result.error {
        display: block;
        background: rgba(220, 53, 69, 0.06);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.04);
    }

    .verify-result.warning {
        display: block;
        background: rgba(255, 193, 7, 0.06);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.04);
    }

    .verify-result.info {
        display: block;
        background: rgba(79, 172, 254, 0.06);
        color: #4facfe;
        border: 1px solid rgba(79, 172, 254, 0.04);
    }

    @@media (max-width: 640px) {
        .card {
            padding: 1.2rem 1rem;
        }
        .form-row {
            grid-template-columns: 1fr;
            gap: 0.6rem;
        }
        .form-row-3 {
            grid-template-columns: 1fr 1fr;
            gap: 0.6rem;
        }
        .resource-header h1 {
            font-size: 1.6rem;
        }
        .platform-grid {
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        }
        .likert-table {
            font-size: 0.7rem;
        }
        .likert-table th,
        .likert-table td {
            padding: 0.3rem 0.2rem;
        }
        .disclaimer-modal {
            padding: 1.2rem;
        }
        .disclaimer-modal .disclaimer-check .check-row {
            flex-direction: column;
            gap: 0.2rem;
        }
    }

    @@media (max-width: 480px) {
        .form-row-3 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="resource-container">

    <div class="resource-header">
        <h1>📦 资源申请</h1>
        <p class="subtitle">填写资源需求，管理员会尽快处理</p>
    </div>

    @if (TempData["Warning"] != null)
    {
        <div class="alert-warning">⚠️ @TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">❌ @TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✅ @TempData["Success"]</div>
    }

    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem;flex-wrap:wrap;gap:0.5rem;">
            <a href="/Resource/Index" class="btn-back">← 返回资源大厅</a>
            <a href="/Resource/History" class="btn-back" style="border-color:rgba(139,92,246,0.06);color:rgba(139,92,246,0.3);">📋 我的申请</a>
        </div>

        <form asp-action="Submit" method="post" id="resourceForm">
            @Html.AntiForgeryToken()

            <!-- ============================================================
            用户信息（自动识别，不可更改）
            ============================================================ -->
            <div class="form-row">
                <div class="form-group">
                    <label>👤 用户名 <span class="required">*</span></label>
                    <input type="text" value="@userName" disabled />
                    <input type="hidden" name="UserName" value="@userName" />
                </div>
                <div class="form-group">
                    <label>📧 邮箱 <span class="required">*</span></label>
                    <input type="text" value="@userEmail" disabled />
                    <input type="hidden" name="UserEmail" value="@userEmail" />
                </div>
            </div>

            <!-- ============================================================
            1. 平台选择（最多2项）
            ============================================================ -->
            <div class="form-group">
                <label>📱 平台选择 <span class="required">*</span> <span style="color:rgba(255,255,255,0.08);font-weight:400;font-size:0.7rem;">（最多选2项）</span></label>
                <div class="platform-grid" id="platformGrid">
                    @foreach (var platform in new[] { "抖音", "快手", "B站", "小红书", "微博", "知乎" })
                    {
                        <div class="platform-option" data-platform="@platform" onclick="togglePlatform(this)">
                            @platform
                        </div>
                    }
                    <div class="platform-option" data-platform="其他" onclick="togglePlatform(this)">
                        其他
                    </div>
                </div>
                <input type="hidden" id="Platform1" name="Platform1" value="" />
                <input type="hidden" id="Platform2" name="Platform2" value="" />
                <div class="form-group" id="otherPlatformGroup" style="display:none;margin-top:0.5rem;">
                    <label>请填写其他平台名称 <span class="required">*</span></label>
                    <input type="text" id="PlatformOther" name="PlatformOther" placeholder="请输入平台名称..." />
                    <div class="hint">💡 请填写你需要的其他平台名称</div>
                </div>
                <div class="hint" style="margin-top:0.3rem;">💡 点击选择平台，再次点击取消选择</div>
            </div>

            <!-- ============================================================
            2. 人物/CP名字
            ============================================================ -->
            <div class="form-group">
                <label>📝 人物/CP名字 <span class="required">*</span></label>
                <input type="text" name="CharacterName" id="CharacterName" placeholder="请输入人物或CP名字" required maxlength="50" />
                <div class="hint">💡 如：五条悟、五夏、佐鸣等</div>
            </div>

            <!-- ============================================================
            3. 资源类型
            ============================================================ -->
            <div class="form-group">
                <label>📂 资源类型 <span class="required">*</span></label>
                <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:0.4rem;color:rgba(255,255,255,0.3);cursor:pointer;font-size:0.9rem;">
                        <input type="radio" name="ResourceType" value="一人" checked /> 一人
                    </label>
                    <label style="display:flex;align-items:center;gap:0.4rem;color:rgba(255,255,255,0.3);cursor:pointer;font-size:0.9rem;">
                        <input type="radio" name="ResourceType" value="多人" /> 多人
                    </label>
                </div>
            </div>

            <!-- ============================================================
            4. 人物设定
            ============================================================ -->
            <div class="form-group">
                <label>⚙️ 人物设定（CP名字的为第一人设定） <span class="required">*</span></label>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    @foreach (var setting in new[] { "1（攻）", "0（受）", "0.5", "互攻", "都行" })
                    {
                        var value = setting.Replace("（攻）", "").Replace("（受）", "");
                        <label style="display:flex;align-items:center;gap:0.4rem;color:rgba(255,255,255,0.3);cursor:pointer;font-size:0.85rem;padding:0.2rem 0.8rem;border-radius:20px;border:1px solid rgba(255,255,255,0.04);background:rgba(255,255,255,0.02);">
                            <input type="radio" name="CharacterSetting" value="@value" @(value == "都行" ? "checked" : "") /> @setting
                        </label>
                    }
                </div>
            </div>

            <!-- ============================================================
            5. 里克特量表
            ============================================================ -->
            <div class="form-group">
                <label>📊 偏好设置 <span class="required">*</span></label>
                <div class="hint" style="margin-bottom:0.3rem;">💡 小说、漫画、图片中至少有一项不能选择"不需要"</div>
                <table class="likert-table">
                    <thead>
                        <tr>
                            <th style="width:80px;text-align:left;padding-left:1rem;">类型</th>
                            <th>纯爱</th>
                            <th>第一项</th>
                            <th>第二项</th>
                            <th>不需要</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>小说</td>
                            <td><input type="radio" name="NovelPreference" value="纯爱" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="NovelPreference" value="R18" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="NovelPreference" value="R18+" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="NovelPreference" value="不需要" checked /><span class="radio-label"></span></td>
                        </tr>
                        <tr>
                            <td>漫画</td>
                            <td><input type="radio" name="ComicPreference" value="纯爱" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="ComicPreference" value="R18" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="ComicPreference" value="R18+" /><span class="radio-label"></span></td>
                            <td><input type="radio" name="ComicPreference" value="不需要" checked /><span class="radio-label"></span></td>
                        </tr>
                        <tr>
                            <td>图片</td>
