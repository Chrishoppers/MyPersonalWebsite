<script>
    var selectedPlatforms = [];

    // ============================================================
    // 1. 平台选择
    // ============================================================
    function togglePlatform(element) {
        var platform = element.dataset.platform;

        if (element.classList.contains('selected')) {
            element.classList.remove('selected');
            selectedPlatforms = selectedPlatforms.filter(function(p) { return p !== platform; });
        } else {
            if (selectedPlatforms.length >= 2) {
                alert('最多选择2个平台');
                return;
            }
            element.classList.add('selected');
            selectedPlatforms.push(platform);
        }

        // 更新隐藏字段
        document.getElementById('Platform1').value = selectedPlatforms[0] || '';
        document.getElementById('Platform2').value = selectedPlatforms[1] || '';

        // 显示/隐藏其他平台输入
        var otherGroup = document.getElementById('otherPlatformGroup');
        if (selectedPlatforms.includes('其他')) {
            otherGroup.style.display = 'block';
            document.getElementById('PlatformOther').required = true;
        } else {
            otherGroup.style.display = 'none';
            document.getElementById('PlatformOther').required = false;
            document.getElementById('PlatformOther').value = '';
        }
    }

    // ============================================================
    // 2. 平台验证关注
    // ============================================================
    function verifyFollow() {
        var platform = document.getElementById('VerifyPlatform').value;
        var accountId = document.getElementById('VerifyAccountId').value.trim();
        var resultEl = document.getElementById('verifyResult');
        var btn = document.getElementById('verifyBtn');

        if (!platform) {
            resultEl.className = 'verify-result warning';
            resultEl.textContent = '⚠️ 请先选择平台';
            return;
        }

        if (!accountId) {
            resultEl.className = 'verify-result warning';
            resultEl.textContent = '⚠️ 请输入你的账号ID';
            return;
        }

        btn.disabled = true;
        btn.textContent = '⏳ 验证中...';
        resultEl.className = 'verify-result info';
        resultEl.textContent = '🔍 正在验证...';

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Resource/VerifyFollow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'platform=' + encodeURIComponent(platform) + '&accountId=' + encodeURIComponent(accountId)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                if (data.isValid) {
                    resultEl.className = 'verify-result success';
                    resultEl.textContent = '✅ ' + data.message;
                    document.getElementById('IsFollowVerified').value = 'true';
                    btn.classList.add('verified');
                    btn.textContent = '✅ 已验证';
                } else {
                    resultEl.className = 'verify-result error';
                    resultEl.textContent = '❌ ' + data.message;
                    document.getElementById('IsFollowVerified').value = 'false';
                    btn.classList.remove('verified');
                    btn.textContent = '🔍 验证';
                }
            } else {
                resultEl.className = 'verify-result warning';
                resultEl.textContent = '⚠️ ' + data.message;
                document.getElementById('IsFollowVerified').value = 'false';
                btn.classList.remove('verified');
                btn.textContent = '🔍 验证';
            }
        })
        .catch(function() {
            resultEl.className = 'verify-result error';
            resultEl.textContent = '❌ 验证失败，请稍后重试';
            document.getElementById('IsFollowVerified').value = 'false';
            btn.classList.remove('verified');
            btn.textContent = '🔍 验证';
        })
        .finally(function() {
            btn.disabled = false;
        });
    }

    // ============================================================
    // 3. 免责声明弹窗
    // ============================================================
    function showFullDisclaimer() {
        document.getElementById('disclaimerOverlay').classList.add('active');
        document.getElementById('disclaimerBL').checked = false;
        document.getElementById('disclaimerAll').checked = false;
        document.getElementById('disclaimerAcceptBtn').disabled = true;
        document.body.style.overflow = 'hidden';
    }

    function closeDisclaimer() {
        document.getElementById('disclaimerOverlay').classList.remove('active');
        document.body.style.overflow = '';
    }

    document.getElementById('disclaimerBL').addEventListener('change', function() {
        updateDisclaimerBtn();
    });

    document.getElementById('disclaimerAll').addEventListener('change', function() {
        updateDisclaimerBtn();
    });

    function updateDisclaimerBtn() {
        var blChecked = document.getElementById('disclaimerBL').checked;
        var allChecked = document.getElementById('disclaimerAll').checked;
        document.getElementById('disclaimerAcceptBtn').disabled = !(blChecked && allChecked);
    }

    function confirmDisclaimer() {
        // 同步到主表单
        document.getElementById('AgreeToBLContent').checked = true;
        document.getElementById('AgreeToTerms').checked = true;
        closeDisclaimer();
        // 提交表单
        submitForm();
    }

    // ============================================================
    // 4. 提交表单
    // ============================================================
    function submitForm() {
        var blChecked = document.getElementById('AgreeToBLContent').checked;
        var termsChecked = document.getElementById('AgreeToTerms').checked;

        if (!blChecked) {
            alert('请确认申请内容为男同性向（BL）内容');
            return;
        }

        if (!termsChecked) {
            alert('请阅读并同意完整免责声明（点击"查看完整免责声明"按钮）');
            return;
        }

        // 验证平台选择
        var platform1 = document.getElementById('Platform1').value;
        var platform2 = document.getElementById('Platform2').value;
        if (!platform1) {
            alert('请至少选择一个平台');
            return;
        }

        // 验证其他平台
        if (selectedPlatforms.includes('其他')) {
            var other = document.getElementById('PlatformOther').value.trim();
            if (!other) {
                alert('请填写其他平台名称');
                return;
            }
        }

        // 验证人物/CP名字
        var characterName = document.getElementById('CharacterName').value.trim();
        if (!characterName || characterName.length < 2) {
            alert('请输入人物/CP名字（至少2个字符）');
            return;
        }

        // 验证里克特量表
        var novel = document.querySelector('input[name="NovelPreference"]:checked');
        var comic = document.querySelector('input[name="ComicPreference"]:checked');
        var image = document.querySelector('input[name="ImagePreference"]:checked');

        if (!novel || !comic || !image) {
            alert('请完成里克特量表的所有选项');
            return;
        }

        if (novel.value === '不需要' && comic.value === '不需要' && image.value === '不需要') {
            alert('小说、漫画、图片中至少有一项不能选择"不需要"');
            return;
        }

        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = '⏳ 提交中...';
        document.getElementById('resourceForm').submit();
    }

    // 点击外部关闭弹窗
    document.getElementById('disclaimerOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeDisclaimer();
    });

    // ESC键关闭
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDisclaimer();
    });
</script>
