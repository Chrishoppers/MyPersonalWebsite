@model MyPersonalWebsite.Models.ResourceRequest
@{
    ViewData["Title"] = "📦 资源申请";
    var user = ViewBag.User as MyPersonalWebsite.Models.User;
    var userName = ViewBag.UserName as string ?? "";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var supportedPlatforms = ViewBag.SupportedPlatforms as List<string> ?? new List<string>();
}

<style>
    .resource-container {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .resource-header {
        text-align: center;
        padding: 1.5rem 0 1rem;
    }

    .resource-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .resource-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
    }

    .card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 2rem 2.2rem;
        margin-bottom: 1.5rem;
    }

    .card .card-title {
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-group label {
        display: block;
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
    }

    .form-group label .required {
        color: #dc3545;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: rgba(139,92,246,0.15);
        background: rgba(255,255,255,0.04);
    }

    .form-group input:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 60px;
    }

    .form-group .hint {
        color: rgba(255,255,255,0.08);
        font-size: 0.65rem;
        margin-top: 0.2rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-row-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1rem;
    }

    /* 里克特量表 */
    .likert-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        margin-top: 0.5rem;
    }

    .likert-table th,
    .likert-table td {
        padding: 0.5rem 0.5rem;
        border: 1px solid rgba(255,255,255,0.04);
        text-align: center;
    }

    .likert-table th {
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        font-weight: 500;
        font-size: 0.75rem;
    }

    .likert-table td:first-child {
        color: rgba(255,255,255,0.4);
        font-weight: 500;
        text-align: left;
        padding-left: 1rem;
        background: rgba(255,255,255,0.01);
    }

    .likert-table td {
        color: rgba(255,255,255,0.1);
    }

    .likert-table input[type="radio"] {
        accent-color: #8B5CF6;
        width: 16px;
        height: 16px;
        cursor: pointer;
        background: transparent;
    }

    /* 平台选择 */
    .platform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 0.5rem;
    }

    .platform-option {
        padding: 0.5rem 0.3rem;
        border: 2px solid rgba(255,255,255,0.04);
        border-radius: 12px;
        background: rgba(255,255,255,0.01);
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        color: rgba(255,255,255,0.2);
        font-size: 0.8rem;
        font-weight: 500;
        user-select: none;
    }

    .platform-option:hover {
        border-color: rgba(139,92,246,0.1);
        background: rgba(139,92,246,0.02);
        color: rgba(255,255,255,0.4);
    }

    .platform-option.selected {
        border-color: #8B5CF6;
        background: rgba(139,92,246,0.06);
        color: #8B5CF6;
    }

    .platform-option.disabled {
        opacity: 0.3;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* 验证按钮 */
    .btn-verify {
        padding: 0.6rem 1.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
        font-family: inherit;
    }

    .btn-verify:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .btn-verify:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-verify.verified {
        background: linear-gradient(135deg, #28a745, #34D399);
    }

    /* 提交按钮 */
    .btn-submit {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-top: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108,60,225,0.2);
    }

    .btn-submit:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .btn-disclaimer {
        width: 100%;
        padding: 0.8rem 1.2rem;
        border: 2px solid rgba(139,92,246,0.08);
        border-radius: 16px;
        background: rgba(139,92,246,0.02);
        color: rgba(255,255,255,0.3);
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-disclaimer:hover {
        border-color: rgba(139,92,246,0.15);
        background: rgba(139,92,246,0.04);
        color: rgba(255,255,255,0.5);
    }

    .verify-result {
        margin-top: 0.3rem;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 0.3rem 0.8rem;
        border-radius: 8px;
        display: none;
    }

    .verify-result.success {
        display: block;
        background: rgba(40,167,69,0.06);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.04);
    }

    .verify-result.error {
        display: block;
        background: rgba(220,53,69,0.06);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,0.04);
    }

    .verify-result.warning {
        display: block;
        background: rgba(255,193,7,0.06);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.04);
    }

    .verify-result.info {
        display: block;
        background: rgba(79,172,254,0.06);
        color: #4facfe;
        border: 1px solid rgba(79,172,254,0.04);
    }

    .alert-warning {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(255,193,7,0.04);
        border: 1px solid rgba(255,193,7,0.06);
        color: rgba(255,193,7,0.4);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-success {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(40,167,69,0.04);
        border: 1px solid rgba(40,167,69,0.06);
        color: #28a745;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-danger {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(220,53,69,0.04);
        border: 1px solid rgba(220,53,69,0.06);
        color: #dc3545;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    /* ===== 免责声明弹窗 ===== */
    .disclaimer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(30px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        overflow-y: auto;
        animation: modalFadeIn 0.4s ease;
    }

    .disclaimer-overlay.active {
        display: flex;
    }

    @@keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.96);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .disclaimer-modal {
        background: rgba(16, 16, 35, 0.98);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 28px;
        max-width: 780px;
        width: 100%;
        max-height: 92vh;
        overflow-y: auto;
        padding: 2rem 2.2rem;
        box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
        position: relative;
    }

    .disclaimer-modal::-webkit-scrollbar {
        width: 4px;
    }
    .disclaimer-modal::-webkit-scrollbar-thumb {
        background: rgba(139, 92, 246, 0.15);
        border-radius: 10px;
    }

    .modal-close-btn {
        position: sticky;
        top: 0;
        float: right;
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.08);
        font-size: 1.8rem;
        cursor: pointer;
        transition: color 0.3s ease;
        font-weight: 300;
        z-index: 10;
    }

    .modal-close-btn:hover {
        color: rgba(255, 255, 255, 0.25);
    }

    .disclaimer-header {
        text-align: center;
        margin-bottom: 1.5rem;
        padding-right: 2rem;
    }

    .disclaimer-header .disclaimer-icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 0.2rem;
    }

    .disclaimer-header h2 {
        font-size: 1.6rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.1rem;
    }

    .disclaimer-header .disclaimer-sub {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.85rem;
    }

    .disclaimer-progress {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1.2rem;
        padding: 0.3rem 0;
    }

    .disclaimer-progress .progress-bar-track {
        flex: 1;
        height: 4px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        overflow: hidden;
    }

    .disclaimer-progress .progress-bar-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
        width: 0%;
    }

    .disclaimer-progress .progress-text {
        font-size: 0.6rem;
        color: rgba(255, 255, 255, 0.06);
        font-weight: 600;
        min-width: 32px;
        text-align: right;
        font-family: 'Courier New', monospace;
    }

    .disclaimer-section {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        margin-bottom: 0.8rem;
        border: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.3s ease;
        opacity: 0.3;
        transform: scale(0.98);
    }

    .disclaimer-section.read {
        opacity: 1;
        transform: scale(1);
        border-color: rgba(139, 92, 246, 0.06);
        background: rgba(139, 92, 246, 0.02);
    }

    .disclaimer-section .section-title {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .disclaimer-section .section-title .section-icon {
        font-size: 1rem;
    }

    .disclaimer-section .section-content p {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.3);
        line-height: 1.8;
        margin-bottom: 0.5rem;
        padding-left: 0.5rem;
        border-left: 2px solid rgba(255, 255, 255, 0.02);
        padding-left: 0.8rem;
    }

    .disclaimer-section .section-content p strong {
        color: rgba(255, 255, 255, 0.6);
    }

    .disclaimer-section .section-content ul {
        margin: 0.3rem 0 0.5rem 1.5rem;
        padding-left: 0.5rem;
        list-style: none;
    }

    .disclaimer-section .section-content ul li {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.2);
        line-height: 1.8;
        padding: 0.05rem 0;
        padding-left: 0.5rem;
    }

    .disclaimer-section .section-content ul li::before {
        content: "• ";
        color: rgba(139, 92, 246, 0.2);
    }

    .disclaimer-section .section-content .highlight-pink {
        color: #EC4899;
        font-weight: 600;
    }

    .disclaimer-section .section-content .highlight-purple {
        color: #8B5CF6;
        font-weight: 600;
    }

    .disclaimer-section .section-content .highlight-gold {
        color: #F59E0B;
        font-weight: 600;
    }

    .disclaimer-section .section-content .highlight-green {
        color: #28a745;
        font-weight: 600;
    }

    .disclaimer-section .section-content .highlight-red {
        color: #dc3545;
        font-weight: 600;
    }

    .disclaimer-section .section-content .highlight-cyan {
        color: #06B6D4;
        font-weight: 600;
    }

    .disclaimer-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.2rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.04);
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .disclaimer-footer .read-status {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .disclaimer-footer .read-status.done {
        color: rgba(40, 167, 69, 0.3);
    }

    .btn-disclaimer-confirm {
        padding: 0.6rem 2.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        opacity: 0.3;
        pointer-events: none;
    }

    .btn-disclaimer-confirm.enabled {
        opacity: 1;
        pointer-events: auto;
    }

    .btn-disclaimer-confirm.enabled:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108, 60, 225, 0.2);
    }

    .btn-disclaimer-close {
        padding: 0.6rem 2rem;
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 40px;
        background: rgba(255, 255, 255, 0.02);
        color: rgba(255, 255, 255, 0.15);
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        font-size: 0.85rem;
    }

    .btn-disclaimer-close:hover {
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.3);
    }

    .disclaimer-read-timer {
        font-size: 0.6rem;
        color: rgba(255, 255, 255, 0.04);
        margin-top: 0.3rem;
        text-align: center;
        font-family: 'Courier New', monospace;
    }

    @@media (max-width: 640px) {
        .card {
            padding: 1.2rem 1rem;
        }
        .form-row {
            grid-template-columns: 1fr;
            gap: 0.6rem;
        }
        .form-row-3 {
            grid-template-columns: 1fr 1fr;
            gap: 0.6rem;
        }
        .resource-header h1 {
            font-size: 1.6rem;
        }
        .platform-grid {
            grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        }
        .likert-table {
            font-size: 0.7rem;
        }
        .likert-table th,
        .likert-table td {
            padding: 0.3rem 0.2rem;
        }
        .disclaimer-modal {
            padding: 1.2rem;
        }
        .disclaimer-section {
            padding: 0.8rem;
        }
        .disclaimer-footer {
            flex-direction: column;
            align-items: stretch;
        }
        .disclaimer-header h2 {
            font-size: 1.2rem;
        }
        .btn-disclaimer-confirm {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 480px) {
        .form-row-3 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="resource-container">

    <div class="resource-header">
        <h1>📦 资源申请</h1>
        <p class="subtitle">填写资源需求，管理员会尽快处理</p>
    </div>

    @if (TempData["Warning"] != null)
    {
        <div class="alert-warning">⚠️ @TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">❌ @TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✅ @TempData["Success"]</div>
    }

    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem;flex-wrap:wrap;gap:0.5rem;">
            <a href="/Resource/Index" class="btn-back">← 返回资源大厅</a>
            <a href="/Resource/History" class="btn-back" style="border-color:rgba(139,92,246,0.06);color:rgba(139,92,246,0.3);">📋 我的申请</a>
        </div>

        <form asp-action="Submit" method="post" id="resourceForm">
            @Html.AntiForgeryToken()

            <!-- ============================================================
            用户信息（自动识别）
            ============================================================ -->
            <div class="form-row">
                <div class="form-group">
                    <label>👤 用户名 <span class="required">*</span></label>
                    <input type="text" value="@userName" disabled />
                    <input type="hidden" name="UserName" value="@userName" />
                </div>
                <div class="form-group">
                    <label>📧 邮箱 <span class="required">*</span></label>
                    <input type="text" value="@userEmail" disabled />
                    <input type="hidden" name="UserEmail" value="@userEmail" />
                </div>
            </div>

            <!-- ============================================================
            1. 平台选择
            ============================================================ -->
            <div class="form-group">
                <label>📱 平台选择 <span class="required">*</span> <span style="color:rgba(255,255,255,0.08);font-weight:400;font-size:0.7rem;">（最多选2项）</span></label>
                <div class="platform-grid" id="platformGrid">
                    @foreach (var platform in new[] { "X", "Pixiv", "EhViewer", "哔咔" })
                    {
                        <div class="platform-option" data-platform="@platform" onclick="togglePlatform(this)">
                            @platform
                        </div>
                    }
                    <div class="platform-option" data-platform="其他" onclick="togglePlatform(this)">
                        其他
                    </div>
                </div>
                <input type="hidden" id="Platform1" name="Platform1" value="" />
                <input type="hidden" id="Platform2" name="Platform2" value="" />
                <div class="form-group" id="otherPlatformGroup" style="display:none;margin-top:0.5rem;">
                    <label>请填写其他平台名称 <span class="required">*</span></label>
                    <input type="text" id="PlatformOther" name="PlatformOther" placeholder="请输入平台名称..." />
                    <div class="hint">💡 请填写你需要的其他平台名称</div>
                </div>
                <div class="hint" style="margin-top:0.3rem;">💡 点击选择平台，再次点击取消选择</div>
            </div>

            <!-- ============================================================
            2. 人物/CP名字
            ============================================================ -->
            <div class="form-group">
                <label>📝 人物/CP名字 <span class="required">*</span></label>
                <input type="text" name="CharacterName" id="CharacterName" placeholder="请输入人物或CP名字" required maxlength="50" />
                <div class="hint">💡 如：五条悟、五夏、佐鸣等</div>
            </div>

            <!-- ============================================================
            3. 资源类型
            ============================================================ -->
            <div class="form-group">
                <label>📂 资源类型 <span class="required">*</span></label>
                <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:0.4rem;color:rgba(255,255,255,0.3);cursor:pointer;font-size:0.9rem;">
                        <input type="radio" name="ResourceType" value="一人" checked /> 一人
                    </label>
                    <label style="display:flex;align-items:center;gap:0.4rem;color:rgba(255,255,255,0.3);cursor:pointer;font-size:0.9rem;">
                        <input type="radio" name="ResourceType" value="多人" /> 多人
                    </label>
                </div>
            </div>

