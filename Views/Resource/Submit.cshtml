    // 2. 平台验证关注
    // ============================================================
    function verifyFollow() {
        var platform = document.getElementById('VerifyPlatform').value;
        var accountId = document.getElementById('VerifyAccountId').value.trim();
        var resultEl = document.getElementById('verifyResult');
        var btn = document.getElementById('verifyBtn');

        if (!platform) {
            resultEl.className = 'verify-result warning';
            resultEl.textContent = '⚠️ 请先选择平台';
            return;
        }

        if (!accountId) {
            resultEl.className = 'verify-result warning';
            resultEl.textContent = '⚠️ 请输入你的账号ID';
            return;
        }

        btn.disabled = true;
        btn.textContent = '⏳ 验证中...';
        resultEl.className = 'verify-result info';
        resultEl.textContent = '🔍 正在验证账号是否存在...';

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Resource/VerifyFollow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'platform=' + encodeURIComponent(platform) + '&accountId=' + encodeURIComponent(accountId)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                if (data.isValid) {
                    resultEl.className = 'verify-result success';
                    resultEl.textContent = '✅ ' + data.message;
                    document.getElementById('IsFollowVerified').value = 'true';
                    btn.classList.add('verified');
                    btn.textContent = '✅ 已验证';
                } else {
                    resultEl.className = 'verify-result error';
                    resultEl.textContent = '❌ ' + data.message;
                    document.getElementById('IsFollowVerified').value = 'false';
                    btn.classList.remove('verified');
                    btn.textContent = '🔍 验证';
                }
            } else {
                resultEl.className = 'verify-result warning';
                resultEl.textContent = '⚠️ ' + data.message;
                document.getElementById('IsFollowVerified').value = 'false';
                btn.classList.remove('verified');
                btn.textContent = '🔍 验证';
            }
        })
        .catch(function() {
            resultEl.className = 'verify-result error';
            resultEl.textContent = '❌ 验证失败，请稍后重试';
            document.getElementById('IsFollowVerified').value = 'false';
            btn.classList.remove('verified');
            btn.textContent = '🔍 验证';
        })
        .finally(function() {
            btn.disabled = false;
        });
    }

    // ============================================================
    // 3. ⭐ 完整免责声明弹窗
    // ============================================================
    var disclaimerStartTime = null;
    var disclaimerTimerInterval = null;

    function openFullDisclaimer() {
        document.getElementById('disclaimerOverlay').classList.add('active');
        document.body.style.overflow = 'hidden';
        disclaimerStartTime = Date.now();
        disclaimerReadSections.clear();
        updateDisclaimerProgress();

        // 重置所有章节为未读
        document.querySelectorAll('.disclaimer-section').forEach(function(el) {
            el.classList.remove('read');
        });

        // 禁用确认按钮
        document.getElementById('disclaimerConfirmBtn').classList.remove('enabled');

        // 重置计时器
        if (disclaimerTimerInterval) {
            clearInterval(disclaimerTimerInterval);
        }
        document.getElementById('disclaimerTimer').textContent = '⏱ 请阅读所有章节...';

        // 滚动到顶部
        document.querySelector('.disclaimer-modal').scrollTop = 0;
    }

    function closeDisclaimer() {
        document.getElementById('disclaimerOverlay').classList.remove('active');
        document.body.style.overflow = '';
        if (disclaimerTimerInterval) {
            clearInterval(disclaimerTimerInterval);
            disclaimerTimerInterval = null;
        }
    }

    // 监听滚动检测阅读进度
    document.querySelector('.disclaimer-modal').addEventListener('scroll', function() {
        checkReadSections();
    });

    function checkReadSections() {
        var sections = document.querySelectorAll('.disclaimer-section');
        var modal = document.querySelector('.disclaimer-modal');
        var modalTop = modal.scrollTop;
        var modalHeight = modal.clientHeight;

        sections.forEach(function(section, index) {
            var rect = section.getBoundingClientRect();
            var modalRect = modal.getBoundingClientRect();
            
            // 计算section在模态框中的可见比例
            var visibleTop = Math.max(0, rect.top - modalRect.top);
            var visibleBottom = Math.min(modalHeight, rect.bottom - modalRect.top);
            var visibleHeight = Math.max(0, visibleBottom - visibleTop);
            var ratio = visibleHeight / rect.height;

            // 如果可见比例超过60%，标记为已读
            if (ratio > 0.6) {
                if (!disclaimerReadSections.has(index)) {
                    disclaimerReadSections.add(index);
                    section.classList.add('read');
                    updateDisclaimerProgress();
                }
            }
        });
    }

    function updateDisclaimerProgress() {
        var count = disclaimerReadSections.size;
        var percent = Math.min(100, Math.round((count / totalSections) * 100));
        
        document.getElementById('disclaimerProgress').style.width = percent + '%';
        document.getElementById('disclaimerProgressText').textContent = percent + '%';
        document.getElementById('readCount').textContent = count;

        // 如果全部读完，启用确认按钮
        var confirmBtn = document.getElementById('disclaimerConfirmBtn');
        if (count >= totalSections) {
            confirmBtn.classList.add('enabled');
            document.getElementById('readStatus').classList.add('done');
            document.getElementById('disclaimerTimer').textContent = '✅ 已阅读全部章节，可点击确认';
        } else {
            confirmBtn.classList.remove('enabled');
            document.getElementById('disclaimerTimer').textContent = '⏱ 请继续阅读... (' + count + '/' + totalSections + ')';
        }
    }

    function confirmDisclaimer() {
        var confirmBtn = document.getElementById('disclaimerConfirmBtn');
        if (!confirmBtn.classList.contains('enabled')) {
            return;
        }

        // 标记已阅读
        document.getElementById('disclaimerStatus').style.display = 'flex';
        
        // 启用复选框
        var checkboxWrapper = document.getElementById('disclaimerCheckboxWrapper');
        checkboxWrapper.style.opacity = '1';
        checkboxWrapper.style.pointerEvents = 'auto';
        
        var checkbox = document.getElementById('AgreeToTerms');
        checkbox.disabled = false;
        checkbox.checked = true;
        
        document.getElementById('AgreeToTermsHidden').value = 'true';
        
        // 关闭弹窗
        closeDisclaimer();
        
        // 滚动到提交按钮
        document.getElementById('submitBtn').scrollIntoView({ behavior: 'smooth' });
    }

    // 点击外部关闭弹窗
    document.getElementById('disclaimerOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeDisclaimer();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDisclaimer();
    });

    // ============================================================
    // 4. 提交表单
    // ============================================================
    function submitForm() {
        var blChecked = document.getElementById('AgreeToBLContent').checked;
        var termsChecked = document.getElementById('AgreeToTerms').checked;

        if (!blChecked) {
            alert('请确认申请内容为男同性向（BL）内容');
            return;
        }

        if (!termsChecked) {
            alert('请先阅读并同意完整免责声明与用户协议');
            openFullDisclaimer();
            return;
        }

        // 验证平台选择
        var platform1 = document.getElementById('Platform1').value;
        var platform2 = document.getElementById('Platform2').value;
        if (!platform1) {
            alert('请至少选择一个平台');
            return;
        }

        if (selectedPlatforms.includes('其他')) {
            var other = document.getElementById('PlatformOther').value.trim();
            if (!other) {
                alert('请填写其他平台名称');
                return;
            }
        }

        // 验证人物/CP名字
        var characterName = document.getElementById('CharacterName').value.trim();
        if (!characterName || characterName.length < 2) {
            alert('请输入人物/CP名字（至少2个字符）');
            return;
        }

        // 验证里克特量表
        var novel = document.querySelector('input[name="NovelPreference"]:checked');
        var comic = document.querySelector('input[name="ComicPreference"]:checked');
        var image = document.querySelector('input[name="ImagePreference"]:checked');

        if (!novel || !comic || !image) {
            alert('请完成里克特量表的所有选项');
            return;
        }

        if (novel.value === '不需要' && comic.value === '不需要' && image.value === '不需要') {
            alert('小说、漫画、图片中至少有一项不能选择"不需要"');
            return;
        }

        // 验证平台验证是否已完成
        var verifyPlatform = document.getElementById('VerifyPlatform').value;
        var verifyAccountId = document.getElementById('VerifyAccountId').value.trim();
        var isVerified = document.getElementById('IsFollowVerified').value === 'true';

        if (!verifyPlatform) {
            alert('请选择验证平台');
            return;
        }

        if (!verifyAccountId) {
            alert('请输入你的平台账号ID');
            return;
        }

        if (!isVerified) {
            alert('请先点击"验证"按钮完成账号真实性验证');
            return;
        }

        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = '⏳ 提交中...';
        document.getElementById('resourceForm').submit();
    }

    // 检测BL内容复选框变化
    document.getElementById('AgreeToBLContent').addEventListener('change', function() {
        if (!this.checked) {
            document.getElementById('AgreeToTerms').checked = false;
            document.getElementById('AgreeToTermsHidden').value = 'false';
        }
    });

    // 检测同意复选框变化
    document.getElementById('AgreeToTerms').addEventListener('change', function() {
        document.getElementById('AgreeToTermsHidden').value = this.checked ? 'true' : 'false';
    });
</script>
