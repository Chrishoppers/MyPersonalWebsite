@model MyPersonalWebsite.Models.ResourceRequest
@{
    ViewData["Title"] = "📦 资源申请";
    var user = ViewBag.User as MyPersonalWebsite.Models.User;
    var userName = ViewBag.UserName as string ?? "";
    var userEmail = ViewBag.UserEmail as string ?? "";
}

<style>
    .resource-container {
        max-width: 820px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .resource-header {
        text-align: center;
        padding: 1.5rem 0 1rem;
    }

    .resource-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .resource-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
    }

    .card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 2rem 2.2rem;
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-group label {
        display: block;
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        font-weight: 500;
        margin-bottom: 0.3rem;
    }

    .form-group label .required {
        color: #dc3545;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 0.9rem;
        outline: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: rgba(108, 60, 225, 0.15);
        background: rgba(255,255,255,0.04);
    }

    .form-group input:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .form-group .hint {
        color: rgba(255,255,255,0.08);
        font-size: 0.65rem;
        margin-top: 0.2rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    /* ===== 退款选项 ===== */
    .refund-option {
        padding: 0.8rem 1rem;
        border-radius: 14px;
        border: 2px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.01);
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .refund-option:hover {
        border-color: rgba(139, 92, 246, 0.1);
        background: rgba(139, 92, 246, 0.02);
    }

    .refund-option.selected {
        border-color: #8B5CF6;
        background: rgba(139, 92, 246, 0.04);
    }

    .refund-option .icon { font-size: 1.4rem; }
    .refund-option .title { font-weight: 700; color: #fff; font-size: 0.95rem; }
    .refund-option .price { font-size: 1.1rem; font-weight: 800; margin: 0.2rem 0; }
    .refund-option .price.gold { color: #F59E0B; }
    .refund-option .price.green { color: #00FF88; }
    .refund-option .desc { font-size: 0.55rem; color: rgba(255,255,255,0.08); }

    .btn-submit {
        width: 100%;
        padding: 0.9rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-top: 0.5rem;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108, 60, 225, 0.2);
    }

    .btn-submit:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back {
        display: inline-block;
        padding: 0.5rem 1.5rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.85rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    /* ===== 免责声明弹窗 ===== */
    .disclaimer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        backdrop-filter: blur(30px);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        animation: modalFadeIn 0.4s ease;
    }

    .disclaimer-overlay.active { display: flex; }

    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.96); }
        to { opacity: 1; transform: scale(1); }
    }

    .disclaimer-modal {
        background: rgba(20, 20, 40, 0.98);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 28px;
        max-width: 720px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 2rem 2.2rem;
        box-shadow: 0 40px 120px rgba(0,0,0,0.6);
    }

    .disclaimer-modal::-webkit-scrollbar { width: 4px; }
    .disclaimer-modal::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.15); border-radius: 10px; }

    .disclaimer-modal .modal-title {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .disclaimer-modal .modal-sub {
        color: rgba(255,255,255,0.15);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .disclaimer-modal .disclaimer-section {
        background: rgba(255,255,255,0.02);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        border: 1px solid rgba(255,255,255,0.03);
    }

    .disclaimer-modal .disclaimer-section .section-title {
        color: rgba(255,255,255,0.15);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .disclaimer-modal .disclaimer-section .item {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.25);
        line-height: 1.8;
        padding: 0.1rem 0;
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
    }

    .disclaimer-modal .disclaimer-section .item .mark {
        color: rgba(139,92,246,0.2);
        font-weight: 700;
        flex-shrink: 0;
    }

    .disclaimer-modal .disclaimer-section .item strong {
        color: rgba(255,255,255,0.4);
    }

    .disclaimer-modal .disclaimer-check {
        margin-top: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 1rem;
        background: rgba(40,167,69,0.04);
        border-radius: 12px;
        border: 1px solid rgba(40,167,69,0.04);
    }

    .disclaimer-modal .disclaimer-check input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #8B5CF6;
        cursor: pointer;
        flex-shrink: 0;
    }

    .disclaimer-modal .disclaimer-check label {
        color: rgba(255,255,255,0.2);
        font-size: 0.8rem;
        cursor: pointer;
    }

    .disclaimer-modal .disclaimer-check label strong {
        color: #8B5CF6;
    }

    .disclaimer-modal .modal-actions {
        display: flex;
        gap: 0.8rem;
        margin-top: 1.2rem;
        flex-wrap: wrap;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer {
        flex: 1;
        padding: 0.7rem 1.5rem;
        border: none;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        min-width: 120px;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.accept {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.accept:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108,60,225,0.2);
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.reject {
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .disclaimer-modal .modal-actions .btn-disclaimer.reject:hover {
        background: rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.4);
    }

    .alert-warning {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(255,193,7,0.04);
        border: 1px solid rgba(255,193,7,0.06);
        color: rgba(255,193,7,0.4);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-success {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(40,167,69,0.04);
        border: 1px solid rgba(40,167,69,0.06);
        color: #28a745;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-danger {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(220,53,69,0.04);
        border: 1px solid rgba(220,53,69,0.06);
        color: #dc3545;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 640px) {
        .card { padding: 1.2rem 1rem; }
        .form-row { grid-template-columns: 1fr; gap: 0.6rem; }
        .refund-option { padding: 0.6rem; }
        .disclaimer-modal { padding: 1.2rem; }
        .resource-header h1 { font-size: 1.6rem; }
    }
</style>

<div class="resource-container">

    <div class="resource-header">
        <h1>📦 资源申请</h1>
        <p class="subtitle">填写资源需求，管理员会尽快处理</p>
    </div>

    @if (TempData["Warning"] != null)
    {
        <div class="alert-warning">⚠️ @TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-danger">❌ @TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✅ @TempData["Success"]</div>
    }

    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.2rem;flex-wrap:wrap;gap:0.5rem;">
            <a href="/Resource/Index" class="btn-back">← 返回资源大厅</a>
            <a href="/Resource/History" class="btn-back" style="border-color:rgba(139,92,246,0.06);color:rgba(139,92,246,0.3);">📋 我的申请</a>
        </div>

        <form asp-action="Submit" method="post" id="resourceForm">
            @Html.AntiForgeryToken()

            <!-- 用户信息（自动识别，不可更改） -->
            <div class="form-row">
                <div class="form-group">
                    <label>👤 用户名 <span class="required">*</span></label>
                    <input type="text" value="@userName" disabled />
                    <input type="hidden" name="UserName" value="@userName" />
                </div>
                <div class="form-group">
                    <label>📧 邮箱 <span class="required">*</span></label>
                    <input type="text" value="@userEmail" disabled />
                    <input type="hidden" name="UserEmail" value="@userEmail" />
                </div>
            </div>

            <!-- 联系人姓名 -->
            <div class="form-group">
                <label>📋 联系人姓名 <span class="required">*</span></label>
                <input type="text" name="PersonName" placeholder="请输入您的真实姓名" required maxlength="50" />
            </div>

            <!-- 平台选择 -->
            <div class="form-group">
                <label>📱 平台 <span class="required">*</span></label>
                <select name="Platform" required>
                    <option value="">请选择平台</option>
                    <option value="X">X (Twitter)</option>
                    <option value="Pixiv">Pixiv</option>
                    <option value="EhViewer">EhViewer</option>
                    <option value="其他">其他</option>
                </select>
            </div>

            <!-- 资源类型 -->
            <div class="form-group">
                <label>📂 资源类型 <span class="required">*</span></label>
                <input type="text" name="ResourceType" placeholder="如：图片、视频、文档、软件等" required />
            </div>

            <!-- 资源名称 -->
            <div class="form-group">
                <label>📂 资源名称 <span class="required">*</span></label>
                <input type="text" name="ResourceName" placeholder="请输入资源的名称" required maxlength="100" />
            </div>

            <!-- 资源链接 -->
            <div class="form-group">
                <label>🔗 资源链接</label>
                <input type="url" name="ResourceUrl" placeholder="https://example.com/resource" />
                <div class="hint">如果有相关链接请填写，方便管理员查找</div>
            </div>

            <!-- 备注 -->
            <div class="form-group">
                <label>📝 备注说明</label>
                <textarea name="Description" placeholder="如有特殊要求请在此说明..." maxlength="500"></textarea>
                <div class="hint">最多500字</div>
            </div>

            <!-- ===== 退款选项 ===== -->
            <div class="form-group">
                <label>💰 退款选项 <span class="required">*</span></label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;">
                    <div class="refund-option" data-value="1day_paid" onclick="selectRefund(this)">
                        <div class="icon">⚡</div>
                        <div class="title">1天内超时退款</div>
                        <div class="price gold">¥2.00</div>
                        <div class="desc">1天内未处理可申请退款2元</div>
                    </div>
                    <div class="refund-option selected" data-value="2weeks_free" onclick="selectRefund(this)">
                        <div class="icon">📅</div>
                        <div class="title">两周内处理</div>
                        <div class="price green">免费</div>
                        <div class="desc">两周内处理完成，无需退款</div>
                    </div>
                </div>
                <input type="hidden" id="refundOption" name="RefundOption" value="2weeks_free" />
                <div class="hint" style="margin-top:0.3rem;">💡 选择后将在对应时间内处理你的申请</div>
            </div>

            <!-- 提交按钮 -->
            <button type="button" class="btn-submit" id="submitBtn" onclick="showDisclaimer()">
                📤 提交申请
            </button>
        </form>
    </div>
</div>

<!-- ===== 免责声明弹窗 ===== -->
<div class="disclaimer-overlay" id="disclaimerOverlay">
    <div class="disclaimer-modal">
        <div class="modal-title">📜 免责声明</div>
        <div class="modal-sub">请仔细阅读以下条款，确认后提交</div>

        <div class="disclaimer-section">
            <div class="section-title">📋 服务说明</div>
            <div class="item"><span class="mark">•</span> 当前平台为 <strong>快手</strong> 平台</div>
            <div class="item"><span class="mark">•</span> 所有操作 <strong>完全免费</strong> 且无任何私密信息</div>
            <div class="item"><span class="mark">•</span> 资源需求填写后由管理员人工处理</div>
        </div>

        <div class="disclaimer-section">
            <div class="section-title">🔒 隐私声明</div>
            <div class="item"><span class="mark">•</span> 你提交的数据将发送给表单所有者</div>
            <div class="item"><span class="mark">•</span> <strong style="color:#dc3545;">绝对不要泄露你的密码</strong></div>
            <div class="item"><span class="mark">•</span> 报告滥用行为可通过 <strong>2908685235@qq.com</strong> 联系</div>
        </div>

        <div class="disclaimer-section">
            <div class="section-title">💰 退款说明</div>
            <div class="item"><span class="mark">•</span> <strong>1天内超时退款（¥2）</strong>：1天内未处理可申请退款</div>
            <div class="item"><span class="mark">•</span> <strong>两周内处理（免费）</strong>：两周内处理完成，无需退款</div>
            <div class="item"><span class="mark">•</span> 退款申请需联系管理员处理</div>
        </div>

        <div class="disclaimer-section">
            <div class="section-title">⚠️ 免责条款</div>
            <div class="item"><span class="mark">•</span> 资源内容由第三方提供，本站仅作为信息中转</div>
            <div class="item"><span class="mark">•</span> 管理员对资源内容不承担任何责任</div>
            <div class="item"><span class="mark">•</span> 如资源涉及侵权，请联系管理员删除</div>
            <div class="highlight-box" style="margin-top:0.5rem;">
                <span class="tag">📢</span> 此内容由表单所有者创建。Microsoft 不对其客户（包括该表单所有者）的隐私或安全惯例负责，包括该表单所有者。
            </div>
        </div>

        <div class="disclaimer-check">
            <input type="checkbox" id="disclaimerCheck" />
            <label for="disclaimerCheck">我已阅读并同意以上 <strong>免责声明</strong> 和 <strong>隐私条款</strong></label>
        </div>

        <div class="modal-actions">
            <button class="btn-disclaimer accept" onclick="confirmSubmit()">✅ 同意并提交</button>
            <button class="btn-disclaimer reject" onclick="closeDisclaimer()">✕ 取消</button>
        </div>
    </div>
</div>

<script>
    // ============================================================
    // 退款选项选择
    // ============================================================
    var selectedRefund = '2weeks_free';

    function selectRefund(element) {
        document.querySelectorAll('.refund-option').forEach(function(el) {
            el.classList.remove('selected');
        });
        element.classList.add('selected');
        selectedRefund = element.dataset.value;
        document.getElementById('refundOption').value = selectedRefund;
    }

    // ============================================================
    // 免责声明弹窗
    // ============================================================
    function showDisclaimer() {
        // 验证必填项
        var personName = document.querySelector('input[name="PersonName"]').value.trim();
        var platform = document.querySelector('select[name="Platform"]').value;
        var resourceType = document.querySelector('input[name="ResourceType"]').value.trim();
        var resourceName = document.querySelector('input[name="ResourceName"]').value.trim();

        if (!personName) { alert('请填写联系人姓名'); return; }
        if (!platform) { alert('请选择平台'); return; }
        if (!resourceType) { alert('请填写资源类型'); return; }
        if (!resourceName) { alert('请填写资源名称'); return; }

        document.getElementById('disclaimerOverlay').classList.add('active');
    }

    function closeDisclaimer() {
        document.getElementById('disclaimerOverlay').classList.remove('active');
    }

    function confirmSubmit() {
        var checkbox = document.getElementById('disclaimerCheck');
        if (!checkbox.checked) {
            alert('请先阅读并同意免责声明');
            return;
        }

        document.getElementById('disclaimerOverlay').classList.remove('active');
        document.getElementById('resourceForm').submit();
    }

    // 点击外部关闭
    document.getElementById('disclaimerOverlay').addEventListener('click', function(e) {
        if (e.target === this) closeDisclaimer();
    });

    // ESC键关闭
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDisclaimer();
    });
</script>
