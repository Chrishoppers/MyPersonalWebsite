@model MyPersonalWebsite.Models.ResourceRequest
@{
    ViewData["Title"] = "📋 申请详情";
}

<style>
    .detail-container {
        max-width: 700px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .detail-container .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .detail-container .header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
    }

    .btn-back {
        padding: 0.4rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .detail-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.5rem;
    }

    .detail-row {
        display: flex;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.02);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-row .label {
        min-width: 120px;
        color: rgba(255,255,255,0.2);
        font-size: 0.8rem;
        font-weight: 500;
        flex-shrink: 0;
    }

    .detail-row .value {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        word-break: break-all;
    }

    .detail-row .value .highlight {
        color: #8B5CF6;
        font-weight: 600;
    }

    .status-badge-large {
        padding: 0.2rem 1rem;
        border-radius: 30px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-pending { background: rgba(255,193,7,0.08); color: #ffc107; border: 1px solid rgba(255,193,7,0.04); }
    .status-processing { background: rgba(79,172,254,0.08); color: #4facfe; border: 1px solid rgba(79,172,254,0.04); }
    .status-completed { background: rgba(40,167,69,0.08); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }
    .status-rejected { background: rgba(220,53,69,0.08); color: #dc3545; border: 1px solid rgba(220,53,69,0.04); }
    .status-refunded { background: rgba(245,158,11,0.08); color: #F59E0B; border: 1px solid rgba(245,158,11,0.04); }
    .status-paid { background: rgba(40,167,69,0.08); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }

    .file-link {
        color: #8B5CF6;
        text-decoration: none;
        padding: 0.2rem 0.8rem;
        border: 1px solid rgba(139,92,246,0.06);
        border-radius: 30px;
        background: rgba(139,92,246,0.04);
        transition: all 0.3s ease;
        display: inline-block;
    }

    .file-link:hover {
        background: rgba(139,92,246,0.08);
    }

    .paid-badge {
        display: inline-block;
        padding: 0.15rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(40,167,69,0.1);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.04);
    }

    .unpaid-badge {
        display: inline-block;
        padding: 0.15rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 600;
        background: rgba(255,193,7,0.08);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.04);
    }

    @@media (max-width: 640px) {
        .detail-row { flex-direction: column; gap: 0.2rem; }
        .detail-row .label { min-width: auto; }
    }
</style>

<div class="detail-container">
    <div class="header">
        <h1>📋 申请详情</h1>
        <a href="/Resource/History" class="btn-back">← 返回列表</a>
    </div>

    <div class="detail-card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.5rem;">
            <span style="color:rgba(255,255,255,0.1);font-size:0.8rem;">#@Model.Id</span>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <span class="status-badge-large @("status-" + Model.Status)">
                    @(Model.Status == "pending" ? "⏳ 待处理" :
                      Model.Status == "paid" ? "💰 已付款" :
                      Model.Status == "processing" ? "🔄 处理中" :
                      Model.Status == "completed" ? "✅ 已完成" :
                      Model.Status == "rejected" ? "❌ 已拒绝" :
                      Model.Status == "refunded" ? "💰 已退款" : "❓ 未知")
                </span>
                @if (Model.IsPaid)
                {
                    <span class="paid-badge">✅ 已支付</span>
                }
                else
                {
                    <span class="unpaid-badge">⏳ 未支付</span>
                }
            </div>
        </div>

        <div class="detail-row">
            <span class="label">👤 申请人</span>
            <span class="value">@Model.UserName</span>
        </div>
        <div class="detail-row">
            <span class="label">📧 邮箱</span>
            <span class="value">@Model.UserEmail</span>
        </div>
        <div class="detail-row">
            <span class="label">📋 联系人</span>
            <span class="value">@Model.PersonName</span>
        </div>
        <div class="detail-row">
            <span class="label">📱 平台</span>
            <span class="value">
                @if (!string.IsNullOrEmpty(Model.Platform1))
                {
                    <span>@Model.Platform1</span>
                    @if (!string.IsNullOrEmpty(Model.Platform2))
                    {
                        <span> + @Model.Platform2</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.PlatformOther))
                    {
                        <span style="color:rgba(255,255,255,0.2);font-size:0.75rem;">（@Model.PlatformOther）</span>
                    }
                }
                else
                {
                    <span style="color:rgba(255,255,255,0.2);">未选择</span>
                }
            </span>
        </div>
        <div class="detail-row">
            <span class="label">📂 资源类型</span>
            <span class="value">@Model.ResourceType</span>
        </div>
        <div class="detail-row">
            <span class="label">📂 资源名称</span>
            <span class="value"><strong style="color:#fff;">@Model.ResourceName</strong></span>
        </div>
        <div class="detail-row">
            <span class="label">📝 备注</span>
            <span class="value">@(string.IsNullOrEmpty(Model.Description) ? "无" : Model.Description)</span>
        </div>
        <div class="detail-row">
            <span class="label">⚙️ 人物设定</span>
            <span class="value"><span class="highlight">@Model.CharacterSetting</span></span>
        </div>
        <div class="detail-row">
            <span class="label">📊 偏好</span>
            <span class="value">
                小说: <span class="highlight">@Model.NovelPreference</span>
                · 漫画: <span class="highlight">@Model.ComicPreference</span>
                · 图片: <span class="highlight">@Model.ImagePreference</span>
            </span>
        </div>
        <div class="detail-row">
            <span class="label">⏰ 申请时间</span>
            <span class="value">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </div>

        @if (Model.ProcessedAt.HasValue)
        {
            <div class="detail-row">
                <span class="label">⏰ 处理时间</span>
                <span class="value">@Model.ProcessedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
        }

        <!-- ===== 支付信息 ===== -->
        <div class="detail-row">
            <span class="label">💰 支付状态</span>
            <span class="value">
                @if (Model.IsPaid)
                {
                    <span style="color:#28a745;">✅ 已支付</span>
                    @if (Model.PaidAt.HasValue)
                    {
                        <span style="color:rgba(255,255,255,0.2);font-size:0.75rem;margin-left:0.5rem;">
                            @Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm")
                        </span>
                    }
                    if (!string.IsNullOrEmpty(Model.PaidNote))
                    {
                        <div style="color:rgba(255,255,255,0.15);font-size:0.7rem;margin-top:0.2rem;">
                            📝 备注：@Model.PaidNote
                        </div>
                    }
                }
                else
                {
                    <span style="color:#ffc107;">⏳ 未支付</span>
                    if (!string.IsNullOrEmpty(Model.OrderId))
                    {
                        <span style="color:rgba(255,255,255,0.15);font-size:0.75rem;margin-left:0.5rem;">
                            订单号：<span style="font-family:monospace;">@Model.OrderId</span>
                        </span>
                    }
                }
            </span>
        </div>

        <!-- ===== 验证信息 ===== -->
        @if (!string.IsNullOrEmpty(Model.VerifyPlatform) && !string.IsNullOrEmpty(Model.VerifyAccountId))
        {
            <div class="detail-row">
                <span class="label">🔍 验证信息</span>
                <span class="value">
                    <div>
                        <strong style="color:#fff;">@Model.VerifyPlatform</strong>
                        <span style="color:rgba(255,255,255,0.3);"> - </span>
                        <span style="color:rgba(255,255,255,0.5);">@Model.VerifyAccountId</span>
                    </div>
                    <div style="font-size:0.75rem;color:rgba(255,255,255,0.2);margin-top:0.2rem;">
                        @(Model.VerifyStatus == "auto_verified" ? "✅ 自动验证通过" :
                          Model.VerifyStatus == "manual_required" ? "⚠️ 待人工核验" :
                          Model.VerifyStatus == "rejected" ? "❌ 验证未通过" : "⏳ 未验证")
                        @if (!string.IsNullOrEmpty(Model.FollowVerifyError))
                        {
                            <span style="display:block;color:rgba(255,255,255,0.1);">@Model.FollowVerifyError</span>
                        }
                    </div>
                </span>
            </div>
        }

        <!-- ===== 文件 ===== -->
        @if (!string.IsNullOrEmpty(Model.FileUrl))
        {
            <div class="detail-row">
                <span class="label">📎 资源文件</span>
                <span class="value">
                    <a href="@Model.FileUrl" target="_blank" class="file-link">📥 下载文件</a>
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.AdminNote))
        {
            <div class="detail-row">
                <span class="label">📝 管理员备注</span>
                <span class="value" style="color:rgba(255,255,255,0.3);font-style:italic;">@Model.AdminNote</span>
            </div>
        }

        <div class="detail-row" style="border-top:1px solid rgba(255,255,255,0.02);padding-top:0.8rem;margin-top:0.3rem;">
            <span class="label" style="color:rgba(255,255,255,0.04);">🆔 申请ID</span>
            <span class="value" style="color:rgba(255,255,255,0.04);font-size:0.7rem;font-family:'Courier New',monospace;">#@Model.Id</span>
        </div>
    </div>
</div>
