@{
    ViewData["Title"] = "💰 微信支付";
    var orderId = ViewBag.OrderId as string;
    var amount = ViewBag.Amount as decimal? ?? 2.00m;
    var description = ViewBag.Description as string ?? "资源申请";
    var characterName = ViewBag.CharacterName as string;
    var userName = ViewBag.UserName as string;
    var error = ViewBag.Error as string;
    var qrCodeUrl = ViewBag.QRCodeUrl as string ?? "/images/payment/wechat_qr.jpg";
    var requestId = ViewBag.RequestId as int?;
}

<style>
    .pay-container {
        max-width: 520px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .pay-card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 2rem;
        text-align: center;
    }

    .pay-card .order-id {
        font-family: 'Courier New', monospace;
        font-size: 1.2rem;
        font-weight: 700;
        color: #8B5CF6;
        background: rgba(139,92,246,0.06);
        padding: 0.3rem 1rem;
        border-radius: 8px;
        display: inline-block;
        margin: 0.3rem 0;
        letter-spacing: 2px;
    }

    .pay-card .amount {
        font-size: 3.5rem;
        font-weight: 900;
        color: #F59E0B;
        margin: 0.3rem 0;
    }

    .pay-card .qr-container {
        background: #fff;
        border-radius: 16px;
        padding: 1.5rem;
        display: inline-block;
        margin: 1rem auto;
        border: 2px dashed rgba(0,0,0,0.05);
        max-width: 100%;
    }

    .pay-card .qr-container img {
        width: 220px;
        height: 220px;
        display: block;
    }

    .pay-card .qr-container .qr-placeholder {
        width: 220px;
        height: 220px;
        background: rgba(255,255,255,0.02);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.08);
        font-size: 0.8rem;
        flex-direction: column;
        gap: 0.5rem;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .pay-card .info-box {
        background: rgba(40,167,69,0.04);
        border: 1px solid rgba(40,167,69,0.06);
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        margin: 0.8rem 0;
        text-align: left;
    }

    .pay-card .info-box .label {
        color: rgba(255,255,255,0.15);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 600;
    }

    .pay-card .info-box .value {
        color: rgba(255,255,255,0.6);
        font-size: 0.85rem;
        margin-top: 0.1rem;
        word-break: break-all;
        line-height: 1.8;
    }

    .pay-card .info-box .value strong {
        color: #F59E0B;
    }

    .pay-card .info-box .value .highlight {
        color: #8B5CF6;
        font-weight: 600;
    }

    .pay-card .status {
        margin-top: 0.8rem;
        padding: 0.8rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
    }

    .pay-card .status.waiting {
        background: rgba(255,193,7,0.06);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.04);
    }

    .pay-card .status.paid {
        background: rgba(40,167,69,0.06);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.04);
    }

    .pay-card .status.checking {
        background: rgba(79,172,254,0.06);
        color: #4facfe;
        border: 1px solid rgba(79,172,254,0.04);
    }

    .btn-check {
        padding: 0.8rem 2.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #07C160, #06AD56);
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-top: 0.8rem;
        box-shadow: 0 4px 24px rgba(7,193,96,0.15);
    }

    .btn-check:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(7,193,96,0.25);
    }

    .btn-check:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-back {
        display: inline-block;
        margin-top: 1rem;
        color: rgba(255,255,255,0.15);
        text-decoration: none;
        font-size: 0.8rem;
        transition: color 0.3s ease;
    }

    .btn-back:hover {
        color: rgba(255,255,255,0.3);
    }

    .copy-btn {
        background: rgba(139,92,246,0.08);
        border: none;
        padding: 0.15rem 0.8rem;
        border-radius: 20px;
        color: #8B5CF6;
        font-size: 0.65rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-left: 0.3rem;
    }

    .copy-btn:hover {
        background: rgba(139,92,246,0.15);
    }

    .payment-method-badge {
        display: inline-block;
        padding: 0.3rem 1.5rem;
        border-radius: 40px;
        background: rgba(7,193,96,0.08);
        color: #07C160;
        border: 1px solid rgba(7,193,96,0.04);
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }

    .step-guide {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        text-align: left;
        padding: 0.5rem 0;
    }

    .step-guide .step {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: rgba(255,255,255,0.25);
        font-size: 0.8rem;
    }

    .step-guide .step .num {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: rgba(7,193,96,0.06);
        color: #07C160;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .alert-error {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(220,53,69,0.06);
        border: 1px solid rgba(220,53,69,0.06);
        color: #dc3545;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .alert-success {
        padding: 0.8rem 1.2rem;
        border-radius: 12px;
        background: rgba(40,167,69,0.06);
        border: 1px solid rgba(40,167,69,0.06);
        color: #28a745;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .order-info-row {
        display: flex;
        justify-content: space-between;
        padding: 0.3rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.02);
        font-size: 0.85rem;
    }

    .order-info-row .label {
        color: rgba(255,255,255,0.2);
    }

    .order-info-row .value {
        color: rgba(255,255,255,0.6);
    }

    @@media (max-width: 640px) {
        .pay-card { padding: 1.2rem; }
        .pay-card .amount { font-size: 2.5rem; }
        .pay-card .qr-container img { width: 160px; height: 160px; }
        .pay-card .qr-container .qr-placeholder { width: 160px; height: 160px; }
        .step-guide .step { font-size: 0.7rem; }
    }
</style>

<div class="pay-container">
    <div class="pay-card">

        <span style="font-size:2.5rem;">💚</span>
        <h2 style="color:#fff;font-weight:700;margin-bottom:0.1rem;">微信支付</h2>
        <p style="color:rgba(255,255,255,0.2);font-size:0.85rem;">支付完成后管理员将处理你的申请</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert-error">❌ @error</div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="alert-success">✅ @TempData["Message"]</div>
        }

        <div class="payment-method-badge">💬 微信支付</div>

        <div class="amount">¥@amount.ToString("F2")</div>

        <!-- 订单信息 -->
        <div style="text-align:left;background:rgba(255,255,255,0.02);border-radius:12px;padding:0.8rem 1rem;margin:0.5rem 0;">
            <div class="order-info-row">
                <span class="label">📋 订单号</span>
                <span class="value" style="font-family:monospace;color:#8B5CF6;">@orderId</span>
            </div>
            @if (!string.IsNullOrEmpty(characterName))
            {
                <div class="order-info-row">
                    <span class="label">📝 申请</span>
                    <span class="value">@characterName</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(userName))
            {
                <div class="order-info-row">
                    <span class="label">👤 申请人</span>
                    <span class="value">@userName</span>
                </div>
            }
            <div class="order-info-row">
                <span class="label">💰 金额</span>
                <span class="value" style="color:#F59E0B;font-weight:700;">¥@amount.ToString("F2")</span>
            </div>
        </div>

        <!-- 复制订单号 -->
        <div>
            <span style="color:rgba(255,255,255,0.15);font-size:0.7rem;">💡 支付时请备注订单号</span>
            <div>
                <span class="order-id" id="orderIdDisplay">@orderId</span>
                <button class="copy-btn" onclick="copyOrderId()">📋 复制</button>
            </div>
        </div>

        <!-- 二维码 -->
        <div class="qr-container">
            @if (!string.IsNullOrEmpty(qrCodeUrl))
            {
                <img id="qrCodeImage" src="@qrCodeUrl" alt="微信支付二维码" />
            }
            else
            {
                <div class="qr-placeholder">
                    <div class="big-icon">💚</div>
                    <span>微信收款码</span>
                    <span style="font-size:0.5rem;color:rgba(255,255,255,0.04);">请联系管理员获取</span>
                </div>
            }
        </div>

        <p style="color:rgba(255,255,255,0.08);font-size:0.6rem;">
            💡 扫码支付时请 <strong style="color:#07C160;">务必备注订单号</strong>
        </p>

        <!-- 支付步骤 -->
        <div class="info-box">
            <div class="label">📌 支付步骤</div>
            <div class="step-guide">
                <div class="step">
                    <span class="num">1</span>
                    打开微信扫一扫，扫描上方二维码
                </div>
                <div class="step">
                    <span class="num">2</span>
                    支付 <strong style="color:#F59E0B;">¥@amount.ToString("F2")</strong>
                </div>
                <div class="step">
                    <span class="num">3</span>
                    在备注中填写 <strong style="color:#8B5CF6;">@orderId</strong>
                </div>
                <div class="step">
                    <span class="num">4</span>
                    点击下方 <strong style="color:#07C160;">"查询支付状态"</strong>
                </div>
            </div>
        </div>

        <!-- 支付须知 -->
        <div class="info-box" style="background:rgba(255,193,7,0.03);border-color:rgba(255,193,7,0.04);">
            <div class="label">⚠️ 支付须知</div>
            <div class="value">
                • 支付后请 <strong style="color:#07C160;">保留截图</strong><br />
                • 管理员将在 <strong>24小时内</strong> 确认<br />
                • 确认后你会收到邮件通知<br />
                • 如有问题请联系管理员
            </div>
        </div>

        <!-- 状态 -->
        <div class="status waiting" id="payStatus">
            ⏳ 等待支付...
        </div>

        <button class="btn-check" onclick="checkPayment()" id="checkBtn">
            🔄 查询支付状态
        </button>

        <div>
            <a href="/Resource/History" class="btn-back">← 返回我的申请</a>
        </div>

    </div>
</div>

<script>
    var orderId = '@orderId';
    var requestId = @(requestId ?? 0);
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var isPaid = false;
    var checkInterval = null;

    // ============================================================
    // 复制订单号
    // ============================================================
    function copyOrderId() {
        var text = document.getElementById('orderIdDisplay').textContent;
        navigator.clipboard.writeText(text).then(function() {
            var btn = document.querySelector('.copy-btn');
            btn.textContent = '✅ 已复制';
            btn.style.color = '#28a745';
            setTimeout(function() {
                btn.textContent = '📋 复制';
                btn.style.color = '';
            }, 2000);
        }).catch(function() {
            var input = document.createElement('input');
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            alert('订单号已复制！');
        });
    }

    // ============================================================
    // 查询支付状态
    // ============================================================
    function checkPayment() {
        var btn = document.getElementById('checkBtn');
        var status = document.getElementById('payStatus');

        if (isPaid) {
            status.className = 'status paid';
            status.textContent = '✅ 已支付！管理员将尽快处理';
            btn.textContent = '✅ 已支付';
            return;
        }

        btn.disabled = true;
        btn.textContent = '⏳ 查询中...';
        status.className = 'status checking';
        status.textContent = '🔍 正在查询支付状态...';

        fetch('/Pay/CheckStatus?orderId=' + encodeURIComponent(orderId), {
            headers: {
                'RequestVerificationToken': token
            }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.paid) {
                isPaid = true;
                status.className = 'status paid';
                status.textContent = '✅ 支付已确认！管理员将尽快处理';
                btn.textContent = '✅ 已支付';
                btn.disabled = true;
                if (checkInterval) clearInterval(checkInterval);
                setTimeout(function() {
                    window.location.href = '/Resource/History';
                }, 2000);
            } else {
                status.className = 'status waiting';
                status.textContent = '⏳ 等待支付确认...\n💡 请确保已付款并备注订单号';
                btn.disabled = false;
                btn.textContent = '🔄 查询支付状态';
            }
        })
        .catch(function() {
            status.className = 'status waiting';
            status.textContent = '⚠️ 查询失败，请重试';
            btn.disabled = false;
            btn.textContent = '🔄 查询支付状态';
        });
    }

    // 每15秒自动查询一次
    if (!isPaid) {
        checkInterval = setInterval(function() {
            fetch('/Pay/CheckStatus?orderId=' + encodeURIComponent(orderId), {
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.paid) {
                    isPaid = true;
                    var status = document.getElementById('payStatus');
                    status.className = 'status paid';
                    status.textContent = '✅ 支付已确认！正在跳转...';
                    if (checkInterval) clearInterval(checkInterval);
                    setTimeout(function() {
                        window.location.href = '/Resource/History';
                    }, 1500);
                }
            })
            .catch(function() {});
        }, 15000);
    }

    // 页面关闭时清除定时器
    window.addEventListener('beforeunload', function() {
        if (checkInterval) clearInterval(checkInterval);
    });
</script>
