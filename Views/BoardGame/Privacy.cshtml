@{
    ViewData["Title"] = "棋盘对局隐私声明";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/BoardGame/Index";
    var safeReturnUrl = Url.IsLocalUrl(returnUrl) ? returnUrl : "/BoardGame/Index";
}
<link rel="stylesheet" href="~/css/boardgame.css" />
<div class="bg-body">
    <div class="bg-privacy">
        <h1>隐私声明与使用说明</h1>
        <p class="subtitle">棋盘对局功能 · 版本 v1</p>
        <article class="bg-privacy-card">
            <h2>一、收集和处理的信息</h2>
            <p>使用在线对局时，系统需要处理房间码、棋类和棋局状态、走子、对局结果及创建时间。登录玩家使用现有账号昵称和用户编号；游客使用本次站点会话中的临时昵称、Emoji 头像和随机访客标识。临时标识用于区分同一房间中的玩家，不是实名信息。</p>
            <p>聊天功能开启时，聊天文本会被保存并通过第三方 DeepSeek AI 服务进行内容审核；选择 AI 对弈时，棋类、棋盘状态和合法走法可能发送给该服务以生成落子。上述请求不主动包含账号密码。第三方服务的数据处理以其当时有效的隐私政策为准。</p>
            <h2>二、使用目的与可见范围</h2>
            <ul>
                <li>用棋局状态和走子记录支持对局同步、规则校验及棋局回放。</li>
                <li>聊天内容仅用于对局内显示和审核；审核未通过的消息不广播。</li>
                <li>回放列表只显示双方均为登录玩家且已结束的真人对局。</li>
                <li>隐私同意记录保存账号编号或访客标识、声明版本及同意时间，用于记载本功能的授权状态。</li>
            </ul>
            <h2>三、存储、保留与共享</h2>
            <p>棋局数据保存在本网站配置的 Turso 数据库中。网站当前未实现自动到期清理，因此不能承诺固定删除期限；请勿在聊天中发送密码、联系方式或其他敏感个人信息。请求 AI 对局或聊天审核时，相关文本/棋局数据会发送到 DeepSeek 接口处理。</p>
            <p>除完成本功能所需的数据库和 AI 服务处理外，网站不会主动将棋局内容用于公开展示；法律法规要求或为保护服务安全的情形除外。房间对局内信息会提供给同房间玩家。</p>
            <h2>四、游客与账号</h2>
            <p>游客昵称和头像仅用于显示，但访客标识依赖站点会话；清除浏览器会话或服务器会话失效后，可能无法继续使用原游客身份。登录用户的棋局会与账号关联。请妥善使用登录设备。</p>
            <h2>五、你的选择</h2>
            <p>你可以拒绝本声明并返回大厅之外的页面；未同意前不能创建或加入对局。停止使用即可退出后续处理。如需咨询或申请处理相关数据，请通过网站首页联系方式联系站点维护者。</p>
            <h2>六、功能限制与安全</h2>
            <p>棋局落子由服务器按当前实现的规则校验。国际象棋当前版本不支持易位和吃过路兵；AI 棋力仅供娱乐。网站会采取合理措施保护数据，但网络传输、第三方服务和临时会话均存在技术限制。</p>
            <h2>七、声明更新</h2>
            <p>功能或数据处理方式发生变化时，本声明可能更新。继续使用前请查看页面标注的版本。</p>
        </article>
        <div class="bg-privacy-actions">
            <a class="bg-btn bg-btn-ghost" href="/BoardGame/Index">返回</a>
            <button type="button" class="bg-btn bg-btn-primary" onclick="agreeAndGo()">✓ 我已阅读并同意</button>
        </div>
    </div>
</div>
<div class="bg-toast" id="toast" role="status" aria-live="polite"></div>
<script>
    const RETURN_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(safeReturnUrl));
    function showToast(message) {
        const toast = document.getElementById('toast');
        toast.textContent = message; toast.classList.add('show');
        clearTimeout(toast._timer); toast._timer = setTimeout(() => toast.classList.remove('show'), 3200);
    }
    async function agreeAndGo() {
        let saved = true;
        try {
            const response = await fetch('/api/boardgame/privacy-agree', { method: 'POST', credentials: 'same-origin' });
            const data = response.ok ? await response.json().catch(() => ({})) : {};
            saved = data.saved !== false;
        } catch { saved = false; }
        // 本地先标记已同意，保证任何网络/存储异常都不会阻断进入对局
        try { localStorage.setItem('bg_privacy_agreed_v1', '1'); } catch { }
        if (!saved) showToast('同意记录暂未保存到云端，但不影响本次使用');
        location.href = RETURN_URL;
    }
</script>
