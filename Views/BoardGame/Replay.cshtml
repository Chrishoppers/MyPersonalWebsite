@{
    ViewData["Title"] = "棋局回放";
    var roomId = ViewBag.RoomId is long value ? value : Convert.ToInt64(ViewBag.RoomId ?? 0);
}
<link rel="stylesheet" href="~/css/boardgame.css" />
<div class="bg-body">
    <div class="bg-play bg-replay-layout">
        <section class="bg-play-main">
            <header class="bg-play-header"><div class="bg-play-title"><h1 id="replayTitle">棋局回放</h1><span class="bg-status-pill bg-replay-pill">🎬 回放模式</span></div>
                <div class="bg-replay-controls"><button type="button" class="bg-btn" id="playBtn">▶ 播放</button><button type="button" class="bg-btn" id="backBtn">◀ 上一步</button><button type="button" class="bg-btn" id="forwardBtn">下一步 ▶</button></div>
            </header>
            <div class="bg-board-wrap"><canvas id="board" width="680" height="680" aria-label="棋局回放棋盘"></canvas></div>
            <section class="bg-panel bg-progress-panel"><input type="range" id="progress" min="0" max="0" value="0" aria-label="回放进度" /><span id="progressText">0 / 0</span></section>
        </section>
        <aside class="bg-play-side">
            <section class="bg-panel"><h2 class="bg-panel-title">对局信息</h2><div id="gameInfo" class="bg-replay-info">正在加载…</div></section>
            <section class="bg-panel"><h2 class="bg-panel-title">走子记录</h2><div class="bg-moves" id="movesList"></div></section>
            <a class="bg-btn" href="/BoardGame/Index">返回棋盘大厅</a>
        </aside>
    </div>
</div>
<div class="bg-toast" id="toast" role="status" aria-live="polite"></div>
<script src="~/js/boardgame/gomoku.js" asp-append-version="true"></script>
<script src="~/js/boardgame/xiangqi.js" asp-append-version="true"></script>
<script src="~/js/boardgame/chess.js" asp-append-version="true"></script>
<script>
    const ROOM_ID = @roomId;
    let moves = [], roomData, renderer, currentIndex = 0, playing = false, playTimer;
    const $ = id => document.getElementById(id);
    async function loadReplay() {
        const replaySets = await Promise.all(['gomoku', 'xiangqi', 'chess'].map(type =>
            fetch(`/api/boardgame/replays/${type}`).then(response => response.ok ? response.json() : [])));
        roomData = replaySets.flat().find(room => room.id === ROOM_ID);
        if (!roomData) { $('gameInfo').textContent = '找不到该棋局回放。'; return; }
        const response = await fetch(`/api/boardgame/replay/${ROOM_ID}/moves`);
        if (!response.ok) { $('gameInfo').textContent = '无法读取棋局记录。'; return; }
        const payload = await response.json();
        moves = payload.moves || [];
        $('replayTitle').textContent = `🎬 ${roomData.hostName || '玩家'} vs ${roomData.guestName || '玩家'}`;
        const info = document.createElement('div');
        info.textContent = `结果：${roomData.winner || '平局'}　${roomData.resultReason || ''}　共 ${moves.length} 手`;
        $('gameInfo').replaceChildren(info);
        const map = { gomoku: window.GomokuBoard, xiangqi: window.XiangqiBoard, chess: window.ChessBoard };
        renderer = map[payload.gameType];
        if (!renderer) { $('gameInfo').textContent = '未知棋类。'; return; }
        renderer.mount($('board'), () => {});
        renderer.setState(initialState(payload.gameType));
        $('progress').max = moves.length;
        renderMoves(); renderProgress(0);
    }
    function initialState(type) {
        const rows = type === 'xiangqi'
            ? ['rnbakabnr','         ',' c     c ','p p p p p','         ','         ','P P P P P',' C     C ','         ','RNBAKABNR']
            : type === 'chess' ? ['rnbqkbnr','pppppppp','        ','        ','        ','        ','PPPPPPPP','RNBQKBNR'] : null;
        const cells = rows ? rows.map(row => [...row].map(piece => piece === ' ' ? '' : piece)) : Array.from({ length: 15 }, () => Array(15).fill(''));
        return JSON.stringify({ cells });
    }
    function renderProgress(index) {
        currentIndex = Math.max(0, Math.min(moves.length, Number(index)));
        $('progress').value = currentIndex;
        $('progressText').textContent = `${currentIndex} / ${moves.length}`;
        renderer.setState(currentIndex === 0 ? initialState(roomData.gameType) : moves[currentIndex - 1].boardStateAfter);
        [...$('movesList').children].forEach((item, index) => item.classList.toggle('latest', index === currentIndex - 1));
    }
    function renderMoves() {
        const list = $('movesList'); list.replaceChildren();
        moves.forEach((move, index) => {
            const item = document.createElement('button'); item.type = 'button'; item.className = 'bg-move-item';
            item.textContent = `#${index + 1} ${move.moveText || `${move.from || ''}→${move.to || ''}`}`;
            item.onclick = () => renderProgress(index + 1); list.appendChild(item);
        });
    }
    function stepForward() { if (currentIndex < moves.length) renderProgress(currentIndex + 1); }
    function togglePlay() {
        playing = !playing; $('playBtn').textContent = playing ? '⏸ 暂停' : '▶ 播放';
        if (playing) playLoop(); else clearTimeout(playTimer);
    }
    function playLoop() {
        if (!playing || currentIndex >= moves.length) { playing = false; $('playBtn').textContent = '▶ 播放'; return; }
        stepForward(); playTimer = setTimeout(playLoop, 900);
    }
    $('progress').addEventListener('input', event => renderProgress(event.target.value));
    $('playBtn').addEventListener('click', togglePlay);
    $('backBtn').addEventListener('click', () => renderProgress(currentIndex - 1));
    $('forwardBtn').addEventListener('click', stepForward);
    loadReplay().catch(() => { $('gameInfo').textContent = '加载回放失败，请稍后重试。'; });
</script>
