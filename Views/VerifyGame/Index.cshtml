                <span class="status-icon" id="voiceIcon">🎤</span>
                <span class="status-text" id="voiceText">🎤 语音就绪</span>
                <span class="transcript-display" id="voiceTranscript">等待指令</span>
            `;
            container.insertBefore(bar, container.firstChild);
            updateVoiceUI(status, text, transcript);
            return;
        }

        var icon = document.getElementById('voiceIcon') || statusBar.querySelector('.status-icon');
        var textEl = document.getElementById('voiceText') || statusBar.querySelector('.status-text');
        var transcriptEl = document.getElementById('voiceTranscript') || statusBar.querySelector('.transcript-display');

        if (icon) { icon.textContent = status === 'listening' ? '🎤' : status === 'error' ? '🚫' : '🎤'; }
        if (textEl) { textEl.innerHTML = text || '🎤 语音就绪'; }
        if (transcriptEl) {
            if (transcript) {
                transcriptEl.textContent = transcript;
                transcriptEl.classList.add('active');
            } else {
                transcriptEl.textContent = status === 'listening' ? '👂 听你说...' : '等待指令';
                transcriptEl.classList.remove('active');
            }
        }
    }

    // ============================================================
    // 作弊检测
    // ============================================================
    function triggerCheatPenalty(message, penalty) {
        if (cheatDetection.isCheatPopupActive || gameState.isGameOver || gameState.isAnswered) return;

        cheatDetection.isCheatPopupActive = true;
        cheatDetection.pendingPenalty = penalty || 5;

        // 暂停游戏
        if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
        document.querySelectorAll('.option-btn, .color-option, .ab-key-btn, .puzzle-cell, .char-btn, .key-btn, .btn-memory')
            .forEach(function(el) { el.dataset._disabled = el.disabled || false; el.disabled = true; el.style.pointerEvents = 'none'; });

        document.getElementById('cheatPopupMsg').textContent = message || '为了维护游戏公平性，本局将扣除 ' + (penalty || 5) + ' 分。';
        var popup = document.getElementById('cheatPopup');
        popup.classList.add('active');

        var countdown = 10;
        var timerEl = document.getElementById('cheatPopupTimer');
        timerEl.textContent = '⏱ ' + countdown + 's 后自动恢复';
        var countdownInterval = setInterval(function() {
            countdown--;
            if (countdown <= 0) {
                clearInterval(countdownInterval);
                timerEl.textContent = '⏱ 即将自动恢复...';
                setTimeout(onCheatPopupConfirm, 500);
            } else {
                timerEl.textContent = '⏱ ' + countdown + 's 后自动恢复';
            }
        }, 1000);
        popup._countdownInterval = countdownInterval;
        gameState.cheatCount++;
        updateUI();
    }

    function onCheatPopupConfirm() {
        var popup = document.getElementById('cheatPopup');
        if (popup._countdownInterval) { clearInterval(popup._countdownInterval); }
        var penalty = cheatDetection.pendingPenalty || 5;
        gameState.score = Math.max(0, gameState.score - penalty);
        updateUI();
        popup.classList.remove('active');
        cheatDetection.isCheatPopupActive = false;
        cheatDetection.pendingPenalty = 0;

        // 恢复游戏
        document.querySelectorAll('.option-btn, .color-option, .ab-key-btn, .puzzle-cell, .char-btn, .key-btn, .btn-memory')
            .forEach(function(el) { el.disabled = el.dataset._disabled === 'true' || false; el.style.pointerEvents = ''; delete el.dataset._disabled; });
        if (gameState.timeLeft > 0 && !gameState.isAnswered) { startTimer(gameState.timeLeft); }
        else if (!gameState.isAnswered && gameState.timeLeft <= 0) {
            gameState.isAnswered = true; gameState.combo = 0; gameState.lives--;
            updateUI(); showFeedback(false, 0, '⏱ 时间到！');
            if (gameState.lives <= 0) { setTimeout(gameOver, 1200); } else { setTimeout(loadChallenge, 1500); }
        }
        showToast('⚖️ 已扣除 ' + penalty + ' 分', 'warning');
    }

    function initCheatDetection() {
        document.addEventListener('visibilitychange', function() {
            if (document.hidden && gameState.isPlaying && !gameState.isAnswered) {
                cheatDetection.tabSwitchCount++;
                if (cheatDetection.tabSwitchCount >= 3) { triggerCheatPenalty('检测到多次切换应用，扣除 5 分', 5); cheatDetection.tabSwitchCount = 0; }
            }
        });
        window.addEventListener('blur', function() {
            if (gameState.isPlaying && !gameState.isAnswered) {
                cheatDetection.blurCount++;
                if (cheatDetection.blurCount >= 3) { triggerCheatPenalty('窗口失去焦点，扣除 5 分', 5); cheatDetection.blurCount = 0; }
            }
        });
        window.addEventListener('focus', function() { cheatDetection.blurCount = 0; });
        document.addEventListener('mouseleave', function() {
            if (gameState.isPlaying && !gameState.isAnswered) { cheatDetection.mouseLeaveCount++; }
        });
        document.addEventListener('mouseenter', function() {
            if (cheatDetection.mouseLeaveCount > 5) { triggerCheatPenalty('检测到异常鼠标操作模式，扣除 5 分', 5); cheatDetection.mouseLeaveCount = 0; }
            else { cheatDetection.mouseLeaveCount = 0; }
        });
        document.addEventListener('click', function(e) {
            if (!gameState.isPlaying || gameState.isAnswered) return;
            var now = Date.now();
            var timeSinceLast = now - cheatDetection.lastClickTime;
            cheatDetection.lastClickTime = now;
            cheatDetection.clickCount++;
            cheatDetection.clickPositions.push({ x: e.clientX, y: e.clientY, time: now });
            if (cheatDetection.clickCount > 10 && timeSinceLast < 50) {
                triggerCheatPenalty('检测到异常点击频率，扣除 5 分', 5);
                cheatDetection.clickCount = 0; return;
            }
            if (cheatDetection.clickPositions.length > 5) {
                var recent = cheatDetection.clickPositions.slice(-5);
                var allSame = recent.every(function(p) { return p.x === recent[0].x && p.y === recent[0].y; });
                if (allSame) { triggerCheatPenalty('检测到异常点击模式，扣除 5 分', 5); cheatDetection.clickPositions = []; return; }
            }
            if (cheatDetection.clickPositions.length > 20) { cheatDetection.clickPositions = cheatDetection.clickPositions.slice(-10); }
        });
        document.addEventListener('contextmenu', function(e) {
            if (gameState.isPlaying && !gameState.isAnswered) { e.preventDefault(); triggerCheatPenalty('检测到右键操作，扣除 5 分', 5); }
        });
        document.addEventListener('keydown', function(e) {
            if (!gameState.isPlaying || gameState.isAnswered) return;
            if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J'))) {
                e.preventDefault(); triggerCheatPenalty('检测到开发者工具，扣除 5 分', 5);
            }
        });
        var resizeCount = 0, lastResizeTime = 0;
        window.addEventListener('resize', function() {
            if (!gameState.isPlaying || gameState.isAnswered) return;
            var now = Date.now();
            if (now - lastResizeTime < 500) {
                resizeCount++;
                if (resizeCount > 5) { triggerCheatPenalty('检测到异常窗口操作，扣除 5 分', 5); resizeCount = 0; }
            } else { resizeCount = 1; }
            lastResizeTime = now;
        });
    }

    // ============================================================
    // 游戏核心
    // ============================================================
    function startGame() {
        document.getElementById('permissionOverlay').classList.add('active');
        setTimeout(function() { testMic(); }, 300);
    }

    function startGameInternal() {
        if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
        gameState.level = 1; gameState.score = 0; gameState.lives = 3; gameState.combo = 0;
        gameState.maxCombo = 0; gameState.passed = 0; gameState.cheatCount = 0;
        gameState.isPlaying = true; gameState.isAnswered = false; gameState.isGameOver = false;
        gameState.timeLeft = 15; gameState.currentChallenge = null;
        gameState.answerTimes = []; gameState.questionStartTime = null;

        cheatDetection.tabSwitchCount = 0; cheatDetection.clickPositions = [];
        cheatDetection.clickCount = 0; cheatDetection.blurCount = 0;
        cheatDetection.mouseLeaveCount = 0; cheatDetection.isCheatPopupActive = false;

        document.getElementById('statusBar').style.display = 'flex';
        document.getElementById('progressBar').style.display = 'block';
        document.getElementById('rankSection').style.display = 'none';
        document.getElementById('typeBadge').style.display = 'block';
        document.getElementById('typeNameDisplay').textContent = '📝 第 1 关 · 入门';

        if (gameState.micEnabled && !document.querySelector('.voice-status-bar')) {
            var container = document.getElementById('gameContent');
            var bar = document.createElement('div');
            bar.className = 'voice-status-bar';
            bar.id = 'voiceStatusBar';
            bar.innerHTML = `
                <span class="status-icon" id="voiceIcon">🎤</span>
                <span class="status-text" id="voiceText">🎤 语音就绪</span>
                <span class="transcript-display" id="voiceTranscript">等待指令</span>
            `;
            container.insertBefore(bar, container.firstChild);
        }

        updateUI();
        initCheatDetection();
        loadChallenge();
    }

    function loadChallenge() {
        if (!gameState.isPlaying || gameState.isGameOver) return;
        if (gameState.level > gameState.totalLevels) { gameWin(); return; }

        gameState.isAnswered = false;
        gameState.questionStartTime = Date.now();

        document.getElementById('feedback').className = 'feedback';
        document.getElementById('feedback').style.display = 'none';
        document.getElementById('gameContent').innerHTML = '';

        if (gameState.micEnabled && !document.querySelector('.voice-status-bar')) {
            var container = document.getElementById('gameContent');
            var bar = document.createElement('div');
            bar.className = 'voice-status-bar';
            bar.id = 'voiceStatusBar';
            bar.innerHTML = `
                <span class="status-icon" id="voiceIcon">🎤</span>
                <span class="status-text" id="voiceText">🎤 语音就绪</span>
                <span class="transcript-display" id="voiceTranscript">等待指令</span>
            `;
            container.insertBefore(bar, container.firstChild);
        }

        var diffLabel = getDifficultyLabel(gameState.level);
        document.getElementById('typeBadge').textContent = '第 ' + gameState.level + ' 关';

        fetch('/VerifyGame/GetChallenge?level=' + gameState.level)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    gameState.currentChallenge = data.data;
                    if (data.data.typeName) {
                        document.getElementById('typeNameDisplay').textContent = '🧩 ' + data.data.typeName + ' · ' + diffLabel;
                    }
                    renderChallenge(data.data);
                } else {
                    showToast('加载挑战失败，请重试', 'error');
                }
            })
            .catch(function() { showToast('网络错误，请刷新重试', 'error'); });
    }

    // ============================================================
    // 渲染挑战
    // ============================================================
    function renderChallenge(challenge) {
        gameState.currentChallenge = challenge;
        var typeName = challenge.typeName || challenge.type || '未知';
        var diffLabel = getDifficultyLabel(challenge.level);
        document.getElementById('typeBadge').textContent = '第 ' + challenge.level + ' 关 · ' + typeName + ' · ' + diffLabel;
        document.getElementById('typeNameDisplay').textContent = '🧩 ' + typeName + ' · ' + diffLabel;
        document.getElementById('questionText').innerHTML = challenge.question || '请完成以下挑战';

        var container = document.getElementById('gameContent');

        if (gameState.micEnabled && !document.querySelector('.voice-status-bar')) {
            var bar = document.createElement('div');
            bar.className = 'voice-status-bar';
            bar.id = 'voiceStatusBar';
            bar.innerHTML = `
                <span class="status-icon" id="voiceIcon">🎤</span>
                <span class="status-text" id="voiceText">🎤 语音就绪</span>
                <span class="transcript-display" id="voiceTranscript">等待指令</span>
            `;
            container.insertBefore(bar, container.firstChild);
        }

        var children = container.children;
        for (var i = children.length - 1; i >= 0; i--) {
            if (children[i].id !== 'voiceStatusBar') { children[i].remove(); }
        }

        // 1A2B
        if (challenge.type === 'abgame') { renderABGame(challenge); return; }

        // 颜色混合
        if (challenge.type === 'colorMix') { renderColorMix(challenge); return; }

        // 图形旋转
        if (challenge.type === 'rotate' && challenge.originalSvg) {
            var rotateDiv = document.createElement('div');
            rotateDiv.className = 'rotate-compare';
            rotateDiv.innerHTML = `
                <div class="rotate-item"><span class="label">📐 原图</span>${challenge.originalSvg}</div>
                <div class="rotate-arrow">→</div>
                <div class="rotate-item"><span class="label">🔄 旋转后</span>${challenge.rotatedSvg || challenge.originalSvg}</div>
            `;
            container.appendChild(rotateDiv);
            renderOptions(challenge, container);
            startTimer(challenge.timeLimit || 15);
            updateUI();
            return;
        }

        // 找不同
        if (challenge.type === 'findDifferent' && challenge.originalDisplay) {
            renderFindDifferent(challenge);
            return;
        }

        // 数字记忆
        if (challenge.type === 'memory' && challenge.keyboardRows) {
            renderMemoryGame(challenge);
            return;
        }

        // 华容道
        if (challenge.type === 'puzzle' && challenge.puzzle) {
            renderPuzzle(challenge.puzzle);
            return;
        }

        // 三视图
        if (challenge.type === 'threeView') {
            renderThreeView(challenge);
            return;
        }

        // 通用渲染
        if (challenge.imageSvg) {
            var imgDiv = document.createElement('div');
            imgDiv.style.cssText = 'width:100%;text-align:center;margin:0.1rem 0 0.4rem;';
            imgDiv.innerHTML = '<div class="captcha-image">' + challenge.imageSvg + '</div>';
            container.appendChild(imgDiv);
        }

        if (challenge.displayHtml) {
            var colorDiv = document.createElement('div');
            colorDiv.className = 'color-display';
            colorDiv.innerHTML = challenge.displayHtml;
            container.appendChild(colorDiv);
        }

        if (challenge.displayText) {
            var textDiv = document.createElement('div');
            textDiv.className = 'display-text-container';
            textDiv.innerHTML = '<div class="display-text">' + challenge.displayText + '</div>';
            container.appendChild(textDiv);
        }

        renderOptions(challenge, container);
        startTimer(challenge.timeLimit || 15);
        updateUI();
    }

    function renderOptions(challenge, container) {
        if (challenge.options && challenge.options.length > 0) {
            var optGrid = document.createElement('div');
            optGrid.className = 'options-grid';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerHTML = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.dataset.index = idx;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                optGrid.appendChild(btn);
            });
            container.appendChild(optGrid);
        }
    }

    // ============================================================
    // 各题型渲染（精简版）
    // ============================================================

    // 1A2B
    var abState = { password: '', digitCount: 4, maxAttempts: 15, currentGuess: '', attemptCount: 0, history: [], gameSolved: false, isActive: false };

    function renderABGame(challenge) {
        abState.password = challenge.password || '';
        abState.digitCount = challenge.digitCount || 4;
        abState.maxAttempts = challenge.maxAttempts || 15;
        abState.currentGuess = '';
        abState.attemptCount = 0;
        abState.history = [];
        abState.gameSolved = false;
        abState.isActive = true;

        var container = document.getElementById('gameContent');

        var ruleDiv = document.createElement('div');
        ruleDiv.style.cssText = 'background:rgba(139,92,246,0.04);border:1px solid rgba(139,92,246,0.04);border-radius:12px;padding:0.4rem 0.6rem;margin-bottom:0.4rem;width:100%;';
        ruleDiv.innerHTML = `
            <div style="color:rgba(255,255,255,0.2);font-size:0.7rem;display:flex;flex-wrap:wrap;gap:0.2rem 0.6rem;justify-content:center;font-weight:500;">
                <span>🎯 猜 <strong style="color:#8B5CF6;">${abState.digitCount}</strong> 位不重复数字</span>
                <span style="color:rgba(255,255,255,0.05);">|</span>
                <span style="color:#28a745;">✅ A = 位置+数字正确</span>
                <span style="color:#F59E0B;">🟡 B = 数字正确位置不对</span>
            </div>
        `;
        container.appendChild(ruleDiv);

        var displayDiv = document.createElement('div');
        displayDiv.className = 'ab-display';
        displayDiv.id = 'abDisplay';
        displayDiv.textContent = ' '.repeat(abState.digitCount).split('').join(' ');
        container.appendChild(displayDiv);

        var statusDiv = document.createElement('div');
        statusDiv.className = 'ab-status';
        statusDiv.id = 'abStatus';
        statusDiv.innerHTML = '💡 剩余 <strong id="abAttempts">' + abState.maxAttempts + '</strong> 次机会';
        container.appendChild(statusDiv);

        var historyDiv = document.createElement('div');
        historyDiv.className = 'ab-history';
        historyDiv.id = 'abHistory';
        historyDiv.textContent = '📝 输入你的猜测...';
        container.appendChild(historyDiv);

        var keypadDiv = document.createElement('div');
        keypadDiv.className = 'ab-keypad';
        keypadDiv.id = 'abKeypad';
        var keypadRows = [['1','2','3'],['4','5','6'],['7','8','9'],['⌫','0','✅']];
        keypadRows.forEach(function(row) {
            row.forEach(function(key) {
                var btn = document.createElement('button');
                btn.className = 'ab-key-btn';
                btn.textContent = key;
                btn.dataset.key = key;
                if (key === '⌫') btn.classList.add('key-backspace');
                else if (key === '✅') btn.classList.add('key-submit');
                else btn.classList.add('key-number');
                btn.addEventListener('click', function() { handleABKeyPress(key); });
                keypadDiv.appendChild(btn);
            });
        });
        container.appendChild(keypadDiv);

        function handlePhysicalKey(e) {
            if (!abState.isActive || abState.gameSolved || gameState.isAnswered) return;
            var key = e.key;
            if (key >= '0' && key <= '9') { e.preventDefault(); handleABKeyPress(key); }
            else if (key === 'Backspace' || key === 'Delete') { e.preventDefault(); handleABKeyPress('⌫'); }
            else if (key === 'Enter') { e.preventDefault(); handleABKeyPress('✅'); }
        }
        document.addEventListener('keydown', handlePhysicalKey);
        window._abCleanup = function() { document.removeEventListener('keydown', handlePhysicalKey); };

        startTimer(challenge.timeLimit || 200);
    }

    function handleABKeyPress(key) {
        if (!abState.isActive || abState.gameSolved || gameState.isAnswered) return;
        var digitCount = abState.digitCount, maxAttempts = abState.maxAttempts, password = abState.password;
        var displayEl = document.getElementById('abDisplay');
        var historyEl = document.getElementById('abHistory');
        var attemptsEl = document.getElementById('abAttempts');

        if (key === '⌫') {
            if (abState.currentGuess.length > 0) {
                abState.currentGuess = abState.currentGuess.slice(0, -1);
                var displayText = abState.currentGuess.padEnd(digitCount, ' ');
                displayEl.textContent = displayText.split('').join(' ');
            }
            return;
        }

        if (key === '✅') {
            if (abState.currentGuess.length !== digitCount) {
                showToast('请完整输入 ' + digitCount + ' 位数字', 'error'); return;
            }
            if (new Set(abState.currentGuess).size !== abState.currentGuess.length) {
                showToast('数字不能重复！', 'error'); return;
            }
            if (abState.currentGuess[0] === '0') {
                showToast('第一位不能是0！', 'error'); return;
            }

            abState.attemptCount++;
            var remaining = maxAttempts - abState.attemptCount;
            attemptsEl.textContent = remaining;

            var passwordArr = password.split(''), guessArr = abState.currentGuess.split('');
            var a = 0, b = 0, matchedIndexes = [];
            for (var i = 0; i < digitCount; i++) {
                if (guessArr[i] === passwordArr[i]) { a++; matchedIndexes.push(i); }
            }
            var unmatchedPassword = [], unmatchedGuess = [];
            for (var i = 0; i < digitCount; i++) {
                if (matchedIndexes.indexOf(i) === -1) {
                    unmatchedPassword.push(passwordArr[i]);
                    unmatchedGuess.push(guessArr[i]);
                }
            }
            for (var g of unmatchedGuess) {
                var idx = unmatchedPassword.indexOf(g);
                if (idx !== -1) { b++; unmatchedPassword.splice(idx, 1); }
            }

            var resultText = a + 'A' + b + 'B';
            var guessDisplay = abState.currentGuess.split('').join(' ');
            abState.history.push(guessDisplay + ' → ' + resultText);

            var html = '';
            var items = abState.history.slice(-6);
            for (var h = 0; h < items.length; h++) {
                html += '<div class="history-item">🔹 ' + items[h] + '</div>';
            }
            historyEl.innerHTML = html;

            if (a === digitCount) {
                abState.gameSolved = true;
                abState.isActive = false;
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                disableABKeyboard();
                var points = 10 + Math.floor(gameState.level / 5) + Math.max(0, maxAttempts - abState.attemptCount);
                showFeedback(true, points, '🎉 ' + abState.attemptCount + ' 次猜中！');
                gameState.score += points;
                gameState.combo++;
                gameState.passed++;
                if (gameState.combo > gameState.maxCombo) gameState.maxCombo = gameState.combo;
                updateUI();
                setTimeout(function() { gameState.level++; updateUI(); loadChallenge(); }, 2000);
                return;
            }

            if (remaining <= 0) {
                abState.isActive = false;
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                disableABKeyboard();
                showFeedback(false, 0, '💀 机会用尽！密码是 ' + password);
                gameState.combo = 0;
                gameState.lives--;
                updateUI();
                if (gameState.lives <= 0) { setTimeout(gameOver, 1500); } else { setTimeout(loadChallenge, 2000); }
                return;
            }

            abState.currentGuess = '';
            displayEl.textContent = ' '.repeat(digitCount).split('').join(' ');
            showToast('第 ' + abState.attemptCount + ' 次：' + resultText, 'info');
            return;
        }

        if (abState.currentGuess.length < digitCount) {
            if (abState.currentGuess.indexOf(key) !== -1) {
                showToast('数字不能重复！', 'error'); return;
            }
            if (abState.currentGuess.length === 0 && key === '0') {
                showToast('第一位不能是0！', 'error'); return;
            }
            abState.currentGuess += key;
            var displayText2 = abState.currentGuess.padEnd(digitCount, ' ');
            displayEl.textContent = displayText2.split('').join(' ');
        } else {
            showToast('已输入 ' + digitCount + ' 位，请点 ✅ 提交', 'info');
        }
    }

