    var currentTutorialIndex = 0;

    function showTutorial() {
        currentTutorialIndex = 0;
        document.getElementById('tutorialOverlay').classList.add('active');
        renderTutorial(currentTutorialIndex);
        document.body.style.overflow = 'hidden';
    }

    function closeTutorial() {
        document.getElementById('tutorialOverlay').classList.remove('active');
        document.body.style.overflow = '';
    }

    function renderTutorial(index) {
        var container = document.getElementById('tutorialContent');
        var total = tutorialSteps.length;
        var step = tutorialSteps[index];
        if (!step) return;

        var prevDisabled = index === 0 ? 'disabled' : '';
        var nextDisabled = index === total - 1 ? 'disabled' : '';
        var isLast = index === total - 1;

        container.innerHTML = `
            <div class="tutorial-title">
                ${step.title}
                <span class="page-counter">${index + 1}/${total}</span>
            </div>
            <div class="tutorial-sub">${step.desc}</div>
            <div class="tutorial-demo-area active">
                <div class="demo-content">${step.demo || '💡 准备开始挑战吧！'}</div>
            </div>
            <div class="tutorial-nav">
                <button class="nav-btn" onclick="renderTutorial(${index - 1})" ${prevDisabled}>← 上一页</button>
                <button class="nav-btn ${isLast ? 'active' : ''}" onclick="${isLast ? 'closeTutorial()' : 'renderTutorial(' + (index + 1) + ')'}" ${nextDisabled}>
                    ${isLast ? '✅ 开始挑战' : '下一页 →'}
                </button>
                <button class="nav-btn close-tutorial" onclick="closeTutorial()">✕ 关闭</button>
            </div>
        `;
    }

    // ============================================================
    // 开始界面
    // ============================================================
    function renderStartScreen() {
        var container = document.getElementById('gameContent');
        document.getElementById('typeBadge').style.display = 'none';
        document.getElementById('questionText').innerHTML = '';
        document.getElementById('statusBar').style.display = 'none';
        document.getElementById('progressBar').style.display = 'none';
        document.getElementById('rankSection').style.display = 'none';
        document.getElementById('feedback').className = 'feedback';
        document.getElementById('feedback').style.display = 'none';
        document.getElementById('timerSection').style.display = 'none';
        document.getElementById('typeNameDisplay').textContent = '🎮 准备开始';

        container.innerHTML = `
            <div class="start-screen">
                <span class="logo-icon">🧩</span>
                <div class="title">验证大闯关</div>
                <p class="desc">100关 · 20种玩法 · 难度递增</p>
                <div class="start-buttons">
                    <button class="btn-start primary" onclick="startGame()">🚀 开始游戏</button>
                    <button class="btn-start ranking" onclick="showRankingOnly()">🏆 排行榜</button>
                    <button class="btn-start tutorial" onclick="showTutorial()">📖 玩法教程</button>
                </div>
            </div>
        `;
    }

    function showRankingOnly() {
        var container = document.getElementById('gameContent');
        container.innerHTML = `
            <div style="width:100%;padding:0.2rem 0;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem;">
                    <div style="color:#fff;font-weight:600;font-size:1rem;">🏆 排行榜</div>
                    <button onclick="renderStartScreen()" style="padding:0.3rem 1.2rem;border:none;border-radius:30px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.3);cursor:pointer;font-family:inherit;font-size:0.75rem;">← 返回</button>
                </div>
                <div id="rankListOnly"></div>
            </div>
        `;
        document.getElementById('typeNameDisplay').textContent = '🏆 排行榜';
        loadRankingOnly();
    }

    function loadRankingOnly() {
        var container = document.getElementById('rankListOnly');
        if (!container) return;
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success && data.data && data.data.length > 0) {
                    var html = '', medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" style="width:24px;height:24px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,0.04);flex-shrink:0;" />' :
                            '<div style="width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,0.04);display:flex;align-items:center;justify-content:center;font-size:0.5rem;color:rgba(255,255,255,0.15);flex-shrink:0;">' + (item.username ? item.username.charAt(0).toUpperCase() : '?') + '</div>';
                        var isMe = item.isMe || false;
                        html += '<div style="display:flex;align-items:center;gap:0.4rem;padding:0.3rem 0.4rem;border-bottom:1px solid rgba(255,255,255,0.02);">' +
                            '<span style="font-size:0.75rem;min-width:24px;text-align:center;color:rgba(255,255,255,0.1);">' + medal + '</span>' +
                            avatarHtml +
                            '<span style="flex:1;color:rgba(255,255,255,0.35);font-size:0.75rem;font-weight:500;">' + item.username + (isMe ? ' <span style="color:#8B5CF6;font-weight:700;">(我)</span>' : '') + '</span>' +
                            '<span style="color:#F59E0B;font-weight:700;font-size:0.8rem;">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div style="text-align:center;color:rgba(255,255,255,0.08);padding:1rem;">暂无排行数据</div>';
                }
            })
            .catch(function() {
                container.innerHTML = '<div style="text-align:center;color:rgba(255,255,255,0.08);padding:1rem;">加载失败</div>';
            });
    }

    // ============================================================
    // 启动
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        renderStartScreen();
        VoiceService.init();
        VoiceService.setupEvents();

        if (window.speechSynthesis) {
            window.speechSynthesis.getVoices();
            window.speechSynthesis.onvoiceschanged = function() {
                window.speechSynthesis.getVoices();
            };
        }
        console.log('🧩 验证大闯关已加载');
    });

    // 暴露全局
    window.startGame = startGame;
    window.startGameInternal = startGameInternal;
    window.loadChallenge = loadChallenge;
    window.renderStartScreen = renderStartScreen;
    window.showTutorial = showTutorial;
    window.closeTutorial = closeTutorial;
    window.renderTutorial = renderTutorial;
    window.showRankingOnly = showRankingOnly;
    window.restartGame = restartGame;
    window.confirmPermissions = confirmPermissions;
    window.skipPermissions = skipPermissions;
    window.onCheatPopupConfirm = onCheatPopupConfirm;
    window.selectChar = selectChar;
    window.submitMemoryAnswer = submitMemoryAnswer;
    window.memoryKeyPress = memoryKeyPress;
    window.memoryBackspace = memoryBackspace;
    window.handleABKeyPress = handleABKeyPress;
    window.updateHardwareTest = updateHardwareTest;
    window.testMic = testMic;
    window.showVoiceTutorial = showVoiceTutorial;
</script>
