<script>
    // ============================================================
    // 全局变量
    // ============================================================
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var userId = @(Context.Session.GetInt32("UserId") ?? 0);

    var gameState = {
        level: 1, score: 0, lives: 3, combo: 0, maxCombo: 0, passed: 0,
        cheatCount: 0, isPlaying: false, isAnswered: false, timer: null, timeLeft: 15,
        totalLevels: 100, currentChallenge: null, isGameOver: false,
        micEnabled: true,
        penaltyCheat: 5, penaltyMic: 4, penaltyCam: 2,
        answerTimes: [], questionStartTime: null
    };

    var cheatDetection = {
        tabSwitchCount: 0, maxTabSwitches: 3,
        clickPositions: [], clickCount: 0, lastClickTime: 0,
        mouseLeaveCount: 0, blurCount: 0,
        isCheatPopupActive: false, pendingPenalty: 0,
        // 答题节奏检测
        answerIntervals: [],
        lastAnswerTime: null
    };

    var hardwareTest = { mic: { status: 'pending', ready: false } };

    // ============================================================
    // 硬件测试
    // ============================================================
    function updateHardwareTest() {
        var micOn = document.getElementById('micToggle').checked;
        if (!micOn) {
            hardwareTest.mic.status = 'pending';
            hardwareTest.mic.ready = false;
            document.getElementById('micTestStatus').className = 'test-status pending';
            document.getElementById('micTestStatus').textContent = '⏳ 已关闭';
        }
        updateStartButton();
    }

    function updateStartButton() {
        var btn = document.getElementById('startGameBtn');
        var micOk = !document.getElementById('micToggle').checked || hardwareTest.mic.ready;
        if (micOk) {
            btn.disabled = false;
            btn.textContent = '✅ 开始游戏';
        } else {
            btn.disabled = true;
            btn.textContent = '⏳ 请测试麦克风';
        }
    }

    function testMic() {
        var statusEl = document.getElementById('micTestStatus');
        var micOn = document.getElementById('micToggle').checked;
        if (!micOn) { showToast('⚠️ 麦克风已关闭，请先开启', 'warning'); return; }

        statusEl.className = 'test-status testing';
        statusEl.textContent = '🔄 测试中...';

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            statusEl.className = 'test-status fail';
            statusEl.textContent = '❌ 不支持';
            hardwareTest.mic.status = 'fail';
            hardwareTest.mic.ready = false;
            updateStartButton();
            showToast('❌ 您的浏览器不支持麦克风', 'error');
            return;
        }

        navigator.mediaDevices.getUserMedia({ audio: true })
            .then(function(stream) {
                var audioContext = new (window.AudioContext || window.webkitAudioContext)();
                var source = audioContext.createMediaStreamSource(stream);
                var analyser = audioContext.createAnalyser();
                analyser.fftSize = 256;
                source.connect(analyser);
                var dataArray = new Uint8Array(analyser.frequencyBinCount);

                var checkInterval = setInterval(function() {
                    analyser.getByteFrequencyData(dataArray);
                    var sum = 0;
                    for (var i = 0; i < dataArray.length; i++) { sum += dataArray[i]; }
                    var avg = sum / dataArray.length;

                    if (avg > 5) {
                        clearInterval(checkInterval);
                        statusEl.className = 'test-status pass';
                        statusEl.textContent = '✅ 正常';
                        hardwareTest.mic.status = 'pass';
                        hardwareTest.mic.ready = true;
                        updateStartButton();
                        showToast('🎤 麦克风测试通过！', 'success');
                        stream.getTracks().forEach(function(t) { t.stop(); });
                        audioContext.close();
                    }
                }, 500);

                setTimeout(function() {
                    clearInterval(checkInterval);
                    if (hardwareTest.mic.status !== 'pass') {
                        statusEl.className = 'test-status pass';
                        statusEl.textContent = '✅ 正常';
                        hardwareTest.mic.status = 'pass';
                        hardwareTest.mic.ready = true;
                        updateStartButton();
                        showToast('🎤 麦克风测试通过', 'success');
                        stream.getTracks().forEach(function(t) { t.stop(); });
                        audioContext.close();
                    }
                }, 5000);
            })
            .catch(function(err) {
                statusEl.className = 'test-status fail';
                statusEl.textContent = '❌ 被拒绝';
                hardwareTest.mic.status = 'fail';
                hardwareTest.mic.ready = false;
                updateStartButton();
                showToast('❌ 麦克风被拒绝，请在浏览器中允许', 'error');
            });
    }

    // ============================================================
    // 权限确认
    // ============================================================
    function confirmPermissions() {
        gameState.micEnabled = document.getElementById('micToggle').checked;
        if (gameState.micEnabled && !hardwareTest.mic.ready) {
            showToast('⚠️ 请先测试麦克风', 'warning');
            return;
        }

        document.getElementById('permissionOverlay').classList.remove('active');

        // 显示语音教程（权限确认后弹出）
        setTimeout(function() {
            showVoiceTutorial();
        }, 500);

        if (gameState.micEnabled) {
            VoiceService.init();
            VoiceService.setupEvents();
            VoiceService.start();
            document.getElementById('micIndicator').className = 'indicator mic active';
        } else {
            document.getElementById('micIndicator').className = 'indicator mic inactive';
            showToast('⚠️ 麦克风已关闭，每关将扣除 4 分', 'warning');
        }

        startGameInternal();
    }

    function skipPermissions() {
        gameState.micEnabled = false;
        document.getElementById('permissionOverlay').classList.remove('active');
        document.getElementById('micIndicator').className = 'indicator mic inactive';
        showToast('⚠️ 已跳过麦克风，每关将扣除 4 分', 'warning');
        startGameInternal();
    }

    // ============================================================
    // 语音教程（权限确认后弹出）
    // ============================================================
    function showVoiceTutorial() {
        var overlay = document.createElement('div');
