<script>
    // ============================================================
    // ⭐ 音效系统
    // ============================================================
    var SoundFX = {
        ctx: null, enabled: true,
        init: function() {
            try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }
            catch(e) { this.enabled = false; }
        },
        ensure: function() {
            if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
        },
        play: function(type) {
            if (!this.enabled || !this.ctx) return;
            this.ensure();
            try {
                var now = this.ctx.currentTime;
                switch(type) {
                    case 'correct':
                        this.playNote(523.25, now, 0.12);
                        setTimeout(function() { SoundFX.playNote(659.25, SoundFX.ctx.currentTime, 0.12); }, 120);
                        setTimeout(function() { SoundFX.playNote(783.99, SoundFX.ctx.currentTime, 0.2); }, 250);
                        break;
                    case 'wrong':
                        var osc = this.ctx.createOscillator();
                        var gain = this.ctx.createGain();
                        osc.connect(gain); gain.connect(this.ctx.destination);
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(300, now);
                        osc.frequency.exponentialRampToValueAtTime(150, now + 0.4);
                        gain.gain.setValueAtTime(0.15, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                        osc.start(now); osc.stop(now + 0.4);
                        break;
                    case 'timeout':
                        var osc = this.ctx.createOscillator();
                        var gain = this.ctx.createGain();
                        osc.connect(gain); gain.connect(this.ctx.destination);
                        osc.type = 'square';
                        osc.frequency.setValueAtTime(800, now);
                        osc.frequency.exponentialRampToValueAtTime(400, now + 0.3);
                        gain.gain.setValueAtTime(0.08, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                        osc.start(now); osc.stop(now + 0.3);
                        break;
                    case 'gameover':
                        [0, 200, 400, 600].forEach(function(delay) {
                            setTimeout(function() {
                                var o = SoundFX.ctx.createOscillator();
                                var g = SoundFX.ctx.createGain();
                                o.connect(g); g.connect(SoundFX.ctx.destination);
                                o.type = 'sine';
                                o.frequency.setValueAtTime(600 - delay * 0.5, SoundFX.ctx.currentTime);
                                g.gain.setValueAtTime(0.1, SoundFX.ctx.currentTime);
                                g.gain.exponentialRampToValueAtTime(0.01, SoundFX.ctx.currentTime + 0.2);
                                o.start(SoundFX.ctx.currentTime);
                                o.stop(SoundFX.ctx.currentTime + 0.2);
                            }, delay);
                        });
                        break;
                    case 'start':
                        this.playNote(523.25, now, 0.08);
                        setTimeout(function() { SoundFX.playNote(659.25, SoundFX.ctx.currentTime, 0.08); }, 80);
                        setTimeout(function() { SoundFX.playNote(783.99, SoundFX.ctx.currentTime, 0.12); }, 170);
                        break;
                    case 'tick':
                        var osc = this.ctx.createOscillator();
                        var gain = this.ctx.createGain();
                        osc.connect(gain); gain.connect(this.ctx.destination);
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(1000, now);
                        gain.gain.setValueAtTime(0.03, now);
                        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.04);
                        osc.start(now); osc.stop(now + 0.04);
                        break;
                }
            } catch(e) {}
        },
        playNote: function(freq, time, duration) {
            var osc = this.ctx.createOscillator();
            var gain = this.ctx.createGain();
            osc.connect(gain); gain.connect(this.ctx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, time);
            gain.gain.setValueAtTime(0.12, time);
            gain.gain.exponentialRampToValueAtTime(0.01, time + duration);
            osc.start(time); osc.stop(time + duration);
        }
    };

    // ============================================================
    // 游戏状态
    // ============================================================
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var userId = @(Context.Session.GetInt32("UserId") ?? 0);

    var gameState = {
        level: 1, score: 0, lives: 3, combo: 0, maxCombo: 0, passed: 0,
        isPlaying: false, isAnswered: false, timer: null, timeLeft: 15,
        totalLevels: 100, currentChallenge: null,
    };

    var dom = {
        levelDisplay: document.getElementById('levelDisplay'),
        scoreDisplay: document.getElementById('scoreDisplay'),
        livesDisplay: document.getElementById('livesDisplay'),
        comboDisplay: document.getElementById('comboDisplay'),
        passedDisplay: document.getElementById('passedDisplay'),
        progressFill: document.getElementById('progressFill'),
        typeBadge: document.getElementById('typeBadge'),
        typeNameDisplay: document.getElementById('typeNameDisplay'),
        questionText: document.getElementById('questionText'),
        feedback: document.getElementById('feedback'),
        timerFill: document.getElementById('timerFill'),
        timerText: document.getElementById('timerText'),
        challengeCard: document.getElementById('challengeCard'),
        gameContent: document.getElementById('gameContent'),
        rankSection: document.getElementById('rankSection'),
        rankList: document.getElementById('rankList'),
        statusBar: document.getElementById('statusBar'),
        progressBar: document.getElementById('progressBar'),
        timerSection: document.getElementById('timerSection')
    };

    var abState = { password: '', digitCount: 4, maxAttempts: 15, currentGuess: '', attemptCount: 0, history: [], gameSolved: false, isActive: false };
    var puzzleState = null, puzzleEmptyRow = 0, puzzleEmptyCol = 0;

    var colorHexMap = {
        '红色': '#FF0000', '深红': '#8B0000', '粉色': '#FF69B4', '浅粉': '#FFB6C1',
        '蓝色': '#0000FF', '深蓝': '#00008B', '天蓝': '#87CEEB', '青色': '#00CED1',
        '绿色': '#00AA00', '深绿': '#006400', '草绿': '#7CFC00', '黄色': '#FFD700',
        '金色': '#DAA520', '橙色': '#FF6600', '深橙': '#CC5500', '紫色': '#8800CC',
