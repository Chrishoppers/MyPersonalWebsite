    // ============================================================
    // 提交答案
    // ============================================================
    function submitAnswer(challenge, answer, btn) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        var container = document.getElementById('gameContent');
        container.querySelectorAll('.option-btn').forEach(function(b) {
            b.disabled = true;
            if (b.dataset.answer === challenge.correctAnswer) b.classList.add('correct');
        });
        if (!isCorrect) {
            btn.classList.add('wrong');
            document.getElementById('challengeCard').classList.add('shake');
            setTimeout(function() { document.getElementById('challengeCard').classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    function handleAnswerResult(challenge, isCorrect) {
        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        // 记录答题时间
        var elapsed = (Date.now() - gameState.questionStartTime) / 1000;
        gameState.answerTimes.push({ elapsed: elapsed, isCorrect: isCorrect, level: gameState.level });

        // 作弊检测：秒答
        if (isCorrect && elapsed < 1.0) {
            triggerCheatPenalty('检测到异常快速答题', 5);
            return;
        }

        // 作弊检测：超慢
        var recent = gameState.answerTimes.slice(-10);
        if (recent.length >= 5) {
            var avgTime = recent.reduce(function(a, b) { return a + b.elapsed; }, 0) / recent.length;
            if (elapsed > avgTime * 3 && elapsed > 15) {
                triggerCheatPenalty('检测到异常缓慢答题', 5);
                return;
            }
        }

        // 计算惩罚
        var penalty = 0;
        if (!gameState.micEnabled) penalty += gameState.penaltyMic;

        var points = 0;
        if (isCorrect) {
            var bonus = Math.min(gameState.combo, 10);
            points = 10 + Math.floor(gameState.level / 5) + bonus * 2;
            points = Math.max(0, points - penalty);
            gameState.score += points;
            gameState.combo++;
            gameState.passed++;
            if (gameState.combo > gameState.maxCombo) gameState.maxCombo = gameState.combo;
            var msg = '✅ 答对了！ +' + points + ' 分';
            if (penalty > 0) msg += ' (已扣除 ' + penalty + ' 分权限惩罚)';
            showFeedback(true, points, challenge.funMessage, penalty);
            gameState.level++;
        } else {
            gameState.combo = 0;
            gameState.lives--;
            showFeedback(false, 0, '');
        }

        updateUI();

        if (gameState.lives <= 0) {
            setTimeout(gameOver, 1500);
            return;
        }
        setTimeout(function() { loadChallenge(); }, 1800);
    }

    // ============================================================
    // 计时器
    // ============================================================
    function startTimer(limit) {
        clearInterval(gameState.timer);
        gameState.timeLeft = limit || 15;
        updateTimerDisplay(limit || 15);

        gameState.timer = setInterval(function() {
            gameState.timeLeft--;
            updateTimerDisplay(limit || 15);
            if (gameState.timeLeft <= 0) {
                clearInterval(gameState.timer);
                if (!gameState.isAnswered) {
                    gameState.isAnswered = true;
                    disableAllInteractions();
                    gameState.combo = 0;
                    gameState.lives--;
                    updateUI();
                    showFeedback(false, 0, '⏱ 时间到！');
                    if (gameState.lives <= 0) {
                        setTimeout(gameOver, 1200);
                    } else {
                        setTimeout(function() { loadChallenge(); }, 1500);
                    }
                }
            }
        }, 1000);
    }

    function updateTimerDisplay(limit) {
        var pct = (gameState.timeLeft / Math.max(1, limit || 15)) * 100;
        document.getElementById('timerFill').style.width = Math.max(0, Math.min(100, pct)) + '%';
        document.getElementById('timerText').textContent = gameState.timeLeft + 's';
        document.getElementById('timerFill').className = 'timer-fill';
        if (pct < 30) document.getElementById('timerFill').classList.add('danger');
        else if (pct < 50) document.getElementById('timerFill').classList.add('warning');
    }

    function disableAllInteractions() {
        var container = document.getElementById('gameContent');
        container.querySelectorAll('.option-btn, .color-option, .ab-key-btn, .puzzle-cell, .char-btn, .key-btn, .btn-memory')
            .forEach(function(b) { b.disabled = true; });
        document.getElementById('memorySubmitBtn')?.setAttribute('disabled', 'disabled');
        if (window._memoryCleanup) {
            window._memoryCleanup();
            window._memoryCleanup = null;
        }
        if (window._abCleanup) {
            window._abCleanup();
            window._abCleanup = null;
        }
    }

    // ============================================================
    // 反馈
    // ============================================================
    function showFeedback(isCorrect, points, funMessage, penalty) {
        var el = document.getElementById('feedback');
        el.style.display = 'block';
        el.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');
        if (isCorrect) {
            var msg = '✅ 答对了！ +' + points + ' 分';
            if (penalty && penalty > 0) msg += ' (已扣除 ' + penalty + ' 分权限惩罚)';
            el.innerHTML = msg + (funMessage ? '<div class="fun-message">' + funMessage + '</div>' : '');
        } else {
            el.innerHTML = '❌ ' + (funMessage || '答错了！连击中断');
        }
    }

    // ============================================================
    // UI 更新
    // ============================================================
    function updateUI() {
        document.getElementById('levelDisplay').textContent = gameState.level;
        document.getElementById('scoreDisplay').textContent = gameState.score;
        document.getElementById('comboDisplay').textContent = gameState.combo;
        document.getElementById('passedDisplay').textContent = gameState.passed;
        document.getElementById('cheatDisplay').textContent = gameState.cheatCount;

        var hearts = '❤️'.repeat(gameState.lives) + '🖤'.repeat(Math.max(0, 3 - gameState.lives));
        document.getElementById('livesDisplay').textContent = hearts || '💀';

        var progress = (gameState.passed / gameState.totalLevels) * 100;
        document.getElementById('progressFill').style.width = Math.min(progress, 100) + '%';
    }

    function getDifficultyLabel(level) {
        if (level >= 81) return '👑 传说';
        if (level >= 61) return '💀 地狱';
        if (level >= 41) return '🔥 噩梦';
        if (level >= 21) return '⚡ 困难';
        return '📝 入门';
    }

    function getColorHex(name) {
        var map = {
            '红色': '#FF0000', '深红': '#8B0000', '粉色': '#FF69B4', '浅粉': '#FFB6C1',
            '蓝色': '#0000FF', '深蓝': '#00008B', '天蓝': '#87CEEB', '青色': '#00CED1',
            '绿色': '#00AA00', '深绿': '#006400', '草绿': '#7CFC00', '黄色': '#FFD700',
            '金色': '#DAA520', '橙色': '#FF6600', '深橙': '#CC5500', '紫色': '#8800CC',
            '深紫': '#4B0082', '棕色': '#8B4513', '灰色': '#808080', '黑色': '#000000',
            '白色': '#FFFFFF', '银色': '#C0C0C0', '紫罗兰': '#EE82EE', '靛蓝': '#4B0082'
