@{
    ViewData["Title"] = "🧩 验证大闯关";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<style>
    /* ============================================================
       全局重置
       ============================================================ */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a0f; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #e0e0e0; min-height: 100vh; overflow-x: hidden; }

    .game-container { max-width: 720px; margin: 0 auto; padding: 0.8rem 1.2rem 2rem; min-height: 100vh; position: relative; }

    /* ============================================================
       头部
       ============================================================ */
    .game-header { text-align: center; padding: 0.3rem 0 0.8rem; position: relative; }
    .game-header h1 { font-size: 2.4rem; font-weight: 900; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 40%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0; letter-spacing: -0.02em; }
    .game-header .subtitle { color: rgba(255,255,255,0.18); font-size: 0.9rem; margin-top: 0.05rem; letter-spacing: 0.06em; }
    .game-header .type-badge-header { display: inline-block; margin-top: 0.2rem; padding: 0.25rem 1.8rem; border-radius: 30px; background: rgba(139,92,246,0.08); color: #A78BFA; font-size: 0.85rem; border: 1px solid rgba(139,92,246,0.06); font-weight: 600; letter-spacing: 0.04em; }
    .header-particle { position: absolute; font-size: 0.5rem; opacity: 0.08; animation: floatParticle 12s infinite linear; pointer-events: none; }
    .header-particle:nth-child(1) { left: 3%; top: 15%; animation-delay: 0s; }
    .header-particle:nth-child(2) { left: 12%; top: 40%; animation-delay: 2.5s; }
    .header-particle:nth-child(3) { right: 8%; top: 20%; animation-delay: 4s; }
    .header-particle:nth-child(4) { right: 3%; top: 55%; animation-delay: 1.5s; }
    @@keyframes floatParticle { 0% { transform: translateY(0) rotate(0deg); opacity: 0.05; } 50% { opacity: 0.12; } 100% { transform: translateY(-25px) rotate(180deg); opacity: 0.05; } }

    /* ============================================================
       开始界面
       ============================================================ */
    .start-screen { text-align: center; padding: 0.8rem 0.5rem 1.5rem; width: 100%; }
    .start-screen .logo-icon { font-size: 4.5rem; margin-bottom: 0.3rem; display: block; animation: logoBounce 2.5s ease-in-out infinite; }
    @@keyframes logoBounce { 0%,100% { transform: scale(1) rotate(0deg); } 50% { transform: scale(1.06) rotate(2deg); } }
    .start-screen .title { font-size: 2.6rem; font-weight: 900; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 45%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 0.2rem; }
    .start-screen .desc { color: rgba(255,255,255,0.25); font-size: 1rem; margin-bottom: 1.8rem; }
    .start-screen .start-buttons { display: flex; flex-direction: column; gap: 0.7rem; max-width: 300px; margin: 0 auto; }
    .start-screen .start-buttons .btn-start { padding: 0.85rem 1.8rem; border: none; border-radius: 60px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1); font-family: inherit; position: relative; overflow: hidden; }
    .start-screen .start-buttons .btn-start.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; box-shadow: 0 4px 30px rgba(108,60,225,0.2); }
    .start-screen .start-buttons .btn-start.primary:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 12px 50px rgba(108,60,225,0.3); }
    .start-screen .start-buttons .btn-start.secondary { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.4); border: 1px solid rgba(255,255,255,0.06); }
    .start-screen .start-buttons .btn-start.secondary:hover { background: rgba(255,255,255,0.08); color: #fff; transform: translateY(-2px); }
    .start-screen .start-buttons .btn-start.ranking { background: rgba(139,92,246,0.08); color: #A78BFA; border: 1px solid rgba(139,92,246,0.06); }
    .start-screen .start-buttons .btn-start.ranking:hover { background: rgba(139,92,246,0.15); transform: translateY(-2px); }
    .start-screen .start-buttons .btn-start.tutorial-btn { background: rgba(245,158,11,0.08); color: #FBBF24; border: 1px solid rgba(245,158,11,0.06); }
    .start-screen .start-buttons .btn-start.tutorial-btn:hover { background: rgba(245,158,11,0.15); transform: translateY(-2px); }

    /* ============================================================
       状态栏
       ============================================================ */
    .status-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.2rem 0.8rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; padding: 0.6rem 1.2rem; margin-bottom: 0.8rem; backdrop-filter: blur(10px); }
    .status-item { color: rgba(255,255,255,0.3); font-size: 0.85rem; display: flex; align-items: center; gap: 0.3rem; font-weight: 500; }
    .status-item .value { color: #fff; font-weight: 700; font-size: 1.3rem; min-width: 20px; }
    .status-item .value.lives { color: #EC4899; font-size: 1.4rem; }
    .status-item .value.level { color: #8B5CF6; }
    .status-item .value.score { color: #F59E0B; }
    .status-item .value.combo { color: #34D399; }
    .status-item .value.passed { color: #8B5CF6; }

    .progress-bar { width: 100%; height: 3px; background: rgba(255,255,255,0.04); border-radius: 10px; margin-bottom: 0.8rem; overflow: hidden; }
    .progress-bar .fill { height: 100%; border-radius: 10px; background: linear-gradient(135deg, #8B5CF6, #EC4899); transition: width 0.6s ease; width: 0%; }

    /* ============================================================
       挑战卡片
       ============================================================ */
    .challenge-card { background: rgba(255,255,255,0.025); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.04); border-radius: 24px; padding: 1.5rem 1.8rem; min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow: hidden; transition: all 0.4s ease; box-shadow: 0 8px 40px rgba(0,0,0,0.2); }
    .challenge-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(ellipse at 30% 30%, rgba(139,92,246,0.015), transparent 70%); pointer-events: none; }
    .challenge-card .type-badge { position: absolute; top: 0.6rem; right: 0.8rem; font-size: 0.65rem; padding: 0.15rem 0.8rem; border-radius: 20px; background: rgba(139,92,246,0.08); color: #A78BFA; border: 1px solid rgba(139,92,246,0.04); font-weight: 600; z-index: 1; }
    .challenge-card .question-text { color: rgba(255,255,255,0.5); font-size: 1.1rem; text-align: center; line-height: 1.8; margin-bottom: 0.3rem; min-height: 36px; width: 100%; position: relative; z-index: 1; font-weight: 500; }

    /* ============================================================
       选项按钮
       ============================================================ */
    .options-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; width: 100%; max-width: 420px; position: relative; z-index: 1; }
    .options-grid .option-btn { padding: 0.8rem 1rem; border: 2px solid rgba(255,255,255,0.06); border-radius: 16px; background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); font-size: 1.05rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; font-family: inherit; text-align: center; position: relative; overflow: hidden; }
    .options-grid .option-btn:hover:not(:disabled) { border-color: rgba(139,92,246,0.2); background: rgba(139,92,246,0.06); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,0,0,0.15); }
    .options-grid .option-btn:disabled { cursor: not-allowed; opacity: 0.3; transform: none !important; }
    .options-grid .option-btn.correct { border-color: #28a745; background: rgba(40,167,69,0.12); color: #28a745; box-shadow: 0 0 30px rgba(40,167,69,0.05); }
    .options-grid .option-btn.wrong { border-color: #dc3545; background: rgba(220,53,69,0.12); color: #dc3545; box-shadow: 0 0 30px rgba(220,53,69,0.05); }

    /* ============================================================
       颜色选项
       ============================================================ */
    .color-options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; width: 100%; max-width: 380px; margin: 0 auto; position: relative; z-index: 1; }
    .color-options-grid .color-option { padding: 0.7rem 0.2rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 16px; background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.35s ease; display: flex; flex-direction: column; align-items: center; gap: 5px; }
    .color-options-grid .color-option:hover:not(.disabled) { border-color: rgba(139,92,246,0.15); background: rgba(139,92,246,0.04); transform: translateY(-3px); box-shadow: 0 8px 30px rgba(0,0,0,0.12); }
    .color-options-grid .color-option.disabled { cursor: not-allowed; opacity: 0.5; transform: none !important; }
    .color-options-grid .color-option .color-block { width: 50px; height: 50px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); transition: all 0.3s ease; }
    .color-options-grid .color-option .color-label { color: rgba(255,255,255,0.5); font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease; }
    .color-options-grid .color-option.correct { border-color: #28a745 !important; background: rgba(40,167,69,0.1) !important; }
    .color-options-grid .color-option.correct .color-label { color: #28a745 !important; }
    .color-options-grid .color-option.wrong { border-color: #dc3545 !important; background: rgba(220,53,69,0.1) !important; }
    .color-options-grid .color-option.wrong .color-label { color: #dc3545 !important; }

    /* ============================================================
       1A2B 键盘 - 3列网格
       ============================================================ */
    .ab-keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; max-width: 260px; margin: 0 auto; }
    .ab-key-btn { padding: 0.8rem 0.5rem; border: 2px solid rgba(255,255,255,0.06); border-radius: 14px; background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); font-size: 1.5rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; font-family: inherit; text-align: center; min-height: 52px; user-select: none; }
    .ab-key-btn:hover:not(:disabled) { background: rgba(139,92,246,0.08); border-color: rgba(139,92,246,0.15); transform: scale(1.04); color: #fff; }
    .ab-key-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .ab-key-btn.key-backspace { background: rgba(236,72,153,0.06); color: #EC4899; border-color: rgba(236,72,153,0.08); }
    .ab-key-btn.key-backspace:hover:not(:disabled) { background: rgba(236,72,153,0.12); }
    .ab-key-btn.key-submit { background: rgba(40,167,69,0.06); color: #28a745; border-color: rgba(40,167,69,0.08); }
    .ab-key-btn.key-submit:hover:not(:disabled) { background: rgba(40,167,69,0.12); }

    .ab-display { font-size: 2.8rem; font-weight: 700; letter-spacing: 12px; color: #8B5CF6; padding: 0.5rem 0; font-family: monospace; background: rgba(255,255,255,0.02); border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); margin: 0 auto 0.5rem; min-height: 70px; display: flex; align-items: center; justify-content: center; }
    .ab-status { color: rgba(255,255,255,0.25); font-size: 0.9rem; text-align: center; margin-bottom: 0.5rem; font-weight: 500; }
    .ab-status strong { color: #F59E0B; }
    .ab-history { color: rgba(255,255,255,0.15); font-size: 0.85rem; min-height: 30px; padding: 0.3rem 0.5rem; font-family: monospace; background: rgba(255,255,255,0.02); border-radius: 10px; border: 1px solid rgba(255,255,255,0.03); margin-bottom: 0.8rem; max-height: 100px; overflow-y: auto; text-align: center; line-height: 1.8; }
    .ab-history .history-item { color: rgba(255,255,255,0.4); }
    .ab-history .history-item.correct { color: #28a745; }

    /* ============================================================
       三视图 - 横向排列
       ============================================================ */
    .view-container { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; padding: 0.5rem 0; align-items: flex-end; }
    .view-item { text-align: center; }
    .view-item .view-label { color: rgba(255,255,255,0.2); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.3rem; display: block; font-weight: 600; }
    .view-item .view-grid { display: inline-grid; gap: 3px; background: rgba(255,255,255,0.02); padding: 6px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); }
    .view-item .view-grid .cell { width: 40px; height: 40px; border-radius: 6px; }
    .view-item .view-grid .cell.filled { background: #8B5CF6; box-shadow: 0 0 20px rgba(139,92,246,0.1); }
    .view-item .view-grid .cell.empty { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02); }

    /* ============================================================
       其他组件
       ============================================================ */
    .captcha-image { border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); background: rgba(255,255,255,0.02); max-width: 100%; margin: 0.1rem 0 0.6rem; cursor: pointer; transition: transform 0.3s ease; }
    .captcha-image:hover { transform: scale(1.02); }
    .color-display { font-size: 2.5rem; padding: 0.3rem 1.5rem; border-radius: 14px; background: rgba(255,255,255,0.02); margin: 0.1rem 0 0.6rem; letter-spacing: 4px; font-weight: 600; }
    .display-text-container { width: 100%; display: block; margin: 0.1rem 0 0.6rem; position: relative; z-index: 1; }
    .display-text-container .display-text { font-size: 1.5rem; padding: 0.5rem 1.2rem; margin: 0.1rem 0 0.6rem; line-height: 2.2; text-align: center; font-family: 'Courier New', monospace; letter-spacing: 4px; width: 100%; color: rgba(255,255,255,0.7); font-weight: 500; }

    .rotate-compare { display: flex; gap: 1.2rem; justify-content: center; align-items: center; flex-wrap: wrap; padding: 0.3rem 0; }
    .rotate-compare .rotate-item { text-align: center; }
    .rotate-compare .rotate-item .label { color: rgba(255,255,255,0.15); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.15rem; display: block; }
    .rotate-compare .rotate-item svg { border-radius: 10px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.03); }
    .rotate-compare .rotate-arrow { color: rgba(255,255,255,0.06); font-size: 1.5rem; }
    .rotate-angle-text { font-size: 1.2rem; font-weight: 700; color: #8B5CF6; margin-top: 0.2rem; }

    .memory-keyboard { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; max-width: 280px; margin: 0.3rem auto; width: 100%; }
    .memory-keyboard .key-btn { padding: 0.7rem 0.3rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 14px; background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.6); font-size: 1.4rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; font-family: inherit; text-align: center; }
    .memory-keyboard .key-btn:hover:not(:disabled) { background: rgba(139,92,246,0.06); border-color: rgba(139,92,246,0.12); transform: scale(1.04); color: #fff; }
    .memory-keyboard .key-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .memory-keyboard .key-btn.backspace { color: #EC4899; border-color: rgba(236,72,153,0.08); }
    .memory-keyboard .key-btn.backspace:hover:not(:disabled) { background: rgba(236,72,153,0.08); }
    .memory-input-display { text-align: center; padding: 0.5rem; min-height: 50px; font-size: 2rem; font-weight: 700; color: #8B5CF6; letter-spacing: 10px; font-family: 'Courier New', monospace; background: rgba(255,255,255,0.02); border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); margin: 0.3rem auto; width: 100%; max-width: 280px; }
    .memory-controls { display: flex; gap: 0.5rem; justify-content: center; margin-top: 0.3rem; }
    .memory-controls .btn-memory { padding: 0.5rem 1.8rem; border: none; border-radius: 40px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; }
    .memory-controls .btn-memory.submit { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
    .memory-controls .btn-memory.submit:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(108,60,225,0.15); }
    .memory-controls .btn-memory:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }

    .char-btn { display: inline-block; padding: 0.3rem 0.8rem; margin: 0.1rem; border-radius: 12px; cursor: pointer; font-size: 2.4rem; font-weight: 700; font-family: monospace; transition: all 0.3s ease; user-select: none; color: #ffffff; border: 2px solid transparent; background: transparent; }
    .char-btn:hover:not(.disabled) { transform: scale(1.08); background: rgba(139,92,246,0.06); }
    .char-btn.disabled { cursor: default; opacity: 0.4; background: transparent !important; transform: none !important; }
    .char-btn.correct-answer { border-color: #28a745 !important; background: rgba(40,167,69,0.1) !important; color: #28a745 !important; }
    .char-btn.wrong-answer { border-color: #dc3545 !important; background: rgba(220,53,69,0.1) !important; color: #dc3545 !important; }

    .puzzle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; max-width: 210px; margin: 0 auto; background: rgba(255,255,255,0.02); padding: 6px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); touch-action: none; user-select: none; }
    .puzzle-grid .puzzle-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; border-radius: 10px; cursor: pointer; transition: all 0.2s ease; background: rgba(255,255,255,0.04); color: #fff; user-select: none; touch-action: none; }
    .puzzle-grid .puzzle-cell:hover:not(.empty) { background: rgba(139,92,246,0.08); transform: scale(1.04); }
    .puzzle-grid .puzzle-cell.empty { background: transparent; cursor: default; }

    .ascii-art { font-family: 'Courier New', monospace; font-size: 0.9rem; color: #8B5CF6; white-space: pre; text-align: center; line-height: 1.5; padding: 0.5rem; background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); }

    /* ============================================================
       反馈
       ============================================================ */
    .feedback { text-align: center; margin-top: 0.6rem; padding: 0.6rem 1.2rem; border-radius: 14px; font-size: 1.1rem; font-weight: 700; animation: feedbackIn 0.5s cubic-bezier(0.23, 1, 0.32, 1); width: 100%; display: none; position: relative; z-index: 1; }
    .feedback.show { display: block; }
    .feedback.correct { background: rgba(40,167,69,0.08); color: #28a745; border: 1px solid rgba(40,167,69,0.06); }
    .feedback.wrong { background: rgba(220,53,69,0.08); color: #dc3545; border: 1px solid rgba(220,53,69,0.06); }
    .feedback .fun-message { font-weight: 400; color: rgba(255,255,255,0.3); font-size: 0.9rem; margin-top: 0.1rem; }
    @@keyframes feedbackIn { from { opacity: 0; transform: translateY(12px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }

    /* ============================================================
       计时器
       ============================================================ */
    .timer-section { width: 100%; margin-top: 0.8rem; position: relative; z-index: 1; }
    .timer-bar { width: 100%; height: 3px; background: rgba(255,255,255,0.04); border-radius: 10px; overflow: hidden; }
    .timer-bar .timer-fill { height: 100%; border-radius: 10px; background: linear-gradient(135deg, #34D399, #F59E0B); transition: width 0.3s linear; width: 100%; }
    .timer-bar .timer-fill.warning { background: linear-gradient(135deg, #F59E0B, #EC4899); }
    .timer-bar .timer-fill.danger { background: linear-gradient(135deg, #EC4899, #dc3545); }
    .timer-text { text-align: right; color: rgba(255,255,255,0.1); font-size: 0.85rem; margin-top: 0.15rem; font-weight: 600; letter-spacing: 0.04em; }

    /* ============================================================
       游戏结束
       ============================================================ */
    .game-over { text-align: center; padding: 1rem 0.5rem; width: 100%; position: relative; z-index: 1; }
    .game-over .big-icon { font-size: 3.8rem; margin-bottom: 0.2rem; animation: gameOverBounce 1.2s ease-in-out infinite; }
    @@keyframes gameOverBounce { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
    .game-over .title { color: #fff; font-size: 1.8rem; font-weight: 800; margin-bottom: 0.1rem; }
    .game-over .sub { color: rgba(255,255,255,0.2); font-size: 0.95rem; margin-bottom: 0.4rem; }
    .game-over .final-score { font-size: 3rem; font-weight: 900; color: #F59E0B; margin: 0.2rem 0; text-shadow: 0 0 60px rgba(245,158,11,0.05); }
    .game-over .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; max-width: 280px; margin: 0.4rem auto 1rem; }
    .game-over .stats-grid .stat-item { background: rgba(255,255,255,0.02); border-radius: 14px; padding: 0.5rem; border: 1px solid rgba(255,255,255,0.03); }
    .game-over .stats-grid .stat-item .stat-value { color: #fff; font-size: 1.2rem; font-weight: 700; }
    .game-over .stats-grid .stat-item .stat-label { color: rgba(255,255,255,0.15); font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 0.05rem; }
    .btn-restart { padding: 0.7rem 2.8rem; border: none; border-radius: 60px; background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; box-shadow: 0 4px 30px rgba(108,60,225,0.15); }
    .btn-restart:hover { transform: translateY(-3px); box-shadow: 0 12px 50px rgba(108,60,225,0.25); }

    /* ============================================================
       排行榜
       ============================================================ */
    .rank-section { margin-top: 1.2rem; padding: 1rem 1.2rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; }
    .rank-section .rank-title { color: rgba(255,255,255,0.2); font-size: 0.9rem; font-weight: 600; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.4rem; }
    .rank-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.02); }
    .rank-item:last-child { border-bottom: none; }
