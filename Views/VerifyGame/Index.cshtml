    // ============================================================
    // 开始界面
    // ============================================================
    function renderStartScreen() {
        var container = dom.gameContent;
        dom.typeBadge.style.display = 'none';
        dom.questionText.innerHTML = '';
        dom.statusBar.style.display = 'none';
        dom.progressBar.style.display = 'none';
        dom.timerSection.style.display = 'none';
        dom.rankSection.style.display = 'none';
        dom.feedback.className = 'feedback';
        dom.feedback.style.display = 'none';

        container.innerHTML = `
            <div class="start-screen">
                <span class="logo-icon">🧩</span>
                <div class="title">验证大闯关</div>
                <p class="desc">100关 · 20种玩法 · 难度递增</p>
                <div class="start-buttons">
                    <button class="btn-start primary" onclick="startGame()">🚀 开始游戏</button>
                    <button class="btn-start ranking" onclick="showRankingOnly()">🏆 排行榜</button>
                    <button class="btn-start tutorial-btn" onclick="showTutorial()">📖 保姆级教程</button>
                </div>
                <div style="margin-top:1.2rem;color:rgba(255,255,255,0.05);font-size:0.7rem;">
                    💡 点击 "保姆级教程" 了解每种玩法的详细说明 + 演示动画
                </div>
            </div>
        `;
        dom.typeNameDisplay.textContent = '🎮 准备开始';
        dom.challengeCard.querySelector('.type-badge').style.display = 'none';
    }

    // ============================================================
    // 排行榜
    // ============================================================
    function showRankingOnly() {
        var container = dom.gameContent;
        container.innerHTML = `
            <div style="width:100%;padding:0.3rem 0;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.8rem;">
                    <div style="color:#fff;font-weight:600;font-size:1.1rem;">🏆 排行榜</div>
                    <button class="btn-start secondary" style="padding:0.3rem 1.2rem;border:none;border-radius:30px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.3);cursor:pointer;font-family:inherit;font-size:0.8rem;" onclick="renderStartScreen()">← 返回</button>
                </div>
                <div id="rankListOnly"></div>
            </div>
        `;
        dom.typeNameDisplay.textContent = '🏆 排行榜';
        loadRankingOnly();
    }

    function loadRankingOnly() {
        var container = document.getElementById('rankListOnly');
        if (!container) return;
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success && data.data && data.data.length > 0) {
                    var html = '';
                    var medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" style="width:26px;height:26px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,0.04);flex-shrink:0;" />' :
                            '<div style="width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,0.04);display:flex;align-items:center;justify-content:center;font-size:0.55rem;color:rgba(255,255,255,0.15);flex-shrink:0;">' + (item.username ? item.username.charAt(0).toUpperCase() : '?') + '</div>';
                        var isMe = item.isMe || false;
                        html += '<div style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0.5rem;border-bottom:1px solid rgba(255,255,255,0.02);">' +
                            '<span style="font-size:0.8rem;min-width:28px;text-align:center;color:rgba(255,255,255,0.1);">' + medal + '</span>' +
                            avatarHtml +
                            '<span style="flex:1;color:rgba(255,255,255,0.35);font-size:0.8rem;font-weight:500;">' + item.username + (isMe ? ' <span style="color:#8B5CF6;font-weight:700;">(我)</span>' : '') + '</span>' +
                            '<span style="color:#F59E0B;font-weight:700;font-size:0.9rem;">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<div style="text-align:center;color:rgba(255,255,255,0.08);padding:1.5rem;">暂无排行数据</div>';
                }
            })
            .catch(function() {
                container.innerHTML = '<div style="text-align:center;color:rgba(255,255,255,0.08);padding:1.5rem;">加载失败</div>';
            });
    }

    // ============================================================
    // 保姆级教程系统
    // ============================================================
    function showTutorial() {
        currentTutorialIndex = 0;
        document.getElementById('tutorialOverlay').classList.add('active');
        renderTutorial(currentTutorialIndex);
        document.body.style.overflow = 'hidden';
        SoundFX.play('start');
    }

    function closeTutorial() {
        document.getElementById('tutorialOverlay').classList.remove('active');
        document.body.style.overflow = '';
        renderStartScreen();
    }

    function renderTutorial(index) {
        var container = document.getElementById('tutorialContent');
        var total = tutorialOrder.length;
        var key = tutorialOrder[index];
        var data = generateTutorialContent(key);

        if (!data) return;

        var stepsHtml = '';
        data.steps.forEach(function(step, idx) {
            stepsHtml += `
                <div class="tutorial-step">
                    <div class="step-number">步骤 ${idx + 1}</div>
                    <div class="step-title">${step.title}</div>
                    <div class="step-desc">${step.desc}</div>
                </div>
            `;
        });

        var demoHtml = '';
        if (data.demo) {
            demoHtml = `
                <div class="tutorial-demo-area active">
                    ${data.demo()}
                </div>
            `;
        }

        var prevDisabled = index === 0 ? 'disabled' : '';
        var nextDisabled = index === total - 1 ? 'disabled' : '';

        container.innerHTML = `
            <div class="tutorial-title">
                <span>${data.icon}</span>
                ${data.name}
                <span class="page-counter">${index + 1} / ${total}</span>
            </div>
            <div class="tutorial-sub">保姆级教程 · 含演示动画</div>

            ${stepsHtml}

            <div class="tutorial-step" style="border-color:rgba(139,92,246,0.06);">
                <div class="step-number">💡 示例</div>
                <div class="step-example">
                    <div class="ex-label">📌 例题</div>
                    <div class="ex-content">${data.example}</div>
                </div>
            </div>

            ${demoHtml}

            <div class="tutorial-nav">
                <button class="nav-btn" onclick="renderTutorial(${index - 1})" ${prevDisabled}>← 上一项</button>
                ${data.demo ? `<button class="nav-btn demo-btn" onclick="replayDemo('${key}')">🔄 重播演示</button>` : ''}
                <button class="nav-btn ${index === total - 1 ? 'active' : ''}" onclick="${index === total - 1 ? 'closeTutorial()' : 'renderTutorial(' + (index + 1) + ')'}" ${nextDisabled}>
                    ${index === total - 1 ? '✅ 完成' : '下一项 →'}
                </button>
                <button class="nav-btn close-tutorial" onclick="closeTutorial()">✕ 关闭</button>
            </div>
        `;
    }

    function replayDemo(key) {
        var data = generateTutorialContent(key);
        if (!data || !data.demo) return;
        var demoArea = document.querySelector('.tutorial-demo-area');
        if (demoArea) {
            demoArea.innerHTML = data.demo();
            var content = demoArea.querySelector('.demo-content');
            if (content) {
                content.style.animation = 'none';
                setTimeout(function() { content.style.animation = ''; }, 10);
            }
            SoundFX.play('start');
        }
    }

    // ============================================================
    // 游戏核心
    // ============================================================
    function startGame() {
        if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
        gameState.level = 1; gameState.score = 0; gameState.lives = 3;
        gameState.combo = 0; gameState.maxCombo = 0; gameState.passed = 0;
        gameState.isPlaying = true; gameState.isAnswered = false;
        gameState.timeLeft = 15;
        gameState.currentChallenge = null;

        dom.statusBar.style.display = 'flex';
        dom.progressBar.style.display = 'block';
        dom.timerSection.style.display = 'block';
        dom.rankSection.style.display = 'none';
        dom.feedback.className = 'feedback';
        dom.feedback.style.display = 'none';
        dom.feedback.innerHTML = '';
        dom.challengeCard.querySelector('.type-badge').style.display = 'block';

        dom.typeNameDisplay.textContent = '📝 第 1 关 · 入门';
        updateUI();
        SoundFX.play('start');
        loadChallenge();
    }

    function loadChallenge() {
        if (!gameState.isPlaying) return;
        if (gameState.level > gameState.totalLevels) { gameWin(); return; }

        gameState.isAnswered = false;
        dom.feedback.className = 'feedback';
        dom.feedback.style.display = 'none';
        dom.gameContent.innerHTML = '';

        if (window._abCleanup) { window._abCleanup(); window._abCleanup = null; }

        var diffLabel = getDifficultyLabel(gameState.level);
        dom.typeBadge.textContent = '第 ' + gameState.level + ' 关';

        fetch('/VerifyGame/GetChallenge?level=' + gameState.level)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    gameState.currentChallenge = data.data;
                    if (data.data.typeName) {
                        dom.typeNameDisplay.textContent = '🧩 ' + data.data.typeName + ' · ' + diffLabel;
                    }
                    renderChallenge(data.data);
                } else {
                    showToast('加载挑战失败，请重试', 'error');
                }
            })
            .catch(function() { showToast('网络错误，请刷新重试', 'error'); });
    }

    // ============================================================
    // 渲染挑战
    // ============================================================
    function renderChallenge(challenge) {
        gameState.currentChallenge = challenge;
        var typeName = challenge.typeName || challenge.type || '未知';
        var diffLabel = getDifficultyLabel(challenge.level);
        dom.typeBadge.textContent = '第 ' + challenge.level + ' 关 · ' + typeName + ' · ' + diffLabel;
        dom.typeNameDisplay.textContent = '🧩 ' + typeName + ' · ' + diffLabel;
        dom.questionText.innerHTML = challenge.question || '请完成以下挑战';

        var container = dom.gameContent;

        // 1A2B
        if (challenge.type === 'abgame') { renderABGame(challenge); return; }

        // 颜色混合
        if (challenge.type === 'colorMix') { renderColorMix(challenge); return; }

        // 图形旋转
        if (challenge.type === 'rotate' && challenge.originalSvg) {
            var rotateDiv = document.createElement('div');
            rotateDiv.className = 'rotate-compare';
            rotateDiv.innerHTML = `
                <div class="rotate-item">
                    <span class="label">📐 原图</span>
                    ${challenge.originalSvg}
                </div>
                <div class="rotate-arrow">→</div>
                <div class="rotate-item">
                    <span class="label">🔄 旋转后</span>
                    ${challenge.rotatedSvg || challenge.originalSvg}
                </div>
            `;
            container.appendChild(rotateDiv);
            renderOptions(challenge, container);
            startTimer(challenge.timeLimit || 15);
            updateUI();
            return;
        }

        // 找不同
        if (challenge.type === 'findDifferent' && challenge.originalDisplay) {
            renderFindDifferent(challenge);
            return;
        }

        // 数字记忆
        if (challenge.type === 'memory' && challenge.keyboardRows) {
            renderMemoryGame(challenge);
            return;
        }

        // 华容道
        if (challenge.type === 'puzzle' && challenge.puzzle) {
            renderPuzzle(challenge.puzzle);
            return;
        }

        // 三视图
        if (challenge.type === 'threeView') {
            renderThreeView(challenge);
            return;
        }

        // 通用渲染
        if (challenge.imageSvg) {
            var imgDiv = document.createElement('div');
            imgDiv.style.cssText = 'width:100%;text-align:center;margin:0.1rem 0 0.6rem;';
            imgDiv.innerHTML = '<div class="captcha-image">' + challenge.imageSvg + '</div>';
            container.appendChild(imgDiv);
        }

        if (challenge.displayHtml) {
            var colorDiv = document.createElement('div');
            colorDiv.className = 'color-display';
            colorDiv.innerHTML = challenge.displayHtml;
            container.appendChild(colorDiv);
        }

        if (challenge.displayText) {
            var textDiv = document.createElement('div');
            textDiv.className = 'display-text-container';
            textDiv.innerHTML = '<div class="display-text">' + challenge.displayText + '</div>';
            container.appendChild(textDiv);
        }

        if (challenge.type === 'shapeCount' && challenge.asciiArt) {
            var asciiDiv = document.createElement('div');
            asciiDiv.className = 'ascii-art';
            asciiDiv.textContent = challenge.asciiArt;
            container.appendChild(asciiDiv);
        }

        renderOptions(challenge, container);
        startTimer(challenge.timeLimit || 15);
        updateUI();
    }

    function renderOptions(challenge, container) {
        if (challenge.options && challenge.options.length > 0) {
            var optGrid = document.createElement('div');
            optGrid.className = 'options-grid';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerHTML = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                optGrid.appendChild(btn);
            });
            container.appendChild(optGrid);
        }
    }

    // ============================================================
    // 三视图 - 横向排列
    // ============================================================
    function renderThreeView(challenge) {
        var container = dom.gameContent;
        container.innerHTML = '';

        var viewContainer = document.createElement('div');
        viewContainer.className = 'view-container';
        viewContainer.style.cssText = 'display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;padding:0.5rem 0;align-items:flex-end;';

        if (challenge.topView) {
            var topItem = document.createElement('div');
            topItem.className = 'view-item';
            topItem.style.cssText = 'text-align:center;';
            topItem.innerHTML = challenge.topView;
            viewContainer.appendChild(topItem);
        }

        if (challenge.frontView) {
            var frontItem = document.createElement('div');
            frontItem.className = 'view-item';
            frontItem.style.cssText = 'text-align:center;';
            frontItem.innerHTML = challenge.frontView;
            viewContainer.appendChild(frontItem);
        }

        if (challenge.sideView) {
            var sideItem = document.createElement('div');
            sideItem.className = 'view-item';
            sideItem.style.cssText = 'text-align:center;';
            sideItem.innerHTML = challenge.sideView;
            viewContainer.appendChild(sideItem);
        }

        container.appendChild(viewContainer);

        if (challenge.options && challenge.options.length > 0) {
            var optGrid = document.createElement('div');
            optGrid.className = 'options-grid';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                optGrid.appendChild(btn);
            });
            container.appendChild(optGrid);
        }

        startTimer(challenge.timeLimit || 20);
        updateUI();
