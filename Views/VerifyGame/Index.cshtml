@{
    ViewData["Title"] = "🧩 验证大闯关";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<style>
    /* ===== 全局重置 ===== */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0a0a0f; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #e0e0e0; min-height: 100vh; overflow-x: hidden; }

    .game-container { max-width: 820px; margin: 0 auto; padding: 0.8rem 1.2rem 2rem; min-height: 100vh; }

    /* ===== 头部 ===== */
    .game-header { text-align: center; padding: 0.3rem 0 0.8rem; }
    .game-header h1 { font-size: 2.4rem; font-weight: 900; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 40%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0; }
    .game-header .subtitle { color: rgba(255,255,255,0.18); font-size: 0.9rem; margin-top: 0.05rem; }
    .game-header .type-badge-header { display: inline-block; margin-top: 0.2rem; padding: 0.25rem 1.8rem; border-radius: 30px; background: rgba(139,92,246,0.08); color: #A78BFA; font-size: 0.85rem; border: 1px solid rgba(139,92,246,0.06); font-weight: 600; }

    /* ===== 动画 ===== */
    @@keyframes modalIn { from { opacity: 0; transform: scale(0.96) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    @@keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.2); } }
    @@keyframes logoBounce { 0%,100% { transform: scale(1) rotate(0deg); } 50% { transform: scale(1.06) rotate(2deg); } }
    @@keyframes gameOverBounce { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
    @@keyframes feedbackIn { from { opacity: 0; transform: translateY(12px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes slideDown { from { opacity: 0; transform: translateY(-20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes demoPulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.05); opacity: 0.7; } }
    @@keyframes typingCursor { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
    @@keyframes optionHighlight { 0% { border-color: rgba(139,92,246,0.2); } 50% { border-color: rgba(139,92,246,0.6); } 100% { border-color: rgba(139,92,246,0.2); } }

    /* ===== 权限弹窗 ===== */
    .permission-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.96); backdrop-filter: blur(30px);
        z-index: 10000; display: none; align-items: center; justify-content: center; padding: 1.5rem;
        overflow-y: auto;
    }
    .permission-overlay.active { display: flex; }
    .permission-overlay::-webkit-scrollbar { width: 4px; }
    .permission-overlay::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.15); border-radius: 10px; }

    .permission-modal {
        background: rgba(20,20,40,0.98); border: 1px solid rgba(255,255,255,0.04);
        border-radius: 28px; max-width: 640px; width: 100%; max-height: 94vh; overflow-y: auto;
        padding: 2rem 2.2rem; box-shadow: 0 40px 120px rgba(0,0,0,0.6);
        animation: modalIn 0.4s cubic-bezier(0.23,1,0.32,1);
    }
    .permission-modal::-webkit-scrollbar { width: 4px; }
    .permission-modal::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.15); border-radius: 10px; }

    .permission-modal .modal-icon { font-size: 3rem; text-align: center; display: block; margin-bottom: 0.1rem; }
    .permission-modal h3 { color: #fff; font-size: 1.5rem; font-weight: 700; text-align: center; margin-bottom: 0.05rem; }
    .permission-modal .modal-sub { color: rgba(255,255,255,0.2); font-size: 0.9rem; text-align: center; margin-bottom: 0.8rem; }

    .perm-section { background: rgba(255,255,255,0.02); border-radius: 14px; padding: 0.6rem 1rem; margin-bottom: 0.5rem; border: 1px solid rgba(255,255,255,0.03); }
    .perm-section .perm-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
    .perm-section .perm-row .perm-label { display: flex; align-items: center; gap: 0.4rem; color: rgba(255,255,255,0.4); font-size: 0.85rem; font-weight: 500; }
    .perm-section .perm-row .perm-label .icon { font-size: 1.2rem; }
    .perm-section .perm-row .perm-desc { color: rgba(255,255,255,0.12); font-size: 0.65rem; }

    /* 开关 */
    .switch { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .switch .slider { position: absolute; cursor: pointer; inset: 0; background: rgba(255,255,255,0.06); transition: .3s; border-radius: 24px; }
    .switch .slider::before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; transition: .3s; border-radius: 50%; }
    .switch input:checked + .slider { background: linear-gradient(135deg, #8B5CF6, #EC4899); }
    .switch input:checked + .slider::before { transform: translateX(20px); }

    /* 硬件测试 */
    .hardware-test { background: rgba(255,255,255,0.02); border-radius: 14px; padding: 0.8rem 1rem; margin: 0.6rem 0; border: 1px solid rgba(255,255,255,0.04); }
    .hardware-test .test-title { color: rgba(255,255,255,0.2); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.3rem; }
    .hardware-test .test-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.25rem 0; border-bottom: 1px solid rgba(255,255,255,0.02); }
    .hardware-test .test-row:last-child { border-bottom: none; }
    .hardware-test .test-row .test-icon { font-size: 1rem; }
    .hardware-test .test-row .test-name { flex: 1; color: rgba(255,255,255,0.3); font-size: 0.75rem; }
    .hardware-test .test-row .test-status { font-size: 0.6rem; font-weight: 600; padding: 0.05rem 0.7rem; border-radius: 20px; transition: all 0.5s ease; white-space: nowrap; }
    .hardware-test .test-row .test-status.pending { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.15); }
    .hardware-test .test-row .test-status.testing { background: rgba(245,158,11,0.08); color: #F59E0B; animation: pulse 1s ease-in-out infinite; }
    .hardware-test .test-row .test-status.pass { background: rgba(40,167,69,0.1); color: #28a745; }
    .hardware-test .test-row .test-status.fail { background: rgba(220,53,69,0.1); color: #dc3545; }
    .hardware-test .test-row .test-retry { background: none; border: none; color: rgba(255,255,255,0.06); cursor: pointer; font-size: 0.6rem; transition: color 0.3s ease; font-family: inherit; }
    .hardware-test .test-row .test-retry:hover { color: rgba(255,255,255,0.15); }

    /* 惩罚信息 */
    .penalty-info { background: rgba(245,158,11,0.04); border-radius: 12px; padding: 0.5rem 1rem; margin: 0.5rem 0; border: 1px solid rgba(245,158,11,0.06); }
    .penalty-info .penalty-title { color: rgba(255,255,255,0.15); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.2rem; font-weight: 600; }
    .penalty-info .penalty-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; padding: 0.05rem 0; color: rgba(255,255,255,0.25); }
    .penalty-info .penalty-row .val { font-weight: 600; }
    .penalty-info .penalty-row .val.green { color: #28a745; }
    .penalty-info .penalty-row .val.yellow { color: #F59E0B; }

    /* 免责声明 - 完整版 */
    .privacy-section { background: rgba(79,172,254,0.03); border-radius: 14px; padding: 0.8rem 1rem; margin: 0.5rem 0; border: 1px solid rgba(79,172,254,0.04); }
    .privacy-section .privacy-title { color: rgba(255,255,255,0.2); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.2rem; display: flex; align-items: center; gap: 0.4rem; }
    .privacy-section .privacy-item { font-size: 0.65rem; color: rgba(255,255,255,0.12); line-height: 1.6; padding: 0.05rem 0; display: flex; align-items: flex-start; gap: 0.4rem; }
    .privacy-section .privacy-item .mark { color: rgba(79,172,254,0.2); font-weight: 700; flex-shrink: 0; }
    .privacy-section .privacy-item strong { color: rgba(255,255,255,0.2); }

    .perm-actions { display: flex; gap: 0.8rem; margin-top: 1rem; flex-wrap: wrap; }
    .perm-actions .btn-perm { flex: 1; padding: 0.7rem; border: none; border-radius: 40px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; min-width: 100px; }
    .perm-actions .btn-perm.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
    .perm-actions .btn-perm.primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(108,60,225,0.2); }
    .perm-actions .btn-perm.primary:disabled { opacity: 0.3; cursor: not-allowed; transform: none !important; }
    .perm-actions .btn-perm.secondary { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.3); border: 1px solid rgba(255,255,255,0.04); }
    .perm-actions .btn-perm.secondary:hover { background: rgba(255,255,255,0.08); color: #fff; }

    /* ===== 状态栏 ===== */
    .status-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.2rem 0.6rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; padding: 0.5rem 1rem; margin-bottom: 0.6rem; backdrop-filter: blur(10px); }
    .status-item { color: rgba(255,255,255,0.3); font-size: 0.8rem; display: flex; align-items: center; gap: 0.2rem; font-weight: 500; }
    .status-item .value { color: #fff; font-weight: 700; font-size: 1.1rem; min-width: 18px; }
    .status-item .value.lives { color: #EC4899; font-size: 1.2rem; }
    .status-item .value.level { color: #8B5CF6; }
    .status-item .value.score { color: #F59E0B; }
    .status-item .value.combo { color: #34D399; }
    .status-item .value.passed { color: #8B5CF6; }
    .status-item .value.cheat { color: #dc3545; font-size: 0.85rem; }

    .status-indicators { display: flex; gap: 0.4rem; align-items: center; }
    .indicator { width: 10px; height: 10px; border-radius: 50%; display: inline-block; transition: all 0.3s ease; }
    .indicator.mic { background: rgba(255,255,255,0.06); }
    .indicator.mic.active { background: #28a745; box-shadow: 0 0 20px rgba(40,167,69,0.2); animation: pulse 1.5s ease-in-out infinite; }
    .indicator.mic.inactive { background: #dc3545; }

    .progress-bar { width: 100%; height: 4px; background: rgba(255,255,255,0.04); border-radius: 10px; margin-bottom: 0.6rem; overflow: hidden; }
    .progress-bar .fill { height: 100%; border-radius: 10px; background: linear-gradient(135deg, #8B5CF6, #EC4899); transition: width 0.6s ease; width: 0%; }

    /* ===== 挑战卡片 ===== */
    .challenge-card { background: rgba(255,255,255,0.025); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.04); border-radius: 24px; padding: 1.2rem 1.5rem; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; position: relative; overflow: hidden; transition: all 0.4s ease; box-shadow: 0 8px 40px rgba(0,0,0,0.2); }
    .challenge-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(ellipse at 30% 30%, rgba(139,92,246,0.015), transparent 70%); pointer-events: none; }
    .challenge-card .type-badge { position: absolute; top: 0.6rem; right: 0.8rem; font-size: 0.6rem; padding: 0.1rem 0.7rem; border-radius: 20px; background: rgba(139,92,246,0.08); color: #A78BFA; border: 1px solid rgba(139,92,246,0.04); font-weight: 600; z-index: 1; }
    .challenge-card .question-text { color: rgba(255,255,255,0.5); font-size: 1.05rem; text-align: center; line-height: 1.8; margin-bottom: 0.2rem; min-height: 32px; width: 100%; position: relative; z-index: 1; font-weight: 500; }

    /* ===== 语音状态栏 ===== */
    .voice-status-bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.3rem 0.8rem; border-radius: 30px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); margin-bottom: 0.6rem; width: 100%; flex-wrap: wrap; }
    .voice-status-bar .status-icon { font-size: 1.2rem; }
    .voice-status-bar .status-text { color: rgba(255,255,255,0.15); font-size: 0.75rem; flex: 1; }
    .voice-status-bar .transcript-display { color: rgba(255,255,255,0.3); font-size: 0.85rem; font-weight: 500; padding: 0.1rem 0.6rem; background: rgba(255,255,255,0.02); border-radius: 20px; border: 1px solid rgba(255,255,255,0.03); min-height: 28px; min-width: 80px; text-align: center; }
    .voice-status-bar .transcript-display.active { border-color: rgba(139,92,246,0.15); color: #fff; }

    /* ===== 选项 ===== */
    .options-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; width: 100%; max-width: 420px; position: relative; z-index: 1; }
    .options-grid .option-btn { padding: 0.7rem 0.8rem; border: 2px solid rgba(255,255,255,0.06); border-radius: 16px; background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.3s ease; font-family: inherit; text-align: center; }
    .options-grid .option-btn:hover:not(:disabled) { border-color: rgba(139,92,246,0.2); background: rgba(139,92,246,0.06); color: #fff; transform: translateY(-2px); }
    .options-grid .option-btn:disabled { cursor: not-allowed; opacity: 0.3; transform: none !important; }
    .options-grid .option-btn.correct { border-color: #28a745; background: rgba(40,167,69,0.12); color: #28a745; }
    .options-grid .option-btn.wrong { border-color: #dc3545; background: rgba(220,53,69,0.12); color: #dc3545; }
    .options-grid .option-btn.highlight { border-color: rgba(139,92,246,0.4); background: rgba(139,92,246,0.08); box-shadow: 0 0 40px rgba(139,92,246,0.05); animation: optionHighlight 1s ease-in-out infinite; }

    /* ===== 颜色选项 ===== */
    .color-options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; width: 100%; max-width: 380px; margin: 0 auto; position: relative; z-index: 1; }
    .color-options-grid .color-option { padding: 0.6rem 0.2rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 16px; background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.35s ease; display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .color-options-grid .color-option:hover:not(.disabled) { border-color: rgba(139,92,246,0.15); background: rgba(139,92,246,0.04); transform: translateY(-3px); }
    .color-options-grid .color-option.disabled { cursor: not-allowed; opacity: 0.5; transform: none !important; }
    .color-options-grid .color-option .color-block { width: 44px; height: 44px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.06); }
    .color-options-grid .color-option .color-label { color: rgba(255,255,255,0.5); font-size: 0.85rem; font-weight: 600; }
    .color-options-grid .color-option.correct { border-color: #28a745 !important; background: rgba(40,167,69,0.1) !important; }
    .color-options-grid .color-option.correct .color-label { color: #28a745 !important; }
    .color-options-grid .color-option.wrong { border-color: #dc3545 !important; background: rgba(220,53,69,0.1) !important; }
    .color-options-grid .color-option.wrong .color-label { color: #dc3545 !important; }
    .color-options-grid .color-option.highlight { border-color: rgba(139,92,246,0.4) !important; background: rgba(139,92,246,0.08) !important; animation: optionHighlight 1s ease-in-out infinite; }

    /* ===== 1A2B ===== */
    .ab-keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-width: 240px; margin: 0 auto; }
    .ab-key-btn { padding: 0.6rem 0.3rem; border: 2px solid rgba(255,255,255,0.06); border-radius: 14px; background: rgba(255,255,255,0.03); color: rgba(255,255,255,0.6); font-size: 1.3rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; font-family: inherit; text-align: center; min-height: 44px; user-select: none; }
    .ab-key-btn:hover:not(:disabled) { background: rgba(139,92,246,0.08); border-color: rgba(139,92,246,0.15); transform: scale(1.04); color: #fff; }
    .ab-key-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .ab-key-btn.key-backspace { background: rgba(236,72,153,0.06); color: #EC4899; border-color: rgba(236,72,153,0.08); }
    .ab-key-btn.key-submit { background: rgba(40,167,69,0.06); color: #28a745; border-color: rgba(40,167,69,0.08); }
    .ab-display { font-size: 2.4rem; font-weight: 700; letter-spacing: 10px; color: #8B5CF6; padding: 0.4rem 0; font-family: monospace; background: rgba(255,255,255,0.02); border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); margin: 0 auto 0.4rem; min-height: 60px; display: flex; align-items: center; justify-content: center; }
    .ab-status { color: rgba(255,255,255,0.25); font-size: 0.85rem; text-align: center; margin-bottom: 0.4rem; font-weight: 500; }
    .ab-history { color: rgba(255,255,255,0.15); font-size: 0.8rem; min-height: 26px; padding: 0.2rem 0.5rem; font-family: monospace; background: rgba(255,255,255,0.02); border-radius: 10px; border: 1px solid rgba(255,255,255,0.03); margin-bottom: 0.6rem; max-height: 80px; overflow-y: auto; text-align: center; line-height: 1.8; }

    /* ===== 三视图 ===== */
    .view-container { display: flex; justify-content: center; gap: 1.2rem; flex-wrap: wrap; padding: 0.3rem 0; align-items: flex-end; }
    .view-item { text-align: center; }
    .view-item .view-label { color: rgba(255,255,255,0.2); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.2rem; display: block; font-weight: 600; }
    .view-item .view-grid { display: inline-grid; gap: 3px; background: rgba(255,255,255,0.02); padding: 5px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); }
    .view-item .view-grid .cell { width: 36px; height: 36px; border-radius: 6px; }
    .view-item .view-grid .cell.filled { background: #8B5CF6; box-shadow: 0 0 20px rgba(139,92,246,0.1); }
    .view-item .view-grid .cell.empty { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02); }

    /* ===== 华容道 ===== */
    .puzzle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; max-width: 190px; margin: 0 auto; background: rgba(255,255,255,0.02); padding: 5px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); touch-action: none; user-select: none; }
    .puzzle-grid .puzzle-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; font-weight: 700; border-radius: 10px; cursor: pointer; transition: all 0.2s ease; background: rgba(255,255,255,0.04); color: #fff; user-select: none; touch-action: none; }
    .puzzle-grid .puzzle-cell:hover:not(.empty) { background: rgba(139,92,246,0.08); transform: scale(1.04); }
    .puzzle-grid .puzzle-cell.empty { background: transparent; cursor: default; }

    /* ===== 数字记忆 ===== */
    .memory-keyboard { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; max-width: 260px; margin: 0.2rem auto; width: 100%; }
    .memory-keyboard .key-btn { padding: 0.6rem 0.2rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 14px; background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.6); font-size: 1.3rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; font-family: inherit; text-align: center; }
    .memory-keyboard .key-btn:hover:not(:disabled) { background: rgba(139,92,246,0.06); border-color: rgba(139,92,246,0.12); transform: scale(1.04); color: #fff; }
    .memory-keyboard .key-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .memory-keyboard .key-btn.backspace { color: #EC4899; border-color: rgba(236,72,153,0.08); }
    .memory-input-display { text-align: center; padding: 0.4rem; min-height: 44px; font-size: 1.8rem; font-weight: 700; color: #8B5CF6; letter-spacing: 8px; font-family: 'Courier New', monospace; background: rgba(255,255,255,0.02); border-radius: 14px; border: 1px solid rgba(255,255,255,0.04); margin: 0.2rem auto; width: 100%; max-width: 260px; }
    .memory-controls { display: flex; gap: 0.4rem; justify-content: center; margin-top: 0.2rem; }
    .memory-controls .btn-memory { padding: 0.4rem 1.5rem; border: none; border-radius: 40px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; }
    .memory-controls .btn-memory.submit { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
    .memory-controls .btn-memory:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }

    /* ===== 找不同 ===== */
    .char-btn { display: inline-block; padding: 0.2rem 0.6rem; margin: 0.1rem; border-radius: 12px; cursor: pointer; font-size: 2.2rem; font-weight: 700; font-family: monospace; transition: all 0.3s ease; user-select: none; color: #ffffff; border: 2px solid transparent; background: transparent; }
    .char-btn:hover:not(.disabled) { transform: scale(1.08); background: rgba(139,92,246,0.06); }
    .char-btn.disabled { cursor: default; opacity: 0.4; background: transparent !important; transform: none !important; }
    .char-btn.correct-answer { border-color: #28a745 !important; background: rgba(40,167,69,0.1) !important; color: #28a745 !important; }
    .char-btn.wrong-answer { border-color: #dc3545 !important; background: rgba(220,53,69,0.1) !important; color: #dc3545 !important; }
