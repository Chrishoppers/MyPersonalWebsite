    function saveScore(score) {
        fetch('/VerifyGame/SaveScore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'score=' + score + '&level=' + gameState.level + '&maxCombo=' + gameState.maxCombo + '&passed=' + gameState.passed
        }).catch(function() {});
    }

    function restartGame() {
        if (VoiceService.isListening) VoiceService.stop();
        if (window._memoryCleanup) { window._memoryCleanup(); window._memoryCleanup = null; }
        if (window._abCleanup) { window._abCleanup(); window._abCleanup = null; }

        document.getElementById('gameContent').innerHTML = '';
        document.getElementById('challengeCard').innerHTML = '';
        document.getElementById('rankSection').style.display = 'none';

        renderStartScreen();
        gameState.isPlaying = false;
        if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
    }

    // ============================================================
    // 排行榜
    // ============================================================
    function loadRanking() {
        var userId = @(Context.Session.GetInt32("UserId") ?? 0);
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var container = document.getElementById('rankList');
                var section = document.getElementById('rankSection');
                if (data.success && data.data && data.data.length > 0) {
                    var html = '', medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" class="rank-avatar" />' :
                            '<div class="rank-avatar-placeholder">' + (item.username ? item.username.charAt(0).toUpperCase() : '?') + '</div>';
                        var isMe = item.isMe || false;
                        html += '<div class="rank-item">' +
                            '<span class="rank-medal">' + medal + '</span>' +
                            avatarHtml +
                            '<span class="rank-name">' + item.username + (isMe ? ' <span class="me">(我)</span>' : '') + '</span>' +
                            '<span class="rank-score">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                    section.style.display = 'block';
                } else {
                    container.innerHTML = '<div class="rank-empty">暂无排行数据<br>快来挑战吧！</div>';
                    section.style.display = 'block';
                }
            })
            .catch(function() {
                document.getElementById('rankList').innerHTML = '<div class="rank-empty">加载排行榜失败</div>';
                document.getElementById('rankSection').style.display = 'block';
            });
    }

