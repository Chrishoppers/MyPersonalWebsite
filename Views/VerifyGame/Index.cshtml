@{
    ViewData["Title"] = "🧩 验证大闯关";
}

<style>
    * {
        box-sizing: border-box;
    }

    .game-container {
        max-width: 700px;
        margin: 0 auto;
        padding: 1rem 1.2rem 2rem;
        min-height: 100vh;
        font-family: 'Inter', -apple-system, sans-serif;
    }

    .game-header {
        text-align: center;
        padding: 0.5rem 0 1rem;
    }

    .game-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    .game-header .subtitle {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.85rem;
    }

    .status-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.3rem 1.2rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
        padding: 0.8rem 1.5rem;
        margin-bottom: 1rem;
    }

    .status-item {
        color: rgba(255, 255, 255, 0.25);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .status-item .value {
        color: #fff;
        font-weight: 700;
        font-size: 1.3rem;
    }

    .status-item .value.lives {
        color: #EC4899;
        font-size: 1.4rem;
    }
    .status-item .value.level {
        color: #8B5CF6;
        font-size: 1.3rem;
    }
    .status-item .value.score {
        color: #F59E0B;
        font-size: 1.3rem;
    }
    .status-item .value.combo {
        color: #34D399;
        font-size: 1.3rem;
    }

    .progress-bar {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        margin-bottom: 1.2rem;
        overflow: hidden;
    }

    .progress-bar .fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
        width: 0%;
    }

    .challenge-card {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 24px;
        padding: 1.8rem 2rem;
        min-height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .challenge-card .type-badge {
        position: absolute;
        top: 0.8rem;
        right: 1rem;
        font-size: 0.7rem;
        padding: 0.15rem 0.8rem;
        border-radius: 20px;
        background: rgba(139, 92, 246, 0.08);
        color: #8B5CF6;
        border: 1px solid rgba(139, 92, 246, 0.04);
        font-weight: 500;
    }

    .challenge-card .question-text {
        color: rgba(255, 255, 255, 0.5);
        font-size: 1.1rem;
        text-align: center;
        line-height: 1.8;
        margin-bottom: 1rem;
        min-height: 50px;
        width: 100%;
    }

    .challenge-card .question-text .icon {
        font-size: 1.5rem;
    }

    .challenge-card .captcha-image {
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        background: rgba(255, 255, 255, 0.02);
        max-width: 100%;
        margin: 0.2rem 0 0.8rem;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .challenge-card .captcha-image:hover {
        transform: scale(1.02);
    }

    .challenge-card .color-display {
        font-size: 2.5rem;
        padding: 0.3rem 1.5rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        margin: 0.2rem 0 0.8rem;
        letter-spacing: 4px;
    }

    .challenge-card .display-text-container {
        width: 100%;
        display: none;
        margin: 0.2rem 0 0.8rem;
    }

    .challenge-card .display-text-container .display-text {
        font-size: 1.4rem;
        padding: 0.5rem 1.5rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.02);
        margin: 0.2rem 0 0.8rem;
        line-height: 2.2;
        text-align: center;
        font-family: 'Courier New', monospace;
        letter-spacing: 3px;
        width: 100%;
    }

    .options-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.6rem;
        width: 100%;
        max-width: 420px;
    }

    .options-grid .option-btn {
        padding: 0.8rem 1rem;
        border: 2px solid rgba(255, 255, 255, 0.04);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.02);
        color: rgba(255, 255, 255, 0.5);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        text-align: center;
    }

    .options-grid .option-btn:hover:not(:disabled) {
        border-color: rgba(139, 92, 246, 0.2);
        background: rgba(139, 92, 246, 0.04);
        color: #fff;
        transform: translateY(-2px);
    }

    .options-grid .option-btn:disabled {
        cursor: not-allowed;
        opacity: 0.3;
    }

    .options-grid .option-btn.correct {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.08);
        color: #28a745;
    }

    .options-grid .option-btn.wrong {
        border-color: #dc3545;
        background: rgba(220, 53, 69, 0.08);
        color: #dc3545;
    }

    .timer-section {
        width: 100%;
        margin-top: 1rem;
    }

    .timer-bar {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.04);
        border-radius: 10px;
        overflow: hidden;
    }

    .timer-bar .timer-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #34D399, #F59E0B);
        transition: width 0.3s linear;
        width: 100%;
    }

    .timer-bar .timer-fill.warning {
        background: linear-gradient(135deg, #F59E0B, #EC4899);
    }

    .timer-bar .timer-fill.danger {
        background: linear-gradient(135deg, #EC4899, #dc3545);
    }

    .timer-text {
        text-align: right;
        color: rgba(255, 255, 255, 0.1);
        font-size: 0.8rem;
        margin-top: 0.2rem;
        font-weight: 500;
    }

    .feedback {
        text-align: center;
        margin-top: 0.8rem;
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        animation: fadeIn 0.4s ease;
        width: 100%;
        display: none;
    }

    .feedback.show {
        display: block;
    }

    .feedback.correct {
        background: rgba(40, 167, 69, 0.06);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.06);
    }

    .feedback.wrong {
        background: rgba(220, 53, 69, 0.06);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.06);
    }

    .feedback .fun-message {
        font-weight: 400;
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.85rem;
        margin-top: 0.1rem;
    }

    .feedback .points-gain {
        font-weight: 400;
        color: #F59E0B;
        font-size: 0.85rem;
    }

    .game-over {
        text-align: center;
        padding: 1.5rem 0.5rem;
    }

    .game-over .big-icon {
        font-size: 4rem;
        margin-bottom: 0.3rem;
    }

    .game-over .title {
        color: #fff;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }

    .game-over .sub {
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
    }

    .game-over .final-score {
        font-size: 3rem;
        font-weight: 800;
        color: #F59E0B;
        margin: 0.3rem 0;
    }

    .game-over .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.4rem;
        max-width: 300px;
        margin: 0.5rem auto 1.2rem;
    }

    .game-over .stats-grid .stat-item {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 12px;
        padding: 0.5rem;
        border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .game-over .stats-grid .stat-item .stat-value {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .game-over .stats-grid .stat-item .stat-label {
        color: rgba(255, 255, 255, 0.15);
        font-size: 0.55rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .btn-restart {
        padding: 0.8rem 3rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        box-shadow: 0 4px 24px rgba(108, 60, 225, 0.15);
    }

    .btn-restart:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 40px rgba(108, 60, 225, 0.25);
    }

    .rank-section {
        margin-top: 1.5rem;
        padding: 1.2rem 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: 16px;
    }

    .rank-section .rank-title {
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .rank-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.6rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }

    .rank-item:last-child {
        border-bottom: none;
    }

    .rank-item .rank-medal {
        font-size: 0.9rem;
        min-width: 32px;
        text-align: center;
        color: rgba(255, 255, 255, 0.15);
    }

    .rank-item .rank-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.03);
    }

    .rank-item .rank-avatar-placeholder {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6rem;
        color: rgba(255, 255, 255, 0.2);
        flex-shrink: 0;
    }

    .rank-item .rank-name {
        flex: 1;
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.85rem;
    }

    .rank-item .rank-score {
        color: #F59E0B;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .rank-empty {
        text-align: center;
        color: rgba(255, 255, 255, 0.08);
        font-size: 0.85rem;
        padding: 1rem 0;
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.6rem 1.5rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .toast-msg.success {
        background: rgba(40, 167, 69, 0.8);
    }
    .toast-msg.error {
        background: rgba(220, 53, 69, 0.8);
    }
    .toast-msg.info {
        background: rgba(79, 172, 254, 0.8);
    }

    .char-btn {
        display: inline-block;
        padding: 0.3rem 0.8rem;
        margin: 0.1rem;
        border-radius: 10px;
        cursor: pointer;
        font-size: 2.4rem;
        font-weight: bold;
        font-family: monospace;
        transition: all 0.3s ease;
        user-select: none;
        color: #ffffff;
        border: 2px solid transparent;
        background: transparent;
    }

    .char-btn:hover {
        transform: scale(1.1);
        background: rgba(139, 92, 246, 0.08);
    }

    .char-btn.disabled {
        cursor: default;
        opacity: 0.5;
        background: transparent !important;
    }

    .char-btn.correct-answer {
        border-color: #28a745 !important;
        background: rgba(40, 167, 69, 0.15) !important;
        color: #28a745 !important;
    }

    .char-btn.wrong-answer {
        border-color: #dc3545 !important;
        background: rgba(220, 53, 69, 0.15) !important;
        color: #dc3545 !important;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-8px); }
        75% { transform: translateX(8px); }
    }

    .shake {
        animation: shake 0.4s ease;
    }

    @@media (max-width: 640px) {
        .game-header h1 { font-size: 1.6rem; }
        .challenge-card { padding: 1rem 1rem; min-height: 260px; }
        .options-grid { grid-template-columns: 1fr 1fr; gap: 0.4rem; }
        .status-bar { padding: 0.5rem 0.8rem; justify-content: center; gap: 0.2rem 0.8rem; }
        .status-item { font-size: 0.7rem; }
        .status-item .value { font-size: 1rem; }
        .status-item .value.lives { font-size: 1.1rem; }
        .game-over .final-score { font-size: 2.2rem; }
        .challenge-card .display-text-container .display-text { font-size: 1rem; padding: 0.3rem 0.8rem; letter-spacing: 1px; }
        .char-btn { font-size: 1.8rem; padding: 0.2rem 0.5rem; }
        .challenge-card .question-text { font-size: 0.95rem; }
        .challenge-card .type-badge { font-size: 0.55rem; top: 0.5rem; right: 0.6rem; }
        .timer-text { font-size: 0.7rem; }
    }

    @@media (max-width: 400px) {
        .game-header h1 { font-size: 1.3rem; }
        .status-item { font-size: 0.6rem; }
        .status-item .value { font-size: 0.85rem; }
        .status-item .value.lives { font-size: 0.9rem; }
        .options-grid .option-btn { font-size: 0.8rem; padding: 0.5rem 0.6rem; }
        .char-btn { font-size: 1.4rem; padding: 0.1rem 0.4rem; }
    }
</style>

<div class="game-container">

    <div class="game-header">
        <h1>🧩 验证大闯关</h1>
        <p class="subtitle">100关 · 难度递增 · 证明你是人类</p>
    </div>

    <div class="status-bar" id="statusBar">
        <div class="status-item">❤️ 生命 <span class="value lives" id="livesDisplay">❤️❤️❤️</span></div>
        <div class="status-item">📊 关卡 <span class="value level" id="levelDisplay">1</span></div>
        <div class="status-item">🏆 积分 <span class="value score" id="scoreDisplay">0</span></div>
        <div class="status-item">🔥 连击 <span class="value combo" id="comboDisplay">0</span></div>
        <div class="status-item">✅ 通关 <span class="value" id="passedDisplay" style="color:#8B5CF6;">0</span></div>
    </div>

    <div class="progress-bar">
        <div class="fill" id="progressFill"></div>
    </div>

    <div class="challenge-card" id="challengeCard">
        <div class="type-badge" id="typeBadge">第 1 关</div>
        <div class="question-text" id="questionText">加载中...</div>
        <div id="imageContainer" style="display:none;"><div class="captcha-image" id="captchaImage"></div></div>
        <div id="colorContainer" style="display:none;"><div class="color-display" id="colorDisplay">██████</div></div>
        <div class="display-text-container" id="displayTextContainer"><div class="display-text" id="displayText"></div></div>
        <div class="options-grid" id="optionsGrid"></div>
        <div class="timer-section">
            <div class="timer-bar"><div class="timer-fill" id="timerFill"></div></div>
            <div class="timer-text" id="timerText">⏱ 15s</div>
        </div>
        <div class="feedback" id="feedback"></div>
    </div>

    <div class="rank-section" id="rankSection" style="display:none;">
        <div class="rank-title">🏆 排行榜</div>
        <div id="rankList"></div>
    </div>

</div>

<div class="toast-container" id="toastContainer"></div>

<script>
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    var gameState = {
        level: 1,
        score: 0,
        lives: 3,
        combo: 0,
        maxCombo: 0,
        passed: 0,
        isPlaying: false,
        isAnswered: false,
        timer: null,
        timeLeft: 15,
        totalLevels: 100,
        currentChallenge: null
    };

    var dom = {
        levelDisplay: document.getElementById('levelDisplay'),
        scoreDisplay: document.getElementById('scoreDisplay'),
        livesDisplay: document.getElementById('livesDisplay'),
        comboDisplay: document.getElementById('comboDisplay'),
        passedDisplay: document.getElementById('passedDisplay'),
        progressFill: document.getElementById('progressFill'),
        typeBadge: document.getElementById('typeBadge'),
        questionText: document.getElementById('questionText'),
        optionsGrid: document.getElementById('optionsGrid'),
        imageContainer: document.getElementById('imageContainer'),
        captchaImage: document.getElementById('captchaImage'),
        colorContainer: document.getElementById('colorContainer'),
        colorDisplay: document.getElementById('colorDisplay'),
        displayTextContainer: document.getElementById('displayTextContainer'),
        displayText: document.getElementById('displayText'),
        feedback: document.getElementById('feedback'),
        timerFill: document.getElementById('timerFill'),
        timerText: document.getElementById('timerText'),
        challengeCard: document.getElementById('challengeCard')
    };

    var typeNames = {
        'text': '文字识别',
        'arithmetic': '算术计算',
        'stroke': '汉字笔画',
        'color': '颜色识别',
        'findDifferent': '找不同',
        'reverse': '倒序识别',
        'missingLetter': '空缺字母',
        'quickTap': '快速点击',
        'idiom': '成语填空',
        'chineseNumber': '中文数字',
        'caseConversion': '大小写转换',
        'pinyin': '读音识别',
        'inverseColor': '反色识别',
        'mirror': '镜像字母',
        'keyboard': '键盘相邻',
        'countChar': '字符计数',
        'memory': '数字记忆',
        'direction': '方向判断',
        'logic': '逻辑推理',
        'tripleColor': '颜色三重干扰',
        'ultimate': '💀 终极挑战'
    };

    function getDifficultyLabel(level) {
        if (level >= 76) return '💀 地狱';
        if (level >= 51) return '🔥 噩梦';
        if (level >= 26) return '⚡ 困难';
        return '📝 入门';
    }

    function startGame() {
        gameState.level = 1;
        gameState.score = 0;
        gameState.lives = 3;
        gameState.combo = 0;
        gameState.maxCombo = 0;
        gameState.passed = 0;
        gameState.isPlaying = true;
        gameState.isAnswered = false;
        updateUI();
        loadChallenge();
        document.getElementById('rankSection').style.display = 'none';
    }

    function loadChallenge() {
        if (!gameState.isPlaying) return;
        if (gameState.level > gameState.totalLevels) {
            gameWin();
            return;
        }

        gameState.isAnswered = false;
        dom.feedback.className = 'feedback';
        dom.feedback.style.display = 'none';
        dom.optionsGrid.innerHTML = '';
        dom.displayTextContainer.style.display = 'none';
        dom.imageContainer.style.display = 'none';
        dom.colorContainer.style.display = 'none';

        var diffLabel = getDifficultyLabel(gameState.level);
        dom.typeBadge.textContent = '第 ' + gameState.level + ' 关 · ' + diffLabel;

        fetch('/VerifyGame/GetChallenge?level=' + gameState.level)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    gameState.currentChallenge = data.data;
                    renderChallenge(data.data);
                } else {
                    showToast('加载挑战失败，请重试', 'error');
                }
            })
            .catch(function() {
                showToast('网络错误，请刷新重试', 'error');
            });
    }

    function renderChallenge(challenge) {
        var typeName = typeNames[challenge.type] || challenge.type;
        var diffLabel = getDifficultyLabel(gameState.level);
        dom.typeBadge.textContent = '第 ' + challenge.level + ' 关 · ' + typeName + ' · ' + diffLabel;

        dom.questionText.innerHTML = challenge.question;

        dom.imageContainer.style.display = 'none';
        dom.colorContainer.style.display = 'none';
        dom.displayTextContainer.style.display = 'none';

        // ⭐ 找不同：显示记忆倒计时
        if (challenge.type === 'findDifferent' && challenge.originalDisplay) {
            dom.displayTextContainer.style.display = 'block';
            dom.displayText.innerHTML = challenge.originalDisplay;
            dom.displayText.style.cssText = 'font-size:2.8rem;font-weight:bold;color:#8B5CF6;padding:1.5rem;margin:0.5rem 0;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:8px;font-family:monospace;';

            var displayTime = challenge.displayTime || 3;
            var timeLeft = displayTime;
            
            // ⭐ 记忆倒计时
            dom.timerText.textContent = '⏱ 记忆 ' + timeLeft + 's';
            dom.timerFill.style.width = '100%';
            dom.timerFill.className = 'timer-fill';

            var countdownInterval = setInterval(function() {
                timeLeft--;
                dom.timerText.textContent = '⏱ 记忆 ' + timeLeft + 's';
                var pct = (timeLeft / displayTime) * 100;
                dom.timerFill.style.width = pct + '%';
                dom.timerFill.className = 'timer-fill';
                if (pct < 30) {
                    dom.timerFill.classList.add('danger');
                } else if (pct < 50) {
                    dom.timerFill.classList.add('warning');
                }
                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                }
            }, 1000);

            setTimeout(function() {
                dom.displayText.textContent = '⏰ 时间到！';
                dom.displayText.style.color = '#F59E0B';
                dom.displayText.style.fontSize = '1.8rem';
                dom.displayText.style.letterSpacing = 'normal';
                dom.timerText.textContent = '⏱ 选择';

                setTimeout(function() {
                    var shuffled = challenge.shuffledDisplay || '';
                    var shuffledPos = challenge.shuffledPos || 0;
                    var html = '';
                    for (var i = 0; i < shuffled.length; i++) {
                        var ch = shuffled[i];
                        html += '<span class="char-btn" data-index="' + i + '" data-char="' + ch + '" onclick="selectChar(' + i + ', \'' + ch + '\', this)">' + ch + '</span>';
                    }
                    dom.displayText.innerHTML = html;
                    dom.displayText.style.cssText = 'padding:1.5rem;margin:0.5rem 0;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:4px;';
                    dom.displayText.style.color = '#fff';
                    dom.displayText.style.fontSize = '1rem';

                    dom.displayText.dataset.correctAnswer = challenge.correctAnswer;
                    dom.displayText.dataset.shuffledPos = shuffledPos;

                    // ⭐ 开始答题计时
                    startTimer(challenge.timeLimit || 10);
                }, 1000);
            }, displayTime * 1000);
            return;
        }

        // ⭐ 颜色三重干扰
        if (challenge.displayHtml) {
            dom.colorContainer.style.display = 'block';
            dom.colorDisplay.innerHTML = challenge.displayHtml;
        }
        // ⭐ 数字记忆
        else if (challenge.displayNumber) {
            dom.displayTextContainer.style.display = 'block';
            dom.displayText.textContent = challenge.displayNumber;
            dom.displayText.style.cssText = 'font-size:3.5rem;font-weight:bold;color:#8B5CF6;padding:1rem;margin:0.5rem 0;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);text-align:center;';
            // 数字记忆倒计时
            dom.timerText.textContent = '⏱ 记忆 4s';
            dom.timerFill.style.width = '100%';
            dom.timerFill.className = 'timer-fill';
            var memTime = 4;
            var memInterval = setInterval(function() {
                memTime--;
                dom.timerText.textContent = '⏱ 记忆 ' + memTime + 's';
                var pct = (memTime / 4) * 100;
                dom.timerFill.style.width = pct + '%';
                if (pct < 30) dom.timerFill.classList.add('danger');
                else if (pct < 50) dom.timerFill.classList.add('warning');
                if (memTime <= 0) {
                    clearInterval(memInterval);
                    dom.timerText.textContent = '⏱ 选择';
                    dom.timerFill.style.width = '100%';
                    dom.timerFill.className = 'timer-fill';
                }
            }, 1000);
            setTimeout(function() {
                dom.displayText.textContent = '请选择你记住的数字';
                dom.displayText.style.color = 'rgba(255,255,255,0.3)';
                dom.displayText.style.fontSize = '1rem';
                // 显示选项
                var options = challenge.options || [];
                var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
                var html = '';
                for (var i = 0; i < options.length; i++) {
                    html += '<button class="option-btn" data-index="' + i + '" data-answer="' + options[i] + '">' +
                        letters[i] + '. ' + options[i] + '</button>';
                }
                dom.optionsGrid.innerHTML = html;
                dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        if (gameState.isAnswered) return;
                        var answer = this.dataset.answer;
                        if (answer) submitAnswer(challenge, answer, this);
                    });
                });
                startTimer(challenge.timeLimit || 10);
            }, 4500);
            return;
        }
        else if (challenge.imageSvg) {
            dom.imageContainer.style.display = 'block';
            dom.captchaImage.innerHTML = challenge.imageSvg;
        }
        else if (challenge.displayText) {
            dom.displayTextContainer.style.display = 'block';
            dom.displayText.innerHTML = challenge.displayText;
        }

        // 渲染选项
        var options = challenge.options || ['A', 'B', 'C', 'D'];
        var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
        var html = '';
        for (var i = 0; i < options.length; i++) {
            html += '<button class="option-btn" data-index="' + i + '" data-answer="' + options[i] + '">' +
                letters[i] + '. ' + options[i] + '</button>';
        }
        dom.optionsGrid.innerHTML = html;

        dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (gameState.isAnswered) return;
                var answer = this.dataset.answer;
                if (answer) submitAnswer(challenge, answer, this);
            });
        });

        var timeLimit = challenge.timeLimit || 15;
        startTimer(timeLimit);
        updateUI();
    }

    function selectChar(index, char, element) {
        if (gameState.isAnswered) return;

        var container = dom.displayText;
        var shuffledPos = parseInt(container.dataset.shuffledPos);

        var isCorrect = (index === shuffledPos);

        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var allChars = container.querySelectorAll('.char-btn');
        allChars.forEach(function(el) {
            el.classList.add('disabled');
            el.onclick = null;
            if (parseInt(el.dataset.index) === shuffledPos) {
                el.classList.add('correct-answer');
            }
        });

        if (isCorrect) {
            element.classList.add('correct-answer');
            showFeedback(true, 10 + Math.floor(gameState.level / 5), challenge.funMessage);
            gameState.score += 10 + Math.floor(gameState.level / 5);
            gameState.combo++;
            gameState.passed++;
            if (gameState.combo > gameState.maxCombo) {
                gameState.maxCombo = gameState.combo;
            }
            gameState.level++;
        } else {
            element.classList.add('wrong-answer');
            gameState.combo = 0;
            gameState.lives--;
            showFeedback(false, 0, '');
        }

        updateUI();

        if (gameState.lives <= 0) {
            setTimeout(gameOver, 1500);
            return;
        }

        setTimeout(loadChallenge, 1500);
    }

    function submitAnswer(challenge, answer, btn) {
        if (gameState.isAnswered) return;
        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var isCorrect = answer === challenge.correctAnswer;

        dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(b) {
            b.disabled = true;
            if (b.dataset.answer === challenge.correctAnswer) {
                b.classList.add('correct');
            }
        });

        if (!isCorrect) {
            btn.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }

        var points = 0;
        if (isCorrect) {
            var bonus = Math.min(gameState.combo, 10);
            points = 10 + Math.floor(gameState.level / 5) + bonus * 2;
            gameState.score += points;
            gameState.combo++;
            gameState.passed++;
            if (gameState.combo > gameState.maxCombo) {
                gameState.maxCombo = gameState.combo;
            }
            showFeedback(true, points, challenge.funMessage);
            gameState.level++;
        } else {
            gameState.combo = 0;
            gameState.lives--;
            showFeedback(false, 0, '');
        }

        updateUI();

        if (gameState.lives <= 0) {
            setTimeout(gameOver, 1500);
            return;
        }

        setTimeout(loadChallenge, 1500);
    }

    function showFeedback(isCorrect, points, funMessage) {
        var el = dom.feedback;
        el.style.display = 'block';
        el.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');

        if (isCorrect) {
            el.innerHTML = '✅ 答对了！ +' + points + ' 分' +
                (funMessage ? '<div class="fun-message">' + funMessage + '</div>' : '');
        } else {
            el.innerHTML = '❌ 答错了！连击中断';
        }
    }

    function startTimer(limit) {
        clearInterval(gameState.timer);
        gameState.timeLeft = limit;
        updateTimerDisplay();

        gameState.timer = setInterval(function() {
            gameState.timeLeft--;
            updateTimerDisplay();

            if (gameState.timeLeft <= 0) {
                clearInterval(gameState.timer);
                if (!gameState.isAnswered) {
                    gameState.isAnswered = true;
                    dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(b) {
                        b.disabled = true;
                    });
                    var charBtns = dom.displayText.querySelectorAll('.char-btn');
                    charBtns.forEach(function(el) {
                        el.classList.add('disabled');
                        el.onclick = null;
                    });
                    gameState.combo = 0;
                    gameState.lives--;
                    updateUI();
                    showFeedback(false, 0, '⏱ 时间到！');
                    if (gameState.lives <= 0) {
                        setTimeout(gameOver, 1200);
                    } else {
                        setTimeout(loadChallenge, 1500);
                    }
                }
            }
        }, 1000);
    }

    function updateTimerDisplay() {
        var pct = (gameState.timeLeft / Math.max(3, 20)) * 100;
        dom.timerFill.style.width = pct + '%';
        dom.timerText.textContent = '⏱ ' + gameState.timeLeft + 's';

        dom.timerFill.className = 'timer-fill';
        if (pct < 30) dom.timerFill.classList.add('danger');
        else if (pct < 50) dom.timerFill.classList.add('warning');
    }

    function updateUI() {
        dom.levelDisplay.textContent = gameState.level;
        dom.scoreDisplay.textContent = gameState.score;
        dom.comboDisplay.textContent = gameState.combo;
        dom.passedDisplay.textContent = gameState.passed;

        var hearts = '❤️'.repeat(gameState.lives) + '🖤'.repeat(Math.max(0, 3 - gameState.lives));
        dom.livesDisplay.textContent = hearts || '💀';

        var progress = (gameState.passed / gameState.totalLevels) * 100;
        dom.progressFill.style.width = Math.min(progress, 100) + '%';
    }

    function saveAndShowRanking() {
        var finalScore = gameState.score;
        fetch('/VerifyGame/SaveScore', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'score=' + finalScore + '&level=' + gameState.level + '&maxCombo=' + gameState.maxCombo +
                '&passed=' + gameState.passed
        }).then(function() { loadRanking(); });
    }

    function loadRanking() {
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var container = document.getElementById('rankList');
                var section = document.getElementById('rankSection');
                if (data.success && data.data.length > 0) {
                    var html = '';
                    var medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" class="rank-avatar" />' :
                            '<div class="rank-avatar-placeholder">' + (item.username ? item.username
                                .charAt(0).toUpperCase() : '?') + '</div>';
                        html += '<div class="rank-item">' +
                            '<span class="rank-medal">' + medal + '</span>' +
                            avatarHtml +
                            '<span class="rank-name">' + item.username + '</span>' +
                            '<span class="rank-score">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                    section.style.display = 'block';
                } else {
                    container.innerHTML = '<div class="rank-empty">暂无排行数据<br>快来挑战吧！</div>';
                    section.style.display = 'block';
                }
            })
            .catch(function() {
                document.getElementById('rankList').innerHTML =
                '<div class="rank-empty">加载排行榜失败</div>';
                document.getElementById('rankSection').style.display = 'block';
            });
    }

    function gameOver() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);

        var finalScore = gameState.score;

        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">${finalScore > 100 ? '🏆' : '💪'}</div>
                <div class="title">${finalScore > 100 ? '🎉 挑战结束！' : '😅 继续加油！'}</div>
                <div class="sub">你成功通过了 ${gameState.passed} 关</div>
                <div class="final-score">${finalScore}</div>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">${gameState.passed}</div>
                        <div class="stat-label">通关</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">${gameState.maxCombo}</div>
                        <div class="stat-label">最高连击</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">${gameState.level - 1}</div>
                        <div class="stat-label">到达关卡</div>
                    </div>
                </div>
                <button class="btn-restart" onclick="startGame()">🔄 再来一次</button>
            </div>
        `;

        saveAndShowRanking();
    }

    function gameWin() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);

        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">👑</div>
                <div class="title">🎉 恭喜通关！</div>
                <div class="sub">你通过了全部 100 关！你是真正的人类之光！</div>
                <div class="final-score">${gameState.score}</div>
                <div class="stats-grid">
                    <div class="stat-item">
                        <div class="stat-value">100</div>
                        <div class="stat-label">通关</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">${gameState.maxCombo}</div>
                        <div class="stat-label">最高连击</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">🏆</div>
                        <div class="stat-label">传说</div>
                    </div>
                </div>
                <button class="btn-restart" onclick="startGame()">🔄 再来一次</button>
            </div>
        `;

        saveAndShowRanking();
    }

    function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + (type || 'info');
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }

    document.addEventListener('DOMContentLoaded', startGame);
</script>
