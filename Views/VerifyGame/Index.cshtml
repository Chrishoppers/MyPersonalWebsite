            z-index: 9998; display: flex; align-items: center; justify-content: center; padding: 1.5rem;
            animation: modalIn 0.4s ease;
        `;
        overlay.innerHTML = `
            <div style="background: rgba(20,20,40,0.98); border: 1px solid rgba(255,255,255,0.04); border-radius: 28px; max-width: 560px; width: 100%; padding: 2rem 2.2rem; box-shadow: 0 40px 120px rgba(0,0,0,0.6); animation: modalIn 0.4s ease; max-height: 90vh; overflow-y: auto;">
                <div style="text-align:center;font-size:2.8rem;margin-bottom:0.2rem;">🎤</div>
                <h3 style="color:#fff;font-size:1.3rem;font-weight:700;text-align:center;margin-bottom:0.1rem;">语音控制快速入门</h3>
                <p style="color:rgba(255,255,255,0.2);font-size:0.85rem;text-align:center;margin-bottom:1rem;">只需说话，无需动手！</p>

                <div style="background:rgba(139,92,246,0.04);border-radius:12px;padding:0.8rem 1rem;margin-bottom:0.6rem;border:1px solid rgba(139,92,246,0.04);">
                    <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.3);font-size:0.75rem;font-weight:600;margin-bottom:0.3rem;">🎯 选择答案</div>
                    <div style="display:flex;flex-wrap:wrap;gap:0.3rem;">
                        <span style="background:rgba(139,92,246,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#A78BFA;">"选 A"</span>
                        <span style="background:rgba(139,92,246,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#A78BFA;">"选第二个"</span>
                        <span style="background:rgba(139,92,246,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#A78BFA;">"红色"</span>
                        <span style="background:rgba(139,92,246,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#A78BFA;">"就这个"</span>
                    </div>
                </div>

                <div style="background:rgba(40,167,69,0.04);border-radius:12px;padding:0.8rem 1rem;margin-bottom:0.6rem;border:1px solid rgba(40,167,69,0.04);">
                    <div style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.3);font-size:0.75rem;font-weight:600;margin-bottom:0.3rem;">✅ 确认操作</div>
                    <div style="display:flex;flex-wrap:wrap;gap:0.3rem;">
                        <span style="background:rgba(40,167,69,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#28a745;">"确认"</span>
                        <span style="background:rgba(40,167,69,0.06);padding:0.15rem 0.6rem;border-radius:12px;font-size:0.7rem;color:#28a745;">"提交"</span>
