@{
    ViewData["Title"] = "🧩 验证大闯关";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<style>
    * { box-sizing: border-box; }
    .game-container { max-width: 700px; margin: 0 auto; padding: 1rem 1.2rem 2rem; min-height: 100vh; font-family: 'Inter', -apple-system, sans-serif; }
    .game-header { text-align: center; padding: 0.5rem 0 1rem; position: relative; }
    .game-header h1 { font-size: 2.2rem; font-weight: 800; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0; }
    .game-header .subtitle { color: rgba(255,255,255,0.15); font-size: 0.85rem; }
    .game-header .type-badge-header { display: inline-block; margin-top: 0.2rem; padding: 0.15rem 1.2rem; border-radius: 20px; background: rgba(139,92,246,0.08); color: #8B5CF6; font-size: 0.75rem; border: 1px solid rgba(139,92,246,0.04); }
    .header-particle { position: absolute; font-size: 0.6rem; opacity: 0.1; animation: floatParticle 10s infinite linear; pointer-events: none; }
    .header-particle:nth-child(1) { left: 5%; top: 10%; animation-delay: 0s; }
    .header-particle:nth-child(2) { left: 15%; top: 30%; animation-delay: 2s; }
    .header-particle:nth-child(3) { left: 85%; top: 20%; animation-delay: 4s; }
    .header-particle:nth-child(4) { left: 75%; top: 60%; animation-delay: 1s; }
    .header-particle:nth-child(5) { left: 90%; top: 80%; animation-delay: 3s; }
    @@keyframes floatParticle { 0% { transform: translateY(0) rotate(0deg); opacity: 0.05; } 50% { opacity: 0.15; } 100% { transform: translateY(-30px) rotate(180deg); opacity: 0.05; } }

    .status-bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.3rem 1.2rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; padding: 0.8rem 1.5rem; margin-bottom: 1rem; }
    .status-item { color: rgba(255,255,255,0.25); font-size: 0.85rem; display: flex; align-items: center; gap: 0.3rem; }
    .status-item .value { color: #fff; font-weight: 700; font-size: 1.3rem; }
    .status-item .value.lives { color: #EC4899; font-size: 1.4rem; }
    .status-item .value.level { color: #8B5CF6; font-size: 1.3rem; }
    .status-item .value.score { color: #F59E0B; font-size: 1.3rem; }
    .status-item .value.combo { color: #34D399; font-size: 1.3rem; }
    .status-item .value.passed { color: #8B5CF6; font-size: 1.3rem; }
    .progress-bar { width: 100%; height: 4px; background: rgba(255,255,255,0.04); border-radius: 10px; margin-bottom: 1.2rem; overflow: hidden; }
    .progress-bar .fill { height: 100%; border-radius: 10px; background: linear-gradient(135deg, #8B5CF6, #EC4899); transition: width 0.5s ease; width: 0%; }

    .challenge-card { background: rgba(255,255,255,0.02); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.04); border-radius: 24px; padding: 1.8rem 2rem; min-height: 320px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; transition: all 0.3s ease; }
    .challenge-card::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(ellipse at 30% 50%, rgba(139,92,246,0.02), transparent 60%); pointer-events: none; }
    .challenge-card .type-badge { position: absolute; top: 0.8rem; right: 1rem; font-size: 0.65rem; padding: 0.15rem 0.8rem; border-radius: 20px; background: rgba(139,92,246,0.08); color: #8B5CF6; border: 1px solid rgba(139,92,246,0.04); font-weight: 500; z-index: 1; }
    .challenge-card .question-text { color: rgba(255,255,255,0.5); font-size: 1.1rem; text-align: center; line-height: 1.8; margin-bottom: 0.5rem; min-height: 40px; width: 100%; position: relative; z-index: 1; }
    .challenge-card .captcha-image { border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); background: rgba(255,255,255,0.02); max-width: 100%; margin: 0.2rem 0 0.8rem; cursor: pointer; transition: transform 0.3s ease; }
    .challenge-card .captcha-image:hover { transform: scale(1.02); }
    .challenge-card .color-display { font-size: 2.5rem; padding: 0.3rem 1.5rem; border-radius: 12px; background: rgba(255,255,255,0.02); margin: 0.2rem 0 0.8rem; letter-spacing: 4px; }
    .challenge-card .display-text-container { width: 100%; display: none; margin: 0.2rem 0 0.8rem; position: relative; z-index: 1; }
    .challenge-card .display-text-container .display-text { font-size: 1.4rem; padding: 0.5rem 1.5rem; margin: 0.2rem 0 0.8rem; line-height: 2.2; text-align: center; font-family: 'Courier New', monospace; letter-spacing: 3px; width: 100%; }

    .rotate-compare { display: flex; gap: 1.5rem; justify-content: center; align-items: center; flex-wrap: wrap; padding: 0.5rem 0; }
    .rotate-compare .rotate-item { text-align: center; }
    .rotate-compare .rotate-item .label { color: rgba(255,255,255,0.12); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.2rem; display: block; }
    .rotate-compare .rotate-item svg { border-radius: 8px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); }
    .rotate-compare .rotate-arrow { color: rgba(255,255,255,0.06); font-size: 1.5rem; }

    .memory-keyboard { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; max-width: 280px; margin: 0.5rem auto; width: 100%; }
    .memory-keyboard .key-btn { padding: 0.8rem 0.5rem; border: 2px solid rgba(255,255,255,0.06); border-radius: 12px; background: rgba(255,255,255,0.03); color: #fff; font-size: 1.4rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; font-family: inherit; text-align: center; }
    .memory-keyboard .key-btn:hover:not(:disabled) { background: rgba(139,92,246,0.08); border-color: rgba(139,92,246,0.15); transform: scale(1.05); }
    .memory-keyboard .key-btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }
    .memory-keyboard .key-btn.backspace { color: #EC4899; border-color: rgba(236,72,153,0.15); font-size: 1.2rem; }
    .memory-keyboard .key-btn.backspace:hover:not(:disabled) { background: rgba(236,72,153,0.08); border-color: rgba(236,72,153,0.2); }
    .memory-input-display { text-align: center; padding: 0.5rem; min-height: 50px; font-size: 2rem; font-weight: bold; color: #8B5CF6; letter-spacing: 8px; font-family: 'Courier New', monospace; background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); margin: 0.5rem auto; width: 100%; max-width: 280px; }
    .memory-controls { display: flex; gap: 0.5rem; justify-content: center; margin-top: 0.3rem; }
    .memory-controls .btn-memory { padding: 0.5rem 1.5rem; border: none; border-radius: 40px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; }
    .memory-controls .btn-memory.submit { background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; }
    .memory-controls .btn-memory.submit:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(108,60,225,0.2); }
    .memory-controls .btn-memory:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }

    .options-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; width: 100%; max-width: 420px; position: relative; z-index: 1; }
    .options-grid .option-btn { padding: 0.8rem 1rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 14px; background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.5); font-size: 1rem; font-weight: 500; cursor: pointer; transition: all 0.3s ease; font-family: inherit; text-align: center; }
    .options-grid .option-btn:hover:not(:disabled) { border-color: rgba(139,92,246,0.2); background: rgba(139,92,246,0.04); color: #fff; transform: translateY(-2px); }
    .options-grid .option-btn:disabled { cursor: not-allowed; opacity: 0.3; }
    .options-grid .option-btn.correct { border-color: #28a745; background: rgba(40,167,69,0.08); color: #28a745; }
    .options-grid .option-btn.wrong { border-color: #dc3545; background: rgba(220,53,69,0.08); color: #dc3545; }

    .color-options-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; width: 100%; max-width: 400px; margin: 0 auto; position: relative; z-index: 1; }
    .color-options-grid .color-option { padding: 0.8rem 0.3rem; border: 2px solid rgba(255,255,255,0.04); border-radius: 14px; background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.3s ease; display: flex; flex-direction: column; align-items: center; gap: 6px; }
    .color-options-grid .color-option:hover:not(.disabled) { border-color: rgba(139,92,246,0.2); background: rgba(139,92,246,0.04); transform: translateY(-2px); }
    .color-options-grid .color-option.disabled { cursor: not-allowed; opacity: 0.4; }
    .color-options-grid .color-option .color-block { width: 56px; height: 56px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .color-options-grid .color-option .color-label { color: rgba(255,255,255,0.2); font-size: 0.7rem; font-weight: 500; }
    .color-options-grid .color-option.correct { border-color: #28a745; background: rgba(40,167,69,0.08); }
    .color-options-grid .color-option.wrong { border-color: #dc3545; background: rgba(220,53,69,0.08); }

    .timer-section { width: 100%; margin-top: 1rem; position: relative; z-index: 1; }
    .timer-bar { width: 100%; height: 4px; background: rgba(255,255,255,0.04); border-radius: 10px; overflow: hidden; }
    .timer-bar .timer-fill { height: 100%; border-radius: 10px; background: linear-gradient(135deg, #34D399, #F59E0B); transition: width 0.3s linear; width: 100%; }
    .timer-bar .timer-fill.warning { background: linear-gradient(135deg, #F59E0B, #EC4899); }
    .timer-bar .timer-fill.danger { background: linear-gradient(135deg, #EC4899, #dc3545); }
    .timer-text { text-align: right; color: rgba(255,255,255,0.1); font-size: 0.8rem; margin-top: 0.2rem; font-weight: 500; }

    .feedback { text-align: center; margin-top: 0.8rem; padding: 0.6rem 1.2rem; border-radius: 12px; font-size: 1rem; font-weight: 600; animation: fadeIn 0.4s ease; width: 100%; display: none; position: relative; z-index: 1; }
    .feedback.show { display: block; }
    .feedback.correct { background: rgba(40,167,69,0.06); color: #28a745; border: 1px solid rgba(40,167,69,0.06); }
    .feedback.wrong { background: rgba(220,53,69,0.06); color: #dc3545; border: 1px solid rgba(220,53,69,0.06); }
    .feedback .fun-message { font-weight: 400; color: rgba(255,255,255,0.3); font-size: 0.85rem; margin-top: 0.1rem; }

    .game-over { text-align: center; padding: 1.5rem 0.5rem; width: 100%; position: relative; z-index: 1; }
    .game-over .big-icon { font-size: 4rem; margin-bottom: 0.3rem; animation: bounce 1s ease infinite; }
    @@keyframes bounce { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    .game-over .title { color: #fff; font-size: 1.8rem; font-weight: 700; margin-bottom: 0.2rem; }
    .game-over .sub { color: rgba(255,255,255,0.2); font-size: 0.95rem; margin-bottom: 0.5rem; }
    .game-over .final-score { font-size: 3rem; font-weight: 800; color: #F59E0B; margin: 0.3rem 0; }
    .game-over .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; max-width: 300px; margin: 0.5rem auto 1.2rem; }
    .game-over .stats-grid .stat-item { background: rgba(255,255,255,0.02); border-radius: 12px; padding: 0.5rem; border: 1px solid rgba(255,255,255,0.03); }
    .game-over .stats-grid .stat-item .stat-value { color: #fff; font-size: 1.2rem; font-weight: 700; }
    .game-over .stats-grid .stat-item .stat-label { color: rgba(255,255,255,0.15); font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .btn-restart { padding: 0.8rem 3rem; border: none; border-radius: 40px; background: linear-gradient(135deg, #8B5CF6, #EC4899); color: #fff; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.3s ease; font-family: inherit; box-shadow: 0 4px 24px rgba(108,60,225,0.15); }
    .btn-restart:hover { transform: translateY(-3px); box-shadow: 0 8px 40px rgba(108,60,225,0.25); }

    .rank-section { margin-top: 1.5rem; padding: 1.2rem 1.5rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; }
    .rank-section .rank-title { color: rgba(255,255,255,0.2); font-size: 0.9rem; font-weight: 500; margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem; }
    .rank-item { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem; border-bottom: 1px solid rgba(255,255,255,0.02); }
    .rank-item:last-child { border-bottom: none; }
    .rank-item .rank-medal { font-size: 0.9rem; min-width: 32px; text-align: center; color: rgba(255,255,255,0.15); }
    .rank-item .rank-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; background: rgba(255,255,255,0.03); }
    .rank-item .rank-avatar-placeholder { width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: rgba(255,255,255,0.2); flex-shrink: 0; }
    .rank-item .rank-name { flex: 1; color: rgba(255,255,255,0.4); font-size: 0.85rem; }
    .rank-item .rank-name .me { color: #8B5CF6; font-weight: 600; }
    .rank-item .rank-score { color: #F59E0B; font-weight: 700; font-size: 0.95rem; }
    .rank-empty { text-align: center; color: rgba(255,255,255,0.08); font-size: 0.85rem; padding: 1rem 0; }

    .toast-container { position: fixed; bottom: 2rem; right: 2rem; z-index: 2000; display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-end; }
    .toast-msg { padding: 0.6rem 1.5rem; border-radius: 40px; color: #fff; font-weight: 500; animation: slideUp 0.4s ease; font-size: 0.9rem; backdrop-filter: blur(10px); background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.04); }
    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    .char-btn { display: inline-block; padding: 0.3rem 0.8rem; margin: 0.1rem; border-radius: 10px; cursor: pointer; font-size: 2.4rem; font-weight: bold; font-family: monospace; transition: all 0.3s ease; user-select: none; color: #ffffff; border: 2px solid transparent; background: transparent; }
    .char-btn:hover:not(.disabled) { transform: scale(1.1); background: rgba(139,92,246,0.08); }
    .char-btn.disabled { cursor: default; opacity: 0.5; background: transparent !important; transform: none !important; }
    .char-btn.correct-answer { border-color: #28a745 !important; background: rgba(40,167,69,0.15) !important; color: #28a745 !important; }
    .char-btn.wrong-answer { border-color: #dc3545 !important; background: rgba(220,53,69,0.15) !important; color: #dc3545 !important; }

    .puzzle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; max-width: 240px; margin: 0 auto; background: rgba(255,255,255,0.02); padding: 6px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); }
    .puzzle-grid .puzzle-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; background: rgba(255,255,255,0.04); color: #fff; user-select: none; }
    .puzzle-grid .puzzle-cell:hover:not(.empty) { background: rgba(139,92,246,0.12); transform: scale(1.04); }
    .puzzle-grid .puzzle-cell.empty { background: transparent; cursor: default; }

    #sudokuGrid .sudoku-cell { padding: 8px; text-align: center; font-size: 1.5rem; font-weight: bold; border-radius: 4px; }
    #sudokuGrid .sudoku-cell.fixed { color: rgba(255,255,255,0.5); }
    #sudokuGrid .sudoku-cell.empty { color: #8B5CF6; background: rgba(139,92,246,0.04); }

    .ascii-art { font-family: 'Courier New', monospace; font-size: 0.85rem; color: #8B5CF6; white-space: pre; text-align: center; line-height: 1.4; padding: 0.5rem; background: rgba(255,255,255,0.02); border-radius: 12px; border: 1px solid rgba(255,255,255,0.04); }

    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-8px); } 75% { transform: translateX(8px); } }
    .shake { animation: shake 0.4s ease; }

    @@media (max-width: 640px) {
        .game-header h1 { font-size: 1.6rem; }
        .challenge-card { padding: 1rem 1rem; min-height: 260px; }
        .options-grid { grid-template-columns: 1fr 1fr; gap: 0.4rem; }
        .color-options-grid { grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
        .color-options-grid .color-option .color-block { width: 42px; height: 42px; }
        .color-options-grid .color-option .color-label { font-size: 0.6rem; }
        .status-bar { padding: 0.5rem 0.8rem; justify-content: center; gap: 0.2rem 0.8rem; }
        .status-item { font-size: 0.7rem; }
        .status-item .value { font-size: 1rem; }
        .status-item .value.lives { font-size: 1.1rem; }
        .game-over .final-score { font-size: 2.2rem; }
        .char-btn { font-size: 1.8rem; padding: 0.2rem 0.5rem; }
        .memory-keyboard { gap: 0.3rem; max-width: 220px; }
        .memory-keyboard .key-btn { padding: 0.6rem 0.3rem; font-size: 1.1rem; }
        .memory-keyboard .key-btn.backspace { font-size: 0.9rem; }
        .memory-input-display { font-size: 1.4rem; max-width: 220px; min-height: 40px; }
        .puzzle-grid { max-width: 180px; }
        .puzzle-grid .puzzle-cell { font-size: 1.2rem; }
        #sudokuGrid .sudoku-cell { font-size: 1.1rem; padding: 4px; }
        .ascii-art { font-size: 0.7rem; }
        .rotate-compare { gap: 0.8rem; }
        .rotate-compare .rotate-item svg { width: 80px; height: 80px; }
    }
    @@media (max-width: 400px) {
        .game-header h1 { font-size: 1.3rem; }
        .status-item { font-size: 0.6rem; }
        .status-item .value { font-size: 0.85rem; }
        .status-item .value.lives { font-size: 0.9rem; }
        .options-grid .option-btn { font-size: 0.8rem; padding: 0.5rem 0.6rem; }
        .char-btn { font-size: 1.4rem; padding: 0.1rem 0.4rem; }
        .color-options-grid .color-option .color-block { width: 34px; height: 34px; }
        .color-options-grid .color-option .color-label { font-size: 0.5rem; }
        .puzzle-grid { max-width: 150px; }
        .puzzle-grid .puzzle-cell { font-size: 1rem; }
        .memory-keyboard { gap: 0.2rem; max-width: 180px; }
        .memory-keyboard .key-btn { padding: 0.4rem 0.2rem; font-size: 0.9rem; }
        .memory-keyboard .key-btn.backspace { font-size: 0.7rem; }
        .ascii-art { font-size: 0.6rem; }
        .rotate-compare .rotate-item svg { width: 60px; height: 60px; }
        .rotate-compare .rotate-arrow { font-size: 1rem; }
    }
</style>

<div class="game-container">
    <div class="game-header">
        <span class="header-particle">✦</span>
        <span class="header-particle">●</span>
        <span class="header-particle">◆</span>
        <span class="header-particle">▲</span>
        <span class="header-particle">★</span>
        <h1>🧩 验证大闯关</h1>
        <p class="subtitle">100关 · 难度递增 · 证明你是人类</p>
        <div class="type-badge-header" id="typeNameDisplay">📝 准备开始</div>
    </div>

    <div class="status-bar" id="statusBar">
        <div class="status-item">❤️ 生命 <span class="value lives" id="livesDisplay">❤️❤️❤️</span></div>
        <div class="status-item">📊 关卡 <span class="value level" id="levelDisplay">1</span></div>
        <div class="status-item">🏆 积分 <span class="value score" id="scoreDisplay">0</span></div>
        <div class="status-item">🔥 连击 <span class="value combo" id="comboDisplay">0</span></div>
        <div class="status-item">✅ 通关 <span class="value passed" id="passedDisplay">0</span></div>
    </div>

    <div class="progress-bar"><div class="fill" id="progressFill"></div></div>

    <div class="challenge-card" id="challengeCard">
        <div class="type-badge" id="typeBadge">第 1 关</div>
        <div class="question-text" id="questionText">加载中...</div>
        <div id="imageContainer" style="display:none;"><div class="captcha-image" id="captchaImage"></div></div>
        <div id="colorContainer" style="display:none;"><div class="color-display" id="colorDisplay">██████</div></div>
        <div class="display-text-container" id="displayTextContainer"><div class="display-text" id="displayText"></div></div>

        <div id="memoryContainer" style="display:none;width:100%;">
            <div class="memory-input-display" id="memoryInputDisplay" style="display:none;text-align:center;">_ _ _ _</div>
            <div class="memory-keyboard" id="memoryKeyboard" style="display:none;"></div>
            <div class="memory-controls">
                <button class="btn-memory submit" onclick="submitMemoryAnswer()" style="display:none;">✅ 确认</button>
            </div>
        </div>

        <div class="options-grid" id="optionsGrid"></div>
        <div class="color-options-grid" id="colorOptionsGrid" style="display:none;"></div>
        <div id="puzzleContainer" style="display:none;width:100%;"><div class="puzzle-grid" id="puzzleGrid"></div></div>
        <div id="sudokuContainer" style="display:none;width:100%;"><div id="sudokuGrid"></div></div>
        <div id="asciiContainer" style="display:none;width:100%;"><div class="ascii-art" id="asciiArt"></div></div>

        <div class="timer-section">
            <div class="timer-bar"><div class="timer-fill" id="timerFill"></div></div>
            <div class="timer-text" id="timerText">⏱ 15s</div>
        </div>
        <div class="feedback" id="feedback"></div>
    </div>

    <div class="rank-section" id="rankSection" style="display:none;">
        <div class="rank-title">🏆 排行榜</div>
        <div id="rankList"></div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    var gameState = {
        level: 1, score: 0, lives: 3, combo: 0, maxCombo: 0, passed: 0,
        isPlaying: false, isAnswered: false, timer: null, timeLeft: 15,
        totalLevels: 100, currentChallenge: null,
        memoryInput: '', memoryCorrectAnswer: '',
        puzzleState: null, puzzleEmptyRow: 0, puzzleEmptyCol: 0,
        sudokuEmptyRow: 0, sudokuEmptyCol: 0, sudokuCorrectAnswer: '',
    };

    var dom = {
        levelDisplay: document.getElementById('levelDisplay'),
        scoreDisplay: document.getElementById('scoreDisplay'),
        livesDisplay: document.getElementById('livesDisplay'),
        comboDisplay: document.getElementById('comboDisplay'),
        passedDisplay: document.getElementById('passedDisplay'),
        progressFill: document.getElementById('progressFill'),
        typeBadge: document.getElementById('typeBadge'),
        typeNameDisplay: document.getElementById('typeNameDisplay'),
        questionText: document.getElementById('questionText'),
        optionsGrid: document.getElementById('optionsGrid'),
        colorOptionsGrid: document.getElementById('colorOptionsGrid'),
        imageContainer: document.getElementById('imageContainer'),
        captchaImage: document.getElementById('captchaImage'),
        colorContainer: document.getElementById('colorContainer'),
        colorDisplay: document.getElementById('colorDisplay'),
        displayTextContainer: document.getElementById('displayTextContainer'),
        displayText: document.getElementById('displayText'),
        memoryContainer: document.getElementById('memoryContainer'),
        memoryKeyboard: document.getElementById('memoryKeyboard'),
        memoryInputDisplay: document.getElementById('memoryInputDisplay'),
        puzzleContainer: document.getElementById('puzzleContainer'),
        puzzleGrid: document.getElementById('puzzleGrid'),
        sudokuContainer: document.getElementById('sudokuContainer'),
        sudokuGrid: document.getElementById('sudokuGrid'),
        asciiContainer: document.getElementById('asciiContainer'),
        asciiArt: document.getElementById('asciiArt'),
        feedback: document.getElementById('feedback'),
        timerFill: document.getElementById('timerFill'),
        timerText: document.getElementById('timerText'),
        challengeCard: document.getElementById('challengeCard'),
        rankSection: document.getElementById('rankSection'),
        rankList: document.getElementById('rankList')
    };

    function startGame() {
        if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
        gameState.level = 1; gameState.score = 0; gameState.lives = 3;
        gameState.combo = 0; gameState.maxCombo = 0; gameState.passed = 0;
        gameState.isPlaying = true; gameState.isAnswered = false;
        gameState.timeLeft = 15; gameState.memoryInput = ''; gameState.memoryCorrectAnswer = '';
        gameState.currentChallenge = null;
        dom.rankSection.style.display = 'none';
        dom.feedback.className = 'feedback'; dom.feedback.style.display = 'none';
        dom.feedback.innerHTML = '';
        dom.challengeCard.innerHTML = `
            <div class="type-badge" id="typeBadge">第 1 关</div>
            <div class="question-text" id="questionText">加载中...</div>
            <div id="imageContainer" style="display:none;"><div class="captcha-image" id="captchaImage"></div></div>
            <div id="colorContainer" style="display:none;"><div class="color-display" id="colorDisplay">██████</div></div>
            <div class="display-text-container" id="displayTextContainer"><div class="display-text" id="displayText"></div></div>
            <div id="memoryContainer" style="display:none;width:100%;">
                <div class="memory-input-display" id="memoryInputDisplay" style="display:none;text-align:center;">_ _ _ _</div>
                <div class="memory-keyboard" id="memoryKeyboard" style="display:none;"></div>
                <div class="memory-controls">
                    <button class="btn-memory submit" onclick="submitMemoryAnswer()" style="display:none;">✅ 确认</button>
                </div>
            </div>
            <div class="options-grid" id="optionsGrid"></div>
            <div class="color-options-grid" id="colorOptionsGrid" style="display:none;"></div>
            <div id="puzzleContainer" style="display:none;width:100%;"><div class="puzzle-grid" id="puzzleGrid"></div></div>
            <div id="sudokuContainer" style="display:none;width:100%;"><div id="sudokuGrid"></div></div>
            <div id="asciiContainer" style="display:none;width:100%;"><div class="ascii-art" id="asciiArt"></div></div>
            <div class="timer-section">
                <div class="timer-bar"><div class="timer-fill" id="timerFill"></div></div>
                <div class="timer-text" id="timerText">⏱ 15s</div>
            </div>
            <div class="feedback" id="feedback"></div>
        `;
        dom.typeBadge = document.getElementById('typeBadge');
        dom.questionText = document.getElementById('questionText');
        dom.imageContainer = document.getElementById('imageContainer');
        dom.captchaImage = document.getElementById('captchaImage');
        dom.colorContainer = document.getElementById('colorContainer');
        dom.colorDisplay = document.getElementById('colorDisplay');
        dom.displayTextContainer = document.getElementById('displayTextContainer');
        dom.displayText = document.getElementById('displayText');
        dom.memoryContainer = document.getElementById('memoryContainer');
        dom.memoryKeyboard = document.getElementById('memoryKeyboard');
        dom.memoryInputDisplay = document.getElementById('memoryInputDisplay');
        dom.optionsGrid = document.getElementById('optionsGrid');
        dom.colorOptionsGrid = document.getElementById('colorOptionsGrid');
        dom.puzzleContainer = document.getElementById('puzzleContainer');
        dom.puzzleGrid = document.getElementById('puzzleGrid');
        dom.sudokuContainer = document.getElementById('sudokuContainer');
        dom.sudokuGrid = document.getElementById('sudokuGrid');
        dom.asciiContainer = document.getElementById('asciiContainer');
        dom.asciiArt = document.getElementById('asciiArt');
        dom.feedback = document.getElementById('feedback');
        dom.timerFill = document.getElementById('timerFill');
        dom.timerText = document.getElementById('timerText');
        dom.challengeCard = document.getElementById('challengeCard');
        updateUI();
        dom.typeNameDisplay.textContent = '📝 第 1 关 · 入门';
        loadChallenge();
    }

    function loadChallenge() {
        if (!gameState.isPlaying) return;
        if (gameState.level > gameState.totalLevels) { gameWin(); return; }

        gameState.isAnswered = false;
        dom.feedback.className = 'feedback';
        dom.feedback.style.display = 'none';
        dom.optionsGrid.innerHTML = ''; dom.optionsGrid.style.display = 'none';
        dom.colorOptionsGrid.innerHTML = ''; dom.colorOptionsGrid.style.display = 'none';
        dom.displayTextContainer.style.display = 'none';
        dom.imageContainer.style.display = 'none'; dom.colorContainer.style.display = 'none';
        dom.memoryContainer.style.display = 'none';
        dom.puzzleContainer.style.display = 'none'; dom.sudokuContainer.style.display = 'none';
        dom.asciiContainer.style.display = 'none';

        var diffLabel = getDifficultyLabel(gameState.level);
        dom.typeBadge.textContent = '第 ' + gameState.level + ' 关';

        fetch('/VerifyGame/GetChallenge?level=' + gameState.level)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    gameState.currentChallenge = data.data;
                    if (data.data.typeName) {
                        dom.typeNameDisplay.textContent = '🧩 ' + data.data.typeName + ' · ' + diffLabel;
                    }
                    renderChallenge(data.data);
                } else { showToast('加载挑战失败，请重试', 'error'); }
            })
            .catch(function() { showToast('网络错误，请刷新重试', 'error'); });
    }

    function renderChallenge(challenge) {
        gameState.currentChallenge = challenge;
        var typeName = challenge.typeName || challenge.type || '未知';
        var diffLabel = getDifficultyLabel(challenge.level);
        dom.typeBadge.textContent = '第 ' + challenge.level + ' 关 · ' + typeName + ' · ' + diffLabel;
        dom.typeNameDisplay.textContent = '🧩 ' + typeName + ' · ' + diffLabel;

        dom.questionText.innerHTML = challenge.question || '请完成以下挑战';

        dom.imageContainer.style.display = 'none'; dom.colorContainer.style.display = 'none';
        dom.displayTextContainer.style.display = 'none'; dom.memoryContainer.style.display = 'none';
        dom.optionsGrid.style.display = 'none'; dom.colorOptionsGrid.style.display = 'none';
        dom.puzzleContainer.style.display = 'none'; dom.sudokuContainer.style.display = 'none';
        dom.asciiContainer.style.display = 'none';

        if (challenge.imageSvg) {
            dom.imageContainer.style.display = 'block';
            dom.captchaImage.innerHTML = challenge.imageSvg;
        }

        // ===== 图形旋转（原图 + 旋转图对比） =====
        if (challenge.type === 'rotate' && challenge.originalSvg) {
            dom.imageContainer.style.display = 'block';
            dom.captchaImage.innerHTML = `
                <div class="rotate-compare">
                    <div class="rotate-item">
                        <span class="label">📐 原图</span>
                        ${challenge.originalSvg}
                    </div>
                    <div class="rotate-arrow">→</div>
                    <div class="rotate-item">
                        <span class="label">🔄 旋转后</span>
                        ${challenge.rotatedSvg || challenge.originalSvg}
                    </div>
                </div>
            `;
            
            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
            startTimer(challenge.timeLimit || 15);
            return;
        }

        if (challenge.type === 'shapeCount' && challenge.correctAnswer) {
            dom.asciiContainer.style.display = 'block';
            dom.asciiArt.textContent = challenge.question.replace(/<br>.*$/, '').replace('📐 下图中共有多少个正方体？', '');
            dom.questionText.innerHTML = challenge.question;
            
            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
            startTimer(challenge.timeLimit || 15);
            return;
        }

        if (challenge.displayHtml) {
            dom.colorContainer.style.display = 'block';
            dom.colorDisplay.innerHTML = challenge.displayHtml;
        }
        if (challenge.displayText && challenge.type !== 'memory') {
            dom.displayTextContainer.style.display = 'block';
            dom.displayText.innerHTML = challenge.displayText;
        }

        // ===== 数字记忆 =====
        if (challenge.type === 'memory' && challenge.keyboardRows) {
            dom.memoryContainer.style.display = 'block';
            dom.memoryInputDisplay.style.display = 'none';
            dom.memoryKeyboard.style.display = 'none';
            dom.memoryContainer.querySelectorAll('.btn-memory').forEach(function(b) { b.style.display = 'none'; });

            gameState.memoryInput = '';
            gameState.memoryCorrectAnswer = challenge.correctAnswer || '';
            dom.memoryInputDisplay.textContent = '_ '.repeat(gameState.memoryCorrectAnswer.length).trim();
            renderMemoryKeyboard(challenge.keyboardRows);

            if (challenge.displayNumber) {
                dom.questionText.innerHTML = '🧠 记住下面显示的数字';
                dom.displayTextContainer.style.display = 'block';
                dom.displayText.textContent = challenge.displayNumber;
                dom.displayText.style.cssText = 'font-size:3rem;font-weight:bold;color:#8B5CF6;padding:1.5rem;margin:0.5rem 0;background:rgba(139,92,246,0.04);border-radius:16px;border:1px solid rgba(139,92,246,0.06);text-align:center;letter-spacing:12px;';

                var memoryTime = challenge.memoryTime || 5;
                dom.timerText.textContent = '⏱ 记忆 ' + memoryTime + 's';
                dom.timerFill.style.width = '100%'; dom.timerFill.className = 'timer-fill';

                var memInterval = setInterval(function() {
                    memoryTime--;
                    dom.timerText.textContent = '⏱ 记忆 ' + memoryTime + 's';
                    var pct = (memoryTime / (challenge.memoryTime || 5)) * 100;
                    dom.timerFill.style.width = pct + '%';
                    if (pct < 30) dom.timerFill.classList.add('danger');
                    else if (pct < 50) dom.timerFill.classList.add('warning');
                    if (memoryTime <= 0) {
                        clearInterval(memInterval);
                        dom.displayText.textContent = '✏️ 输入你记住的数字';
                        dom.displayText.style.cssText = 'font-size:1.2rem;color:rgba(255,255,255,0.3);padding:0.5rem;margin:0.5rem 0;text-align:center;';
                        dom.memoryInputDisplay.style.display = 'block';
                        dom.memoryInputDisplay.style.textAlign = 'center';
                        dom.memoryKeyboard.style.display = 'grid';
                        dom.memoryContainer.querySelectorAll('.btn-memory').forEach(function(b) { b.style.display = 'inline-block'; });
                        dom.timerText.textContent = '⏱ ' + (challenge.timeLimit || 15) + 's';
                        dom.timerFill.style.width = '100%'; dom.timerFill.className = 'timer-fill';
                        startTimer(challenge.timeLimit || 15);
                    }
                }, 1000);
                return;
            }
        }

        // ===== 颜色混合 =====
        if (challenge.type === 'colorMix' && challenge.optionsHtml) {
            dom.colorOptionsGrid.style.display = 'grid';
            dom.colorOptionsGrid.innerHTML = challenge.optionsHtml;
            dom.optionsGrid.style.display = 'none';
            var colorOptions = dom.colorOptionsGrid.querySelectorAll('.color-option');
            colorOptions.forEach(function(el) {
                el.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    var answer = this.dataset.color;
                    if (answer) submitColorMixAnswer(challenge, answer, this);
                });
            });
            startTimer(challenge.timeLimit || 15);
            return;
        }

        // ===== 华容道 =====
        if (challenge.type === 'puzzle' && challenge.puzzle) {
            dom.puzzleContainer.style.display = 'block';
            renderPuzzle(challenge.puzzle);
            startTimer(challenge.timeLimit || 60);
            return;
        }

        // ===== 数独 =====
        if (challenge.type === 'sudoku' && challenge.gridHtml) {
            dom.sudokuContainer.style.display = 'block';
            dom.sudokuGrid.innerHTML = challenge.gridHtml;
            gameState.sudokuEmptyRow = challenge.emptyRow || 0;
            gameState.sudokuEmptyCol = challenge.emptyCol || 0;
            gameState.sudokuCorrectAnswer = challenge.correctAnswer || '';

            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            var optionLetters = ['A', 'B', 'C', 'D', 'E', 'F'];
            (challenge.options || []).forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = optionLetters[idx] + '. ' + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitSudokuAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
            startTimer(challenge.timeLimit || 30);
            return;
        }

        // ===== 找不同 =====
        if (challenge.type === 'findDifferent' && challenge.originalDisplay) {
            dom.displayTextContainer.style.display = 'block';
            dom.displayText.textContent = challenge.originalDisplay;
            dom.displayText.style.cssText = 'font-size:2.8rem;font-weight:bold;color:#8B5CF6;padding:1.5rem;margin:0.5rem 0;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:8px;font-family:monospace;';

            var displayTime = challenge.displayTime || 3;
            dom.timerText.textContent = '⏱ 记忆 ' + displayTime + 's';
            dom.timerFill.style.width = '100%'; dom.timerFill.className = 'timer-fill';

            var countdownInterval = setInterval(function() {
                displayTime--;
                dom.timerText.textContent = '⏱ 记忆 ' + displayTime + 's';
                var pct = (displayTime / (challenge.displayTime || 3)) * 100;
                dom.timerFill.style.width = pct + '%';
                if (pct < 30) dom.timerFill.classList.add('danger');
                else if (pct < 50) dom.timerFill.classList.add('warning');
                if (displayTime <= 0) {
                    clearInterval(countdownInterval);
                    dom.displayText.textContent = '⏰ 时间到！找出被更改的字符！';
                    dom.displayText.style.color = '#F59E0B';
                    dom.displayText.style.fontSize = '1.8rem';
                    dom.displayText.style.letterSpacing = 'normal';
                    dom.timerText.textContent = '⏱ 选择';

                    setTimeout(function() {
                        var shuffled = challenge.shuffledDisplay || '';
                        var shuffledPos = challenge.shuffledPos || 0;
                        var html = '';
                        for (var i = 0; i < shuffled.length; i++) {
                            var ch = shuffled[i];
                            html += '<span class="char-btn" data-index="' + i + '" data-char="' + ch + '" onclick="selectChar(' + i + ', \'' + ch + '\', this)">' + ch + '</span>';
                        }
                        dom.displayText.innerHTML = html;
                        dom.displayText.style.cssText = 'padding:1.5rem;margin:0.5rem 0;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:4px;';
                        dom.displayText.style.color = '#fff';
                        dom.displayText.style.fontSize = '1rem';
                        dom.displayText.dataset.correctAnswer = challenge.correctAnswer;
                        dom.displayText.dataset.shuffledPos = shuffledPos;
                        startTimer(challenge.timeLimit || 10);
                    }, 1000);
                }
            }, 1000);
            return;
        }

        // ===== 真假判断 =====
        if (challenge.type === 'trueFalse') {
            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            (challenge.options || ['✅ 真的', '❌ 假的']).forEach(function(opt) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
            startTimer(challenge.timeLimit || 60);
            return;
        }

        // ===== 字符频率统计 =====
        if (challenge.type === 'charFrequency' && challenge.options) {
            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = (idx < letters.length ? letters[idx] + '. ' : '') + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
            startTimer(challenge.timeLimit || 15);
            return;
        }

        // ===== 常规选项 =====
        if (challenge.options && challenge.options.length > 0) {
            dom.optionsGrid.style.display = 'grid';
            dom.optionsGrid.innerHTML = '';
            var letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
            challenge.options.forEach(function(opt, idx) {
                var btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.textContent = letters[idx] + '. ' + opt;
                btn.dataset.answer = opt;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    submitAnswer(challenge, this.dataset.answer, this);
                });
                dom.optionsGrid.appendChild(btn);
            });
        }

        startTimer(challenge.timeLimit || 15);
        updateUI();
    }

    // ===== 记忆键盘 =====
    function renderMemoryKeyboard(rows) {
        var keyboard = dom.memoryKeyboard;
        keyboard.innerHTML = '';
        keyboard.style.gridTemplateColumns = 'repeat(4, 1fr)';

        var allKeys = [];
        rows.forEach(function(row) {
            row.forEach(function(num) { allKeys.push({ type: 'number', value: num }); });
        });
        while (allKeys.length < 11) {
            allKeys.push({ type: 'number', value: allKeys.length % 10 });
        }
        allKeys = allKeys.slice(0, 11);
        allKeys.push({ type: 'backspace', value: '⌫' });

        allKeys.forEach(function(item) {
            var btn = document.createElement('button');
            btn.className = 'key-btn';
            if (item.type === 'backspace') {
                btn.textContent = '⌫';
                btn.classList.add('backspace');
                btn.dataset.type = 'backspace';
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    memoryBackspace();
                });
            } else {
                btn.textContent = item.value;
                btn.dataset.value = item.value;
                btn.addEventListener('click', function() {
                    if (gameState.isAnswered) return;
                    memoryKeyPress(this.dataset.value);
                });
            }
            keyboard.appendChild(btn);
        });
    }

    function memoryKeyPress(value) {
        if (gameState.isAnswered) return;
        var len = gameState.memoryCorrectAnswer.length;
        if (gameState.memoryInput.length >= len) return;
        gameState.memoryInput += value;
        updateMemoryDisplay();
    }

    function memoryBackspace() {
        if (gameState.isAnswered) return;
        if (gameState.memoryInput.length > 0) {
            gameState.memoryInput = gameState.memoryInput.slice(0, -1);
            updateMemoryDisplay();
        }
    }

    function updateMemoryDisplay() {
        var len = gameState.memoryCorrectAnswer.length;
        var display = '';
        for (var i = 0; i < len; i++) {
            if (i < gameState.memoryInput.length) {
                display += gameState.memoryInput[i] + ' ';
            } else {
                display += '_ ';
            }
        }
        dom.memoryInputDisplay.textContent = display.trim();
        dom.memoryInputDisplay.style.textAlign = 'center';
    }

    function submitMemoryAnswer() {
        if (gameState.isAnswered) return;
        if (gameState.memoryInput.length !== gameState.memoryCorrectAnswer.length) {
            showToast('请完整输入所有数字', 'error');
            return;
        }
        var isCorrect = gameState.memoryInput === gameState.memoryCorrectAnswer;
        var challenge = gameState.currentChallenge;
        dom.memoryKeyboard.querySelectorAll('.key-btn').forEach(function(b) { b.disabled = true; });
        dom.memoryContainer.querySelectorAll('.btn-memory').forEach(function(b) { b.disabled = true; });
        handleAnswerResult(challenge, isCorrect);
    }

    // ===== 答案处理 =====
    function submitAnswer(challenge, answer, btn) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(b) {
            b.disabled = true;
            if (b.dataset.answer === challenge.correctAnswer) b.classList.add('correct');
        });
        if (!isCorrect) {
            btn.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    function submitColorMixAnswer(challenge, answer, element) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        dom.colorOptionsGrid.querySelectorAll('.color-option').forEach(function(el) {
            el.classList.add('disabled');
            if (el.dataset.color === challenge.correctAnswer) {
                el.classList.add('correct');
            }
        });
        if (!isCorrect) {
            element.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    function submitSudokuAnswer(challenge, answer, btn) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(b) {
            b.disabled = true;
            if (b.dataset.answer === challenge.correctAnswer) b.classList.add('correct');
        });
        if (!isCorrect) {
            btn.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        var emptyCell = document.getElementById('sudokuEmpty');
        if (emptyCell) {
            emptyCell.textContent = isCorrect ? challenge.correctAnswer : '✗';
            emptyCell.style.color = isCorrect ? '#28a745' : '#dc3545';
        }
        handleAnswerResult(challenge, isCorrect);
    }

    function selectChar(index, char, element) {
        if (gameState.isAnswered) return;
        var container = dom.displayText;
        var shuffledPos = parseInt(container.dataset.shuffledPos);
        var isCorrect = (index === shuffledPos);
        var challenge = gameState.currentChallenge;

        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var allChars = container.querySelectorAll('.char-btn');
        allChars.forEach(function(el) {
            el.classList.add('disabled');
            el.onclick = null;
            if (parseInt(el.dataset.index) === shuffledPos) {
                el.classList.add('correct-answer');
            }
        });
        if (!isCorrect) {
            element.classList.add('wrong-answer');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    function handleAnswerResult(challenge, isCorrect) {
        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var points = 0;
        if (isCorrect) {
            var bonus = Math.min(gameState.combo, 10);
            points = 10 + Math.floor(gameState.level / 5) + bonus * 2;
            gameState.score += points;
            gameState.combo++;
            gameState.passed++;
            if (gameState.combo > gameState.maxCombo) gameState.maxCombo = gameState.combo;
            showFeedback(true, points, challenge.funMessage);
            gameState.level++;
        } else {
            gameState.combo = 0;
            gameState.lives--;
            showFeedback(false, 0, '');
        }

        updateUI();

        if (gameState.lives <= 0) {
            setTimeout(gameOver, 1500);
            return;
        }
        setTimeout(loadChallenge, 1500);
    }

    // ===== 华容道 =====
    function renderPuzzle(puzzle) {
        var grid = dom.puzzleGrid;
        grid.innerHTML = '';
        gameState.puzzleState = puzzle.map(function(row) { return row.slice(); });

        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                var cell = document.createElement('div');
                cell.className = 'puzzle-cell';
                var val = puzzle[r][c];
                if (val === 0) {
                    cell.classList.add('empty');
                    cell.textContent = '';
                    gameState.puzzleEmptyRow = r;
                    gameState.puzzleEmptyCol = c;
                } else {
                    cell.textContent = val;
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    cell.addEventListener('click', function() {
                        if (gameState.isAnswered) return;
                        var row = parseInt(this.dataset.row);
                        var col = parseInt(this.dataset.col);
                        movePuzzleTile(row, col);
                    });
                }
                grid.appendChild(cell);
            }
        }
    }

    function movePuzzleTile(row, col) {
        var emptyRow = gameState.puzzleEmptyRow;
        var emptyCol = gameState.puzzleEmptyCol;
        var dr = Math.abs(row - emptyRow);
        var dc = Math.abs(col - emptyCol);
        if ((dr === 1 && dc === 0) || (dr === 0 && dc === 1)) {
            var puzzle = gameState.puzzleState;
            puzzle[emptyRow][emptyCol] = puzzle[row][col];
            puzzle[row][col] = 0;
            gameState.puzzleEmptyRow = row;
            gameState.puzzleEmptyCol = col;
            renderPuzzleState(puzzle);
            if (checkPuzzleSolved(puzzle)) {
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                var challenge = gameState.currentChallenge;
                handleAnswerResult(challenge, true);
            }
        }
    }

    function renderPuzzleState(puzzle) {
        var cells = dom.puzzleGrid.querySelectorAll('.puzzle-cell');
        var idx = 0;
        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                var val = puzzle[r][c];
                var cell = cells[idx];
                if (val === 0) {
                    cell.classList.add('empty');
                    cell.textContent = '';
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    cell.onclick = null;
                } else {
                    cell.classList.remove('empty');
                    cell.textContent = val;
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    cell.onclick = function() {
                        if (gameState.isAnswered) return;
                        var row = parseInt(this.dataset.row);
                        var col = parseInt(this.dataset.col);
                        movePuzzleTile(row, col);
                    };
                }
                idx++;
            }
        }
    }

    function checkPuzzleSolved(puzzle) {
        var expected = [[1,2,3],[4,5,6],[7,8,0]];
        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                if (puzzle[r][c] !== expected[r][c]) return false;
            }
        }
        return true;
    }

    // ===== 计时器 =====
    function startTimer(limit) {
        clearInterval(gameState.timer);
        gameState.timeLeft = limit;
        updateTimerDisplay(limit);

        gameState.timer = setInterval(function() {
            gameState.timeLeft--;
            updateTimerDisplay(limit);
            if (gameState.timeLeft <= 0) {
                clearInterval(gameState.timer);
                if (!gameState.isAnswered) {
                    gameState.isAnswered = true;
                    disableAllInteractions();
                    gameState.combo = 0;
                    gameState.lives--;
                    updateUI();
                    showFeedback(false, 0, '⏱ 时间到！');
                    if (gameState.lives <= 0) {
                        setTimeout(gameOver, 1200);
                    } else {
                        setTimeout(loadChallenge, 1500);
                    }
                }
            }
        }, 1000);
    }

    function updateTimerDisplay(limit) {
        var pct = (gameState.timeLeft / Math.max(1, limit)) * 100;
        dom.timerFill.style.width = Math.max(0, Math.min(100, pct)) + '%';
        dom.timerText.textContent = '⏱ ' + gameState.timeLeft + 's';
        dom.timerFill.className = 'timer-fill';
        if (pct < 30) dom.timerFill.classList.add('danger');
        else if (pct < 50) dom.timerFill.classList.add('warning');
    }

    function disableAllInteractions() {
        dom.optionsGrid.querySelectorAll('.option-btn').forEach(function(b) { b.disabled = true; });
        dom.colorOptionsGrid.querySelectorAll('.color-option').forEach(function(el) {
            el.classList.add('disabled');
        });
        dom.memoryKeyboard.querySelectorAll('.key-btn').forEach(function(b) { b.disabled = true; });
        dom.memoryContainer.querySelectorAll('.btn-memory').forEach(function(b) { b.disabled = true; });
        dom.puzzleGrid.querySelectorAll('.puzzle-cell').forEach(function(cell) { cell.onclick = null; });
        dom.sudokuGrid.querySelectorAll('.option-btn').forEach(function(b) { b.disabled = true; });
    }

    function showFeedback(isCorrect, points, funMessage) {
        var el = dom.feedback;
        el.style.display = 'block';
        el.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');
        if (isCorrect) {
            el.innerHTML = '✅ 答对了！ +' + points + ' 分' +
                (funMessage ? '<div class="fun-message">' + funMessage + '</div>' : '');
        } else {
            el.innerHTML = '❌ 答错了！连击中断';
        }
    }

    function updateUI() {
        dom.levelDisplay.textContent = gameState.level;
        dom.scoreDisplay.textContent = gameState.score;
        dom.comboDisplay.textContent = gameState.combo;
        dom.passedDisplay.textContent = gameState.passed;
        var hearts = '❤️'.repeat(gameState.lives) + '🖤'.repeat(Math.max(0, 3 - gameState.lives));
        dom.livesDisplay.textContent = hearts || '💀';
        var progress = (gameState.passed / gameState.totalLevels) * 100;
        dom.progressFill.style.width = Math.min(progress, 100) + '%';
    }

    function getDifficultyLabel(level) {
        if (level >= 81) return '👑 传说';
        if (level >= 61) return '💀 地狱';
        if (level >= 41) return '🔥 噩梦';
        if (level >= 21) return '⚡ 困难';
        return '📝 入门';
    }

    function saveAndShowRanking() {
        var finalScore = gameState.score;
        fetch('/VerifyGame/SaveScore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'score=' + finalScore + '&level=' + gameState.level + '&maxCombo=' + gameState.maxCombo + '&passed=' + gameState.passed
        }).then(function() { loadRanking(); });
    }

    function loadRanking() {
        var userId = @(Context.Session.GetInt32("UserId") ?? 0);
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var container = dom.rankList;
                var section = dom.rankSection;
                if (data.success && data.data.length > 0) {
                    var html = '';
                    var medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" class="rank-avatar" />' :
                            '<div class="rank-avatar-placeholder">' + (item.username ? item.username.charAt(0).toUpperCase() : '?') + '</div>';
                        var isMe = item.isMe || false;
                        html += '<div class="rank-item">' +
                            '<span class="rank-medal">' + medal + '</span>' +
                            avatarHtml +
                            '<span class="rank-name">' + item.username + (isMe ? ' <span class="me">(我)</span>' : '') + '</span>' +
                            '<span class="rank-score">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                    section.style.display = 'block';
                } else {
                    container.innerHTML = '<div class="rank-empty">暂无排行数据<br>快来挑战吧！</div>';
                    section.style.display = 'block';
                }
            })
            .catch(function() {
                dom.rankList.innerHTML = '<div class="rank-empty">加载排行榜失败</div>';
                dom.rankSection.style.display = 'block';
            });
    }

    function gameOver() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);
        var finalScore = gameState.score;
        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">${finalScore > 100 ? '🏆' : '💪'}</div>
                <div class="title">${finalScore > 100 ? '🎉 挑战结束！' : '😅 继续加油！'}</div>
                <div class="sub">你成功通过了 ${gameState.passed} 关</div>
                <div class="final-score">${finalScore}</div>
                <div class="stats-grid">
                    <div class="stat-item"><div class="stat-value">${gameState.passed}</div><div class="stat-label">通关</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.maxCombo}</div><div class="stat-label">最高连击</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.level - 1}</div><div class="stat-label">到达关卡</div></div>
                </div>
                <button class="btn-restart" onclick="restartGame()">🔄 再来一次</button>
            </div>
        `;
        saveAndShowRanking();
    }

    function gameWin() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);
        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">👑</div>
                <div class="title">🎉 恭喜通关！</div>
                <div class="sub">你通过了全部 100 关！</div>
                <div class="final-score">${gameState.score}</div>
                <div class="stats-grid">
                    <div class="stat-item"><div class="stat-value">100</div><div class="stat-label">通关</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.maxCombo}</div><div class="stat-label">最高连击</div></div>
                    <div class="stat-item"><div class="stat-value">🏆</div><div class="stat-label">传说</div></div>
                </div>
                <button class="btn-restart" onclick="restartGame()">🔄 再来一次</button>
            </div>
        `;
        saveAndShowRanking();
    }

    function restartGame() {
        window.location.reload();
    }

    function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + (type || 'info');
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function() {
        gameState.isPlaying = true;
        startGame();
    });
</script>
