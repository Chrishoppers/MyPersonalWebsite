    // ============================================================
    // 颜色混合
    // ============================================================
    function renderColorMix(challenge) {
        var container = dom.gameContent;
        container.innerHTML = '';

        if (challenge.displayHtml) {
            var displayDiv = document.createElement('div');
            displayDiv.className = 'display-text-container';
            displayDiv.style.textAlign = 'center';
            displayDiv.style.margin = '0.1rem 0 0.6rem';
            displayDiv.innerHTML = challenge.displayHtml;
            container.appendChild(displayDiv);
        }

        var colorGrid = document.createElement('div');
        colorGrid.className = 'color-options-grid';

        if (challenge.optionsHtml && challenge.optionsHtml.trim().length > 0) {
            colorGrid.innerHTML = challenge.optionsHtml;
        } else if (challenge.options && challenge.options.length > 0) {
            var html = '';
            challenge.options.forEach(function(colorName) {
                var hex = getColorHex(colorName) || '#808080';
                var displayName = colorName.replace('色', '');
                html += '<div class="color-option" data-color="' + colorName + '">';
                html += '<div class="color-block" style="background:' + hex + ';"></div>';
                html += '<span class="color-label">' + displayName + '</span>';
                html += '</div>';
            });
            colorGrid.innerHTML = html;
        } else {
            renderOptions(challenge, container);
            startTimer(challenge.timeLimit || 15);
            updateUI();
            return;
        }

        colorGrid.querySelectorAll('.color-option').forEach(function(el) {
            el.addEventListener('click', function() {
                if (gameState.isAnswered) return;
                var answer = this.dataset.color;
                if (answer) submitColorMixAnswer(challenge, answer, this);
            });
        });

        container.appendChild(colorGrid);
        startTimer(challenge.timeLimit || 15);
        updateUI();
    }

    function submitColorMixAnswer(challenge, answer, element) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        var container = dom.gameContent;

        container.querySelectorAll('.color-option').forEach(function(el) {
            el.classList.add('disabled');
            if (el.dataset.color === challenge.correctAnswer) el.classList.add('correct');
        });

        if (!isCorrect) {
            element.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        } else {
            element.classList.add('correct');
        }

        handleAnswerResult(challenge, isCorrect);
    }

    // ============================================================
    // 华容道
    // ============================================================
    function renderPuzzle(puzzle) {
        var container = dom.gameContent;
        container.innerHTML = '';
        var hintDiv = document.createElement('div');
        hintDiv.style.cssText = 'color:rgba(255,255,255,0.08);font-size:0.7rem;text-align:center;margin-bottom:0.4rem;font-weight:500;';
        hintDiv.textContent = '💡 点击数字 或 滑动方向 移动';
        container.appendChild(hintDiv);

        var grid = document.createElement('div');
        grid.className = 'puzzle-grid';
        grid.id = 'puzzleGrid';
        container.appendChild(grid);

        puzzleState = puzzle.map(function(row) { return row.slice(); });

        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                var cell = document.createElement('div');
                cell.className = 'puzzle-cell';
                var val = puzzle[r][c];
                if (val === 0) {
                    cell.classList.add('empty');
                    cell.textContent = '';
                    puzzleEmptyRow = r;
                    puzzleEmptyCol = c;
                } else {
                    cell.textContent = val;
                    cell.dataset.row = r;
                    cell.dataset.col = c;
                    cell.addEventListener('click', function() {
                        if (gameState.isAnswered) return;
                        var row = parseInt(this.dataset.row);
                        var col = parseInt(this.dataset.col);
                        movePuzzleTile(row, col);
                    });
                }
                grid.appendChild(cell);
            }
        }

        setupPuzzleSwipe(grid);
        startTimer(60);
    }

    function setupPuzzleSwipe(grid) {
        var startX = 0, startY = 0, isDragging = false;
        grid.addEventListener('mousedown', function(e) {
            startX = e.clientX; startY = e.clientY; isDragging = true; e.preventDefault();
        });
        grid.addEventListener('mouseup', function(e) {
            if (!isDragging) return;
            isDragging = false;
            handleSwipe(e.clientX - startX, e.clientY - startY);
        });
        grid.addEventListener('mouseleave', function() { isDragging = false; });
        grid.addEventListener('touchstart', function(e) {
            var touch = e.touches[0];
            startX = touch.clientX; startY = touch.clientY; isDragging = true; e.preventDefault();
        }, { passive: false });
        grid.addEventListener('touchmove', function(e) { e.preventDefault(); }, { passive: false });
        grid.addEventListener('touchend', function(e) {
            if (!isDragging) return;
            isDragging = false;
            var touch = e.changedTouches[0];
            handleSwipe(touch.clientX - startX, touch.clientY - startY);
        });
    }

    function handleSwipe(dx, dy) {
        if (gameState.isAnswered) return;
        if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
        var targetRow = puzzleEmptyRow, targetCol = puzzleEmptyCol;
        if (Math.abs(dx) > Math.abs(dy)) {
            targetCol = dx > 0 ? puzzleEmptyCol - 1 : puzzleEmptyCol + 1;
        } else {
            targetRow = dy > 0 ? puzzleEmptyRow - 1 : puzzleEmptyRow + 1;
        }
        if (targetRow >= 0 && targetRow < 3 && targetCol >= 0 && targetCol < 3) {
            movePuzzleTile(targetRow, targetCol);
        }
    }

    function movePuzzleTile(row, col) {
        var dr = Math.abs(row - puzzleEmptyRow);
        var dc = Math.abs(col - puzzleEmptyCol);
        if ((dr === 1 && dc === 0) || (dr === 0 && dc === 1)) {
            puzzleState[puzzleEmptyRow][puzzleEmptyCol] = puzzleState[row][col];
            puzzleState[row][col] = 0;
            puzzleEmptyRow = row;
            puzzleEmptyCol = col;
            renderPuzzleState(puzzleState);
            if (checkPuzzleSolved(puzzleState)) {
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                handleAnswerResult(gameState.currentChallenge, true);
            }
        }
    }

    function renderPuzzleState(puzzle) {
        var cells = document.querySelectorAll('.puzzle-grid .puzzle-cell');
        var idx = 0;
        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                var val = puzzle[r][c];
                var cell = cells[idx];
                if (val === 0) {
                    cell.classList.add('empty');
                    cell.textContent = '';
                    cell.dataset.row = r; cell.dataset.col = c;
                    cell.onclick = null;
                } else {
                    cell.classList.remove('empty');
                    cell.textContent = val;
                    cell.dataset.row = r; cell.dataset.col = c;
                    cell.onclick = function() {
                        if (gameState.isAnswered) return;
                        var row = parseInt(this.dataset.row);
                        var col = parseInt(this.dataset.col);
                        movePuzzleTile(row, col);
                    };
                }
                idx++;
            }
        }
    }

    function checkPuzzleSolved(puzzle) {
        var expected = [[1,2,3],[4,5,6],[7,8,0]];
        for (var r = 0; r < 3; r++) {
            for (var c = 0; c < 3; c++) {
                if (puzzle[r][c] !== expected[r][c]) return false;
            }
        }
        return true;
    }

    // ============================================================
    // 1A2B 游戏
    // ============================================================
    function renderABGame(challenge) {
        var digitCount = challenge.digitCount || 4;
        var maxAttempts = challenge.maxAttempts || 15;
        var password = challenge.password || '';

        abState.password = password;
        abState.digitCount = digitCount;
        abState.maxAttempts = maxAttempts;
        abState.currentGuess = '';
        abState.attemptCount = 0;
        abState.history = [];
        abState.gameSolved = false;
        abState.isActive = true;

        var container = dom.gameContent;
        container.innerHTML = '';

        var ruleDiv = document.createElement('div');
        ruleDiv.style.cssText = 'background:rgba(139,92,246,0.04);border:1px solid rgba(139,92,246,0.04);border-radius:12px;padding:0.5rem 0.8rem;margin-bottom:0.5rem;width:100%;';
        ruleDiv.innerHTML = `
            <div style="color:rgba(255,255,255,0.2);font-size:0.75rem;display:flex;flex-wrap:wrap;gap:0.2rem 0.8rem;justify-content:center;font-weight:500;">
                <span>🎯 猜 <strong style="color:#8B5CF6;">${digitCount}</strong> 位不重复数字</span>
                <span style="color:rgba(255,255,255,0.05);">|</span>
                <span style="color:#28a745;">✅ <strong>A</strong> = 位置+数字都正确</span>
                <span style="color:#F59E0B;">🟡 <strong>B</strong> = 数字正确位置不对</span>
            </div>
        `;
        container.appendChild(ruleDiv);

        var displayDiv = document.createElement('div');
        displayDiv.className = 'ab-display';
        displayDiv.id = 'abDisplay';
        displayDiv.textContent = ' '.repeat(digitCount).split('').join(' ');
        container.appendChild(displayDiv);

        var statusDiv = document.createElement('div');
        statusDiv.className = 'ab-status';
        statusDiv.id = 'abStatus';
        statusDiv.innerHTML = '💡 剩余 <strong id="abAttempts">' + maxAttempts + '</strong> 次机会';
        container.appendChild(statusDiv);

        var historyDiv = document.createElement('div');
        historyDiv.className = 'ab-history';
        historyDiv.id = 'abHistory';
        historyDiv.textContent = '📝 输入你的猜测...';
        container.appendChild(historyDiv);

        // 3列键盘
        var keypadDiv = document.createElement('div');
        keypadDiv.className = 'ab-keypad';
        keypadDiv.id = 'abKeypad';
        var keypadRows = [
            ['1', '2', '3'],
            ['4', '5', '6'],
            ['7', '8', '9'],
            ['⌫', '0', '✅']
        ];
        keypadRows.forEach(function(row) {
            row.forEach(function(key) {
                var btn = document.createElement('button');
                btn.className = 'ab-key-btn';
                btn.textContent = key;
                btn.dataset.key = key;
                if (key === '⌫') btn.classList.add('key-backspace');
                else if (key === '✅') btn.classList.add('key-submit');
                else btn.classList.add('key-number');
                btn.addEventListener('click', function() { handleABKeyPress(key); });
                keypadDiv.appendChild(btn);
            });
        });
        container.appendChild(keypadDiv);

        function handlePhysicalKey(e) {
            if (!abState.isActive || abState.gameSolved || gameState.isAnswered) return;
            var key = e.key;
            if (key >= '0' && key <= '9') { e.preventDefault(); handleABKeyPress(key); }
            else if (key === 'Backspace' || key === 'Delete') { e.preventDefault(); handleABKeyPress('⌫'); }
            else if (key === 'Enter') { e.preventDefault(); handleABKeyPress('✅'); }
        }
        document.addEventListener('keydown', handlePhysicalKey);
        window._abCleanup = function() { document.removeEventListener('keydown', handlePhysicalKey); };

        startTimer(challenge.timeLimit || 200);
    }

    function handleABKeyPress(key) {
        if (!abState.isActive || abState.gameSolved || gameState.isAnswered) return;
        var digitCount = abState.digitCount, maxAttempts = abState.maxAttempts, password = abState.password;
        var displayEl = document.getElementById('abDisplay');
        var historyEl = document.getElementById('abHistory');
        var attemptsEl = document.getElementById('abAttempts');

        if (key === '⌫') {
            if (abState.currentGuess.length > 0) {
                abState.currentGuess = abState.currentGuess.slice(0, -1);
                updateABDisplay();
            }
            return;
        }

        if (key === '✅') {
            if (abState.currentGuess.length !== digitCount) {
                showToast('请完整输入 ' + digitCount + ' 位数字', 'error'); return;
            }
            if (new Set(abState.currentGuess).size !== abState.currentGuess.length) {
                showToast('数字不能重复！', 'error'); return;
            }
            if (abState.currentGuess[0] === '0') {
                showToast('第一位不能是0！', 'error'); return;
            }

            abState.attemptCount++;
            var remaining = maxAttempts - abState.attemptCount;
            attemptsEl.textContent = remaining;

            var passwordArr = password.split(''), guessArr = abState.currentGuess.split('');
            var a = 0, b = 0, matchedIndexes = [];
            for (var i = 0; i < digitCount; i++) {
                if (guessArr[i] === passwordArr[i]) { a++; matchedIndexes.push(i); }
            }
            var unmatchedPassword = [], unmatchedGuess = [];
            for (var i = 0; i < digitCount; i++) {
                if (matchedIndexes.indexOf(i) === -1) {
                    unmatchedPassword.push(passwordArr[i]);
                    unmatchedGuess.push(guessArr[i]);
                }
            }
            for (var g of unmatchedGuess) {
                var idx = unmatchedPassword.indexOf(g);
                if (idx !== -1) { b++; unmatchedPassword.splice(idx, 1); }
            }

            var resultText = a + 'A' + b + 'B';
            var guessDisplay = abState.currentGuess.split('').join(' ');
            var historyItem = guessDisplay + ' → ' + resultText;
            abState.history.push(historyItem);
            updateABHistory();

            if (a === digitCount) {
                abState.gameSolved = true;
                abState.isActive = false;
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                disableABKeyboard();
                var points = 10 + Math.floor(gameState.level / 5) + Math.max(0, maxAttempts - abState.attemptCount);
                showFeedback(true, points, '🎉 ' + abState.attemptCount + ' 次猜中！');
                gameState.score += points;
                gameState.combo++;
                gameState.passed++;
                if (gameState.combo > gameState.maxCombo) gameState.maxCombo = gameState.combo;
                updateUI();
                setTimeout(function() { gameState.level++; updateUI(); loadChallenge(); }, 2000);
                return;
            }

            if (remaining <= 0) {
                abState.isActive = false;
                gameState.isAnswered = true;
                clearInterval(gameState.timer);
                disableABKeyboard();
                showFeedback(false, 0, '💀 机会用尽！密码是 ' + password);
                gameState.combo = 0;
                gameState.lives--;
                updateUI();
                if (gameState.lives <= 0) { setTimeout(gameOver, 1500); } else { setTimeout(loadChallenge, 2000); }
                return;
            }

            abState.currentGuess = '';
            updateABDisplay();
            showToast('第 ' + abState.attemptCount + ' 次：' + resultText, 'info');
            return;
        }

        if (abState.currentGuess.length < digitCount) {
            if (abState.currentGuess.indexOf(key) !== -1) {
                showToast('数字不能重复！', 'error'); return;
            }
            if (abState.currentGuess.length === 0 && key === '0') {
                showToast('第一位不能是0！', 'error'); return;
            }
            abState.currentGuess += key;
            updateABDisplay();
        } else {
            showToast('已输入 ' + digitCount + ' 位，请点 ✅ 提交', 'info');
        }
    }

    function updateABDisplay() {
        var displayEl = document.getElementById('abDisplay');
        if (!displayEl) return;
        var displayText = abState.currentGuess.padEnd(abState.digitCount, ' ');
        displayEl.textContent = displayText.split('').join(' ');
    }

    function updateABHistory() {
        var historyEl = document.getElementById('abHistory');
        if (!historyEl) return;
        if (abState.history.length === 0) { historyEl.textContent = '📝 输入你的猜测...'; return; }
        var html = '', items = abState.history.slice(-6);
        for (var i = 0; i < items.length; i++) {
            var isCorrect = false;
            var parts = items[i].split('→');
            if (parts.length === 2) {
                var result = parts[1].trim();
                var match = result.match(/^(\d+)A(\d+)B$/);
                if (match) {
                    var aCount = parseInt(match[1]);
                    if (aCount === abState.digitCount) {
                        isCorrect = true;
                    }
                }
            }
            html += '<div class="history-item' + (isCorrect ? ' correct' : '') + '">🔹 ' + items[i] + '</div>';
        }
        historyEl.innerHTML = html;
        historyEl.scrollTop = historyEl.scrollHeight;
    }

    function disableABKeyboard() {
        document.querySelectorAll('.ab-key-btn').forEach(function(b) { b.disabled = true; });
    }

    // ============================================================
    // 找不同
    // ============================================================
    function renderFindDifferent(challenge) {
        var container = dom.gameContent;
        var displayTime = challenge.displayTime || 3;

        var textDiv = document.createElement('div');
        textDiv.className = 'display-text-container';
        textDiv.id = 'findDifferentDisplay';
        textDiv.innerHTML = '<div class="display-text" style="font-size:2.6rem;font-weight:bold;color:#8B5CF6;padding:1rem;margin:0.3rem 0;background:rgba(255,255,255,0.02);border-radius:14px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:10px;font-family:monospace;">' + challenge.originalDisplay + '</div>';
        container.appendChild(textDiv);

        dom.timerText.textContent = '⏱ 记忆 ' + displayTime + 's';
        dom.timerFill.style.width = '100%';
        dom.timerFill.className = 'timer-fill';

        var countdownInterval = setInterval(function() {
            displayTime--;
            dom.timerText.textContent = '⏱ 记忆 ' + displayTime + 's';
            var pct = (displayTime / (challenge.displayTime || 3)) * 100;
            dom.timerFill.style.width = pct + '%';
            if (pct < 30) dom.timerFill.classList.add('danger');
            else if (pct < 50) dom.timerFill.classList.add('warning');
            if (displayTime <= 0) {
                clearInterval(countdownInterval);
                var displayEl = document.getElementById('findDifferentDisplay');
                if (displayEl) {
                    var shuffled = challenge.shuffledDisplay || '';
                    var html = '';
                    for (var i = 0; i < shuffled.length; i++) {
                        var ch = shuffled[i];
                        html += '<span class="char-btn" data-index="' + i + '" data-char="' + ch + '" onclick="selectChar(' + i + ', \'' + ch + '\', this)">' + ch + '</span>';
                    }
                    displayEl.innerHTML = '<div class="display-text" style="padding:1rem;margin:0.3rem 0;background:rgba(255,255,255,0.02);border-radius:14px;border:1px solid rgba(255,255,255,0.04);text-align:center;letter-spacing:4px;">' + html + '</div>';
                    displayEl.dataset.correctAnswer = challenge.correctAnswer;
                    displayEl.dataset.shuffledPos = challenge.shuffledPos;
                    dom.timerText.textContent = '⏱ 选择';
                    startTimer(challenge.timeLimit || 10);
                }
            }
        }, 1000);
    }

    function selectChar(index, char, element) {
        if (gameState.isAnswered) return;
        var container = document.getElementById('findDifferentDisplay');
        if (!container) return;
        var shuffledPos = parseInt(container.dataset.shuffledPos);
        var isCorrect = (index === shuffledPos);
        var challenge = gameState.currentChallenge;

        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var allChars = container.querySelectorAll('.char-btn');
        allChars.forEach(function(el) {
            el.classList.add('disabled');
            el.onclick = null;
            if (parseInt(el.dataset.index) === shuffledPos) el.classList.add('correct-answer');
        });
        if (!isCorrect) {
            element.classList.add('wrong-answer');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    // ============================================================
    // 数字记忆
    // ============================================================
    function renderMemoryGame(challenge) {
        var container = dom.gameContent;
        var memoryTime = challenge.memoryTime || 5;
        var timeLimit = challenge.timeLimit || 15;
        var correctAnswer = challenge.correctAnswer || '';

        container.innerHTML = '';

        var displayDiv = document.createElement('div');
        displayDiv.id = 'memoryDisplay';
        displayDiv.style.cssText = 'font-size:3.2rem;font-weight:bold;color:#8B5CF6;padding:1.5rem;margin:0.3rem 0;background:rgba(139,92,246,0.03);border-radius:14px;border:1px solid rgba(139,92,246,0.04);text-align:center;letter-spacing:16px;font-family:monospace;';
        displayDiv.textContent = challenge.displayNumber || '';
        container.appendChild(displayDiv);

        var statusDiv = document.createElement('div');
        statusDiv.id = 'memoryStatus';
        statusDiv.style.cssText = 'color:rgba(255,255,255,0.12);font-size:0.8rem;text-align:center;margin:0.1rem 0 0.3rem;font-weight:500;';
        statusDiv.textContent = '⏱ 记忆 ' + memoryTime + 's';
        container.appendChild(statusDiv);

        var inputDiv = document.createElement('div');
        inputDiv.className = 'memory-input-display';
        inputDiv.id = 'memoryInputDisplay';
        inputDiv.style.display = 'none';
        inputDiv.textContent = '_ '.repeat(correctAnswer.length).trim();
        container.appendChild(inputDiv);

        var keyboardDiv = document.createElement('div');
        keyboardDiv.className = 'memory-keyboard';
        keyboardDiv.id = 'memoryKeyboard';
        keyboardDiv.style.display = 'none';

        var keyboardRows = challenge.keyboardRows || [['1','2','3'],['4','5','6'],['7','8','9'],['','0','⌫']];
        keyboardRows.forEach(function(row) {
            row.forEach(function(key) {
                if (!key) { var empty = document.createElement('div'); keyboardDiv.appendChild(empty); return; }
                var btn = document.createElement('button');
                btn.className = 'key-btn';
                if (key === '⌫') {
                    btn.classList.add('backspace');
                    btn.textContent = '⌫';
                    btn.addEventListener('click', function() { if (gameState.isAnswered) return; memoryBackspace(); });
                } else {
                    btn.textContent = key;
                    btn.addEventListener('click', function() { if (gameState.isAnswered) return; memoryKeyPress(key); });
                }
                keyboardDiv.appendChild(btn);
            });
        });
        container.appendChild(keyboardDiv);

        var controlsDiv = document.createElement('div');
        controlsDiv.className = 'memory-controls';
        controlsDiv.innerHTML = '<button class="btn-memory submit" id="memorySubmitBtn" style="display:none;" onclick="submitMemoryAnswer()">✅ 确认</button>';
        container.appendChild(controlsDiv);

        var memoryState = { input: '', correctAnswer: correctAnswer, isActive: true, isMemorizing: true };
        window._memoryState = memoryState;

        var memInterval = setInterval(function() {
            memoryTime--;
            var statusEl = document.getElementById('memoryStatus');
            if (statusEl) statusEl.textContent = '⏱ 记忆 ' + memoryTime + 's';
            var pct = (memoryTime / (challenge.memoryTime || 5)) * 100;
            dom.timerFill.style.width = Math.max(0, Math.min(100, pct)) + '%';
            if (pct < 30) dom.timerFill.classList.add('danger');
            else if (pct < 50) dom.timerFill.classList.add('warning');
            else dom.timerFill.classList.remove('danger', 'warning');

            if (memoryTime <= 0) {
                clearInterval(memInterval);
                var displayEl = document.getElementById('memoryDisplay');
                if (displayEl) {
                    displayEl.textContent = '✏️ 输入你记住的数字';
                    displayEl.style.color = 'rgba(255,255,255,0.25)';
                    displayEl.style.fontSize = '1.3rem';
                    displayEl.style.letterSpacing = 'normal';
                    displayEl.style.padding = '1rem';
                }
                var statusEl = document.getElementById('memoryStatus');
                if (statusEl) {
                    statusEl.textContent = '⌨️ 输入你记住的数字';
                    statusEl.style.color = 'rgba(255,255,255,0.06)';
                }
                document.getElementById('memoryInputDisplay').style.display = 'block';
                document.getElementById('memoryKeyboard').style.display = 'grid';
                document.getElementById('memorySubmitBtn').style.display = 'inline-block';
                memoryState.isMemorizing = false;
                dom.timerText.textContent = '⏱ ' + timeLimit + 's';
                dom.timerFill.style.width = '100%';
                dom.timerFill.className = 'timer-fill';
                startTimer(timeLimit);
            }
        }, 1000);
    }

    function memoryKeyPress(value) {
        if (gameState.isAnswered) return;
        var state = window._memoryState;
        if (!state || !state.isActive || state.isMemorizing) return;
        var len = state.correctAnswer.length;
        if (state.input.length >= len) return;
        state.input += value;
        updateMemoryDisplay(state);
    }

    function memoryBackspace() {
        if (gameState.isAnswered) return;
        var state = window._memoryState;
        if (!state || !state.isActive || state.isMemorizing) return;
        if (state.input.length > 0) {
            state.input = state.input.slice(0, -1);
            updateMemoryDisplay(state);
        }
    }

    function updateMemoryDisplay(state) {
        var display = document.getElementById('memoryInputDisplay');
        if (!display) return;
        var len = state.correctAnswer.length;
        var text = '';
        for (var i = 0; i < len; i++) {
            text += (i < state.input.length ? state.input[i] : '_') + ' ';
        }
        display.textContent = text.trim();
    }

    function submitMemoryAnswer() {
        if (gameState.isAnswered) return;
        var state = window._memoryState;
        if (!state) return;
        if (state.input.length !== state.correctAnswer.length) {
            showToast('请完整输入所有数字', 'error'); return;
        }
        var isCorrect = state.input === state.correctAnswer;
        var challenge = gameState.currentChallenge;
        document.querySelectorAll('.memory-keyboard .key-btn').forEach(function(b) { b.disabled = true; });
        document.getElementById('memorySubmitBtn').disabled = true;
        state.isActive = false;
        handleAnswerResult(challenge, isCorrect);
    }

    // ============================================================
    // 提交答案
    // ============================================================
    function submitAnswer(challenge, answer, btn) {
        if (gameState.isAnswered) return;
        var isCorrect = answer === challenge.correctAnswer;
        var container = dom.gameContent;
        container.querySelectorAll('.option-btn').forEach(function(b) {
            b.disabled = true;
            if (b.dataset.answer === challenge.correctAnswer) b.classList.add('correct');
        });
        if (!isCorrect) {
            btn.classList.add('wrong');
            dom.challengeCard.classList.add('shake');
            setTimeout(function() { dom.challengeCard.classList.remove('shake'); }, 500);
        }
        handleAnswerResult(challenge, isCorrect);
    }

    // ============================================================
    // 处理答案结果
    // ============================================================
    function handleAnswerResult(challenge, isCorrect) {
        gameState.isAnswered = true;
        clearInterval(gameState.timer);

        var points = 0;
        if (isCorrect) {
            var bonus = Math.min(gameState.combo, 10);
            points = 10 + Math.floor(gameState.level / 5) + bonus * 2;
            gameState.score += points;
            gameState.combo++;
            gameState.passed++;
            if (gameState.combo > gameState.maxCombo) gameState.maxCombo = gameState.combo;
            showFeedback(true, points, challenge.funMessage);
            gameState.level++;
            SoundFX.play('correct');
        } else {
            gameState.combo = 0;
            gameState.lives--;
            showFeedback(false, 0, '');
            SoundFX.play('wrong');
        }

        updateUI();

        if (gameState.lives <= 0) {
            SoundFX.play('gameover');
            setTimeout(gameOver, 1500);
            return;
        }
        setTimeout(function() { loadChallenge(); }, 1800);
    }

    // ============================================================
    // 计时器
    // ============================================================
    function startTimer(limit) {
        clearInterval(gameState.timer);
        gameState.timeLeft = limit || 15;
        updateTimerDisplay(limit || 15);

        gameState.timer = setInterval(function() {
            gameState.timeLeft--;
            updateTimerDisplay(limit || 15);
            if (gameState.timeLeft <= 0) {
                clearInterval(gameState.timer);
                if (!gameState.isAnswered) {
                    gameState.isAnswered = true;
                    disableAllInteractions();
                    gameState.combo = 0;
                    gameState.lives--;
                    updateUI();
                    showFeedback(false, 0, '⏱ 时间到！');
                    SoundFX.play('timeout');
                    if (gameState.lives <= 0) {
                        SoundFX.play('gameover');
                        setTimeout(gameOver, 1200);
                    } else {
                        setTimeout(function() { loadChallenge(); }, 1500);
                    }
                }
            }
            if (gameState.timeLeft <= 5 && gameState.timeLeft > 0 && !gameState.isAnswered) {
                SoundFX.play('tick');
            }
        }, 1000);
    }

    function updateTimerDisplay(limit) {
        var pct = (gameState.timeLeft / Math.max(1, limit || 15)) * 100;
        dom.timerFill.style.width = Math.max(0, Math.min(100, pct)) + '%';
        dom.timerText.textContent = '⏱ ' + gameState.timeLeft + 's';
        dom.timerFill.className = 'timer-fill';
        if (pct < 30) dom.timerFill.classList.add('danger');
        else if (pct < 50) dom.timerFill.classList.add('warning');
    }

    function disableAllInteractions() {
        var container = dom.gameContent;
        container.querySelectorAll('.option-btn').forEach(function(b) { b.disabled = true; });
        container.querySelectorAll('.color-option').forEach(function(el) { el.classList.add('disabled'); });
        container.querySelectorAll('.ab-key-btn').forEach(function(b) { b.disabled = true; });
        container.querySelectorAll('.puzzle-cell').forEach(function(cell) { cell.onclick = null; });
        container.querySelectorAll('.char-btn').forEach(function(el) { el.classList.add('disabled'); el.onclick = null; });
        container.querySelectorAll('.key-btn').forEach(function(b) { b.disabled = true; });
        document.getElementById('memorySubmitBtn')?.setAttribute('disabled', 'disabled');
    }

    // ============================================================
    // 反馈
    // ============================================================
    function showFeedback(isCorrect, points, funMessage) {
        var el = dom.feedback;
        el.style.display = 'block';
        el.className = 'feedback show ' + (isCorrect ? 'correct' : 'wrong');
        if (isCorrect) {
            el.innerHTML = '✅ 答对了！ +' + points + ' 分' +
                (funMessage ? '<div class="fun-message">' + funMessage + '</div>' : '');
        } else {
            el.innerHTML = '❌ ' + (funMessage || '答错了！连击中断');
        }
    }

    // ============================================================
    // UI 更新
    // ============================================================
    function updateUI() {
        dom.levelDisplay.textContent = gameState.level;
        dom.scoreDisplay.textContent = gameState.score;
        dom.comboDisplay.textContent = gameState.combo;
        dom.passedDisplay.textContent = gameState.passed;
        var hearts = '❤️'.repeat(gameState.lives) + '🖤'.repeat(Math.max(0, 3 - gameState.lives));
        dom.livesDisplay.textContent = hearts || '💀';
        var progress = (gameState.passed / gameState.totalLevels) * 100;
        dom.progressFill.style.width = Math.min(progress, 100) + '%';
    }

    function getDifficultyLabel(level) {
        if (level >= 81) return '👑 传说';
        if (level >= 61) return '💀 地狱';
        if (level >= 41) return '🔥 噩梦';
        if (level >= 21) return '⚡ 困难';
        return '📝 入门';
    }

    // ============================================================
    // Toast
    // ============================================================
    function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + (type || 'info');
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }

    // ============================================================
    // 游戏结束
    // ============================================================
    function gameOver() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);
        var currentScore = gameState.score;
        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">${currentScore > 50 ? '🏆' : '💪'}</div>
                <div class="title">${currentScore > 50 ? '🎉 挑战结束！' : '😅 继续加油！'}</div>
                <div class="sub">你成功通过了 ${gameState.passed} 关</div>
                <div style="font-size:0.85rem;color:rgba(255,255,255,0.1);margin-bottom:0.2rem;">本局得分</div>
                <div class="final-score" id="finalScoreDisplay">${currentScore}</div>
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.06);margin-top:-0.2rem;margin-bottom:0.3rem;">🔄 正在保存最高分...</div>
                <div class="stats-grid">
                    <div class="stat-item"><div class="stat-value">${gameState.passed}</div><div class="stat-label">通关</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.maxCombo}</div><div class="stat-label">最高连击</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.level - 1}</div><div class="stat-label">到达关卡</div></div>
                </div>
                <button class="btn-restart" onclick="restartGame()">🔄 再来一次</button>
            </div>
        `;
        saveAndShowRanking();
    }

    // ============================================================
    // 通关
    // ============================================================
    function gameWin() {
        gameState.isPlaying = false;
        clearInterval(gameState.timer);
        var currentScore = gameState.score;
        dom.challengeCard.innerHTML = `
            <div class="game-over">
                <div class="big-icon">👑</div>
                <div class="title">🎉 恭喜通关！</div>
                <div class="sub">你通过了全部 100 关！</div>
                <div style="font-size:0.85rem;color:rgba(255,255,255,0.1);margin-bottom:0.2rem;">本局得分</div>
                <div class="final-score" id="finalScoreDisplay">${currentScore}</div>
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.06);margin-top:-0.2rem;margin-bottom:0.3rem;">🔄 正在保存最高分...</div>
                <div class="stats-grid">
                    <div class="stat-item"><div class="stat-value">100</div><div class="stat-label">通关</div></div>
                    <div class="stat-item"><div class="stat-value">${gameState.maxCombo}</div><div class="stat-label">最高连击</div></div>
                    <div class="stat-item"><div class="stat-value">🏆</div><div class="stat-label">传说</div></div>
                </div>
                <button class="btn-restart" onclick="restartGame()">🔄 再来一次</button>
            </div>
        `;
        saveAndShowRanking();
    }

    // ============================================================
    // 保存分数并显示最高分
    // ============================================================
    function saveAndShowRanking() {
        var currentScore = gameState.score;
        fetch('/VerifyGame/SaveScore', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: 'score=' + currentScore + '&level=' + gameState.level + '&maxCombo=' + gameState.maxCombo + '&passed=' + gameState.passed
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                return fetch('/VerifyGame/GetUserScore');
            }
            return null;
        })
        .then(function(r) {
            if (r) return r.json();
            return null;
        })
        .then(function(data) {
            if (data && data.success) {
                var scoreEl = document.getElementById('finalScoreDisplay');
                if (scoreEl) {
                    scoreEl.textContent = data.totalScore;
                    var loadingEl = document.querySelector('.game-over .sub + div');
                    if (loadingEl) {
                        loadingEl.textContent = '🏆 历史最高分';
                        loadingEl.style.color = 'rgba(255,255,255,0.15)';
                    }
                }
            }
            loadRanking();
        })
        .catch(function() {
            loadRanking();
        });
    }

    function restartGame() { renderStartScreen(); gameState.isPlaying = false; if (gameState.timer) { clearInterval(gameState.timer); } }

    // ============================================================
    // 排行榜（游戏内）
    // ============================================================
    function loadRanking() {
        var userId = @(Context.Session.GetInt32("UserId") ?? 0);
        fetch('/VerifyGame/GetRanking')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var container = dom.rankList;
                var section = dom.rankSection;
                if (data.success && data.data && data.data.length > 0) {
                    var html = '', medals = ['🥇', '🥈', '🥉'];
                    data.data.forEach(function(item, index) {
                        var medal = index < 3 ? medals[index] : '#' + (index + 1);
                        var avatarHtml = item.avatarUrl && item.isAvatarApproved ?
                            '<img src="' + item.avatarUrl + '" class="rank-avatar" />' :
                            '<div class="rank-avatar-placeholder">' + (item.username ? item.username.charAt(0).toUpperCase() : '?') + '</div>';
                        var isMe = item.isMe || false;
                        html += '<div class="rank-item">' +
                            '<span class="rank-medal">' + medal + '</span>' +
                            avatarHtml +
                            '<span class="rank-name">' + item.username + (isMe ? ' <span class="me">(我)</span>' : '') + '</span>' +
                            '<span class="rank-score">' + item.totalPoints + '</span>' +
                            '</div>';
                    });
                    container.innerHTML = html;
                    section.style.display = 'block';
                } else {
                    container.innerHTML = '<div class="rank-empty">暂无排行数据<br>快来挑战吧！</div>';
                    section.style.display = 'block';
                }
            })
            .catch(function() {
                dom.rankList.innerHTML = '<div class="rank-empty">加载排行榜失败</div>';
                dom.rankSection.style.display = 'block';
            });
    }

    // ============================================================
    // 启动
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        SoundFX.init();
        renderStartScreen();
    });
</script>
