        document.body.appendChild(overlay);
    }

    // ============================================================
    // 语音识别服务
    // ============================================================
    var VoiceService = {
        recognition: null,
        isListening: false,
        transcript: '',
        interimTranscript: '',
        isProcessing: false,
        restartTimer: null,
        lastActivity: Date.now(),

        commands: {
            confirm: ['确认', '确定', '是的', '对', '好', '可以', '提交', '回车', '就这个', '就是它', '没错'],
            cancel: ['取消', '算了', '不要', '不对', '错了', '后退', '返回', '撤销', '重选'],
            next: ['下一题', '下一关', '继续', '下一个', '再来', '下一步', '跳过', '下一题'],
            backspace: ['删除', '退格', '回退', '清除', '擦掉', '去掉'],
            select: ['选', '选择', '这个', '那个', '就这个', '就它', '我要选'],
            help: ['帮助', '怎么玩', '说明', '提示', '救命', '不会'],
            restart: ['重来', '重新开始', '再来一次', '重新']
        },

        numberMap: {
            '零': '0', '一': '1', '二': '2', '三': '3', '四': '4',
            '五': '5', '六': '6', '七': '7', '八': '8', '九': '9',
            '两': '2', '俩': '2', '十': '10'
        },

        init: function() {
            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                showToast('⚠️ 您的浏览器不支持语音识别', 'error');
                return false;
            }
            this.recognition = new SpeechRecognition();
            this.recognition.lang = 'zh-CN';
            this.recognition.continuous = true;
            this.recognition.interimResults = true;
            this.recognition.maxAlternatives = 5;
            return true;
        },

        start: function() {
            if (!this.recognition) { if (!this.init()) return; }
            if (this.isListening) return;
            try {
                this.recognition.start();
                this.isListening = true;
                this.lastActivity = Date.now();
                this.transcript = '';
                this.interimTranscript = '';
                updateVoiceUI('listening', '🎤 正在听...');
                this.restartTimer = setInterval(function() {
                    if (Date.now() - VoiceService.lastActivity > 30000) { VoiceService.restart(); }
                }, 5000);
            } catch(e) {
                setTimeout(function() { VoiceService.start(); }, 500);
            }
        },

        restart: function() {
            if (!this.isListening) return;
            try { this.stop(); setTimeout(function() { VoiceService.start(); }, 300); } catch(e) {}
        },

        stop: function() {
            if (this.restartTimer) { clearInterval(this.restartTimer); this.restartTimer = null; }
            this.isListening = false;
            try { this.recognition.stop(); } catch(e) {}
            updateVoiceUI('idle', '🎤 语音已暂停');
        },

        setupEvents: function() {
            var self = this;
            this.recognition.onstart = function() { self.isListening = true; updateVoiceUI('listening', '🎤 正在听...'); };
            this.recognition.onend = function() {
                if (self.isListening) { setTimeout(function() { VoiceService.start(); }, 500); }
                else { updateVoiceUI('idle', '🎤 语音已暂停'); }
            };
            this.recognition.onerror = function(event) {
                if (event.error === 'not-allowed') {
                    showToast('⚠️ 麦克风权限被拒绝', 'error');
                    updateVoiceUI('error', '🚫 麦克风被拒绝');
                    self.isListening = false;
                } else if (event.error === 'no-speech') {
                    updateVoiceUI('listening', '🎤 请说话...');
                } else {
                    updateVoiceUI('listening', '🎤 继续监听...');
                }
            };
            this.recognition.onresult = function(event) {
                self.lastActivity = Date.now();
                var finalText = '', interimText = '';
                for (var i = event.resultIndex; i < event.results.length; i++) {
                    var result = event.results[i];
                    var text = result[0].transcript.trim();
                    if (result.isFinal) { finalText += text; }
                    else { interimText += text; }
                }
                if (interimText) {
                    self.interimTranscript = interimText;
                    updateVoiceUI('listening', '🎤 识别中: ' + interimText, interimText);
                }
                if (finalText) {
                    self.transcript = finalText;
                    self.interimTranscript = '';
                    updateVoiceUI('listening', '🎤 已识别: ' + finalText, finalText);
                    self.processCommand(finalText);
                }
            };
        },

        processCommand: function(text) {
            if (this.isProcessing) return;
            this.isProcessing = true;
            this.lastActivity = Date.now();
            var normalized = text.replace(/[，。、！？\s]/g, '');

            // 1. 检查控制指令
            if (this.matchCommand(normalized)) { this.isProcessing = false; return; }

            // 2. 检查数字匹配
            var numberResult = this.matchNumber(normalized);
            if (numberResult !== null) { this.isProcessing = false; return; }

            // 3. 检查选项匹配
            if (this.matchOption(normalized)) { this.isProcessing = false; return; }

            // 4. 检查内容匹配
            if (this.matchContent(normalized)) { this.isProcessing = false; return; }

            this.isProcessing = false;
        },

        matchCommand: function(text) {
            var cmds = [
                { list: this.commands.confirm, action: 'confirm' },
                { list: this.commands.cancel, action: 'cancel' },
                { list: this.commands.next, action: 'next' },
                { list: this.commands.backspace, action: 'backspace' },
                { list: this.commands.select, action: 'select' },
                { list: this.commands.help, action: 'help' },
                { list: this.commands.restart, action: 'restart' }
            ];
            for (var c of cmds) {
                for (var cmd of c.list) {
                    if (text.includes(cmd)) { this.executeCommand(c.action); return true; }
                }
            }
            return false;
        },

        executeCommand: function(cmd) {
            switch(cmd) {
                case 'confirm': this.handleConfirm(); break;
                case 'cancel': this.handleCancel(); break;
                case 'next': this.handleNext(); break;
                case 'backspace': this.handleBackspace(); break;
                case 'select': this.handleSelect(); break;
                case 'help': this.handleHelp(); break;
                case 'restart': this.handleRestart(); break;
            }
        },

        handleConfirm: function() {
            if (gameState.isAnswered || !gameState.isPlaying) return;
            var highlighted = document.querySelector('.option-btn.highlight, .color-option.highlight, .char-btn.highlight');
            if (highlighted) {
                highlighted.click();
                showToast('✅ 已确认选择', 'success');
            } else {
                var submitBtn = document.getElementById('memorySubmitBtn');
                if (submitBtn && !submitBtn.disabled) { submitBtn.click(); }
                else { showToast('请先选择或输入答案', 'info'); }
            }
        },

        handleCancel: function() {
            document.querySelectorAll('.option-btn.highlight, .color-option.highlight, .char-btn.highlight')
                .forEach(function(el) { el.classList.remove('highlight'); });
            showToast('已取消选择', 'info');
        },

        handleNext: function() {
            if (gameState.isAnswered) { loadChallenge(); }
            else if (gameState.isGameOver) { restartGame(); }
            else { showToast('请先完成当前题目', 'info'); }
        },

        handleBackspace: function() {
            if (window._memoryState && !window._memoryState.isMemorizing) { memoryBackspace(); }
            if (abState && abState.isActive) { handleABKeyPress('⌫'); }
        },

        handleSelect: function() {
            showToast('请说出要选择的选项', 'info');
            document.querySelectorAll('.option-btn, .color-option, .char-btn').forEach(function(el) {
                if (!el.disabled) { el.style.borderColor = 'rgba(139,92,246,0.2)'; }
            });
            setTimeout(function() {
                document.querySelectorAll('.option-btn, .color-option, .char-btn').forEach(function(el) {
                    el.style.borderColor = '';
                });
            }, 3000);
        },

        handleHelp: function() { showTutorial(); },

        handleRestart: function() {
            if (confirm('确定要重新开始吗？当前进度将丢失。')) { restartGame(); }
        },

        matchNumber: function(text) {
            var numbers = text.match(/\d+/g);
            if (numbers && numbers.length > 0) { return numbers[0]; }
            for (var key in this.numberMap) {
                if (text.includes(key)) { return this.numberMap[key]; }
            }
            return null;
        },

        matchOption: function(text) {
            var patterns = [
                { regex: /选([一二三四五六七八九十])/, handler: function(m) { return this.chineseToNumber(m[1]); } },
                { regex: /选(\d+)/, handler: function(m) { return parseInt(m[1]) - 1; } },
                { regex: /第([一二三四五六七八九十])个/, handler: function(m) { return this.chineseToNumber(m[1]) - 1; } },
                { regex: /第(\d+)个/, handler: function(m) { return parseInt(m[1]) - 1; } },
                { regex: /([A-D])/, handler: function(m) { return m[1].charCodeAt(0) - 65; } }
            ];
            for (var p of patterns) {
                var match = text.match(p.regex);
                if (match) {
                    var index = p.handler.call(this, match);
                    if (index !== null && index >= 0) {
                        this.selectOptionByIndex(index);
                        return true;
                    }
                }
            }
            return false;
        },

        chineseToNumber: function(ch) {
            var map = { '一':1, '二':2, '三':3, '四':4, '五':5, '六':6, '七':7, '八':8, '九':9, '十':10 };
            return map[ch] || null;
        },

        selectOptionByIndex: function(index) {
            var options = document.querySelectorAll('.option-btn:not(.disabled), .color-option:not(.disabled)');
            if (index < options.length) {
                options[index].classList.add('highlight');
                showToast('已高亮选项 ' + (index + 1) + '，请说"确认"提交', 'info');
                options[index].scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
        },

        matchContent: function(text) {
            var options = document.querySelectorAll('.option-btn:not(.disabled), .color-option:not(.disabled)');
            var bestMatch = null, bestScore = 0;

            for (var opt of options) {
                var optText = opt.textContent.replace(/^[A-D]\.\s*/, '').trim();
                var score = this.fuzzyMatch(text, optText);
                if (score > bestScore) { bestScore = score; bestMatch = opt; }
            }

            if (bestMatch && bestScore >= 0.25) {
                bestMatch.classList.add('highlight');
                showToast('🔍 已匹配: ' + bestMatch.textContent.trim(), 'info');
                if (bestScore >= 0.7) {
                    setTimeout(function() {
                        if (bestMatch && !bestMatch.disabled) { bestMatch.click(); }
                    }, 800);
                }
                return true;
            }

            // 没匹配到，提示用户
            showToast('🔊 没找到 "' + text + '"，请再说一次或手动选择', 'warning');
            // 高亮所有选项引导
            document.querySelectorAll('.option-btn:not(.disabled), .color-option:not(.disabled)').forEach(function(el) {
                el.style.borderColor = 'rgba(139,92,246,0.15)';
                setTimeout(function() { el.style.borderColor = ''; }, 2000);
            });
            return false;
        },

        fuzzyMatch: function(input, target) {
            if (!input || !target) return 0;
            input = input.toLowerCase();
            target = target.toLowerCase();
            if (input === target) return 1;
            if (target.includes(input)) return 0.85;
            if (input.includes(target)) return 0.7;

            var dist = this.levenshtein(input, target);
            var maxLen = Math.max(input.length, target.length);
            if (maxLen === 0) return 0;
            return 1 - (dist / maxLen);
        },

        levenshtein: function(a, b) {
            if (a.length === 0) return b.length;
            if (b.length === 0) return a.length;
            var matrix = [];
            for (var i = 0; i <= b.length; i++) { matrix[i] = [i]; }
            for (var j = 0; j <= a.length; j++) { matrix[0][j] = j; }
            for (var i = 1; i <= b.length; i++) {
                for (var j = 1; j <= a.length; j++) {
                    if (b[i-1] === a[j-1]) {
                        matrix[i][j] = matrix[i-1][j-1];
                    } else {
                        matrix[i][j] = Math.min(matrix[i-1][j-1] + 1, matrix[i][j-1] + 1, matrix[i-1][j] + 1);
                    }
                }
            }
            return matrix[b.length][a.length];
        }
    };

    // ============================================================
    // 语音UI更新
    // ============================================================
    function updateVoiceUI(status, text, transcript) {
        var statusBar = document.querySelector('.voice-status-bar');
        if (!statusBar) {
            var container = document.getElementById('gameContent');
            if (!container) return;
            var bar = document.createElement('div');
            bar.className = 'voice-status-bar';
            bar.id = 'voiceStatusBar';
