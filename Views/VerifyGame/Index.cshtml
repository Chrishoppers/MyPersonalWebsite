    // ============================================================
    // Toast
    // ============================================================
    function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + (type || 'info');
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }

    // ============================================================
    // 游戏结束
    // ============================================================
    function gameOver() {
        gameState.isPlaying = false;
        gameState.isGameOver = true;
        clearInterval(gameState.timer);
        if (VoiceService.isListening) VoiceService.stop();

        var currentScore = gameState.score;
        document.getElementById('challengeCard').innerHTML = '';
        document.getElementById('gameContent').innerHTML = '';

        var finalScore = currentScore
            - (gameState.cheatCount * gameState.penaltyCheat)
            - (gameState.passed * gameState.penaltyMic);
        finalScore = Math.max(0, finalScore);

        var card = document.getElementById('challengeCard');
        card.innerHTML = `
            <div class="game-over" style="width:100%;">
                <div class="big-icon">${finalScore > 50 ? '🏆' : '💪'}</div>
                <div class="title">${finalScore > 50 ? '🎉 挑战结束！' : '😅 继续加油！'}</div>
                <div class="sub">你成功通过了 ${gameState.passed} 关</div>
                <div style="font-size:0.8rem;color:rgba(255,255,255,0.1);margin-bottom:0.1rem;">本局得分</div>
                <div class="final-score" id="finalScoreDisplay">${finalScore}</div>
                <div class="penalty-detail">
                    ${gameState.cheatCount > 0 ? '⚖️ 作弊扣分: -' + (gameState.cheatCount * gameState.penaltyCheat) + ' 分' : ''}
                    ${!gameState.micEnabled ? '🔇 麦克风关闭: -' + (gameState.passed * gameState.penaltyMic) + ' 分' : ''}
