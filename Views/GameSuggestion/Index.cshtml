@model List<MyPersonalWebsite.Models.SuggestionViewModel>

@{
    ViewData["Title"] = "💡 游戏建议";
    var userId = ViewBag.CurrentUserId as int?;
    var username = ViewBag.Username as string;
}

<style>
    .suggestion-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
    }

    .suggestion-header {
        text-align: center;
        padding: 1.5rem 0 1rem;
    }

    .suggestion-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #F59E0B 0%, #F97316 50%, #EC4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .suggestion-header .subtitle {
        color: rgba(255,255,255,0.3);
        font-size: 0.9rem;
    }

    /* 提交表单 */
    .submit-card {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 24px;
        padding: 1.8rem 2rem;
        margin-bottom: 2rem;
    }

    .submit-card .form-row {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .submit-card .form-row input {
        flex: 2;
        min-width: 180px;
        padding: 0.8rem 1.2rem;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #fff;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
    }

    .submit-card .form-row input:focus {
        border-color: rgba(245,158,11,0.2);
        background: rgba(255,255,255,0.05);
    }

    .submit-card .form-row input::placeholder {
        color: rgba(255,255,255,0.15);
    }

    .submit-card .form-row textarea {
        flex: 3;
        min-width: 200px;
        padding: 0.8rem 1.2rem;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #fff;
        font-size: 0.95rem;
        outline: none;
        resize: vertical;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .submit-card .form-row textarea:focus {
        border-color: rgba(245,158,11,0.2);
        background: rgba(255,255,255,0.05);
    }

    .submit-card .form-row textarea::placeholder {
        color: rgba(255,255,255,0.15);
    }

    .btn-submit-suggestion {
        padding: 0.8rem 2rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #F59E0B, #F97316);
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 100px;
        white-space: nowrap;
    }

    .btn-submit-suggestion:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(245,158,11,0.2);
    }

    .btn-submit-suggestion:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .submit-card .hint-text {
        color: rgba(255,255,255,0.08);
        font-size: 0.7rem;
        margin-top: 0.5rem;
    }

    /* 建议列表 */
    .suggestion-item {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1.2rem 1.5rem;
        margin-bottom: 0.8rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        transition: all 0.3s ease;
    }

    .suggestion-item:hover {
        background: rgba(255,255,255,0.04);
    }

    .suggestion-item .vote-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 50px;
        padding-right: 0.5rem;
    }

    .suggestion-item .vote-section .vote-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        color: rgba(255,255,255,0.1);
        padding: 0.1rem 0.3rem;
    }

    .suggestion-item .vote-section .vote-btn:hover {
        color: #F59E0B;
        transform: scale(1.1);
    }

    .suggestion-item .vote-section .vote-btn.voted {
        color: #F59E0B;
    }

    .suggestion-item .vote-section .vote-count {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
    }

    .suggestion-item .vote-section .vote-label {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.15);
    }

    .suggestion-item .content {
        flex: 1;
    }

    .suggestion-item .content .game-name {
        font-size: 1.1rem;
        font-weight: 600;
        color: #fff;
    }

    .suggestion-item .content .description {
        color: rgba(255,255,255,0.4);
        font-size: 0.9rem;
        margin-top: 0.1rem;
        line-height: 1.5;
    }

    .suggestion-item .content .meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-top: 0.4rem;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.15);
    }

    .suggestion-item .content .meta .user {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .suggestion-item .content .meta .user .avatar-small {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .suggestion-item .content .meta .user .avatar-placeholder-small {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(139,92,246,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.5rem;
        font-weight: 600;
        color: rgba(255,255,255,0.3);
    }

    .suggestion-item .content .meta .status-badge {
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        font-size: 0.6rem;
        font-weight: 500;
    }

    .status-pending {
        background: rgba(255,193,7,0.1);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.06);
    }

    .status-approved {
        background: rgba(40,167,69,0.1);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.06);
    }

    .status-developing {
        background: rgba(79,172,254,0.1);
        color: #4facfe;
        border: 1px solid rgba(79,172,254,0.06);
    }

    .status-completed {
        background: rgba(139,92,246,0.1);
        color: #8B5CF6;
        border: 1px solid rgba(139,92,246,0.06);
    }

    .status-rejected {
        background: rgba(220,53,69,0.08);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,0.04);
    }

    /* 管理员操作 */
    .admin-actions {
        display: flex;
        gap: 0.3rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
    }

    .admin-actions select {
        padding: 0.15rem 0.5rem;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #e0e0e0;
        font-size: 0.7rem;
        outline: none;
    }

    .admin-actions select option {
        background: #1a1a2e;
        color: #e0e0e0;
    }

    .admin-actions .btn-sm {
        padding: 0.15rem 0.6rem;
        border: none;
        border-radius: 20px;
        font-size: 0.6rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .admin-actions .btn-sm.danger {
        background: rgba(220,53,69,0.08);
        color: #dc3545;
    }

    .admin-actions .btn-sm.danger:hover {
        background: rgba(220,53,69,0.15);
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: rgba(255,255,255,0.1);
    }

    .empty-state .icon {
        font-size: 3rem;
        margin-bottom: 0.5rem;
        opacity: 0.3;
        display: block;
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@media (max-width: 640px) {
        .suggestion-header h1 { font-size: 1.6rem; }
        .submit-card { padding: 1.2rem; }
        .submit-card .form-row { flex-direction: column; }
        .btn-submit-suggestion { width: 100%; }
        .suggestion-item { flex-direction: column; align-items: stretch; }
        .suggestion-item .vote-section { flex-direction: row; gap: 0.5rem; }
    }
</style>

<div class="suggestion-container">

    <div class="suggestion-header">
        <h1>💡 游戏建议</h1>
        <p class="subtitle">有什么想玩的游戏？提出来，大家投票决定开发顺序！</p>
    </div>

    <!-- 提交表单 -->
    <div class="submit-card">
        <div class="form-row">
            <input type="text" id="gameNameInput" placeholder="🎮 游戏名称..." maxlength="50" />
            <textarea id="gameDescInput" placeholder="📝 简单描述一下玩法..." maxlength="200" rows="1"></textarea>
            <button class="btn-submit-suggestion" id="submitSuggestionBtn" onclick="submitSuggestion()">💡 提交建议</button>
        </div>
        <div class="hint-text">💡 好的建议会被采纳并开发！已有相似建议请投票支持</div>
    </div>

    <!-- 建议列表 -->
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var statusMap = new Dictionary<string, string> {
                { "pending", "⏳ 待审核" },
                { "approved", "✅ 已采纳" },
                { "developing", "🚧 开发中" },
                { "completed", "🎉 已完成" },
                { "rejected", "❌ 已拒绝" }
            };
            var statusClass = item.Suggestion.Status switch
            {
                "approved" => "status-approved",
                "developing" => "status-developing",
                "completed" => "status-completed",
                "rejected" => "status-rejected",
                _ => "status-pending"
            };

            <div class="suggestion-item" id="suggestion-@item.Suggestion.Id">
                <div class="vote-section">
                    <button class="vote-btn @(item.IsVoted ? "voted" : "")" onclick="toggleVote(@item.Suggestion.Id)">
                        ▲
                    </button>
                    <span class="vote-count" id="voteCount-@item.Suggestion.Id">@item.VoteCount</span>
                    <span class="vote-label">票</span>
                </div>

                <div class="content">
                    <div class="game-name">
                        @item.Suggestion.GameName
                        <span class="status-badge @statusClass">@statusMap[item.Suggestion.Status]</span>
                    </div>
                    @if (!string.IsNullOrEmpty(item.Suggestion.Description))
                    {
                        <div class="description">@item.Suggestion.Description</div>
                    }
                    <div class="meta">
                        <span class="user">
                            @if (!string.IsNullOrEmpty(item.AvatarUrl))
                            {
                                <img src="@item.AvatarUrl" alt="@item.Username" class="avatar-small" />
                            }
                            else
                            {
                                <span class="avatar-placeholder-small">@(item.Username?.FirstOrDefault().ToString().ToUpper() ?? "?")</span>
                            }
                            @item.Username
                        </span>
                        <span>· @item.Suggestion.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>

                    <!-- 管理员操作 -->
                    @{
                        var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
                        if (isAdmin == 1)
                        {
                            <div class="admin-actions">
                                <select onchange="updateStatus(@item.Suggestion.Id, this.value)">
    @if (item.Suggestion.Status == "pending")
    {
        <option value="pending" selected>⏳ 待审核</option>
    }
    else
    {
        <option value="pending">⏳ 待审核</option>
    }
    @if (item.Suggestion.Status == "approved")
    {
        <option value="approved" selected>✅ 已采纳</option>
    }
    else
    {
        <option value="approved">✅ 已采纳</option>
    }
    @if (item.Suggestion.Status == "developing")
    {
        <option value="developing" selected>🚧 开发中</option>
    }
    else
    {
        <option value="developing">🚧 开发中</option>
    }
    @if (item.Suggestion.Status == "completed")
    {
        <option value="completed" selected>🎉 已完成</option>
    }
    else
    {
        <option value="completed">🎉 已完成</option>
    }
    @if (item.Suggestion.Status == "rejected")
    {
        <option value="rejected" selected>❌ 已拒绝</option>
    }
    else
    {
        <option value="rejected">❌ 已拒绝</option>
    }
</select>
                                <button class="btn-sm danger" onclick="deleteSuggestion(@item.Suggestion.Id)">🗑️</button>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <span class="icon">💡</span>
            <p style="color:rgba(255,255,255,0.3);">还没有建议</p>
            <p style="color:rgba(255,255,255,0.08);">第一个提出你想玩的游戏吧！</p>
        </div>
    }

</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast-msg ${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ============================================================
        // 提交建议
        // ============================================================
        function submitSuggestion() {
            const nameInput = document.getElementById('gameNameInput');
            const descInput = document.getElementById('gameDescInput');
            const name = nameInput.value.trim();
            const desc = descInput.value.trim();

            if (!name || name.length < 2) {
                showToast('游戏名称至少2个字符', 'error');
                nameInput.focus();
                return;
            }

            const btn = document.getElementById('submitSuggestionBtn');
            btn.disabled = true;
            btn.textContent = '⏳ 提交中...';

            fetch('/GameSuggestion/Submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `gameName=${encodeURIComponent(name)}&description=${encodeURIComponent(desc)}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('✅ ' + data.message, 'success');
                    nameInput.value = '';
                    descInput.value = '';
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast(data.message || '提交失败', 'error');
                }
            })
            .catch(() => showToast('网络错误，请重试', 'error'))
            .finally(() => {
                btn.disabled = false;
                btn.textContent = '💡 提交建议';
            });
        }

        // 回车键提交
        document.getElementById('gameNameInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('gameDescInput').focus();
            }
        });
        document.getElementById('gameDescInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                submitSuggestion();
            }
        });

        // ============================================================
        // 投票
        // ============================================================
        function toggleVote(id) {
            const btn = document.querySelector(`#suggestion-${id} .vote-btn`);
            const countEl = document.getElementById(`voteCount-${id}`);
            btn.disabled = true;

            fetch('/GameSuggestion/ToggleVote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    countEl.textContent = data.votes;
                    btn.classList.toggle('voted');
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || '操作失败', 'error');
                }
            })
            .catch(() => showToast('网络错误，请重试', 'error'))
            .finally(() => {
                btn.disabled = false;
            });
        }

        // ============================================================
        // 管理员：更新状态
        // ============================================================
        function updateStatus(id, status) {
            fetch('/GameSuggestion/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}&status=${status}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('✅ 状态已更新', 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || '更新失败', 'error');
                }
            })
            .catch(() => showToast('网络错误，请重试', 'error'));
        }

        // ============================================================
        // 管理员：删除建议
        // ============================================================
        function deleteSuggestion(id) {
            if (!confirm('确定要删除这条建议吗？')) return;

            fetch('/GameSuggestion/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('🗑️ 已删除', 'success');
                    document.getElementById(`suggestion-${id}`).remove();
                } else {
                    showToast(data.message || '删除失败', 'error');
                }
            })
            .catch(() => showToast('网络错误，请重试', 'error'));
        }
    </script>
}
