@{
    ViewData["Title"] = "🚄 列车实时追踪";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<style>
    .train-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .train-header {
        text-align: center;
        padding: 1rem 0 1.5rem;
    }

    .train-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .train-header .subtitle {
        color: rgba(255,255,255,0.2);
        font-size: 0.9rem;
    }

    /* 搜索栏 */
    .search-box {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }

    .search-box input {
        padding: 0.8rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #fff;
        font-size: 1.1rem;
        min-width: 200px;
        outline: none;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        border-color: rgba(139,92,246,0.2);
        background: rgba(255,255,255,0.05);
    }

    .search-box input::placeholder {
        color: rgba(255,255,255,0.15);
    }

    .search-box .btn-search {
        padding: 0.8rem 2.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .search-box .btn-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .search-box .btn-search:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .search-box .hint-text {
        color: rgba(255,255,255,0.08);
        font-size: 0.75rem;
    }

    /* ===== 结果面板 ===== */
    .result-panel {
        display: none;
        animation: fadeIn 0.5s ease;
    }

    .result-panel.active {
        display: block;
    }

    /* 列车信息头 */
    .train-info-header {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.2rem 2rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .train-info-header .train-code {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .train-info-header .train-code .type-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.8rem;
        border-radius: 20px;
        background: rgba(139,92,246,0.12);
        color: #8B5CF6;
        border: 1px solid rgba(139,92,246,0.06);
        font-weight: 500;
    }

    .train-info-header .train-route {
        color: rgba(255,255,255,0.3);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .train-info-header .train-route .arrow {
        color: rgba(139,92,246,0.3);
    }

    .train-info-header .train-time {
        color: rgba(255,255,255,0.15);
        font-size: 0.75rem;
    }

    /* ===== 实时状态卡片 ===== */
    .status-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .status-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        text-align: center;
    }

    .status-card .label {
        color: rgba(255,255,255,0.2);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-card .value {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 600;
        margin-top: 0.2rem;
    }

    .status-card .value .highlight {
        color: #8B5CF6;
    }

    .status-card .value .on-time { color: #28a745; }
    .status-card .value .delayed { color: #dc3545; }
    .status-card .value .running { color: #4facfe; }
    .status-card .value .arrived { color: #28a745; }

    /* ===== 进度条 ===== */
    .progress-section {
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .progress-section .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.15);
        margin-bottom: 0.3rem;
    }

    .progress-section .progress-track {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.04);
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .progress-section .progress-track .progress-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
    }

    .progress-section .progress-track .progress-dot {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #8B5CF6;
        border: 2px solid #0a0a0f;
        box-shadow: 0 0 20px rgba(139,92,246,0.3);
        transition: left 0.5s ease;
    }

    .progress-section .progress-text {
        text-align: center;
        color: rgba(255,255,255,0.15);
        font-size: 0.7rem;
        margin-top: 0.3rem;
    }

    /* ===== 经停站流程图 ===== */
    .stops-flow {
        position: relative;
        padding: 1rem 0;
    }

    .stops-flow .line {
        position: absolute;
        top: 40px;
        left: 40px;
        right: 40px;
        height: 2px;
        background: rgba(255,255,255,0.04);
    }

    .stops-flow .line .line-fill {
        height: 100%;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
    }

    .stop-item {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        padding: 0.6rem 1rem;
        border-radius: 12px;
        margin-bottom: 0.3rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .stop-item:hover {
        background: rgba(255,255,255,0.02);
    }

    .stop-item .stop-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 0.3rem;
        border: 2px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .stop-item .stop-dot.passed {
        background: #8B5CF6;
        border-color: #8B5CF6;
        box-shadow: 0 0 20px rgba(139,92,246,0.15);
    }

    .stop-item .stop-dot.current {
        background: #EC4899;
        border-color: #EC4899;
        box-shadow: 0 0 30px rgba(236,72,153,0.3);
        animation: pulse 1.5s ease-in-out infinite;
    }

    .stop-item .stop-dot.future {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.04);
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.3); }
    }

    .stop-item .stop-info {
        flex: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-bottom: 0.3rem;
        border-bottom: 1px solid rgba(255,255,255,0.02);
    }

    .stop-item:last-child .stop-info {
        border-bottom: none;
    }

    .stop-item .stop-info .station {
        font-weight: 500;
        color: rgba(255,255,255,0.6);
        min-width: 80px;
    }

    .stop-item .stop-info .station .highlight {
        color: #fff;
        font-weight: 600;
    }

    .stop-item .stop-info .station .current-label {
        font-size: 0.55rem;
        padding: 0.05rem 0.5rem;
        border-radius: 20px;
        background: rgba(236,72,153,0.12);
        color: #EC4899;
        border: 1px solid rgba(236,72,153,0.06);
        margin-left: 0.5rem;
    }

    .stop-item .stop-info .times {
        color: rgba(255,255,255,0.2);
        font-size: 0.75rem;
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }

    .stop-item .stop-info .times .arrive {
        color: rgba(255,255,255,0.15);
    }

    .stop-item .stop-info .times .depart {
        color: rgba(255,255,255,0.25);
    }

    .stop-item .stop-info .times .stop-duration {
        color: rgba(255,255,255,0.08);
        font-size: 0.65rem;
    }

    .stop-item .stop-info .status-tag {
        font-size: 0.6rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        font-weight: 500;
    }

    .stop-item .stop-info .status-tag.passed {
        color: #28a745;
        background: rgba(40,167,69,0.08);
        border: 1px solid rgba(40,167,69,0.04);
    }

    .stop-item .stop-info .status-tag.current {
        color: #EC4899;
        background: rgba(236,72,153,0.08);
        border: 1px solid rgba(236,72,153,0.04);
        animation: pulseText 1.5s ease-in-out infinite;
    }

    .stop-item .stop-info .status-tag.future {
        color: rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.02);
    }

    @@keyframes pulseText {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .stop-item .stop-info .status-tag.end {
        color: #4facfe;
        background: rgba(79,172,254,0.08);
        border: 1px solid rgba(79,172,254,0.04);
    }

    /* 空状态 */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: rgba(255,255,255,0.1);
    }

    .empty-state .icon {
        font-size: 4rem;
        margin-bottom: 0.5rem;
        opacity: 0.3;
    }

    .empty-state .title {
        font-size: 1.2rem;
        color: rgba(255,255,255,0.2);
    }

    /* 错误 */
    .error-msg {
        background: rgba(220,53,69,0.08);
        border: 1px solid rgba(220,53,69,0.12);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        color: #dc3545;
        display: none;
    }

    .error-msg.show {
        display: block;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .loading-spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255,255,255,0.1);
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        vertical-align: middle;
        margin-right: 0.5rem;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* 滚动条 */
    .stops-scroll {
        max-height: 500px;
        overflow-y: auto;
        padding-right: 0.3rem;
    }

    .stops-scroll::-webkit-scrollbar {
        width: 3px;
    }

    .stops-scroll::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.02);
        border-radius: 10px;
    }

    .stops-scroll::-webkit-scrollbar-thumb {
        background: rgba(139,92,246,0.2);
        border-radius: 10px;
    }

    @@media (max-width: 640px) {
        .train-header h1 { font-size: 1.6rem; }
        .search-box { padding: 1rem; }
        .search-box input { min-width: 100%; }
        .train-info-header { flex-direction: column; align-items: flex-start; }
        .status-cards { grid-template-columns: 1fr 1fr; }
        .stop-item .stop-info { flex-direction: column; align-items: flex-start; }
        .stop-item .stop-info .times { flex-wrap: wrap; }
    }
</style>

<div class="train-container">

    <div class="train-header">
        <h1>🚄 列车实时追踪</h1>
        <p class="subtitle">输入车次号，追踪列车实时运行状态</p>
    </div>

    <!-- 搜索框 -->
    <div class="search-box">
        <input type="text" id="trainInput" placeholder="输入车次号，如 G1、Z1、K1..." maxlength="10" autofocus />
        <button class="btn-search" id="searchBtn" onclick="queryTrain()">🔍 追踪列车</button>
        <span class="hint-text">支持 G/D/C/Z/T/K 开头车次</span>
    </div>

    <!-- 错误信息 -->
    <div class="error-msg" id="errorMsg"></div>

    <!-- 结果面板 -->
    <div class="result-panel" id="resultPanel">

        <!-- 列车信息头 -->
        <div class="train-info-header" id="trainHeader">
            <div class="train-code">
                <span id="trainCode">G1</span>
                <span class="type-badge" id="trainType">高速动车</span>
            </div>
            <div class="train-route">
                <span id="startStation">北京南</span>
                <span class="arrow">→</span>
                <span id="endStation">上海</span>
            </div>
            <div class="train-time">
                查询时间：<span id="queryTime">--</span>
            </div>
        </div>

        <!-- 实时状态卡片 -->
        <div class="status-cards" id="statusCards">
            <div class="status-card">
                <div class="label">🚦 运行状态</div>
                <div class="value" id="statusValue">--</div>
            </div>
            <div class="status-card">
                <div class="label">📍 当前站</div>
                <div class="value" id="currentStation">--</div>
            </div>
            <div class="status-card">
                <div class="label">⏭️ 下一站</div>
                <div class="value" id="nextStation">--</div>
            </div>
            <div class="status-card">
                <div class="label">⏰ 下一站到达</div>
                <div class="value" id="nextArrive">--</div>
            </div>
            <div class="status-card">
                <div class="label">📊 运行进度</div>
                <div class="value" id="progressValue">0%</div>
            </div>
            <div class="status-card">
                <div class="label">⏱️ 正点情况</div>
                <div class="value" id="delayInfo">--</div>
            </div>
        </div>

        <!-- 进度条 -->
        <div class="progress-section">
            <div class="progress-labels">
                <span id="startLabel">始发站</span>
                <span id="endLabel">终点站</span>
            </div>
            <div class="progress-track">
                <div class="progress-fill" id="progressFill" style="width:0%"></div>
                <div class="progress-dot" id="progressDot" style="left:0%"></div>
            </div>
            <div class="progress-text" id="progressText">0% 已完成</div>
        </div>

        <!-- 经停站列表 -->
        <div class="stops-flow">
            <div class="stops-scroll" id="stopsList"></div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var isQuerying = false;

        // ============================================================
        // 查询列车
        // ============================================================
        function queryTrain() {
            var input = document.getElementById('trainInput');
            var trainCode = input.value.trim().toUpperCase();

            if (!trainCode || trainCode.length < 2) {
                showError('请输入有效的车次号');
                return;
            }

            if (isQuerying) return;

            var btn = document.getElementById('searchBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span>查询中...';
            document.getElementById('errorMsg').classList.remove('show');

            fetch('/Train/Query', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ trainCode: trainCode })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    renderResult(data.data);
                } else {
                    showError(data.message || '未找到该车次信息');
                    document.getElementById('resultPanel').classList.remove('active');
                }
            })
            .catch(function() {
                showError('网络错误，请重试');
                document.getElementById('resultPanel').classList.remove('active');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = '🔍 追踪列车';
                isQuerying = false;
            });
        }

        // ============================================================
        // 渲染结果
        // ============================================================
        function renderResult(data) {
            // 基本信息
            document.getElementById('trainCode').textContent = data.trainCode;
            document.getElementById('trainType').textContent = data.trainType || '未知';
            document.getElementById('startStation').textContent = data.startStation;
            document.getElementById('endStation').textContent = data.endStation;
            document.getElementById('queryTime').textContent = new Date(data.queryTime).toLocaleString();

            // 状态
            var statusMap = {
                '未发车': '⏳ 未发车',
                '运行中': '🚄 运行中',
                '停靠中': '🚉 停靠中',
                '已到达': '🏁 已到达'
            };
            document.getElementById('statusValue').textContent = statusMap[data.status] || data.status;
            document.getElementById('statusValue').className = 'value ' + (data.status === '已到达' ? 'arrived' : data.status === '运行中' ? 'running' : '');

            document.getElementById('currentStation').textContent = data.currentStation || '--';
            document.getElementById('nextStation').textContent = data.nextStation || '已到终点';
            document.getElementById('nextArrive').textContent = data.nextArriveTime || '--';

            var progress = data.progressPercent || 0;
            document.getElementById('progressValue').textContent = progress + '%';
            document.getElementById('progressFill').style.width = progress + '%';
            document.getElementById('progressDot').style.left = progress + '%';
            document.getElementById('progressText').textContent = progress + '% 已完成';

            var delay = data.delayInfo || '正点';
            var delayEl = document.getElementById('delayInfo');
            delayEl.textContent = delay;
            delayEl.className = 'value ' + (delay === '正点' ? 'on-time' : 'delayed');

            // 渲染经停站
            renderStops(data.stops, data.currentStation);

            document.getElementById('resultPanel').classList.add('active');
        }

        // ============================================================
        // 渲染经停站
        // ============================================================
        function renderStops(stops, currentStation) {
            var container = document.getElementById('stopsList');
            if (!stops || stops.length === 0) {
                container.innerHTML = '<div class="empty-state"><div class="icon">🚄</div><div class="title">暂无经停站信息</div></div>';
                return;
            }

            var html = '';
            var foundCurrent = false;

            stops.forEach(function(stop, index) {
                var isStart = stop.isStart;
                var isEnd = stop.isEnd;
                var isCurrent = stop.stationName === currentStation && !foundCurrent;

                if (isCurrent) {
                    foundCurrent = true;
                }

                var dotClass = 'stop-dot';
                var statusClass = 'status-tag future';
                var stationClass = '';

                if (isCurrent) {
                    dotClass += ' current';
                    statusClass = 'status-tag current';
                    stationClass = ' highlight';
                } else if (foundCurrent || isEnd) {
                    dotClass += ' passed';
                    statusClass = 'status-tag passed';
                } else {
                    dotClass += ' future';
                    statusClass = 'status-tag future';
                }

                if (isStart) {
                    dotClass = 'stop-dot passed';
                    statusClass = 'status-tag passed';
                }
                if (isEnd) {
                    dotClass = 'stop-dot passed';
                    statusClass = 'status-tag end';
                }

                var statusText = isStart ? '始发' : isEnd ? '终点' : isCurrent ? '📍 当前' : '';
                var arriveDisplay = stop.arriveTime || '--';
                var departDisplay = stop.departTime || '--';
                var stopTimeDisplay = stop.stopTime || '--';

                // 处理始发/终到特殊显示
                if (isStart) {
                    arriveDisplay = '始发';
                    departDisplay = stop.departTime || '--';
                }
                if (isEnd) {
                    arriveDisplay = stop.arriveTime || '--';
                    departDisplay = '终到';
                }

                html += `
                    <div class="stop-item">
                        <div class="${dotClass}"></div>
                        <div class="stop-info">
                            <div class="station">
                                <span class="${stationClass}">${stop.stationName}</span>
                                ${statusText ? `<span class="current-label">${statusText}</span>` : ''}
                            </div>
                            <div class="times">
                                <span class="arrive">🚉 ${arriveDisplay}</span>
                                <span class="depart">🚄 ${departDisplay}</span>
                                ${!isStart && !isEnd ? `<span class="stop-duration">⏱ ${stopTimeDisplay}</span>` : ''}
                            </div>
                            <span class="${statusClass}">${isStart ? '始发站' : isEnd ? '终点站' : isCurrent ? '🟢 当前' : '⬜ 未到'}</span>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            // 滚动到当前站
            var currentItem = container.querySelector('.stop-dot.current');
            if (currentItem) {
                currentItem.closest('.stop-item').scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
        }

        // ============================================================
        // 错误提示
        // ============================================================
        function showError(msg) {
            var el = document.getElementById('errorMsg');
            el.textContent = msg;
            el.classList.add('show');
        }

        // ============================================================
        // 回车键查询
        // ============================================================
        document.getElementById('trainInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                queryTrain();
            }
        });

        // ============================================================
        // 自动聚焦
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('trainInput').focus();
        });
    </script>
}
