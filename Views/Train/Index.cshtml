@{
    ViewData["Title"] = "🚄 列车实时追踪 - 全息版";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🚄 列车实时追踪 - 全息版</title>

    <style>
        /* ============================================================
           全局重置 - 全屏强制
           ============================================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0a0a0f;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #e0e0e0;
            overflow: hidden;
            height: 100vh;
            width: 100vw;
        }

        .train-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: #0a0a0f;
            z-index: 9999;
            padding: 0.6rem 2rem 1rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .train-container::-webkit-scrollbar {
            width: 4px;
        }
        .train-container::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.2);
            border-radius: 10px;
        }

        /* ============================================================
           粒子背景
           ============================================================ */
        #particles-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: rgba(139, 92, 246, 0.2);
            border-radius: 50%;
            animation: particleFloat linear infinite;
            opacity: 0;
        }

        .particle:nth-child(1) {
            left: 5%;
            animation-duration: 25s;
            animation-delay: 0s;
        }
        .particle:nth-child(2) {
            left: 15%;
            animation-duration: 20s;
            animation-delay: 2s;
            width: 4px;
            height: 4px;
            background: rgba(236, 72, 153, 0.15);
        }
        .particle:nth-child(3) {
            left: 25%;
            animation-duration: 28s;
            animation-delay: 1s;
        }
        .particle:nth-child(4) {
            left: 35%;
            animation-duration: 18s;
            animation-delay: 3s;
            width: 5px;
            height: 5px;
            background: rgba(245, 158, 11, 0.1);
        }
        .particle:nth-child(5) {
            left: 45%;
            animation-duration: 30s;
            animation-delay: 0.5s;
        }
        .particle:nth-child(6) {
            left: 55%;
            animation-duration: 22s;
            animation-delay: 4s;
            width: 4px;
            height: 4px;
            background: rgba(79, 172, 254, 0.15);
        }
        .particle:nth-child(7) {
            left: 65%;
            animation-duration: 26s;
            animation-delay: 1.5s;
        }
        .particle:nth-child(8) {
            left: 75%;
            animation-duration: 19s;
            animation-delay: 2.5s;
            width: 5px;
            height: 5px;
            background: rgba(139, 92, 246, 0.12);
        }
        .particle:nth-child(9) {
            left: 85%;
            animation-duration: 32s;
            animation-delay: 0.8s;
        }
        .particle:nth-child(10) {
            left: 95%;
            animation-duration: 21s;
            animation-delay: 3.5s;
            width: 4px;
            height: 4px;
            background: rgba(236, 72, 153, 0.12);
        }
        .particle:nth-child(11) {
            left: 10%;
            animation-duration: 24s;
            animation-delay: 6s;
        }
        .particle:nth-child(12) {
            left: 50%;
            animation-duration: 27s;
            animation-delay: 5s;
            width: 3px;
            height: 3px;
            background: rgba(139, 92, 246, 0.1);
        }

        @@keyframes particleFloat {
            0% {
                transform: translateY(100vh) scale(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-10vh) scale(1);
                opacity: 0;
            }
        }

        /* ============================================================
           头部
           ============================================================ */
        .train-header {
            text-align: center;
            padding: 0.2rem 0 0.4rem;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
        }

        .train-header .glow-line {
            width: 100px;
            height: 2px;
            margin: 0.1rem auto 0;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            border-radius: 10px;
            animation: glowPulse 2s ease-in-out infinite;
        }

        @@keyframes glowPulse {
            0%,
            100% {
                opacity: 0.3;
                transform: scaleX(1);
            }
            50% {
                opacity: 1;
                transform: scaleX(1.2);
            }
        }

        .train-header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
            letter-spacing: -0.02em;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }

        .train-header h1 .train-emoji {
            animation: trainMove 3s ease-in-out infinite;
        }

        @@keyframes trainMove {
            0%,
            100% {
                transform: translateX(0);
            }
            50% {
                transform: translateX(6px);
            }
        }

        .train-header .subtitle {
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.6rem;
            margin-top: 0.05rem;
            font-weight: 300;
            letter-spacing: 0.06em;
        }

        /* ============================================================
           搜索栏
           ============================================================ */
        .search-box {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 16px;
            padding: 0.5rem 1.2rem;
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 48px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
            margin-bottom: 0.6rem;
        }

        .search-box:focus-within {
            border-color: rgba(139, 92, 246, 0.15);
        }

        .search-box .input-wrapper {
            flex: 1;
            min-width: 160px;
            position: relative;
        }

        .search-box .input-wrapper .input-icon {
            position: absolute;
            left: 0.8rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.85rem;
        }

        .search-box .input-wrapper input {
            width: 100%;
            padding: 0.5rem 1rem 0.5rem 2.6rem;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            color: #fff;
            font-size: 0.85rem;
            outline: none;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        .search-box .input-wrapper input:focus {
            border-color: rgba(139, 92, 246, 0.15);
            background: rgba(255, 255, 255, 0.04);
        }

        .search-box .input-wrapper input::placeholder {
            color: rgba(255, 255, 255, 0.06);
            font-weight: 300;
        }

        .suggestions-dropdown {
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: rgba(16, 16, 30, 0.98);
            backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 14px;
            max-height: 180px;
            overflow-y: auto;
            display: none;
            z-index: 200;
            padding: 0.2rem 0;
            box-shadow: 0 20px 80px rgba(0, 0, 0, 0.6);
        }

        .suggestions-dropdown.show {
            display: block;
            animation: dropdownIn 0.2s ease;
        }

        @@keyframes dropdownIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .suggestions-dropdown::-webkit-scrollbar {
            width: 3px;
        }
        .suggestions-dropdown::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.2);
            border-radius: 10px;
        }

        .suggestions-dropdown .suggestion-item {
            padding: 0.4rem 1rem;
            cursor: pointer;
            color: rgba(255, 255, 255, 0.3);
            font-size: 0.8rem;
            transition: all 0.2s ease;
            font-weight: 500;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .suggestions-dropdown .suggestion-item:hover {
            background: rgba(139, 92, 246, 0.06);
            color: #fff;
        }

        .suggestions-dropdown .suggestion-item .s-tag {
            font-size: 0.5rem;
            padding: 0.05rem 0.5rem;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.12);
            font-weight: 400;
        }

        .search-box .btn-search {
            padding: 0.5rem 1.8rem;
            border: none;
            border-radius: 50px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            font-family: inherit;
            white-space: nowrap;
            box-shadow: 0 4px 24px rgba(108, 60, 225, 0.15);
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        .search-box .btn-search::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.1), transparent 60%);
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .search-box .btn-search:hover:not(:disabled)::after {
            opacity: 1;
        }

        .search-box .btn-search:hover:not(:disabled) {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 8px 48px rgba(108, 60, 225, 0.3);
        }

        .search-box .btn-search:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        .search-box .hot-keys {
            display: flex;
            gap: 0.3rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-box .hot-keys .hot-key {
            padding: 0.15rem 0.6rem;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.02);
            background: rgba(255, 255, 255, 0.02);
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.55rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .search-box .hot-keys .hot-key:hover {
            background: rgba(139, 92, 246, 0.06);
            color: rgba(255, 255, 255, 0.2);
            border-color: rgba(139, 92, 246, 0.06);
        }

        /* ============================================================
           错误信息
           ============================================================ */
        .error-msg {
            background: rgba(220, 53, 69, 0.04);
            border: 1px solid rgba(220, 53, 69, 0.08);
            border-radius: 14px;
            padding: 0.8rem 1.5rem;
            text-align: center;
            color: #dc3545;
            display: none;
            margin-bottom: 0.6rem;
            font-weight: 500;
            animation: fadeIn 0.4s ease;
            backdrop-filter: blur(10px);
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .error-msg.show {
            display: block;
        }

        /* ============================================================
           结果面板
           ============================================================ */
        .result-panel {
            display: none;
            animation: fadeIn 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

        .result-panel.active {
            display: block;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============================================================
           列车信息头 - 3D卡片
           ============================================================ */
        .train-info-header {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 18px;
            padding: 1rem 1.8rem;
            margin-bottom: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
            perspective: 800px;
            transform-style: preserve-3d;
        }

        .train-info-header:hover {
            transform: rotateX(0.5deg) rotateY(0.5deg);
            border-color: rgba(255, 255, 255, 0.06);
        }

        .train-info-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899, #F59E0B);
            opacity: 0.4;
        }

        .train-info-header .train-code {
            font-size: 2.2rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            letter-spacing: -0.02em;
            z-index: 1;
        }

        .train-info-header .train-code .type-badge {
            font-size: 0.55rem;
            padding: 0.15rem 0.8rem;
            border-radius: 20px;
            background: rgba(139, 92, 246, 0.08);
            color: #8B5CF6;
            border: 1px solid rgba(139, 92, 246, 0.04);
            font-weight: 500;
            letter-spacing: 0.04em;
        }

        .train-info-header .train-code .brand-badge {
            font-size: 0.5rem;
            padding: 0.1rem 0.6rem;
            border-radius: 20px;
            background: rgba(236, 72, 153, 0.06);
            color: #EC4899;
            border: 1px solid rgba(236, 72, 153, 0.03);
        }

        .train-info-header .train-route {
            color: rgba(255, 255, 255, 0.2);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex-wrap: wrap;
            z-index: 1;
        }

        .train-info-header .train-route .station-name {
            color: rgba(255, 255, 255, 0.5);
            font-weight: 500;
        }

        .train-info-header .train-route .station-name.start {
            color: #8B5CF6;
        }
        .train-info-header .train-route .station-name.end {
            color: #EC4899;
        }

        .train-info-header .train-route .arrow {
            color: rgba(139, 92, 246, 0.15);
            font-size: 0.7rem;
        }

        .train-info-header .train-meta {
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.6rem;
            text-align: right;
            line-height: 1.6;
            z-index: 1;
        }

        .train-info-header .train-meta .meta-value {
            color: rgba(255, 255, 255, 0.15);
        }

        /* ============================================================
           状态卡片 - 6个
           ============================================================ */
        .status-cards {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 0.6rem;
            margin-bottom: 0.8rem;
        }

        .status-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 0.7rem 0.4rem;
            text-align: center;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
            cursor: default;
        }

        .status-card:hover {
            background: rgba(255, 255, 255, 0.04);
            transform: translateY(-3px);
            border-color: rgba(255, 255, 255, 0.06);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }

        .status-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .status-card:hover::before {
            opacity: 1;
        }

        .status-card:nth-child(1)::before {
            background: linear-gradient(135deg, #8B5CF6, #A78BFA);
        }
        .status-card:nth-child(2)::before {
            background: linear-gradient(135deg, #4facfe, #60A5FA);
        }
        .status-card:nth-child(3)::before {
            background: linear-gradient(135deg, #34D399, #6EE7B7);
        }
        .status-card:nth-child(4)::before {
            background: linear-gradient(135deg, #F59E0B, #FBBF24);
        }
        .status-card:nth-child(5)::before {
            background: linear-gradient(135deg, #EC4899, #F472B6);
        }
        .status-card:nth-child(6)::before {
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
        }

        .status-card .label {
            color: rgba(255, 255, 255, 0.1);
            font-size: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 600;
        }

        .status-card .value {
            color: #fff;
            font-size: 0.9rem;
            font-weight: 700;
            margin-top: 0.1rem;
            line-height: 1.3;
        }

        .status-card .value .sub {
            font-size: 0.55rem;
            font-weight: 400;
            color: rgba(255, 255, 255, 0.12);
            display: block;
            margin-top: 0.05rem;
        }

        .status-card .value .running {
            color: #4facfe;
        }
        .status-card .value .stopping {
            color: #F59E0B;
        }
        .status-card .value .arrived {
            color: #28a745;
        }
        .status-card .value .on-time {
            color: #28a745;
        }
        .status-card .value .delayed {
            color: #dc3545;
        }

        .status-card .status-icon {
            font-size: 1rem;
            display: block;
            margin-bottom: 0.05rem;
        }

        /* ============================================================
           进度条 - 流光
           ============================================================ */
        .progress-section {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 0.8rem 1.5rem;
            margin-bottom: 0.8rem;
            position: relative;
            overflow: hidden;
        }

        .progress-section .progress-labels {
            display: flex;
            justify-content: space-between;
            font-size: 0.6rem;
            color: rgba(255, 255, 255, 0.1);
            margin-bottom: 0.3rem;
            position: relative;
            z-index: 1;
        }

        .progress-section .progress-labels .start {
            color: rgba(139, 92, 246, 0.3);
        }
        .progress-section .progress-labels .end {
            color: rgba(236, 72, 153, 0.3);
        }

        .progress-section .progress-track {
            position: relative;
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            overflow: hidden;
            z-index: 1;
        }

        .progress-section .progress-track .progress-fill {
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(135deg, #8B5CF6, #EC4899);
            transition: width 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.1);
        }

        .progress-section .progress-track .progress-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
            animation: shimmer 2.5s infinite;
        }

        @@keyframes shimmer {
            0% {
                transform: translateX(-100%);
            }
            100% {
                transform: translateX(100%);
            }
        }

        .progress-section .progress-track .progress-dot {
            position: absolute;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, #A78BFA, #6D28D9);
            border: 3px solid #0a0a0f;
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.25);
            transition: left 0.8s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 2;
        }

        .progress-section .progress-track .progress-dot .train-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 0.55rem;
        }

        .progress-section .progress-text {
            text-align: center;
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.6rem;
            margin-top: 0.3rem;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }

        .progress-section .progress-text strong {
            color: rgba(255, 255, 255, 0.15);
            font-weight: 600;
        }

        /* ============================================================
           经停站 - 时间线（正确顺序：始发→终点）
           ============================================================ */
        .stops-section {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 0.8rem 0.5rem 0.3rem;
            overflow: hidden;
            position: relative;
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .stops-section .stops-header {
            display: flex;
            justify-content: space-between;
            padding: 0 1.2rem 0.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.02);
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.55rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            flex-shrink: 0;
        }

        .stops-section .stops-header .count {
            color: rgba(139, 92, 246, 0.15);
        }

        .stops-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 0.2rem 0.5rem 0.5rem;
            min-height: 0;
        }

        .stops-scroll::-webkit-scrollbar {
            width: 3px;
        }
        .stops-scroll::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.01);
            border-radius: 10px;
        }
        .stops-scroll::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.12);
            border-radius: 10px;
        }

        /* 每个停靠站 */
        .stop-item {
            display: flex;
            align-items: stretch;
            padding: 0.3rem 0.6rem;
            border-radius: 12px;
            transition: all 0.3s ease;
            gap: 0.6rem;
            position: relative;
            cursor: pointer;
        }

        .stop-item:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .stop-item .stop-timeline {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 30px;
            padding-top: 0.1rem;
            position: relative;
            flex-shrink: 0;
        }

        .stop-item .stop-timeline .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            flex-shrink: 0;
            transition: all 0.4s ease;
            z-index: 2;
            position: relative;
        }

        .stop-item .stop-timeline .dot.passed {
            background: #8B5CF6;
            border-color: #8B5CF6;
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.12);
        }

        .stop-item .stop-timeline .dot.current {
            background: #EC4899;
            border-color: #EC4899;
            box-shadow: 0 0 30px rgba(236, 72, 153, 0.25);
            animation: pulse-dot 1.5s ease-in-out infinite;
        }

        .stop-item .stop-timeline .dot.future {
            background: rgba(255, 255, 255, 0.02);
            border-color: rgba(255, 255, 255, 0.03);
        }

        .stop-item .stop-timeline .line-connector {
            flex: 1;
            width: 2px;
            min-height: 8px;
            background: rgba(255, 255, 255, 0.02);
            margin: 1px 0;
            transition: all 0.4s ease;
        }

        .stop-item .stop-timeline .line-connector.passed {
            background: linear-gradient(180deg, #8B5CF6, rgba(139, 92, 246, 0.08));
        }

        @@keyframes pulse-dot {
            0%,
            100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.25);
            }
        }

        /* 右侧信息 - 紧凑 */
        .stop-info {
            flex: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.2rem 0.6rem;
            padding: 0.05rem 0;
            min-height: 36px;
        }

        .stop-info .station {
            font-weight: 500;
            color: rgba(255, 255, 255, 0.3);
            font-size: 0.8rem;
            min-width: 60px;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .stop-info .station .highlight {
            color: #fff;
            font-weight: 600;
        }

        .stop-info .station .current-label {
            font-size: 0.45rem;
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
            background: rgba(236, 72, 153, 0.12);
            color: #EC4899;
            border: 1px solid rgba(236, 72, 153, 0.06);
            font-weight: 500;
            animation: pulse-text 1.5s ease-in-out infinite;
        }

        .stop-info .station .station-type {
            font-size: 0.45rem;
            color: rgba(255, 255, 255, 0.05);
            font-weight: 400;
        }

        @@keyframes pulse-text {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0.4;
            }
        }

        .stop-info .times {
            color: rgba(255, 255, 255, 0.1);
            font-size: 0.6rem;
            display: flex;
            gap: 0.6rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .stop-info .times .arrive {
            color: rgba(255, 255, 255, 0.1);
        }
        .stop-info .times .depart {
            color: rgba(255, 255, 255, 0.15);
        }
        .stop-info .times .stop-dur {
            color: rgba(255, 255, 255, 0.04);
            font-size: 0.5rem;
            background: rgba(255, 255, 255, 0.02);
            padding: 0.05rem 0.4rem;
            border-radius: 20px;
        }

        .stop-info .status-tag {
            font-size: 0.45rem;
            padding: 0.05rem 0.5rem;
            border-radius: 20px;
            font-weight: 500;
            white-space: nowrap;
        }

        .stop-info .status-tag.passed {
            color: rgba(139, 92, 246, 0.25);
            background: rgba(139, 92, 246, 0.03);
            border: 1px solid rgba(139, 92, 246, 0.02);
        }

        .stop-info .status-tag.current {
            color: #EC4899;
            background: rgba(236, 72, 153, 0.06);
            border: 1px solid rgba(236, 72, 153, 0.04);
        }

        .stop-info .status-tag.future {
            color: rgba(255, 255, 255, 0.03);
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid rgba(255, 255, 255, 0.01);
        }

        .stop-info .status-tag.end {
            color: #4facfe;
            background: rgba(79, 172, 254, 0.04);
            border: 1px solid rgba(79, 172, 254, 0.02);
        }

        .stop-info .platform-info {
            font-size: 0.5rem;
            color: rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            gap: 0.2rem;
        }

        .stop-info .platform-info .icon {
            font-size: 0.45rem;
        }

        /* ============================================================
           座席状态 - 高级卡片
           ============================================================ */
        .seat-section {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            padding: 0.8rem 1.5rem;
            margin-bottom: 0.8rem;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

        .seat-section .seat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .seat-section .seat-header .seat-title {
            color: rgba(255, 255, 255, 0.15);
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .seat-section .seat-input-group {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .seat-section .seat-input-group input {
            padding: 0.4rem 1rem;
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            background: rgba(255, 255, 255, 0.02);
            color: #fff;
            font-size: 0.8rem;
            outline: none;
            font-family: inherit;
            width: 140px;
            transition: all 0.3s ease;
        }

        .seat-section .seat-input-group input:focus {
            border-color: rgba(139, 92, 246, 0.15);
            background: rgba(255, 255, 255, 0.04);
        }

        .seat-section .seat-input-group input::placeholder {
            color: rgba(255, 255, 255, 0.06);
        }

        .seat-section .seat-input-group .btn-seat {
            padding: 0.4rem 1.2rem;
            border: none;
            border-radius: 50px;
            background: linear-gradient(135deg, #F59E0B, #F97316);
            color: #fff;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .seat-section .seat-input-group .btn-seat:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 32px rgba(245, 158, 11, 0.15);
        }

        .seat-section .seat-input-group .btn-seat:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .seat-section .seat-result {
            display: none;
            margin-top: 0.6rem;
            padding: 0.8rem 1rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            animation: fadeIn 0.4s ease;
        }

        .seat-section .seat-result.show {
            display: block;
        }

        .seat-result .seat-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 0.4rem 1rem;
        }

        .seat-result .seat-info-grid .seat-item {
            display: flex;
            flex-direction: column;
        }

        .seat-result .seat-info-grid .seat-item .label {
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.45rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .seat-result .seat-info-grid .seat-item .value {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.8rem;
            font-weight: 600;
        }

        .seat-result .seat-info-grid .seat-item .value.available {
            color: #28a745;
        }
        .seat-result .seat-info-grid .seat-item .value.sold {
            color: #dc3545;
        }
        .seat-result .seat-info-grid .seat-item .value.selected {
            color: #F59E0B;
        }
        .seat-result .seat-info-grid .seat-item .value.highlight {
            color: #8B5CF6;
        }

        .seat-result .seat-features {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            margin-top: 0.4rem;
            padding-top: 0.4rem;
            border-top: 1px solid rgba(255, 255, 255, 0.03);
        }

        .seat-result .seat-features .feature-tag {
            padding: 0.1rem 0.6rem;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.03);
            color: rgba(255, 255, 255, 0.15);
            font-size: 0.55rem;
        }

        /* ============================================================
           车站详情弹窗
           ============================================================ */
        .station-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            animation: modalFadeIn 0.3s ease;
        }

        .station-modal-overlay.active {
            display: flex;
        }

        @@keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .station-modal {
            background: rgba(16, 16, 30, 0.98);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 24px;
            max-width: 520px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            padding: 1.8rem 2rem;
            box-shadow: 0 32px 120px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        .station-modal::-webkit-scrollbar {
            width: 3px;
        }
        .station-modal::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.2);
            border-radius: 10px;
        }

        .station-modal .modal-close {
            position: absolute;
            top: 0.8rem;
            right: 1rem;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.1);
            font-size: 1.3rem;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .station-modal .modal-close:hover {
            color: rgba(255, 255, 255, 0.3);
        }

        .station-modal .modal-station-name {
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.1rem;
        }

        .station-modal .modal-station-sub {
            color: rgba(255, 255, 255, 0.12);
            font-size: 0.75rem;
            margin-bottom: 1rem;
        }

        .station-modal .modal-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.04);
            margin: 0.6rem 0 0.8rem;
        }

        .station-modal .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.4rem 1rem;
        }

        .station-modal .info-grid .info-item {
            display: flex;
            flex-direction: column;
        }

        .station-modal .info-grid .info-item .label {
            color: rgba(255, 255, 255, 0.06);
            font-size: 0.45rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .station-modal .info-grid .info-item .value {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.8rem;
            font-weight: 500;
            margin-top: 0.05rem;
        }

        .station-modal .info-grid .info-item .value.highlight {
            color: #8B5CF6;
        }

        .station-modal .modal-description {
            margin-top: 0.8rem;
            padding: 0.6rem 0.8rem;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.02);
            color: rgba(255, 255, 255, 0.15);
            font-size: 0.75rem;
            line-height: 1.6;
        }

        .station-modal .modal-actions {
            display: flex;
            gap: 0.6rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .station-modal .modal-actions .btn-close-modal {
            padding: 0.5rem 1.8rem;
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 40px;
            background: rgba(255, 255, 255, 0.02);
            color: rgba(255, 255, 255, 0.15);
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
            font-size: 0.8rem;
        }

        .station-modal .modal-actions .btn-close-modal:hover {
            background: rgba(255, 255, 255, 0.04);
            color: rgba(255, 255, 255, 0.3);
        }

        /* ============================================================
           空状态
           ============================================================ */
        .empty-state {
            text-align: center;
            padding: 2rem;
            color: rgba(255, 255, 255, 0.04);
        }

        .empty-state .icon {
            font-size: 3rem;
            margin-bottom: 0.3rem;
            opacity: 0.15;
        }
        .empty-state .title {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.06);
        }
        .empty-state .sub {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.03);
        }

        /* ============================================================
           Loading
           ============================================================ */
        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, 0.06);
            border-top-color: #8B5CF6;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            vertical-align: middle;
            margin-right: 0.4rem;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ============================================================
           响应式
           ============================================================ */
        @@media (max-width: 1024px) {
            .status-cards {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .train-container {
                padding: 0.4rem 0.8rem 0.8rem;
            }

            .train-header h1 {
                font-size: 1.2rem;
            }

            .search-box {
                padding: 0.4rem 0.8rem;
                flex-direction: column;
            }
            .search-box .input-wrapper {
                min-width: 100%;
            }
            .search-box .btn-search {
                width: 100%;
                justify-content: center;
            }
            .search-box .hot-keys {
                justify-content: center;
            }

            .train-info-header {
                padding: 0.8rem 1rem;
                flex-direction: column;
                align-items: flex-start;
            }
            .train-info-header .train-meta {
                text-align: left;
                width: 100%;
            }
            .train-info-header .train-route {
                font-size: 0.75rem;
            }
            .train-info-header .train-code {
                font-size: 1.6rem;
                flex-wrap: wrap;
            }

            .status-cards {
                grid-template-columns: repeat(2, 1fr);
                gap: 0.4rem;
            }
            .status-card .value {
                font-size: 0.75rem;
            }
            .status-card .label {
                font-size: 0.4rem;
            }

            .stop-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.1rem;
            }
            .stop-info .times {
                flex-wrap: wrap;
                gap: 0.3rem;
            }
            .stop-info .station {
                font-size: 0.7rem;
                min-width: 50px;
            }
            .stop-item {
                padding: 0.2rem 0.3rem;
                gap: 0.4rem;
            }
            .stop-item .stop-timeline {
                min-width: 24px;
            }
            .stop-item .stop-timeline .dot {
                width: 10px;
                height: 10px;
            }

            .progress-section {
                padding: 0.5rem 0.8rem;
            }

            .seat-section {
                padding: 0.5rem 0.8rem;
            }
            .seat-section .seat-input-group {
                flex-direction: column;
                width: 100%;
            }
            .seat-section .seat-input-group input {
                width: 100%;
            }
            .seat-section .seat-input-group .btn-seat {
                width: 100%;
                justify-content: center;
            }
            .seat-result .seat-info-grid {
                grid-template-columns: 1fr 1fr;
            }

            .station-modal {
                padding: 1.2rem;
                margin: 0.5rem;
            }
            .station-modal .info-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .train-header h1 {
                font-size: 1rem;
            }
            .train-header .subtitle {
                font-size: 0.5rem;
            }

            .status-cards {
                grid-template-columns: 1fr 1fr;
                gap: 0.3rem;
            }
            .status-card {
                padding: 0.4rem 0.2rem;
                border-radius: 10px;
            }
            .status-card .value {
                font-size: 0.65rem;
            }
            .status-card .label {
                font-size: 0.35rem;
            }
            .status-card .status-icon {
                font-size: 0.7rem;
            }

            .train-info-header .train-code {
                font-size: 1.2rem;
            }
            .train-info-header .train-route {
                font-size: 0.65rem;
            }

            .stop-info .station {
                font-size: 0.6rem;
                min-width: 40px;
            }
            .stop-info .times {
                font-size: 0.5rem;
                gap: 0.2rem;
            }
            .stop-info .platform-info {
                font-size: 0.4rem;
            }

            .seat-result .seat-info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- ===== 粒子背景 ===== -->
    <div id="particles-container">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <!-- ===== 主容器 ===== -->
    <div class="train-container" id="trainContainer">

        <!-- ===== 头部 ===== -->
        <div class="train-header">
            <h1>
                <span class="train-emoji">🚄</span> 列车实时追踪
            </h1>
            <div class="glow-line"></div>
            <p class="subtitle">全息 · 实时 · 沉浸式</p>
        </div>

        <!-- ===== 搜索栏 ===== -->
        <div class="search-box">
            <div class="input-wrapper">
                <span class="input-icon">🔍</span>
                <input type="text" id="trainInput"
                       placeholder="输入车次号，如 G1、Z1、K1..."
                       maxlength="10" autofocus
                       autocomplete="off" />
                <div class="suggestions-dropdown" id="suggestions"></div>
            </div>
            <button class="btn-search" id="searchBtn" onclick="queryTrain()">
                🚄 追踪
            </button>
            <div class="hot-keys">
                <button class="hot-key" onclick="setTrain('G1')">G1</button>
                <button class="hot-key" onclick="setTrain('G310')">G310</button>
                <button class="hot-key" onclick="setTrain('G79')">G79</button>
                <button class="hot-key" onclick="setTrain('Z1')">Z1</button>
                <button class="hot-key" onclick="setTrain('K1')">K1</button>
                <button class="hot-key" onclick="setTrain('D1')">D1</button>
            </div>
        </div>

        <!-- ===== 错误信息 ===== -->
        <div class="error-msg" id="errorMsg"></div>

        <!-- ===== 结果面板 ===== -->
        <div class="result-panel" id="resultPanel">

            <!-- 列车信息头 -->
            <div class="train-info-header" id="trainHeader">
                <div class="train-code">
                    <span id="trainCode">G1</span>
                    <span class="type-badge" id="trainType">高速动车</span>
                    <span class="brand-badge" id="trainBrand">复兴号</span>
                </div>
                <div class="train-route">
                    <span class="station-name start" id="startStation">北京南</span>
                    <span class="arrow">→</span>
                    <span class="station-name end" id="endStation">上海虹桥</span>
                    <span style="color:rgba(255,255,255,0.03);font-size:0.5rem;margin-left:0.2rem;" id="trainDistance">--</span>
                </div>
                <div class="train-meta">
                    <div id="queryTime">查询：--</div>
                    <div id="trainDuration" style="color:rgba(255,255,255,0.03);">--</div>
                    <div id="trainModel" style="color:rgba(255,255,255,0.03);">--</div>
                </div>
            </div>

            <!-- 状态卡片 -->
            <div class="status-cards" id="statusCards">
                <div class="status-card">
                    <span class="status-icon">🚦</span>
                    <div class="label">运行状态</div>
                    <div class="value" id="statusValue">--</div>
                </div>
                <div class="status-card">
                    <span class="status-icon">📍</span>
                    <div class="label">当前站</div>
                    <div class="value" id="currentStation">--</div>
                </div>
                <div class="status-card">
                    <span class="status-icon">⏭️</span>
                    <div class="label">下一站</div>
                    <div class="value" id="nextStation">--</div>
                </div>
                <div class="status-card">
                    <span class="status-icon">⏰</span>
                    <div class="label">到达时间</div>
                    <div class="value" id="nextArrive">--</div>
                </div>
                <div class="status-card">
                    <span class="status-icon">📊</span>
                    <div class="label">运行进度</div>
                    <div class="value" id="progressValue">0%</div>
                </div>
                <div class="status-card">
                    <span class="status-icon">⏱️</span>
                    <div class="label">正点情况</div>
                    <div class="value" id="delayInfo">--</div>
                </div>
            </div>

            <!-- 进度条 -->
            <div class="progress-section">
                <div class="progress-labels">
                    <span class="start" id="startLabel">🟢 始发站</span>
                    <span class="end" id="endLabel">🏁 终点站</span>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" id="progressFill" style="width:0%"></div>
                    <div class="progress-dot" id="progressDot" style="left:0%">
                        <span class="train-icon">🚄</span>
                    </div>
                </div>
                <div class="progress-text">
                    已完成 <strong id="progressText">0%</strong>
                </div>
            </div>

            <!-- ===== 座席状态 ===== -->
            <div class="seat-section">
                <div class="seat-header">
                    <span class="seat-title">🪑 座席状态查询</span>
                    <div class="seat-input-group">
                        <input type="text" id="seatInput" placeholder="如 5车3A 或 3A" maxlength="10" />
                        <button class="btn-seat" id="seatBtn" onclick="querySeat()">🔍 查询</button>
                    </div>
                </div>
                <div class="seat-result" id="seatResult">
                    <div class="seat-info-grid" id="seatInfoGrid"></div>
                    <div class="seat-features" id="seatFeatures"></div>
                </div>
            </div>

            <!-- 经停站 -->
            <div class="stops-section">
                <div class="stops-header">
                    <span>📍 经停站 <span style="color:rgba(255,255,255,0.03);font-weight:300;text-transform:none;letter-spacing:0;">（按运行方向）</span></span>
                    <span class="count" id="stopsCount">共 0 站</span>
                </div>
                <div class="stops-scroll" id="stopsList"></div>
            </div>

        </div>

    </div>

    <!-- ===== 车站详情弹窗 ===== -->
    <div class="station-modal-overlay" id="stationModal">
        <div class="station-modal">
            <button class="modal-close" onclick="closeStationModal()">✕</button>
            <div class="modal-station-name" id="modalStationName">北京南站</div>
            <div class="modal-station-sub" id="modalStationSub">特等站 · 北京市</div>
            <div class="modal-divider"></div>
            <div class="info-grid" id="modalInfoGrid">
                <div class="info-item">
                    <span class="label">站台</span>
                    <span class="value highlight" id="modalPlatform">--</span>
                </div>
                <div class="info-item">
                    <span class="label">开门方向</span>
                    <span class="value" id="modalDoorDirection">--</span>
                </div>
                <div class="info-item">
                    <span class="label">站台侧</span>
                    <span class="value" id="modalPlatformSide">--</span>
                </div>
                <div class="info-item">
                    <span class="label">股道</span>
                    <span class="value" id="modalTrackNumber">--</span>
                </div>
                <div class="info-item">
                    <span class="label">候车区</span>
                    <span class="value" id="modalWaitingArea">--</span>
                </div>
                <div class="info-item">
                    <span class="label">地标颜色</span>
                    <span class="value" id="modalLandmarkColor">--</span>
                </div>
                <div class="info-item">
                    <span class="label">到达</span>
                    <span class="value" id="modalArriveTime">--</span>
                </div>
                <div class="info-item">
                    <span class="label">发车</span>
                    <span class="value" id="modalDepartTime">--</span>
                </div>
                <div class="info-item">
                    <span class="label">停靠</span>
                    <span class="value" id="modalStopTime">--</span>
                </div>
                <div class="info-item">
                    <span class="label">换乘</span>
                    <span class="value" id="modalNearbyTransport">--</span>
                </div>
            </div>
            <div class="modal-description" id="modalDescription">--</div>
            <div class="modal-actions">
                <button class="btn-close-modal" onclick="closeStationModal()">关闭</button>
            </div>
        </div>
    </div>

    <!-- ============================================================
    JavaScript
    ============================================================ -->
    <script>
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var isQuerying = false;
        var suggestionTimeout = null;
        var currentData = null;
        var autoRefreshInterval = null;

        // ============================================================
        // 设置车次
        // ============================================================
        function setTrain(code) {
            document.getElementById('trainInput').value = code;
            document.getElementById('suggestions').classList.remove('show');
            queryTrain();
        }

        // ============================================================
        // 查询列车
        // ============================================================
        function queryTrain() {
            var input = document.getElementById('trainInput');
            var trainCode = input.value.trim().toUpperCase();

            if (!trainCode || trainCode.length < 2) {
                showError('请输入有效的车次号（如 G1、Z1、K1）');
                return;
            }

            if (isQuerying) return;

            var btn = document.getElementById('searchBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span>';
            document.getElementById('errorMsg').classList.remove('show');
            document.getElementById('suggestions').classList.remove('show');

            fetch('/Train/Query', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ trainCode: trainCode })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    currentData = data.data;
                    renderResult(data.data);
                    startAutoRefresh();
                } else {
                    showError(data.message || '未找到该车次信息');
                    document.getElementById('resultPanel').classList.remove('active');
                }
            })
            .catch(function() {
                showError('网络错误，请重试');
                document.getElementById('resultPanel').classList.remove('active');
            })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = '🚄 追踪';
                isQuerying = false;
            });
        }

        // ============================================================
        // 自动刷新
        // ============================================================
        function startAutoRefresh() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
            }
            autoRefreshInterval = setInterval(function() {
                if (currentData) {
                    refreshProgress(currentData);
                }
            }, 15000);
        }

        function refreshProgress(data) {
            // 模拟进度更新
            var currentProgress = data.progressPercent || 0;
            var newProgress = Math.min(100, currentProgress + (Math.random() * 2 + 0.5));
            data.progressPercent = Math.round(newProgress);

            // 更新进度显示
            document.getElementById('progressValue').textContent = Math.round(newProgress) + '%';
            document.getElementById('progressFill').style.width = Math.round(newProgress) + '%';
            document.getElementById('progressDot').style.left = Math.round(newProgress) + '%';
            document.getElementById('progressText').textContent = Math.round(newProgress) + '%';

            // 更新状态
            if (newProgress > 98) {
                document.getElementById('statusValue').textContent = '🏁 已到达';
                document.getElementById('statusValue').className = 'value arrived';
                document.getElementById('currentStation').textContent = data.endStation || '终点站';
                document.getElementById('nextStation').textContent = '已到终点';
                document.getElementById('nextArrive').textContent = '--';
                clearInterval(autoRefreshInterval);
            } else if (newProgress > 3) {
                // 更新当前站和下一站（根据进度估算）
                var stops = data.detailStops || data.stops || [];
                if (stops.length > 0) {
                    var total = stops.length;
                    var index = Math.floor((newProgress / 100) * (total - 1));
                    index = Math.max(0, Math.min(total - 2, index));
                    var currentStop = stops[index];
                    var nextStop = stops[index + 1];
                    if (currentStop) {
                        document.getElementById('currentStation').textContent = currentStop.stationName || '--';
                        document.getElementById('nextStation').textContent = nextStop ? nextStop.stationName : '已到终点';
                        document.getElementById('nextArrive').textContent = nextStop ? nextStop.arriveTime : '--';
                    }
                }
            }
        }

        // ============================================================
        // 渲染结果
        // ============================================================
        function renderResult(data) {
            // ---- 基本信息 ----
            document.getElementById('trainCode').textContent = data.trainCode;
            document.getElementById('trainType').textContent = data.trainType || '未知';
            document.getElementById('trainBrand').textContent = data.trainBrand || '';
            document.getElementById('startStation').textContent = data.startStation;
            document.getElementById('endStation').textContent = data.endStation;
            document.getElementById('trainDistance').textContent = '· ' + (data.totalDistance || '--');
            document.getElementById('trainDuration').textContent = '全程 ' + (data.totalDuration || '--');
            document.getElementById('trainModel').textContent = (data.trainModel || '--') + ' · ' + (data.maxSpeed || '--');

            var queryTime = data.queryTime ? new Date(data.queryTime) : new Date();
            document.getElementById('queryTime').textContent = '查询：' + queryTime.toLocaleString('zh-CN');

            // ---- 状态 ----
            var statusMap = {
                '未发车': '⏳ 未发车',
                '运行中': '🚄 运行中',
                '停靠中': '🚉 停靠中',
                '已到达': '🏁 已到达'
            };
            var statusEl = document.getElementById('statusValue');
            var statusText = statusMap[data.status] || data.status;
            statusEl.textContent = statusText;
            statusEl.className = 'value ' + (data.status === '已到达' ? 'arrived' :
                                             data.status === '停靠中' ? 'stopping' :
                                             data.status === '运行中' ? 'running' : '');

            document.getElementById('currentStation').textContent = data.currentStation || '--';
            document.getElementById('nextStation').textContent = data.nextStation || '已到终点';
            document.getElementById('nextArrive').textContent = data.nextArriveTime || '--';

            // ---- 进度 ----
            var progress = data.progressPercent || 0;
            document.getElementById('progressValue').textContent = Math.round(progress) + '%';
            document.getElementById('progressFill').style.width = Math.round(progress) + '%';
            document.getElementById('progressDot').style.left = Math.round(progress) + '%';
            document.getElementById('progressText').textContent = Math.round(progress) + '%';

            // ---- 正点 ----
            var delayEl = document.getElementById('delayInfo');
            var delay = data.delayInfo || '正点';
            delayEl.textContent = delay;
            delayEl.className = 'value ' + (delay === '正点' ? 'on-time' : 'delayed');

            // ---- 经停站 ----
            var stops = data.detailStops || data.stops || [];
            // ⭐ 关键修复：确保经停站按运行方向排列（始发站→终点站）
            renderStops(stops, data.currentStation);
            document.getElementById('stopsCount').textContent = '共 ' + stops.length + ' 站';

            // ---- 显示面板 ----
            document.getElementById('resultPanel').classList.add('active');

            // 更新 URL
            try {
                var url = new URL(window.location);
                url.searchParams.set('train', data.trainCode);
                window.history.replaceState({}, '', url);
            } catch(e) {}
        }

        // ============================================================
        // 渲染经停站（正确顺序：始发→终点）
        // ============================================================
        function renderStops(stops, currentStation) {
            var container = document.getElementById('stopsList');
            if (!stops || stops.length === 0) {
                container.innerHTML = '<div class="empty-state"><div class="icon">🚄</div><div class="title">暂无经停站信息</div></div>';
                return;
            }

            var html = '';
            var foundCurrent = false;

            // ⭐ 关键修复：按 StationNo 排序确保正确顺序
            var sortedStops = stops.slice().sort(function(a, b) {
                return (a.stationNo || 0) - (b.stationNo || 0);
            });

            sortedStops.forEach(function(stop, index) {
                var isStart = stop.isStart;
                var isEnd = stop.isEnd;
                var isCurrent = stop.stationName === currentStation && !foundCurrent;

                if (isCurrent) foundCurrent = true;

                // 判断状态
                var dotClass = 'dot';
                var statusClass = 'status-tag future';
                var stationClass = '';
                var statusText = '⬜ 未到';

                if (isStart) {
                    dotClass += ' passed';
                    statusClass = 'status-tag passed';
                    statusText = '始发站';
                } else if (isEnd) {
                    dotClass += ' passed';
                    statusClass = 'status-tag end';
                    statusText = '终点站';
                } else if (isCurrent) {
                    dotClass += ' current';
                    statusClass = 'status-tag current';
                    stationClass = ' highlight';
                    statusText = '🟢 当前站';
                } else if (foundCurrent) {
                    dotClass += ' passed';
                    statusClass = 'status-tag passed';
                    statusText = '✅ 已过';
                } else {
                    dotClass += ' future';
                    statusClass = 'status-tag future';
                    statusText = '⬜ 未到';
                }

                // 时间
                var arriveDisplay = stop.arriveTime || '--';
                var departDisplay = stop.departTime || '--';
                var stopTimeDisplay = stop.stopTime || '--';

                if (isStart) {
                    arriveDisplay = '始发';
                    departDisplay = stop.departTime || '--';
                }
                if (isEnd) {
                    arriveDisplay = stop.arriveTime || '--';
                    departDisplay = '终到';
                }

                // 站台信息
                var platformInfo = stop.platform || '';
                var waitingArea = stop.waitingArea || '';
                var specialNote = stop.specialNote || '';
                var doorDirection = stop.doorDirection || '';
                var stationType = stop.stationType || '';

                // ⭐ 修复：如果到达时间包含"终到"，修正状态
                if (arriveDisplay === '终到' || departDisplay === '终到') {
                    dotClass = 'dot passed';
                    statusClass = 'status-tag end';
                    statusText = '终点站';
                }

                html += `
                    <div class="stop-item" onclick="openStationModal(${index})">
                        <div class="stop-timeline">
                            <div class="${dotClass}"></div>
                            ${index < sortedStops.length - 1 ? `<div class="line-connector ${foundCurrent && !isEnd ? 'passed' : ''}"></div>` : ''}
                        </div>
                        <div class="stop-info">
                            <div class="station">
                                <span class="${stationClass}">${stop.stationName}</span>
                                ${stationType ? `<span class="station-type">${stationType}</span>` : ''}
                                ${isCurrent ? `<span class="current-label">📍 当前</span>` : ''}
                            </div>
                            <div class="times">
                                <span class="arrive">🚉 ${arriveDisplay}</span>
                                <span class="depart">🚄 ${departDisplay}</span>
                                ${!isStart && !isEnd ? `<span class="stop-dur">⏱ ${stopTimeDisplay}</span>` : ''}
                            </div>
                            <div style="display:flex;align-items:center;gap:0.3rem;flex-wrap:wrap;">
                                <span class="${statusClass}">${statusText}</span>
                                ${platformInfo ? `<span class="platform-info"><span class="icon">📍</span> ${platformInfo}</span>` : ''}
                                ${doorDirection ? `<span class="platform-info"><span class="icon">🚪</span> ${doorDirection}</span>` : ''}
                                ${specialNote ? `<span class="platform-info" style="color:rgba(255,255,255,0.03);">${specialNote}</span>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            // 滚动到当前站
            var currentItem = container.querySelector('.dot.current');
            if (currentItem) {
                setTimeout(function() {
                    currentItem.closest('.stop-item').scrollIntoView({ block: 'center', behavior: 'smooth' });
                }, 400);
            }
        }

        // ============================================================
        // 座席状态查询
        // ============================================================
        function querySeat() {
            var input = document.getElementById('seatInput');
            var seatNumber = input.value.trim().toUpperCase();

            if (!seatNumber) {
                showError('请输入座位号，如 5车3A 或 3A');
                return;
            }

            var btn = document.getElementById('seatBtn');
            btn.disabled = true;
            btn.textContent = '⏳';

            fetch('/Train/GetSeatStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ seatNumber: seatNumber })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    renderSeatResult(data.data);
                } else {
                    showError(data.message || '查询失败');
                }
            })
            .catch(function() {
                showError('网络错误，请重试');
            })
            .finally(function() {
                btn.disabled = false;
                btn.textContent = '🔍 查询';
            });
        }

        function renderSeatResult(data) {
            var grid = document.getElementById('seatInfoGrid');
            var features = document.getElementById('seatFeatures');
            var result = document.getElementById('seatResult');

            var statusClass = data.isAvailable ? 'available' : data.isSelected ? 'selected' : 'sold';
            var statusLabel = data.isAvailable ? '✅ 可售' : data.isSelected ? '🟡 已选' : '❌ 已售';

            grid.innerHTML = `
                <div class="seat-item">
                    <span class="label">座位号</span>
                    <span class="value highlight">${data.seatNumber}</span>
                </div>
                <div class="seat-item">
                    <span class="label">车厢类型</span>
                    <span class="value">${data.carriageType || '标准座'}</span>
                </div>
                <div class="seat-item">
                    <span class="label">位置</span>
                    <span class="value">${data.position || '--'}</span>
                </div>
                <div class="seat-item">
                    <span class="label">状态</span>
                    <span class="value ${statusClass}">${statusLabel}</span>
                </div>
                <div class="seat-item">
                    <span class="label">价格</span>
                    <span class="value highlight">${data.price || '--'}</span>
                </div>
                <div class="seat-item">
                    <span class="label">车厢</span>
                    <span class="value">${data.carriage || 1}车</span>
                </div>
            `;

            features.innerHTML = '';
            if (data.features && data.features.length > 0) {
                data.features.forEach(function(f) {
                    var tag = document.createElement('span');
                    tag.className = 'feature-tag';
                    tag.textContent = f;
                    features.appendChild(tag);
                });
            }

            result.classList.add('show');
        }

        // ============================================================
        // 车站详情弹窗
        // ============================================================
        var modalStopIndex = -1;

        function openStationModal(index) {
            var stops = currentData?.detailStops || currentData?.stops || [];
            if (!stops || index < 0 || index >= stops.length) return;

            var stop = stops[index];
            modalStopIndex = index;

            var stationInfo = stop.stationInfo || {};

            document.getElementById('modalStationName').textContent = stop.stationName || '未知车站';
            document.getElementById('modalStationSub').textContent =
                (stationInfo.type || stop.stationType || '普通站') +
                (stationInfo.city ? ' · ' + stationInfo.city : '') +
                (stationInfo.province ? ' · ' + stationInfo.province : '');

            document.getElementById('modalPlatform').textContent = stop.platform || '--';
            document.getElementById('modalDoorDirection').textContent = stop.doorDirection || '不固定';
            document.getElementById('modalPlatformSide').textContent = stop.platformSide || '--';
            document.getElementById('modalTrackNumber').textContent = stop.trackNumber || '--';
            document.getElementById('modalWaitingArea').textContent = stop.waitingArea || '--';
            document.getElementById('modalLandmarkColor').textContent = stop.landmarkColor || '--';
            document.getElementById('modalArriveTime').textContent = stop.arriveTime || '--';
            document.getElementById('modalDepartTime').textContent = stop.departTime || '--';
            document.getElementById('modalStopTime').textContent = stop.stopTime || '--';
            document.getElementById('modalNearbyTransport').textContent = stop.nearbyTransport || stationInfo.nearbyTransport || '暂无信息';

            var desc = stationInfo.description || '';
            var boardingGuide = stop.boardingGuide || '';
            var specialNote = stop.specialNote || '';
            var descriptionParts = [];
            if (boardingGuide) descriptionParts.push(boardingGuide);
            if (specialNote) descriptionParts.push(specialNote);
            if (desc) descriptionParts.push(desc);
            document.getElementById('modalDescription').textContent = descriptionParts.join(' · ') || '暂无更多信息';

            document.getElementById('stationModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeStationModal() {
            document.getElementById('stationModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        document.getElementById('stationModal').addEventListener('click', function(e) {
            if (e.target === this) closeStationModal();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeStationModal();
        });

        // ============================================================
        // 自动补全
        // ============================================================
        function setupSuggestions() {
            var input = document.getElementById('trainInput');
            var dropdown = document.getElementById('suggestions');

            input.addEventListener('input', function() {
                var query = this.value.trim().toUpperCase();
                if (query.length < 1) {
                    dropdown.classList.remove('show');
                    return;
                }

                clearTimeout(suggestionTimeout);
                suggestionTimeout = setTimeout(function() {
                    fetch('/Train/GetSuggestions?query=' + encodeURIComponent(query))
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            if (data && data.length > 0) {
                                var html = '';
                                data.forEach(function(code) {
                                    var type = code.charAt(0);
                                    var typeLabel = type === 'G' ? '高铁' : type === 'D' ? '动车' :
                                                    type === 'C' ? '城际' : type === 'Z' ? '直达' :
                                                    type === 'T' ? '特快' : type === 'K' ? '快速' : '普速';
                                    html += `<div class="suggestion-item" onclick="selectSuggestion('${code}')">
                                                ${code}
                                                <span class="s-tag">${typeLabel}</span>
                                            </div>`;
                                });
                                dropdown.innerHTML = html;
                                dropdown.classList.add('show');
                            } else {
                                dropdown.classList.remove('show');
                            }
                        })
                        .catch(function() { dropdown.classList.remove('show'); });
                }, 200);
            });

            input.addEventListener('blur', function() {
                setTimeout(function() { dropdown.classList.remove('show'); }, 200);
            });

            input.addEventListener('focus', function() {
                if (this.value.trim().length > 0) {
                    this.dispatchEvent(new Event('input'));
                }
            });
        }

        function selectSuggestion(code) {
            document.getElementById('trainInput').value = code;
            document.getElementById('suggestions').classList.remove('show');
            queryTrain();
        }

        // ============================================================
        // 错误提示
        // ============================================================
        function showError(msg) {
            var el = document.getElementById('errorMsg');
            el.textContent = msg;
            el.classList.add('show');
            setTimeout(function() {
                el.classList.remove('show');
            }, 5000);
        }

        // ============================================================
        // 自动全屏
        // ============================================================
        function goFullscreen() {
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(function() {});
            }
        }

        // ============================================================
        // 快捷键
        // ============================================================
        document.addEventListener('keydown', function(e) {
            // Ctrl+Enter 查询
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                queryTrain();
            }
            // ESC 退出全屏
            if (e.key === 'Escape' && document.fullscreenElement) {
                document.exitFullscreen().catch(function() {});
            }
            // F 全屏切换
            if (e.key === 'f' && e.ctrlKey) {
                e.preventDefault();
                if (document.fullscreenElement) {
                    document.exitFullscreen().catch(function() {});
                } else {
                    goFullscreen();
                }
            }
        });

        // ============================================================
        // 初始化
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            // 自动补全
            setupSuggestions();

            // 回车查询
            document.getElementById('trainInput').addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    queryTrain();
                }
            });

            // 座席输入回车
            document.getElementById('seatInput').addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    querySeat();
                }
            });

            // 从 URL 参数自动查询
            var urlParams = new URLSearchParams(window.location.search);
            var trainParam = urlParams.get('train');
            if (trainParam) {
                document.getElementById('trainInput').value = trainParam;
                setTimeout(queryTrain, 500);
            }

            if (!trainParam) {
                document.getElementById('trainInput').focus();
            }

            // 自动全屏（延迟执行，让用户先看到内容）
            setTimeout(goFullscreen, 1000);
        });
    </script>

</body>
</html>
