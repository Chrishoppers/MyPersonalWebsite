@{
    ViewData["Title"] = "🚄 列车实时追踪";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<style>
    .train-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .train-header {
        text-align: center;
        padding: 1rem 0 1.5rem;
    }

    .train-header h1 {
        font-size: 2.2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.2rem;
    }

    .train-header .subtitle {
        color: rgba(255,255,255,0.2);
        font-size: 0.9rem;
    }

    /* 搜索栏 */
    .search-box {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.5rem 2rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }

    .search-box input {
        padding: 0.8rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #fff;
        font-size: 1.1rem;
        min-width: 200px;
        outline: none;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        border-color: rgba(139,92,246,0.2);
        background: rgba(255,255,255,0.05);
    }

    .search-box input::placeholder {
        color: rgba(255,255,255,0.15);
    }

    .search-box .btn-search {
        padding: 0.8rem 2.5rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .search-box .btn-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .search-box .btn-search:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .search-box .hint-text {
        color: rgba(255,255,255,0.08);
        font-size: 0.75rem;
    }

    /* ===== 结果面板 ===== */
    .result-panel {
        display: none;
        animation: fadeIn 0.5s ease;
    }

    .result-panel.active {
        display: block;
    }

    /* 列车信息头 */
    .train-info-header {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.2rem 2rem;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .train-info-header .train-code {
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .train-info-header .train-code .type-badge {
        font-size: 0.7rem;
        padding: 0.2rem 0.8rem;
        border-radius: 20px;
        background: rgba(139,92,246,0.12);
        color: #8B5CF6;
        border: 1px solid rgba(139,92,246,0.06);
        font-weight: 500;
    }

    .train-info-header .train-route {
        color: rgba(255,255,255,0.3);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .train-info-header .train-route .arrow {
        color: rgba(139,92,246,0.3);
    }

    .train-info-header .train-time {
        color: rgba(255,255,255,0.15);
        font-size: 0.75rem;
    }

    /* ===== 实时状态卡片 ===== */
    .status-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .status-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        text-align: center;
    }

    .status-card .label {
        color: rgba(255,255,255,0.2);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-card .value {
        color: #fff;
        font-size: 1.2rem;
        font-weight: 600;
        margin-top: 0.2rem;
    }

    .status-card .value .highlight {
        color: #8B5CF6;
    }

    .status-card .value .on-time { color: #28a745; }
    .status-card .value .delayed { color: #dc3545; }
    .status-card .value .running { color: #4facfe; }
    .status-card .value .arrived { color: #28a745; }

    /* ===== 进度条 ===== */
    .progress-section {
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .progress-section .progress-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.15);
        margin-bottom: 0.3rem;
    }

    .progress-section .progress-track {
        width: 100%;
        height: 6px;
        background: rgba(255,255,255,0.04);
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .progress-section .progress-track .progress-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
    }

    .progress-section .progress-track .progress-dot {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #8B5CF6;
        border: 2px solid #0a0a0f;
        box-shadow: 0 0 20px rgba(139,92,246,0.3);
        transition: left 0.5s ease;
    }

    .progress-section .progress-text {
        text-align: center;
        color: rgba(255,255,255,0.15);
        font-size: 0.7rem;
        margin-top: 0.3rem;
    }

    /* ===== 经停站流程图 ===== */
    .stops-flow {
        position: relative;
        padding: 1rem 0;
    }

    .stops-flow .line {
        position: absolute;
        top: 40px;
        left: 40px;
        right: 40px;
        height: 2px;
        background: rgba(255,255,255,0.04);
    }

    .stops-flow .line .line-fill {
        height: 100%;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        transition: width 0.5s ease;
    }

    .stop-item {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        padding: 0.6rem 1rem;
        border-radius: 12px;
        margin-bottom: 0.3rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .stop-item:hover {
        background: rgba(255,255,255,0.02);
    }

    .stop-item .stop-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 0.3rem;
        border: 2px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        transition: all 0.3s ease;
        position: relative;
        z-index: 2;
    }

    .stop-item .stop-dot.passed {
        background: #8B5CF6;
        border-color: #8B5CF6;
        box-shadow: 0 0 20px rgba(139,92,246,0.15);
    }

    .stop-item .stop-dot.current {
        background: #EC4899;
        border-color: #EC4899;
        box-shadow: 0 0 30px rgba(236,72,153,0.3);
        animation: pulse 1.5s ease-in-out infinite;
    }

    .stop-item .stop-dot.future {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.04);
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.3); }
    }

    .stop-item .stop-info {
        flex: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-bottom: 0.3rem;
        border-bottom: 1px solid rgba(255,255,255,0.02);
    }

    .stop-item:last-child .stop-info {
        border-bottom: none;
    }

    .stop-item .stop-info .station {
        font-weight: 500;
        color: rgba(255,255,255,0.6);
        min-width: 80px;
    }

    .stop-item .stop-info .station .highlight {
        color: #fff;
        font-weight: 600;
    }

    .stop-item .stop-info .station .current-label {
        font-size: 0.55rem;
        padding: 0.05rem 0.5rem;
        border-radius: 20px;
        background: rgba(236,72,153,0.12);
        color: #EC4899;
        border: 1px solid rgba(236,72,153,0.06);
        margin-left: 0.5rem;
    }

    .stop-item .stop-info .times {
        color: rgba(255,255,255,0.2);
        font-size: 0.75rem;
        display: flex;
        gap: 0.8rem;
        align-items: center;
    }

    .stop-item .stop-info .times .arrive {
        color: rgba(255,255,255,0.15);
    }

    .stop-item .stop-info .times .depart {
        color: rgba(255,255,255,0.25);
    }

    .stop-item .stop-info .times .stop-duration {
        color: rgba(255,255,255,0.08);
        font-size: 0.65rem;
    }

    .stop-item .stop-info .status-tag {
        font-size: 0.6rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        font-weight: 500;
    }

    .stop-item .stop-info .status-tag.passed {
        color: #28a745;
        background: rgba(40,167,69,0.08);
        border: 1px solid rgba(40,167,69,0.04);
    }

    .stop-item .stop-info .status-tag.current {
        color: #EC4899;
        background: rgba(236,72,153,0.08);
        border: 1px solid rgba(236,72,153,0.04);
        animation: pulseText 1.5s ease-in-out infinite;
    }

    .stop-item .stop-info .status-tag.future {
        color: rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255
