    function buildDailyBanner(daily) {
        var cards = [];
        try { cards = JSON.parse(daily.cardsJson || '[]'); } catch (e) {}
        var card = (cards.length && DECK.length > cards[0].cardId) ? DECK[cards[0].cardId] : null;
        if (!card) {
            return '<div class="daily-banner"><div class="db-title">🌞 今日运势已生成</div></div>';
        }
        var f = dailyFortune(card);
        var starStr = '';
        for (var i = 0; i < 5; i++) starStr += (i < f.stars ? '★' : '☆');
        return '<div class="daily-banner">' +
            '<div class="db-title">🌞 今日运势 · ' + escapeHtml(card.name) + (cards[0].reversed ? '（逆）' : '（正）') + '</div>' +
            '<div class="db-stars">' + starStr + ' <span>' + f.stars + '/5</span></div>' +
            '<div class="db-line">🍀 幸运色 ' + f.color + ' · 🔢 幸运数字 ' + f.num + '</div>' +
            '<div class="db-line">' + f.yi + ' · ' + f.ji + '</div>' +
            '</div>';
    }

