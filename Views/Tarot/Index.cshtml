    function loadHistory() {
        $('historyList').innerHTML = '<div class="history-empty">加载中…</div>';
        fetch('/api/tarot/history?limit=30')
            .then(function (r) { return r.json(); })
            .then(function (data) { renderHistory(data && data.list ? data.list : []); })
            .catch(function () { $('historyList').innerHTML = '<div class="history-empty">加载失败，请稍后再试</div>'; });
    }

    function renderHistory(list) {
        var el = $('historyList');
        if (!list.length) { el.innerHTML = '<div class="history-empty">暂无记录，快去占卜一次吧 ✨</div>'; return; }
        var html = '';
        list.forEach(function (item) {
            var cards = [];
            try { cards = JSON.parse(item.cardsJson || '[]'); } catch (e) {}
            var pills = cards.map(function (c) {
                return '<span class="h-card">' + escapeHtml(c.positionName) + ' · ' + escapeHtml(c.name) +
                    (c.reversed ? ' <span class="h-rev">逆</span>' : '') + '</span>';
            }).join('');
            html += '<div class="history-item">' +
                '<div class="history-item-head"><span class="h-spread">' + escapeHtml(item.spread) + '</span><span class="h-time">' + escapeHtml(item.createdAt) + '</span></div>' +
                '<div class="h-question">' + escapeHtml(item.question) + '</div>' +
                '<div class="h-cards">' + pills + '</div>' +
                '<div class="history-result" style="display:none;">' + mdToHtml(item.resultJson) + '</div>' +
                '</div>';
        });
        el.innerHTML = html;
        el.querySelectorAll('.history-item').forEach(function (it) {
            it.addEventListener('click', function () {
                var res = it.querySelector('.history-result');
                res.style.display = res.style.display === 'none' ? 'block' : 'none';
            });
        });
    }

