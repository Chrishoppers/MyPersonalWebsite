        readBtn.style.display = 'none';
        readBtn.addEventListener('click', function () { ensureAudio(); startReading(); });
        document.querySelector('.draw-controls').appendChild(readBtn);
        setInterval(function () {
            if (spread && drawn.length >= spread.cardCount && !reading) readBtn.style.display = 'inline-block';
