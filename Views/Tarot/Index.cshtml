        $('disclaimerBtn').addEventListener('click', function () { $('dscOverlay').style.display = 'flex'; });
        $('dscClose').addEventListener('click', function () { $('dscOverlay').style.display = 'none'; });
        $('dscOverlay').addEventListener('click', function (e) { if (e.target === this) $('dscOverlay').style.display = 'none'; });
        $('introClose').addEventListener('click', function () {
            $('introSplash').style.transition = 'opacity 0.5s ease';
            $('introSplash').style.opacity = '0';
            setTimeout(function () { $('introSplash').style.display = 'none'; }, 500);
        });
        document.querySelectorAll('.cm-btn').forEach(function (b) {
            b.addEventListener('click', function () {
                document.querySelectorAll('.cm-btn').forEach(function (x) { x.classList.remove('active'); });
                b.classList.add('active');
                CARD_MODE = b.dataset.mode;
                try { localStorage.setItem('tarot_card_mode', CARD_MODE); } catch (e) {}
            });
        });
        $('followupSendBtn').addEventListener('click', sendFollowup);
        $('followupInput').addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendFollowup(); }
        });
    }

    // ============================================================
    // 初始化
    // ============================================================
    function refreshStatus() {
        fetch('/api/tarot/status')
            .then(function (r) { return r.json(); })
            .then(function (data) { STATUS = data; applyStatusUI(); })
            .catch(function () {});
    }

    function init() {
        startStars();
        try { CARD_MODE = localStorage.getItem('tarot_card_mode') || 'simple'; } catch (e) {}
        document.querySelectorAll('.cm-btn').forEach(function (b) { b.classList.toggle('active', b.dataset.mode === CARD_MODE); });
        bind();
        fetch('/api/tarot/deck')
            .then(function (r) { return r.json(); })
            .then(function (data) { if (data && data.cards) DECK = data.cards; })
            .catch(function () {});
        refreshStatus();
    }

    init();
})();
</script>
