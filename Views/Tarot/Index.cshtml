    // ============================================================
    // 每日一签 & 是否牌阵
    // ============================================================
    var LUCKY_COLORS = ['金色', '紫色', '玫瑰红', '天蓝', '翡翠绿', '月光银', '琥珀橙', '靛青'];
    var YI = ['宜：大胆尝试', '宜：整理思绪', '宜：主动沟通', '宜：静心阅读', '宜：亲近自然', '宜：表达爱意', '宜：制定小计划', '宜：犒赏自己'];
    var JI = ['忌：冲动决定', '忌：熬夜', '忌：翻旧账', '忌：拖延', '忌：过度消费', '忌：猜疑', '忌：逞强', '忌：三心二意'];

    function cardPositivity(card) {
        var good = { 0: 1, 1: 1, 3: 1, 6: 1, 7: 1, 8: 1, 10: 1, 14: 1, 17: 1, 19: 1, 21: 1 };
        var bad = { 12: 1, 13: 1, 15: 1, 16: 1, 18: 1 };
        if (card.arcana === 'major') {
            if (good[card.id]) return 5;
            if (bad[card.id]) return 2;
            return 3;
        }
        if (card.suit === 'swords' && (card.name.indexOf('九') >= 0 || card.name.indexOf('十') >= 0)) return 2;
        if (card.rank === '王牌' || card.rank === '国王' || card.rank === '王后') return 5;
        return 3;
    }

    function dailyFortune(card) {
        var d = new Date();
        var dateStr = '' + d.getFullYear() + (d.getMonth() + 1) + d.getDate();
        var rnd = mulberry32(parseInt(dateStr, 10) * 131 + card.id);
        var stars = Math.max(2, Math.min(5, cardPositivity(card) + (rnd() < 0.5 ? 0 : 1)));
        return {
            stars: stars,
            color: LUCKY_COLORS[Math.floor(rnd() * LUCKY_COLORS.length)],
            num: 1 + Math.floor(rnd() * 9),
            yi: YI[Math.floor(rnd() * YI.length)],
            ji: JI[Math.floor(rnd() * JI.length)]
        };
    }

    function renderDailyFortune(card) {
        var f = dailyFortune(card);
        var starStr = '';
        for (var i = 0; i < 5; i++) starStr += (i < f.stars ? '★' : '☆');
        return '<div class="fortune-box">' +
            '<div class="fortune-title">🌞 今日运势 · ' + escapeHtml(card.name) + '</div>' +
            '<div class="fortune-stars">' + starStr + ' <span>(' + f.stars + '/5)</span></div>' +
            '<div class="fortune-grid">' +
            '<div class="fortune-item"><span>🍀 幸运色</span><b>' + f.color + '</b></div>' +
            '<div class="fortune-item"><span>🔢 幸运数字</span><b>' + f.num + '</b></div>' +
            '</div>' +
            '<div class="fortune-line">' + f.yi + '</div>' +
            '<div class="fortune-line">' + f.ji + '</div>' +
            '</div>';
    }

    function yesNoVerdict(cards) {
        var up = 0, rev = 0;
        cards.forEach(function (d) { if (d.reversed) rev++; else up++; });
        if (up === 3) return '✅ 是 · 强烈肯定';
        if (up === 2) return '✅ 是 · 倾向肯定';
        if (rev === 3) return '❌ 否 · 强烈否定';
        return '❌ 否 · 倾向否定';
    }

    // ============================================================
    // 解读
    // ============================================================
    function startReading() {
        reading = true;
        showPhase('phase-reading');
        $('readingStatus').innerHTML = '<span class="shimmer">✨ AI 正在与牌灵沟通，为你解读中…</span><div class="ai-progress"><div class="ai-progress-bar"></div></div>';
        var body = $('readingBody');
        body.innerHTML = '';
        if (spread.daily && drawn.length) body.innerHTML = renderDailyFortune(drawn[0].card);
        if (spread.yesno && drawn.length === spread.cardCount) body.innerHTML = '<div class="verdict-banner">' + yesNoVerdict(drawn) + '</div>';

        var q = spread.daily ? '今日运势' : ($('qInput').value || '').trim();
        var verdict = spread.yesno ? yesNoVerdict(drawn) : null;

        var payload = {
            question: q,
            spread: spread.name,
            verdict: verdict,
            isDaily: !!spread.daily,
            cards: drawn.map(function (d) {
                return { positionName: d.pos.name + '（' + d.pos.sub + '）', cardId: d.card.id, reversed: d.reversed };
            })
        };

        FOLLOWUP_CTX = {
            question: q,
            spread: spread.name,
            cards: payload.cards,
            content: ''
        };
        $('followupSection').style.display = 'none';
        $('followupInput').value = '';

        fetch('/api/tarot/interpret', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data && data.success && data.content) {
                if (data.cached) {
                    // 每日一签已测过：展示缓存结果
                    var cards = [];
                    try { cards = JSON.parse(data.cardsJson || '[]'); } catch (e) {}
                    var card = (cards.length && DECK.length > cards[0].cardId) ? DECK[cards[0].cardId] : null;
                    if (card) $('readingBody').innerHTML = renderDailyFortune(card);
                    renderReading(data.content, false, '', data.warning);
                } else {
                    renderReading(data.content, data.fallback, data.errorDetail, data.warning);
                }
                if (FOLLOWUP_CTX) FOLLOWUP_CTX.content = data.content;
                showFollowupSection();
                // 刷新状态（每日一签/次数）
                refreshStatus();
            } else if (data && data.message) {
                $('readingStatus').innerHTML = '⚠️ ' + escapeHtml(data.message);
            } else {
                $('readingStatus').innerHTML = '⚠️ 解读暂时无法完成，请稍后再试。';
            }
        })
        .catch(function () { $('readingStatus').innerHTML = '⚠️ 网络异常，解读失败，请稍后再试。'; });
    }

    function renderReading(md, fallback, errorDetail, warning) {
        if (fallback) {
            $('readingStatus').innerHTML = '🌙 本次为本地牌义解读（AI 服务暂不可用）' +
                (errorDetail ? '<div style="font-size:0.72rem;color:rgba(255,255,255,0.35);margin-top:5px;">' + escapeHtml(errorDetail) + '</div>' : '');
        } else {
            $('readingStatus').innerHTML = '🌙 解读完成 · 愿你听见内心的声音';
        }
        var body = $('readingBody');
        if (warning) {
            var wb = document.createElement('div');
            wb.className = 'warning-banner';
            wb.textContent = warning;
            body.insertBefore(wb, body.firstChild);
        }
        var wrapper = document.createElement('div');
        wrapper.className = 'reading-ai';
        wrapper.innerHTML = mdToHtml(md);
        body.appendChild(wrapper);
        var blocks = wrapper.querySelectorAll('h2, h3, p, ul, .reading-summary-box');
        for (var i = 0; i < blocks.length; i++) blocks[i].classList.add('rv-block');
        requestAnimationFrame(function () {
            for (var j = 0; j < blocks.length; j++) {
                (function (el, delay) { setTimeout(function () { el.classList.add('show'); }, delay); })(blocks[j], j * 90);
            }
        });
    }

