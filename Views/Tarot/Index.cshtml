    function sendFollowup() {
        var msg = ($('followupInput').value || '').trim();
        if (!msg) { toast('请输入追问或补充说明'); return; }
        if (!FOLLOWUP_CTX) return;
        if (STATUS && typeof STATUS.remaining === 'number' && STATUS.remaining <= 0) {
            toast('今日占卜次数已用完，无法追问');
            return;
        }
        var btn = $('followupSendBtn');
        btn.disabled = true; btn.textContent = '⏳ 思考中…';

        var payload = {
            originalQuestion: FOLLOWUP_CTX.question,
            spread: FOLLOWUP_CTX.spread,
            previousContent: FOLLOWUP_CTX.content,
            message: msg,
            cards: FOLLOWUP_CTX.cards
        };

        fetch('/api/tarot/followup', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
