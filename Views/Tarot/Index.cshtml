    function shuffle(a) {
        var arr = a.slice();
        for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
        }
        return arr;
    }

    function easeInOutCubic(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
    function easeOutBack(t) { var c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2); }

    function mulberry32(a) {
        return function () {
            a |= 0; a = a + 0x6D2B79F5 | 0;
            var t = Math.imul(a ^ a >>> 15, 1 | a);
            t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
            return ((t ^ t >>> 14) >>> 0) / 4294967296;
        };
    }

    function suitColor(card) {
        if (card.arcana === 'major') return '#f4d07a';
        if (card.suit === 'wands') return '#ff9a5a';
        if (card.suit === 'cups') return '#6fc3ff';
        if (card.suit === 'swords') return '#a9c4e8';
        if (card.suit === 'pentacles') return '#7fd98b';
        return '#f4d07a';
    }

    function cardGrad(card) {
        if (card.arcana === 'major') return 'linear-gradient(160deg, #3b2a6e 0%, #241455 55%, #150e34 100%)';
        if (card.suit === 'wands') return 'linear-gradient(160deg, #6b2a12 0%, #4a1a0a 55%, #2a0f06 100%)';
        if (card.suit === 'cups') return 'linear-gradient(160deg, #0f3a5e 0%, #0a2440 55%, #061426 100%)';
        if (card.suit === 'swords') return 'linear-gradient(160deg, #33455e 0%, #22303f 55%, #131c26 100%)';
        if (card.suit === 'pentacles') return 'linear-gradient(160deg, #2a5a34 0%, #1a3d22 55%, #0d2312 100%)';
        return 'linear-gradient(160deg, #2a1f4d 0%, #170f30 100%)';
    }

    var RANK_NUM = { '王牌': 1, '二': 2, '三': 3, '四': 4, '五': 5, '六': 6, '七': 7, '八': 8, '九': 9, '十': 10 };

    function courtGlyph(rank) {
        if (rank === '侍从') return '🎴';
        if (rank === '骑士') return '🐎';
        if (rank === '王后') return '👑';
        if (rank === '国王') return '🤴';
        return '';
    }

    function backDesignHTML() {
        return '<div class="tcard-back-design">' +
            '<div class="back-ring"></div><div class="back-ring2"></div>' +
            '<div class="back-center"><span class="back-moon">☾</span><span class="back-eye">🔮</span></div>' +
            '<span class="back-stars">✦ ✦ ✦ ✦</span>' +
            '<span class="back-corner tl"></span><span class="back-corner tr"></span>' +
            '<span class="back-corner bl"></span><span class="back-corner br"></span>' +
            '</div>';
    }

    function pipsHTML(symbol, n) {
        var h = '';
        for (var i = 0; i < n; i++) h += '<span class="cf-pip">' + symbol + '</span>';
        return h;
    }

    var ORIGINAL_MAJOR = {
        'The Fool': 'Fool', 'The Magician': 'Magician', 'The High Priestess': 'High_Priestess',
        'The Empress': 'Empress', 'The Emperor': 'Emperor', 'The Hierophant': 'Hierophant',
        'The Lovers': 'Lovers', 'The Chariot': 'Chariot', 'Strength': 'Strength',
        'The Hermit': 'Hermit', 'Wheel of Fortune': 'Wheel_of_Fortune', 'Justice': 'Justice',
        'The Hanged Man': 'Hanged_Man', 'Death': 'Death', 'Temperance': 'Temperance',
        'The Devil': 'Devil', 'The Tower': 'Tower', 'The Star': 'Star', 'The Moon': 'Moon',
        'The Sun': 'Sun', 'Judgement': 'Judgement', 'The World': 'World'
    };

    function originalImageUrl(card) {
        var base = 'https://raw.githubusercontent.com/look-fate/tarot-lab/main/SimpleTarotPng/';
        if (card.arcana === 'major') {
            var name = ORIGINAL_MAJOR[card.nameEn];
            return name ? (base + name + '.jpg') : '';
        }
        var suits = ['Wands', 'Cups', 'Swords', 'Pents'];
        var idx = Math.floor((card.id - 22) / 14);
        var rankNum = ((card.id - 22) % 14) + 1;
        if (idx < 0 || idx >= suits.length) return '';
        return base + suits[idx] + (rankNum < 10 ? '0' + rankNum : '' + rankNum) + '.jpg';
    }

    function frontHTML(card, reversed) {
        var isMajor = card.arcana === 'major';
        var isCourt = !isMajor && (card.rank === '侍从' || card.rank === '骑士' || card.rank === '王后' || card.rank === '国王');
        var rankNum = (!isMajor && !isCourt) ? (RANK_NUM[card.rank] || 0) : 0;

        var topLabel;
        if (isMajor) topLabel = card.roman;
        else if (isCourt) topLabel = card.rank;
        else topLabel = rankNum === 1 ? 'A' : String(rankNum);

        var center;
        if (isMajor) {
            center = '<div class="cf-medallion"><span class="cf-symbol">' + card.symbol + '</span></div>';
        } else if (isCourt) {
            center = '<div class="cf-medallion"><span class="cf-symbol">' + card.symbol + '</span><span class="cf-court">' + courtGlyph(card.rank) + '</span></div>';
        } else {
            center = '<div class="cf-pips">' + pipsHTML(card.symbol, rankNum) + '</div>';
        }

        var img = '';
        if (CARD_MODE === 'original') {
            var url = originalImageUrl(card);
            if (url) img = '<img class="tcard-img" src="' + url + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />';
        }

        return '<div class="tcard-front-inner">' +
            '<span class="cf-corner tl"></span><span class="cf-corner tr"></span>' +
            '<span class="cf-corner bl"></span><span class="cf-corner br"></span>' +
            '<div class="cf-top"><span class="cf-num">' + topLabel + '</span></div>' +
            '<div class="cf-center">' + center + '</div>' +
            '<div class="cf-bottom"><div class="cf-name">' + card.name + '</div><div class="cf-en">' + card.nameEn + '</div></div>' +
            '</div>' + img +
            '<div class="tcard-badge">' + (reversed ? '逆位' : '正位') + '</div>';
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ============================================================
    // 音效
    // ============================================================
    var AC = null;
    function ensureAudio() {
        try {
            if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)();
            if (AC.state === 'suspended') AC.resume();
        } catch (e) { AC = null; }
    }
    function tone(freq, dur, type, vol) {
        if (!AC) return;
        try {
            var o = AC.createOscillator(), g = AC.createGain();
            o.type = type || 'sine'; o.frequency.value = freq;
            g.gain.setValueAtTime(vol || 0.1, AC.currentTime);
            g.gain.exponentialRampToValueAtTime(0.0001, AC.currentTime + dur);
            o.connect(g); g.connect(AC.destination);
            o.start(); o.stop(AC.currentTime + dur);
        } catch (e) {}
    }
    function sndWhoosh() { tone(220, 0.4, 'sawtooth', 0.06); tone(180, 0.5, 'sawtooth', 0.05); }
    function sndChime() { tone(880, 0.4, 'sine', 0.08); setTimeout(function () { tone(1320, 0.5, 'sine', 0.07); }, 90); }
    function sndShuffle() { for (var i = 0; i < 6; i++) setTimeout(function () { tone(400 + Math.random() * 400, 0.07, 'triangle', 0.05); }, i * 60); }

    // ============================================================
    // 粒子 / 特效
    // ============================================================
    function burst(x, y, color) {
        var overlay = $('flyOverlay');
        var n = 16;
        for (var i = 0; i < n; i++) {
            var p = document.createElement('div');
            var size = 3 + Math.random() * 5;
            var ang = Math.random() * Math.PI * 2;
            var dist = 34 + Math.random() * 80;
            var dx = Math.cos(ang) * dist, dy = Math.sin(ang) * dist;
            p.style.cssText = 'position:absolute;left:' + x + 'px;top:' + y + 'px;width:' + size + 'px;height:' + size + 'px;' +
                'border-radius:50%;background:' + color + ';box-shadow:0 0 8px ' + color + ';pointer-events:none;' +
                'transition:transform 0.95s cubic-bezier(0.2,0.6,0.3,1), opacity 0.95s ease;opacity:1;';
            overlay.appendChild(p);
            requestAnimationFrame(function () {
                p.style.transform = 'translate(' + dx + 'px,' + dy + 'px) scale(0.2)';
                p.style.opacity = '0';
            });
            (function (el) { setTimeout(function () { el.remove(); }, 1000); })(p);
        }
    }

    function screenShake(strength) {
        var page = document.querySelector('.tarot-page');
        var st = (strength || 10);
        var start = Date.now(), dur = 350;
        var iv = setInterval(function () {
            var p = (Date.now() - start) / dur;
            if (p >= 1) { clearInterval(iv); page.style.transform = ''; return; }
            var k = (1 - p) * st;
            page.style.transform = 'translate(' + (Math.random() - 0.5) * k * 2 + 'px,' + (Math.random() - 0.5) * k * 2 + 'px)';
        }, 16);
    }

    function toast(text) {
        var el = document.createElement('div');
        el.className = 'float-toast'; el.textContent = text;
        document.body.appendChild(el);
        setTimeout(function () { el.remove(); }, 1500);
    }

    // ============================================================
    // 星空背景
    // ============================================================
    function startStars() {
        var canvas = $('starCanvas');
        var ctx = canvas.getContext('2d');
        var stars = [];
        var meteor = null;
        function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
        resize(); window.addEventListener('resize', resize);
        var count = Math.min(160, Math.floor(window.innerWidth * window.innerHeight / 9000));
        for (var i = 0; i < count; i++) {
            stars.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, r: Math.random() * 1.4 + 0.3, tw: Math.random() * Math.PI * 2, sp: 0.02 + Math.random() * 0.05 });
        }
        function spawnMeteor() {
            meteor = {
                x: Math.random() * canvas.width * 0.8 + canvas.width * 0.2,
                y: Math.random() * canvas.height * 0.4,
                vx: -(6 + Math.random() * 8),
                vy: (3 + Math.random() * 4),
                life: 0, maxLife: 40 + Math.random() * 30
            };
        }
        function frame() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (var i = 0; i < stars.length; i++) {
                var s = stars[i]; s.tw += s.sp;
                var a = 0.3 + Math.abs(Math.sin(s.tw)) * 0.7;
                ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255,255,255,' + a + ')'; ctx.fill();
            }
            if (!meteor && Math.random() < 0.01) spawnMeteor();
            if (meteor) {
                meteor.x += meteor.vx; meteor.y += meteor.vy; meteor.life++;
                var fade = 1 - meteor.life / meteor.maxLife;
                var tailX = meteor.x - meteor.vx * 6, tailY = meteor.y - meteor.vy * 6;
                var grad = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
                grad.addColorStop(0, 'rgba(244,208,122,' + (0.9 * fade) + ')');
                grad.addColorStop(1, 'rgba(244,208,122,0)');
                ctx.strokeStyle = grad;
                ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(meteor.x, meteor.y); ctx.lineTo(tailX, tailY); ctx.stroke();
                if (meteor.life >= meteor.maxLife) meteor = null;
            }
            requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
    }

    // ============================================================
    // 阶段切换
    // ============================================================
    function showPhase(id) {
        var phases = document.querySelectorAll('.phase');
        for (var i = 0; i < phases.length; i++) phases[i].classList.remove('active');
        $(id).classList.add('active');
        if (id === 'phase-draw' || id === 'phase-reading') $('board').classList.add('visible');
        else $('board').classList.remove('visible');
        if (id !== 'phase-draw') window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ============================================================
    // 牌阵棋盘构建
    // ============================================================
    function buildBoard() {
        var board = $('board');
        board.className = 'board';
        board.innerHTML = '';
        if (spread.layout === 'celtic') {
            board.classList.add('board-celtic');
            var cross = document.createElement('div'); cross.className = 'cross';
            var grid = document.createElement('div'); grid.className = 'cross-grid';
            var crossCells = ['top', 'left', 'center', 'right', 'bottom'];
            var crossingPos = null;
            for (var i = 0; i < spread.positions.length; i++) {
                var pos = spread.positions[i];
                if (pos.area === 'crossing') { crossingPos = pos; continue; }
                if (crossCells.indexOf(pos.area) >= 0) grid.appendChild(buildSlot(pos));
            }
            cross.appendChild(grid);

            // 横跨牌：只放横置的牌，叠加在中间主位之上；文字用浮动标签，避免重叠
            var crossing = document.createElement('div');
            crossing.className = 'slot crossing';
            crossing.dataset.key = crossingPos.key;
            crossing.innerHTML = '<div class="slot-card"></div>';
            cross.appendChild(crossing);

            var tag = document.createElement('div');
            tag.className = 'crossing-tag';
            tag.innerHTML = '<span class="slot-name">' + crossingPos.name + '</span><span class="slot-sub">' + crossingPos.sub + '</span>';
            cross.appendChild(tag);

            var staff = document.createElement('div'); staff.className = 'staff';
            var staffOrder = ['staff1', 'staff2', 'staff3', 'staff4'];
            for (var s = 0; s < staffOrder.length; s++) {
                for (var j = 0; j < spread.positions.length; j++) {
                    if (spread.positions[j].area === staffOrder[s]) staff.appendChild(buildSlot(spread.positions[j]));
                }
            }
            board.appendChild(cross);
            board.appendChild(staff);
        } else if (spread.layout === 'grid') {
            board.classList.add('board-grid');
            var tarotGrid = document.createElement('div');
            tarotGrid.className = 'tarot-grid';
            tarotGrid.style.gridTemplateAreas = spread.grid.map(function (r) { return '"' + r + '"'; }).join(' ');
            for (var g = 0; g < spread.positions.length; g++) tarotGrid.appendChild(buildSlot(spread.positions[g]));
            board.appendChild(tarotGrid);
        } else {
            board.classList.add('board-row');
            for (var k = 0; k < spread.positions.length; k++) board.appendChild(buildSlot(spread.positions[k]));
        }
        updateProgress();
    }

    function buildSlot(pos) {
        var slot = document.createElement('div');
        slot.className = 'slot'; slot.dataset.key = pos.key;
        slot.style.gridArea = pos.area;
        slot.innerHTML =
            '<div class="slot-label"><span class="slot-name">' + pos.name + '</span><span class="slot-sub">' + pos.sub + '</span></div>' +
            '<div class="slot-card"></div>';
        return slot;
    }

    // ============================================================
    // 扇形牌堆
    // ============================================================
    function buildFan() {
        var fan = $('fan'); fan.innerHTML = '';
        for (var i = 0; i < order.length; i++) {
            var el = document.createElement('div');
            el.className = 'fan-card'; el.dataset.deckindex = order[i];
            el.innerHTML = '<span class="fan-symbol">🔮</span><span class="fan-idx">' + (i + 1) + '</span>';
            el.addEventListener('click', function () {
                ensureAudio(); sndWhoosh();
                drawCard(parseInt(this.dataset.deckindex, 10), this);
            });
            fan.appendChild(el);
        }
    }

    function fanCardByDeckIndex(idx) {
        var cards = $('fan').querySelectorAll('.fan-card');
        for (var i = 0; i < cards.length; i++) if (parseInt(cards[i].dataset.deckindex, 10) === idx) return cards[i];
        return null;
    }

    function fanCenter() {
        var fan = $('fan');
        var r = fan.getBoundingClientRect();
        return { left: r.left + r.width / 2 - 42, top: r.top + r.height / 2 - 64, width: 84, height: 128 };
    }

    // ============================================================
    // 抽牌
    // ============================================================
    function updateProgress() {
        var el = $('drawProgress');
        if (!spread) return;
        var next = drawn.length < spread.cardCount ? spread.positions[drawn.length] : null;
        el.innerHTML = '已抽 <b>' + drawn.length + '</b> / ' + spread.cardCount +
            (next ? ' · 接下来：<b>' + next.name + '</b>' : ' · 全部抽完，请开始解读 ✨');
        $('randomDrawBtn').disabled = drawn.length >= spread.cardCount;
        $('autoDrawBtn').disabled = drawn.length >= spread.cardCount;
        if (drawn.length >= spread.cardCount) toast('✨ 牌已备好，开始解读吧！');
    }

    function drawCard(deckIndex, originEl) {
        if (reading) return;
        if (!spread || drawn.length >= spread.cardCount) return;
        for (var i = 0; i < drawn.length; i++) if (drawn[i].deckIndex === deckIndex) { toast('这张牌已被抽过'); return; }

        var pos = spread.positions[drawn.length];
        var card = DECK[deckIndex];
        var reversed = Math.random() < 0.5;
        var slot = document.querySelector('#board .slot[data-key="' + pos.key + '"] .slot-card');

        var fcard = originEl && originEl.classList.contains('fan-card') ? originEl : fanCardByDeckIndex(deckIndex);
        var originRect = (originEl && originEl.classList.contains('fan-card'))
            ? originEl.getBoundingClientRect()
            : (fcard ? fcard.getBoundingClientRect() : fanCenter());
        if (fcard) fcard.classList.add('drawn');

        flyToSlot(originRect, slot, function () {
            fillSlot(slot, card, reversed);
            drawn.push({ deckIndex: deckIndex, card: card, reversed: reversed, pos: pos });
            updateProgress();
        });
    }

    // 镜头跟随：卡牌飞行时，画面平滑平移跟踪到目标牌位
    function flyToSlot(originRect, slotEl, done) {
        var overlay = $('flyOverlay');
        var fly = document.createElement('div');
        fly.className = 'fly-card';
        fly.innerHTML = backDesignHTML();
        var w = originRect.width || 84, h = originRect.height || 128;
        fly.style.width = w + 'px'; fly.style.height = h + 'px';
        overlay.appendChild(fly);

        var srect = slotEl.getBoundingClientRect();
        var ox = originRect.left + window.scrollX;
        var oy = originRect.top + window.scrollY;
        var tx = srect.left + (srect.width - w) / 2 + window.scrollX;
        var ty = srect.top + (srect.height - h) / 2 + window.scrollY;
        var sc = Math.min(slotEl.offsetWidth / w, slotEl.offsetHeight / h);

        var dur = 680, t0 = performance.now(), trailT = 0;
        function frame(now) {
            var p = Math.min((now - t0) / dur, 1);
            var e = easeInOutCubic(p);
            var x = ox + (tx - ox) * e;
            var y = oy + (ty - oy) * e;

            var sx = (x + w / 2) - window.innerWidth / 2;
            var sy = (y + h / 2) - window.innerHeight * 0.42;
            window.scrollTo(Math.max(0, sx), Math.max(0, sy));

            fly.style.left = (x - window.scrollX) + 'px';
            fly.style.top = (y - window.scrollY) + 'px';
            fly.style.transform = 'rotate(' + (p * 540) + 'deg) scale(' + (1 + (sc - 1) * e) + ')';
            fly.style.opacity = p > 0.9 ? Math.max(0, 1 - (p - 0.9) * 10) : 1;

            // 拖尾粒子
            if (p < 0.9 && now - trailT > 55) {
                trailT = now;
                var fr = fly.getBoundingClientRect();
                burst(fr.left + fr.width / 2, fr.top + fr.height / 2, 'rgba(244,208,122,0.85)');
            }

            if (p < 1) requestAnimationFrame(frame);
            else { fly.remove(); if (done) done(); }
        }
        requestAnimationFrame(frame);
    }

    function fillSlot(slotEl, card, reversed) {
        var el = document.createElement('div');
        el.className = 'tcard' + (reversed ? ' reversed' : '');
        el.style.setProperty('--card-grad', cardGrad(card));
        el.style.setProperty('--card-accent', suitColor(card));
        el.innerHTML =
            '<div class="tcard-face tcard-back">' + backDesignHTML() + '</div>' +
            '<div class="tcard-face tcard-front">' + frontHTML(card, reversed) + '</div>';
        slotEl.innerHTML = '';
        slotEl.appendChild(el);

        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                el.classList.add('flipped');
                slotEl.classList.add('flash');
                var r = slotEl.getBoundingClientRect();
                burst(r.left + r.width / 2, r.top + r.height / 2, suitColor(card));
                sndChime();
                var sw = document.createElement('div');
                sw.className = 'shockwave';
                sw.style.borderColor = suitColor(card);
                slotEl.appendChild(sw);
                setTimeout(function () { sw.remove(); }, 800);
                if (card.arcana === 'major') {
                    screenShake(7);
                    var gf = document.createElement('div');
                    gf.className = 'gold-flash';
                    slotEl.appendChild(gf);
                    setTimeout(function () { gf.remove(); }, 700);
                }
                setTimeout(function () { slotEl.classList.remove('flash'); }, 950);
            });
        });
    }

    function drawRandom() {
        var remaining = [];
        for (var i = 0; i < order.length; i++) {
            var idx = order[i], taken = false;
            for (var j = 0; j < drawn.length; j++) if (drawn[j].deckIndex === idx) { taken = true; break; }
            if (!taken) remaining.push(idx);
        }
        if (!remaining.length) return;
        var pick = remaining[Math.floor(Math.random() * remaining.length)];
        sndWhoosh();
        drawCard(pick, null);
    }

    function autoDrawAll() {
        if (drawn.length >= spread.cardCount) return;
        var remaining = spread.cardCount - drawn.length;
        var step = 0;
        var iv = setInterval(function () {
            drawRandom();
            step++;
            if (step >= remaining || drawn.length >= spread.cardCount) clearInterval(iv);
        }, 1400);
    }

    // ============================================================
    // 洗牌动画（高级 3D 多段式：切牌 → 交错 → 扇形 → 收拢）
    // ============================================================
    function runShuffle() {
        showPhase('phase-shuffle');
        var stage = $('shuffleStage');
        stage.querySelectorAll('.deck3d').forEach(function (n) { n.remove(); });
        var layer = document.createElement('div');
        layer.className = 'deck3d';
        stage.appendChild(layer);
        $('shuffleCaption').innerHTML = '🌌 宇宙能量注入中…';

        var N = 22;
        var cards = [];
        for (var i = 0; i < N; i++) {
            var el = document.createElement('div');
            el.className = 'shuffle-card';
            el.innerHTML = backDesignHTML();
            layer.appendChild(el);
            cards.push({ el: el, i: i });
        }

        var t0 = performance.now(), dur = 3300, sndT = 0, sparkT = 0;
        function frame(now) {
            var p = Math.min((now - t0) / dur, 1);
            var cx = stage.clientWidth / 2, cy = stage.clientHeight / 2;

            for (var k = 0; k < N; k++) {
                var s = shuffleState(cards[k].i, N, p);
                var el = cards[k].el;
                el.style.transform = 'translate3d(' + s.dx + 'px,' + s.dy + 'px,' + s.z + 'px) rotateY(' + s.rotY + 'deg) rotateZ(' + s.rotZ + 'deg) scale(' + s.scale + ')';
                el.style.opacity = s.opacity;
                el.style.zIndex = Math.round(s.z + 100);
            }

            // 粒子拖尾
            if (now - sparkT > 90 && p < 0.9) {
                sparkT = now;
                var pickEl = cards[Math.floor(Math.random() * N)].el;
                var rect = pickEl.getBoundingClientRect();
                burst(rect.left + rect.width / 2, rect.top + rect.height / 2, 'rgba(244,208,122,0.9)');
            }

            updateShuffleCaption(p);
            if (now - sndT > 300) { sndT = now; sndShuffle(); }
            if (p < 1) requestAnimationFrame(frame);
            else finishShuffle();
        }
        requestAnimationFrame(frame);
    }

    function shuffleState(i, N, p) {
        if (p < 0.28) {
            var t = p / 0.28, k = easeInOutCubic(t);
            var half = i < N / 2 ? -1 : 1;
            return { dx: half * k * 160, dy: (i - N / 2) * (1 - k) * 2.2, rotY: half * k * 34, rotZ: 0, z: 0, scale: 1, opacity: 1 };
        }
        if (p < 0.6) {
            var t2 = (p - 0.28) / 0.32, k2 = easeInOutCubic(t2);
            var half2 = i < N / 2 ? -1 : 1;
            var alt = (i % 2 === 0) ? 1 : -1;
            return { dx: half2 * 160 * (1 - k2) * 0.55, dy: alt * k2 * 38, rotY: half2 * 34 * (1 - k2), rotZ: alt * k2 * 22, z: alt * k2 * 36, scale: 1, opacity: 1 };
        }
        if (p < 0.86) {
            var t3 = (p - 0.6) / 0.26, k3 = easeOutBack(t3);
            var ang = (i / (N - 1) - 0.5) * 2.3;
            var r = 290;
            return { dx: Math.sin(ang) * r * k3, dy: (1 - Math.cos(ang)) * r * 0.8 * k3 + 16, rotY: 0, rotZ: ang * 57.3 * k3, z: 0, scale: 0.92, opacity: 1 };
        }
        var t4 = (p - 0.86) / 0.14, k4 = easeInOutCubic(t4);
        var ang4 = (i / (N - 1) - 0.5) * 2.3;
        var r4 = 290;
        return {
            dx: Math.sin(ang4) * r4 * (1 - k4),
            dy: (1 - Math.cos(ang4)) * r4 * 0.8 * (1 - k4) + (i - N / 2) * k4 * 2 + 16 * (1 - k4),
            rotY: 0, rotZ: ang4 * 57.3 * (1 - k4), z: 0, scale: 0.92 + 0.08 * k4, opacity: 1
        };
    }

    function updateShuffleCaption(p) {
        var cap = $('shuffleCaption');
        if (p < 0.28) cap.innerHTML = '🂠 切牌中…';
