@{
    ViewData["Title"] = "🔮 塔罗牌占卜";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<style>
    :root {
        --gold: #f4d07a;
        --gold-dim: #b8914a;
        --violet: #8B5CF6;
        --pink: #EC4899;
        --ink: #07060f;
    }

    .tarot-page { position: relative; min-height: 100vh; overflow-x: hidden; }

    /* ---- 背景：星云 + 星星画布 ---- */
    .tarot-bg { position: fixed; inset: 0; z-index: -2; background:
        radial-gradient(1200px 800px at 80% -10%, rgba(139,92,246,0.22), transparent 60%),
        radial-gradient(900px 700px at 10% 20%, rgba(236,72,153,0.14), transparent 60%),
        radial-gradient(1000px 900px at 50% 110%, rgba(244,208,122,0.10), transparent 60%),
        #07060f; }
    .tarot-bg::after {
        content: ''; position: absolute; inset: 0;
        background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.06) 0 1px, transparent 1.5px);
        background-size: 220px 220px; opacity: 0.4; mix-blend-mode: screen;
    }
    #starCanvas { position: fixed; inset: 0; z-index: -1; pointer-events: none; }

    .fly-overlay { position: fixed; inset: 0; z-index: 1000; pointer-events: none; }

    /* ---- 主容器 ---- */
    .tarot-wrap { position: relative; max-width: 1180px; margin: 0 auto; padding: 0.6rem 1.2rem 3rem; z-index: 1; }
    .tarot-head { text-align: center; padding: 1rem 0 0.4rem; position: relative; }
    .tarot-head h1 {
        font-size: 2.6rem; font-weight: 900; letter-spacing: 1px; margin: 0;
        background: linear-gradient(135deg, #f4d07a 0%, #EC4899 30%, #8B5CF6 60%, #f4d07a 100%);
        background-size: 200% 200%;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        filter: drop-shadow(0 0 20px rgba(139,92,246,0.5));
        animation: titleShimmer 4s ease infinite;
    }
    @@keyframes titleShimmer { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
    .tarot-head .subtitle { color: rgba(255,255,255,0.35); font-size: 0.88rem; margin-top: 0.3rem; }
    .history-btn {
        position: absolute; right: 0; top: 0.4rem; padding: 0.5rem 1rem; font-size: 0.82rem; font-weight: 700;
        color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1);
        border-radius: 50px; cursor: pointer; font-family: inherit; transition: all 0.2s ease;
    }
    .history-btn:hover { color: #fff; border-color: rgba(244,208,122,0.5); background: rgba(244,208,122,0.08); }

    /* ---- 阶段切换 ---- */
    .phase { display: none; }
    .phase.active { display: block; animation: phaseIn 0.6s cubic-bezier(0.23,1,0.32,1); }
    @@keyframes phaseIn { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: none; } }

    .panel {
        background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px; padding: 1.8rem 1.6rem; backdrop-filter: blur(14px);
        box-shadow: 0 30px 80px rgba(0,0,0,0.4);
    }

    /* ============================================================
       阶段 1：提问
       ============================================================ */
    #phase-question .panel { max-width: 720px; margin: 1.2rem auto 0; text-align: center; }
    .question-label { color: rgba(255,255,255,0.55); font-weight: 600; margin-bottom: 0.8rem; font-size: 0.95rem; min-height: 1.4em; }
    .question-label .moon { animation: moonFloat 3s ease-in-out infinite; display: inline-block; }
    @@keyframes moonFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
    .q-input {
        width: 100%; min-height: 96px; resize: vertical; padding: 0.9rem 1rem;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; color: #fff; font-family: inherit; font-size: 1rem; line-height: 1.6;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .q-input:focus { outline: none; border-color: rgba(139,92,246,0.6); box-shadow: 0 0 0 4px rgba(139,92,246,0.12); }
    .q-input::placeholder { color: rgba(255,255,255,0.25); }

    .spread-select { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem; margin: 1.2rem 0 1.4rem; }
    .spread-opt {
        position: relative; padding: 0.85rem 0.6rem; cursor: pointer; text-align: center;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; color: #fff; font-family: inherit; transition: all 0.2s ease;
    }
    .spread-opt .s-name { font-weight: 700; font-size: 0.95rem; }
    .spread-opt .s-desc { display: block; color: rgba(255,255,255,0.35); font-size: 0.72rem; margin-top: 0.2rem; }
    .spread-opt:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.16); }
    .spread-opt.active { border-color: rgba(244,208,122,0.55); background: rgba(244,208,122,0.08); box-shadow: 0 0 24px rgba(244,208,122,0.12); }
    .spread-opt .s-badge { position: absolute; top: -8px; right: -8px; font-size: 0.6rem; padding: 0.1rem 0.5rem; border-radius: 20px; background: rgba(236,72,153,0.16); color: #EC4899; }
    .spread-info { text-align: center; color: rgba(255,255,255,0.35); font-size: 0.72rem; margin: -0.3rem 0 1rem; line-height: 1.9; }
    .spread-info .si-label { color: rgba(255,255,255,0.5); font-weight: 600; }
    .spread-info .si-item { display: inline-block; margin: 0 0.3rem; }

    .big-btn {
        position: relative; display: inline-block; padding: 0.95rem 3rem; font-size: 1.05rem; font-weight: 800; color: #1a1408;
        background: linear-gradient(135deg, #ffe3a3 0%, #f4d07a 35%, #d99a3d 70%, #c78a28 100%);
        background-size: 200% 200%;
        border: none; border-radius: 50px; cursor: pointer; font-family: inherit; letter-spacing: 1px; overflow: hidden;
        box-shadow: 0 10px 34px rgba(244,208,122,0.35), inset 0 1px 0 rgba(255,255,255,0.6), inset 0 -2px 6px rgba(0,0,0,0.15);
        transition: all 0.25s ease;
    }
    .big-btn::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.55) 50%, transparent 70%);
        transform: translateX(-130%);
    }
    .big-btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 48px rgba(244,208,122,0.55), inset 0 1px 0 rgba(255,255,255,0.7); animation: bigBtnShine 1.4s ease; }
    .big-btn:hover::after { animation: bigBtnSweep 1.1s ease; }
    .big-btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none; animation: none; }
    .big-btn:disabled::after { display: none; }
    @@keyframes bigBtnSweep { 0% { transform: translateX(-130%); } 100% { transform: translateX(130%); } }
    @@keyframes bigBtnShine { 0%,100% { background-position: 0% 0%; } 50% { background-position: 100% 100%; } }

    .quota-info { text-align: center; color: rgba(255,255,255,0.4); font-size: 0.82rem; margin-bottom: 0.8rem; }
    .quota-info b { color: var(--gold); }
    .daily-banner-wrap { margin-bottom: 1rem; }
    .daily-banner { text-align: center; padding: 1rem; border-radius: 16px; background: linear-gradient(135deg, rgba(244,208,122,0.12), rgba(139,92,246,0.1)); border: 1px solid rgba(244,208,122,0.3); }
    .db-title { font-size: 1.05rem; font-weight: 800; color: var(--gold); }
    .db-stars { font-size: 1.3rem; color: var(--gold); letter-spacing: 2px; margin: 0.3rem 0; }
    .db-stars span { font-size: 0.75rem; color: rgba(255,255,255,0.4); letter-spacing: 0; }
    .db-line { color: rgba(255,255,255,0.65); font-size: 0.85rem; margin: 0.2rem 0; }

    /* ============================================================
       阶段 2：洗牌（高级 3D 多段式）
       ============================================================ */
    #shuffleStage { position: relative; height: 440px; overflow: hidden; }
    .shuffle-caption { text-align: center; color: rgba(255,255,255,0.6); font-size: 1rem; margin-top: 1rem; min-height: 1.6em; }
    .shuffle-caption .glow { color: var(--gold); text-shadow: 0 0 16px rgba(244,208,122,0.8); }

    .magic-ring {
        position: absolute; left: 50%; top: 50%; width: 320px; height: 320px; margin: -160px 0 0 -160px;
        border-radius: 50%; border: 1px dashed rgba(244,208,122,0.35); animation: ringSpin 6s linear infinite;
    }
    .magic-ring::before, .magic-ring::after { content: '✦'; position: absolute; font-size: 1.4rem; color: var(--gold); text-shadow: 0 0 14px rgba(244,208,122,0.9); }
    .magic-ring::before { top: -12px; left: 50%; }
    .magic-ring::after { bottom: -12px; left: 50%; }
    .magic-ring.r2 { width: 220px; height: 220px; margin: -110px 0 0 -110px; animation-direction: reverse; animation-duration: 4.5s; }
    .magic-ring.r3 { width: 400px; height: 400px; margin: -200px 0 0 -200px; animation-duration: 8s; border-style: dotted; opacity: 0.6; }
    @@keyframes ringSpin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

    .deck3d { position: absolute; inset: 0; perspective: 1100px; }
    .shuffle-card {
        position: absolute; left: 50%; top: 50%; width: 84px; height: 128px; margin: -64px 0 0 -42px;
        border-radius: 10px; background: linear-gradient(145deg, #2a2260, #150f2e);
        border: 1px solid rgba(244,208,122,0.5);
        box-shadow: 0 16px 38px rgba(0,0,0,0.6), 0 0 24px rgba(244,208,122,0.14), inset 0 0 0 1px rgba(255,255,255,0.06);
        will-change: transform, opacity; transform-style: preserve-3d;
    }

    .fly-card {
        position: absolute; border-radius: 10px;
        background: linear-gradient(145deg, #2a2260, #150f2e);
        border: 1px solid rgba(244,208,122,0.5);
        box-shadow: 0 18px 44px rgba(0,0,0,0.6), 0 0 30px rgba(244,208,122,0.3);
        will-change: transform, left, top, opacity;
    }
    .fly-card .tcard-back-design { position: absolute; inset: 0; }

    /* ---- 卡背设计 ---- */
    .tcard-back-design { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border-radius: inherit; }
    .back-ring { position: absolute; inset: 7px; border: 1px solid rgba(244,208,122,0.5); border-radius: 7px; }
    .back-ring2 { position: absolute; inset: 11px; border: 1px dashed rgba(244,208,122,0.28); border-radius: 5px; }
    .back-center {
        position: relative; width: 52px; height: 52px; border-radius: 50%;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: radial-gradient(circle at 50% 40%, rgba(244,208,122,0.18), rgba(0,0,0,0.32) 72%);
        border: 1px solid rgba(244,208,122,0.6); box-shadow: 0 0 22px rgba(244,208,122,0.28), inset 0 0 10px rgba(0,0,0,0.4);
    }
    .back-moon { font-size: 1.35rem; color: var(--gold); line-height: 1; text-shadow: 0 0 14px rgba(244,208,122,0.9); }
    .back-eye { font-size: 0.8rem; margin-top: -3px; filter: drop-shadow(0 0 6px rgba(244,208,122,0.6)); }
    .back-stars { position: relative; font-size: 0.55rem; letter-spacing: 3px; color: rgba(244,208,122,0.7); margin-top: 6px; }
    .back-corner { position: absolute; width: 7px; height: 7px; border: 1px solid rgba(244,208,122,0.6); }
    .back-corner.tl { top: 4px; left: 4px; border-right: none; border-bottom: none; }
    .back-corner.tr { top: 4px; right: 4px; border-left: none; border-bottom: none; }
    .back-corner.bl { bottom: 4px; left: 4px; border-right: none; border-top: none; }
    .back-corner.br { bottom: 4px; right: 4px; border-left: none; border-top: none; }

    /* ============================================================
       牌阵棋盘
       ============================================================ */
    .board { display: none; margin: 1rem auto 0; }
    .board.visible { display: flex; animation: phaseIn 0.6s ease; }

    .board-celtic { justify-content: center; align-items: center; gap: 26px; flex-wrap: wrap; }
    .cross { position: relative; width: 460px; padding: 10px; }
    .cross::before, .cross::after {
        content: ''; position: absolute; z-index: 0; pointer-events: none;
        background: linear-gradient(transparent, rgba(244,208,122,0.22), transparent);
    }
    .cross::before { left: 50%; top: 4%; bottom: 4%; width: 1px; }
    .cross::after { top: 50%; left: 4%; right: 4%; height: 1px; background: linear-gradient(90deg, transparent, rgba(244,208,122,0.22), transparent); }
    .cross-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.35fr 1fr; gap: 16px;
        grid-template-areas: ". top ." "left center right" ". bottom ."; }
    .crossing { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 6; }
    .crossing .slot-card { transform: rotate(90deg); }
    .crossing-tag { position: absolute; right: 2px; top: 0; z-index: 7; text-align: right; pointer-events: none; }
    .crossing-tag .slot-name { display: block; color: var(--gold); font-weight: 700; font-size: 0.72rem; }
    .crossing-tag .slot-sub { display: block; color: rgba(255,255,255,0.28); font-size: 0.6rem; margin-top: 1px; }
    .staff { position: relative; display: flex; flex-direction: column; gap: 12px; padding-left: 6px; }
    .staff::before { content: ''; position: absolute; left: -8px; top: 4%; bottom: 4%; width: 1px; background: linear-gradient(transparent, rgba(244,208,122,0.2), transparent); }

    .board-row { justify-content: center; align-items: center; gap: 22px; flex-wrap: wrap; }
    .board-grid { justify-content: center; align-items: center; }
    .tarot-grid { display: grid; gap: 14px; justify-content: center; }

    .slot { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .slot-label { text-align: center; }
    .slot-label .slot-name { display: block; color: var(--gold); font-weight: 700; font-size: 0.82rem; }
    .slot-label .slot-sub { display: block; color: rgba(255,255,255,0.28); font-size: 0.66rem; margin-top: 1px; }
    .slot-card { position: relative; width: 88px; height: 140px; perspective: 1000px; }

    /* ---- 3D 塔罗牌 ---- */
    .tcard { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; }
    .tcard.flipped { transform: rotateY(180deg); animation: flipPop 0.85s cubic-bezier(0.34, 1.4, 0.4, 1); }
    @@keyframes flipPop {
        0% { transform: rotateY(0deg) scale(0.72); }
        55% { transform: rotateY(180deg) scale(1.07); }
        100% { transform: rotateY(180deg) scale(1); }
    }
    .tcard-face {
        position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
        border-radius: 10px; overflow: hidden;
    }
    .tcard-back {
        background:
            radial-gradient(120% 90% at 50% 0%, rgba(139,92,246,0.28), transparent 46%),
            linear-gradient(160deg, #2a2260 0%, #181040 60%, #0f0b26 100%);
        border: 1px solid rgba(244,208,122,0.55);
    }
    .tcard-front {
        position: absolute; inset: 0;
        background:
            radial-gradient(120% 90% at 50% 0%, rgba(255,255,255,0.10), transparent 45%),
            var(--card-grad, linear-gradient(160deg, #2b1a5e 0%, #1a1038 60%, #120c28 100%));
        border: 1px solid rgba(244,208,122,0.6); transform: rotateY(180deg);
        box-shadow: inset 0 0 0 1px rgba(244,208,122,0.14), inset 0 0 24px rgba(0,0,0,0.5);
        overflow: hidden;
    }
    .tcard-front::after {
        content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 6;
        background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,0.5) 50%, transparent 65%);
        transform: translateX(-130%); opacity: 0;
    }
    .tcard.flipped .tcard-front::after { animation: shineSweep 0.6s ease 0.12s; }
    @@keyframes shineSweep { 0% { transform: translateX(-130%); opacity: 0; } 25% { opacity: 1; } 100% { transform: translateX(130%); opacity: 0; } }

    .tcard-front-inner {
        position: absolute; inset: 0; padding: 7px 6px 16px;
        display: flex; flex-direction: column; align-items: center;
    }
    .tcard.reversed .tcard-front-inner { transform: rotate(180deg); }
    .tcard-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .tcard.reversed .tcard-img { transform: rotate(180deg); }

    .cf-top { text-align: center; height: 15px; flex: 0 0 auto; }
    .cf-num { font-size: 0.78rem; font-weight: 800; letter-spacing: 1px; color: var(--card-accent, var(--gold)); text-shadow: 0 0 10px rgba(244,208,122,0.5); }
    .cf-center { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; width: 100%; }
    .cf-medallion {
        position: relative; width: 56px; height: 56px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: radial-gradient(circle at 50% 35%, rgba(255,255,255,0.16), rgba(0,0,0,0.3) 72%);
        border: 1px solid var(--card-accent, var(--gold));
        box-shadow: 0 0 18px rgba(244,208,122,0.25), inset 0 0 12px rgba(0,0,0,0.4);
    }
    .cf-medallion::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; border: 1px dashed rgba(244,208,122,0.35); }
    .cf-symbol { font-size: 1.85rem; line-height: 1; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6)); }
    .cf-court {
        position: absolute; bottom: -5px; right: -5px; font-size: 0.85rem; line-height: 1;
        width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
        background: #120c28; border: 1px solid var(--card-accent, var(--gold)); border-radius: 50%;
        box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }
    .cf-pips { display: flex; flex-wrap: wrap; justify-content: center; align-content: center; gap: 3px; max-width: 56px; }
    .cf-pip { font-size: 0.85rem; line-height: 1; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.55)); }
    .cf-bottom { text-align: center; flex: 0 0 auto; }
    .cf-name { font-size: 0.72rem; font-weight: 800; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,0.7); }
    .cf-en { font-size: 0.46rem; color: rgba(244,208,122,0.72); letter-spacing: 0.3px; }
    .cf-corner { position: absolute; width: 6px; height: 6px; border: 1px solid rgba(244,208,122,0.6); z-index: 4; }
    .cf-corner.tl { top: 4px; left: 4px; border-right: none; border-bottom: none; }
    .cf-corner.tr { top: 4px; right: 4px; border-left: none; border-bottom: none; }
    .cf-corner.bl { bottom: 4px; left: 4px; border-right: none; border-top: none; }
    .cf-corner.br { bottom: 4px; right: 4px; border-left: none; border-top: none; }

    .tcard-badge {
        position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%); z-index: 5;
        font-size: 0.5rem; padding: 0.02rem 0.45rem; border-radius: 20px;
        color: #1a1408; background: var(--card-accent, var(--gold)); font-weight: 800;
    }
    .tcard.reversed .tcard-badge { background: #ec5d7a; color: #fff; }

    .slot-card.flash { animation: slotFlash 0.9s ease; }
    .gold-flash { position: absolute; inset: 0; border-radius: 10px; background: radial-gradient(circle at 50% 50%, rgba(244,208,122,0.7), transparent 70%); animation: goldFlash 0.7s ease forwards; pointer-events: none; z-index: 7; }
    @@keyframes goldFlash { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
    .shockwave { position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin: -12px 0 0 -12px; border-radius: 50%; border: 2px solid rgba(244,208,122,0.85); box-shadow: 0 0 18px rgba(244,208,122,0.5); animation: shockwaveExpand 0.8s ease-out forwards; pointer-events: none; z-index: 8; }
    @@keyframes shockwaveExpand { 0% { transform: scale(0.5); opacity: 1; } 100% { transform: scale(5.5); opacity: 0; } }
    .shuffle-orb { position: absolute; left: 50%; top: 50%; width: 90px; height: 90px; margin: -45px 0 0 -45px; border-radius: 50%; background: radial-gradient(circle, rgba(244,208,122,0.55), rgba(139,92,246,0.25) 55%, transparent 75%); filter: blur(5px); animation: orbPulse 1.6s ease-in-out infinite; pointer-events: none; }
    @@keyframes orbPulse { 0%,100% { transform: scale(1); opacity: 0.55; } 50% { transform: scale(1.5); opacity: 1; } }
    @@keyframes slotFlash { 0% { box-shadow: 0 0 0 0 rgba(244,208,122,0); } 30% { box-shadow: 0 0 0 6px rgba(244,208,122,0.5), 0 0 44px rgba(244,208,122,0.6); } 100% { box-shadow: 0 0 0 0 rgba(244,208,122,0); } }

    /* ============================================================
       抽牌阶段：扇形牌堆 + 控制
       ============================================================ */
    .fan-wrap { margin-top: 1.4rem; }
    .fan-hint { text-align: center; color: rgba(255,255,255,0.35); font-size: 0.8rem; margin-bottom: 0.6rem; }
    .fan { display: flex; justify-content: flex-start; align-items: center; overflow-x: auto; padding: 12px 8px 16px; gap: 0; min-height: 104px; }
    .fan::-webkit-scrollbar { height: 6px; }
    .fan::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 10px; }
    .fan-card {
        flex: 0 0 auto; width: 54px; height: 84px; margin-left: -14px; cursor: pointer;
        border-radius: 8px; background: linear-gradient(145deg, #2a2260, #150f2e);
        border: 1px solid rgba(244,208,122,0.42); position: relative; transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 6px 16px rgba(0,0,0,0.4);
    }
    .fan-card:first-child { margin-left: 0; }
    .fan-card:hover { transform: translateY(-10px) scale(1.06); box-shadow: 0 12px 26px rgba(0,0,0,0.55), 0 0 20px rgba(244,208,122,0.35); z-index: 5; }
    .fan-card.drawn { opacity: 0.16; pointer-events: none; transform: scale(0.9); }
    .fan-card .fan-symbol { font-size: 1.25rem; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); }
    .fan-card .fan-idx { position: absolute; bottom: 3px; left: 0; right: 0; text-align: center; font-size: 0.55rem; color: rgba(255,255,255,0.4); }

    .draw-controls { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; align-items: center; margin-top: 0.4rem; }
    .draw-progress { width: 100%; text-align: center; color: rgba(255,255,255,0.4); font-size: 0.82rem; margin-bottom: 0.3rem; }
    .draw-progress b { color: var(--gold); }
    .chip-btn {
        padding: 0.55rem 1.2rem; font-size: 0.88rem; font-weight: 700; color: #fff; font-family: inherit; cursor: pointer;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 50px; transition: all 0.15s ease;
    }
    .chip-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(244,208,122,0.4); transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,0.3), 0 0 12px rgba(244,208,122,0.15); }
    .chip-btn.primary { background: rgba(139,92,246,0.2); border-color: rgba(139,92,246,0.5); }
    .chip-btn.primary:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.3), 0 0 14px rgba(139,92,246,0.3); }
    .chip-btn.gold { background: linear-gradient(135deg, #ffe3a3, #f4d07a, #d99a3d); color: #1a1408; border: none; box-shadow: 0 6px 20px rgba(244,208,122,0.3), inset 0 1px 0 rgba(255,255,255,0.6); }
    .chip-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
    .num-input { width: 90px; padding: 0.5rem 0.6rem; text-align: center; font-size: 0.9rem; color: #fff; font-family: inherit;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.14); border-radius: 50px; }
    .num-input:focus { outline: none; border-color: rgba(244,208,122,0.6); }

    /* ============================================================
       解读阶段
       ============================================================ */
    .reading-panel { max-width: 860px; margin: 1.4rem auto 0; }
    .reading-status { text-align: center; color: rgba(255,255,255,0.5); padding: 1rem 0; font-size: 0.95rem; }
    .reading-status .shimmer {
        display: inline-block; background: linear-gradient(90deg, rgba(255,255,255,0.2) 25%, #f4d07a 50%, rgba(255,255,255,0.2) 75%);
        background-size: 200% 100%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        animation: shimmer 1.6s linear infinite;
    }
    @@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .ai-progress { width: 100%; max-width: 420px; height: 6px; margin: 0.8rem auto 0; border-radius: 20px; background: rgba(255,255,255,0.06); overflow: hidden; }
    .ai-progress-bar { height: 100%; width: 100%; background: linear-gradient(90deg, transparent, #f4d07a, #EC4899, #8B5CF6, transparent); background-size: 200% 100%; animation: aiSweep 1.6s linear infinite; }
    @@keyframes aiSweep { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .fortune-box {
        text-align: center; padding: 1.2rem 1rem; margin: 0.5rem 0 1.2rem; border-radius: 18px;
        background: linear-gradient(135deg, rgba(244,208,122,0.1), rgba(236,72,153,0.08), rgba(139,92,246,0.1));
        border: 1px solid rgba(244,208,122,0.25); box-shadow: 0 10px 40px rgba(0,0,0,0.3);
    }
    .fortune-title { font-size: 1.15rem; font-weight: 800; color: var(--gold); }
    .fortune-stars { font-size: 1.5rem; color: var(--gold); letter-spacing: 3px; margin: 0.4rem 0; text-shadow: 0 0 18px rgba(244,208,122,0.6); }
    .fortune-stars span { font-size: 0.8rem; color: rgba(255,255,255,0.45); letter-spacing: 0; }
    .fortune-grid { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin: 0.6rem 0; }
    .fortune-item { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 0.5rem 1rem; }
    .fortune-item span { display: block; font-size: 0.7rem; color: rgba(255,255,255,0.4); }
    .fortune-item b { font-size: 1rem; color: #fff; }
    .fortune-line { color: rgba(255,255,255,0.65); font-size: 0.9rem; margin: 0.3rem 0; }

    .verdict-banner {
        text-align: center; padding: 1rem; margin: 0.5rem 0 1.2rem; border-radius: 16px; font-size: 1.3rem; font-weight: 800;
        background: linear-gradient(135deg, rgba(244,208,122,0.12), rgba(139,92,246,0.12));
        border: 1px solid rgba(244,208,122,0.35); color: var(--gold); box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        animation: verdictPop 0.6s cubic-bezier(0.34,1.56,0.64,1);
    }
    @@keyframes verdictPop { 0% { transform: scale(0.7); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

    .reading-body { color: rgba(255,255,255,0.82); line-height: 1.9; font-size: 0.98rem; }
    .reading-body h2 { color: var(--gold); font-size: 1.25rem; margin: 1.2rem 0 0.6rem; padding-left: 0.6rem; border-left: 3px solid var(--gold); text-shadow: 0 0 14px rgba(244,208,122,0.35); }
    .reading-body h3 { color: var(--violet); font-size: 1.05rem; margin: 1rem 0 0.4rem; padding-left: 0.6rem; border-left: 3px solid var(--violet); }
    .reading-body ul { padding-left: 1.2rem; }
    .reading-body li { margin: 0.35rem 0; }
    .reading-body strong { color: #f4d07a; }
    .reading-summary-box { margin-top: 1rem; padding: 1rem 1.1rem; border-radius: 14px; border: 1px solid rgba(244,208,122,0.3); background: linear-gradient(135deg, rgba(244,208,122,0.08), rgba(139,92,246,0.06)); box-shadow: 0 8px 30px rgba(0,0,0,0.25); }
    .reading-summary-box h2, .reading-summary-box h3 { margin-top: 0.2rem; }
    .warning-banner { margin: 0 0 1rem; padding: 0.7rem 1rem; border-radius: 12px; border: 1px solid rgba(255,193,7,0.35); background: rgba(255,193,7,0.08); color: #ffc107; font-size: 0.85rem; line-height: 1.6; animation: phaseIn 0.5s ease; }
    .rv-block { opacity: 0; transform: translateY(10px); transition: opacity 0.5s ease, transform 0.5s ease; }
    .rv-block.show { opacity: 1; transform: none; }
    .reading-actions { text-align: center; margin-top: 1.4rem; }

    /* 追问补充 */
    .followup-section { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px dashed rgba(255,255,255,0.1); }
    .followup-hint { text-align: center; color: rgba(255,255,255,0.5); font-size: 0.8rem; margin-bottom: 0.7rem; }
    .followup-hint b { color: var(--gold); }
    .followup-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 0.8rem; }
    .followup-chip { padding: 0.35rem 0.8rem; font-size: 0.76rem; font-weight: 600; cursor: pointer; font-family: inherit; color: rgba(255,255,255,0.65); background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; transition: all 0.18s ease; }
    .followup-chip:hover { color: #fff; border-color: rgba(244,208,122,0.45); background: rgba(244,208,122,0.08); transform: translateY(-2px); }
    .followup-input-row { display: flex; gap: 0.6rem; align-items: stretch; }
    .followup-input { flex: 1; min-height: 60px; resize: vertical; padding: 0.7rem 0.9rem; font-size: 0.9rem; font-family: inherit; color: #fff; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; line-height: 1.6; }
    .followup-input:focus { outline: none; border-color: rgba(244,208,122,0.5); box-shadow: 0 0 0 4px rgba(244,208,122,0.12); }
    .followup-input::placeholder { color: rgba(255,255,255,0.25); }
    .followup-box { margin: 1rem 0 0; padding: 0.9rem 1rem; border-radius: 14px; border: 1px solid rgba(139,92,246,0.3); background: rgba(139,92,246,0.06); }
    .followup-box .fu-user { color: rgba(255,255,255,0.75); font-size: 0.82rem; margin-bottom: 0.5rem; padding-bottom: 0.5rem; border-bottom: 1px dashed rgba(255,255,255,0.08); }
    .followup-box .fu-user b { color: var(--gold); }
    .followup-box .fu-ai { color: rgba(255,255,255,0.82); line-height: 1.85; font-size: 0.9rem; }
    .followup-box .fu-ai h2 { color: var(--gold); font-size: 1rem; margin: 0.7rem 0 0.35rem; }
    .followup-box .fu-ai h3 { color: var(--violet); font-size: 0.9rem; margin: 0.5rem 0 0.25rem; }
    .followup-box .fu-ai strong { color: #f4d07a; }

    .float-toast {
        position: fixed; left: 50%; top: 22%; transform: translateX(-50%); z-index: 2000; pointer-events: none;
        color: var(--gold); font-size: 1.4rem; font-weight: 800; letter-spacing: 2px; text-shadow: 0 0 24px rgba(244,208,122,0.8);
        animation: toastPop 1.4s ease forwards;
    }
    @@keyframes toastPop { 0% { opacity: 0; transform: translate(-50%, 10px) scale(0.8); } 20% { opacity: 1; transform: translate(-50%, 0) scale(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -18px) scale(1.05); } }

    /* ============================================================
       历史记录弹窗
       ============================================================ */
    .history-overlay {
        position: fixed; inset: 0; z-index: 3000; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center; padding: 1.2rem;
    }
    .history-modal {
        width: min(560px, 100%); max-height: 80vh; display: flex; flex-direction: column;
        background: #14101f; border: 1px solid rgba(244,208,122,0.2); border-radius: 20px; overflow: hidden;
        box-shadow: 0 40px 120px rgba(0,0,0,0.7); animation: phaseIn 0.35s ease;
    }
    .history-head { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.06); color: var(--gold); font-weight: 800; }
    .history-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 1.2rem; cursor: pointer; font-family: inherit; }
    .history-close:hover { color: #fff; }
    .history-list { overflow-y: auto; padding: 0.6rem; }
    .history-list::-webkit-scrollbar { width: 5px; }
    .history-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 10px; }
    .history-empty { text-align: center; color: rgba(255,255,255,0.3); padding: 2.5rem 1rem; }
    .history-item { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; padding: 0.8rem 0.9rem; margin-bottom: 0.6rem; cursor: pointer; transition: border-color 0.2s ease; }
    .history-item:hover { border-color: rgba(244,208,122,0.3); }
    .history-item-head { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
    .h-spread { color: var(--gold); font-weight: 700; font-size: 0.85rem; }
    .h-time { color: rgba(255,255,255,0.25); font-size: 0.7rem; white-space: nowrap; }
    .h-question { color: rgba(255,255,255,0.6); font-size: 0.8rem; margin: 0.35rem 0; }
    .h-cards { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .h-card { font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); }
    .h-card .h-rev { color: #ec5d7a; font-weight: 700; }
    .history-result { margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px dashed rgba(255,255,255,0.08); color: rgba(255,255,255,0.75); line-height: 1.8; font-size: 0.88rem; }
    .history-result h2 { color: var(--gold); font-size: 1.05rem; margin: 0.8rem 0 0.4rem; }
    .history-result h3 { color: var(--violet); font-size: 0.92rem; margin: 0.6rem 0 0.3rem; }
    .history-result strong { color: #f4d07a; }

    /* ============================================================
       牌阵图解弹窗
       ============================================================ */
    .sd-overlay {
        position: fixed; inset: 0; z-index: 3100; background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
        display: flex; align-items: center; justify-content: center; padding: 1.2rem;
    }
    .sd-modal {
        width: min(720px, 100%); max-height: 85vh; display: flex; flex-direction: column;
        background: #14101f; border: 1px solid rgba(244,208,122,0.25); border-radius: 20px; overflow: hidden;
        box-shadow: 0 40px 120px rgba(0,0,0,0.7); animation: phaseIn 0.3s ease;
    }
    .sd-head { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.06); color: var(--gold); font-weight: 800; font-size: 1.05rem; }
    .sd-close { background: none; border: none; color: rgba(255,255,255,0.5); font-size: 1.2rem; cursor: pointer; font-family: inherit; }
    .sd-close:hover { color: #fff; }
    .sd-body { overflow-y: auto; padding: 1.1rem 1.2rem; }
    .sd-body::-webkit-scrollbar { width: 5px; }
    .sd-body::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 10px; }
    .sd-grid { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    .sd-grid.has-grid { display: grid; }
    .sd-cell {
        flex: 0 0 100px; padding: 0.6rem 0.4rem; text-align: center; border-radius: 12px;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(244,208,122,0.16);
    }
    .sd-num { display: inline-block; width: 20px; height: 20px; line-height: 20px; border-radius: 50%; background: rgba(244,208,122,0.16); color: var(--gold); font-size: 0.7rem; font-weight: 800; margin-bottom: 0.25rem; }
    .sd-name { display: block; color: #fff; font-size: 0.78rem; font-weight: 700; }
    .sd-sub { display: block; color: rgba(255,255,255,0.35); font-size: 0.66rem; margin-top: 1px; }

    /* 卡面模式切换 */
    .card-mode-toggle { text-align: center; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; gap: 0.4rem; flex-wrap: wrap; }
    .cm-label { color: rgba(255,255,255,0.5); font-size: 0.8rem; }
    .cm-btn { padding: 0.4rem 1rem; font-size: 0.8rem; font-weight: 700; cursor: pointer; font-family: inherit; color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; transition: all 0.15s ease; }
    .cm-btn.active { color: #1a1408; background: linear-gradient(135deg, #f4d07a, #d99a3d); border-color: transparent; }

    /* 免责声明 */
    .disclaimer-text { color: rgba(255,255,255,0.7); line-height: 1.9; font-size: 0.9rem; }
    .disclaimer-text h2 { color: var(--gold); font-size: 1rem; margin: 0.8rem 0 0.4rem; }
    .disclaimer-text p { margin: 0.3rem 0; }

    /* 权威性介绍 splash */
    .intro-splash { position: fixed; inset: 0; z-index: 4000; display: flex; align-items: center; justify-content: center; padding: 1.2rem; background: radial-gradient(1000px 700px at 50% 30%, rgba(139,92,246,0.25), rgba(7,6,15,0.96) 70%); backdrop-filter: blur(8px); }
    .intro-inner { text-align: center; max-width: 520px; }
    .intro-icon { font-size: 3.5rem; margin-bottom: 0.6rem; animation: introFloat 2.4s ease-in-out infinite; }
    @@keyframes introFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    .intro-line { font-size: 1.05rem; color: rgba(255,255,255,0.85); margin: 0.5rem 0; opacity: 0; transform: translateY(12px); animation: introIn 0.7s ease forwards; }
    .intro-line.l1 { animation-delay: 0.2s; }
    .intro-line.l2 { animation-delay: 0.8s; }
    .intro-line.l3 { animation-delay: 1.4s; }
    @@keyframes introIn { to { opacity: 1; transform: none; } }
    .intro-btn { margin-top: 1.4rem; padding: 0.8rem 2.6rem; font-size: 1rem; font-weight: 800; color: #1a1408; background: linear-gradient(135deg, #f4d07a, #d99a3d); border: none; border-radius: 50px; cursor: pointer; font-family: inherit; opacity: 0; animation: introIn 0.7s ease 2s forwards; box-shadow: 0 10px 34px rgba(244,208,122,0.35); }
    .intro-btn:hover { transform: translateY(-2px); }


    /* ============================================================
       高级质感全面升级
       ============================================================ */
    .panel { animation: panelGlow 5s ease-in-out infinite; }
    @@keyframes panelGlow {
        0%,100% { box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(244,208,122,0.05); }
        50% { box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 28px rgba(244,208,122,0.12), 0 0 0 1px rgba(244,208,122,0.12); }
    }

    .spread-opt { transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1); }
    .spread-opt:hover { box-shadow: 0 10px 26px rgba(0,0,0,0.35), 0 0 16px rgba(244,208,122,0.15); border-color: rgba(244,208,122,0.35); }
    .spread-opt.active { box-shadow: 0 0 0 1px rgba(244,208,122,0.45), 0 0 28px rgba(244,208,122,0.28), inset 0 0 20px rgba(244,208,122,0.08); border-color: rgba(244,208,122,0.6); }

    .fan-card { transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s ease; }
    .fan-card:hover { transform: translateY(-12px) scale(1.08); box-shadow: 0 16px 30px rgba(0,0,0,0.6), 0 0 26px rgba(244,208,122,0.5); z-index: 5; }

    .q-input:focus { box-shadow: 0 0 0 4px rgba(139,92,246,0.14), 0 0 22px rgba(139,92,246,0.28); }
    .num-input:focus { box-shadow: 0 0 0 4px rgba(244,208,122,0.12), 0 0 20px rgba(244,208,122,0.22); }

    .ai-progress { box-shadow: 0 0 16px rgba(244,208,122,0.28); }

    .fortune-box, .verdict-banner, .daily-banner { animation: bannerGlow 3.2s ease-in-out infinite; }
    @@keyframes bannerGlow { 0%,100% { box-shadow: 0 10px 40px rgba(0,0,0,0.3); } 50% { box-shadow: 0 10px 46px rgba(244,208,122,0.22); } }

    .intro-btn { box-shadow: 0 10px 34px rgba(244,208,122,0.45), inset 0 1px 0 rgba(255,255,255,0.6); }
    .intro-btn:hover { box-shadow: 0 14px 44px rgba(244,208,122,0.6), inset 0 1px 0 rgba(255,255,255,0.7); transform: translateY(-2px); }

    .sd-cell { transition: all 0.2s ease; }
    .sd-cell:hover { border-color: rgba(244,208,122,0.45); background: rgba(244,208,122,0.07); transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.3); }

    .history-item { transition: all 0.2s ease; }
    .history-item:hover { transform: translateX(3px); background: rgba(244,208,122,0.04); }

    .cm-btn { transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1); }
    .cm-btn:hover { transform: translateY(-2px); border-color: rgba(244,208,122,0.5); box-shadow: 0 6px 16px rgba(0,0,0,0.3); }
    .cm-btn.active { box-shadow: 0 6px 20px rgba(244,208,122,0.35), inset 0 1px 0 rgba(255,255,255,0.6); }

    .history-btn:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.3), 0 0 14px rgba(244,208,122,0.2); }
    .ta-btn:hover { box-shadow: 0 6px 16px rgba(244,208,122,0.35); }

    @@media (max-width: 700px) {
        .tarot-head h1 { font-size: 1.9rem; }
        .history-btn { position: static; margin-top: 0.6rem; }
        #shuffleStage { height: 340px; }
        .magic-ring { width: 220px; height: 220px; margin: -110px 0 0 -110px; }
        .magic-ring.r2 { width: 160px; height: 160px; margin: -80px 0 0 -80px; }
        .magic-ring.r3 { width: 280px; height: 280px; margin: -140px 0 0 -140px; }
        .cross { width: 300px; }
        .cross-grid { gap: 12px; }
        .board-celtic { gap: 16px; }
        .staff { gap: 8px; }
        .board-row { gap: 12px; }
        .tarot-grid { gap: 10px; }
        .slot-card { width: 72px; height: 116px; }
        .crossing-tag .slot-name { font-size: 0.66rem; }
        .slot-label .slot-name { font-size: 0.74rem; }
        .slot-label .slot-sub { font-size: 0.6rem; }

        /* 卡面内容缩小，避免叠加 */
        .tcard-front-inner { padding: 5px 4px 13px; }
        .cf-top { height: 12px; }
        .cf-num { font-size: 0.66rem; }
        .cf-medallion { width: 42px; height: 42px; }
        .cf-medallion::after { inset: 3px; }
        .cf-symbol { font-size: 1.3rem; }
        .cf-court { width: 18px; height: 18px; font-size: 0.7rem; bottom: -4px; right: -4px; }
        .cf-pips { max-width: 46px; gap: 2px; }
        .cf-pip { font-size: 0.72rem; }
        .cf-name { font-size: 0.6rem; }
        .cf-en { font-size: 0.4rem; }
        .cf-corner { width: 5px; height: 5px; }
        .tcard-badge { font-size: 0.45rem; padding: 0.02rem 0.4rem; }
        .spread-select { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 420px) {
        .cross { width: 264px; }
        .slot-card { width: 62px; height: 100px; }
        .board-celtic { gap: 12px; }
        .cross-grid { gap: 10px; }
        .spread-select { grid-template-columns: 1fr; }

        .tcard-front-inner { padding: 4px 3px 11px; }
        .cf-top { height: 11px; }
        .cf-num { font-size: 0.6rem; }
        .cf-medallion { width: 36px; height: 36px; }
        .cf-symbol { font-size: 1.15rem; }
        .cf-court { width: 16px; height: 16px; font-size: 0.62rem; }
        .cf-pips { max-width: 40px; gap: 2px; }
