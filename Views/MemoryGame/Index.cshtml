@{
    ViewData["Title"] = "🃏 记忆翻牌";
    var username = Context.Session.GetString("Username") ?? "玩家";
}

<link rel="stylesheet" href="~/css/casual-game.css" />

<style>
    .game-container { max-width: 720px; margin: 0 auto; padding: 1rem 1.2rem 3rem; }
    .game-header { text-align: center; padding: 0.6rem 0 1rem; }
    .game-header h1 {
        font-size: 2rem; font-weight: 800; margin: 0;
        background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .game-header .subtitle { color: rgba(255,255,255,0.3); font-size: 0.82rem; margin-top: 0.2rem; }

    .status-bar {
        display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;
        background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px; padding: 0.7rem 1.3rem; margin-bottom: 1rem;
    }
    .status-item { color: rgba(255,255,255,0.3); font-size: 0.8rem; display: flex; align-items: center; gap: 0.35rem; }
    .status-item .value { color: #fff; font-weight: 700; font-size: 1.1rem; }

    .diff-bar { display: flex; gap: 0.6rem; justify-content: center; margin-bottom: 1.2rem; }
    .diff-btn {
        padding: 0.45rem 1.4rem; font-size: 0.85rem; font-weight: 700; color: rgba(255,255,255,0.5);
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 50px; cursor: pointer; font-family: inherit; transition: all 0.15s ease;
    }
    .diff-btn.active { color: #fff; background: rgba(139,92,246,0.2); border-color: rgba(139,92,246,0.5); }

    .board { display: grid; gap: 0.7rem; justify-content: center; perspective: 800px; }
    .card {
        position: relative; aspect-ratio: 1; cursor: pointer;
        border-radius: 14px; user-select: none; -webkit-user-select: none;
        transform-style: preserve-3d; transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .card .face {
        position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        border-radius: 14px; backface-visibility: hidden; border: 1px solid rgba(255,255,255,0.1);
    }
    .card .back {
        background: linear-gradient(135deg, rgba(139,92,246,0.3), rgba(167,139,250,0.16));
        color: rgba(255,255,255,0.5); font-size: 1.4rem;
    }
    .card .front { background: rgba(255,255,255,0.07); transform: rotateY(180deg); font-size: 2.1rem; }
    .card.flipped { transform: rotateY(180deg); }
    .card.matched {
        transform: rotateY(180deg);
        border-color: rgba(40,167,69,0.5);
        animation: matchedPop 0.4s;
    }
    .card.matched .front { background: rgba(40,167,69,0.14); border-color: rgba(40,167,69,0.5); }
    @@keyframes matchedPop { 0% { box-shadow: 0 0 0 0 rgba(40,167,69,0.5); } 100% { box-shadow: 0 0 0 14px rgba(40,167,69,0); } }

    .result-panel {
        display: none; text-align: center; background: rgba(255,255,255,0.03);
        border: 1px solid rgba(139,92,246,0.3); border-radius: 20px; padding: 1.6rem 1.2rem; margin-top: 1.4rem;
    }
    .result-panel.show { display: block; }
    .result-panel h2 { color: #A78BFA; font-weight: 800; margin-bottom: 0.7rem; }
    .result-panel p { color: rgba(255,255,255,0.4); margin: 0.2rem 0; }

    .big-btn {
        display: inline-block; margin-top: 0.8rem; padding: 0.7rem 2.2rem; font-size: 0.95rem; font-weight: 700; color: #fff;
        background: linear-gradient(135deg, #8B5CF6, #A78BFA); border: none; border-radius: 50px;
        cursor: pointer; font-family: inherit; transition: all 0.2s ease;
    }
    .big-btn:hover { transform: translateY(-2px); }

    .lb-panel { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 1rem 1.1rem; margin-top: 1.4rem; }
</style>

<div class="game-container">
    <div class="game-header">
        <h1>🃏 记忆翻牌</h1>
        <div class="subtitle">翻转卡片配对 · 少步数、少用时拿高分</div>
    </div>

    <div class="status-bar">
        <span class="status-item">🎯 步数 <span class="value" id="moves">0</span></span>
        <span class="status-item">⏱️ 用时 <span class="value" id="time">0s</span></span>
        <span class="status-item">🏆 最佳 <span class="value" id="best">--</span></span>
    </div>

    <div class="diff-bar">
        <button class="diff-btn active" data-cols="4" data-pairs="6">😀 简单</button>
        <button class="diff-btn" data-cols="4" data-pairs="8">🙂 中等</button>
        <button class="diff-btn" data-cols="6" data-pairs="12">😈 困难</button>
    </div>

    <div class="board" id="board"></div>

    <div class="result-panel" id="result">
        <h2>🎉 全部配对成功！</h2>
        <p id="rInfo"></p>
        <div class="my-best-bar" id="myBestBar" style="justify-content:center;margin-top:0.8rem;"></div>
        <button class="big-btn" id="restartBtn">🔄 再来一局</button>
    </div>

    <div class="lb-panel">
        <div class="panel-title">🏆 全站排行榜（综合分 = 对数×100 − 步数 − 秒数）</div>
        <div id="lb"></div>
    </div>
</div>

<script src="~/js/casual-game.js"></script>
<script>
(function () {
    'use strict';
    var GAME_KEY = 'memory';
    var emojis = ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐨','🐯','🦁','🐮','🐷','🐸','🐵','🦄','🐙','🦋','🌸','🍎','⭐','🚗','🎈','🍀'];

    var cols = 4, pairs = 6;
    var cards = [], flipped = [], matchedCount = 0, moves = 0, locked = false;
    var startTime = null, timerHandle = null, finished = false;

    function $(id) { return document.getElementById(id); }
    var boardEl = $('board'), movesEl = $('moves'), timeEl = $('time'), bestEl = $('best');

    function bestKey() { return 'memory_best_' + pairs; }
    function loadBest() { try { return parseInt(localStorage.getItem(bestKey()) || '0', 10); } catch (e) { return 0; } }
    function saveBest(v) { try { localStorage.setItem(bestKey(), String(v)); } catch (e) {} }
    function refreshBest() { var b = loadBest(); bestEl.textContent = b > 0 ? b + ' 步' : '--'; }

    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

    function buildBoard() {
        var chosen = shuffle(emojis).slice(0, pairs);
        cards = shuffle(chosen.concat(chosen)).map(function (v) { return { emoji: v, matched: false }; });
        boardEl.style.gridTemplateColumns = 'repeat(' + cols + ', minmax(0, 1fr))';
        boardEl.innerHTML = '';
        for (var i = 0; i < cards.length; i++) {
            var c = document.createElement('div');
            c.className = 'card';
            c.dataset.index = i;
            c.innerHTML = '<div class="face back">❓</div><div class="face front">' + cards[i].emoji + '</div>';
            boardEl.appendChild(c);
        }
    }

    function startTimer() {
        startTime = Date.now();
        timerHandle = setInterval(function () {
            timeEl.textContent = Math.floor((Date.now() - startTime) / 1000) + 's';
        }, 500);
    }

    function finish() {
        finished = true;
        if (timerHandle) clearInterval(timerHandle);
        var s = Math.floor((Date.now() - startTime) / 1000);
        var b = loadBest();
        var isNew = b === 0 || moves < b;
        if (isNew) { saveBest(moves); refreshBest(); }
        $('rInfo').textContent = '难度 ' + pairs + ' 对 · ' + moves + ' 步 · ' + s + ' 秒' + (isNew ? ' · 🏆 新纪录！' : '');
        $('result').classList.add('show');
        CasualGame.Sound.win();

        // 综合分：对数越多、步数越少、用时越短 → 越高
        var score = Math.max(0, pairs * 100 - moves - s);
        CasualGame.submit(GAME_KEY, score, 0).then(function (r) {
            var bar = $('myBestBar');
            if (r && r.ok) {
                bar.innerHTML = '<span>🏆 综合分 <b>' + score + '</b></span>' +
                    '<span>📈 账号最佳 <b>' + r.bestScore + '</b></span>' +
                    '<span>🥇 排名 <b>#' + r.rank + '</b></span>';
            } else bar.innerHTML = '<span>🏆 综合分 <b>' + score + '</b></span>';
            CasualGame.loadLeaderboard(GAME_KEY, $('lb'));
        });
    }

    function onCardClick(el) {
        var idx = parseInt(el.dataset.index, 10);
        if (locked || finished) return;
        if (el.classList.contains('flipped') || el.classList.contains('matched')) return;
        if (flipped.length >= 2) return;
        if (!startTime) startTimer();

        el.classList.add('flipped');
        CasualGame.Sound.flip();
        flipped.push({ el: el, idx: idx });

        if (flipped.length === 2) {
            moves++;
            movesEl.textContent = moves;
            var a = cards[flipped[0].idx], b = cards[flipped[1].idx];
            if (a.emoji === b.emoji) {
                setTimeout(function () {
                    flipped.forEach(function (f) { f.el.classList.remove('flipped'); f.el.classList.add('matched'); });
                    var r = flipped[0].el.getBoundingClientRect();
                    CasualGame.floatText(r.left + r.width / 2, r.top, '✨', '#4ade80');
                    cards[flipped[0].idx].matched = true;
                    cards[flipped[1].idx].matched = true;
                    matchedCount += 2;
                    flipped = [];
                    CasualGame.Sound.match();
                    if (matchedCount === cards.length) finish();
                }, 250);
            } else {
                locked = true;
                var pending = flipped.slice();
                flipped = [];
                setTimeout(function () {
                    pending.forEach(function (f) { f.el.classList.remove('flipped'); });
                    locked = false;
                }, 850);
            }
        }
    }

    function reset() {
        finished = false; moves = 0; matchedCount = 0; flipped = []; locked = false; startTime = null;
        if (timerHandle) clearInterval(timerHandle);
        movesEl.textContent = '0'; timeEl.textContent = '0s';
        $('result').classList.remove('show');
        refreshBest();
        buildBoard();
    }

    var diffBtns = document.querySelectorAll('.diff-btn');
    diffBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
            diffBtns.forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            cols = parseInt(btn.dataset.cols, 10);
            pairs = parseInt(btn.dataset.pairs, 10);
            reset();
        });
    });

    boardEl.addEventListener('click', function (e) {
        var card = e.target.closest('.card');
        if (card) onCardClick(card);
    });

    $('restartBtn').addEventListener('click', reset);

    reset();
    CasualGame.loadLeaderboard(GAME_KEY, $('lb'));
})();
</script>
