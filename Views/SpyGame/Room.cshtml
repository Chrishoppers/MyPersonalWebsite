@{
    ViewData["Title"] = "🕵️ 谁是卧底 · 多人对战";
    var username = Context.Session.GetString("Username") ?? "玩家";
    var prefillCode = ViewBag.RoomCode as string;
}

<style>
    .game-container { max-width: 720px; margin: 0 auto; padding: 1rem 1.2rem 3rem; }
    .game-header { text-align: center; padding: 0.6rem 0 1rem; }
    .game-header h1 {
        font-size: 2rem; font-weight: 800; margin: 0;
        background: linear-gradient(135deg, #EC4899 0%, #F472B6 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .game-header .subtitle { color: rgba(255,255,255,0.3); font-size: 0.82rem; margin-top: 0.2rem; }

    .panel { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 22px; padding: 1.4rem; margin-bottom: 1.1rem; }

    .field { width: 100%; padding: 0.85rem 1.1rem; font-size: 1rem; color: #fff; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 13px; font-family: inherit; outline: none; margin-bottom: 0.7rem; }
    .field:focus { border-color: rgba(236,72,153,0.5); }

    .btn { display: inline-block; padding: 0.7rem 1.8rem; font-size: 0.95rem; font-weight: 700; color: #fff; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; cursor: pointer; font-family: inherit; transition: all 0.15s ease; }
    .btn:hover { transform: translateY(-2px); }
    .btn.primary { background: linear-gradient(135deg, #EC4899, #F472B6); border: none; }
    .btn.green { background: linear-gradient(135deg, #22C55E, #16A34A); border: none; }
    .btn:disabled { opacity: 0.5; cursor: default; transform: none; }

    .room-code { font-size: 2.6rem; font-weight: 900; letter-spacing: 0.15em; color: #F472B6; text-align: center; margin: 0.4rem 0; }

    .player-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.6rem; }
    .player-chip { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.9rem; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; font-weight: 600; }
    .player-chip.dead { opacity: 0.35; text-decoration: line-through; }
    .player-chip .avatar { font-size: 1.3rem; }
    .player-chip .badge { margin-left: auto; font-size: 0.7rem; color: rgba(255,255,255,0.3); }

    .log { max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.45rem; margin-bottom: 0.9rem; }
    .log .line { padding: 0.5rem 0.8rem; background: rgba(255,255,255,0.03); border-radius: 12px; font-size: 0.9rem; color: rgba(255,255,255,0.75); }
    .log .line.speaker { color: #F472B6; }
    .log .line.self { color: #4ade80; }
    .log .line.event { color: #ffc107; }
    .log .line.result { background: rgba(236,72,153,0.14); font-weight: 700; color: #fff; }

    .role-word { font-size: 2.4rem; font-weight: 800; color: #fff; margin: 0.3rem 0; text-align: center; }
    .role-badge { display: inline-block; padding: 0.25rem 1rem; border-radius: 50px; font-size: 0.85rem; font-weight: 700; }
    .role-badge.civilian { background: rgba(40,167,69,0.15); color: #4ade80; }
    .role-badge.spy { background: rgba(220,53,69,0.15); color: #f87171; }

    .vote-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
    .vote-btn { padding: 0.9rem; font-size: 1rem; font-weight: 800; color: #fff; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; cursor: pointer; font-family: inherit; transition: all 0.15s ease; }
    .vote-btn:hover { background: rgba(236,72,153,0.15); border-color: rgba(236,72,153,0.4); }
    .muted { color: rgba(255,255,255,0.3); font-size: 0.85rem; text-align: center; }
    .hidden { display: none !important; }

    @@media (max-width: 480px) { .vote-grid { grid-template-columns: 1fr; } }
</style>

<div class="game-container">
    <div class="game-header">
        <h1>🕵️ 谁是卧底 · 多人对战</h1>
        <div class="subtitle">4-8 人实时对战 · 发言投票找出卧底 · <a href="/SpyGame" style="color:#F472B6;">🤖 人机模式</a></div>
    </div>

    <!-- 入口 -->
    <div class="panel" id="entry">
        <input type="text" class="field" id="nameInput" maxlength="12" placeholder="输入你的昵称" />
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
            <button class="btn primary" id="createBtn" style="flex:1;">🎮 创建房间</button>
        </div>
        <div style="display:flex;gap:0.6rem;margin-top:0.6rem;">
            <input type="text" class="field" id="codeInput" maxlength="9" placeholder="房间码（如 ABCD-EFGH）" style="flex:1;margin-bottom:0;" value="@prefillCode" />
            <button class="btn" id="joinBtn">加入</button>
        </div>
        <div class="muted" id="entryMsg" style="margin-top:0.6rem;"></div>
    </div>

    <!-- 大厅 -->
    <div class="panel hidden" id="lobby">
        <div class="muted">房间码</div>
        <div class="room-code" id="roomCode"></div>
        <div class="muted" style="margin-bottom:0.8rem;">分享房间码，邀请好友加入（至少 4 人）</div>
        <div class="player-list" id="lobbyPlayers"></div>
        <div style="text-align:center;margin-top:1rem;">
            <button class="btn green" id="startBtn" style="display:none;">▶️ 开始游戏</button>
        </div>
    </div>

    <!-- 游戏中 -->
    <div class="panel hidden" id="game">
        <div id="roleCard" class="hidden" style="text-align:center;margin-bottom:0.8rem;"></div>
        <div class="log" id="log"></div>
        <div id="action"></div>
    </div>

    <!-- 结算 -->
    <div class="panel hidden" id="over" style="text-align:center;"></div>
</div>

<script>
(function () {
    'use strict';
    var connection = null;
    var myPlayerId = null, myName = '', roomCode = '', isHost = false;
    var myRole = '', myWord = '', phase = '', currentSpeaker = '';
    var room = null;

    function $(id) { return document.getElementById(id); }
    function show(id) { $(id).classList.remove('hidden'); }
    function hide(id) { $(id).classList.add('hidden'); }
    function log(text, cls) {
        var l = $('log');
        var d = document.createElement('div');
        d.className = 'line' + (cls ? ' ' + cls : '');
        d.textContent = text;
        l.appendChild(d); l.scrollTop = l.scrollHeight;
    }
    function setMsg(text) { $('entryMsg').textContent = text; }

    function renderLobby(room) {
        $('roomCode').textContent = room.code;
        var html = '';
        room.players.forEach(function (p) {
            html += '<div class="player-chip"><span class="avatar">' + (p.isHost ? '👑' : '🧑') + '</span>' + p.name +
                (p.isHost ? '<span class="badge">房主</span>' : '') + '</div>';
        });
        $('lobbyPlayers').innerHTML = html;
        $('startBtn').style.display = (room.players.length >= 4 && isHost) ? 'inline-block' : 'none';
    }

    function renderRoleCard() {
        var role = myRole === 'spy' ? 'spy' : 'civilian';
        $('roleCard').innerHTML =
            '<div class="role-badge ' + role + '">' + (myRole === 'spy' ? '🕵️ 卧底' : '👥 平民') + '</div>' +
            '<div class="role-word">' + myWord + '</div>' +
            '<div class="muted">' + (myRole === 'spy' ? '隐藏身份，别被识破！' : '找出和你描述对不上的卧底！') + '</div>';
        show('roleCard');
    }

    function renderAction(html) { $('action').innerHTML = html; }

    function renderClueInput() {
        renderAction(
            '<div class="muted">轮到你发言，用一句话描述你的词</div>' +
            '<div style="display:flex;gap:0.6rem;margin-top:0.6rem;">' +
            '<input type="text" class="field" id="clueInput" maxlength="30" placeholder="输入描述…" style="flex:1;margin-bottom:0;" />' +
            '<button class="btn primary" id="clueBtn">发言</button></div>');
        var input = $('clueInput');
        function submit() { var c = input.value.trim() || '……'; connection.invoke('Speak', roomCode, myPlayerId, c); renderAction('<div class="muted">已发言，等待其他玩家…</div>'); }
        $('clueBtn').addEventListener('click', submit);
        input.addEventListener('keydown', function (e) { if (e.key === 'Enter') submit(); });
        input.focus();
    }

    function renderVote(room) {
        var html = '<div class="muted">🗳️ 投票：你认为谁是卧底？</div><div class="vote-grid" style="margin-top:0.6rem;">';
        room.players.forEach(function (p) {
            if (!p.alive || p.playerId === myPlayerId) return;
            html += '<button class="vote-btn" data-id="' + p.playerId + '">' + p.name + '</button>';
        });
        html += '</div>';
        renderAction(html);
        var btns = $('action').querySelectorAll('.vote-btn');
        btns.forEach(function (b) {
            b.addEventListener('click', function () {
                connection.invoke('Vote', roomCode, myPlayerId, b.getAttribute('data-id'));
                renderAction('<div class="muted">已投票，等待其他玩家…</div>');
            });
        });
    }

    function findName(room, pid) { var p = room.players.find(function (x) { return x.playerId === pid; }); return p ? p.name : ''; }

    // ============ 连接 ============
    function connect() {
        connection = new signalR.HubConnectionBuilder().withUrl('/spyGameHub').withAutomaticReconnect().build();

        connection.on('RoomCreated', function (data) {
            myPlayerId = data.playerId; roomCode = data.room.code; isHost = true; room = data.room;
            hide('entry'); show('lobby'); renderLobby(data.room);
        });
        connection.on('JoinedRoom', function (data) {
            if (!data.success) { setMsg(data.message); return; }
            myPlayerId = data.playerId; roomCode = data.room.code; isHost = false; room = data.room;
            hide('entry'); show('lobby'); renderLobby(data.room);
        });
        connection.on('RoomUpdated', function (r) { room = r; renderLobby(r); });

        connection.on('GameStarted', function (data) {
            room = data.room;
            hide('lobby'); show('game');
            $('roleCard').classList.add('hidden');
            phase = 'speaking'; currentSpeaker = data.currentSpeaker;
            $('log').innerHTML = '';
        });
        connection.on('YourRole', function (data) { myRole = data.role; myWord = data.word; renderRoleCard(); });

        connection.on('ClueSpoken', function (data) {
            log(data.name + '：' + data.clue, data.playerId === myPlayerId ? 'self' : 'speaker');
        });
        connection.on('TurnChanged', function (data) {
            currentSpeaker = data.currentSpeaker;
            if (currentSpeaker === myPlayerId) renderClueInput();
            else renderAction('<div class="muted">等待 ' + findName(room, currentSpeaker) + ' 发言…</div>');
        });
        connection.on('PhaseChanged', function (data) {
            phase = 'voting';
            log('🗳️ ' + data.message, 'event');
            renderVote(room);
        });
        connection.on('VoteCast', function (data) { log(data.name + ' 已投票', 'event'); });
        connection.on('Eliminated', function (data) {
            log('🚨 ' + data.name + ' 被淘汰，身份：' + (data.wasSpy ? '🕵️ 卧底' : '👥 平民'), 'event');
        });
        connection.on('NewRound', function (data) {
            room = data.room; phase = 'speaking'; currentSpeaker = data.currentSpeaker;
            log('—— 第 ' + data.round + ' 轮发言 ——', 'event');
            if (currentSpeaker === myPlayerId) renderClueInput();
            else renderAction('<div class="muted">等待 ' + findName(room, currentSpeaker) + ' 发言…</div>');
        });
        connection.on('GameOver', function (data) {
            hide('game');
            var win = (data.winner === 'civilian');
            $('over').innerHTML =
                '<div style="font-size:3rem;">' + (win ? '🎉' : '💀') + '</div>' +
                '<h2 style="color:#F472B6;">' + (win ? '平民胜利！' : '卧底获胜！') + '</h2>' +
                '<p class="muted">卧底是 <b style="color:#fff;">' + data.spyName + '</b></p>' +
                '<p class="muted">平民词「' + data.civilianWord + '」 · 卧底词「' + data.spyWord + '」</p>' +
                '<a class="btn primary" href="/SpyGame/Room" style="margin-top:0.8rem;">🔄 再来一局</a>';
            show('over');
        });
        connection.on('Error', function (msg) { setMsg(msg); });

        connection.start().then(function () {
            if ('@prefillCode') { /* 有预填房间码则提示输入昵称后加入 */ }
        }).catch(function (e) { setMsg('连接失败，请刷新重试'); });
    }

    $('createBtn').addEventListener('click', function () {
        myName = $('nameInput').value.trim();
        if (!myName) { setMsg('请输入昵称'); return; }
        connection.invoke('CreateRoom', myName);
    });
    $('joinBtn').addEventListener('click', function () {
        myName = $('nameInput').value.trim();
        var code = $('codeInput').value.trim().toUpperCase();
        if (!myName) { setMsg('请输入昵称'); return; }
        if (!code) { setMsg('请输入房间码'); return; }
        connection.invoke('JoinRoom', code, myName);
    });
    $('startBtn').addEventListener('click', function () {
        connection.invoke('StartGame', roomCode, myPlayerId);
    });

    connect();
})();
</script>
