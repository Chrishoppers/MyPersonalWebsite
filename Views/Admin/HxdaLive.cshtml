@model List<MyPersonalWebsite.Models.HxdaPlayer>

@{
    ViewData["Title"] = "实时在线";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1) { Context.Response.Redirect("/Auth/Login"); return; }
}

<style>
    .live-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .live-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .live-header h1 {
            color: #fff;
            font-size: 1.6rem;
            margin: 0;
        }

        .live-header .pulse {
            display: inline-block;
            width: 10px;
            height: 10px;
            background: #28a745;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
            margin-right: 0.5rem;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .live-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px,1fr));
        gap: 1rem;
    }

    .live-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(40,167,69,0.15);
        border-radius: 16px;
        padding: 1.2rem;
        transition: all 0.3s;
    }

        .live-card:hover {
            background: rgba(255,255,255,0.05);
            border-color: rgba(40,167,69,0.3);
        }

        .live-card .name {
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0.3rem;
        }

        .live-card .page {
            font-family: monospace;
            font-size: 0.75rem;
            color: #4facfe;
            margin-bottom: 0.6rem;
        }

        .live-card .row {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            padding: 0.2rem 0;
        }

            .live-card .row .k {
                color: rgba(255,255,255,0.3);
            }

            .live-card .row .v {
                color: rgba(255,255,255,0.8);
            }

        .live-card .actions {
            margin-top: 0.8rem;
            display: flex;
            gap: 0.4rem;
        }

        .live-card .btn-sm {
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.7rem;
            text-decoration: none;
            display: inline-block;
            border: none;
            cursor: pointer;
        }

            .live-card .btn-sm.primary {
                background: rgba(79,172,254,0.12);
                color: #4facfe;
            }

            .live-card .btn-sm.warn {
                background: rgba(255,193,7,0.12);
                color: #ffc107;
            }

        .live-card .sig {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid rgba(255,255,255,0.1);
            float: right;
        }
</style>

<div class="live-container">
    <div class="live-header">
        <h1><span class="pulse"></span>🟢 实时在线（@Model.Count）</h1>
        <div>
            <a href="/AdminHxda/Players" style="color:rgba(255,255,255,0.5);text-decoration:none;">← 玩家列表</a>
            <button onclick="sendAllGlitch()" style="padding:0.5rem 1.5rem;border-radius:40px;border:none;background:linear-gradient(135deg,#dc3545,#e55353);color:#fff;font-weight:600;font-size:0.9rem;cursor:pointer;margin-left:1rem;">💥 一键全部干预</button>
        </div>
    </div>

    <div class="live-list" id="liveList">
        @foreach (var p in Model)
        {
            <div class="live-card">
                @if (!string.IsNullOrEmpty(p.SignatureImage) && p.SignatureImage.StartsWith("data:image"))
                {
                    <img src="@p.SignatureImage" class="sig" />
                }
                <div class="name">@(string.IsNullOrEmpty(p.VisitorName) ? "无名" : p.VisitorName)</div>
                <div class="page">📍 @p.CurrentPage</div>
                <div class="row"><span class="k">真实名字</span><span class="v">@(string.IsNullOrEmpty(p.RealName) ? "—" : p.RealName)</span></div>
                <div class="row"><span class="k">注意值</span><span class="v">@p.Attention</span></div>
                <div class="row"><span class="k">节点</span><span class="v">@p.NodeReadList.Count / 7</span></div>
                <div class="row"><span class="k">结局</span><span class="v">@(p.EndingsSeenList.Count == 0 ? "—" : string.Join(", ", p.EndingsSeenList))</span></div>
                <div class="actions">
                    <a href="/AdminHxda/PlayerDetail?id=@p.Id" class="btn-sm primary">👁️ 详情</a>
                    <a href="/AdminHxda/Control?id=@p.Id" class="btn-sm warn">🎛️ 干预</a>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div style="color:rgba(255,255,255,0.15);text-align:center;padding:3rem;grid-column:1/-1;">🟢 当前没有玩家在线</div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
<script>
    var ws = new signalR.HubConnectionBuilder()
        .withUrl('/hxdaHub')
        .withAutomaticReconnect()
        .build();

    ws.on('PlayerReport', function (data) { location.reload(); });
    ws.on('PlayerHeartbeat', function (playerId) { /* 可更新具体卡片 */ });

    ws.start().then(function () { ws.invoke('JoinAdmin'); });

    /* 一键全部干预：发送给后端，由后端广播 */
    function sendAllGlitch() {
        if (!confirm('确定要对所有在线玩家发送画面扭曲吗？')) return;
        fetch('/AdminHxda/SendCommandAll', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'type=glitch&payload='
        })
        .then(r => r.json())
        .then(d => { if (d.success) alert('已发送给 ' + d.count + ' 位玩家'); });
    }

    /* 兜底：每 15 秒刷新一次 */
    setTimeout(function () { location.reload(); }, 15000);
</script>