@{
    ViewData["Title"] = "📋 用户行为审计";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }

    var logs = ViewBag.Logs as List<MyPersonalWebsite.Models.UserActivityLog> ?? new List<MyPersonalWebsite.Models.UserActivityLog>();
    var stats = ViewBag.Stats as List<MyPersonalWebsite.Models.UserActivityStats> ?? new List<MyPersonalWebsite.Models.UserActivityStats>();
    var userStats = ViewBag.UserStats as MyPersonalWebsite.Models.UserActivityStats;
    var targetUser = ViewBag.TargetUser as MyPersonalWebsite.Models.User;
    var users = ViewBag.Users as List<MyPersonalWebsite.Models.User> ?? new List<MyPersonalWebsite.Models.User>();
    var actionTypes = ViewBag.ActionTypes as string[] ?? new string[0];
    var userId = ViewBag.UserId as int?;
    var search = ViewBag.Search as string;
    var actionType = ViewBag.ActionType as string;
    var page = ViewBag.Page as int? ?? 1;
}

<style>
    .audit-container { max-width: 1400px; margin: 0 auto; padding: 1rem 1.5rem; }
    .audit-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .audit-header h1 { font-size: 1.8rem; font-weight: 800; background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin: 0; }

    .btn-glass { padding: 0.4rem 1.2rem; border: 1px solid rgba(255,255,255,0.04); border-radius: 40px; background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.3); text-decoration: none; font-size: 0.8rem; transition: all 0.3s ease; display: inline-block; }
    .btn-glass:hover { background: rgba(255,255,255,0.04); color: #fff; }
    .btn-glass.primary { background: linear-gradient(135deg, #8B5CF6, #EC4899); border: none; color: #fff; }
    .btn-glass.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(108,60,225,0.2); }
    .btn-glass.danger { background: rgba(220,53,69,0.08); border-color: rgba(220,53,69,0.08); color: #dc3545; }
    .btn-glass.danger:hover { background: rgba(220,53,69,0.15); }

    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-radius: 16px; padding: 1rem 1.2rem; text-align: center; }
    .stat-card .num { font-size: 1.6rem; font-weight: 700; color: #fff; }
    .stat-card .label { font-size: 0.7rem; color: rgba(255,255,255,0.3); margin-top: 0.1rem; }
    .stat-card.purple .num { color: #8B5CF6; }
    .stat-card.green .num { color: #28a745; }
    .stat-card.gold .num { color: #F59E0B; }
    .stat-card.red .num { color: #dc3545; }
    .stat-card.blue .num { color: #4facfe; }

    .filter-bar { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.5rem; padding: 1rem 1.5rem; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(255,255,255,0.04); align-items: center; }
    .filter-bar select, .filter-bar input { padding: 0.4rem 1rem; border-radius: 30px; border: 1px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.04); color: #e0e0e0; font-size: 0.85rem; outline: none; }
    .filter-bar select option { background: #1a1a2e; color: #e0e0e0; }

    /* 排行表格 */
    .rank-section { background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px solid rgba(255,255,255,0.04); padding: 1rem 1.5rem; margin-bottom: 2rem; }
    .rank-section .section-title { font-size: 0.9rem; font-weight: 600; color: #fff; margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem; }
    .rank-item { display: flex; align-items: center; gap: 0.8rem; padding: 0.3rem 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.02); }
    .rank-item:last-child { border-bottom: none; }
    .rank-item .rank-num { font-size: 0.7rem; color: rgba(255,255,255,0.15); min-width: 28px; font-weight: 700; }
    .rank-item .rank-num.gold { color: #F59E0B; }
    .rank-item .rank-num.silver { color: #9CA3AF; }
    .rank-item .rank-num.bronze { color: #D97706; }
    .rank-item .rank-name { flex: 1; color: rgba(255,255,255,0.4); font-size: 0.8rem; }
    .rank-item .rank-name .highlight { color: #fff; font-weight: 600; }
    .rank-item .rank-name .me { color: #8B5CF6; font-weight: 700; }
    .rank-item .rank-value { font-size: 0.8rem; font-weight: 600; }
    .rank-item .rank-value.actions { color: #4facfe; }
    .rank-item .rank-value.violations { color: #dc3545; }
    .rank-item .rank-value.warnings { color: #F59E0B; }
    .rank-item .rank-badge { font-size: 0.45rem; padding: 0.05rem 0.5rem; border-radius: 20px; font-weight: 600; }
    .rank-badge.low { background: rgba(40,167,69,0.08); color: #28a745; }
    .rank-badge.medium { background: rgba(255,193,7,0.08); color: #ffc107; }
    .rank-badge.high { background: rgba(245,158,11,0.08); color: #F59E0B; }
    .rank-badge.critical { background: rgba(220,53,69,0.08); color: #dc3545; }

    /* 日志列表 */
    .log-item { display: flex; align-items: flex-start; gap: 1rem; padding: 0.6rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.02); transition: background 0.2s ease; border-radius: 8px; }
    .log-item:hover { background: rgba(255,255,255,0.02); }
    .log-item .log-icon { font-size: 1.2rem; flex-shrink: 0; margin-top: 0.1rem; }
    .log-item .log-content { flex: 1; min-width: 0; }
    .log-item .log-content .log-desc { color: rgba(255,255,255,0.6); font-size: 0.85rem; }
    .log-item .log-content .log-desc strong { color: #fff; }
    .log-item .log-content .log-meta { color: rgba(255,255,255,0.15); font-size: 0.65rem; margin-top: 0.1rem; display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; }
    .log-item .log-content .log-meta .tag { padding: 0.05rem 0.5rem; border-radius: 20px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.02); }
    .log-item .log-time { color: rgba(255,255,255,0.08); font-size: 0.6rem; flex-shrink: 0; }

    .empty-state { text-align: center; padding: 3rem 1rem; color: rgba(255,255,255,0.08); }
    .empty-state .icon { font-size: 3rem; display: block; margin-bottom: 0.5rem; opacity: 0.3; }

    .pagination { display: flex; gap: 0.3rem; justify-content: center; margin-top: 1rem; }
    .pagination .page-btn { padding: 0.2rem 0.8rem; border-radius: 20px; border: 1px solid rgba(255,255,255,0.04); background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.2); text-decoration: none; font-size: 0.75rem; transition: all 0.3s ease; }
    .pagination .page-btn:hover { background: rgba(255,255,255,0.04); color: #fff; }
    .pagination .page-btn.active { background: rgba(139,92,246,0.08); color: #8B5CF6; border-color: rgba(139,92,246,0.04); }

    @@media (max-width: 640px) {
        .filter-bar { flex-direction: column; align-items: stretch; }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .log-item { flex-direction: column; gap: 0.3rem; }
        .rank-section { padding: 0.8rem; }
    }
</style>

<div class="audit-container">
    <div class="audit-header">
        <h1>📋 用户行为审计</h1>
        <div>
            <a href="/Admin/Dashboard" class="btn-glass">← 返回后台</a>
        </div>
    </div>

    <!-- ===== 统计 ===== -->
    <div class="stats-row">
        <div class="stat-card purple">
            <div class="num">@stats.Count</div>
            <div class="label">👥 活跃用户</div>
        </div>
        <div class="stat-card gold">
            <div class="num">@stats.Sum(s => s.TotalActions)</div>
            <div class="label">📊 总行为数</div>
        </div>
        <div class="stat-card red">
            <div class="num">@stats.Sum(s => s.ViolationCount)</div>
            <div class="label">🚫 违规总数</div>
        </div>
        <div class="stat-card blue">
            <div class="num">@stats.Count(s => s.RiskLevel == "high" || s.RiskLevel == "critical")</div>
            <div class="label">⚠️ 高风险用户</div>
        </div>
    </div>

    <!-- ===== 用户排行 ===== -->
    <div class="rank-section">
        <div class="section-title">🏆 用户行为排行</div>
        <div style="max-height:300px;overflow-y:auto;">
            @if (stats.Any())
            {
                var medals = new[] { "🥇", "🥈", "🥉" };
                foreach (var item in stats.Take(20))
                {
                    var rankClass = item.Rank <= 3 ? new[] { "gold", "silver", "bronze" }[item.Rank - 1] : "";
                    var medal = item.Rank <= 3 ? medals[item.Rank - 1] : $"#{item.Rank}";
                    var isMe = item.UserId == (Context.Session.GetInt32("UserId") ?? 0);
                    var riskLabel = item.RiskLevel == "low" ? "🟢 低" :
                                    item.RiskLevel == "medium" ? "🟡 中" :
                                    item.RiskLevel == "high" ? "🟠 高" : "🔴 严重";

                    <div class="rank-item">
                        <span class="rank-num @rankClass">@medal</span>
                        <span class="rank-name">
                            <span class="@(isMe ? "highlight me" : "highlight")">@item.Username</span>
                            @if (isMe) { <span style="color:#8B5CF6;font-size:0.55rem;">(我)</span> }
                        </span>
                        <span class="rank-value actions">@item.TotalActions 次</span>
                        <span class="rank-value violations">🚫 @item.ViolationCount</span>
                        <span class="rank-value warnings">⚠️ @item.WarningCount</span>
                        <span class="rank-badge @item.RiskLevel">@riskLabel</span>
                        <a href="/Admin/UserAudit?userId=@item.UserId" class="btn-glass" style="font-size:0.6rem;padding:0.1rem 0.6rem;">👁️</a>
                    </div>
                }
            }
            else
            {
                <div class="empty-state"><span class="icon">📊</span>暂无用户行为数据</div>
            }
        </div>
    </div>

    <!-- ===== 筛选 ===== -->
    <div class="filter-bar">
        <span style="color:rgba(255,255,255,0.2);font-size:0.8rem;">🔍 筛选：</span>
        <input type="text" id="searchInput" placeholder="搜索用户名..." value="@search" style="flex:1;min-width:140px;" />
        <select id="actionTypeFilter">
            <option value="">全部行为</option>
            @foreach (var type in actionTypes)
            {
                <option value="@type" selected="@(actionType == type)">@type</option>
            }
        </select>
        <button class="btn-glass" onclick="applyFilters()">应用</button>
        <button class="btn-glass" onclick="resetFilters()">重置</button>
    </div>

    <!-- ===== 日志列表 ===== -->
    @if (logs.Any())
    {
        <div style="background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.04);padding:0.5rem 0;">
            @foreach (var log in logs)
            {
                var iconMap = new Dictionary<string, string> {
                    { "Login", "🔐" }, { "Logout", "🚪" }, { "SubmitResource", "📤" },
                    { "PostMessage", "💬" }, { "PostBlog", "📝" }, { "Like", "❤️" },
                    { "Report", "🚩" }, { "Ban", "🚫" }, { "Unban", "✅" },
                    { "Delete", "🗑️" }, { "Warning", "⚠️" }
                };
                var icon = iconMap.ContainsKey(log.ActionType) ? iconMap[log.ActionType] : "📌";

                <div class="log-item">
                    <span class="log-icon">@icon</span>
                    <div class="log-content">
                        <div class="log-desc">
                            <strong>@log.Username</strong>
                            @log.Description
                            @if (!string.IsNullOrEmpty(log.TargetType))
                            {
                                <span style="color:rgba(255,255,255,0.15);font-size:0.7rem;">(关联: @log.TargetType #@log.TargetId)</span>
                            }
                        </div>
                        <div class="log-meta">
                            <span class="tag">@log.ActionCategory</span>
                            <span class="tag">@log.ActionType</span>
                            @if (!string.IsNullOrEmpty(log.IpAddress))
                            {
                                <span>📍 @log.IpAddress</span>
                            }
                            <span>📱 @(log.UserAgent?.Length > 30 ? log.UserAgent.Substring(0,30)+"..." : log.UserAgent)</span>
                            <span class="tag @(log.Status == "success" ? "status-success" : "status-failed")">
                                @(log.Status == "success" ? "✅ 成功" : "❌ 失败")
                            </span>
                        </div>
                    </div>
                    <div class="log-time">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            }
        </div>

        <div class="pagination">
            <a href="/Admin/UserAudit?page=@(page-1)&userId=@userId&search=@search&actionType=@actionType" class="page-btn" disabled="@(page <= 1)">←</a>
            <span class="page-btn active">@page</span>
            <a href="/Admin/UserAudit?page=@(page+1)&userId=@userId&search=@search&actionType=@actionType" class="page-btn">→</a>
        </div>
    }
    else
    {
        <div class="empty-state"><span class="icon">📭</span>暂无行为日志</div>
    }
</div>

<script>
    function applyFilters() {
        var search = document.getElementById('searchInput').value;
        var actionType = document.getElementById('actionTypeFilter').value;
        var url = '/Admin/UserAudit?page=1';
        if (search) url += '&search=' + encodeURIComponent(search);
        if (actionType) url += '&actionType=' + encodeURIComponent(actionType);
        window.location.href = url;
    }

    function resetFilters() {
        window.location.href = '/Admin/UserAudit';
    }

    document.getElementById('searchInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') applyFilters();
    });
</script>
