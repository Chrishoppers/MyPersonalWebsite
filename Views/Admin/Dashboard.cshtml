@{
    ViewData["Title"] = "管理后台";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var username = Context.Session.GetString("Username") ?? "管理员";
    var userId = Context.Session.GetInt32("UserId") ?? 0;
}

<style>
    /* ===== 全局 ===== */
    body {
        background: #0b0e1a;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #e0e0e0;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    /* ===== 头部 ===== */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .dashboard-header .left h1 {
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 50%, #4facfe 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .dashboard-header .left .greeting {
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.9rem;
        margin-top: 0.1rem;
    }

    .dashboard-header .right {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .dashboard-header .right .user-badge {
        padding: 0.4rem 1.2rem;
        border-radius: 40px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.85rem;
    }

    .btn-glass {
        padding: 0.5rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.7);
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .btn-glass:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.12);
        color: #fff;
        transform: translateY(-1px);
    }

    .btn-glass.danger {
        background: rgba(220, 53, 69, 0.08);
        border-color: rgba(220, 53, 69, 0.08);
        color: #dc3545;
    }

    .btn-glass.danger:hover {
        background: rgba(220, 53, 69, 0.15);
    }

    .btn-glass.primary {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        border: none;
        color: #fff;
    }

    .btn-glass.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108, 60, 225, 0.2);
    }

    /* ===== 统计卡片 ===== */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 20px;
        padding: 1.2rem 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        background: rgba(255, 255, 255, 0.05);
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .stat-card .number {
        font-size: 2.2rem;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }

    .stat-card .label {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.35);
        margin-top: 0.2rem;
        font-weight: 400;
    }

    .stat-card .icon {
        font-size: 1.2rem;
        margin-right: 0.3rem;
    }

    .stat-card.blue .number { color: #4facfe; }
    .stat-card.green .number { color: #28a745; }
    .stat-card.pink .number { color: #f5576c; }
    .stat-card.orange .number { color: #ffc107; }
    .stat-card.purple .number { color: #a855f7; }
    .stat-card.red .number { color: #dc3545; }
    .stat-card.cyan .number { color: #06b6d4; }
    .stat-card.online .number { color: #28a745; }
    .stat-card.gold .number { color: #F59E0B; }

    /* ===== 统计表格 ===== */
    .stats-section {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.04);
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .stats-section .section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .stats-section .section-title .badge {
        font-size: 0.6rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.04);
        color: rgba(255, 255, 255, 0.2);
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.5rem;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0.8rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .stat-item:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .stat-item .label {
        color: rgba(255, 255, 255, 0.3);
        font-size: 0.8rem;
    }

    .stat-item .value {
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .stat-item .value.highlight {
        color: #8B5CF6;
    }
    .stat-item .value.green {
        color: #28a745;
    }
    .stat-item .value.red {
        color: #dc3545;
    }
    .stat-item .value.orange {
        color: #ffc107;
    }
    .stat-item .value.pink {
        color: #EC4899;
    }

    /* ===== 快速操作卡片 ===== */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.2rem;
        margin-bottom: 2rem;
    }

    .card-item {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        padding: 1.5rem 1.8rem;
        border: 1px solid rgba(255, 255, 255, 0.04);
        transition: all 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
        overflow: hidden;
    }

    .card-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(135deg, #f093fb, #f5576c);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .card-item:hover {
        background: rgba(255, 255, 255, 0.05);
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.06);
    }

    .card-item:hover::before {
        opacity: 1;
    }

    .card-item .card-icon {
        font-size: 2rem;
        margin-bottom: 0.3rem;
        display: block;
    }

    .card-item .card-title {
        font-weight: 600;
        font-size: 1.05rem;
        color: #fff;
        margin-bottom: 0.2rem;
    }

    .card-item .card-desc {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.3);
    }

    .card-item .card-badge {
        position: absolute;
        top: 0.8rem;
        right: 1rem;
        font-size: 0.65rem;
        padding: 0.15rem 0.6rem;
        border-radius: 20px;
        font-weight: 500;
    }

    .card-badge.pending {
        background: rgba(255, 193, 7, 0.12);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.06);
    }

    .card-badge.count {
        background: rgba(79, 172, 254, 0.12);
        color: #4facfe;
        border: 1px solid rgba(79, 172, 254, 0.06);
    }

    .card-badge.danger {
        background: rgba(220, 53, 69, 0.12);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.06);
    }

    /* ===== 导出按钮 ===== */
    .btn-export {
        padding: 0.6rem 2rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        margin-top: 0.5rem;
    }

    .btn-export:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(79, 172, 254, 0.2);
    }

    /* ===== 最近活动 ===== */
    .activity-section {
        background: rgba(255, 255, 255, 0.02);
        border-radius: 20px;
        padding: 1.5rem 1.8rem;
        border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .activity-section .section-title {
        font-weight: 600;
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .activity-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }

    .activity-item:last-child {
        border-bottom: none;
    }

    .activity-item .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .activity-item .dot.blue { background: #4facfe; }
    .activity-item .dot.green { background: #28a745; }
    .activity-item .dot.orange { background: #ffc107; }
    .activity-item .dot.pink { background: #f5576c; }
    .activity-item .dot.purple { background: #a855f7; }
    .activity-item .dot.red { background: #dc3545; }

    .activity-item .act-text {
        flex: 1;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.6);
    }

    .activity-item .act-text strong {
        color: #fff;
        font-weight: 600;
    }

    .activity-item .act-time {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.2);
        flex-shrink: 0;
    }

    .empty-state {
        text-align: center;
        padding: 1.5rem;
        color: rgba(255, 255, 255, 0.2);
        font-size: 0.9rem;
    }

    /* ===== 响应式 ===== */
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }
        .dashboard-header .right {
            justify-content: space-between;
            flex-wrap: wrap;
        }
        .dashboard-header .left h1 {
            font-size: 1.4rem;
        }
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.6rem;
        }
        .stat-card {
            padding: 0.8rem 1rem;
        }
        .stat-card .number {
            font-size: 1.6rem;
        }
        .card-grid {
            grid-template-columns: 1fr 1fr;
        }
        .stat-grid {
            grid-template-columns: 1fr;
        }
        .activity-section {
            padding: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: 1fr 1fr;
        }
        .card-grid {
            grid-template-columns: 1fr;
        }
        .stat-card .number {
            font-size: 1.3rem;
        }
        .stat-card .label {
            font-size: 0.65rem;
        }
        .stat-item .label {
            font-size: 0.7rem;
        }
        .stat-item .value {
            font-size: 0.75rem;
        }
    }
</style>

<div class="dashboard-container">

    <!-- ===== 头部 ===== -->
    <div class="dashboard-header">
        <div class="left">
            <h1>⚙️ 管理后台</h1>
            <div class="greeting">👋 欢迎回来，<strong>@username</strong></div>
        </div>
        <div class="right">
            <span class="user-badge">👑 管理员</span>
            <a href="/Admin/Dashboard" class="btn-glass" style="background:rgba(79,172,254,0.08);color:#4facfe;border-color:rgba(79,172,254,0.08);">
                🔄 刷新
            </a>
            <a href="/Auth/Logout" class="btn-glass danger">
                🚪 退出
            </a>
        </div>
    </div>

    <!-- ===== 快速统计 ===== -->
    <div class="stats-row">
        <div class="stat-card blue">
            <div class="number"><span class="icon">👤</span> @ViewBag.ActiveUsers</div>
            <div class="label">活跃用户</div>
        </div>
        <div class="stat-card red">
            <div class="number"><span class="icon">🚫</span> @ViewBag.BannedUsers</div>
            <div class="label">已封禁</div>
        </div>
        <div class="stat-card purple">
            <div class="number"><span class="icon">🔒</span> @ViewBag.RestrictedUsers</div>
            <div class="label">受限用户</div>
        </div>
        <div class="stat-card orange">
            <div class="number"><span class="icon">⏳</span> @ViewBag.PendingApproval</div>
            <div class="label">待审核</div>
        </div>
        <div class="stat-card pink">
            <div class="number"><span class="icon">💬</span> @ViewBag.PendingMessages</div>
            <div class="label">待审核留言</div>
        </div>
        <div class="stat-card gold">
            <div class="number"><span class="icon">📦</span> @ViewBag.PendingResourceRequests</div>
            <div class="label">待处理资源</div>
        </div>
    </div>

    <!-- ===== ⭐ 超级详细统计 ===== -->
    <div class="stats-section">
        <div class="section-title">
            📊 超级详细统计
            <span class="badge">实时</span>
            <button class="btn-export" onclick="exportStats()" style="margin-left:auto;padding:0.3rem 1.2rem;font-size:0.7rem;">📥 导出CSV</button>
            <button id="toggleDetails" class="btn-glass" style="margin-left:0.6rem;padding:0.3rem 0.8rem;font-size:0.75rem;" onclick="toggleDetails()">隐藏详情</button>
        </div>

        <div id="detailsContent">

        <!-- 用户统计 -->
        <h4 style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin:0.5rem 0 0.3rem;text-transform:uppercase;letter-spacing:0.06em;">👤 用户统计</h4>
        <div class="stat-grid">
            <div class="stat-item"><span class="label">总用户数</span><span class="value">@ViewBag.TotalUsers</span></div>
            <div class="stat-item"><span class="label">活跃用户</span><span class="value highlight">@ViewBag.ActiveUsers</span></div>
            <div class="stat-item"><span class="label">已删除用户</span><span class="value red">@ViewBag.DeletedUsers</span></div>
            <div class="stat-item"><span class="label">管理员</span><span class="value pink">@ViewBag.AdminUsers</span></div>
            <div class="stat-item"><span class="label">普通用户</span><span class="value">@ViewBag.NormalUsers</span></div>
            <div class="stat-item"><span class="label">🚫 已封禁</span><span class="value red">@ViewBag.BannedUsers</span></div>
            <div class="stat-item"><span class="label">&nbsp;&nbsp;永久封禁</span><span class="value red">@ViewBag.PermanentBanned</span></div>
            <div class="stat-item"><span class="label">&nbsp;&nbsp;临时封禁</span><span class="value orange">@ViewBag.TempBanned</span></div>
            <div class="stat-item"><span class="label">&nbsp;&nbsp;已过期封禁</span><span class="value">@ViewBag.ExpiredBans</span></div>
            <div class="stat-item"><span class="label">✅ 已验证邮箱</span><span class="value green">@ViewBag.EmailVerified</span></div>
            <div class="stat-item"><span class="label">⏳ 未验证邮箱</span><span class="value orange">@ViewBag.EmailUnverified</span></div>
            <div class="stat-item"><span class="label">✅ 已审核通过</span><span class="value green">@ViewBag.ApprovedUsers</span></div>
            <div class="stat-item"><span class="label">⏳ 待审核</span><span class="value orange">@ViewBag.PendingApproval</span></div>
            <div class="stat-item"><span class="label">🔒 受限用户</span><span class="value purple">@ViewBag.RestrictedUsers</span></div>
            <div class="stat-item"><span class="label">🖼️ 有头像</span><span class="value">@ViewBag.HasAvatar</span></div>
            <div class="stat-item"><span class="label">⏳ 头像待审核</span><span class="value orange">@ViewBag.AvatarPending</span></div>
            <div class="stat-item"><span class="label">📷 无头像</span><span class="value">@ViewBag.NoAvatar</span></div>
            <div class="stat-item"><span class="label">✏️ 待审核昵称修改</span><span class="value orange">@ViewBag.PendingUsernameChanges</span></div>
            <div class="stat-item"><span class="label">✏️ 待审核邮箱修改</span><span class="value orange">@ViewBag.PendingEmailChanges</span></div>
            <div class="stat-item"><span class="label">📧 开启连对邮件</span><span class="value green">@ViewBag.StreakEmailEnabled</span></div>
            <div class="stat-item"><span class="label">📅 今日注册</span><span class="value">@ViewBag.RegisteredToday</span></div>
            <div class="stat-item"><span class="label">📅 本周注册</span><span class="value">@ViewBag.RegisteredThisWeek</span></div>
            <div class="stat-item"><span class="label">📅 本月注册</span><span class="value">@ViewBag.RegisteredThisMonth</span></div>
            <div class="stat-item"><span class="label">🟢 今日登录</span><span class="value green">@ViewBag.LoggedInToday</span></div>
            <div class="stat-item"><span class="label">🟢 本周登录</span><span class="value">@ViewBag.LoggedInThisWeek</span></div>
            <div class="stat-item"><span class="label">💤 从未登录</span><span class="value red">@ViewBag.NeverLoggedIn</span></div>
        </div>

        <!-- 留言统计 -->
        <h4 style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin:1rem 0 0.3rem;text-transform:uppercase;letter-spacing:0.06em;">💬 留言统计</h4>
        <div class="stat-grid">
            <div class="stat-item"><span class="label">总留言</span><span class="value">@ViewBag.TotalMessages</span></div>
            <div class="stat-item"><span class="label">✅ 已审核</span><span class="value green">@ViewBag.ApprovedMessages</span></div>
            <div class="stat-item"><span class="label">⏳ 待审核</span><span class="value orange">@ViewBag.PendingMessages</span></div>
            <div class="stat-item"><span class="label">🚩 被举报</span><span class="value red">@ViewBag.ReportedMessages</span></div>
            <div class="stat-item"><span class="label">❤️ 总点赞</span><span class="value pink">@ViewBag.TotalLikes</span></div>
            <div class="stat-item"><span class="label">💬 有回复</span><span class="value">@ViewBag.MessagesWithReply</span></div>
        </div>

        <!-- 资源申请统计 -->
        <h4 style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin:1rem 0 0.3rem;text-transform:uppercase;letter-spacing:0.06em;">📦 资源申请统计</h4>
        <div class="stat-grid">
            <div class="stat-item"><span class="label">总申请</span><span class="value">@ViewBag.TotalResourceRequests</span></div>
            <div class="stat-item"><span class="label">⏳ 待付款</span><span class="value orange">@ViewBag.PendingPayments</span></div>
            <div class="stat-item"><span class="label">✅ 已付款</span><span class="value green">@ViewBag.PaidRequests</span></div>
            <div class="stat-item"><span class="label">📋 待处理</span><span class="value orange">@ViewBag.PendingResourceRequests</span></div>
            <div class="stat-item"><span class="label">✅ 已完成</span><span class="value green">@ViewBag.CompletedRequests</span></div>
            <div class="stat-item"><span class="label">❌ 已拒绝</span><span class="value red">@ViewBag.RejectedRequests</span></div>
            <div class="stat-item"><span class="label">💰 已退款</span><span class="value gold">@ViewBag.RefundedRequests</span></div>
            <div class="stat-item"><span class="label">🔍 待人工核验</span><span class="value red">@ViewBag.ManualVerifyNeeded</span></div>
            <div class="stat-item"><span class="label">💰 总金额</span><span class="value gold">¥@ViewBag.TotalResourceAmount</span></div>
        </div>

        <!-- 其他统计 -->
        <h4 style="color:rgba(255,255,255,0.3);font-size:0.75rem;margin:1rem 0 0.3rem;text-transform:uppercase;letter-spacing:0.06em;">📊 其他统计</h4>
        <div class="stat-grid">
            <div class="stat-item"><span class="label">📖 博客总数</span><span class="value">@ViewBag.TotalBlogs</span></div>
            <div class="stat-item"><span class="label">❤️ 博客总赞</span><span class="value pink">@ViewBag.TotalBlogLikes</span></div>
            <div class="stat-item"><span class="label">🔑 授权码申请</span><span class="value">@ViewBag.TotalContactRequests</span></div>
            <div class="stat-item"><span class="label">✅ 已使用授权码</span><span class="value green">@ViewBag.UsedContactRequests</span></div>
            <div class="stat-item"><span class="label">⏳ 待处理授权码</span><span class="value orange">@ViewBag.PendingContactRequests</span></div>
            <div class="stat-item"><span class="label">📬 总通知</span><span class="value">@ViewBag.TotalNotifications</span></div>
            <div class="stat-item"><span class="label">✅ 已读通知</span><span class="value green">@ViewBag.ReadNotifications</span></div>
            <div class="stat-item"><span class="label">⏳ 未读通知</span><span class="value orange">@ViewBag.UnreadNotifications</span></div>
        </div>
    </div>

    <!-- ===== 快速操作卡片 ===== -->
    <div class="card-grid">
        <a href="/Admin/Blogs" class="card-item">
            <span class="card-icon">📖</span>
            <div class="card-title">博客管理</div>
            <div class="card-desc">发布、编辑、删除文章</div>
            @if (ViewBag.BlogCount > 0)
            {
                <span class="card-badge count">@ViewBag.BlogCount 篇</span>
            }
        </a>

        <a href="/Admin/Messages" class="card-item">
            <span class="card-icon">💬</span>
            <div class="card-title">留言管理</div>
            <div class="card-desc">审核、回复、删除留言</div>
            @if (ViewBag.PendingMessages > 0)
            {
                <span class="card-badge pending">@ViewBag.PendingMessages 待审核</span>
            }
            else
            {
                <span class="card-badge count">@ViewBag.MessageCount 条</span>
            }
        </a>

        <a href="/Admin/Users" class="card-item">
            <span class="card-icon">👥</span>
            <div class="card-title">用户管理</div>
            <div class="card-desc">查看、封禁、管理所有用户</div>
            <span class="card-badge count">@ViewBag.ActiveUsers 人</span>
        </a>

        <a href="/Admin/ContactRequests" class="card-item">
            <span class="card-icon">🔑</span>
            <div class="card-title">授权码管理</div>
            <div class="card-desc">查看、标记、管理授权码</div>
            @if (ViewBag.PendingContactRequests > 0)
            {
                <span class="card-badge pending">@ViewBag.PendingContactRequests 待处理</span>
            }
            else
            {
                <span class="card-badge count">@ViewBag.ContactRequestCount 条</span>
            }
        </a>

        <a href="/Admin/About" class="card-item">
            <span class="card-icon">📝</span>
            <div class="card-title">关于我编辑</div>
            <div class="card-desc">编辑个人简介、学习路线</div>
            <span class="card-badge count">✏️ 可编辑</span>
        </a>

        <a href="/Admin/PendingChanges" class="card-item">
            <span class="card-icon">📋</span>
            <div class="card-title">待审核更改</div>
            <div class="card-desc">审核用户头像、昵称、邮箱</div>
            @if (ViewBag.PendingChangesCount > 0)
            {
                <span class="card-badge pending">@ViewBag.PendingChangesCount 项</span>
            }
            else
            {
                <span class="card-badge count">0 项</span>
            }
        </a>

        <a href="/Admin/ResourceManagement" class="card-item">
            <span class="card-icon">📦</span>
            <div class="card-title">资源管理</div>
            <div class="card-desc">处理资源申请、确认付款</div>
            @if (ViewBag.ResourcePendingCount > 0)
            {
                <span class="card-badge pending">@ViewBag.ResourcePendingCount 待处理</span>
            }
            else
            {
                <span class="card-badge count">@ViewBag.ResourceTotalCount 条</span>
            }
        </a>

        <a href="/Admin/QuestionBank" class="card-item">
            <span class="card-icon">📚</span>
            <div class="card-title">题库管理</div>
            <div class="card-desc">管理每日一问题库</div>
            <span class="card-badge count">@(ViewBag.QuestionCount ?? 0) 题</span>
        </a>

        <a href="/Admin/QuestionSchedule" class="card-item">
            <span class="card-icon">📅</span>
            <div class="card-title">题目安排</div>
            <div class="card-desc">查看未来7天题目安排</div>
            <span class="card-badge count">🗓️ 智能排期</span>
        </a>
    </div>

    <!-- ===== 最近动态 ===== -->
    <div class="activity-section">
        <div class="section-title">📋 最近动态</div>
        @{
            var hasActivity = false;
        }

        @if (ViewBag.RecentMessages != null && ((List<MyPersonalWebsite.Models.Message>)ViewBag.RecentMessages).Any())
        {
            hasActivity = true;
            foreach (var msg in (List<MyPersonalWebsite.Models.Message>)ViewBag.RecentMessages)
            {
                <div class="activity-item">
                    <span class="dot green"></span>
                    <span class="act-text">
                        <strong>@msg.VisitorName</strong> 发布了新留言
                        <span style="color:rgba(255,255,255,0.3);font-size:0.85rem;">“@(msg.Content.Length > 30 ? msg.Content.Substring(0,30) + "..." : msg.Content)”</span>
                    </span>
                    <span class="act-time">@msg.CreateTime.ToString("MM-dd HH:mm")</span>
                </div>
            }
        }

        @if (ViewBag.RecentContactRequests != null && ((List<MyPersonalWebsite.Models.ContactRequest>)ViewBag.RecentContactRequests).Any())
        {
            hasActivity = true;
            foreach (var req in (List<MyPersonalWebsite.Models.ContactRequest>)ViewBag.RecentContactRequests)
            {
                <div class="activity-item">
                    <span class="dot orange"></span>
                    <span class="act-text">
                        <strong>@req.Identity</strong> 申请了 <strong>@(req.Platform == "WeChat" ? "微信" : "QQ")</strong> 授权码
                        <span style="color:rgba(255,255,255,0.3);font-size:0.85rem;">@req.AuthorizationCode</span>
                    </span>
                    <span class="act-time">@req.RequestTime.ToString("MM-dd HH:mm")</span>
                </div>
            }
        }

        @if (!hasActivity)
        {
            <div class="empty-state">暂无最近动态</div>
        }
    </div>

</div>

<script>
    // ============================================================
    // 导出统计 CSV
    // ============================================================
    function exportStats() {
        var data = [];
        document.querySelectorAll('.stat-grid').forEach(function(grid) {
            grid.querySelectorAll('.stat-item').forEach(function(item) {
                var label = item.querySelector('.label')?.textContent?.trim() || '';
                var value = item.querySelector('.value')?.textContent?.trim() || '';
                if (label && value) {
                    data.push({ label: label, value: value });
                }
            });
        });

        // 添加头部信息
        var csv = '统计项,数值\n';
        csv += '"导出时间","' + new Date().toLocaleString('zh-CN') + '"\n';
        data.forEach(function(item) {
            csv += '"' + item.label + '","' + item.value + '"\n';
        });

        var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'dashboard_stats_' + new Date().toISOString().slice(0,10) + '.csv';
        link.click();
    }

// 折叠/展开详细统计
function toggleDetails() {
    var el = document.getElementById('detailsContent');
    var btn = document.getElementById('toggleDetails');
    if (!el) return;
    if (el.style.display === 'none') {
        el.style.display = 'block';
        if (btn) btn.innerText = '隐藏详情';
    } else {
        el.style.display = 'none';
        if (btn) btn.innerText = '展开详情';
    }
}

// 页面加载时保持默认显示状态
document.addEventListener('DOMContentLoaded', function() {
    var el = document.getElementById('detailsContent');
    if (el) el.style.display = 'block';
});
</script>
