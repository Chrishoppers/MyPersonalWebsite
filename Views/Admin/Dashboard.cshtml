<!-- ===== SignalR 在线用户脚本 ===== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    (function() {
        var userId = @(Context.Session.GetInt32("UserId") ?? 0);
        var isAdmin = @(Context.Session.GetInt32("IsAdmin") ?? 0);
        if (!userId || isAdmin !== 1) return;

        var allUsers = [];

        // 获取所有用户信息
        function fetchUsersInfo() {
            return fetch('/Admin/GetAllUsersBrief')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        allUsers = data.users || [];
                    }
                    return allUsers;
                })
                .catch(function() {
                    return [];
                });
        }

        // 更新在线用户列表
        window._updateOnlineList = function(onlineUserIds) {
            var container = document.getElementById('onlineUsersList');
            var badge = document.getElementById('onlineUsersBadge');
            var countEl = document.getElementById('onlineUsersCount');

            if (!container) return;

            // 如果还没加载用户数据，先加载
            if (allUsers.length === 0) {
                container.innerHTML = '<span class="online-empty">加载中...</span>';
                return;
            }

            var onlineUsers = allUsers.filter(function(u) {
                return onlineUserIds && onlineUserIds.indexOf(u.id) !== -1;
            });

            var count = onlineUsers.length;

            if (badge) badge.textContent = count;
            if (countEl) countEl.textContent = count;

            if (count === 0) {
                container.innerHTML = '<span class="online-empty">暂无用户在线</span>';
                return;
            }

            var html = '';
            onlineUsers.forEach(function(u) {
                var avatarHtml = '';
                if (u.avatarUrl && u.isAvatarApproved) {
                    avatarHtml = '<img src="' + u.avatarUrl + '" class="avatar" />';
                } else {
                    avatarHtml = '<div class="avatar-placeholder">' + (u.username ? u.username.charAt(0).toUpperCase() : '?') + '</div>';
                }
                html += '<div class="online-user-item">';
                html += '<span class="status-dot"></span>';
                html += avatarHtml;
                html += '<span class="name">' + u.username + '</span>';
                if (u.isAdmin) {
                    html += '<span class="admin-tag">👑</span>';
                }
                html += '</div>';
            });
            container.innerHTML = html;
        };

        // 初始化：获取用户列表并连接 SignalR
        fetchUsersInfo().then(function() {
            try {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/messageHub')
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.start()
                    .then(function() {
                        connection.invoke('UserOnline', userId);
                    })
                    .catch(function(err) { console.error('SignalR 连接失败:', err); });

                connection.on('OnlineUsersUpdated', function(onlineUserIds) {
                    window._updateOnlineList(onlineUserIds);
                });

                // 页面关闭时断开连接
                window.addEventListener('beforeunload', function() {
                    connection.stop();
                });

                // 先显示空状态
                window._updateOnlineList([]);

                // 延迟一下再拉取真实数据（等连接建立后）
                setTimeout(function() {
                    // 尝试手动拉取
                    fetch('/Admin/GetOnlineUsers')
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            if (data.success) {
                                window._updateOnlineList(data.onlineUsers || []);
                            }
                        })
                        .catch(function() {});
                }, 2000);

            } catch (e) {
                console.log('SignalR 不可用');
                document.getElementById('onlineUsersList').innerHTML = '<span class="online-empty">实时功能不可用</span>';
            }
        }).catch(function() {
            document.getElementById('onlineUsersList').innerHTML = '<span class="online-empty">加载失败</span>';
        });
    })();

</script>
