@model MyPersonalWebsite.Models.ResourceRequest
@{
    ViewData["Title"] = "🔍 处理资源申请";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
    var adminName = ViewBag.AdminName as string ?? "管理员";
}

<style>
    .process-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .process-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .process-header h1 {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        margin: 0;
    }

    .btn-back {
        padding: 0.4rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .card-title {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255,255,255,0.08);
        margin-bottom: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-title .badge-status {
        font-size: 0.55rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
    }

    .badge-pending { background: rgba(255,193,7,0.08); color: #ffc107; border: 1px solid rgba(255,193,7,0.04); }
    .badge-processing { background: rgba(79,172,254,0.08); color: #4facfe; border: 1px solid rgba(79,172,254,0.04); }
    .badge-completed { background: rgba(40,167,69,0.08); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }
    .badge-rejected { background: rgba(220,53,69,0.08); color: #dc3545; border: 1px solid rgba(220,53,69,0.04); }
    .badge-refunded { background: rgba(245,158,11,0.08); color: #F59E0B; border: 1px solid rgba(245,158,11,0.04); }

    .detail-row {
        display: flex;
        padding: 0.4rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.02);
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-row .label {
        min-width: 120px;
        color: rgba(255,255,255,0.15);
        font-size: 0.75rem;
        font-weight: 500;
        flex-shrink: 0;
    }

    .detail-row .value {
        color: rgba(255,255,255,0.5);
        font-size: 0.85rem;
        word-break: break-all;
    }

    .detail-row .value strong { color: #fff; }
    .detail-row .value .highlight { color: #8B5CF6; font-weight: 600; }
    .detail-row .value .highlight-pink { color: #EC4899; font-weight: 600; }

    .verify-status-box {
        padding: 0.5rem 1rem;
        border-radius: 10px;
        margin-top: 0.2rem;
        font-size: 0.8rem;
    }

    .verify-status-box.auto { background: rgba(40,167,69,0.06); border: 1px solid rgba(40,167,69,0.04); color: #28a745; }
    .verify-status-box.manual { background: rgba(255,107,107,0.06); border: 1px solid rgba(255,107,107,0.04); color: #ff6b6b; }
    .verify-status-box.pending { background: rgba(255,193,7,0.06); border: 1px solid rgba(255,193,7,0.04); color: #ffc107; }
    .verify-status-box.rejected { background: rgba(220,53,69,0.06); border: 1px solid rgba(220,53,69,0.04); color: #dc3545; }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-group label {
        display: block;
        color: rgba(255,255,255,0.3);
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: 0.2rem;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 0.85rem;
        outline: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: rgba(139,92,246,0.15);
        background: rgba(255,255,255,0.04);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 60px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    /* ⭐ 文件上传区域 - 支持多文件和文件夹 */
    .file-upload-area {
        border: 2px dashed rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: rgba(255,255,255,0.01);
    }

    .file-upload-area:hover {
        border-color: rgba(139,92,246,0.1);
        background: rgba(139,92,246,0.02);
    }

    .file-upload-area .icon { font-size: 2.5rem; display: block; margin-bottom: 0.3rem; opacity: 0.3; }
    .file-upload-area .text { color: rgba(255,255,255,0.15); font-size: 0.9rem; font-weight: 500; }
    .file-upload-area .hint { color: rgba(255,255,255,0.06); font-size: 0.7rem; margin-top: 0.2rem; }

    /* ⭐ 文件列表 */
    .file-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.8rem;
        max-height: 200px;
        overflow-y: auto;
        padding: 0.2rem 0.2rem;
    }

    .file-list::-webkit-scrollbar { width: 3px; }
    .file-list::-webkit-scrollbar-thumb { background: rgba(139,92,246,0.1); border-radius: 10px; }

    .file-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.15rem 0.6rem 0.15rem 0.8rem;
        border-radius: 30px;
        background: rgba(40,167,69,0.04);
        border: 1px solid rgba(40,167,69,0.04);
        color: rgba(40,167,69,0.4);
        font-size: 0.6rem;
        animation: fileTagIn 0.3s ease;
        max-width: 200px;
    }

    .file-tag .file-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .file-tag .file-size {
        color: rgba(255,255,255,0.06);
        font-size: 0.5rem;
        flex-shrink: 0;
    }

    .file-tag .remove-file {
        background: none;
        border: none;
        color: rgba(220,53,69,0.2);
        cursor: pointer;
        font-size: 0.5rem;
        padding: 0.1rem 0.2rem;
        transition: color 0.3s ease;
    }

    .file-tag .remove-file:hover {
        color: #dc3545;
    }

    .file-count-badge {
        display: inline-block;
        padding: 0.1rem 0.8rem;
        border-radius: 20px;
        background: rgba(139,92,246,0.04);
        color: #8B5CF6;
        font-size: 0.6rem;
        border: 1px solid rgba(139,92,246,0.04);
    }

    @@keyframes fileTagIn {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }

    .btn-submit {
        padding: 0.7rem 2rem;
        border: none;
        border-radius: 40px;
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 40px rgba(108,60,225,0.2);
    }

    .btn-submit:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        transform: none;
    }

    .btn-cancel {
        padding: 0.7rem 2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.2);
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-cancel:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .actions {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .refund-info {
        padding: 0.5rem 1rem;
        border-radius: 12px;
        background: rgba(245,158,11,0.04);
        border: 1px solid rgba(245,158,11,0.04);
        color: rgba(245,158,11,0.3);
        font-size: 0.75rem;
        margin-top: 0.5rem;
    }

    .manual-verify-section {
        background: rgba(255,107,107,0.04);
        border: 1px solid rgba(255,107,107,0.06);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .manual-verify-section .section-label {
        color: #ff6b6b;
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .manual-verify-section .radio-group {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .manual-verify-section .radio-group label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: rgba(255,255,255,0.3);
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 400;
    }

    .manual-verify-section .radio-group input[type="radio"] {
        width: 16px;
        height: 16px;
        accent-color: #8B5CF6;
        cursor: pointer;
    }

    .manual-verify-section .user-account-info {
        font-size: 0.65rem;
        color: rgba(255,255,255,0.08);
        margin-top: 0.3rem;
        padding: 0.3rem 0.6rem;
        background: rgba(255,255,255,0.02);
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.02);
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@media (max-width: 640px) {
        .form-row { grid-template-columns: 1fr; gap: 0.6rem; }
        .card { padding: 1rem; }
        .actions { flex-direction: column; }
        .btn-submit, .btn-cancel { width: 100%; text-align: center; }
        .detail-row { flex-direction: column; gap: 0.2rem; }
        .detail-row .label { min-width: auto; }
        .manual-verify-section .radio-group { flex-direction: column; gap: 0.3rem; }
        .file-tag { max-width: 140px; font-size: 0.5rem; }
    }
</style>

<div class="process-container">
    <div class="process-header">
        <h1>🔍 处理资源申请</h1>
        <a href="/Admin/ResourceManagement" class="btn-back">← 返回列表</a>
    </div>

    <!-- ===== 申请信息 ===== -->
    <div class="card">
        <div class="card-title">
            📋 申请信息
            <span class="badge-status @("badge-" + Model.Status)">
                @(Model.Status == "pending" ? "⏳ 待处理" :
                  Model.Status == "processing" ? "🔄 处理中" :
                  Model.Status == "completed" ? "✅ 已完成" :
                  Model.Status == "rejected" ? "❌ 已拒绝" :
                  Model.Status == "refunded" ? "💰 已退款" : "❓ 未知")
            </span>
        </div>

        <div class="detail-row">
            <span class="label">ID</span>
            <span class="value" style="color:rgba(255,255,255,0.1);font-family:'Courier New',monospace;">#@Model.Id</span>
        </div>
        <div class="detail-row">
            <span class="label">申请人</span>
            <span class="value"><strong>@Model.UserName</strong></span>
        </div>
        <div class="detail-row">
            <span class="label">邮箱</span>
            <span class="value">@Model.UserEmail</span>
        </div>
        <div class="detail-row">
            <span class="label">联系人</span>
            <span class="value"><strong>@Model.PersonName</strong></span>
        </div>
        <div class="detail-row">
            <span class="label">人物/CP</span>
            <span class="value"><strong style="color:#fff;">@Model.CharacterName</strong></span>
        </div>
        <div class="detail-row">
            <span class="label">平台</span>
            <span class="value">
                @if (!string.IsNullOrEmpty(Model.Platform1))
                {
                    <span>@Model.Platform1</span>
                    @if (!string.IsNullOrEmpty(Model.Platform2))
                    {
                        <span> + @Model.Platform2</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.PlatformOther))
                    {
                        <span style="color:rgba(255,255,255,0.2);font-size:0.75rem;">（@Model.PlatformOther）</span>
                    }
                }
                else
                {
                    <span style="color:rgba(255,255,255,0.2);">未选择</span>
                }
            </span>
        </div>
        <div class="detail-row">
            <span class="label">资源类型</span>
            <span class="value">@Model.ResourceType</span>
        </div>
        <div class="detail-row">
            <span class="label">人物设定</span>
            <span class="value"><span class="highlight">@Model.CharacterSetting</span></span>
        </div>
        <div class="detail-row">
            <span class="label">偏好设置</span>
            <span class="value">
                小说: <span class="highlight">@Model.NovelPreference</span>
                · 漫画: <span class="highlight">@Model.ComicPreference</span>
                · 图片: <span class="highlight">@Model.ImagePreference</span>
            </span>
        </div>

        <!-- ===== 验证信息 ===== -->
        @if (!string.IsNullOrEmpty(Model.VerifyPlatform) && !string.IsNullOrEmpty(Model.VerifyAccountId))
        {
            <div class="detail-row">
                <span class="label">🔍 验证信息</span>
                <span class="value">
                    <div>
                        <strong style="color:#fff;">@Model.VerifyPlatform</strong>
                        <span style="color:rgba(255,255,255,0.3);"> - </span>
                        <span style="color:rgba(255,255,255,0.5);">@Model.VerifyAccountId</span>
                    </div>
                    <div class="verify-status-box @(Model.VerifyStatus == "auto_verified" ? "auto" : Model.VerifyStatus == "manual_required" ? "manual" : Model.VerifyStatus == "rejected" ? "rejected" : "pending")">
                        @(Model.VerifyStatus == "auto_verified" ? "✅ 自动验证通过" :
                          Model.VerifyStatus == "manual_required" ? "⚠️ 待人工核验" :
                          Model.VerifyStatus == "rejected" ? "❌ 验证未通过" :
                          "⏳ 未验证")
                        @if (!string.IsNullOrEmpty(Model.FollowVerifyError))
                        {
                            <span style="font-weight:400;font-size:0.75rem;display:block;color:rgba(255,255,255,0.2);">@Model.FollowVerifyError</span>
                        }
                    </div>
                </span>
            </div>
        }

        <div class="detail-row">
            <span class="label">申请时间</span>
            <span class="value">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </div>

        @if (Model.ProcessedAt.HasValue)
        {
            <div class="detail-row">
                <span class="label">处理时间</span>
                <span class="value">@Model.ProcessedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.AdminNote))
        {
            <div class="detail-row">
                <span class="label">管理员备注</span>
                <span class="value" style="color:rgba(255,255,255,0.3);font-style:italic;">@Model.AdminNote</span>
            </div>
        }
    </div>

    <!-- ===== 处理表单 ===== -->
    <form method="post" enctype="multipart/form-data" id="processForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="card">
            <div class="card-title">📊 处理结果</div>

            <!-- ===== 状态 ===== -->
            <div class="form-row">
                <div class="form-group">
                    <label>状态 <span style="color:#dc3545;">*</span></label>
                    <select name="Status" required>
                        @{
                            var statusList = new[]
                            {
                                new { Value = "processing", Label = "🔄 处理中" },
                                new { Value = "completed", Label = "✅ 已完成" },
                                new { Value = "rejected", Label = "❌ 已拒绝" },
                                new { Value = "refunded", Label = "💰 已退款" }
                            };
                        }
                        @foreach (var status in statusList)
                        {
                            if (Model.Status == status.Value)
                            {
                                <option value="@status.Value" selected>@status.Label</option>
                            }
                            else
                            {
                                <option value="@status.Value">@status.Label</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- ===== ⭐ 人工核验 ===== -->
            @if (Model.VerifyStatus == "manual_required")
            {
                <div class="manual-verify-section">
                    <div class="section-label">🔍 人工核验</div>
                    <div class="radio-group">
                        <label>
                            <input type="radio" name="IsFollowVerified" value="true" />
                            ✅ 核验通过（已关注）
                        </label>
                        <label>
                            <input type="radio" name="IsFollowVerified" value="false" checked />
                            ❌ 核验未通过（未关注）
                        </label>
                    </div>
                    <div class="user-account-info">
                        📱 用户账号：<strong style="color:rgba(255,255,255,0.15);">@Model.VerifyPlatform</strong>
                        <span style="color:rgba(255,255,255,0.04);"> - </span>
                        <span style="color:rgba(255,255,255,0.15);">@Model.VerifyAccountId</span>
                    </div>
                    <div style="font-size:0.6rem;color:rgba(255,255,255,0.04);margin-top:0.2rem;">
                        💡 请前往对应平台确认用户是否关注了你的账号
                    </div>
                </div>
            }

            <!-- ===== 已找到/未找到类型 ===== -->
            <div class="form-row">
                <div class="form-group">
                    <label>✅ 已找到类型</label>
                    <input type="text" name="FoundTypes" value="@Model.FoundTypes" placeholder="如：图片、文档、视频" />
                </div>
                <div class="form-group">
                    <label>❌ 未找到类型</label>
                    <input type="text" name="NotFoundTypes" value="@Model.NotFoundTypes" placeholder="如：软件、音频" />
                </div>
            </div>

            <!-- ===== ⭐ 文件上传（支持多文件和文件夹） ===== -->
            <div class="form-group">
                <label>📎 上传资源文件 <span class="file-count-badge" id="fileCountBadge">已选 0 个</span></label>
                <div class="file-upload-area" onclick="document.getElementById('fileInput').click()">
                    <span class="icon">📤</span>
                    <div class="text">点击上传文件或文件夹</div>
                    <div class="hint">支持多选 · 最多200个文件 · 支持文件夹上传</div>
                </div>
                <input type="file" id="fileInput" name="resourceFiles" multiple webkitdirectory style="display:none;" />
                <div class="file-list" id="fileList"></div>
            </div>

            <!-- ===== 管理员备注 ===== -->
            <div class="form-group">
                <label>📝 管理员备注</label>
                <textarea name="AdminNote" placeholder="填写处理备注...">@Model.AdminNote</textarea>
            </div>

            <!-- ===== 退款提示 ===== -->
            @if (Model.RefundOption == "1day_paid" && Model.Status != "refunded")
            {
                <div class="refund-info">
                    💰 用户选择了 "1天内超时退款" (¥2)，如果超时请标记为"已退款"
                </div>
            }

            <!-- ===== 操作按钮 ===== -->
            <div class="actions">
                <button type="submit" class="btn-submit">💾 保存并发送邮件</button>
                <a href="/Admin/ResourceManagement" class="btn-cancel">取消</a>
            </div>
        </div>
    </form>
</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

<script>
    // ============================================================
    // ⭐ 多文件选择和管理
    // ============================================================
    var selectedFiles = [];

    document.getElementById('fileInput').addEventListener('change', function(e) {
        var files = this.files;
        if (!files || files.length === 0) return;

        // 限制最多200个文件
        var maxFiles = 200;
        var filesToAdd = [];
        for (var i = 0; i < Math.min(files.length, maxFiles); i++) {
            filesToAdd.push(files[i]);
        }

        if (files.length > maxFiles) {
            showToast('⚠️ 最多只能上传 ' + maxFiles + ' 个文件，已自动截取前 ' + maxFiles + ' 个', 'warning');
        }

        // 添加到列表
        filesToAdd.forEach(function(file) {
            // 检查是否已存在（按文件名+大小判断）
            var exists = selectedFiles.some(function(f) {
                return f.name === file.name && f.size === file.size;
            });
            if (!exists) {
                selectedFiles.push(file);
            }
        });

        updateFileList();
        this.value = ''; // 重置input，允许再次选择相同文件
    });

    function updateFileList() {
        var container = document.getElementById('fileList');
        var badge = document.getElementById('fileCountBadge');
        
        container.innerHTML = '';
        badge.textContent = '已选 ' + selectedFiles.length + ' 个';

        selectedFiles.forEach(function(file, index) {
            var sizeText = (file.size / 1024).toFixed(1) + ' KB';
            if (file.size > 1024 * 1024) {
                sizeText = (file.size / 1024 / 1024).toFixed(1) + ' MB';
            }

            var tag = document.createElement('span');
            tag.className = 'file-tag';
            tag.innerHTML = `
                <span class="file-name">📎 ${file.name}</span>
                <span class="file-size">${sizeText}</span>
                <button class="remove-file" onclick="removeFile(${index})">✕</button>
            `;
            container.appendChild(tag);
        });
    }

    function removeFile(index) {
        selectedFiles.splice(index, 1);
        updateFileList();
    }

    // ============================================================
    // 表单提交
    // ============================================================
    document.getElementById('processForm').addEventListener('submit', function(e) {
        // 把 selectedFiles 添加到 FormData
        var formData = new FormData(this);

        // 清空原有的文件字段
        formData.delete('resourceFiles');

        // 添加所有选中的文件
        selectedFiles.forEach(function(file) {
            formData.append('resourceFiles', file, file.name);
        });

        // 用 fetch 提交
        e.preventDefault();

        var btn = document.querySelector('.btn-submit');
        btn.disabled = true;
        btn.textContent = '⏳ 发送中...';

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch(this.action, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': token
            },
            body: formData
        })
        .then(function(r) {
            if (r.redirected) {
                window.location.href = r.url;
                return;
            }
            return r.json();
        })
        .then(function(data) {
            if (data && data.success) {
                showToast(data.message || '✅ 处理成功', 'success');
                setTimeout(function() {
                    window.location.href = '/Admin/ResourceManagement';
                }, 1500);
            } else if (data && !data.success) {
                showToast(data.message || '处理失败', 'error');
                btn.disabled = false;
                btn.textContent = '💾 保存并发送邮件';
            }
        })
        .catch(function() {
            showToast('网络错误，请重试', 'error');
            btn.disabled = false;
            btn.textContent = '💾 保存并发送邮件';
        });
    });

    // ============================================================
    // Toast
    // ============================================================
    function showToast(message, type) {
        type = type || 'info';
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + type;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3500);
    }
</script>
