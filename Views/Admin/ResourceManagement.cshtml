    {
        <div class="empty-state">暂无已处理的申请</div>
    }
</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

<script>
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function showToast(message, type) {
        type = type || 'info';
        var container = document.getElementById('toastContainer');
        var toast = document.createElement('div');
        toast.className = 'toast-msg ' + type;
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(20px)';
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }
// ============================================================
// 确认收款
// ============================================================
function confirmPayment(requestId) {
    if (!confirm('确认已收到该订单的付款吗？')) return;

    var note = prompt('请输入备注（可选）：', '');
    if (note === null) return;

    fetch('/Admin/ConfirmPayment', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token
        },
        body: 'requestId=' + requestId + '&note=' + encodeURIComponent(note)
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            showToast(data.message, 'success');
            setTimeout(function() { location.reload(); }, 800);
        } else {
            showToast(data.message || '操作失败', 'error');
        }
    })
    .catch(function() {
        showToast('操作失败，请重试', 'error');
    });
}
    // ============================================================
    // 人工核验
    // ============================================================
    function manualVerify(requestId, approved) {
        var action = approved ? '通过' : '拒绝';
        if (!confirm('确定要' + action + '该用户的人工核验吗？')) return;

        fetch('/Admin/ManualVerifyFollow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'requestId=' + requestId + '&approved=' + approved
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                showToast(data.message, 'success');
                setTimeout(function() { location.reload(); }, 800);
            } else {
                showToast(data.message || '操作失败', 'error');
            }
        })
        .catch(function() {
            showToast('操作失败，请重试', 'error');
        });
    }

    // ============================================================
    // 删除
    // ============================================================
    function deleteRequest(id) {
        if (!confirm('确定要删除这条申请吗？此操作不可恢复！')) return;

        fetch('/Admin/DeleteResourceRequest', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var item = document.getElementById('request-' + id);
                if (item) item.remove();
                showToast('✅ 已删除', 'success');
                setTimeout(function() { location.reload(); }, 600);
            } else {
                showToast('❌ ' + data.message, 'error');
            }
        })
        .catch(function() {
            showToast('❌ 操作失败，请重试', 'error');
        });
    }
</script>
