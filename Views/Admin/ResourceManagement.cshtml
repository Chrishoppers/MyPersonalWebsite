@{
    ViewData["Title"] = "📦 资源管理";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }

    var pendingRequests = ViewBag.PendingRequests as List<MyPersonalWebsite.Models.ResourceRequest> ?? new List<MyPersonalWebsite.Models.ResourceRequest>();
    var processedRequests = ViewBag.ProcessedRequests as List<MyPersonalWebsite.Models.ResourceRequest> ?? new List<MyPersonalWebsite.Models.ResourceRequest>();
    var pendingCount = ViewBag.PendingCount ?? 0;
    var processedCount = ViewBag.ProcessedCount ?? 0;
    var totalCount = ViewBag.TotalCount ?? 0;
}

<style>
    .admin-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    .btn-glass {
        padding: 0.4rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }

    .btn-glass:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        text-align: center;
    }

    .stat-card .num {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-card .label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.3);
        margin-top: 0.1rem;
    }

    .stat-card.pending .num { color: #ffc107; }
    .stat-card.processed .num { color: #28a745; }
    .stat-card.total .num { color: #4facfe; }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 1.2rem 0 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title .count {
        font-size: 0.65rem;
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
    }

    .request-item {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .request-item:hover {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.06);
    }

    .request-item .info .id {
        color: rgba(255,255,255,0.1);
        font-size: 0.6rem;
        font-family: 'Courier New', monospace;
    }

    .request-item .info .name {
        font-weight: 600;
        color: #fff;
        font-size: 0.9rem;
    }

    .request-item .info .meta {
        color: rgba(255,255,255,0.15);
        font-size: 0.65rem;
        margin-top: 0.05rem;
    }

    .request-item .info .meta span {
        margin-right: 0.6rem;
    }

    .btn-process {
        padding: 0.2rem 1rem;
        border: 1px solid rgba(139,92,246,0.06);
        border-radius: 30px;
        background: rgba(139,92,246,0.04);
        color: #8B5CF6;
        text-decoration: none;
        font-size: 0.7rem;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-process:hover {
        background: rgba(139,92,246,0.08);
    }

    .btn-delete {
        padding: 0.2rem 0.8rem;
        border: 1px solid rgba(220,53,69,0.04);
        border-radius: 30px;
        background: rgba(220,53,69,0.02);
        color: rgba(220,53,69,0.2);
        text-decoration: none;
        font-size: 0.65rem;
        transition: all 0.3s ease;
        cursor: pointer;
        border: none;
        font-family: inherit;
    }

    .btn-delete:hover {
        background: rgba(220,53,69,0.04);
        color: #dc3545;
    }

    .status-badge-sm {
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        font-size: 0.55rem;
        font-weight: 600;
    }

    .status-pending { background: rgba(255,193,7,0.06); color: #ffc107; border: 1px solid rgba(255,193,7,0.04); }
    .status-processing { background: rgba(79,172,254,0.06); color: #4facfe; border: 1px solid rgba(79,172,254,0.04); }
    .status-completed { background: rgba(40,167,69,0.06); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }
    .status-rejected { background: rgba(220,53,69,0.06); color: #dc3545; border: 1px solid rgba(220,53,69,0.04); }
    .status-refunded { background: rgba(245,158,11,0.06); color: #F59E0B; border: 1px solid rgba(245,158,11,0.04); }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: rgba(255,255,255,0.06);
        font-size: 0.85rem;
    }

    .processed-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .processed-list::-webkit-scrollbar { width: 3px; }
    .processed-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.04); border-radius: 10px; }

    @@media (max-width: 640px) {
        .request-item { flex-direction: column; align-items: stretch; }
        .request-item .right { display: flex; justify-content: space-between; align-items: center; }
        .stats-row { grid-template-columns: repeat(3, 1fr); }
    }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1>📦 资源管理</h1>
        <a href="/Admin/Dashboard" class="btn-glass">← 返回后台</a>
    </div>

    <!-- 统计 -->
    <div class="stats-row">
        <div class="stat-card pending">
            <div class="num">@pendingCount</div>
            <div class="label">⏳ 待处理</div>
        </div>
        <div class="stat-card processed">
            <div class="num">@processedCount</div>
            <div class="label">✅ 已处理</div>
        </div>
        <div class="stat-card total">
            <div class="num">@totalCount</div>
            <div class="label">📊 总计</div>
        </div>
    </div>

    <!-- 待处理列表 -->
    <div class="section-title">
        ⏳ 待处理申请
        <span class="count">@pendingCount 条</span>
    </div>

    @if (pendingRequests.Any())
    {
        foreach (var item in pendingRequests)
        {
            <div class="request-item" id="request-@item.Id">
                <div class="info">
                    <div class="id">#@item.Id</div>
                    <div class="name">@item.ResourceName</div>
                    <div class="meta">
                        <span>👤 @item.PersonName</span>
                        <span>📱 @item.Platform</span>
                        <span>⏰ @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        <span class="status-badge-sm @("status-" + item.Status)">
                            @(item.Status == "pending" ? "⏳ 待处理" : "🔄 处理中")
                        </span>
                    </div>
                </div>
                <div class="right" style="display:flex;align-items:center;gap:0.5rem;">
                    <a href="/Admin/ProcessResource/@item.Id" class="btn-process">🔍 处理</a>
                    <button class="btn-delete" onclick="deleteRequest(@item.Id)">🗑️</button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">✅ 暂无待处理的申请</div>
    }

    <!-- 已处理列表 -->
    <div class="section-title" style="margin-top:1.5rem;">
        ✅ 已处理申请
        <span class="count">@processedCount 条</span>
    </div>

    @if (processedRequests.Any())
    {
        <div class="processed-list">
            @foreach (var item in processedRequests)
            {
                <div class="request-item" style="opacity:0.6;">
                    <div class="info">
                        <div class="id">#@item.Id</div>
                        <div class="name">@item.ResourceName</div>
                        <div class="meta">
                            <span>👤 @item.PersonName</span>
                            <span>📱 @item.Platform</span>
                            <span>⏰ @item.CreatedAt.ToString("yyyy-MM-dd")</span>
                            <span class="status-badge-sm @("status-" + item.Status)">
                                @(item.Status == "completed" ? "✅ 已完成" :
                                  item.Status == "rejected" ? "❌ 已拒绝" :
                                  item.Status == "refunded" ? "💰 已退款" : item.Status)
                            </span>
                            @if (item.ProcessedAt.HasValue)
                            {
                                <span style="color:rgba(255,255,255,0.04);">处理: @item.ProcessedAt.Value.ToString("MM-dd HH:mm")</span>
                            }
                        </div>
                    </div>
                    <div class="right">
                        <a href="/Admin/ProcessResource/@item.Id" class="btn-process" style="font-size:0.6rem;">👁️ 查看</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">暂无已处理的申请</div>
    }
</div>

<script>
    function deleteRequest(id) {
        if (!confirm('确定要删除这条申请吗？此操作不可恢复！')) return;

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        fetch('/Admin/DeleteResourceRequest', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: 'id=' + id
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var item = document.getElementById('request-' + id);
                if (item) item.remove();
                alert('✅ 已删除');
                location.reload();
            } else {
                alert('❌ ' + data.message);
            }
        })
        .catch(function() {
            alert('❌ 操作失败，请重试');
        });
    }
</script>
