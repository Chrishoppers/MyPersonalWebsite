@{
    ViewData["Title"] = "📦 资源管理";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }

    var pendingRequests = ViewBag.PendingRequests as List<MyPersonalWebsite.Models.ResourceRequest> ?? new List<MyPersonalWebsite.Models.ResourceRequest>();
    var manualVerifyRequests = ViewBag.ManualVerifyRequests as List<MyPersonalWebsite.Models.ResourceRequest> ?? new List<MyPersonalWebsite.Models.ResourceRequest>();
    var processedRequests = ViewBag.ProcessedRequests as List<MyPersonalWebsite.Models.ResourceRequest> ?? new List<MyPersonalWebsite.Models.ResourceRequest>();
    var pendingCount = ViewBag.PendingCount ?? 0;
    var manualVerifyCount = ViewBag.ManualVerifyCount ?? 0;
    var processedCount = ViewBag.ProcessedCount ?? 0;
    var totalCount = ViewBag.TotalCount ?? 0;
}

<style>
    .admin-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.2rem;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    .btn-glass {
        padding: 0.4rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 40px;
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.3);
        text-decoration: none;
        font-size: 0.8rem;
        transition: all 0.3s ease;
    }

    .btn-glass:hover {
        background: rgba(255,255,255,0.04);
        color: #fff;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        text-align: center;
    }

    .stat-card .num {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-card .label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.3);
        margin-top: 0.1rem;
    }

    .stat-card.pending .num { color: #ffc107; }
    .stat-card.manual .num { color: #ff6b6b; }
    .stat-card.processed .num { color: #28a745; }
    .stat-card.total .num { color: #4facfe; }

    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin: 1.2rem 0 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title .count {
        font-size: 0.65rem;
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
    }

    .request-item {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .request-item:hover {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.06);
    }

    .request-item .info .id {
        color: rgba(255,255,255,0.1);
        font-size: 0.65rem;
        font-family: 'Courier New', monospace;
    }

    .request-item .info .name {
        font-weight: 600;
        color: #fff;
        font-size: 0.9rem;
    }

    .request-item .info .meta {
        color: rgba(255,255,255,0.2);
        font-size: 0.7rem;
        margin-top: 0.1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 0.8rem;
    }

    .request-item .info .meta .verify-badge {
        font-size: 0.55rem;
        padding: 0.05rem 0.5rem;
        border-radius: 20px;
        font-weight: 600;
    }

    .verify-auto { background: rgba(40,167,69,0.08); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }
    .verify-manual { background: rgba(255,107,107,0.08); color: #ff6b6b; border: 1px solid rgba(255,107,107,0.04); animation: pulse-warning 1.5s ease-in-out infinite; }
    .verify-pending { background: rgba(255,193,7,0.06); color: #ffc107; border: 1px solid rgba(255,193,7,0.04); }
    .verify-rejected { background: rgba(220,53,69,0.06); color: #dc3545; border: 1px solid rgba(220,53,69,0.04); }

    @@keyframes pulse-warning {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .btn-process {
        padding: 0.2rem 1rem;
        border: 1px solid rgba(139,92,246,0.06);
        border-radius: 30px;
        background: rgba(139,92,246,0.04);
        color: #8B5CF6;
        text-decoration: none;
        font-size: 0.7rem;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .btn-process:hover {
        background: rgba(139,92,246,0.08);
    }

    .btn-delete {
        padding: 0.2rem 0.8rem;
        border: 1px solid rgba(220,53,69,0.04);
        border-radius: 30px;
        background: rgba(220,53,69,0.02);
        color: rgba(220,53,69,0.2);
        text-decoration: none;
        font-size: 0.65rem;
        transition: all 0.3s ease;
        cursor: pointer;
        border: none;
        font-family: inherit;
    }

    .btn-delete:hover {
        background: rgba(220,53,69,0.04);
        color: #dc3545;
    }

    .btn-manual-verify {
        padding: 0.2rem 0.8rem;
        border: none;
        border-radius: 20px;
        font-size: 0.6rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .btn-manual-verify.approve {
        background: rgba(40,167,69,0.08);
        color: #28a745;
    }

    .btn-manual-verify.approve:hover {
        background: rgba(40,167,69,0.15);
    }

    .btn-manual-verify.reject {
        background: rgba(220,53,69,0.08);
        color: #dc3545;
    }

    .btn-manual-verify.reject:hover {
        background: rgba(220,53,69,0.15);
    }

    .status-badge-sm {
        padding: 0.05rem 0.6rem;
        border-radius: 20px;
        font-size: 0.55rem;
        font-weight: 600;
    }

    .status-pending { background: rgba(255,193,7,0.06); color: #ffc107; border: 1px solid rgba(255,193,7,0.04); }
    .status-processing { background: rgba(79,172,254,0.06); color: #4facfe; border: 1px solid rgba(79,172,254,0.04); }
    .status-completed { background: rgba(40,167,69,0.06); color: #28a745; border: 1px solid rgba(40,167,69,0.04); }
    .status-rejected { background: rgba(220,53,69,0.06); color: #dc3545; border: 1px solid rgba(220,53,69,0.04); }
    .status-refunded { background: rgba(245,158,11,0.06); color: #F59E0B; border: 1px solid rgba(245,158,11,0.04); }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: rgba(255,255,255,0.06);
        font-size: 0.85rem;
    }

    .processed-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .processed-list::-webkit-scrollbar { width: 3px; }
    .processed-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.04); border-radius: 10px; }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@media (max-width: 640px) {
        .request-item { flex-direction: column; align-items: stretch; }
        .request-item .right { display: flex; justify-content: space-between; align-items: center; }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="admin-container">
    <div class="admin-header">
        <h1>📦 资源管理</h1>
        <a href="/Admin/Dashboard" class="btn-glass">← 返回后台</a>
    </div>

    <!-- 统计 -->
    <div class="stats-row">
        <div class="stat-card pending">
            <div class="num">@pendingCount</div>
            <div class="label">⏳ 待处理</div>
        </div>
        <div class="stat-card manual">
            <div class="num">@manualVerifyCount</div>
            <div class="label">🔍 待人工核验</div>
        </div>
        <div class="stat-card processed">
            <div class="num">@processedCount</div>
            <div class="label">✅ 已处理</div>
        </div>
        <div class="stat-card total">
            <div class="num">@totalCount</div>
            <div class="label">📊 总计</div>
        </div>
<div class="stat-card pending" style="border-left: 3px solid #F59E0B;">
    <div class="num">@ViewBag.PendingPaymentCount</div>
    <div class="label">⏳ 待付款</div>
</div>
    </div>

    <!-- ⭐ 待人工核验列表 -->
    @if (manualVerifyRequests.Any())
    {
        <div class="section-title">
            🔍 待人工核验
            <span class="count">@manualVerifyCount 条</span>
            <span style="font-size:0.55rem;color:#ff6b6b;font-weight:400;">⚠️ 需要管理员手动确认是否关注</span>
        </div>

        foreach (var item in manualVerifyRequests)
        {
            <div class="request-item" id="request-@item.Id" style="border-left:3px solid #ff6b6b;">
                <div class="info">
                    <div class="id">#@item.Id</div>
                    <div class="name">
                        @item.CharacterName
                        <span style="font-size:0.65rem;color:rgba(255,255,255,0.1);margin-left:0.5rem;">@item.ResourceType</span>
                    </div>
                    <div class="meta">
                        <span>👤 @item.UserName</span>
                        <span>📱 @(string.IsNullOrEmpty(item.Platform1) ? "未选择" : item.Platform1 + (string.IsNullOrEmpty(item.Platform2) ? "" : " + " + item.Platform2))</span>
                        <span>🔍 @item.VerifyPlatform: @item.VerifyAccountId</span>
                        <span>⏰ @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        <span class="verify-badge verify-manual">⚠️ 待人工核验</span>
                    </div>
                </div>
                <div class="right" style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
                    <a href="/Admin/ProcessResource/@item.Id" class="btn-process">🔍 处理</a>
                    <button class="btn-manual-verify approve" onclick="manualVerify(@item.Id, true)">✅ 通过</button>
                    <button class="btn-manual-verify reject" onclick="manualVerify(@item.Id, false)">❌ 拒绝</button>
                    <button class="btn-delete" onclick="deleteRequest(@item.Id)">🗑️</button>
                </div>
            </div>
        }
    }

    <!-- 待处理列表 -->
    <div class="section-title" style="margin-top:@(manualVerifyRequests.Any() ? "1rem" : "0");">
        ⏳ 待处理申请
        <span class="count">@pendingCount 条</span>
    </div>

    @if (pendingRequests.Any())
    {
        foreach (var item in pendingRequests)
        {
            var isManual = item.VerifyStatus == "manual_required";
            <div class="request-item" id="request-@item.Id" style="@(isManual ? "border-left:3px solid #ff6b6b;" : "")">
                <div class="info">
                    <div class="id">#@item.Id</div>
                    <div class="name">
                        @item.CharacterName
                        <span style="font-size:0.65rem;color:rgba(255,255,255,0.1);margin-left:0.5rem;">@item.ResourceType</span>
                    </div>
                    <div class="meta">
                        <span>👤 @item.UserName</span>
                        <span>📱 @(string.IsNullOrEmpty(item.Platform1) ? "未选择" : item.Platform1 + (string.IsNullOrEmpty(item.Platform2) ? "" : " + " + item.Platform2))</span>
                        @if (!string.IsNullOrEmpty(item.VerifyPlatform))
                        {
                            <span>🔍 @item.VerifyPlatform: @item.VerifyAccountId</span>
                        }
                        <span>⏰ @item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        @if (isManual)
                        {
                            <span class="verify-badge verify-manual">⚠️ 待人工核验</span>
                        }
                        else if (item.VerifyStatus == "auto_verified")
                        {
                            <span class="verify-badge verify-auto">✅ 已验证</span>
                        }
                        else
                        {
                            <span class="verify-badge verify-pending">⏳ 未验证</span>
                        }
                        <span class="status-badge-sm @("status-" + item.Status)">
                            @(item.Status == "pending" ? "⏳ 待处理" : "🔄 处理中")
                        </span>
                    </div>
                </div>
                <div class="right" style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
                    <a href="/Admin/ProcessResource/@item.Id" class="btn-process">🔍 处理</a>
                    <button class="btn-delete" onclick="deleteRequest(@item.Id)">🗑️</button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">✅ 暂无待处理的申请</div>
    }
<!-- 在统计卡片中添加 -->
