                        <div class="meta">
                            <span>👤 @item.UserName</span>
                            <span>📱 @(string.IsNullOrEmpty(item.Platform1) ? "未选择" : item.Platform1 + (string.IsNullOrEmpty(item.Platform2) ? "" : " + " + item.Platform2))</span>
