@{
    ViewData["Title"] = "📅 未来题目安排";
    var schedule = ViewBag.Schedule as List<MyPersonalWebsite.Controllers.AdminController.DailyScheduleItem>;
    var bankQuestions = ViewBag.BankQuestions as List<MyPersonalWebsite.Models.BankQuestion>;
    var today = ViewBag.Today as DateTime? ?? DateTime.Today;
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }
}

<style>
    .schedule-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .schedule-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .schedule-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    .btn-glass {
        padding: 0.5rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-block;
    }

    .btn-glass:hover {
        background: rgba(255,255,255,0.08);
        color: #fff;
    }

    .btn-glass.primary {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        border: none;
        color: #fff;
    }

    .btn-glass.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .btn-glass.ai {
        background: linear-gradient(135deg, #10B981, #34D399);
        border: none;
        color: #fff;
    }

    .btn-glass.ai:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(16,185,129,0.2);
    }

    .schedule-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .schedule-card {
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
        padding: 1.2rem 1.5rem;
        transition: all 0.3s ease;
        position: relative;
    }

    .schedule-card:hover {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.08);
    }

    .schedule-card.today {
        border-color: rgba(139,92,246,0.2);
        background: rgba(139,92,246,0.04);
    }

    .schedule-card.past {
        opacity: 0.4;
    }

    .schedule-card .card-date {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .schedule-card .card-date .date-text {
        font-weight: 600;
        color: #fff;
        font-size: 1rem;
    }

    .schedule-card .card-date .badge {
        font-size: 0.6rem;
        padding: 0.1rem 0.6rem;
        border-radius: 20px;
        font-weight: 500;
    }

    .badge-today {
        background: rgba(139,92,246,0.15);
        color: #8B5CF6;
        border: 1px solid rgba(139,92,246,0.06);
    }

    .badge-past {
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .badge-future {
        background: rgba(79,172,254,0.1);
        color: #4facfe;
        border: 1px solid rgba(79,172,254,0.06);
    }

    .badge-empty {
        background: rgba(255,193,7,0.08);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.04);
    }

    .schedule-card .question-preview {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        margin: 0.3rem 0;
        min-height: 40px;
    }

    .schedule-card .question-preview .empty-text {
        color: rgba(255,255,255,0.15);
        font-style: italic;
    }

    .schedule-card .question-meta {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        font-size: 0.7rem;
        color: rgba(255,255,255,0.2);
        margin-top: 0.3rem;
    }

    .schedule-card .question-meta .tag {
        padding: 0.05rem 0.5rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .schedule-card .replace-area {
        margin-top: 0.8rem;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(255,255,255,0.04);
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .schedule-card .replace-area select {
        flex: 1;
        min-width: 150px;
        padding: 0.3rem 0.8rem;
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.03);
        color: #e0e0e0;
        font-size: 0.8rem;
        outline: none;
    }

    .schedule-card .replace-area select option {
        background: #1a1a2e;
        color: #e0e0e0;
    }

    .schedule-card .replace-area .btn-replace {
        padding: 0.25rem 1rem;
        border: none;
        border-radius: 30px;
        background: rgba(245,158,11,0.12);
        color: #F59E0B;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .schedule-card .replace-area .btn-replace:hover {
        background: rgba(245,158,11,0.2);
    }

    .schedule-card .replace-area .btn-replace:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.03);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        text-align: center;
    }

    .stat-card .number {
        font-size: 1.6rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-card .label {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.3);
        margin-top: 0.1rem;
    }

    .stat-card.total .number { color: #4facfe; }
    .stat-card.used .number { color: #28a745; }
    .stat-card.available .number { color: #ffc107; }

    @@media (max-width: 640px) {
        .schedule-grid { grid-template-columns: 1fr; }
        .schedule-header h1 { font-size: 1.3rem; }
        .schedule-card { padding: 1rem 1.2rem; }
    }
</style>

<div class="schedule-container">

    <div class="schedule-header">
        <h1>📅 未来题目安排</h1>
        <div>
            <a href="/Admin/Dashboard" class="btn-glass">← 返回后台</a>
            <a href="/Admin/QuestionBank" class="btn-glass primary" style="margin-left:0.5rem;">📚 题库管理</a>
            <button class="btn-glass ai" onclick="autoScheduleAll()" style="margin-left:0.5rem;">
                🤖 AI一键安排
            </button>
        </div>
    </div>

    <!-- 统计 -->
    <div class="stats-row">
        @{
            var total = ViewBag.BankQuestions?.Count ?? 0;
            var used = ViewBag.BankQuestions?.Count(q => q.UseCount > 0) ?? 0;
            var available = ViewBag.BankQuestions?.Count(q => q.UseCount == 0 && q.IsActive) ?? 0;
        }
        <div class="stat-card total">
            <div class="number">@total</div>
            <div class="label">📝 总题库</div>
        </div>
        <div class="stat-card used">
            <div class="number">@used</div>
            <div class="label">✅ 已使用</div>
        </div>
        <div class="stat-card available">
            <div class="number">@available</div>
            <div class="label">📦 未使用</div>
        </div>
    </div>

    <!-- 未来7天安排 -->
    <div class="schedule-grid">
        @if (schedule != null)
        {
            foreach (var item in schedule)
            {
                var isToday = item.Date.Date == today.Date;
                var isPast = item.Date.Date < today.Date;

                <div class="schedule-card @(isToday ? "today" : "") @(isPast ? "past" : "")">
                    <div class="card-date">
                        <span class="date-text">
                            @item.DateStr
                            @if (isToday) { <span style="color:#8B5CF6;font-size:0.8rem;">（今天）</span> }
                            @if (isPast) { <span style="color:rgba(255,255,255,0.2);font-size:0.8rem;">（已过）</span> }
                        </span>
                        <span>
                            @if (isToday)
                            {
                                <span class="badge badge-today">⭐ 今天</span>
                            }
                            else if (isPast)
                            {
                                <span class="badge badge-past">✅ 已过</span>
                        }
                            else
                            {
                                <span class="badge badge-future">📅 未来</span>
                            }
                        </span>
                    </div>

                    @if (item.IsScheduled)
                    {
                        <div class="question-preview">
                            <strong style="color:#fff;">@item.Question</strong>
                            <br />
                            <span style="color:#8B5CF6;font-size:0.85rem;">答案：@item.Answer</span>
                        </div>
                        <div class="question-meta">
                            <span class="tag">📂 @item.Category</span>
                            <span class="tag">⭐ @(new string('⭐', item.Difficulty))</span>
                            <span class="tag">🆔 #@item.QuestionId</span>
                        </div>
                    }
                    else
                    {
                        <div class="question-preview">
                            <span class="empty-text">📭 暂无安排</span>
                        </div>
                    }

                    <!-- 更换题目 -->
                    @if (!isPast)
                    {
                        <div class="replace-area">
                            <select id="newQuestion_@item.DateStr">
                                <option value="">-- 更换题目 --</option>
                                @if (bankQuestions != null)
                                {
                                    foreach (var q in bankQuestions)
                                    {
                                        if (!q.IsActive) continue;
                                        var isSelected = q.Id == item.QuestionId;
                                        var usedText = q.UseCount > 0 ? $"(已用{q.UseCount}次)" : "(未使用)";
                                        if (isSelected)
                                        {
                                            <option value="@q.Id" selected>@q.Question [@q.Category] @usedText</option>
                                        }
                                        else
                                        {
                                            <option value="@q.Id">@q.Question [@q.Category] @usedText</option>
                                        }
                                    }
                                }
                            </select>
                            <button class="btn-replace" onclick="replaceQuestion('@item.DateStr')">
                                🔄 更换
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>

</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function showToast(message, type) {
            type = type || 'info';
            var container = document.getElementById('toastContainer');
            var toast = document.createElement('div');
            toast.className = 'toast-msg ' + type;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(function() {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(function() { toast.remove(); }, 300);
            }, 3000);
        }
 // ============================================================
        // 更换题目
        // ============================================================
        function replaceQuestion(date) {
            var select = document.getElementById('newQuestion_' + date);
            var newQuestionId = select.value;

            if (!newQuestionId) {
                showToast('请选择一道题目', 'error');
                return;
            }

            if (!confirm('确定要将 ' + date + ' 的题目更换为选中的题目吗？')) return;

            var btn = select.parentElement.querySelector('.btn-replace');
            btn.disabled = true;
            btn.textContent = '⏳ 处理中...';

            fetch('/Admin/ReplaceQuestion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: 'date=' + encodeURIComponent(date) + '&newQuestionId=' + newQuestionId
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showToast('✅ 题目已更换', 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    showToast(data.message || '更换失败', 'error');
                    btn.disabled = false;
                    btn.textContent = '🔄 更换';
                }
            })
            .catch(function() {
                showToast('网络错误，请重试', 'error');
                btn.disabled = false;
                btn.textContent = '🔄 更换';
            });
        }

        // ============================================================
        // 🤖 AI一键安排
        // ============================================================
        function autoScheduleAll() {
            if (!confirm('确定要清空未来7天的所有安排，并由AI自动重新安排吗？')) return;

            var btn = document.querySelector('.btn-glass.ai');
            btn.disabled = true;
            btn.textContent = '⏳ 安排中...';

            fetch('/Admin/AutoScheduleAll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showToast('✅ ' + data.message, 'success');
                    setTimeout(function() { location.reload(); }, 1000);
                } else {
                    showToast(data.message || '安排失败', 'error');
                    btn.disabled = false;
                    btn.textContent = '🤖 AI一键安排';
                }
            })
            .catch(function() {
                showToast('网络错误，请重试', 'error');
                btn.disabled = false;
                btn.textContent = '🤖 AI一键安排';
            });
        }
    </script>
}
