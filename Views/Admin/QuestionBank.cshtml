@model List<MyPersonalWebsite.Models.BankQuestion>

@{
    ViewData["Title"] = "题库管理";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1)
    {
        Context.Response.Redirect("/Auth/Login");
        return;
    }

    var total = Model.Count;
    var activeCount = Model.Count(q => q.IsActive);
}

<style>
    .admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .admin-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #8B5CF6 0%, #EC4899 50%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin: 0;
    }

    .btn-glass {
        padding: 0.5rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-block;
    }

    .btn-glass:hover {
        background: rgba(255,255,255,0.08);
        color: #fff;
    }

    .btn-glass.primary {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        border: none;
        color: #fff;
    }

    .btn-glass.primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .btn-glass.danger {
        background: rgba(220,53,69,0.08);
        border-color: rgba(220,53,69,0.08);
        color: #dc3545;
    }

    .btn-glass.danger:hover {
        background: rgba(220,53,69,0.15);
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.03);
        border-radius: 16px;
        padding: 1rem 1.2rem;
        border: 1px solid rgba(255,255,255,0.04);
        text-align: center;
    }

    .stat-card .number {
        font-size: 1.6rem;
        font-weight: 700;
        color: #fff;
    }

    .stat-card .label {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.4);
        margin-top: 0.2rem;
    }

    .stat-card.total .number { color: #4facfe; }
    .stat-card.active .number { color: #28a745; }
    .stat-card.inactive .number { color: #dc3545; }

    .filter-bar {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        padding: 1rem 1.5rem;
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
        align-items: center;
    }

    .filter-bar select,
    .filter-bar input {
        padding: 0.4rem 1rem;
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        color: #e0e0e0;
        font-size: 0.85rem;
        outline: none;
    }

    .filter-bar select:focus,
    .filter-bar input:focus {
        border-color: rgba(79,172,254,0.3);
    }

    .filter-bar select option {
        background: #1a1a2e;
        color: #e0e0e0;
    }

    .table-wrapper {
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        min-width: 1000px;
    }

    th {
        text-align: left;
        padding: 0.8rem 1rem;
        background: rgba(255,255,255,0.03);
        color: rgba(255,255,255,0.4);
        font-weight: 500;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        white-space: nowrap;
    }

    td {
        padding: 0.7rem 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        color: rgba(255,255,255,0.8);
        vertical-align: middle;
    }

    tr:hover td {
        background: rgba(255,255,255,0.02);
    }

    tr.disabled td {
        opacity: 0.4;
    }

    .badge {
        font-size: 0.65rem;
        padding: 0.15rem 0.7rem;
        border-radius: 20px;
        font-weight: 500;
        display: inline-block;
    }

    .badge-active {
        background: rgba(40,167,69,0.12);
        color: #28a745;
        border: 1px solid rgba(40,167,69,0.06);
    }

    .badge-inactive {
        background: rgba(220,53,69,0.12);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,0.06);
    }

    .badge-category {
        background: rgba(139,92,246,0.12);
        color: #8B5CF6;
        border: 1px solid rgba(139,92,246,0.06);
    }

    .btn-sm {
        padding: 0.2rem 0.7rem;
        border: none;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-sm.primary {
        background: rgba(79,172,254,0.12);
        color: #4facfe;
    }

    .btn-sm.primary:hover {
        background: rgba(79,172,254,0.2);
    }

    .btn-sm.success {
        background: rgba(40,167,69,0.12);
        color: #28a745;
    }

    .btn-sm.success:hover {
        background: rgba(40,167,69,0.2);
    }

    .btn-sm.danger {
        background: rgba(220,53,69,0.08);
        color: #dc3545;
    }

    .btn-sm.danger:hover {
        background: rgba(220,53,69,0.15);
    }

    .btn-sm.warning {
        background: rgba(255,193,7,0.12);
        color: #ffc107;
    }

    .btn-sm.warning:hover {
        background: rgba(255,193,7,0.2);
    }

    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: rgba(255,255,255,0.15);
    }

    .toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 2000;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .toast-msg {
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        animation: slideUp 0.4s ease;
        font-size: 0.9rem;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.6);
        border: 1px solid rgba(255,255,255,0.04);
    }

    .toast-msg.success { background: rgba(40,167,69,0.8); }
    .toast-msg.error { background: rgba(220,53,69,0.8); }
    .toast-msg.info { background: rgba(79,172,254,0.8); }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(8px);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-content {
        background: #1a1a2e;
        border-radius: 24px;
        padding: 2rem 2.5rem;
        max-width: 600px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        border: 1px solid rgba(255,255,255,0.04);
        animation: modalIn 0.3s ease;
    }

    @@keyframes modalIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .modal-content h3 {
        color: #fff;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .modal-content .close-btn {
        float: right;
        background: none;
        border: none;
        color: rgba(255,255,255,0.2);
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .modal-content .close-btn:hover {
        color: #fff;
    }

    .modal-content .detail-row {
        display: flex;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(255,255,255,0.03);
    }

    .modal-content .detail-row .label {
        color: rgba(255,255,255,0.3);
        font-size: 0.8rem;
        min-width: 80px;
        font-weight: 500;
    }

    .modal-content .detail-row .value {
        color: #fff;
        font-size: 0.9rem;
        word-break: break-word;
    }

    .modal-content .detail-row .value .answer-highlight {
        color: #8B5CF6;
        font-weight: 600;
    }

    .modal-content .form-group {
        margin-bottom: 1rem;
    }

    .modal-content .form-group label {
        display: block;
        color: rgba(255,255,255,0.4);
        font-size: 0.8rem;
        margin-bottom: 0.2rem;
    }

    .modal-content .form-group input,
    .modal-content .form-group textarea,
    .modal-content .form-group select {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.02);
        color: #fff;
        font-size: 0.9rem;
        outline: none;
        font-family: inherit;
    }

    .modal-content .form-group textarea {
        min-height: 60px;
        resize: vertical;
    }

    .modal-content .form-group input:focus,
    .modal-content .form-group textarea:focus {
        border-color: rgba(108,60,225,0.2);
        background: rgba(255,255,255,0.04);
    }

    .modal-content .form-actions {
        display: flex;
        gap: 0.8rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .modal-content .form-actions button {
        padding: 0.6rem 2rem;
        border: none;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.9rem;
    }

    .modal-content .form-actions .btn-submit {
        background: linear-gradient(135deg, #8B5CF6, #EC4899);
        color: #fff;
    }

    .modal-content .form-actions .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,60,225,0.2);
    }

    .modal-content .form-actions .btn-cancel {
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.3);
    }

    .modal-content .form-actions .btn-cancel:hover {
        background: rgba(255,255,255,0.08);
        color: #fff;
    }

    .modal-content .form-actions .btn-danger {
        background: rgba(220,53,69,0.12);
        color: #dc3545;
    }

    .modal-content .form-actions .btn-danger:hover {
        background: rgba(220,53,69,0.2);
    }

    @@media (max-width: 768px) {
        .admin-header h1 { font-size: 1.3rem; }
        .filter-bar { flex-direction: column; align-items: stretch; }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .modal-content { padding: 1.5rem; }
    }
</style>

<div class="admin-container">

    <div class="admin-header">
        <h1>📚 题库管理</h1>
        <div>
            <a href="/Admin/Dashboard" class="btn-glass">← 返回后台</a>
            <button class="btn-glass primary" onclick="openAddModal()" style="margin-left:0.5rem;">
                ➕ 添加题目
            </button>
            <button class="btn-glass primary" onclick="openBatchAddModal()" style="margin-left:0.5rem;">
                📚 批量添加
            </button>
        </div>
    </div>

    <!-- 统计 -->
    <div class="stats-row">
        <div class="stat-card total">
            <div class="number">@total</div>
            <div class="label">📝 总题目</div>
        </div>
        <div class="stat-card active">
            <div class="number">@activeCount</div>
            <div class="label">✅ 已启用</div>
        </div>
        <div class="stat-card inactive">
            <div class="number">@(total - activeCount)</div>
            <div class="label">⛔ 已禁用</div>
        </div>
    </div>

    <!-- 筛选 -->
    <div class="filter-bar">
        <span style="color:rgba(255,255,255,0.3);font-size:0.8rem;">🔍 筛选：</span>
        <select id="filterCategory">
            <option value="all">全部类别</option>
            <option value="生活">生活</option>
            <option value="历史">历史</option>
            <option value="文学">文学</option>
            <option value="科技">科技</option>
            <option value="地理">地理</option>
        </select>
        <select id="filterDifficulty">
            <option value="all">全部难度</option>
            <option value="1">⭐</option>
            <option value="2">⭐⭐</option>
            <option value="3">⭐⭐⭐</option>
            <option value="4">⭐⭐⭐⭐</option>
            <option value="5">⭐⭐⭐⭐⭐</option>
        </select>
        <select id="filterStatus">
            <option value="all">全部状态</option>
            <option value="1">✅ 启用</option>
            <option value="0">⛔ 禁用</option>
        </select>
        <input type="text" id="searchInput" placeholder="搜索题目或答案..." style="flex:1;min-width:160px;" />
        <button class="btn-glass" onclick="applyFilters()" style="padding:0.3rem 1.2rem;">应用</button>
        <button class="btn-glass" onclick="resetFilters()" style="padding:0.3rem 1.2rem;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.4);">重置</button>
    </div>

    <!-- 表格 -->
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>题目</th>
                    <th>答案</th>
                    <th>类别</th>
                    <th>难度</th>
                    <th>状态</th>
                    <th>使用次数</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="questionTableBody">
                @if (Model.Any())
                {
                    @foreach (var q in Model.OrderByDescending(q => q.Id))
                    {
                        <tr class="question-row @(!q.IsActive ? "disabled" : "")"
                            data-id="@q.Id"
                            data-category="@q.Category"
                            data-difficulty="@q.Difficulty"
                            data-status="@(q.IsActive ? "1" : "0")"
                            data-search="@(q.Question + " " + q.Answer)">
                            <td style="color:rgba(255,255,255,0.3);font-size:0.8rem;">#@q.Id</td>
                            <td style="max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@q.Question</td>
                            <td><strong style="color:#8B5CF6;">@q.Answer</strong></td>
                            <td><span class="badge badge-category">@q.Category</span></td>
                            <td>@(new string('⭐', q.Difficulty))</td>
                            <td>
                                <span class="badge @(q.IsActive ? "badge-active" : "badge-inactive")">
                                    @(q.IsActive ? "✅ 启用" : "⛔ 禁用")
                                </span>
                            </td>
                            <td style="font-size:0.8rem;color:rgba(255,255,255,0.3);">@q.UseCount 次</td>
                            <td>
                                <button class="btn-sm primary" onclick="viewDetail(@q.Id)">👁️ 详情</button>
                                <button class="btn-sm warning" onclick="toggleStatus(@q.Id, @(q.IsActive ? "false" : "true"))">
                                    @(q.IsActive ? "⛔ 禁用" : "✅ 启用")
                                </button>
                                <button class="btn-sm danger" onclick="deleteQuestion(@q.Id)">🗑️ 删除</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <p style="font-size:1.5rem;margin-bottom:0.5rem;">📭</p>
                                <p>题库为空</p>
                                <p style="color:rgba(255,255,255,0.05);font-size:0.8rem;">点击右上角「添加题目」开始创建</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- ===== 弹窗 ===== -->

<!-- 1. 单个添加题目弹窗 -->
<div class="modal-overlay" id="addSingleModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal('addSingleModal')">✕</button>
        <h3>➕ 添加题目</h3>
        <p style="color:rgba(255,255,255,0.2);font-size:0.85rem;margin-bottom:1rem;">
            添加一道新题目到题库，所有题目会同步到 Turso 数据库
        </p>

        <div class="form-group">
            <label>📝 题目 <span style="color:#dc3545;">*</span></label>
            <input type="text" id="singleQuestion" placeholder="输入题目内容" />
        </div>

        <div class="form-group">
            <label>✅ 答案 <span style="color:#dc3545;">*</span></label>
            <input type="text" id="singleAnswer" placeholder="输入正确答案" />
        </div>

        <div class="form-group">
            <label>🔤 拼音（用于语音识别）</label>
            <input type="text" id="singlePinyin" placeholder="如：zhongguo" />
            <div style="color:rgba(255,255,255,0.1);font-size:0.7rem;margin-top:0.2rem;">💡 建议填写，用于语音匹配</div>
        </div>

        <div class="form-group">
            <label>💡 提示</label>
            <input type="text" id="singleHint" placeholder="可选提示信息" />
        </div>

        <div class="form-group" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
            <div>
                <label>⭐ 难度</label>
                <select id="singleDifficulty">
                    <option value="1">⭐ 简单</option>
                    <option value="2">⭐⭐ 适中</option>
                    <option value="3" selected>⭐⭐⭐ 中等</option>
                    <option value="4">⭐⭐⭐⭐ 困难</option>
                    <option value="5">⭐⭐⭐⭐⭐ 极难</option>
                </select>
            </div>
            <div>
                <label>📂 类别</label>
                <select id="singleCategory">
                    <option value="生活">生活</option>
                    <option value="历史">历史</option>
                    <option value="文学">文学</option>
                    <option value="科技">科技</option>
                    <option value="地理">地理</option>
                    <option value="综合" selected>综合</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn-submit" onclick="addSingleQuestion()">✅ 添加题目</button>
            <button class="btn-cancel" onclick="closeModal('addSingleModal')">取消</button>
        </div>
    </div>
</div>

<!-- 2. 批量添加题目弹窗 -->
<div class="modal-overlay" id="addBatchModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal('addBatchModal')">✕</button>
        <h3>📚 批量添加题目</h3>
        <p style="color:rgba(255,255,255,0.2);font-size:0.85rem;margin-bottom:1rem;">
            一行一题，格式：<br />
            <code style="color:rgba(255,255,255,0.3);font-size:0.75rem;">题目 | 答案 | 拼音 | 提示 | 难度(1-5) | 类别</code>
        </p>

        <div class="form-group">
            <label>📝 题目列表</label>
            <textarea id="batchQuestions" rows="10" placeholder="示例：&#10;世界上最高的山峰是？ | 珠穆朗玛峰 | zhumulangmafeng | 海拔8848米 | 1 | 地理&#10;中国最长的河流是？ | 长江 | changjiang | 发源于青藏高原 | 1 | 地理"></textarea>
        </div>

        <div class="form-actions">
            <button class="btn-submit" onclick="batchAddQuestions()">📤 批量提交</button>
            <button class="btn-cancel" onclick="closeModal('addBatchModal')">取消</button>
        </div>
    </div>
</div>

<!-- 3. 详情弹窗 -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-content">
        <button class="close-btn" onclick="closeModal('detailModal')">✕</button>
        <h3>📋 题目详情</h3>
        <div id="detailContent">
            <div class="detail-row"><span class="label">ID</span><span class="value" id="dId">-</span></div>
            <div class="detail-row"><span class="label">题目</span><span class="value" id="dQuestion">-</span></div>
            <div class="detail-row"><span class="label">答案</span><span class="value"><span class="answer-highlight" id="dAnswer">-</span></span></div>
            <div class="detail-row"><span class="label">拼音</span><span class="value" id="dPinyin">-</span></div>
            <div class="detail-row"><span class="label">提示</span><span class="value" id="dHint">-</span></div>
            <div class="detail-row"><span class="label">类别</span><span class="value" id="dCategory">-</span></div>
            <div class="detail-row"><span class="label">难度</span><span class="value" id="dDifficulty">-</span></div>
            <div class="detail-row"><span class="label">状态</span><span class="value" id="dStatus">-</span></div>
            <div class="detail-row"><span class="label">使用次数</span><span class="value" id="dUseCount">-</span></div>
            <div class="detail-row"><span class="label">创建时间</span><span class="value" id="dCreatedAt">-</span></div>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // ============================================================
        // Toast
        // ============================================================
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast-msg ${type}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ============================================================
        // 弹窗控制
        // ============================================================
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function openAddModal() {
            document.getElementById('singleQuestion').value = '';
            document.getElementById('singleAnswer').value = '';
            document.getElementById('singlePinyin').value = '';
            document.getElementById('singleHint').value = '';
            openModal('addSingleModal');
        }

        function openBatchAddModal() {
            document.getElementById('batchQuestions').value = '';
            openModal('addBatchModal');
        }

        // 点击背景关闭
        document.querySelectorAll('.modal-overlay').forEach(el => {
            el.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                }
            });
        });

        // ESC 关闭
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay.active').forEach(el => el.classList.remove('active'));
            }
        });

        // ============================================================
        // 单个添加
        // ============================================================
        function addSingleQuestion() {
            const question = document.getElementById('singleQuestion').value.trim();
            const answer = document.getElementById('singleAnswer').value.trim();
            const pinyin = document.getElementById('singlePinyin').value.trim();
            const hint = document.getElementById('singleHint').value.trim();
            const difficulty = document.getElementById('singleDifficulty').value;
            const category = document.getElementById('singleCategory').value;

            if (!question) { showToast('请输入题目', 'error'); return; }
            if (!answer) { showToast('请输入答案', 'error'); return; }

            fetch('/Admin/AddSingleQuestion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    question: question,
                    answer: answer,
                    pinyin: pinyin,
                    hint: hint,
                    difficulty: parseInt(difficulty),
                    category: category
                })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('✅ 添加成功', 'success');
                    closeModal('addSingleModal');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || '添加失败', 'error');
                }
            })
            .catch(() => showToast('操作失败，请重试', 'error'));
        }

        // ============================================================
        // 批量添加
        // ============================================================
        function batchAddQuestions() {
            const text = document.getElementById('batchQuestions').value.trim();
            if (!text) { showToast('请输入题目', 'error'); return; }

            const lines = text.split('\n').filter(l => l.trim());
            if (lines.length === 0) { showToast('请输入至少一行题目', 'error'); return; }

            const questions = [];
            for (let line of lines) {
                const parts = line.split('|').map(s => s.trim());
                if (parts.length < 6) {
                    showToast(`格式错误：${line}`, 'error');
                    return;
                }
                questions.push({
                    question: parts[0],
                    answer: parts[1],
                    pinyin: parts[2] || '',
                    hint: parts[3] || '',
                    difficulty: parseInt(parts[4]) || 1,
                    category: parts[5] || '综合'
                });
            }

            if (!confirm(`确定要添加 ${questions.length} 道题吗？`)) return;

            fetch('/Admin/BatchAddQuestions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ questions: questions })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast(`✅ 成功添加 ${data.count} 道题`, 'success');
                    closeModal('addBatchModal');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message || '添加失败', 'error');
                }
            })
            .catch(() => showToast('操作失败，请重试', 'error'));
        }

        // ============================================================
        // 查看详情
        // ============================================================
        function viewDetail(id) {
            fetch(`/Admin/GetQuestionDetail?id=${id}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const q = data.data;
                        document.getElementById('dId').textContent = '#' + q.id;
                        document.getElementById('dQuestion').textContent = q.question;
                        document.getElementById('dAnswer').textContent = q.answer;
                        document.getElementById('dPinyin').textContent = q.pinyin || '-';
                        document.getElementById('dHint').textContent = q.hint || '-';
                        document.getElementById('dCategory').textContent = q.category;
                        document.getElementById('dDifficulty').textContent = new Array(q.difficulty).fill('⭐').join('');
                        document.getElementById('dStatus').textContent = q.isActive ? '✅ 启用' : '⛔ 禁用';
                        document.getElementById('dUseCount').textContent = q.useCount + ' 次';
                        document.getElementById('dCreatedAt').textContent = q.createdAt ? new Date(q.createdAt).toLocaleString('zh-CN') : '-';
                        openModal('detailModal');
                    } else {
                        showToast('加载失败', 'error');
                    }
                })
                .catch(() => showToast('加载失败，请重试', 'error'));
        }

        // ============================================================
        // 切换状态
        // ============================================================
        function toggleStatus(id, enable) {
            const action = enable ? '启用' : '禁用';
            if (!confirm(`确定要${action}这道题吗？`)) return;

            fetch('/Admin/ToggleQuestionStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}&enable=${enable}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast(`✅ 已${action}`, 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || '操作失败', 'error');
                }
            })
            .catch(() => showToast('操作失败，请重试', 'error'));
        }

        // ============================================================
        // 删除题目
        // ============================================================
        function deleteQuestion(id) {
            if (!confirm('⚠️ 确定要删除这道题吗？此操作不可恢复！')) return;

            fetch('/Admin/DeleteQuestion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast('🗑️ 删除成功', 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || '删除失败', 'error');
                }
            })
            .catch(() => showToast('操作失败，请重试', 'error'));
        }

        // ============================================================
        // 筛选功能
        // ============================================================
        function applyFilters() {
            const category = document.getElementById('filterCategory').value;
            const difficulty = document.getElementById('filterDifficulty').value;
            const status = document.getElementById('filterStatus').value;
            const search = document.getElementById('searchInput').value.toLowerCase();

            const rows = document.querySelectorAll('.question-row');
            let count = 0;

            rows.forEach(row => {
                let show = true;
                const rowCategory = row.dataset.category;
                const rowDifficulty = row.dataset.difficulty;
                const rowStatus = row.dataset.status;
                const rowSearch = row.dataset.search?.toLowerCase() || '';

                if (category !== 'all' && rowCategory !== category) show = false;
                if (difficulty !== 'all' && rowDifficulty !== difficulty) show = false;
                if (status !== 'all' && rowStatus !== status) show = false;
                if (search && !rowSearch.includes(search)) show = false;

                row.style.display = show ? '' : 'none';
                if (show) count++;
            });

            showToast(`显示 ${count} 条`, 'info');
        }

        function resetFilters() {
            document.getElementById('filterCategory').value = 'all';
            document.getElementById('filterDifficulty').value = 'all';
            document.getElementById('filterStatus').value = 'all';
            document.getElementById('searchInput').value = '';
            document.querySelectorAll('.question-row').forEach(row => {
                row.style.display = '';
            });
            showToast('已重置筛选', 'info');
        }

        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') applyFilters();
        });
    </script>
}
