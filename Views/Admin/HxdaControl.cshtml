@model MyPersonalWebsite.Models.HxdaPlayer

@{
    ViewData["Title"] = "人工干预";
    var isAdmin = Context.Session.GetInt32("IsAdmin") ?? 0;
    if (isAdmin != 1) { Context.Response.Redirect("/Auth/Login"); return; }
}

<style>
    .ctrl-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .ctrl-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .ctrl-header h1 {
            color: #fff;
            font-size: 1.6rem;
            margin: 0;
        }

    .btn-glass {
        padding: 0.5rem 1.5rem;
        border-radius: 40px;
        border: 1px solid rgba(255,255,255,0.06);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.7);
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-block;
        cursor: pointer;
    }

    .ctrl-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.2rem;
    }

        .ctrl-card h3 {
            color: #8B5CF6;
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0 0 1rem;
            text-transform: uppercase;
        }

    .cmd-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px,1fr));
        gap: 0.8rem;
    }

    .cmd-btn {
        padding: 0.8rem 1rem;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        background: rgba(255,255,255,0.02);
        color: #fff;
        cursor: pointer;
        transition: all 0.3s;
        font-family: inherit;
        font-size: 0.85rem;
        text-align: left;
    }

        .cmd-btn:hover {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.12);
            transform: translateY(-2px);
        }

        .cmd-btn .icon {
            font-size: 1.4rem;
            display: block;
            margin-bottom: 0.3rem;
        }

        .cmd-btn .desc {
            color: rgba(255,255,255,0.3);
            font-size: 0.7rem;
            margin-top: 0.2rem;
        }

    .toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        padding: 0.8rem 1.8rem;
        border-radius: 40px;
        color: #fff;
        font-weight: 500;
        z-index: 9999;
        display: none;
    }

        .toast.success {
            background: rgba(40,167,69,0.9);
        }

        .toast.error {
            background: rgba(220,53,69,0.9);
        }
</style>

<div class="ctrl-container">
    <div class="ctrl-header">
        <h1>🎛️ 人工干预 · @(string.IsNullOrEmpty(Model.VisitorName) ? "无名" : Model.VisitorName)</h1>
        <div>
            <a href="/AdminHxda/PlayerDetail?id=@Model.Id" class="btn-glass">👁️ 详情</a>
            <a href="/AdminHxda/Players" class="btn-glass" style="margin-left:0.5rem;">← 返回列表</a>
        </div>
    </div>

    <div class="ctrl-card">
        <h3>📜 最近干预记录</h3>
        <div id="historyList" style="max-height:400px;overflow-y:auto;">
            <div style="color:rgba(255,255,255,0.15);text-align:center;padding:1rem;">加载中...</div>
        </div>
    </div>

</div>

<div class="toast" id="toast"></div>

<script>
    var playerId = '@Model.Id';

    function showToast(msg, type) {
        var t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast ' + type;
        t.style.display = 'block';
        setTimeout(function () { t.style.display = 'none'; }, 3000);
    }

    function loadHistory() {
        fetch('/AdminHxda/GetInterventions?playerId=' + encodeURIComponent(playerId))
            .then(r => r.json())
            .then(data => {
                var list = document.getElementById('historyList');
                if (!data.success || !data.items || data.items.length === 0) {
                    list.innerHTML = '<div style="color:rgba(255,255,255,0.15);text-align:center;padding:1rem;">暂无记录</div>';
                    return;
                }
                var html = '';
                data.items.forEach(function (it) {
                    html += '<div style="padding:0.4rem 0;border-bottom:1px solid rgba(255,255,255,0.02);font-size:0.8rem;">' +
                            '<span style="color:#4facfe;font-weight:600;">' + it.type + '</span> ' +
                            '<span style="color:rgba(255,255,255,0.4);">' + (it.payload || '') + '</span>' +
                            '<span style="float:right;color:rgba(255,255,255,0.2);font-size:0.7rem;">' +
                            it.createdAt + (it.consumed ? ' ✅' : ' ⏳') + '</span>' +
                            '</div>';
                });
                list.innerHTML = html;
            })
            .catch(function () {
                document.getElementById('historyList').innerHTML =
                    '<div style="color:rgba(255,255,255,0.15);text-align:center;padding:1rem;">加载失败</div>';
            });
    }

    function send(type, payload) {
        fetch('/AdminHxda/SendCommand', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'playerId=' + encodeURIComponent(playerId) +
                '&type=' + encodeURIComponent(type) +
                '&payload=' + encodeURIComponent(payload || '')
        })
            .then(r => r.json())
            .then(d => {
                if (d.success) showToast('✅ 已发送', 'success');
                else showToast('❌ 发送失败', 'error');
            })
            .catch(() => showToast('❌ 网络错误', 'error'));
    }

    function sendWhisper() { var t = prompt('低语内容：', '你 在 看 什 么'); if (t !== null) send('whisper', t); }
    function sendRedirect() { var t = prompt('跳转地址：', '/hxda/page43.html'); if (t !== null) send('redirect', t); }
    function sendAlert() { var t = prompt('弹窗内容：', '有人吗。'); if (t !== null) send('alert', t); }
    function sendRename() { var t = prompt('临时名字：', ''); if (t !== null) send('rename', t); }
    function sendAudio() { var t = prompt('音频路径：', '/hxda/audio/knock.mp3'); if (t !== null) send('audio', t); }
    function sendAttention() { var t = prompt('注意值：', '26'); if (t !== null) send('attention_set', t); }
    function sendLock() { var t = prompt('锁定毫秒：', '3000'); if (t !== null) send('lock', t); }

    loadHistory();
    setInterval(loadHistory, 5000);
</script>
